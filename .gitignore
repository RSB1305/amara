# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.codex-dev-server.*

# tool run artifacts: screenshots, debug HTML dumps and browser console logs.
# These are working output of a single investigation, not project sources.
output/
.playwright-cli/
playwright-report/
test-results/

# machine-specific agent settings; .claude/launch.json stays versioned
.claude/settings.local.json

# raw photo drops (camera originals) stay out of the repo and out of the
# Tailwind source scan, which honours this file and only filters lowercase
# image extensions on its own.
src/assets/images/content/**/*.JPEG
src/assets/images/content/**/*.TIFF
src/assets/images/content/**/*.tiff
src/assets/images/content/**/*.HEIC
src/assets/images/content/**/*.heic


# environment variables and server-only secrets
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Local sitemap export for external SEO reviews (copy of dist/sitemap-0.xml)
sitemap-full.xml
