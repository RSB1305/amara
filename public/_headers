# Astro emits every build asset under /_astro/ with a content hash in its filename,
# so a changed file is always a changed URL. Cloudflare Pages otherwise serves these
# assets with `max-age=0, must-revalidate`, which forces the browser to spend a full
# network round trip revalidating each stylesheet, font and image on every page view
# even though the bytes are already in its cache. Immutable caching removes those
# round trips from repeat visits and from every in-site navigation.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

https://amara-staging.pages.dev/*
  X-Robots-Tag: noindex

https://:version.amara-staging.pages.dev/*
  X-Robots-Tag: noindex
