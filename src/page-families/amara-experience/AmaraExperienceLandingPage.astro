---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  BadgeCheck,
  CalendarDays,
  Croissant,
  Footprints,
  Heart,
  MapPin,
  Route,
  Trees,
  WavesHorizontal,
} from '@lucide/astro';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import AmaraActionButton from '../../components/actions/AmaraActionButton.astro';
import BookingDateRangeCalendar from '../../components/booking/BookingDateRangeCalendar.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import villageImage from '../../assets/images/content/amara-frigiliana-pueblo/frigiliana-old-town-steps.jpeg';
import coastImage from '../../assets/images/content/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg';
import eveningImage from '../../assets/images/content/hero-frigiliana.jpg';
import { amaraExperienceSeo, getAmaraExperienceContent } from '../../content/amaraExperienceContent';
import { createAmaraImage } from '../../lib/images/amaraImageProfiles';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = getAmaraExperienceContent(currentLang);
const guideHref = currentLang === 'es' ? '/amara-experience/guide' : `/${currentLang}/amara-experience/guide`;
const hostHref = buildOwnedLocalizedPath('staying-with-us', currentLang);
const seoHeroImage = await createAmaraImage(villageImage, 'hero');
const seo = { ...amaraExperienceSeo, ogImage: seoHeroImage.src };
const promiseIcons = {
  authenticity: Route,
  exclusivity: BadgeCheck,
  calm: Trees,
} as const;
const benefitIcons = {
  eat: Croissant,
  sea: WavesHorizontal,
  walk: Footprints,
  together: Heart,
  'day-trip': MapPin,
} as const;
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  pageFamily="amara-experience-landing"
  navigationCurrentToken="amara_experience"
  navigationLanguageToken="amara_experience"
  contextBreadcrumbTitle={copy.title}
>
  <AmaraPageShell family="amara-experience" dataLang={currentLang} class="am-experience-landing" whiteCanvas>
    <div class="am-experience-editorial-hero" data-am-component="amara-experience-introduction">
      <LocationGuideHero
        eyebrow={copy.eyebrow}
        title={copy.title}
        subtitle={copy.subtitle}
        paragraphs={[copy.directAnswer]}
        accent={copy.heroAccent}
        family="experience"
        role="hub"
        topic="overview"
      >
        <EditorialByline
          slot="meta"
          lang={currentLang}
          authorName={copy.hostAuthorName}
          authorHref={hostHref}
          updated={copy.hostUpdated}
          note={copy.hostNote}
        />

        <div slot="visual" class="am-experience-hero__media">
          <div class="am-experience-hero__primary overflow-hidden bg-surface-container-low">
            <AmaraImage
              src={villageImage}
              alt={copy.imageAlts.village}
              profile="hero"
              width={1200}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 1023px) calc(100vw - 3rem), 52vw"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              preferAvif
            />
          </div>
          <div class="am-experience-hero__secondary overflow-hidden border-[6px] border-surface-white bg-surface-container-low shadow-lg sm:border-8">
            <AmaraImage
              src={eveningImage}
              alt={copy.imageAlts.evening}
              profile="card"
              width={900}
              widths={[320, 480, 720, 900]}
              sizes="(max-width: 639px) 48vw, (max-width: 1023px) 42vw, 24vw"
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>
          <div class="am-experience-hero__mark" aria-hidden="true">
            <span class="am-text-label">AMARA</span>
            <span class="am-text-caption">EXPERIENCE</span>
          </div>
        </div>
      </LocationGuideHero>
    </div>

    <AmaraSection family="experience" dataComponent="amara-experience-promises">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-8">
            <p class="am-text-eyebrow mb-5 text-primary">{copy.promiseEyebrow}</p>
            <h2 class="am-text-title max-w-[24ch] text-on-surface">{copy.promiseTitle}</h2>
          </div>
          <p class="am-text-body max-w-[60ch] leading-relaxed text-on-surface-variant lg:col-span-4">{copy.promiseIntro}</p>
        </div>

        <ol class="mt-14 grid gap-8 lg:mt-20 lg:grid-cols-3">
          {copy.promises.map((promise) => {
            const Icon = promiseIcons[promise.id as keyof typeof promiseIcons];

            return (
              <li class="am-experience-benefit border-t border-outline-variant/30 pt-6">
                <div class="flex items-center justify-between gap-4">
                  <p class="am-text-label text-primary">{promise.principle}</p>
                  <span
                    class="inline-grid h-11 w-11 shrink-0 place-items-center rounded-full border border-outline-variant/30 bg-surface-container-low text-primary"
                    aria-hidden="true"
                  >
                    <Icon class="h-5 w-5" stroke-width={1.5} />
                  </span>
                </div>
                <h3 class="am-text-subtitle mt-5 text-on-surface">{promise.title}</h3>
                <p class="am-text-body mt-4 max-w-[52ch] leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={promise.copy} />
                </p>
              </li>
            );
          })}
        </ol>
      </div>
    </AmaraSection>

    <AmaraSection surface="tint" family="experience" dataComponent="amara-experience-value">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-8">
            <p class="am-text-eyebrow mb-5 text-primary">{copy.valueEyebrow}</p>
            <h2 class="am-text-title max-w-[25ch] text-on-surface">{copy.valueTitle}</h2>
          </div>
          <p class="am-text-body max-w-[60ch] leading-relaxed text-on-surface-variant lg:col-span-4">{copy.valueIntro}</p>
        </div>

        <ol class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3 xl:grid-cols-5">
          {copy.benefits.map((benefit) => {
            const Icon = benefitIcons[benefit.id as keyof typeof benefitIcons];

            return (
              <li class="am-experience-benefit border-t border-outline-variant/30 pt-6">
                <div class="flex items-center justify-between gap-4">
                  <p class="am-text-label text-primary">{benefit.number}</p>
                  <span
                    class="inline-grid h-10 w-10 shrink-0 place-items-center rounded-full border border-outline-variant/30 bg-surface-white text-primary"
                    aria-hidden="true"
                  >
                    <Icon class="h-5 w-5" stroke-width={1.5} />
                  </span>
                </div>
                <h3 class="am-text-subtitle mt-5 text-on-surface">{benefit.title}</h3>
                <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{benefit.copy}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </AmaraSection>

    <AmaraSection family="experience" dataComponent="amara-experience-host-note">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-24">
        <div class="overflow-hidden bg-surface-container-low lg:col-span-6">
          <AmaraImage
            src={coastImage}
            alt={copy.imageAlts.coast}
            profile="hero"
            width={1200}
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 1023px) calc(100vw - 3rem), 48vw"
            class="aspect-[4/5] h-full w-full object-cover sm:aspect-[3/2] lg:aspect-[4/5]"
            loading="lazy"
            preferAvif
          />
        </div>
        <div class="max-w-[62ch] lg:col-span-5 lg:col-start-8">
          <p class="am-text-eyebrow mb-5 text-primary">{copy.hostEyebrow}</p>
          <h2 class="am-text-title text-on-surface">{copy.hostTitle}</h2>
          <div class="mt-7 space-y-5">
            {copy.hostParagraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </AmaraSection>

    <AmaraSection surface="tint" family="experience" dataComponent="amara-experience-access">
      <div class="mx-auto grid max-w-[1100px] gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(22rem,1fr)] lg:items-start lg:gap-20">
        <div class="max-w-[55ch] lg:pt-8">
          <p class="am-text-eyebrow mb-5 text-primary">{copy.accessEyebrow}</p>
          <h2 class="am-text-title text-on-surface">{copy.accessTitle}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{copy.accessIntro}</p>
        </div>

        <div class="am-experience-access-card rounded-[var(--radius-overlay)] border border-outline-variant/20 bg-surface-white p-6 shadow-sm sm:p-9">
          <h2 class="am-text-title text-on-surface">{copy.formTitle}</h2>
          <p class="am-text-body mt-3 text-on-surface-variant">{copy.formIntro}</p>

          <form
            class="mt-8 space-y-5"
            data-am-experience-form
            data-lang={currentLang}
            data-guide-href={guideHref}
            data-pending-label={copy.pendingLabel}
            data-submit-label={copy.submitLabel}
            data-denied-message={copy.deniedMessage}
            data-unavailable-message={copy.unavailableMessage}
            data-session-ended-message={copy.sessionEndedMessage}
            data-choose-arrival-label={copy.chooseArrivalLabel}
            data-choose-departure-label={copy.chooseDepartureLabel}
            data-date-picker-help={copy.datePickerHelp}
            data-date-picker-departure-help={copy.datePickerDepartureHelp}
            data-date-picker-complete-help={copy.datePickerCompleteHelp}
            data-date-picker-required-message={copy.datePickerRequiredMessage}
          >
            <label class="block">
              <span class="am-text-label mb-2 block text-on-surface">{copy.firstNameLabel}</span>
              <input class="am-form-control w-full" name="firstName" type="text" autocomplete="given-name" minlength="2" maxlength="80" required />
            </label>
            <div class="am-experience-date-picker relative" data-am-experience-date-picker>
              <div class="space-y-5">
                <label class="block" data-am-experience-native-arrival>
                  <span class="am-text-label mb-2 block text-on-surface">{copy.arrivalLabel}</span>
                  <input class="am-form-control w-full" name="arrival" type="date" autocomplete="off" required data-am-experience-arrival />
                </label>
                <div class="block" hidden data-am-experience-arrival-trigger-wrap>
                  <span id="am-experience-arrival-label" class="am-text-label mb-2 block text-on-surface">{copy.arrivalLabel}</span>
                  <button
                    class="am-form-control am-form-control--trigger am-text-form-value flex w-full items-center justify-between gap-3 bg-surface-white"
                    type="button"
                    aria-controls="am-experience-date-calendar"
                    aria-expanded="false"
                    aria-labelledby="am-experience-arrival-label am-experience-arrival-value"
                    data-am-experience-arrival-trigger
                  >
                    <span id="am-experience-arrival-value" class="min-w-0 flex-1 truncate text-left" data-am-experience-arrival-value>{copy.chooseArrivalLabel}</span>
                    <CalendarDays class="h-5 w-5 shrink-0 text-primary" stroke-width={1.6} aria-hidden="true" />
                  </button>
                </div>

                <label class="block" data-am-experience-native-departure>
                  <span class="am-text-label mb-2 block text-on-surface">{copy.departureLabel}</span>
                  <input class="am-form-control w-full" name="departure" type="date" autocomplete="off" required data-am-experience-departure />
                </label>
                <div class="block" hidden data-am-experience-departure-trigger-wrap>
                  <span id="am-experience-departure-label" class="am-text-label mb-2 block text-on-surface">{copy.departureLabel}</span>
                  <button
                    class="am-form-control am-form-control--trigger am-text-form-value flex w-full items-center justify-between gap-3 bg-surface-white"
                    type="button"
                    aria-controls="am-experience-date-calendar"
                    aria-expanded="false"
                    aria-labelledby="am-experience-departure-label am-experience-departure-value"
                    data-am-experience-departure-trigger
                  >
                    <span id="am-experience-departure-value" class="min-w-0 flex-1 truncate text-left" data-am-experience-departure-value>{copy.chooseDepartureLabel}</span>
                    <CalendarDays class="h-5 w-5 shrink-0 text-primary" stroke-width={1.6} aria-hidden="true" />
                  </button>
                </div>
              </div>

              <div id="am-experience-date-calendar">
                <BookingDateRangeCalendar
                  title={copy.datePickerTitle}
                  help={copy.datePickerHelp}
                  previousMonthLabel={copy.previousMonthLabel}
                  nextMonthLabel={copy.nextMonthLabel}
                />
              </div>
            </div>
            <p class="am-text-body min-h-6 text-on-surface-variant" data-am-experience-status role="status" aria-live="polite"></p>
            <AmaraActionButton variant="primary" type="submit" class="w-full" data-am-experience-submit>
              <span data-am-experience-submit-label>{copy.submitLabel}</span>
            </AmaraActionButton>
          </form>
          <p class="am-text-caption mt-5 text-muted">{copy.privacyNote}</p>
        </div>
      </div>
    </AmaraSection>

    <EditorialClosingCta
      title={copy.closingTitle}
      lead={copy.closingLead}
      links={[{ token: 'book', label: copy.availabilityLabel, style: 'primary' }]}
      lang={currentLang}
      spacing="page"
      dataComponent="amara-experience-booking-cta"
      role="conversion"
      family="experience"
      tone="romance"
    />
  </AmaraPageShell>
</BaseLayout>

<style>
  .am-experience-editorial-hero {
    overflow: hidden;
    margin-inline: calc(var(--spacing-page-gutter) * -1);
  }

  .am-experience-hero__media {
    position: relative;
    min-block-size: 32rem;
    padding-inline-start: clamp(0rem, 6vw, 5rem);
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }

  .am-experience-hero__primary {
    block-size: 34rem;
  }

  .am-experience-hero__secondary {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    inline-size: min(58%, 22rem);
    block-size: 14rem;
  }

  .am-experience-hero__mark {
    position: absolute;
    inset-inline-end: -0.75rem;
    inset-block-end: 1.25rem;
    display: grid;
    inline-size: 7.5rem;
    block-size: 7.5rem;
    place-content: center;
    gap: 0.15rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 34%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface-white) 94%, transparent);
    color: var(--color-primary);
    text-align: center;
    backdrop-filter: blur(0.5rem);
  }

  .am-experience-benefit {
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .am-experience-benefit:hover {
    border-color: var(--color-primary);
    transform: translateY(-0.25rem);
  }

  .am-experience-date-picker :global(.am-booking-calendar__months) {
    grid-template-columns: minmax(0, 1fr);
  }

  .am-experience-date-picker :global(.am-booking-calendar__day),
  .am-experience-date-picker :global(.am-booking-calendar__blank) {
    min-height: 3.25rem;
  }

  @media (min-width: 40rem) {
    .am-experience-date-picker :global(.am-booking-calendar) {
      position: absolute;
      inset-block-start: calc(100% + 0.75rem);
      inset-inline-end: 0;
      z-index: 90;
      width: min(28rem, 100%);
      margin-top: 0;
    }
  }

  @media (max-width: 47.999rem) {
    .am-experience-hero__media {
      min-block-size: 28rem;
      margin-inline: calc(var(--spacing-page-gutter) * -0.4);
      padding-inline-start: 2.25rem;
      padding-block-end: 4rem;
    }

    .am-experience-hero__primary {
      block-size: 28rem;
    }

    .am-experience-hero__secondary {
      inline-size: 55%;
      block-size: 10.5rem;
    }

    .am-experience-hero__mark {
      inline-size: 6.25rem;
      block-size: 6.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-experience-benefit {
      transition: none;
    }

    .am-experience-benefit:hover {
      transform: none;
    }
  }
</style>

<script>
  import { enhanceExperienceAccessForms } from '../../scripts/experienceAccessForm';

  enhanceExperienceAccessForms();
</script>
