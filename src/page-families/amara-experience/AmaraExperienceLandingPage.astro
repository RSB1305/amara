---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  BadgeCheck,
  Croissant,
  Footprints,
  Heart,
  MapPin,
  Route,
  Trees,
  WavesHorizontal,
} from '@lucide/astro';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import villageImage from '../../assets/images/content/amara-frigiliana-pueblo/frigiliana-old-town-steps.jpeg';
import coastImage from '../../assets/images/content/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg';
import eveningImage from '../../assets/images/content/hero-frigiliana.jpg';
import { amaraExperienceSeo, getAmaraExperienceContent } from '../../content/amaraExperienceContent';
import { createAmaraImage } from '../../lib/images/amaraImageProfiles';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = getAmaraExperienceContent(currentLang);
import { experienceAccessHref } from '../../../guest-experience/guide-routes.mjs';
const accessHref = experienceAccessHref(currentLang);
const hostHref = buildOwnedLocalizedPath('about', currentLang);
const seoHeroImage = await createAmaraImage(villageImage, 'hero');
const seo = { ...amaraExperienceSeo, ogImage: seoHeroImage.src };
const promiseIcons = {
  authenticity: Route,
  exclusivity: BadgeCheck,
  calm: Trees,
} as const;
const benefitIcons = {
  eat: Croissant,
  sea: WavesHorizontal,
  walk: Footprints,
  together: Heart,
  'day-trip': MapPin,
} as const;
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  pageFamily="amara-experience-landing"
  navigationCurrentToken="amara_experience"
  navigationLanguageToken="amara_experience"
  contextBreadcrumbTitle={copy.title}
>
  <AmaraPageShell family="amara-experience" dataLang={currentLang} class="am-experience-landing" whiteCanvas>
    <div class="am-experience-editorial-hero" data-am-component="amara-experience-introduction">
      <LocationGuideHero
        eyebrow={copy.eyebrow}
        title={copy.title}
        subtitle={copy.subtitle}
        paragraphs={[copy.directAnswer]}
        accent={copy.heroAccent}
        family="experience"
        role="hub"
        topic="overview"
      >
        <EditorialByline
          slot="meta"
          lang={currentLang}
          authorName={copy.hostAuthorName}
          authorHref={hostHref}
          updated={copy.hostUpdated}
          note={copy.hostNote}
        />

        <div slot="visual" class="am-experience-hero__media">
          <div class="am-experience-hero__primary overflow-hidden bg-surface-container-low">
            <AmaraImage
              src={villageImage}
              alt={copy.imageAlts.village}
              profile="hero"
              width={1200}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 1023px) calc(100vw - 3rem), 52vw"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              preferAvif
            />
          </div>
          <div class="am-experience-hero__secondary overflow-hidden border-[6px] border-surface-white bg-surface-container-low shadow-lg sm:border-8">
            <AmaraImage
              src={eveningImage}
              alt={copy.imageAlts.evening}
              profile="card"
              width={900}
              widths={[320, 480, 720, 900]}
              sizes="(max-width: 639px) 48vw, (max-width: 1023px) 42vw, 24vw"
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>
          <div class="am-experience-hero__mark" aria-hidden="true">
            <span class="am-text-label">AMARA</span>
            <span class="am-text-caption">EXPERIENCE</span>
          </div>
        </div>
      </LocationGuideHero>
    </div>

    <AmaraSection family="experience" dataComponent="amara-experience-promises">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-8">
            <p class="am-text-eyebrow mb-5 text-primary">{copy.promiseEyebrow}</p>
            <h2 class="am-text-title max-w-[24ch] text-on-surface">{copy.promiseTitle}</h2>
          </div>
          <p class="am-text-body max-w-[60ch] leading-relaxed text-on-surface-variant lg:col-span-4">{copy.promiseIntro}</p>
        </div>

        <ol class="mt-14 grid gap-8 lg:mt-20 lg:grid-cols-3">
          {copy.promises.map((promise) => {
            const Icon = promiseIcons[promise.id as keyof typeof promiseIcons];

            return (
              <li class="am-experience-benefit border-t border-outline-variant/30 pt-6">
                <div class="flex items-center justify-between gap-4">
                  <p class="am-text-label text-primary">{promise.principle}</p>
                  <span
                    class="inline-grid h-11 w-11 shrink-0 place-items-center rounded-full border border-outline-variant/30 bg-surface-container-low text-primary"
                    aria-hidden="true"
                  >
                    <Icon class="h-5 w-5" stroke-width={1.5} />
                  </span>
                </div>
                <h3 class="am-text-subtitle mt-5 text-on-surface">{promise.title}</h3>
                <p class="am-text-body mt-4 max-w-[52ch] leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={promise.copy} />
                </p>
              </li>
            );
          })}
        </ol>
      </div>
    </AmaraSection>

    <AmaraSection surface="tint" family="experience" dataComponent="amara-experience-value">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-8">
            <p class="am-text-eyebrow mb-5 text-primary">{copy.valueEyebrow}</p>
            <h2 class="am-text-title max-w-[25ch] text-on-surface">{copy.valueTitle}</h2>
          </div>
          <p class="am-text-body max-w-[60ch] leading-relaxed text-on-surface-variant lg:col-span-4">{copy.valueIntro}</p>
        </div>

        <ol class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3 xl:grid-cols-5">
          {copy.benefits.map((benefit) => {
            const Icon = benefitIcons[benefit.id as keyof typeof benefitIcons];

            return (
              <li class="am-experience-benefit border-t border-outline-variant/30 pt-6">
                <div class="flex items-center justify-between gap-4">
                  <p class="am-text-label text-primary">{benefit.number}</p>
                  <span
                    class="inline-grid h-10 w-10 shrink-0 place-items-center rounded-full border border-outline-variant/30 bg-surface-white text-primary"
                    aria-hidden="true"
                  >
                    <Icon class="h-5 w-5" stroke-width={1.5} />
                  </span>
                </div>
                <h3 class="am-text-subtitle mt-5 text-on-surface">{benefit.title}</h3>
                <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{benefit.copy}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </AmaraSection>

    <AmaraSection family="experience" dataComponent="amara-experience-host-note">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-24">
        <div class="overflow-hidden bg-surface-container-low lg:col-span-6">
          <AmaraImage
            src={coastImage}
            alt={copy.imageAlts.coast}
            profile="hero"
            width={1200}
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 1023px) calc(100vw - 3rem), 48vw"
            class="aspect-[4/5] h-full w-full object-cover sm:aspect-[3/2] lg:aspect-[4/5]"
            loading="lazy"
            preferAvif
          />
        </div>
        <div class="max-w-[62ch] lg:col-span-5 lg:col-start-8">
          <p class="am-text-eyebrow mb-5 text-primary">{copy.hostEyebrow}</p>
          <h2 class="am-text-title text-on-surface">{copy.hostTitle}</h2>
          <div class="mt-7 space-y-5">
            {copy.hostParagraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </AmaraSection>

    <AmaraSection surface="tint" family="experience" dataComponent="amara-experience-access">
      <div class="mx-auto grid max-w-[1100px] gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16">
        <div class="max-w-[62ch]">
          <p class="am-text-eyebrow mb-5 text-primary">{copy.accessEyebrow}</p>
          <h2 class="am-text-title text-on-surface">{copy.accessTitle}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{copy.accessIntro}</p>
        </div>
        <div>
          <a class="am-btn am-btn--primary" href={accessHref}>{copy.submitLabel}</a>
        </div>
      </div>
    </AmaraSection>

    <EditorialClosingCta
      title={copy.closingTitle}
      lead={copy.closingLead}
      links={[{ token: 'book', label: copy.availabilityLabel, style: 'primary' }]}
      lang={currentLang}
      spacing="page"
      dataComponent="amara-experience-booking-cta"
      role="conversion"
      family="experience"
      tone="romance"
    />
  </AmaraPageShell>
</BaseLayout>

<style>
  .am-experience-editorial-hero {
    overflow: hidden;
    margin-inline: calc(var(--spacing-page-gutter) * -1);
  }

  .am-experience-hero__media {
    position: relative;
    min-block-size: 32rem;
    padding-inline-start: clamp(0rem, 6vw, 5rem);
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }

  .am-experience-hero__primary {
    block-size: 34rem;
  }

  .am-experience-hero__secondary {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    inline-size: min(58%, 22rem);
    block-size: 14rem;
  }

  .am-experience-hero__mark {
    position: absolute;
    inset-inline-end: -0.75rem;
    inset-block-end: 1.25rem;
    display: grid;
    inline-size: 7.5rem;
    block-size: 7.5rem;
    place-content: center;
    gap: 0.15rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 34%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface-white) 94%, transparent);
    color: var(--color-primary);
    text-align: center;
    backdrop-filter: blur(0.5rem);
  }

  .am-experience-benefit {
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .am-experience-benefit:hover {
    border-color: var(--color-primary);
    transform: translateY(-0.25rem);
  }

  @media (max-width: 47.999rem) {
    .am-experience-hero__media {
      min-block-size: 28rem;
      margin-inline: calc(var(--spacing-page-gutter) * -0.4);
      padding-inline-start: 2.25rem;
      padding-block-end: 4rem;
    }

    .am-experience-hero__primary {
      block-size: 28rem;
    }

    .am-experience-hero__secondary {
      inline-size: 55%;
      block-size: 10.5rem;
    }

    .am-experience-hero__mark {
      inline-size: 6.25rem;
      block-size: 6.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-experience-benefit {
      transition: none;
    }

    .am-experience-benefit:hover {
      transform: none;
    }
  }
</style>
