---
import GuestGuideLayout from '../../layouts/GuestGuideLayout.astro';
import GuestGuideMenuItem from '../../components/guest-guide/GuestGuideMenuItem.astro';
import GuestGuideLanguageSwitcher from '../../components/guest-guide/GuestGuideLanguageSwitcher.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import { guideHref } from '../../lib/guestGuideHref';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';
import type { GuestGuideHubEntry } from '../../types/guestGuide';

interface Props {
  entry: GuestGuideHubEntry;
  lang: AmaraLanguage;
}

const { entry, lang } = Astro.props;

const seo: AmaraAuthoringSeo = {
  version: 'guest-guide-v1',
  pageType: 'D',
  entityKey: entry.entityKey,
  languages: {
    en: { title: entry.seoTitle.en, description: entry.seoDescription.en, robots: 'noindex, follow', canonical: 'auto' },
    de: { title: entry.seoTitle.de, description: entry.seoDescription.de, robots: 'noindex, follow', canonical: 'auto' },
    es: { title: entry.seoTitle.es, description: entry.seoDescription.es, robots: 'noindex, follow', canonical: 'auto' },
    nl: { title: entry.seoTitle.nl, description: entry.seoDescription.nl, robots: 'noindex, follow', canonical: 'auto' },
    sv: { title: entry.seoTitle.sv, description: entry.seoDescription.sv, robots: 'noindex, follow', canonical: 'auto' }
  }
};
---

<GuestGuideLayout seo={seo} pageLang={lang} supportHref={entry.supportHref} supportLabel={entry.supportLabel[lang]}>
  <header class="am-hero">
    <AmaraImage src={entry.heroImage} alt={entry.heroAlt[lang]} profile="hero" loading="eager" fetchpriority="high" />
    <GuestGuideLanguageSwitcher slug={entry.slug} currentLang={lang} variant="overlay" />
  </header>

  <main class="am-main">
    <section class="am-prose">
      <span class="am-kicker">{entry.kicker[lang]}</span>
      <h1 class="am-hero-title">{entry.title[lang]}</h1>
      <p>{entry.intro[lang]}</p>
    </section>

    <nav aria-label="Guide menu">
      {entry.menuLinks.map((link) => (
        <GuestGuideMenuItem
          icon={link.icon}
          title={link.title[lang]}
          subtitle={link.subtitle[lang]}
          href={guideHref(link.targetSlug, lang, entry.slug)}
        />
      ))}
    </nav>

    <section class="am-prose am-prose--closing">
      {entry.closingParagraphs.map((paragraph) => <p set:html={paragraph[lang]} />)}

      <div class="am-btn-row">
        <a href={entry.ctaHref[lang]} class="am-btn am-btn--primary">{entry.ctaLabel[lang]}</a>
        {entry.secondaryCtaHref && entry.secondaryCtaLabel && (
          <a href={entry.secondaryCtaHref} class="am-btn am-btn--secondary" target="_blank" rel="noopener">
            {entry.secondaryCtaLabel[lang]}
          </a>
        )}
      </div>

      <p set:html={entry.signOff[lang]} />
    </section>
  </main>
</GuestGuideLayout>
