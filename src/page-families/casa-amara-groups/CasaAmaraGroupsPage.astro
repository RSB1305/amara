---
import { resolveLocale } from '../../types/content';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import type { ImageMetadata } from 'astro';
import AmaraImage from '../../components/AmaraImage.astro';
import Hero from '../../components/Hero.astro';
import Navigation from '../../components/Navigation.astro';
import farahImage from '../../assets/images/content/amara-farah/67-amara-frigiliana.jpg';
import lounisImage from '../../assets/images/content/amara-lounis/15-amara-frigiliana.jpg';
import zaidImage from '../../assets/images/content/amara-zaid/cara-rural-frigiliana-amara-said-terraza.jpg';
import mahaImage from '../../assets/images/content/amara-maha/29-amara-frigiliana.jpg';
import connectionImage from '../../assets/images/content/casa-amara-groups/47-amara-frigiliana-connection-stairs.jpg';
import houseImage from '../../assets/images/content/amara-entrada/casa-amara-frigiliana-fuerra.jpg';
import {
  casaAmaraGroupsContent,
  casaAmaraGroupsSeo
} from '../../content/casaAmaraGroupsContent';
import {
  formatVacationRentalBedDimensions,
  vacationRentalEntitiesByToken,
  type VacationRentalToken
} from '../../content/vacationRentalEntities';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type GroupStayToken = Extract<VacationRentalToken, 'farah' | 'lounis' | 'zaid' | 'maha'>;

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = resolveLocale(casaAmaraGroupsContent, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Casa AMARA groups');

const links = {
  enquiry: requiredLink('casa_amara_group_enquiry'),
  stays: requiredLink('romantic_hideaways')
};

const stayImages: Record<GroupStayToken, ImageMetadata> = {
  farah: farahImage,
  lounis: lounisImage,
  zaid: zaidImage,
  maha: mahaImage
};

const groupStayTokens: GroupStayToken[] = ['farah', 'lounis', 'zaid', 'maha'];
const stays = groupStayTokens.map((token) => ({
  token,
  entity: vacationRentalEntitiesByToken[token],
  image: stayImages[token],
  href: requiredLink(token),
  context: copy.stays.contexts[token]
}));

const locationLinks = copy.location.links.map((item) => ({
  ...item,
  href: requiredLink(item.token)
}));

const footerHighlights: LabeledLink[] = [
  { token: 'casa_amara_groups', label: copy.footer.groups },
  { token: 'location_frigiliana', label: copy.footer.location },
  { token: 'romantic_hideaways', label: copy.footer.stays }
];
---

<BaseLayout
  seo={casaAmaraGroupsSeo}
  pageLang={currentLang}
  contextBreadcrumbTitle={copy.hero.title}
  footerHighlights={footerHighlights}
  showContextNavigation={false}
>
  <Navigation
    currentLang={currentLang}
    currentToken="casa_amara_groups"
    languageToken="casa_amara_groups"
  />

  <main
    id="am-main-content"
    tabindex="-1"
    class="min-h-screen overflow-hidden scroll-mt-[104px] lg:scroll-mt-[112px]"
    data-am-page="casa-amara-groups"
  >
    <Hero imageSrc={mahaImage} imageAlt={copy.hero.imageAlt}>
      <span class="am-text-caption mb-8 block text-primary">{copy.hero.kicker}</span>
      <h1 class="am-text-display mb-7 break-words italic tracking-tighter text-on-surface md:mb-8">
        {copy.hero.title}
      </h1>
      <p class="am-text-subtitle max-w-2xl italic leading-relaxed text-on-surface">
        {copy.hero.lead}
      </p>
      <p class="am-text-caption mt-8 normal-case tracking-normal text-primary">
        {copy.hero.facts}
      </p>
      <p class="am-text-body mt-5 max-w-2xl leading-relaxed text-on-surface-variant">
        <InlineEmphasis text={copy.hero.qualifier} />
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a class="am-btn am-btn--primary" href="#availability">{copy.hero.primaryCta}</a>
        <a class="am-btn am-btn--secondary" href="#stays">{copy.hero.secondaryCta}</a>
      </div>
    </Hero>

    <section class="border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
        <p class="am-text-caption text-primary">{copy.model.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-4xl italic tracking-tight text-on-surface">
          {copy.model.title}
        </h2>
        <p class="am-text-body mt-7 max-w-3xl leading-relaxed text-on-surface-variant">
          <InlineEmphasis text={copy.model.intro} />
        </p>

        <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
          {copy.model.options.map((option) => (
            <article class="border-t border-outline-variant/20 pt-6">
              <p class="am-text-caption text-primary">{option.guests}</p>
              <h3 class="am-text-subtitle mt-4 text-on-surface">{option.title}</h3>
              <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant"><InlineEmphasis text={option.text} /></p>
            </article>
          ))}
        </div>

        <p class="am-text-body mt-12 max-w-4xl border-l border-primary/30 bg-surface px-5 py-4 leading-relaxed text-on-surface-variant">
          {copy.model.note}
        </p>
      </div>
    </section>

    <section id="stays" class="scroll-mt-32 border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
        <p class="am-text-caption text-primary">{copy.stays.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-4xl italic tracking-tight text-on-surface">
          {copy.stays.title}
        </h2>
        <p class="am-text-body mt-7 max-w-3xl leading-relaxed text-on-surface-variant">
          {copy.stays.intro}
        </p>

        <div class="mt-14 grid gap-x-8 gap-y-16 md:grid-cols-2">
          {stays.map(({ entity, image, href, context }) => (
            <article class="border-t border-outline-variant/15 pt-6">
              <AmaraImage
                src={image}
                alt={entity.imageAlt[currentLang]}
                profile="card"
                sizes="(max-width: 767px) calc(100vw - 3rem), 50vw"
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="pt-7">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h3 class="am-text-subtitle text-on-surface">{entity.shortName}</h3>
                  <p class="am-text-caption text-primary">
                    {entity.occupancy} {copy.stays.labels.guests} · {entity.bathrooms} {copy.stays.labels.bathroom}
                  </p>
                </div>
                <p class="am-text-body mt-4 max-w-xl leading-relaxed text-on-surface-variant">
                  {context}
                </p>
                <dl class="mt-6 space-y-3 border-t border-outline-variant/10 pt-5 text-on-surface-variant">
                  <div class="grid grid-cols-[7rem_1fr] gap-4">
                    <dt class="am-text-caption normal-case tracking-normal text-on-surface">{copy.stays.labels.bed}</dt>
                    <dd class="am-text-body">
                      {entity.bed.map((bed) => formatVacationRentalBedDimensions(bed.label) ?? bed.label).join(', ')}
                    </dd>
                  </div>
                  <div class="grid grid-cols-[7rem_1fr] gap-4">
                    <dt class="am-text-caption normal-case tracking-normal text-on-surface">{copy.stays.labels.kitchen}</dt>
                    <dd class="am-text-body">{entity.kitchenNote[currentLang]}</dd>
                  </div>
                  <div class="grid grid-cols-[7rem_1fr] gap-4">
                    <dt class="am-text-caption normal-case tracking-normal text-on-surface">{copy.stays.labels.outdoor}</dt>
                    <dd class="am-text-body">{entity.outdoorNote[currentLang]}</dd>
                  </div>
                  <div class="grid grid-cols-[7rem_1fr] gap-4">
                    <dt class="am-text-caption normal-case tracking-normal text-on-surface">{copy.stays.labels.access}</dt>
                    <dd class="am-text-body">{entity.accessNote[currentLang]}</dd>
                  </div>
                </dl>
                <a class="am-cta-link mt-7 inline-block" href={href}>{copy.stays.linkLabel}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <AmaraImage
            src={connectionImage}
            alt={copy.connection.imageAlt}
            profile="gallery"
            sizes="(max-width: 1023px) 100vw, 50vw"
            class="aspect-[3/2] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="max-w-2xl lg:col-span-5 lg:col-start-8">
          <p class="am-text-caption text-primary">{copy.connection.eyebrow}</p>
          <h2 class="am-text-title mt-5 italic tracking-tight text-on-surface">
            {copy.connection.title}
          </h2>
          <div class="mt-7 space-y-5">
            {copy.connection.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>
      </div>
      <div class="mx-auto grid max-w-screen-2xl gap-10 px-6 pb-20 md:grid-cols-3 md:px-12 md:pb-28 md:gap-8">
        {copy.connection.facts.map((fact) => (
          <article class="border-t border-outline-variant/20 pt-6">
            <h3 class="am-text-subtitle text-on-surface">{fact.title}</h3>
            <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant"><InlineEmphasis text={fact.text} /></p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12 lg:gap-16">
        <div class="max-w-2xl lg:col-span-5">
          <p class="am-text-caption text-primary">{copy.fit.eyebrow}</p>
          <h2 class="am-text-title mt-5 italic tracking-tight text-on-surface">{copy.fit.title}</h2>
          <p class="am-text-body mt-7 leading-relaxed text-on-surface-variant"><InlineEmphasis text={copy.fit.intro} /></p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <AmaraImage
            src={houseImage}
            alt={copy.fit.imageAlt}
            profile="gallery"
            sizes="(max-width: 1023px) 100vw, 50vw"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="mx-auto grid max-w-screen-2xl gap-12 px-6 pb-20 md:px-12 md:pb-28 lg:grid-cols-2 lg:gap-20">
        <div>
          <h3 class="am-text-subtitle text-on-surface">{copy.fit.worksTitle}</h3>
          <ul class="mt-6 divide-y divide-outline-variant/10 border-t border-outline-variant/10">
            {copy.fit.works.map((item) => (
              <li class="am-text-body py-4 leading-relaxed text-on-surface-variant">{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="am-text-subtitle text-on-surface">{copy.fit.limitsTitle}</h3>
          <ul class="mt-6 divide-y divide-outline-variant/10 border-t border-outline-variant/10">
            {copy.fit.limits.map((item) => (
              <li class="am-text-body py-4 leading-relaxed text-on-surface-variant">{item}</li>
            ))}
          </ul>
        </div>
        <p class="am-text-body max-w-4xl border-l border-primary/30 bg-surface-container-low px-5 py-4 leading-relaxed text-on-surface-variant lg:col-span-2">
          {copy.fit.note}
        </p>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
        <p class="am-text-caption text-primary">{copy.location.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-4xl italic tracking-tight text-on-surface">
          {copy.location.title}
        </h2>
        <div class="mt-7 max-w-3xl space-y-5">
          {copy.location.paragraphs.map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
        </div>

        <div class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {locationLinks.map((item) => (
            <article class="border-t border-outline-variant/20 pt-6">
              <h3 class="am-text-subtitle text-on-surface">{item.label}</h3>
              <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant"><InlineEmphasis text={item.text} /></p>
              <a class="am-cta-link mt-6 inline-block" href={item.href}>{item.label}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="availability" class="scroll-mt-32 border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="max-w-2xl lg:col-span-5">
            <p class="am-text-caption text-primary">{copy.booking.eyebrow}</p>
            <h2 class="am-text-title mt-5 italic tracking-tight text-on-surface">
              {copy.booking.title}
            </h2>
            <div class="mt-7 space-y-5">
              {copy.booking.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
            <div class="mt-9 flex flex-wrap gap-4">
              <a class="am-btn am-btn--primary" href={links.enquiry}>{copy.booking.primaryCta}</a>
              <a class="am-btn am-btn--secondary" href={links.stays}>{copy.booking.secondaryCta}</a>
            </div>
          </div>

          <div class="space-y-10 lg:col-span-6 lg:col-start-7">
            {copy.booking.steps.map((step) => (
              <div class="flex items-start gap-8 border-t border-outline-variant/15 pt-7">
                <span class="am-text-display select-none italic leading-none text-outline">{step.num}</span>
                <div class="pt-2">
                  <h3 class="am-text-caption text-on-surface">{step.headline}</h3>
                  <p class="am-text-body mt-3 max-w-md leading-relaxed text-on-surface-variant"><InlineEmphasis text={step.text} /></p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto max-w-screen-xl px-6 py-20 md:px-12 md:py-28">
        <h2 class="am-text-title max-w-3xl italic tracking-tight text-on-surface">{copy.faq.title}</h2>
        <div class="mt-12 divide-y divide-outline-variant/10 border-y border-outline-variant/10">
          {copy.faq.items.map((item) => (
            <details class="group py-6 md:py-8">
              <summary class="am-accordion__trigger items-center">
                <span class="am-text-caption pr-6 text-on-surface transition-colors group-hover:text-primary">
                  {item.question}
                </span>
                <span class="am-accordion__indicator" aria-hidden="true">
                  <span class="group-open:hidden">+</span>
                  <span class="hidden group-open:inline">−</span>
                </span>
              </summary>
              <p class="am-text-body max-w-3xl pt-5 leading-relaxed text-on-surface-variant md:pt-7">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface px-6 py-20 text-center md:px-12 md:py-28">
      <div class="mx-auto max-w-3xl">
        <h2 class="am-text-title italic tracking-tight text-on-surface">{copy.closing.title}</h2>
        <p class="am-text-body mx-auto mt-7 max-w-2xl leading-relaxed text-on-surface-variant">
          {copy.closing.text}
        </p>
        <a class="am-btn am-btn--primary mt-9" href={links.enquiry}>{copy.closing.cta}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
