---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);

const seo: AmaraAuthoringSeo = {
  version: '2026-03-24-legal-content-v1.0-C',
  pageType: 'C',
  entityKey: 'amara-brand',
  languages: {
    en: {
      title: 'AMARA Legal Notice & Privacy Policy',
      description: 'Legal notice, rental licenses, and privacy policy. Including compliance information for Andalusia and GDPR.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    de: {
      title: 'AMARA Impressum & Datenschutzerklärung',
      description: 'Impressum, Lizenzen und Datenschutz. Inklusive Pflichtangaben nach TMG/DDG und andalusischem Tourismusrecht.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    es: {
      title: 'AMARA Aviso legal y política de privacidad',
      description: 'Aviso legal, licencias y privacidad. Cumplimiento con LSSI-CE y normativa turística de Andalucía.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    nl: {
      title: 'AMARA Juridische informatie & privacybeleid',
      description: 'Juridische info, licenties en privacy. Conform Spaanse en Europese regelgeving.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    sv: {
      title: 'AMARA Juridisk information & integritetspolicy',
      description: 'Juridisk info, licenser och integritet. Enligt spanska och europeiska regler.',
      robots: 'index, follow',
      canonical: 'auto'
    }
  }
};

const linkClass = 'am-inline-link';
const specsClass = 'space-y-4 text-on-surface-variant am-text-body';
const specsItemClass = 'grid gap-2 md:grid-cols-[minmax(0,18rem)_1fr]';
const cardClass = 'bg-surface-container-lowest border border-outline-variant/10 px-8 py-8 md:px-10 md:py-10';

const heroCopy = {
  en: {
    subtitle: 'Transparency matters.',
    title: 'Legal Notice & Privacy Policy',
    lead: 'Applicable to amara-lodging.es and associated subpages.'
  },
  de: {
    subtitle: 'Transparenz gehört dazu.',
    title: 'Impressum & Datenschutz&shy;erklärung',
    lead: 'Gültig für amara-lodging.es und zugehörige Unterseiten.'
  },
  es: {
    subtitle: 'La transparencia importa.',
    title: 'Aviso legal y política de privacidad',
    lead: 'Aplicable a amara-lodging.es y sus subpáginas.'
  },
  nl: {
    subtitle: 'Transparantie hoort erbij.',
    title: 'Juridische kennisgeving & Privacybeleid',
    lead: "Van toepassing op amara-lodging.es en subpagina's."
  },
  sv: {
    subtitle: 'Transparens är viktigt.',
    title: 'Juridisk information & Integritets&shy;policy',
    lead: 'Gäller för amara-lodging.es och undersidor.'
  }
}[currentLang];
---

<BaseLayout seo={seo} pageLang={currentLang}>
  <Navigation
    currentLang={currentLang}
    languageToken="legal_notice"
  />

  <div class="bg-white" data-am-page="legal-notice">
    <div class="w-full max-w-[1400px] mx-auto px-[5vw]" data-lang={currentLang}>
      <TrustHero
        subtitle={heroCopy.subtitle}
        title={heroCopy.title}
        lead={heroCopy.lead}
      />

      <div class="max-w-screen-lg mx-auto pb-28">
      {currentLang === 'en' && (
        <main id="am-main-content" tabindex="-1" lang="en" aria-label="Legal (EN)" class="legal-notice-formal-headings space-y-16 scroll-mt-[104px] lg:scroll-mt-[112px]">
          <section class="space-y-6" aria-label="Responsible party">
            <h2 class="am-text-title italic text-on-surface">Responsible for this Website</h2>
            <div class={cardClass}>
              <ul class={specsClass} aria-label="Contact details">
                <li class={specsItemClass}><strong class="text-on-surface">Name</strong> <span>Robert Sebastian Böhmer</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Address</strong> <span>C./ Chorruelo 5, 29788 Frigiliana, Spain</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Spanish Tax ID (NIE)</strong> <span>Y 77 66 788 R</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Status</strong> <span>Private Host – Not registered in the commercial register</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Country</strong> <span>Spain</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Email</strong> <span><a class={linkClass} href="mailto:hola@amara-lodging.es">hola@amara-lodging.es</a></span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Phone</strong> <span><a class={linkClass} href="tel:+34604440964">+34 604 440 964</a></span></li>
              </ul>
            </div>
          </section>

          <section class="space-y-6" aria-label="Licenses">
            <h2 class="am-text-title italic text-on-surface">Rental Licenses &amp; Registrations</h2>
            <div class="space-y-6">
              <div class={cardClass}>
                <h3 class="am-text-subtitle italic text-on-surface mb-6">Nerja</h3>
                <ul class={specsClass}>
                  <li class={specsItemClass}><strong class="text-on-surface">Regional License</strong> <span>VFT/MA/19212</span></li>
                  <li class={specsItemClass}><strong class="text-on-surface">Registration (NRUA)</strong> <span><code class="break-all font-mono am-text-body text-on-surface">ESFCTU0000290130000818750000000000000000VUT/MA/192120</code></span></li>
                </ul>
              </div>
              <div class={cardClass}>
                <h3 class="am-text-subtitle italic text-on-surface mb-6">Frigiliana</h3>
                <ul class={specsClass}>
                  <li class={specsItemClass}><strong class="text-on-surface">Regional License</strong> <span>A/MA/01767</span></li>
                  <li class={specsItemClass}><strong class="text-on-surface">Registration (NRUA)</strong> <span>Not required (License Class 'A')</span></li>
                </ul>
              </div>
              <div class={cardClass}>
                <h3 class="am-text-subtitle italic text-on-surface mb-6">Tarifa</h3>
                <ul class={specsClass}>
                  <li class={specsItemClass}><strong class="text-on-surface">Regional License</strong> <span>VFT/CA/17038</span></li>
                  <li class={specsItemClass}><strong class="text-on-surface">Registration (NRUA)</strong> <span><code class="break-all font-mono am-text-body text-on-surface">ESFCTU0000110140004256770000000000000000VFT/CA/170387</code></span></li>
                </ul>
              </div>
            </div>
            <p class="am-text-body text-on-surface-variant italic">Private holiday rental. Not a registered company.</p>
          </section>

          <section class="space-y-6" aria-label="Consumer protection">
            <h2 class="am-text-title italic text-on-surface">Consumer Protection</h2>
            <div class={cardClass}>
              <div class="space-y-6">
                <p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Complaint Forms (Andalusia):</strong><br />Official complaint forms (Hojas de Quejas y Reclamaciones) of the Junta de Andalucía are available to consumers upon request.</p>
                <p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Dispute resolution:</strong><br />The former European Online Dispute Resolution platform was discontinued on July 20, 2025. We are neither obliged nor willing to participate in dispute resolution proceedings before a consumer arbitration board.</p>
              </div>
            </div>
          </section>

          <section class="space-y-6" aria-label="Privacy Policy">
            <h2 class="am-text-title italic text-on-surface">Privacy Policy</h2>
            <p class="am-text-body text-on-surface-variant">Last updated: <strong class="text-on-surface">August 12, 2026</strong></p>
            <div class={cardClass}>
              <div class="space-y-8">
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">1. General Information</h3><p class="am-text-body text-on-surface-variant">We process personal data (e.g., name, contact details, payment info) primarily to fulfill the rental agreement (Art. 6(1)(b) GDPR) and to comply with legal obligations (Art. 6(1)(c) GDPR).</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">2. Website Hosting &amp; Booking Software</h3><p class="am-text-body text-on-surface-variant">The public website is delivered via <strong class="text-on-surface">Cloudflare Pages (Cloudflare, Inc.)</strong>. The separate booking system at <strong class="text-on-surface">amara.lodgify.com</strong> is provided by <strong class="text-on-surface">Lodgify (Codebay Solutions Ltd.)</strong>. The providers process the technical data required to operate their respective services.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">3. Payment Processing (Stripe &amp; PayPal)</h3><p class="am-text-body text-on-surface-variant">For payments, we use <strong class="text-on-surface">Stripe</strong> and <strong class="text-on-surface">PayPal</strong>. These providers act as <strong class="text-on-surface">independent Data Controllers</strong> for financial transactions and fraud prevention.</p><p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Third-Country Transfer:</strong> Usage includes the transfer of data to third countries (e.g., USA). This is secured by Standard Contractual Clauses (SCCs) and/or the EU-US Data Privacy Framework.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">4. Contact by Email or Phone</h3><p class="am-text-body text-on-surface-variant">When you contact us by email or phone, we process the details you provide in order to respond. Legal basis: Art. 6(1)(b) (pre-contractual measures) and Art. 6(1)(f) (legitimate interest) GDPR.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">5. Legal Obligations &amp; Guest Registration (Chekin)</h3><p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Obligation:</strong> Under Spanish law (Real Decreto 933/2021), we are required to report guest data (including ID details) to the Ministry of the Interior (Ses.Hospedajes) within 24 hours of arrival.</p><p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Service Used:</strong> To fulfill this obligation and automate the check-in process, we use <strong class="text-on-surface">Chekin (Chekin Soluciones Digitales S.L.)</strong>. Chekin acts as a <strong class="text-on-surface">Data Processor</strong> (Art. 28 GDPR), securely scanning ID documents and transmitting the required data to authorities.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">6. Cookies &amp; Google Analytics</h3><p class="am-text-body text-on-surface-variant">We use Google Analytics 4 (GA4), a web analytics service provided by Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Ireland, on our public website. Google Analytics helps us understand how our website is used, how visitors reach AMARA, and which content and booking paths are used. This may include page views, session and interaction data, the AMARA language edition used, approximate location information, and browser and device information.</p><p class="am-text-body text-on-surface-variant">Google Analytics is activated on our website only after you have given your consent. The legal basis is Art. 6(1)(a) GDPR together with the applicable rules on non-essential cookies. If you do not consent, the website, including links to our booking system, remains available. You may change or withdraw your choice at any time through the cookie settings with effect for the future.</p><p class="am-text-body text-on-surface-variant">After consent, Google Analytics may use first-party cookies including _ga to distinguish users and _ga_&lt;container-id&gt; to maintain session state. Google specifies a default lifetime of up to two years for these cookies, although browser restrictions or our configuration may shorten this period. User- and event-level data in our Google Analytics property is retained for 14 months.</p><p class="am-text-body text-on-surface-variant">Google may technically process an IP address during data collection, including to derive approximate geographical information. For users in the European Economic Area, Google states that the IP address is discarded before it is logged. Data may also be processed outside the European Economic Area in connection with the provision of Google Analytics. Depending on the processing involved, Google refers to safeguards including the EU-US Data Privacy Framework and Standard Contractual Clauses.</p><p class="am-text-body text-on-surface-variant">Our separately hosted booking system at amara.lodgify.com is provided by Lodgify and uses its own cookie and consent mechanism. If you accept analytics cookies there, Lodgify's native Google Analytics integration may send usage and booking events to the same AMARA Google Analytics property. Consent on the AMARA website and consent within the Lodgify booking environment are technically managed separately.</p><p class="am-text-body text-on-surface-variant">The trailer on our Netflix filming-locations page is embedded from YouTube (Google Ireland Limited) and is loaded only after you explicitly start it. Our internal guest guide also retrieves weather information from Open-Meteo. The privacy information described or linked in this section applies to these services.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">7. Your Rights</h3><p class="am-text-body text-on-surface-variant">Subject to the applicable legal requirements, you have the right to access, rectification, erasure, restriction of processing, data portability and objection. Where processing is based on your consent, you may withdraw that consent at any time with effect for the future, without affecting the lawfulness of processing carried out before the withdrawal. You also have the right to lodge a complaint with a competent data protection supervisory authority, in particular the Spanish Data Protection Agency (Agencia Española de Protección de Datos – AEPD).</p><ul class={specsClass} aria-label="Privacy contact"><li class={specsItemClass}><strong class="text-on-surface">Privacy Contact</strong> <span><a class={linkClass} href="mailto:hola@amara-lodging.es">hola@amara-lodging.es</a></span></li></ul></div>
              </div>
            </div>
          </section>
        </main>
      )}

      {currentLang === 'de' && (
        <main id="am-main-content" tabindex="-1" lang="de" aria-label="Rechtliches (DE)" class="legal-notice-formal-headings space-y-16 scroll-mt-[104px] lg:scroll-mt-[112px]">
          <section class="space-y-6" aria-label="Verantwortlich">
            <h2 class="am-text-title italic text-on-surface">Verantwortlich für diese Website</h2>
            <div class={cardClass}>
              <ul class={specsClass} aria-label="Kontaktdaten">
                <li class={specsItemClass}><strong class="text-on-surface">Name</strong> <span>Robert Sebastian Böhmer</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Anschrift</strong> <span>C./ Chorruelo 5, 29788 Frigiliana, Spanien</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Spanische Steuer-ID (NIE)</strong> <span>Y 77 66 788 R</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Status</strong> <span>Privatvermieter – Keine Eintragung im Handelsregister</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Land</strong> <span>Spanien</span></li>
                <li class={specsItemClass}><strong class="text-on-surface">E-Mail</strong> <span><a class={linkClass} href="mailto:hola@amara-lodging.es">hola@amara-lodging.es</a></span></li>
                <li class={specsItemClass}><strong class="text-on-surface">Telefon</strong> <span><a class={linkClass} href="tel:+34604440964">+34 604 440 964</a></span></li>
              </ul>
            </div>
          </section>
          <section class="space-y-6" aria-label="Lizenzen">
            <h2 class="am-text-title italic text-on-surface">Vermietungs&shy;lizenzen &amp; Registrierungen</h2>
            <div class="space-y-6">
              <div class={cardClass}>
                <h3 class="am-text-subtitle italic text-on-surface mb-6">Nerja</h3>
                <ul class={specsClass}>
                  <li class={specsItemClass}><strong class="text-on-surface">Regionale Lizenz</strong> <span>VFT/MA/19212</span></li>
                  <li class={specsItemClass}><strong class="text-on-surface">Registrierung (NRUA)</strong> <span><code class="break-all font-mono am-text-body text-on-surface">ESFCTU0000290130000818750000000000000000VUT/MA/192120</code></span></li>
                </ul>
              </div>
              <div class={cardClass}>
                <h3 class="am-text-subtitle italic text-on-surface mb-6">Frigiliana</h3>
                <ul class={specsClass}>
                  <li class={specsItemClass}><strong class="text-on-surface">Regionale Lizenz</strong> <span>A/MA/01767</span></li>
                  <li class={specsItemClass}><strong class="text-on-surface">Registrierung (NRUA)</strong> <span>Nicht erforderlich (Lizenzklasse 'A')</span></li>
                </ul>
              </div>
              <div class={cardClass}>
                <h3 class="am-text-subtitle italic text-on-surface mb-6">Tarifa</h3>
                <ul class={specsClass}>
                  <li class={specsItemClass}><strong class="text-on-surface">Regionale Lizenz</strong> <span>VFT/CA/17038</span></li>
                  <li class={specsItemClass}><strong class="text-on-surface">Registrierung (NRUA)</strong> <span><code class="break-all font-mono am-text-body text-on-surface">ESFCTU0000110140004256770000000000000000VFT/CA/170387</code></span></li>
                </ul>
              </div>
            </div>
            <p class="am-text-body text-on-surface-variant italic">Private Ferienvermietung. Kein eingetragenes Unternehmen, kein Handelsregistereintrag.</p>
          </section>
          <section class="space-y-6" aria-label="Verbraucherschutz">
            <h2 class="am-text-title italic text-on-surface">Verbraucherschutz &amp; Streitbeilegung</h2>
            <div class={cardClass}>
              <div class="space-y-6">
                <p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Beschwerdeformulare (Andalusien):</strong><br />Offizielle Beschwerdeformulare (Hojas de Quejas y Reclamaciones) der Junta de Andalucía stehen Verbrauchern auf Anfrage zur Verfügung.</p>
                <p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Streitbeilegung (VSBG):</strong><br />Wir sind zur Teilnahme an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle weder verpflichtet noch bereit.</p>
              </div>
            </div>
          </section>
          <section class="space-y-6" aria-label="Datenschutz">
            <h2 class="am-text-title italic text-on-surface">Datenschutz&shy;erklärung</h2>
            <p class="am-text-body text-on-surface-variant">Stand: <strong class="text-on-surface">12.08.2026</strong></p>
            <div class={cardClass}>
              <div class="space-y-8">
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">1. Allgemeines</h3><p class="am-text-body text-on-surface-variant">Wir verarbeiten personenbezogene Daten (z.B. Name, Kontakt, Zahlung) vorrangig zur Erfüllung des Mietvertrags (Art. 6 Abs. 1 lit. b DSGVO) und gesetzlicher Pflichten (Art. 6 Abs. 1 lit. c DSGVO).</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">2. Website-Hosting &amp; Buchungssoftware</h3><p class="am-text-body text-on-surface-variant">Die öffentliche Website wird über <strong class="text-on-surface">Cloudflare Pages (Cloudflare, Inc.)</strong> bereitgestellt. Das separate Buchungssystem unter <strong class="text-on-surface">amara.lodgify.com</strong> wird von <strong class="text-on-surface">Lodgify (Codebay Solutions Ltd.)</strong> betrieben. Die Anbieter verarbeiten die technischen Daten, die für den Betrieb des jeweiligen Dienstes erforderlich sind.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">3. Zahlungsabwicklung (Stripe &amp; PayPal)</h3><p class="am-text-body text-on-surface-variant">Für Zahlungen nutzen wir <strong class="text-on-surface">Stripe</strong> und <strong class="text-on-surface">PayPal</strong>. Diese Anbieter fungieren als <strong class="text-on-surface">eigenständige Verantwortliche</strong> für die Durchführung von Finanztransaktionen und Betrugsprävention.</p><p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Drittlandtransfer:</strong> Die Nutzung beinhaltet die Übermittlung von Daten in Drittländer (z.B. USA). Dies wird durch Standardvertragsklauseln (SCCs) und/oder das EU-US Data Privacy Framework abgesichert.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">4. Kontakt per E-Mail oder Telefon</h3><p class="am-text-body text-on-surface-variant">Wenn Sie uns per E-Mail oder Telefon kontaktieren, verarbeiten wir die von Ihnen mitgeteilten Angaben zur Beantwortung. Rechtsgrundlage sind Art. 6 Abs. 1 lit. b (vorvertragliche Maßnahmen) und lit. f (berechtigtes Interesse) DSGVO.</p><p class="am-text-body text-on-surface-variant">Wir löschen die Daten, sobald die Anfrage geklärt ist und keine gesetzlichen Aufbewahrungsfristen entgegenstehen.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">5. Meldepflichten &amp; Gästeregistrierung (Chekin)</h3><p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Pflicht:</strong> Aufgrund spanischer Gesetzgebung (Real Decreto 933/2021) sind wir verpflichtet, Gästedaten (inkl. Ausweisdaten) innerhalb von 24 Stunden nach Ankunft an das Zentralregister des Innenministeriums (Ses.Hospedajes) zu übermitteln.</p><p class="am-text-body text-on-surface-variant"><strong class="text-on-surface">Eingesetztes Tool:</strong> Zur Erfüllung dieser Pflicht und zur Automatisierung des Check-ins nutzen wir den Dienst <strong class="text-on-surface">Chekin (Chekin Soluciones Digitales S.L.)</strong>. Chekin agiert als <strong class="text-on-surface">Auftragsverarbeiter</strong> (Art. 28 DSGVO), der Ausweisdokumente sicher scannt und die erforderlichen Daten an die Behörden übermittelt.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">6. Cookies &amp; Google Analytics</h3><p class="am-text-body text-on-surface-variant">Wir verwenden auf unserer öffentlichen Website Google Analytics 4 (GA4), einen Webanalysedienst von Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irland. Google Analytics hilft uns zu verstehen, wie unsere Website genutzt wird, über welche Quellen Besucher zu AMARA gelangen und welche Inhalte und Buchungswege genutzt werden. Dazu können insbesondere Seitenaufrufe, Sitzungs- und Interaktionsdaten, die verwendete Sprachversion, ungefähre Standortinformationen sowie Browser- und Geräteinformationen verarbeitet werden.</p><p class="am-text-body text-on-surface-variant">Google Analytics wird auf unserer Website nur nach Ihrer Einwilligung aktiviert. Rechtsgrundlage ist Art. 6 Abs. 1 lit. a DSGVO in Verbindung mit den anwendbaren Vorschriften über den Einsatz nicht erforderlicher Cookies. Wenn Sie nicht zustimmen, bleibt die Website einschließlich der Links zum Buchungssystem nutzbar. Sie können Ihre Entscheidung jederzeit über die Cookie-Einstellungen mit Wirkung für die Zukunft ändern oder widerrufen.</p><p class="am-text-body text-on-surface-variant">Google Analytics verwendet nach erteilter Einwilligung insbesondere eigene Cookies wie _ga zur Unterscheidung von Nutzern und _ga_&lt;container-id&gt; zur Speicherung des Sitzungsstatus. Google gibt hierfür standardmäßig eine Speicherdauer von bis zu zwei Jahren an; Browserbeschränkungen oder unsere Einstellungen können zu einer kürzeren Dauer führen. Nutzer- und Ereignisdaten in unserer Google-Analytics-Property werden für 14 Monate aufbewahrt.</p><p class="am-text-body text-on-surface-variant">Bei der Datenerhebung kann Google die IP-Adresse technisch verarbeiten, unter anderem zur Ableitung einer ungefähren geografischen Region. Für Nutzer im Europäischen Wirtschaftsraum wird die IP-Adresse nach Angaben von Google vor der Protokollierung verworfen. Google kann Daten im Rahmen der Bereitstellung von Google Analytics auch außerhalb des Europäischen Wirtschaftsraums verarbeiten. Google nennt hierfür je nach Verarbeitung insbesondere das EU-US Data Privacy Framework und Standardvertragsklauseln als Übermittlungsmechanismen.</p><p class="am-text-body text-on-surface-variant">Unser separat betriebenes Buchungssystem unter amara.lodgify.com wird von Lodgify bereitgestellt und verfügt über ein eigenes Cookie- und Einwilligungssystem. Wenn Sie dort Analyse-Cookies akzeptieren, kann Lodgifys native Google-Analytics-Integration Nutzungs- und Buchungsereignisse an dieselbe AMARA-Google-Analytics-Property übertragen. Die Einwilligungsentscheidung auf unserer AMARA-Website und die Einwilligung innerhalb der Lodgify-Buchungsumgebung werden technisch getrennt verwaltet.</p><p class="am-text-body text-on-surface-variant">Der Trailer auf unserer Seite zu den Netflix-Drehorten ist von YouTube (Google Ireland Limited) eingebunden und wird erst geladen, nachdem Sie ihn ausdrücklich starten. Unser interner Gäste-Guide nutzt außerdem eine Wettervorhersage von Open-Meteo. Für diese Dienste gelten die jeweils in diesem Abschnitt beschriebenen bzw. verlinkten Datenschutzinformationen.</p></div>
                <div class="space-y-4"><h3 class="am-text-subtitle italic text-on-surface">7. Betroffenenrechte</h3><p class="am-text-body text-on-surface-variant">Sie haben – soweit die jeweiligen gesetzlichen Voraussetzungen vorliegen – das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung, Datenübertragbarkeit sowie Widerspruch gegen die Verarbeitung. Soweit eine Verarbeitung auf Ihrer Einwilligung beruht, können Sie diese jederzeit mit Wirkung für die Zukunft widerrufen, ohne dass dadurch die Rechtmäßigkeit der bis zum Widerruf erfolgten Verarbeitung berührt wird. Sie haben außerdem das Recht, Beschwerde bei einer zuständigen Datenschutzaufsichtsbehörde einzulegen, insbesondere bei der Agencia Española de Protección de Datos (AEPD).</p><ul class={specsClass} aria-label="Datenschutz Kontakt"><li class={specsItemClass}><strong class="text-on-surface">Datenschutz-Kontakt</strong> <span><a class={linkClass} href="mailto:hola@amara-lodging.es">hola@amara-lodging.es</a></span></li></ul></div>
