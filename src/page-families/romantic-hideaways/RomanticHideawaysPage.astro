const optionalLink = (token: string) =>
  resolveOptionalLink(token, currentLang, { suppressMissing: true });
const collectionHref = '#booking';
const directBookingHref = optionalLink('direct_booking_benefits');
const reviewsHref = optionalLink('reviews_hub');
const faqHref = optionalLink('faq_general');
const comparisonHref = optionalLink('nerja_vs_frigiliana');
const decisionItems = copy.decisionItems[currentLang] ?? copy.decisionItems.en;
const faqItems = copy.faqItems[currentLang] ?? copy.faqItems.en;

const locationBridgeLinks = [
  { href: buildOwnedLocalizedPath('frigiliana-location', currentLang), label: t(copy.locationFrigiliana) },
  { href: buildOwnedLocalizedPath('frigiliana-parking', currentLang), label: t(copy.locationParking) },
  { href: buildOwnedLocalizedPath('frigiliana-weather', currentLang), label: t(copy.locationWeather) }
];

type ApartmentBase = Omit<
  (typeof apartments)[number],
  'imageSrc' | 'imageAlt' | 'meta' | 'title' | 'description' | 'ctaLabel'
>;
type ApartmentWithHref = ApartmentBase &
  LocalizedApartmentCopy & {
    href: string;
    image: ImageMetadata;
  };
const apartmentRows = apartments.map((apt) => {
    const href = optionalLink(apt.token);
    if (!href) return null;

    return {
      token: apt.token,
      ...apartmentCopy[apt.token],
      href,
      image: apartmentImages[apt.token]
    };
  });
const apartmentsWithLinks: ApartmentWithHref[] = apartmentRows.filter(
  (apt): apt is ApartmentWithHref => Boolean(apt)
);
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    brandName="AMARA"
    links={trustLinks}
    variant="trust"
    languageToken="romantic_hideaways"
  />

  <div class="am-root bg-surface min-h-screen relative overflow-hidden" data-am-page="romantic-hideaways">
    <div class="am-wrap w-full max-w-screen-2xl mx-auto px-6 md:px-12 pb-20">
      <section class="pt-8 pb-16 md:pb-24 relative z-10">
        <TrustHero
          subtitle={t(copy.heroSubtitle)}
          title={t(copy.heroTitleHtml)}
          lead={t(copy.heroLead)}
          ctaLinks={[]}
        />

        <div class="max-w-2xl space-y-5 mt-8 am-text-body text-on-surface-variant leading-relaxed">
          {
            tArr(copy.prose).map((html) => (
              <p set:html={html} />
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-4 mt-8">
          <a class="am-btn am-btn--primary" href={collectionHref}>{t(copy.ctaCollection)}</a>
          {
            reviewsHref ? (
              <a class="am-btn am-btn--secondary" href={reviewsHref}>{t(copy.ctaReviews)}</a>
            ) : (
              <span class="am-btn am-btn--secondary am-is-disabled" aria-disabled="true">{t(copy.ctaReviews)}</span>
            )
          }
        </div>

        <div
          class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-12 pt-8 border-t border-border-subtle am-text-body text-on-surface-variant"
          id="direct-booking"
        >
          <span>{t(copy.trustBooking)}</span>
          <span>{t(copy.trustAirbnb)}</span>
          {
            directBookingHref ? (
              <a class="am-inline-link" href={directBookingHref}>{t(copy.trustDirect)}</a>
            ) : (
              <span class="am-inline-link am-is-disabled" aria-disabled="true">{t(copy.trustDirect)}</span>
            )
          }
        </div>
      </section>

      <section
        class="py-14 md:py-20 border-t border-border-subtle relative z-10"
        aria-labelledby="decision-title"
      >
        <div
          class:list={[
            'grid gap-10 lg:items-start',
            currentLang === 'de'
              ? 'lg:grid-cols-1'
              : 'lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]'
          ]}
        >
          <div class="max-w-2xl">
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">
              {t(copy.decisionEyebrow)}
            </p>
            <h2 id="decision-title" class="am-text-title tracking-tight mt-4">
              {t(copy.decisionTitle)}
            </h2>
            <p class="am-text-body text-on-surface-variant mt-5 leading-relaxed">
              {t(copy.decisionIntro)}
            </p>
            {
              currentLang === 'de' && comparisonHref && (
                <a class="am-cta-link mt-7 inline-flex" href={comparisonHref}>
                  Ausführlicher Vergleich: Frigiliana oder Nerja
                </a>
              )
            }
          </div>

          {
            currentLang !== 'de' && (
              <div class="grid gap-8 md:grid-cols-3">
                {decisionItems.map((item) => (
                  <article class="border-t border-border-subtle pt-5">
                    <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-primary">
                      {item.kicker}
                    </p>
                    <h3 class="am-text-subtitle text-on-surface mt-4">
                      {item.title}
                    </h3>
                    <p class="am-text-body text-on-surface-variant mt-3 leading-relaxed">
                      {item.body}
                    </p>
                  </article>
                ))}
              </div>
            )
          }
        </div>
      </section>

      <section
        id="booking"
        class="scroll-mt-36 md:scroll-mt-40 py-16 md:py-24 border-t border-border-subtle relative z-10"
        aria-labelledby="collection-title"
      >
        <div class="flex flex-col gap-6 max-w-3xl">
          <h2 id="collection-title" class="am-text-title tracking-tight">{t(copy.collectionTitle)}</h2>
          <p class="am-text-body text-on-surface-variant">{t(copy.collectionIntro)}</p>
        </div>

        <ApartmentGrid>
          {
            apartmentsWithLinks.map((apt) => (
              <ApartmentCard
                href={apt.href}
                imageSrc={apt.image}
                imageAlt={t(apt.imageAlt)}
                loading={['farah', 'lounis', 'zaid'].includes(apt.token) ? 'eager' : 'lazy'}
                meta={t(apt.meta)}
                title={t(apt.title)}
                description={t(apt.description)}
                ctaLabel={t(apt.ctaLabel)}
              />
            ))
          }
        </ApartmentGrid>
      </section>

      <section class="py-14 md:py-20 border-t border-border-subtle relative z-10" aria-labelledby="location-bridge-title">
        <div class="max-w-3xl">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">
            {t(copy.locationBridgeEyebrow)}
          </p>
          <h2 id="location-bridge-title" class="am-text-title tracking-tight mt-4">
            {t(copy.locationBridgeTitle)}
          </h2>
          <p class="am-text-body text-on-surface-variant mt-5 leading-relaxed">
            {t(copy.locationBridgeBody)}
          </p>
          <div class="flex flex-wrap gap-3 mt-7">
            {
              locationBridgeLinks.map((link) => (
                <a class="am-btn am-btn--secondary" href={link.href}>{link.label}</a>
              ))
            }
          </div>
        </div>
      </section>

      <section
        class="am-romantic-faq py-14 md:py-20 border-t border-border-subtle relative z-10"
        aria-labelledby="romantic-faq-title"
      >
        <div class="max-w-3xl">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">
            {t(copy.faqEyebrow)}
          </p>
          <h2 id="romantic-faq-title" class="am-text-title tracking-tight mt-4">
            {t(copy.faqTitle)}
          </h2>
          <p class="am-text-body text-on-surface-variant mt-5 leading-relaxed">
            {t(copy.faqIntro)}
          </p>
        </div>

        <div class="mt-10 divide-y divide-border-subtle border-t border-border-subtle">
          {
            faqItems.map((item) => (
              <details class="group py-6">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
                  <h3 class="am-text-subtitle text-on-surface">
                    {item.question}
                  </h3>
                  <span class="text-on-surface-variant text-xl leading-none" aria-hidden="true">
                    <span class="group-open:hidden">+</span>
                    <span class="hidden group-open:inline">-</span>
                  </span>
                </summary>
                <p class="am-text-body text-on-surface-variant mt-4 max-w-3xl leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>

        {
          faqHref && (
            <a class="am-btn am-btn--secondary mt-8" href={faqHref}>
              {t(copy.faqCta)}
            </a>
          )
        }
      </section>

      {
        reviewsHref && (
          <GuestReviewsSummary
            eyebrow={t(copy.reviewsEyebrow)}
            headline={t(copy.reviewsHeadline)}
            body={t(copy.reviewsBody)}
            reviewsHref={reviewsHref}
            reviewsCtaLabel={t(copy.reviewsCta)}
            features={featureChipsByLang[currentLang]}
          />
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .am-romantic-faq summary::-webkit-details-marker {
    display: none;
  }
</style>
