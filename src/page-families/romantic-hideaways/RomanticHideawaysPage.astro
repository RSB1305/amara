  heroTitleHtml: {
    en: 'Boutique apartments for couples <br />Frigiliana &amp; Nerja',
    de: 'Ferienunterkünfte für Paare <br />in Frigiliana, Nerja &amp; Tarifa',
    es: 'Apartamentos boutique para parejas <br />Frigiliana y Nerja',
