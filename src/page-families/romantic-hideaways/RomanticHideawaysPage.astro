      },
      {
        kicker: 'Kust van Nerja',
        title: 'Voor twee gasten dicht bij het strand',
        body: 'Playa ligt op 100 meter van het strand van Torrecilla en heeft een volledige keuken en wasmachine voor het dagelijks verblijf in Nerja.'
      },
      {
        kicker: 'Meer ruimte in Tarifa',
        title: 'Voor een gezin of maximaal vier gasten',
        body: 'Family & Surf heeft twee slaapkamers, twee badkamers, een zwembad, een gereserveerde garageplaats en een terras aan de Atlantische Oceaan.'
      }
    ],
    sv: [
      {
        kicker: 'Frigilianas gamla stad',
