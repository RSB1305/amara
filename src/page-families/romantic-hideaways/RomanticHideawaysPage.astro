const t = <T extends Record<AmaraLanguage, string>>(row: T) => row[currentLang] ?? row.en;


const footerHighlights: LabeledLink[] = [
  {
    token: 'casa_amara_groups',
    label: t({
      en: 'Casa AMARA for 4–8',
      de: 'Casa AMARA für 4–8',
      es: 'Casa AMARA para 4–8',
      nl: 'Casa AMARA voor 4–8',
      sv: 'Casa AMARA för 4–8'
    })
  },
  { token: 'amenities', label: t(comfortAmenitiesLinkLabel) },
  { token: 'faq_general', label: t({ en: 'Stay FAQ', de: 'Aufenthalts-FAQ', es: 'FAQ de la estancia', nl: 'Verblijfs-FAQ', sv: 'FAQ för vistelsen' }) },
  { token: 'honeymoon', label: t({ en: 'Honeymoon in Andalusia', de: 'Flitterwochen in Andalusien', es: 'Luna de miel en Andalucía', nl: 'Huwelijksreis in Andalusië', sv: 'Smekmånad i Andalusien' }) },
  { token: 'wedding_anniversary', label: t({ en: 'Wedding anniversary in Andalusia', de: 'Hochzeitstag in Andalusien', es: 'Aniversario de boda en Andalucía', nl: 'Huwelijksverjaardag in Andalusië', sv: 'Bröllopsdag i Andalusien' }) }
];

