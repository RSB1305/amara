type CopyRow = Record<AmaraLanguage, string>;
type DecisionItem = {
  kicker: string;
  title: string;
  body: string;
};
type FaqItem = {
  question: string;
  answer: string;
};
type GermanProofItem = {
  title: string;
  body: string;
};

const bookingAwardCount =
  guestReviewsCopy.awards.frigiliana.length + guestReviewsCopy.awards.coast.length;

