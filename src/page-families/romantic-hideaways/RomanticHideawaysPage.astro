  bedSize: {
    en: '200 × 200 cm bed',
    de: 'Bett: 200 × 200 cm',
    es: 'Cama de 200 × 200 cm',
    nl: 'Bed van 200 × 200 cm',
    sv: 'Säng: 200 × 200 cm'
  },
  noInternalStairs: {
    en: 'No stairs inside the apartment',
    de: 'Keine Stufen im Apartment',
    es: 'Sin escaleras dentro del apartamento',
    nl: 'Geen trappen in het appartement',
    sv: 'Inga trappor inne i lägenheten'
  },
  privatePatioAndTerrace: {
    en: 'Private patio and terrace',
    de: 'Privater Patio und private Terrasse',
    es: 'Patio y terraza privados',
    nl: 'Privépatio en privéterras',
    sv: 'Privat uteplats och terrass'
  },
  sharedPool: {
    en: 'Shared pool',
    de: 'Gemeinschaftspool',
    es: 'Piscina comunitaria',
    nl: 'Gedeeld zwembad',
    sv: 'Gemensam pool'
  },
  reservedGarage: {
    en: 'Reserved underground parking space',
    de: 'Reservierter Tiefgaragenstellplatz',
    es: 'Plaza reservada en el garaje',
    nl: 'Gereserveerde plek in de parkeergarage',
    sv: 'Reserverad garageplats'
  },
  stepFreeVillageRoute: {
    en: 'The route towards the village centre is step-free',
    de: 'Der Weg in Richtung Ortskern ist stufenlos',
    es: 'El recorrido hacia el centro del pueblo no tiene escalones',
    nl: 'De route richting het dorpscentrum is trapvrij',
    sv: 'Vägen mot bykärnan är utan trappsteg'
  }
} satisfies Record<string, CopyRow>;

type SelectionSignal =
  | 'kitchen'
  | 'washingMachine'
  | 'noWashingMachine'
  | 'twoRoomSuite'
  | 'bedSize'
  | 'outdoor'
  | 'privatePatioAndTerrace'
  | 'pool'
  | 'parking'
  | 'stepFreeVillageRoute';

const selectionSignalsByToken: Record<ApartmentToken, SelectionSignal[]> = {
  farah: ['twoRoomSuite', 'kitchen', 'outdoor', 'stepFreeVillageRoute'],
  lounis: ['kitchen', 'washingMachine', 'privatePatioAndTerrace'],
  zaid: ['kitchen', 'washingMachine', 'outdoor'],
  maha: ['kitchen', 'noWashingMachine', 'outdoor'],
  playa: ['bedSize', 'kitchen', 'washingMachine', 'outdoor'],
  casa: ['kitchen', 'washingMachine', 'pool', 'parking']
};

function amenityValue(
  rental: VacationRentalEntity,
  name: string
): VacationRentalAmenityFeature['value'] | undefined {
  return rental.amenityFeatures.find((feature) => feature.name === name)?.value;
}

function hasAmenity(rental: VacationRentalEntity, name: string): boolean {
  return amenityValue(rental, name) === true;
}

function firstSentence(text: string): string {
  const end = text.indexOf('.');
  return end === -1 ? text : text.slice(0, end + 1);
}

function selectionSignal(
  signal: SelectionSignal,
  rental: VacationRentalEntity
): string | undefined {
  switch (signal) {
    case 'kitchen':
      return rental.kitchenNote[currentLang];
    case 'washingMachine':
      return hasAmenity(rental, 'washingMachine')
        ? selectionLabels.washingMachine[currentLang]
        : undefined;
    case 'noWashingMachine':
      return !hasAmenity(rental, 'washingMachine')
        ? selectionLabels.noWashingMachine[currentLang]
        : undefined;
    case 'twoRoomSuite':
      return rental.rooms === 2 ? selectionLabels.twoRoomSuite[currentLang] : undefined;
    case 'bedSize':
      return rental.bed.some((bed) => bed.label === '200 x 200')
        ? selectionLabels.bedSize[currentLang]
        : undefined;
    case 'outdoor':
      return rental.outdoorNote[currentLang];
    case 'privatePatioAndTerrace':
      return hasAmenity(rental, 'privatePatio') && hasAmenity(rental, 'privateTerrace')
        ? selectionLabels.privatePatioAndTerrace[currentLang]
        : undefined;
    case 'pool':
      return hasAmenity(rental, 'pool') ? selectionLabels.sharedPool[currentLang] : undefined;
    case 'parking':
      return amenityValue(rental, 'parkingType') === 'ReservedUndergroundIncluded'
        ? selectionLabels.reservedGarage[currentLang]
        : undefined;
    case 'stepFreeVillageRoute':
      return rental.accessFacts.routeToVillageCore === 'step-free'
        ? selectionLabels.stepFreeVillageRoute[currentLang]
        : undefined;
  }
}

function physicalAccessSummary(token: ApartmentToken, rental: VacationRentalEntity): string {
  if (token === 'playa' || token === 'casa') return rental.accessNote[currentLang];

  const summary = token === 'zaid' && currentLang === 'sv'
    ? `Ett trappsteg vid huvudentrén och därefter ${rental.accessFacts.insideBuildingStepsToUnitOrLift} trappsteg upp till lägenheten.`
    : firstSentence(rental.accessNote[currentLang]);
  return token === 'zaid'
    ? `${summary} ${selectionLabels.noInternalStairs[currentLang]}.`
    : summary;
}

function cardDescription(token: ApartmentToken, rental: VacationRentalEntity): string {
  const lead = token === 'casa'
    ? firstSentence(rental.lead[currentLang])
    : rental.lead[currentLang];
  const signals = selectionSignalsByToken[token]
    .map((signal) => selectionSignal(signal, rental))
    .filter((value): value is string => Boolean(value));

  return `${lead} ${signals.join(' · ')}. ${physicalAccessSummary(token, rental)}`;
}

function cardCtaLabel(rental: VacationRentalEntity): string {
  const labels: Record<AmaraLanguage, string> = {
    en: `View ${rental.shortName}`,
    de: `${rental.shortName} ansehen`,
    es: `Ver ${rental.shortName}`,
    nl: `${rental.shortName} bekijken`,
    sv: `Visa ${rental.shortName}`
  };
  return labels[currentLang];
}

const optionalLink = (token: LinkToken) =>
  resolveOptionalLink(token, currentLang, { suppressMissing: true });
const collectionHref = '#booking';
const bookHref = optionalLink('book');
const directBookingHref = optionalLink('direct_booking_benefits');
const reviewsHref = optionalLink('reviews_hub');
const comparisonHref = optionalLink('nerja_vs_frigiliana');
const amenitiesHref = optionalLink('amenities');
const winterHref = optionalLink('frigiliana_winter_stays');
const decisionItems = copy.decisionItems[currentLang] ?? copy.decisionItems.en;

const locationBridgeLinks = [
  ...(comparisonHref ? [{ href: comparisonHref, label: t(copy.locationComparison) }] : []),
  ...(amenitiesHref ? [{ href: amenitiesHref, label: t(copy.ctaAmenities) }] : []),
  ...(winterHref ? [{ href: winterHref, label: t(copy.locationWinter) }] : [])
];

const apartmentRows = stayCollectionEntityKeys.map((entityKey) => {
  const rental = vacationRentalEntitiesByKey[entityKey];
  const token = rental.token;
  const href = optionalLink(token);
  if (!href) return null;

  return {
    token,
    href,
    image: apartmentImages[token],
    imageAlt: rental.imageAlt,
    meta: `${rental.city} · ${guestCountLabels[currentLang](rental.occupancy)}`,
    title: rental.name,
    description: cardDescription(token, rental),
    ctaLabel: cardCtaLabel(rental)
  };
});
const apartmentsWithLinks = apartmentRows.filter(
  (apt): apt is NonNullable<(typeof apartmentRows)[number]> => Boolean(apt)
);
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    languageToken="romantic_hideaways"
  />

  <main id="am-main-content" tabindex="-1" class="bg-surface min-h-screen relative overflow-hidden scroll-mt-[104px] lg:scroll-mt-[112px]" data-am-page="romantic-hideaways">
    <div class="w-full max-w-screen-2xl mx-auto px-6 md:px-12 pb-20">
      <section class="pt-8 pb-16 md:pb-24 relative z-10">
        <TrustHero
          subtitle={t(copy.heroSubtitle)}
          title={t(copy.heroTitleHtml)}
          lead={t(copy.heroLead)}
          ctaVariant="conversion"
          ctaLinks={[
            { href: collectionHref, label: t(copy.ctaCollection) },
            ...(bookHref ? [{ href: bookHref, label: t(copy.ctaBook) }] : [])
          ]}
        />

        <div class="max-w-2xl space-y-5 mt-8 am-text-body text-on-surface-variant leading-relaxed">
          {tArr(copy.prose).map((html) => (
            <p set:html={html} />
          ))}
        </div>

        <div
          class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-12 pt-8 border-t border-border-subtle am-text-body text-on-surface-variant"
          id="direct-booking"
        >
          <span>{t(copy.trustBooking)}</span>
          <span>{t(copy.trustAirbnb)}</span>
          {
            directBookingHref ? (
              <a class="am-inline-link" href={directBookingHref}>{t(copy.trustDirect)}</a>
            ) : (
              <span class="am-inline-link am-is-disabled" aria-disabled="true">{t(copy.trustDirect)}</span>
            )
          }
        </div>
      </section>

      <section
        class="py-14 md:py-20 border-t border-border-subtle relative z-10"
        aria-labelledby="decision-title"
      >
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-start">
          <div class="max-w-2xl">
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">
              {t(copy.decisionEyebrow)}
            </p>
            <h2 id="decision-title" class="am-text-title tracking-tight mt-4">
              {t(copy.decisionTitle)}
            </h2>
            <p class="am-text-body text-on-surface-variant mt-5 leading-relaxed">
              {t(copy.decisionIntro)}
            </p>
          </div>

          <div class="grid gap-8 md:grid-cols-3">
            {decisionItems.map((item) => (
              <article class="border-t border-border-subtle pt-5">
                <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-primary">
                  {item.kicker}
                </p>
                <h3 class="am-text-subtitle text-on-surface mt-4">
                  {item.title}
                </h3>
                <p class="am-text-body text-on-surface-variant mt-3 leading-relaxed">
                  {item.body}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section
        id="booking"
        class="scroll-mt-36 md:scroll-mt-40 py-16 md:py-24 border-t border-border-subtle relative z-10"
        aria-labelledby="collection-title"
      >
        <div class="flex flex-col gap-6 max-w-3xl">
          <h2 id="collection-title" class="am-text-title tracking-tight">{t(copy.collectionTitle)}</h2>
          <p class="am-text-body text-on-surface-variant">{t(copy.collectionIntro)}</p>
        </div>

        <ApartmentGrid>
          {
            apartmentsWithLinks.map((apt, index) => (
              <ApartmentCard
                href={apt.href}
                imageSrc={apt.image}
                imageAlt={t(apt.imageAlt)}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                meta={apt.meta}
                title={apt.title}
                description={apt.description}
                ctaLabel={apt.ctaLabel}
              />
            ))
          }
        </ApartmentGrid>
      </section>

      <section class="py-14 md:py-20 border-t border-border-subtle relative z-10" aria-labelledby="location-bridge-title">
        <div class="max-w-3xl">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">
            {t(copy.locationBridgeEyebrow)}
          </p>
          <h2 id="location-bridge-title" class="am-text-title tracking-tight mt-4">
            {t(copy.locationBridgeTitle)}
          </h2>
          <p class="am-text-body text-on-surface-variant mt-5 leading-relaxed">
            {t(copy.locationBridgeBody)}
          </p>
          <div class="flex flex-wrap gap-3 mt-7">
            {
              locationBridgeLinks.map((link) => (
                <a class="am-btn am-btn--secondary" href={link.href}>{link.label}</a>
              ))
            }
          </div>
        </div>
      </section>

      {
        reviewsHref && (
          <GuestReviewsSummary
            eyebrow={t(copy.reviewsEyebrow)}
            headline={t(copy.reviewsHeadline)}
            body={t(copy.reviewsBody)}
            reviewsHref={reviewsHref}
            reviewsCtaLabel={t(copy.reviewsCta)}
            features={featureChipsByLang[currentLang]}
          />
        )
      }
    </div>
  </main>
</BaseLayout>
