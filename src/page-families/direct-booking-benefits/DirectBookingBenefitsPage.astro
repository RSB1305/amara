---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import EditorialQuote from '../../components/editorial/EditorialQuote.astro';
import EditorialDefinitionList from '../../components/editorial/EditorialDefinitionList.astro';
import EditorialSplit from '../../components/editorial/EditorialSplit.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import {
  directBookingBenefitsCopy,
  directBookingBenefitsFooterLabels,
  directBookingBenefitsSeo
} from '../../content/directBookingBenefitsContent';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const seo = directBookingBenefitsSeo;
const copy = directBookingBenefitsCopy;
const trustLinks = [
  { token: 'about', label: copy.hero.ctaAbout[currentLang] },
  { token: 'reviews_hub', label: copy.hero.ctaReviews[currentLang] },
  { token: 'direct_booking_benefits', label: copy.hero.subtitle[currentLang] }
];
const footerHighlights: LabeledLink[] = [
  { token: 'amenities', label: directBookingBenefitsFooterLabels.amenities[currentLang] },
  { token: 'faq_general', label: directBookingBenefitsFooterLabels.faq_general[currentLang] },
  { token: 'instagram', label: directBookingBenefitsFooterLabels.instagram[currentLang] }
];
const directBookingDefinitionItems = copy.benefits.map((benefit) => ({
  title: benefit.title[currentLang],
  description: benefit.copy[currentLang]
}));
const closingCtaLinks = [
  { label: copy.sections.ctaAvailability[currentLang], token: 'book', style: 'primary' as const },
  { label: copy.sections.inlineAbout[currentLang], token: 'about', style: 'secondary' as const },
  { label: copy.sections.ctaExplore[currentLang], token: 'romantic_hideaways', style: 'secondary' as const }
];
const heroCtaLinks = [
  { token: 'book', label: copy.sections.ctaAvailability[currentLang] },
  { token: 'reviews_hub', label: copy.hero.ctaReviews[currentLang] }
]
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
const inlineLinks = [
  { token: 'reviews_hub', label: copy.sections.inlineReviews[currentLang] },
  { token: 'about', label: copy.sections.inlineAbout[currentLang] }
]
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>

  <Navigation

    currentLang={currentLang}

    brandName="AMARA"

    links={trustLinks}

    variant="trust"

    languageToken="direct_booking_benefits"

  />

  <div class="bg-white" data-am-page="direct-booking-benefits">
    <div class="w-full max-w-[1400px] mx-auto px-[5vw]">

    <TrustHero

      subtitle={copy.hero.subtitle[currentLang]}

      title={copy.hero.title[currentLang]}

      lead={copy.hero.lead[currentLang]}

      supportText={copy.hero.supportText[currentLang]}

      ctaLinks={heroCtaLinks}

      ctaVariant="conversion"

    />



    <main id="am-main-content" tabindex="-1" class="scroll-mt-[104px] lg:scroll-mt-[112px]">

      <section class="mb-[clamp(8rem,15vw,14rem)]">

        <EditorialSplit title={copy.sections.benefitsTitle[currentLang]}>

          <div class="mb-10">

            <EditorialDefinitionList items={directBookingDefinitionItems} />

          </div>

          <p class="am-text-body leading-[1.8] text-muted italic mb-8">

            {copy.sections.tip[currentLang]}

          </p>

          <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 sm:gap-6">
            {inlineLinks.map((link) => (
              <>
                <a
                  href={link.href}
                  class="am-cta-link"
                >
                  {link.label}
                </a>
              </>
            ))}
          </div>

        </EditorialSplit>

      </section>



      <div class="mb-[clamp(8rem,15vw,14rem)]">

        <EditorialQuote quote={copy.sections.quote[currentLang]} />

      </div>



      <section class="mb-[clamp(8rem,15vw,14rem)]">

        <EditorialSplit title={copy.sections.whyTitle[currentLang]}>

          <p class="am-text-subtitle leading-[1.5] text-on-surface mb-8">

            {copy.sections.whyLead[currentLang]}

          </p>

          <p class="am-text-body leading-[1.8] text-subtle">

            {copy.sections.whyBody[currentLang]}

          </p>

        </EditorialSplit>

      </section>



      <section class="mb-[clamp(8rem,15vw,14rem)] bg-surface py-[clamp(4rem,8vw,8rem)] px-[clamp(2rem,5vw,5rem)] -mx-[5vw]">

        <EditorialStatement title={copy.sections.promiseTitle[currentLang]}>

          <p class="am-text-body leading-[1.8] text-subtle">

            {copy.sections.promiseP1[currentLang]}

          </p>

          <p class="am-text-body leading-[1.8] text-subtle">

            {copy.sections.promiseP2[currentLang]}

          </p>

          <p class="am-text-body leading-[1.8] text-muted italic mt-8">

            {copy.sections.promiseNote[currentLang]}

          </p>

        </EditorialStatement>

      </section>



      <EditorialClosingCta

        title={copy.sections.ctaTitle[currentLang]}

        lead={copy.sections.ctaLead[currentLang]}

        links={closingCtaLinks}

        lang={currentLang}

      />

    </main>

    </div>

  </div>

</BaseLayout>



















