      image: '/images/amara-zaid/cara-rural-frigiliana-amara-said-terraza-5.jpg',
      alt: {
        en: 'AMARA trust image',
        de: 'AMARA Bild zum Thema Vertrauen',
        es: 'Imagen de AMARA sobre confianza',
        nl: 'AMARA beeld over vertrouwen',
        sv: 'AMARA-bild för trygghet'
      },
      items: [
        {
          q: { en: 'Are pets allowed?', de: 'Sind Haustiere erlaubt?', es: '¿Se admiten mascotas?', nl: 'Zijn huisdieren toegestaan?', sv: 'Är husdjur tillåtna?' },
          a: { en: 'Pets are welcome in selected apartments, usually on request, for €15 per day. The final rule is shown during booking and in the unit details.', de: 'Haustiere sind in ausgewählten Apartments willkommen, meist auf Anfrage, für 15 EUR pro Tag. Die endgültige Regelung steht immer in der Buchung und in den Wohnungsdetails.', es: 'Las mascotas son bienvenidas en apartamentos seleccionados, normalmente bajo petición previa, por 15 EUR al día. La norma final aparece siempre durante la reserva y en los detalles del alojamiento.', nl: 'Huisdieren zijn welkom in geselecteerde appartementen, meestal op aanvraag, voor 15 EUR per dag. De definitieve regel staat altijd bij de boeking en in de accommodatiedetails.', sv: 'Husdjur är välkomna i utvalda lägenheter, vanligtvis på förfrågan, för 15 EUR per dag. Den slutliga regeln visas alltid under bokningen och i boendeinformationen.' }
        },
        {
          q: { en: 'Is AMARA legally registered?', de: 'Ist AMARA rechtlich registriert?', es: '¿Está AMARA legalmente registrada?', nl: 'Is AMARA wettelijk geregistreerd?', sv: 'Är AMARA lagligt registrerat?' },
          a: { en: 'Yes. License numbers are listed on our Amenities & Policies page where required.', de: 'Ja. Wo es vorgeschrieben ist, findet ihr die Lizenznummern auf unserer Seite zu Ausstattung und Regeln.', es: 'Sí. Cuando es obligatorio, los números de licencia aparecen en nuestra página de servicios y normas.', nl: 'Ja. Waar dat verplicht is, staan de licentienummers op onze pagina over voorzieningen en regels.', sv: 'Ja. Där det krävs finns licensnumren på vår sida om bekvämligheter och regler.' }
        },
        {
          q: { en: 'Who can I contact during my stay?', de: 'Wen kann ich während meines Aufenthalts kontaktieren?', es: '¿Con quién puedo contactar durante la estancia?', nl: 'Met wie kan ik tijdens mijn verblijf contact opnemen?', sv: 'Vem kan jag kontakta under vistelsen?' },
          a: { en: 'You’ll receive clear contact details as part of your arrival information. For urgent matters, please use the primary contact channel provided.', de: 'Ihr erhaltet klare Kontaktdaten zusammen mit euren Anreiseinformationen. Für dringende Anliegen nutzt bitte den angegebenen Hauptkontakt.', es: 'Recibiréis unos datos de contacto claros como parte de vuestra información de llegada. Para asuntos urgentes, utilizad el canal principal indicado.', nl: 'Jullie ontvangen duidelijke contactgegevens als onderdeel van jullie aankomstinformatie. Gebruik bij urgente zaken het opgegeven hoofdcontact.', sv: 'Ni får tydliga kontaktuppgifter som en del av er ankomstinformation. För brådskande ärenden, använd den huvudsakliga kontaktväg som ni har fått.' }
        },
        {
          q: { en: 'Why book directly?', de: 'Warum direkt buchen?', es: '¿Por qué reservar directamente?', nl: 'Waarom direct boeken?', sv: 'Varför boka direkt?' },
          a: { en: 'Direct booking gives you the clearest availability, the most accurate rules, and the final price without intermediaries.', de: 'Bei einer Direktbuchung seht ihr die klarste Verfügbarkeit, die genauesten Regeln und den Endpreis ohne Zwischenhändler.', es: 'La reserva directa os ofrece la disponibilidad más clara, las normas más precisas y el precio final sin intermediarios.', nl: 'Direct boeken geeft jullie de duidelijkste beschikbaarheid, de meest nauwkeurige regels en de eindprijs zonder tussenpartijen.', sv: 'Direktbokning ger er tydligast tillgänglighet, de mest korrekta reglerna och slutpriset utan mellanhänder.' }
        }
      ]
    }
  ],
} as const;

const hero = {
  kicker: copy.hero.kicker[currentLang],
  title: copy.hero.title[currentLang],
  lead: copy.hero.lead[currentLang],
  ctaBooking: copy.hero.ctaBooking[currentLang],
  ctaAmenities: copy.hero.ctaAmenities[currentLang]
};

const trustLinks = [
  { token: 'about', label: copy.shared.ctaAbout[currentLang] },
  { token: 'reviews_hub', label: copy.shared.ctaReviews[currentLang] },
  { token: 'direct_booking_benefits', label: copy.shared.ctaDirectBenefits[currentLang] }
];
const heroCtaLinks = [
  { token: 'book', label: hero.ctaBooking },
  { token: 'amenities', label: hero.ctaAmenities }
]
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
const closingCtaLinks = [
  { token: 'book', label: hero.ctaBooking, style: 'primary' as const },
  { token: 'amenities', label: hero.ctaAmenities, style: 'secondary' as const }
];

const sections = copy.sections.map((section, index) => ({
  topic: section.topic[currentLang],
  image: section.image,
  alt: section.alt[currentLang],
  reverse: index % 2 === 1,
  items: section.items.map((item) => ({
    question: item.q[currentLang],
    answer: item.a[currentLang]
  }))
}));
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    brandName="AMARA"
    links={trustLinks}
    variant="trust"
    currentToken="faq_general"
  />

  <div class="am-root bg-white" data-am-page="faq-general">
    <div class="am-wrap w-full max-w-[1400px] mx-auto px-[5vw]" data-lang={currentLang}>
    <TrustHero
      subtitle={hero.kicker}
      title={hero.title}
      lead={hero.lead}
      supportText={copy.shared.supportText[currentLang]}
      ctaLinks={heroCtaLinks}
      ctaVariant="conversion"
    />
      <main class="am-faq-main space-y-16">
        {sections.map((section) => (
          <section
            class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-start border-t border-outline-variant/10 pt-16"
            data-lang={currentLang}
          >
            {section.reverse ? (
              <>
                <div class="min-w-0 self-start">
                  <figure class="border border-outline-variant/10 bg-surface-container-low overflow-hidden">
                    <div class="aspect-16/10">
                      <img
                        src={section.image}
                        alt={section.alt}
                        width={getPublicImageDimensions(section.image).width}
                        height={getPublicImageDimensions(section.image).height}
                        class="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </figure>
                </div>

                <div class="min-w-0 self-start">
                  <div class="border border-outline-variant/10 bg-surface-container-lowest px-8 pb-8 pt-4 md:px-10 md:pb-10 md:pt-5 lg:px-12 lg:pb-12 lg:pt-6">
                    <div class="mb-6">
                      <span class="am-text-caption uppercase tracking-[0.3em] text-primary block mb-3">
                        {copy.shared.sectionBadge[currentLang]}
                      </span>
                      <h2 class="am-text-title italic tracking-tight text-on-surface">
                        {section.topic}
                      </h2>
                    </div>

                    <div class="divide-y divide-outline-variant/15 border-y border-outline-variant/15">
                      {section.items.map((item) => (
                        <details class="group py-6">
                          <summary class="am-accordion__trigger">
                            <span class="min-w-0 am-text-caption uppercase tracking-[0.18em] text-on-surface group-hover:text-primary transition-colors leading-relaxed">
                              {item.question}
                            </span>
                            <span class="am-accordion__indicator" aria-hidden="true">
                              <span class="group-open:hidden">+</span>
                              <span class="hidden group-open:inline">-</span>
                            </span>
                          </summary>
                          <p class="pt-4 am-text-body text-on-surface-variant leading-relaxed max-w-2xl">
                            {item.answer}
                          </p>
                        </details>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <>
                <div class="min-w-0 self-start">
                  <div class="border border-outline-variant/10 bg-surface-container-lowest px-8 pb-8 pt-4 md:px-10 md:pb-10 md:pt-5 lg:px-12 lg:pb-12 lg:pt-6">
                    <div class="mb-6">
                      <span class="am-text-caption uppercase tracking-[0.3em] text-primary block mb-3">
                        {copy.shared.sectionBadge[currentLang]}
                      </span>
                      <h2 class="am-text-title italic tracking-tight text-on-surface">
                        {section.topic}
                      </h2>
                    </div>

                    <div class="divide-y divide-outline-variant/15 border-y border-outline-variant/15">
                      {section.items.map((item) => (
                        <details class="group py-6">
                          <summary class="am-accordion__trigger">
                            <span class="min-w-0 am-text-caption uppercase tracking-[0.18em] text-on-surface group-hover:text-primary transition-colors leading-relaxed">
                              {item.question}
                            </span>
                            <span class="am-accordion__indicator" aria-hidden="true">
                              <span class="group-open:hidden">+</span>
                              <span class="hidden group-open:inline">-</span>
                            </span>
                          </summary>
                          <p class="pt-4 am-text-body text-on-surface-variant leading-relaxed max-w-2xl">
                            {item.answer}
                          </p>
                        </details>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="min-w-0 self-start">
                  <figure class="border border-outline-variant/10 bg-surface-container-low overflow-hidden">
                    <div class="aspect-16/10">
                      <img
                        src={section.image}
                        alt={section.alt}
                        width={getPublicImageDimensions(section.image).width}
                        height={getPublicImageDimensions(section.image).height}
                        class="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </figure>
                </div>
              </>
            )}
          </section>
        ))}

        <EditorialClosingCta
          title={copy.shared.closingTitle[currentLang]}
          lead={copy.shared.closingLead[currentLang]}
          links={closingCtaLinks}
          lang={currentLang}
        />
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .am-faq-main {
    padding-bottom: 5rem;
  }

  @media (max-width: 600px) {
  }
</style>
