---
import TrustPageLayout from '../../layouts/TrustPageLayout.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import type { EditorialClosingCtaLink } from '../../components/editorial/EditorialClosingCta.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import { trustLabels } from '../../content/trustLabels';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);

const seo: AmaraAuthoringSeo = {
  version: '2026-03-24-amara-faq-general-shell-v1.0',
  pageType: 'C',
  entityKey: 'amara-brand',
  languages: {
    en: {
      title: 'FAQ: Booking & Check-in',
      description: 'Answers about booking, payment, arrival, cancellation, house rules and trust before you stay with AMARA.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    de: {
      title: 'FAQ: Buchung & Anreise',
      description: 'Antworten zu Buchung, Zahlung, Anreise, Stornierung, Hausregeln und Vertrauen vor eurem AMARA-Aufenthalt.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    es: {
      title: 'FAQ: reservas y llegada',
      description: 'Respuestas sobre reservas, pagos, llegada, cancelación, normas y confianza antes de vuestra estancia en AMARA.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    nl: {
      title: 'FAQ: boeken & aankomst',
      description: 'Antwoorden over boeken, betalen, aankomst, annulering, huisregels en vertrouwen voor jullie AMARA-verblijf.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    sv: {
      title: 'FAQ: bokning & ankomst',
      description: 'Svar om bokning, betalning, ankomst, avbokning, husregler och trygghet inför er AMARA-vistelse.',
      robots: 'index, follow',
      canonical: 'auto'
    }
  },
  ogImage: '/images/robert-amara-host.jpg'
};

const trustFooterLabels = {
  amenities: trustLabels.amenities,
  reviews_hub: trustLabels.reviews_hub,
  instagram: {
    en: 'Instagram',
    de: 'Instagram',
    es: 'Instagram',
    nl: 'Instagram',
    sv: 'Instagram'
  }
} as const;

const footerHighlights: LabeledLink[] = [
  { token: 'amenities', label: trustFooterLabels.amenities[currentLang] },
  { token: 'reviews_hub', label: trustFooterLabels.reviews_hub[currentLang] },
  { token: 'instagram', label: trustFooterLabels.instagram[currentLang] }
];

const copy = {
  hero: {
    kicker: {
      en: 'Good to know before booking',
      de: 'Vor der Buchung gut zu wissen',
      es: 'Conviene saberlo antes de reservar',
      nl: 'Goed om te weten vóór het boeken',
      sv: 'Bra att veta före bokningen'
    },
    title: {
      en: 'Stay FAQ: Booking & Check-in',
      de: 'FAQ zu Buchung und Anreise',
      es: 'FAQ sobre reserva y llegada',
      nl: 'FAQ over boeken en aankomst',
      sv: 'FAQ om bokning och ankomst'
    },
    lead: {
      en: 'Payment, cancellation, check-in, house rules: the questions before booking, answered briefly.',
      de: 'Zahlung, Stornierung, Check-in, Hausregeln: die Fragen vor der Buchung, kurz beantwortet.',
      es: 'Pago, cancelación, check-in, normas de la casa: las preguntas antes de reservar, respondidas en breve.',
      nl: 'Betaling, annulering, inchecken, huisregels: de vragen vóór het boeken, kort beantwoord.',
      sv: 'Betalning, avbokning, incheckning, husregler: frågorna före bokningen, kort besvarade.'
    },
    ctaBooking: trustLabels.book,
    ctaAmenities: trustLabels.amenities
  },
  shared: {
    supportText: {
      en: 'What is shown at booking applies: price, payment schedule, cancellation terms.',
      de: 'Was bei der Buchung angezeigt wird, gilt: Preis, Zahlungsplan, Stornobedingungen.',
      es: 'Lo que se muestra al reservar es lo que rige: precio, plan de pago, condiciones de cancelación.',
      nl: 'Wat bij het boeken wordt getoond, geldt: prijs, betaalschema, annuleringsvoorwaarden.',
      sv: 'Det som visas vid bokningen gäller: pris, betalningsplan, avbokningsvillkor.'
    },
    ctaAbout: trustLabels.about,
    ctaReviews: trustLabels.reviews_hub,
    ctaDirectBenefits: trustLabels.direct_booking_benefits,
    closingTitle: {
      en: 'Availability and prices',
      de: 'Verfügbarkeit und Preise',
      es: 'Disponibilidad y precios',
      nl: 'Beschikbaarheid en prijzen',
      sv: 'Tillgänglighet och priser'
    },
    closingLead: {
      en: 'Enter your dates, see available stays and the total price.',
      de: 'Reisedaten eingeben, freie Unterkünfte und Gesamtpreis sehen.',
      es: 'Introducir las fechas, ver alojamientos libres y precio total.',
      nl: 'Reisdata invoeren, vrije verblijven en totaalprijs zien.',
      sv: 'Ange resdatum, se lediga boenden och totalpris.'
    }
  },
  sections: [
    {
      id: 'booking-payment',
      topic: {
        en: 'Booking & Payment',
        de: 'Buchung & Zahlung',
        es: 'Reserva y pago',
        nl: 'Boeking en betaling',
        sv: 'Bokning och betalning'
      },
      image: '/images/amara-entrada/casa-amara-frigiliana-entrada-iii.jpg',
      alt: {
        en: 'AMARA booking and arrival image',
        de: 'AMARA Bild zu Buchung und Anreise',
        es: 'Imagen de AMARA sobre reserva y llegada',
        nl: 'AMARA beeld over boeken en aankomst',
        sv: 'AMARA-bild för bokning och ankomst'
      },
      items: [
        {
          q: { en: 'How does booking work, and is it confirmed right away?', de: 'Wie läuft die Buchung ab, und ist sie sofort bestätigt?', es: '¿Cómo funciona la reserva y se confirma al momento?', nl: 'Hoe werkt het boeken en is het meteen bevestigd?', sv: 'Hur fungerar bokningen och bekräftas den direkt?' },
          a: { en: 'You choose stay and dates, see total price and terms and book. The booking is confirmed with our confirmation email and receipt of the payment then due.', de: 'Ihr wählt Unterkunft und Daten, seht Gesamtpreis und Bedingungen und bucht. Bestätigt ist die Buchung mit unserer Bestätigungsmail und dem Eingang der dann fälligen Zahlung.', es: 'Elegís alojamiento y fechas, veis precio total y condiciones y reserváis. La reserva queda confirmada con nuestro correo de confirmación y la recepción del pago entonces debido.', nl: 'Je kiest verblijf en data, ziet totaalprijs en voorwaarden en boekt. Bevestigd is de boeking met onze bevestigingsmail en de ontvangst van de dan verschuldigde betaling.', sv: 'Ni väljer boende och datum, ser totalpris och villkor och bokar. Bokningen är bekräftad med vårt bekräftelsemejl och när den då förfallna betalningen kommit in.' }
        },
        {
          q: { en: 'How and when will I pay?', de: 'Wie und wann bezahle ich?', es: '¿Cómo y cuándo pago?', nl: 'Hoe en wanneer betaal ik?', sv: 'Hur och när betalar jag?' },
          a: { en: 'Payment method and timing are on screen before the last click: for most stays the full amount at booking, for some a staged payment plan.', de: 'Zahlungsart und Zeitpunkt stehen vor dem letzten Klick auf dem Bildschirm: bei den meisten Aufenthalten der volle Betrag bei Buchung, bei manchen ein gestaffelter Zahlungsplan.', es: 'Forma de pago y momento aparecen en pantalla antes del último clic: en la mayoría de las estancias el importe total al reservar, en algunas un plan de pago escalonado.', nl: 'Betaalwijze en moment staan vóór de laatste klik op het scherm: bij de meeste verblijven het volledige bedrag bij boeking, bij sommige een gespreid betaalschema.', sv: 'Betalsätt och tidpunkt står på skärmen före sista klicket: för de flesta vistelser hela beloppet vid bokningen, för några en uppdelad betalningsplan.' }
        },
        {
          q: { en: 'What is your cancellation policy?', de: 'Wie sind eure Stornierungsbedingungen?', es: '¿Cuál es vuestra política de cancelación?', nl: 'Wat is jullie annuleringsbeleid?', sv: 'Vad är er avbokningspolicy?' },
          a: { en: 'The cancellation and refund terms shown for the selected rate before booking and repeated in your booking confirmation apply. They may differ by accommodation, dates or rate.', de: 'Es gelten die Stornierungs- und Erstattungsbedingungen, die euch für den gewählten Tarif vor dem Buchungsabschluss angezeigt und in der Buchungsbestätigung wiederholt werden. Sie können je nach Unterkunft, Reisedaten oder Tarif unterschiedlich sein.', es: 'Se aplican las condiciones de cancelación y reembolso que aparecen para la tarifa elegida antes de reservar y que se repiten en la confirmación. Pueden variar según el alojamiento, las fechas o la tarifa.', nl: 'De annulerings- en restitutievoorwaarden die vóór het boeken bij het gekozen tarief worden getoond en in de boekingsbevestiging staan, zijn van toepassing. Ze kunnen per verblijf, reisdata of tarief verschillen.', sv: 'De avboknings- och återbetalningsvillkor som visas för det valda priset före bokningen och upprepas i bokningsbekräftelsen gäller. De kan variera beroende på boende, datum eller prisplan.' }
        }
      ]
    },
    {
      id: 'stay-comfort',
      topic: {
        en: 'Stay & Comfort',
        de: 'Aufenthalt & Komfort',
        es: 'Estancia y confort',
        nl: 'Verblijf en comfort',
        sv: 'Vistelse och komfort'
      },
      image: '/images/amara-lounis/104-amara-frigiliana.jpg',
      alt: {
        en: 'AMARA stay image',
        de: 'AMARA Bild zum Aufenthalt',
        es: 'Imagen de AMARA sobre la estancia',
        nl: 'AMARA verblijfsbeeld',
        sv: 'AMARA-bild för vistelsen'
      },
      items: [
        {
          q: { en: 'What kind of accommodation is AMARA?', de: 'Was für eine Unterkunft ist AMARA?', es: '¿Qué tipo de alojamiento es AMARA?', nl: 'Wat voor accommodatie is AMARA?', sv: 'Vilken typ av boende är AMARA?' },
          a: { en: 'AMARA is individual holiday apartments, most for two; Family & Surf in Tarifa has room for four. Kitchen, terrace and access are on each stay page.', de: 'AMARA sind einzelne Ferienapartments, die meisten für zwei; Family & Surf in Tarifa hat Platz für vier. Küche, Terrasse und Zugang stehen auf jeder Unterkunftsseite.', es: 'AMARA son apartamentos vacacionales individuales, la mayoría para dos; Family & Surf en Tarifa tiene sitio para cuatro. Cocina, terraza y acceso están en cada página de alojamiento.', nl: 'AMARA zijn afzonderlijke vakantieappartementen, de meeste voor twee; Family & Surf in Tarifa heeft plaats voor vier. Keuken, terras en toegang staan op elke verblijfspagina.', sv: 'AMARA är enskilda semesterlägenheter, de flesta för två; Family & Surf i Tarifa har plats för fyra. Kök, terrass och tillgänglighet står på varje boendesida.' }
        },
        {
          q: { en: 'Is AMARA suitable for parties or celebrations?', de: 'Ist AMARA für Partys oder Feiern geeignet?', es: '¿Es AMARA adecuado para fiestas o celebraciones?', nl: 'Is AMARA geschikt voor feesten of vieringen?', sv: 'Passar AMARA för fester eller firanden?' },
          a: { en: 'Parties are not possible: the houses stand in the middle of residential neighbourhoods, and only those named on the booking can stay overnight. If you travel as a group, Casa AMARA has room for up to eight guests in four apartments of their own.', de: 'Feiern geht nicht: Die Häuser stehen mitten in Wohnvierteln, und übernachten können nur die, die auf der Buchung stehen. Wer als Gruppe reist, bekommt in Casa AMARA Platz für bis zu acht Gäste in vier eigenen Wohnungen.', es: 'Fiestas no: las casas están en medio de barrios residenciales, y solo pueden pernoctar quienes figuran en la reserva. Quien viaja en grupo tiene en Casa AMARA sitio para hasta ocho huéspedes en cuatro viviendas propias.', nl: 'Feesten kan niet: de huizen staan midden in woonwijken, en overnachten kunnen alleen zij die op de boeking staan. Wie als groep reist, krijgt in Casa AMARA plaats voor maximaal acht gasten in vier eigen woningen.', sv: 'Fester går inte: husen står mitt i bostadsområden, och övernatta kan bara de som står på bokningen. Reser ni som grupp har Casa AMARA plats för upp till åtta gäster i fyra egna lägenheter.' }
        },
        {
          q: { en: 'Do you provide daily cleaning?', de: 'Gibt es tägliches Housekeeping?', es: '¿Ofrecéis servicio de limpieza diario?', nl: 'Bieden jullie dagelijkse housekeeping aan?', sv: 'Erbjuder ni daglig städning?' },
          a: { en: 'The apartment is ready on arrival, bed linen and towels laid out. From eight nights a mid-stay clean is added for direct bookings; nobody comes daily, you have the house to yourselves.', de: 'Das Apartment ist bei der Anreise fertig, Bettwäsche und Handtücher liegen bereit. Ab acht Nächten kommt bei Direktbuchung eine Zwischenreinigung dazu; täglich kommt niemand, ihr habt das Haus für euch.', es: 'El apartamento está listo a la llegada, con ropa de cama y toallas preparadas. A partir de ocho noches, en reserva directa se añade una limpieza intermedia; a diario no viene nadie, la casa es vuestra.', nl: 'Het appartement is bij aankomst klaar, beddengoed en handdoeken liggen gereed. Vanaf acht nachten komt bij directe boeking een tussentijdse schoonmaak bij; dagelijks komt er niemand, je hebt het huis voor jezelf.', sv: 'Lägenheten är klar vid ankomsten, sänglinne och handdukar ligger framme. Från åtta nätter tillkommer vid direktbokning en mellanstädning; dagligen kommer ingen, ni har huset för er själva.' }
        },
        {
          q: { en: 'Are linens and towels included?', de: 'Sind Bettwäsche und Handtücher inklusive?', es: '¿Se incluyen sábanas y toallas?', nl: 'Zijn beddengoed en handdoeken inbegrepen?', sv: 'Ingår sängkläder och handdukar?' },
          a: { en: 'Yes. Bed linen and towels are provided. Exact details may vary slightly by apartment and are listed in the unit information.', de: 'Ja. Bettwäsche und Handtücher sind vorhanden. Die genauen Details können je nach Apartment leicht variieren und stehen in den Unterkunftsinformationen.', es: 'Sí. Se incluyen sábanas y toallas. Los detalles exactos pueden variar ligeramente según el apartamento y figuran en la información del alojamiento.', nl: 'Ja. Beddengoed en handdoeken zijn aanwezig. De exacte details kunnen per appartement licht verschillen en staan bij de informatie van de accommodatie.', sv: 'Ja. Sängkläder och handdukar finns. Exakta detaljer kan skilja sig något mellan lägenheterna och anges i informationen för respektive boende.' }
        },
        {
          q: { en: 'Is Wi-Fi available?', de: 'Gibt es WLAN?', es: '¿Hay wifi?', nl: 'Is er wifi beschikbaar?', sv: 'Finns wifi?' },
          a: { en: 'Yes, Wi-Fi is available. If you plan to work remotely, check the details of the specific stay before booking.', de: 'Ja, WLAN ist verfügbar. Wenn ihr remote arbeiten möchtet, schaut vor der Buchung in die Angaben der jeweiligen Unterkunft.', es: 'Sí, hay wifi. Si pensáis trabajar a distancia, revisad antes de reservar los detalles del alojamiento elegido.', nl: 'Ja, er is wifi. Als jullie op afstand willen werken, bekijk dan vóór het boeken de gegevens van het gekozen verblijf.', sv: 'Ja, wifi finns. Om ni planerar att arbeta på distans bör ni kontrollera uppgifterna för det aktuella boendet före bokning.' }
        }
      ]
    },
    {
      id: 'house-rules',
      topic: {
        en: 'House Rules & Policies',
        de: 'Hausregeln',
        es: 'Normas de la casa',
        nl: 'Huisregels',
        sv: 'Husregler'
      },
      image: '/images/amara-maha/91-amara-frigiliana.jpg',
      alt: {
        en: 'AMARA house rules image',
        de: 'AMARA Bild zu den Hausregeln',
        es: 'Imagen de AMARA sobre las normas de la casa',
        nl: 'AMARA beeld over de huisregels',
        sv: 'AMARA-bild för husregler'
      },
      items: [
        {
          q: { en: 'What are check-in and check-out times?', de: 'Wann sind Check-in und Check-out?', es: '¿Cuáles son los horarios de check-in y check-out?', nl: 'Wat zijn de tijden voor inchecken en uitchecken?', sv: 'Vilka tider gäller för incheckning och utcheckning?' },
          a: { en: 'Check-in is from 15:00 and check-out is by 11:00. If you need a special arrangement, please ask in advance - it depends on availability.', de: 'Der Check-in ist ab 15:00 Uhr möglich und der Check-out bis 11:00 Uhr. Wenn ihr eine besondere Lösung braucht, fragt bitte vorher nach - das hängt von der Verfügbarkeit ab.', es: 'El check-in es a partir de las 15:00 y el check-out hasta las 11:00. Si necesitáis algo especial, pedidlo con antelación: depende de la disponibilidad.', nl: 'Inchecken kan vanaf 15:00 en uitchecken is uiterlijk om 11:00. Als jullie iets afwijkends nodig hebben, laat het vooraf weten - het hangt af van de beschikbaarheid.', sv: 'Incheckning är från 15.00 och utcheckning senast 11.00. Om ni behöver en särskild lösning, fråga gärna i förväg - det beror på tillgänglighet.' }
        },
        {
          q: { en: 'Is smoking allowed?', de: 'Ist Rauchen erlaubt?', es: '¿Se permite fumar?', nl: 'Is roken toegestaan?', sv: 'Är rökning tillåten?' },
          a: { en: 'No. All AMARA homes are strictly non-smoking.', de: 'Nein. In allen AMARA Häusern ist Rauchen im Innenbereich verboten.', es: 'No. No se permite fumar en el interior de ninguno de los alojamientos de AMARA.', nl: 'Nee. Alle AMARA woningen zijn strikt rookvrij binnenshuis.', sv: 'Nej. Alla AMARA-boenden är helt rökfria inomhus.' }
        },
        {
          q: { en: 'Are visitors allowed?', de: 'Sind Besucher erlaubt?', es: '¿Se permiten visitas?', nl: 'Zijn bezoekers toegestaan?', sv: 'Är besökare tillåtna?' },
          a: { en: 'Only the guests named on the booking can stay overnight; a daytime visit you arrange briefly with us beforehand.', de: 'Übernachten können nur die Gäste, die auf der Buchung stehen; Tagesbesuch besprecht ihr vorher kurz mit uns.', es: 'Solo pueden pernoctar los huéspedes que figuran en la reserva; una visita de día la acordáis antes brevemente con nosotros.', nl: 'Overnachten kunnen alleen de gasten die op de boeking staan; dagbezoek bespreek je vooraf kort met ons.', sv: 'Övernatta kan bara de gäster som står på bokningen; dagsbesök stämmer ni kort av med oss i förväg.' }
        }
      ]
    },
    {
      id: 'trust-policies',
      topic: {
        en: 'Trust & House Rules',
        de: 'Vertrauen & Hausregeln',
        es: 'Confianza y normas',
        nl: 'Vertrouwen en huisregels',
        sv: 'Trygghet och regler'
      },
      image: '/images/amara-zaid/cara-rural-frigiliana-amara-said-terraza-5.jpg',
      alt: {
        en: 'AMARA trust image',
        de: 'AMARA Bild zum Thema Vertrauen',
        es: 'Imagen de AMARA sobre confianza',
        nl: 'AMARA beeld over vertrouwen',
        sv: 'AMARA-bild för trygghet'
      },
      items: [
        {
          q: { en: 'Are pets allowed?', de: 'Sind Haustiere erlaubt?', es: '¿Se admiten mascotas?', nl: 'Zijn huisdieren toegestaan?', sv: 'Är husdjur tillåtna?' },
          a: { en: 'No. Pets cannot be brought to AMARA stays. Mandatory rules concerning recognised assistance animals remain unaffected.', de: 'Nein. Haustiere dürfen nicht in die AMARA-Unterkünfte mitgebracht werden. Zwingende Regelungen für anerkannte Assistenztiere bleiben unberührt.', es: 'No. No se admiten mascotas en los alojamientos AMARA. Las normas obligatorias sobre animales de asistencia reconocidos no se ven afectadas.', nl: 'Nee. Huisdieren mogen niet worden meegenomen naar AMARA-verblijven. Dwingende regels voor erkende assistentiedieren blijven van toepassing.', sv: 'Nej. Husdjur får inte tas med till AMARA-boendena. Tvingande regler för erkända assistansdjur gäller fortfarande.' }
        },
        {
          q: { en: 'Is AMARA legally registered?', de: 'Ist AMARA rechtlich registriert?', es: '¿Está AMARA legalmente registrada?', nl: 'Is AMARA wettelijk geregistreerd?', sv: 'Är AMARA lagligt registrerat?' },
          a: { en: 'Yes. License numbers are listed on our Amenities & Policies page where required.', de: 'Ja. Wo es vorgeschrieben ist, findet ihr die Lizenznummern auf unserer Seite zu Ausstattung und Regeln.', es: 'Sí. Cuando es obligatorio, los números de licencia aparecen en nuestra página de servicios y normas.', nl: 'Ja. Waar dat verplicht is, staan de licentienummers op onze pagina over voorzieningen en regels.', sv: 'Ja. Där det krävs finns licensnumren på vår sida om bekvämligheter och regler.' }
        },
        {
          q: { en: 'Who can I contact during my stay?', de: 'Wen kann ich während meines Aufenthalts kontaktieren?', es: '¿Con quién puedo contactar durante la estancia?', nl: 'Met wie kan ik tijdens mijn verblijf contact opnemen?', sv: 'Vem kan jag kontakta under vistelsen?' },
          a: { en: 'Us, by WhatsApp. The contact details are in your arrival message; in an emergency the number given there applies.', de: 'Uns, per WhatsApp. Die Kontaktdaten stehen in eurer Anreise-Nachricht; im Notfall gilt die dort genannte Nummer.', es: 'A nosotros, por WhatsApp. Los datos de contacto están en vuestro mensaje de llegada; en caso de emergencia rige el número indicado allí.', nl: 'Ons, via WhatsApp. De contactgegevens staan in je aankomstbericht; in een noodgeval geldt het daar genoemde nummer.', sv: 'Oss, via WhatsApp. Kontaktuppgifterna står i ert ankomstmeddelande; i en nödsituation gäller numret som anges där.' }
        }
      ]
    }
  ],
} as const;

const hero = {
  kicker: copy.hero.kicker[currentLang],
  title: copy.hero.title[currentLang],
  lead: copy.hero.lead[currentLang],
  ctaBooking: copy.hero.ctaBooking[currentLang],
  ctaAmenities: copy.hero.ctaAmenities[currentLang]
};

const heroCtaLinks = ([
  { token: 'book', label: hero.ctaBooking },
  { token: 'amenities', label: hero.ctaAmenities }
] satisfies LabeledLink[])
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
const closingCtaLinks: EditorialClosingCtaLink[] = [
  { token: 'book', label: hero.ctaBooking, style: 'primary' as const },
  { token: 'amenities', label: hero.ctaAmenities, style: 'secondary' as const }
];

const faqSections = [
  copy.sections[0],
  copy.sections[1],
  {
    ...copy.sections[2],
    id: 'arrival-rules',
    topic: {
      en: 'Arrival & House Rules',
      de: 'Anreise & Hausregeln',
      es: 'Llegada y normas de la casa',
      nl: 'Aankomst en huisregels',
      sv: 'Ankomst och husregler'
    },
    items: [...copy.sections[2].items, ...copy.sections[3].items]
  }
] as const;

const sections = faqSections.map((section, index) => ({
  id: section.id,
  topic: section.topic[currentLang],
  image: section.image,
  alt: section.alt[currentLang],
  reverse: index % 2 === 1,
  items: section.items.map((item) => ({
    question: item.q[currentLang],
    answer: item.a[currentLang]
  }))
}));
---

<TrustPageLayout
  pageFamily="general-faq"
  seo={seo}
  currentLang={currentLang}
  currentToken="faq_general"
  footerHighlights={footerHighlights}
  pageId="faq-general"
  dataLang={currentLang}
  hero={{
    subtitle: hero.kicker,
    title: hero.title,
    lead: hero.lead,
    supportText: copy.shared.supportText[currentLang],
    ctaLinks: heroCtaLinks,
    ctaVariant: 'conversion'
  }}
>
  {sections.map((section) => (
    <AmaraSection
      labelledby={`faq-${section.id}-title`}
      dataComponent="stay-faq-topic"
    >
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:gap-20" data-lang={currentLang}>
        <div class:list={['min-w-0 self-start', { 'lg:order-2': section.reverse }]}>
          <div class="mb-8">
            <h2 id={`faq-${section.id}-title`} class="am-text-title tracking-tight text-on-surface">
              {section.topic}
            </h2>
          </div>

          <div class="divide-y divide-outline-variant/15 border-y border-outline-variant/15">
            {section.items.map((item) => (
              <details class="group py-6">
                <summary class="am-accordion__trigger">
                  <span class="min-w-0 am-text-annotation am-text-annotation--wide text-on-surface transition-colors group-hover:text-primary">
                    {item.question}
                  </span>
                  <span class="am-accordion__indicator" aria-hidden="true">
                    <span class="group-open:hidden">+</span>
                    <span class="hidden group-open:inline">-</span>
                  </span>
                </summary>
                <p class="am-text-body max-w-2xl pt-4 text-on-surface-variant">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>
        </div>

        <div class:list={['min-w-0 self-start', { 'lg:order-1': section.reverse }]}>
          <figure class="am-mobile-full-bleed am-mobile-full-bleed--fluid overflow-hidden bg-surface-container-low">
            <div class="aspect-16/10">
              <AmaraImage
                src={section.image}
                alt={section.alt}
                profile="card"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      </div>
    </AmaraSection>
  ))}

  <EditorialClosingCta
    title={copy.shared.closingTitle[currentLang]}
    titleId="stay-faq-next-step-title"
    lead={copy.shared.closingLead[currentLang]}
    links={closingCtaLinks}
    lang={currentLang}
    spacing="page"
    dataComponent="stay-faq-next-step"
  />
</TrustPageLayout>
