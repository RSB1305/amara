    title: {
      en: 'Stay FAQ: Booking & Check-in',
      de: 'FAQ zu Buchung und Anreise',
      es: 'FAQ sobre reserva y llegada',
      nl: 'FAQ over boeken en aankomst',
      sv: 'FAQ om bokning och ankomst'
    },
    lead: {
      en: 'Practical answers about payment, cancellation, check-in, house rules and what is included in an AMARA stay.',
      de: 'Praktische Antworten zu Zahlung, Stornierung, Check-in, Hausregeln und den Leistungen eures AMARA-Aufenthalts.',
      es: 'Respuestas prácticas sobre pagos, cancelación, llegada, normas de la casa y lo que incluye una estancia AMARA.',
