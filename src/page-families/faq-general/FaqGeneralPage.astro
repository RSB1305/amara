    },
    closingLead: {
      en: 'Check current availability or review the complete amenities and policies before choosing dates.',
      de: 'Prüft die aktuelle Verfügbarkeit oder lest vor der Terminwahl alle Informationen zu Ausstattung und Regeln.',
      es: 'Consultad la disponibilidad actual o revisad todos los servicios y normas antes de elegir fechas.',
      nl: 'Bekijk de actuele beschikbaarheid of lees alle voorzieningen en regels voordat jullie data kiezen.',
      sv: 'Kontrollera aktuell tillgänglighet eller läs om alla bekvämligheter och regler innan ni väljer datum.'
    },
    sectionBadge: {
