---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import StaySearchFinder from '../../components/booking/StaySearchFinder.astro';
import HomeCinematicMain from '../../components/home/HomeCinematicMain.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import { createAmaraImage } from '../../lib/images/amaraImageProfiles';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';
import {
  formatVacationRentalFromPrice,
  vacationRentalEntities,
  vacationRentalEntitiesByToken
} from '../../content/vacationRentalEntities';
import {
  airbnbRatingLabel,
  superhostLabel,
  travellerReviewAwardLabel,
  completedStaysLabel
} from '../../content/reviewEvidence';
import {
  cancellationAssuranceBadge,
  cancellationAssuranceDetail,
  directBookingTrustSignals
} from '../../content/directBookingBenefitsContent';
import {
  cinematicApartments,
  type CinematicAptToken,
  cinematicHeroKicker,
  cinematicHeroLead,
  cinematicHeroImageAlt,
  cinematicHeroProofRating,
  cinematicHostLabel,
  cinematicHostAvatarAlt,
  cinematicWelcome,
  cinematicPhilosophyPart1,
  cinematicPhilosophyAccent,
  cinematicPhilosophyLabel,
  cinematicPhilosophyP1,
  cinematicFactTerraceLabel,
  cinematicFactBedLabel,
  cinematicFactBalconyLabel,
  cinematicPriceFromLabel,
  cinematicPriceUnitLabel,
  cinematicListConjunction,
  cinematicPositioningLabel,
  cinematicPositioningTerraces,
  cinematicPositioningStoves,
  cinematicPositioningEntrances,
  cinematicPlaces,
  cinematicPlacesEyebrow,
  cinematicPlacesTitle,
  cinematicBridgeEyebrow,
  cinematicBridgeTitle,
  cinematicBridgeBody,
  cinematicBridgeQuote,
  cinematicBridgeQuoteAttribution,
  cinematicBridgeCtaLabel,
  cinematicQuoteTranslationNote,
  cinematicCollectionEyebrow,
  cinematicCollectionTitle,
  cinematicCollectionCtaLabel,
  cinematicTrustQuote,
  cinematicTrustQuoteAttribution,
  cinematicTrustCta,
  cinematicTrustCtaPrimary,
  cinematicStatReviewsValue,
  cinematicStatRatingValue,
  cinematicStatReviewsLabel,
  cinematicStatRatingLabel,
  cinematicDirectEyebrow,
  cinematicDirectTitle,
  cinematicDirectCtaLabel,
  cinematicHoneymoonEyebrow,
  cinematicHoneymoonTitle,
  cinematicHoneymoonCtaLabel
} from '../../content/homeCinematicCopy';
import imgHeroLounis from '../../assets/images/home/amara-lounis-15-amara-frigiliana.jpg';
import imgFarah from '../../assets/images/home/amara-farah-67-amara-frigiliana.jpg';
import imgZaid from '../../assets/images/home/amara-zaid-terraza-5.jpg';
import imgMaha from '../../assets/images/home/amara-maha-29-amara-frigiliana.jpg';
import imgPlaya from '../../assets/images/home/amara-playa-chaparril-13.webp';
import imgTarifa from '../../assets/images/home/amara-tarifa-apartment01.webp';
import imgHost from '../../assets/images/content/robert-amara-host.jpg';

const homeImageByToken: Record<CinematicAptToken, typeof imgHeroLounis> = {
  farah: imgFarah,
  lounis: imgHeroLounis,
  zaid: imgZaid,
  maha: imgMaha,
  playa: imgPlaya,
  tarifa: imgTarifa
};

const heroImage = await createAmaraImage(imgHeroLounis, 'hero', { quality: 50 });
const trustImage = await createAmaraImage(imgZaid, 'background', { quality: 55 });
const hostAvatar = await createAmaraImage(imgHost, 'card', { quality: 60 });
const homeHeroSizes = '100vw';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);

const t = <T extends Record<AmaraLanguage, string>>(row: T) => row[currentLang] ?? row.en;

const seo: AmaraAuthoringSeo = {
  version: '2026-08-24-amara-home-romantic-hideaways-v5.0-A',
  pageType: 'A',
  entityKey: 'amara-brand',
  ogImage: heroImage.src,
  languages: {
    en: {
      title: 'AMARA — Romantic Hideaways in Andalusia',
      description:
        'Special places for shared time as a couple: six individual stays in Frigiliana, Nerja and Tarifa, personally hosted and bookable direct with AMARA.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    de: {
      title: 'AMARA — Romantic Hideaways in Andalusien',
      description:
        'Besondere Orte für gemeinsame Zeit zu zweit: sechs individuelle Unterkünfte in Frigiliana, Nerja und Tarifa, persönlich betreut und direkt bei AMARA buchbar.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    es: {
      title: 'AMARA — Romantic Hideaways en Andalucía',
      description:
        'Lugares especiales para compartir tiempo en pareja: seis alojamientos únicos en Frigiliana, Nerja y Tarifa, con atención personal y reserva directa con AMARA.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    nl: {
      title: 'AMARA — Romantic Hideaways in Andalusië',
      description:
        'Bijzondere plekken voor waardevolle tijd samen: zes individuele verblijven in Frigiliana, Nerja en Tarifa, persoonlijk beheerd en direct te boeken bij AMARA.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    sv: {
      title: 'AMARA — Romantic Hideaways i Andalusien',
      description:
        'Speciella platser för värdefull tid tillsammans: sex individuella boenden i Frigiliana, Nerja och Tarifa, personligt omhändertagna och bokningsbara direkt.',
      robots: 'index, follow',
      canonical: 'auto'
    }
  }
};

/**
 * The card carries the same three dimensions for every stay so the six can be
 * compared. The previous version ranked amenity flags and showed the top three,
 * which quietly lied: four stays have an underfloor-heated bathroom and only
 * one had room to say so, so its neighbours read as if they did not. A missing
 * measurement cannot mislead the same way — no terrace figure means no terrace.
 * The hideaway features are argued on the rental pages, which already carry the
 * hammock, the outdoor shower and Lounis's historic well.
 */
type RentalEntity = (typeof vacationRentalEntities)[number];

const hasFlag = (rental: RentalEntity, name: string) =>
  rental.amenityFeatures.some((feature) => feature.name === name && feature.value === true);

function cardFacts(rental: RentalEntity): string[] {
  /** Playa's outdoor space is a balcony and carries no area in the SSOT. */
  const outdoor = rental.exteriorAreaSqm
    ? `${t(cinematicFactTerraceLabel)} ${rental.exteriorAreaSqm} m²`
    : hasFlag(rental, 'balcony')
      ? t(cinematicFactBalconyLabel)
      : null;

  const bed = rental.bed[0]?.label.replace(/\s*x\s*/i, ' × ');

  return [
    rental.interiorAreaSqm ? `${rental.interiorAreaSqm} m²` : null,
    outdoor,
    bed ? `${t(cinematicFactBedLabel)} ${bed}` : null
  ].filter((fact): fact is string => Boolean(fact));
}

/** "Lounis, Zaid und Maha" — the localized list the proof lines name. */
function listStays(rentals: RentalEntity[]): string {
  const names = rentals.map((rental) => rental.shortName || rental.name);
  if (names.length <= 1) return names.join('');
  return `${names.slice(0, -1).join(', ')} ${t(cinematicListConjunction)} ${names[names.length - 1]}`;
}

/**
 * The proof row under the brand statement. Which stays qualify is derived from
 * the verified amenity flags, so the claim cannot drift away from the product.
 *
 * The lines name the stays rather than counting them. Stated as fractions they
 * joined the three "{n} of six" labels in the places band, and six fractions on
 * one page turned the brand statement into arithmetic.
 */
const terraceHideaways = vacationRentalEntities.filter(
  (rental) =>
    hasFlag(rental, 'privateTerrace') && hasFlag(rental, 'hammock') && hasFlag(rental, 'outdoorShower')
);
const stoveStays = vacationRentalEntities.filter(
  (rental) => hasFlag(rental, 'pelletStove') || hasFlag(rental, 'fireplace')
);
const everyStayHasOwnEntrance = vacationRentalEntities.every((rental) =>
  hasFlag(rental, 'selfCheckinCheckout')
);

const positioningProofs = [
  terraceHideaways.length > 0
    ? t(cinematicPositioningTerraces).replace('{stays}', listStays(terraceHideaways))
    : null,
  stoveStays.length > 0
    ? t(cinematicPositioningStoves).replace('{stays}', listStays(stoveStays))
    : null,
  everyStayHasOwnEntrance ? t(cinematicPositioningEntrances) : null
].filter((proof): proof is string => Boolean(proof));

/**
 * Card facts come from the rental entities so the four Frigiliana stays read as
 * four different places. Guest count is deliberately absent: five of six carry
 * the same value and it differentiates nothing on the home.
 */
const cinematicApartmentsProps = (
  await Promise.all(
    cinematicApartments.map(async (apt) => {
      const exploreHref = resolveOptionalLink(apt.token, currentLang, { suppressMissing: true });
      if (!exploreHref) {
        return null;
      }

      const rental = vacationRentalEntitiesByToken[apt.token];
      const optimized = await createAmaraImage(homeImageByToken[apt.token], 'card', { quality: 60 });
      return {
        id: apt.id,
        name: apt.name,
        subtitle: t(apt.subtitle),
        city: rental.city,
        facts: cardFacts(rental),
        viewNote: t(rental.viewNote as Record<AmaraLanguage, string>),
        priceFrom: t(cinematicPriceFromLabel),
        priceAmount: formatVacationRentalFromPrice(rental.pricing, currentLang, false)
          .replace(new RegExp(`^${t(cinematicPriceFromLabel)}\\s*`, 'i'), ''),
        priceUnit: t(cinematicPriceUnitLabel),
        desc: t(apt.desc),
        imgAlt: t(apt.imageAlt),
        img: optimized.src,
        imgWidth: optimized.attributes.width as number,
        imgHeight: optimized.attributes.height as number,
        imgSrcSet: optimized.srcSet.attribute,
        imgSizes: `(max-width: 639px) 100vw, ${optimized.attributes.sizes as string}`,
        exploreHref
      };
    })
  )
).filter((apt): apt is NonNullable<typeof apt> => Boolean(apt));

/**
 * The "{n} of six hideaways" label is gone: each place's own copy already opens
 * with the count ("Four of our stays are here"), so the label restated it as a
 * fraction beside the city name and made the band read like arithmetic.
 */
const placesProps = cinematicPlaces
  .map((place) => {
    const href = resolveOptionalLink(place.token, currentLang, { suppressMissing: true });
    if (!href) {
      return null;
    }
    return {
      id: place.id,
      city: place.city,
      character: t(place.character),
      travel: t(place.travel),
      href,
      ctaLabel: t(place.ctaLabel)
    };
  })
  .filter((place): place is NonNullable<typeof place> => Boolean(place));

const trustReviewsHref = resolveOptionalLink('reviews_hub', currentLang, { suppressMissing: true });
const staySearchResultsHref = resolveOptionalLink('stay_search_results', currentLang, { suppressMissing: true });
const trustBookingHref = staySearchResultsHref ? '#stay-search' : null;
const bridgeHref = resolveOptionalLink('nerja_vs_frigiliana', currentLang, { suppressMissing: true });
const collectionCtaHref = resolveOptionalLink('romantic_hideaways', currentLang, { suppressMissing: true });
const directHref = resolveOptionalLink('direct_booking_benefits', currentLang, { suppressMissing: true });
const honeymoonHref = resolveOptionalLink('honeymoon', currentLang, { suppressMissing: true });
const hostAboutHref = resolveOptionalLink('about', currentLang, { suppressMissing: true });

/** The hero carries two signals only; the trust band holds the rest. */
const heroProof = [t(superhostLabel), t(cinematicHeroProofRating)];

/**
 * Evidence only. The two authored chips that used to follow — "concrete
 * property details" and "personal contact" — were claims rather than proof,
 * and the direct-booking band directly below already makes the second one.
 */
const trustChips = [t(travellerReviewAwardLabel), t(completedStaysLabel)];

const directBenefits = [
  t(directBookingTrustSignals.lowestAvailablePrice),
  t(directBookingTrustSignals.midStayCleaning),
  t(directBookingTrustSignals.directHostContact)
];

/**
 * Both displayed guest reviews are German originals. Other locales show a
 * translation, and the note keeps that provenance visible.
 */
const quoteTranslationNote = currentLang === 'de' ? null : t(cinematicQuoteTranslationNote);
---

<BaseLayout seo={seo} pageLang={currentLang}>
  <Navigation
    currentLang={currentLang}
    languageToken="home"
    appearance="overlay"
  />
  <AmaraPageShell
    family="home"
    dataLang={currentLang}
    flush
    whiteCanvas
    edgeToEdge
    class="-mt-[104px] lg:-mt-[112px]"
  >
    <div class="w-full pb-20">
      <HomeCinematicMain
        heroImageSrc={heroImage.src}
        heroImageSrcSet={heroImage.srcSet.attribute}
        heroImageSizes={homeHeroSizes}
        heroImageWidth={heroImage.attributes.width as number}
        heroImageHeight={heroImage.attributes.height as number}
        heroImageAlt={t(cinematicHeroImageAlt)}
        heroKicker={t(cinematicHeroKicker)}
        heroLead={t(cinematicHeroLead)}
        heroProof={heroProof}
        welcomeMessage={cinematicWelcome}
        hostAvatarSrc={hostAvatar.src}
        hostAvatarSrcSet={hostAvatar.srcSet.attribute}
        hostAvatarSizes="40px"
        hostAvatarAlt={t(cinematicHostAvatarAlt)}
        hostAboutHref={hostAboutHref}
        hostAboutLabel={t(cinematicHostLabel)}
        philosophyHeadlinePart1={t(cinematicPhilosophyPart1)}
        philosophyHeadlineAccent={t(cinematicPhilosophyAccent)}
        philosophyLabel={t(cinematicPhilosophyLabel)}
        philosophyP1={t(cinematicPhilosophyP1)}
        positioningLabel={t(cinematicPositioningLabel)}
        positioningProofs={positioningProofs}
        statReviewsValue={cinematicStatReviewsValue}
        statRatingValue={t(cinematicStatRatingValue)}
        statReviewsLabel={t(cinematicStatReviewsLabel)}
        statRatingLabel={t(cinematicStatRatingLabel)}
        placesEyebrow={t(cinematicPlacesEyebrow)}
        placesTitle={t(cinematicPlacesTitle)}
        places={placesProps}
        bridgeEyebrow={t(cinematicBridgeEyebrow)}
        bridgeTitle={t(cinematicBridgeTitle)}
        bridgeBody={t(cinematicBridgeBody)}
        bridgeQuote={t(cinematicBridgeQuote)}
        bridgeQuoteAttribution={t(cinematicBridgeQuoteAttribution)}
        bridgeHref={bridgeHref}
        bridgeCtaLabel={t(cinematicBridgeCtaLabel)}
        collectionEyebrow={t(cinematicCollectionEyebrow)}
        collectionTitle={t(cinematicCollectionTitle)}
        apartments={cinematicApartmentsProps}
        collectionCtaHref={collectionCtaHref}
        collectionCtaLabel={t(cinematicCollectionCtaLabel)}
        trustBgSrc={trustImage.src}
        trustBgSrcSet={trustImage.srcSet.attribute}
        trustBgSizes={trustImage.attributes.sizes as string}
        trustImageWidth={trustImage.attributes.width as number}
        trustImageHeight={trustImage.attributes.height as number}
        trustQuote={t(cinematicTrustQuote)}
        trustQuoteAttribution={t(cinematicTrustQuoteAttribution)}
        trustChips={trustChips}
        trustCta={t(cinematicTrustCta)}
        trustReviewsHref={trustReviewsHref}
        trustCtaPrimary={t(cinematicTrustCtaPrimary)}
        trustBookingHref={trustBookingHref}
        quoteTranslationNote={quoteTranslationNote}
        directEyebrow={t(cinematicDirectEyebrow)}
        directTitle={t(cinematicDirectTitle)}
        directBenefits={directBenefits}
        cancellationBadge={t(cancellationAssuranceBadge)}
        cancellationDetail={t(cancellationAssuranceDetail)}
        directHref={directHref}
        directCtaLabel={t(cinematicDirectCtaLabel)}
        honeymoonEyebrow={t(cinematicHoneymoonEyebrow)}
        honeymoonTitle={t(cinematicHoneymoonTitle)}
        honeymoonHref={honeymoonHref}
        honeymoonCtaLabel={t(cinematicHoneymoonCtaLabel)}
      >
        {staySearchResultsHref && (
          <StaySearchFinder
            slot="bookingFinder"
            lang={currentLang}
            action={staySearchResultsHref}
          />
        )}
      </HomeCinematicMain>
    </div>
  </AmaraPageShell>
</BaseLayout>
