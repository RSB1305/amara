---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import ExploreCampaignHero from '../../components/experience/ExploreCampaignHero.astro';
import ExploreCampaignMediaSplit from '../../components/experience/ExploreCampaignMediaSplit.astro';
import ExploreCampaignPlanningGrid from '../../components/experience/ExploreCampaignPlanningGrid.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialCallout from '../../components/content/EditorialCallout.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import Navigation from '../../components/Navigation.astro';
import churchImage from '../../assets/images/content/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/01-frigiliana-pueblo.jpg';
import villageImage from '../../assets/images/content/hero-frigiliana.jpg';
import houseImage from '../../assets/images/content/amara-entrada/casa-amara-frigiliana-fuerra.jpg';
import prepareImage from '../../assets/images/content/amara-zaid/cara-rural-frigiliana-amara-said-bano.jpg';
import {
  frigilianaWeddingsContent,
  frigilianaWeddingsSeo
} from '../../content/frigilianaWeddingsContent';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaWeddingsContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana weddings');

const links = {
  book: requiredLink('book'),
  stays: requiredLink('romantic_hideaways'),
  location: requiredLink('location_frigiliana'),
  farah: requiredLink('farah'),
  lounis: requiredLink('lounis'),
  zaid: requiredLink('zaid'),
  maha: requiredLink('maha')
};

const apartmentLinks = [
  { label: 'Farah', href: links.farah },
  { label: 'Lounis', href: links.lounis },
  { label: 'Zaid', href: links.zaid },
  { label: 'Maha', href: links.maha }
];

const planningItems = copy.planning.items.map((item) => ({
  ...item,
  href: requiredLink(item.linkToken)
}));

const footerHighlights: (LabeledLink & { decoration: 'heart' })[] = [
  { token: 'frigiliana_weddings', label: copy.footerHighlights.weddings, decoration: 'heart' },
  { token: 'location_frigiliana', label: copy.footerHighlights.location, decoration: 'heart' },
  {
    token: 'casa_amara_groups',
    label: {
      en: 'Casa AMARA for 4–8',
      de: 'Casa AMARA für 4–8',
      es: 'Casa AMARA para 4–8',
      nl: 'Casa AMARA voor 4–8',
      sv: 'Casa AMARA för 4–8'
    }[currentLang],
    decoration: 'heart'
  },
  { token: 'romantic_hideaways', label: copy.footerHighlights.stays, decoration: 'heart' }
];

const parishHref = 'https://diocesismalaga.es/parroquias/145/san-antonio-de-padua-frigiliana';
---

<BaseLayout
  seo={frigilianaWeddingsSeo}
  pageLang={currentLang}
  contextBreadcrumbTitle={copy.hero.title}
  footerHighlights={footerHighlights}
  showContextNavigation={false}
  pageFamily="campaign-weddings"
>
  <Navigation
    currentLang={currentLang}
    currentToken="frigiliana_weddings"
    languageToken="frigiliana_weddings"
  />

  <AmaraPageShell family="frigiliana-weddings" dataLang={currentLang} flush whiteCanvas>
    <ExploreCampaignHero
      imageSrc={churchImage}
      imageAlt={copy.hero.imageAlt}
      kicker={copy.hero.kicker}
      kickerDecoration="heart"
      title={copy.hero.title}
      lead={copy.hero.lead}
      paragraphs={copy.hero.paragraphs}
      action={{ href: '#wedding-stay', label: copy.hero.cta }}
    />

    <AmaraSection dataComponent="wedding-village">
      <ExploreCampaignMediaSplit title={copy.village.title} paragraphs={copy.village.paragraphs} image={villageImage} imageAlt={copy.village.imageAlt}>
        {copy.village.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
      </ExploreCampaignMediaSplit>
    </AmaraSection>

    <AmaraSection
      id="wedding-stay"
      dataComponent="wedding-stay"
      class="scroll-mt-36"
    >
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
        <h2 class="am-text-title max-w-3xl text-on-surface">
          {copy.stayOptions.title}
        </h2>

        <div class="mt-14 grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-6">
            <AmaraImage
              src={houseImage}
              alt={copy.nearChurch.imageAlt}
              profile="gallery"
              class="aspect-[4/3] h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="max-w-2xl lg:col-span-5 lg:col-start-8">
            <h3 class="am-text-subtitle text-on-surface">
              {copy.nearChurch.title}
            </h3>
            <div class="mt-6 space-y-5">
              {copy.nearChurch.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
            <div class="mt-8 border-l border-primary/30 pl-6">
              <p class="am-text-display italic leading-none text-primary">
                {copy.nearChurch.distance}
              </p>
              <p class="am-text-caption mt-3 normal-case tracking-normal text-on-surface-variant">
                {copy.nearChurch.distanceLabel}
              </p>
            </div>
          </div>
        </div>

        <div class="mt-20 border-t border-outline-variant/10 pt-12">
          <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">
            {copy.stayOptions.intro}
          </p>
          <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
            {copy.stayOptions.items.map((item) => (
              <article class="border-t border-outline-variant/20 pt-6">
                <p class="am-text-caption text-primary">{item.eyebrow}</p>
                <h3 class="am-text-subtitle mt-4 text-on-surface">{item.title}</h3>
                <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">
                  {item.text}
                </p>
              </article>
            ))}
          </div>
          <EditorialCallout class="mt-10 max-w-4xl">
            {copy.stayOptions.note}
          </EditorialCallout>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
            {apartmentLinks.map((item) => (
              <a class="am-inline-link" href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      </div>
    </AmaraSection>

    <AmaraSection dataComponent="wedding-prepare">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 md:px-12 lg:grid-cols-12 lg:gap-16">
        <div class="max-w-2xl lg:col-span-5">
          <h2 class="am-text-title text-on-surface">
            {copy.prepare.title}
          </h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">
            {copy.prepare.intro}
          </p>
          <div class="mt-10 space-y-8">
            {copy.prepare.items.map((item) => (
              <article class="border-l border-primary/20 pl-5">
                <h3 class="am-text-subtitle text-on-surface">{item.title}</h3>
                <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">
                  {item.text}
                </p>
              </article>
            ))}
          </div>
          <p class="am-text-body mt-10 leading-relaxed text-on-surface-variant">
            {copy.prepare.note}
          </p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <AmaraImage
            src={prepareImage}
            alt={copy.prepare.imageAlt}
            profile="gallery"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </AmaraSection>

    <AmaraSection dataComponent="wedding-planning">
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
        <div class="max-w-3xl">
          <h2 class="am-text-title text-on-surface">
            {copy.planning.title}
          </h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">
            {copy.planning.intro}
          </p>
        </div>
        <ExploreCampaignPlanningGrid items={planningItems} columns={4} />
        <p class="am-text-body mt-12 max-w-4xl border-l border-primary/20 bg-surface-container-low px-5 py-4 leading-relaxed text-on-surface-variant">
          {copy.planning.churchNote}{' '}
          <a
            class="am-inline-link"
            href={parishHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.planning.churchLinkLabel}
          </a>.
        </p>
      </div>
    </AmaraSection>

    <FaqAccordion layout="single" faqTitle={copy.faq.title} items={copy.faq.items} pageEndFamily="experience" dataComponent="wedding-faq" />

    <EditorialClosingCta
      dataComponent="wedding-closing"
      title={copy.closing.title}
      lead={copy.closing.paragraphs[0]}
      paragraphs={copy.closing.paragraphs}
      lang={currentLang}
      links={[
        { href: links.stays, label: copy.stayOptions.apartmentsCta, style: 'text' },
        { href: links.book, label: copy.closing.cta, style: 'inline' }
      ]}
      spacing="page"
      role="next-action"
      family="experience"
      tone="romance"
    />
  </AmaraPageShell>
</BaseLayout>
