---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import type { EditorialClosingCtaLink } from '../../components/editorial/EditorialClosingCta.astro';
import TrustFamilyClosing from '../../components/trust/TrustFamilyClosing.astro';
import EditorialSplit from '../../components/editorial/EditorialSplit.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import AmaraSectionIntro from '../../components/layout/AmaraSectionIntro.astro';
import {
  guestReviewsCopy,
  guestReviewsFooterLabels,
  guestReviewsSeo
} from '../../content/guestReviewsContent';
import { airbnbReviewEvidence } from '../../content/reviewEvidence';
import type { LabeledLink } from '../../lib/linkResolver';
import TrustPageLayout from '../../layouts/TrustPageLayout.astro';
import type { AmaraLanguage } from '../../types/seo';
import awardLounis from '../../assets/images/content/booking-awards-2026/amara-lounis-booking-award-2026.png';
import awardMaha from '../../assets/images/content/booking-awards-2026/amara-maha-booking-award-2026.png';
import awardZaid from '../../assets/images/content/booking-awards-2026/amara-zaid-booking-award-2026.png';
import awardPlaya from '../../assets/images/content/booking-awards-2026/amara-playa-booking-award-2026.png';
import awardFamilySurf from '../../assets/images/content/booking-awards-2026/amara-family-surf-booking-award-2026.png';

interface Props {
  currentLang: AmaraLanguage;
}

const { currentLang } = Astro.props;
const seo = guestReviewsSeo;
const copy = guestReviewsCopy;
const awardScoreFormatter = new Intl.NumberFormat(currentLang, {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1
});
const formatAward = (award: { name: string; score: number }) =>
  `${award.name} - ${awardScoreFormatter.format(award.score)} / 10`;
const awardImageAlt = (award: { name: string; score: number }) =>
  copy.sections.awardImageAlt[currentLang]
    .replace('{stay}', award.name)
    .replace('{score}', awardScoreFormatter.format(award.score));
const awards = [
  { ...copy.awards.frigiliana[0], image: awardLounis },
  { ...copy.awards.frigiliana[1], image: awardMaha },
  { ...copy.awards.frigiliana[2], image: awardZaid },
  { ...copy.awards.coast[0], image: awardPlaya },
  { ...copy.awards.coast[1], image: awardFamilySurf }
];
const footerHighlights: LabeledLink[] = [
  { token: 'amenities', label: guestReviewsFooterLabels.amenities[currentLang] },
  { token: 'faq_general', label: guestReviewsFooterLabels.faq_general[currentLang] },
  { token: 'instagram', label: guestReviewsFooterLabels.instagram[currentLang] }
];
const closingCtaLinks: EditorialClosingCtaLink[] = [
  { token: 'book', label: copy.sections.ctaBook[currentLang], style: 'primary' },
  { token: 'romantic_hideaways', label: copy.sections.ctaExplore[currentLang], style: 'text' }
];
---

<TrustPageLayout
  seo={seo}
  currentLang={currentLang}
  languageToken="reviews_hub"
  footerHighlights={footerHighlights}
  pageId="guest-reviews"
  pageFamily="guest-reviews"
  hero={{
    subtitle: copy.hero.subtitle[currentLang],
    title: copy.hero.title[currentLang],
    titleWidth: 'wide',
    lead: copy.hero.lead[currentLang],
    supportText: copy.hero.supportText[currentLang]
  }}
>
  <AmaraSection>
        <EditorialSplit title={copy.sections.summaryTitle[currentLang]}>
          <p class="am-text-subtitle text-on-surface"><InlineEmphasis text={copy.sections.summaryLead[currentLang]} /></p>
          <p class="am-text-caption text-on-surface-variant">
            <a
              class="am-inline-link"
              href={airbnbReviewEvidence.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.sections.evidenceSource[currentLang]}
            </a>
          </p>
          <p class="am-text-body text-subtle">{copy.sections.summaryBodyOne[currentLang]}</p>
        </EditorialSplit>
  </AmaraSection>

  <AmaraSection>
        <AmaraSectionIntro
          title={copy.sections.reviewsTitle[currentLang]}
          note={copy.sections.reviewsNote[currentLang]}
          variant="centered"
        />

        <div class="grid gap-[clamp(2rem,4vw,3rem)] lg:grid-cols-3">
          {copy.reviews.map((review) => (
            <article class="border border-on-surface/5 bg-surface-container-lowest p-[clamp(2rem,3vw,2.5rem)]">
              <p class="am-text-caption mb-6 text-muted">{review.meta[currentLang]}</p>
              <p class="am-text-body text-strong">&ldquo;{review.copy[currentLang]}&rdquo;</p>
            </article>
          ))}
        </div>
  </AmaraSection>

  <AmaraSection>
      <div class="mx-auto max-w-[900px]">
        <AmaraSectionIntro
          title={copy.sections.mentionsTitle[currentLang]}
          note={copy.sections.mentionsNote[currentLang]}
          variant="centered"
        />

        <div class="border-t-2 border-on-surface">
          {copy.proofPoints[currentLang].map((item) => (
            <div class="grid border-b border-on-surface/10 py-[1.8rem]">
              <p class="am-text-body m-0 text-strong"><InlineEmphasis text={item} /></p>
            </div>
          ))}
        </div>
      </div>
  </AmaraSection>

  <AmaraSection id="booking-awards" class="am-page-band">
        <AmaraSectionIntro
          title={copy.sections.awardsTitle[currentLang]}
          intro={copy.sections.awardsBody[currentLang]}
          note={copy.sections.awardsSource[currentLang]}
          variant="centered"
          emphasizeIntro
        />

        <div class="am-booking-awards-grid mx-auto max-w-[960px]">
          {awards.map((award) => (
            <figure class="m-0 overflow-hidden border border-on-surface/5 bg-surface-container-lowest shadow-[var(--shadow-editorial-card)]">
              <AmaraImage
                src={award.image}
                alt={awardImageAlt(award)}
                profile="card"
                class="block h-auto w-full"
              />
              <figcaption class="sr-only">{formatAward(award)}</figcaption>
            </figure>
          ))}
        </div>
  </AmaraSection>

      <TrustFamilyClosing
        family="guest-reviews"
        title={copy.sections.nextTitle[currentLang]}
        lead={copy.sections.nextLead[currentLang]}
        links={closingCtaLinks}
        lang={currentLang}
      />
</TrustPageLayout>

<style>
  .am-booking-awards-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .am-booking-awards-grid figure {
    flex: 0 1 100%;
  }

  @media (min-width: 48rem) {
    .am-booking-awards-grid figure {
      flex-basis: calc(50% - 1rem);
    }
  }

  @media (min-width: 64rem) {
    .am-booking-awards-grid figure {
      flex-basis: calc(33.333% - 1.35rem);
    }
  }
</style>
