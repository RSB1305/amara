---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import {
  guestReviewsCopy,
  guestReviewsFooterLabels,
  guestReviewsSeo
} from '../../content/guestReviewsContent';
import { airbnbReviewEvidence } from '../../content/reviewEvidence';
import { resolveLink, resolveOptionalLink } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  currentLang: AmaraLanguage;
}

const { currentLang } = Astro.props;
const seo = guestReviewsSeo;
const copy = guestReviewsCopy;
const trustLinks = [
  { token: 'about', label: copy.hero.ctaAbout[currentLang] },
  { token: 'reviews_hub', label: copy.sections.reviewsTitle[currentLang] },
  { token: 'direct_booking_benefits', label: copy.hero.ctaBenefits[currentLang] }
];
const footerHighlights = [
  { token: 'amenities', label: guestReviewsFooterLabels.amenities[currentLang] },
  { token: 'faq_general', label: guestReviewsFooterLabels.faq_general[currentLang] },
  { token: 'instagram', label: guestReviewsFooterLabels.instagram[currentLang] }
];
const heroCtaLinks = [
  { token: 'book', label: copy.sections.ctaBook[currentLang] },
  { token: 'direct_booking_benefits', label: copy.hero.ctaBenefits[currentLang] }
]
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
const closingCtaLinks = [
  { token: 'book', label: copy.sections.ctaBook[currentLang], style: 'primary' as const },
  { token: 'romantic_hideaways', label: copy.sections.ctaExplore[currentLang], style: 'secondary' as const },
  { token: 'direct_booking_benefits', label: copy.sections.ctaBenefits[currentLang], style: 'secondary' as const }
];
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    brandName="AMARA"
    links={trustLinks}
    variant="trust"
    languageToken="reviews_hub"
  />
  <div class="am-root bg-white" data-am-page="guest-reviews">
    <div class="am-wrap w-full max-w-[1400px] mx-auto px-[5vw]">
    <TrustHero
      subtitle={copy.hero.subtitle[currentLang]}
      title={copy.hero.title[currentLang]}
      lead={copy.hero.lead[currentLang]}
      supportText={copy.hero.supportText[currentLang]}
      ctaLinks={heroCtaLinks}
      ctaVariant="conversion"
    />

    <main>
      <!-- The opening split mirrors the About page: one anchored title, one dense proof column. -->
      <section class="am-reviews-section">
        <div class="am-reviews-split">
          <div class="am-reviews-split__left">
            <h2 class="am-text-title">{copy.sections.summaryTitle[currentLang]}</h2>
          </div>
          <div class="am-reviews-split__right">
            <p class="am-text-subtitle text-on-surface mb-8">{copy.sections.summaryLead[currentLang]}</p>
            <p class="am-text-caption text-on-surface-variant mb-6">
              <a
                class="am-inline-link"
                href={airbnbReviewEvidence.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {copy.sections.evidenceSource[currentLang]}
              </a>
            </p>
            <p class="am-text-body text-subtle">
              {copy.sections.summaryBodyOne[currentLang]}
            </p>
            <p class="am-text-body text-subtle">
              {copy.sections.summaryBodyTwo[currentLang].before}
              <a href={resolveLink('direct_booking_benefits', currentLang)} class="am-inline-link">{copy.sections.summaryBodyTwo[currentLang].linkLabel}</a>
              {copy.sections.summaryBodyTwo[currentLang].after}
            </p>
          </div>
        </div>
      </section>

      <section class="am-reviews-section am-reviews-quote-block">
        <blockquote class="am-text-title italic am-reviews-quote">
          &ldquo;{copy.sections.quote[currentLang]}&rdquo;
        </blockquote>
      </section>

      <section class="am-reviews-section">
        <div class="am-reviews-section-header">
          <h2 class="am-text-title">{copy.sections.reviewsTitle[currentLang]}</h2>
          <p class="am-text-body text-muted italic am-reviews-section-note">{copy.sections.reviewsNote[currentLang]}</p>
        </div>

        <div class="am-reviews-grid">
          {copy.reviews.map((review) => (
            <article class="am-reviews-card">
              <p class="am-text-caption text-on-surface/60 am-reviews-card__meta">{review.meta[currentLang]}</p>
              <p class="am-text-body text-strong am-reviews-card__copy">&ldquo;{review.copy[currentLang]}&rdquo;</p>
            </article>
          ))}
        </div>
      </section>

      <section class="am-reviews-section am-reviews-proof">
        <div class="am-reviews-proof__header">
          <h2 class="am-text-title">{copy.sections.mentionsTitle[currentLang]}</h2>
          <p class="am-text-body text-muted italic am-reviews-proof__note">{copy.sections.mentionsNote[currentLang]}</p>
        </div>

        <div class="am-reviews-list">
          {copy.proofPoints[currentLang].map((item) => (
            <div class="am-reviews-list__item">
              <p class="am-text-body text-strong am-reviews-list__copy">{item}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Awards are grouped clearly, but kept editorial rather than widget-like. -->
      <section class="am-reviews-section am-reviews-awards">
        <div class="am-reviews-awards__header">
          <h2 class="am-text-title am-reviews-awards__title">{copy.sections.awardsTitle[currentLang]}</h2>
          <p class="am-text-body text-subtle">{copy.sections.awardsBody[currentLang]}</p>
          <p class="am-text-body text-muted italic am-reviews-awards__source">{copy.sections.awardsSource[currentLang]}</p>
        </div>

        <div class="am-reviews-awards__grid">
          <div class="am-reviews-awards__group">
            <h3 class="am-text-caption am-reviews-awards__label">Frigiliana</h3>
            <ul class="am-text-body text-on-surface am-reviews-ul">
              {copy.awards.frigiliana.map((award) => (
                <li>{award}</li>
              ))}
            </ul>
          </div>

          <div class="am-reviews-awards__group">
            <h3 class="am-text-caption am-reviews-awards__label">Nerja & Tarifa</h3>
            <ul class="am-text-body text-on-surface am-reviews-ul">
              {copy.awards.coast.map((award) => (
                <li>{award}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="am-reviews-section am-reviews-locations">
        <div class="am-reviews-locations__header">
          <h2 class="am-text-title">{copy.sections.locationTitle[currentLang]}</h2>
          <p class="am-text-body text-subtle">{copy.sections.locationLead[currentLang]}</p>
        </div>

        <div class="am-reviews-locations__trio">
          <a href={resolveLink('location_frigiliana', currentLang)} class="am-card-link am-reviews-location">
            <div class="am-reviews-location__image"><span>Frigiliana</span></div>
            <div class="am-reviews-location__caption">
              <h3 class="am-text-subtitle am-reviews-location__title">Frigiliana</h3>
              <p class="am-text-body text-subtle">{copy.sections.locationFrigiliana[currentLang]}</p>
            </div>
          </a>

          <a href={resolveLink('location_nerja', currentLang)} class="am-card-link am-reviews-location">
            <div class="am-reviews-location__image"><span>Nerja</span></div>
            <div class="am-reviews-location__caption">
              <h3 class="am-text-subtitle am-reviews-location__title">Nerja</h3>
              <p class="am-text-body text-subtle">{copy.sections.locationNerja[currentLang]}</p>
            </div>
          </a>

          <span class="am-card-link am-reviews-location am-is-disabled" aria-disabled="true">
            <div class="am-reviews-location__image"><span>Tarifa</span></div>
            <div class="am-reviews-location__caption">
              <h3 class="am-text-subtitle am-reviews-location__title">Tarifa</h3>
              <p class="am-text-body text-subtle">{copy.sections.locationTarifa[currentLang]}</p>
            </div>
          </span>
        </div>
      </section>

      <EditorialClosingCta
        title={copy.sections.nextTitle[currentLang]}
        lead={copy.sections.nextLead[currentLang]}
        links={closingCtaLinks}
        lang={currentLang}
      />
    </main>
    </div>
  </div>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .am-reviews-section {
    margin-bottom: clamp(8rem, 15vw, 14rem);
  }

  .am-reviews-split {
    display: grid;
    grid-template-columns: 1.2fr 1.8fr;
    gap: clamp(4rem, 8vw, 8rem);
  }

  .am-reviews-split__left .am-text-title {
    position: sticky;
    top: 2rem;
  }

  .am-reviews-split__right {
    max-width: 65ch;
  }

  .am-reviews-split__right p {
    margin-bottom: 1.5rem;
  }

  .am-reviews-quote-block {
    padding: clamp(4rem, 8vw, 8rem) 0;
    text-align: center;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  .am-reviews-quote {
    line-height: 1.15;
    letter-spacing: -0.02em;
    @apply text-on-surface;
    margin: 0;
  }

  .am-reviews-section-header,
  .am-reviews-proof__header,
  .am-reviews-awards__header,
  .am-reviews-locations__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem;
  }

  .am-reviews-section-note,
  .am-reviews-proof__note,
  .am-reviews-awards__source {
    @apply text-muted;
    font-style: italic;
  }

  .am-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
  }

  .am-reviews-card {
    @apply bg-surface border border-on-surface/5;
    padding: clamp(2rem, 3vw, 2.5rem);
  }

  .am-reviews-card__meta {
    margin-bottom: 1.5rem;
    opacity: 0.75;
  }

  .am-reviews-card__copy {
    @apply text-strong;
    line-height: 1.85;
  }

  .am-reviews-proof {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .am-reviews-list {
    border-top: 2px solid var(--color-on-surface);
  }

  .am-reviews-list__item {
    display: grid;
    grid-template-columns: 1fr;
    padding: 1.8rem 0;
    @apply border-b border-on-surface/10;
  }

  .am-reviews-list__copy {
    margin: 0;
    @apply text-strong;
  }

  .am-reviews-awards {
    @apply bg-surface;
    padding: clamp(4rem, 8vw, 8rem) clamp(2rem, 5vw, 5rem);
    margin-left: -5vw;
    margin-right: -5vw;
  }

  .am-reviews-awards__title {
    margin-bottom: 1.5rem;
  }

  .am-reviews-awards__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .am-reviews-awards__group {
    @apply bg-white border border-on-surface/5;
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: var(--shadow-editorial-card);
  }

  .am-reviews-awards__label {
    @apply text-hint border-b border-on-surface/10;
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
  }

  .am-reviews-ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .am-reviews-ul li {
    margin-bottom: 1rem;
    position: relative;
    padding-left: 1.25rem;
    @apply text-on-surface;
  }

  .am-reviews-ul li::before {
    content: "-";
    position: absolute;
    left: 0;
    @apply text-on-surface/35;
  }

  .am-reviews-locations__trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .am-reviews-location {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .am-reviews-location__image {
    aspect-ratio: 3 / 4;
    @apply bg-on-surface/[0.03];
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: background-color 0.2s ease;
  }

  .am-reviews-location:hover .am-reviews-location__image {
    @apply bg-on-surface/5;
  }

  .am-reviews-location__image span {
    font-family: var(--font-headline);
    font-style: italic;
    @apply text-on-surface/30;
  }

  .am-reviews-location__title {
    margin-bottom: 0.5rem;
    @apply text-on-surface;
  }

  @media (max-width: 1000px) {
    .am-reviews-grid,
    .am-reviews-locations__trio,
    .am-reviews-awards__grid,
    .am-reviews-split {
      grid-template-columns: 1fr;
    }

    .am-reviews-split__left .am-text-title {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .am-reviews-hero__links {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      justify-content: center;
    }

    .am-reviews-hero__dot {
      display: none;
    }
  }
</style>
