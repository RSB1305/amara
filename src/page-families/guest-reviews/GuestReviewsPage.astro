---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import type { EditorialClosingCtaLink } from '../../components/editorial/EditorialClosingCta.astro';
import EditorialQuote from '../../components/editorial/EditorialQuote.astro';
import EditorialSplit from '../../components/editorial/EditorialSplit.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import frigilianaLocationImage from '../../assets/images/content/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/04-frigiliana-pueblo.jpg';
import nerjaLocationImage from '../../assets/images/home/amara-playa-chaparril-13.webp';
import tarifaLocationImage from '../../assets/images/home/amara-tarifa-apartment01.webp';
import {
  guestReviewsCopy,
  guestReviewsFooterLabels,
  guestReviewsSeo
} from '../../content/guestReviewsContent';
import { airbnbReviewEvidence } from '../../content/reviewEvidence';
import { resolveLink, resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import TrustPageLayout from '../../layouts/TrustPageLayout.astro';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  currentLang: AmaraLanguage;
}

const { currentLang } = Astro.props;
const seo = guestReviewsSeo;
const copy = guestReviewsCopy;
const awardScoreFormatter = new Intl.NumberFormat(currentLang, {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1
});
const formatAward = (award: { name: string; score: number }) =>
  `${award.name} - ${awardScoreFormatter.format(award.score)} / 10`;
const footerHighlights: LabeledLink[] = [
  { token: 'amenities', label: guestReviewsFooterLabels.amenities[currentLang] },
  { token: 'faq_general', label: guestReviewsFooterLabels.faq_general[currentLang] },
  { token: 'instagram', label: guestReviewsFooterLabels.instagram[currentLang] }
];
const heroCtaLinks = ([
  { token: 'book', label: copy.sections.ctaBook[currentLang] },
  { token: 'direct_booking_benefits', label: copy.hero.ctaBenefits[currentLang] }
] satisfies LabeledLink[])
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
const closingCtaLinks: EditorialClosingCtaLink[] = [
  { token: 'book', label: copy.sections.ctaBook[currentLang], style: 'primary' as const },
  { token: 'romantic_hideaways', label: copy.sections.ctaExplore[currentLang], style: 'secondary' as const },
  { token: 'direct_booking_benefits', label: copy.sections.ctaBenefits[currentLang], style: 'secondary' as const }
];
---

<TrustPageLayout
  seo={seo}
  currentLang={currentLang}
  languageToken="reviews_hub"
  footerHighlights={footerHighlights}
  pageId="guest-reviews"
  hero={{
    subtitle: copy.hero.subtitle[currentLang],
    title: copy.hero.title[currentLang],
    titleWidth: 'wide',
    lead: copy.hero.lead[currentLang],
    supportText: copy.hero.supportText[currentLang],
    ctaLinks: heroCtaLinks,
    ctaVariant: 'conversion'
  }}
>
      <section class="mb-[var(--spacing-section-y)]">
        <EditorialSplit title={copy.sections.summaryTitle[currentLang]}>
          <p class="am-text-subtitle text-on-surface"><InlineEmphasis text={copy.sections.summaryLead[currentLang]} /></p>
          <p class="am-text-caption text-on-surface-variant">
            <a
              class="am-inline-link"
              href={airbnbReviewEvidence.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.sections.evidenceSource[currentLang]}
            </a>
          </p>
          <p class="am-text-body text-subtle">{copy.sections.summaryBodyOne[currentLang]}</p>
        </EditorialSplit>
      </section>

      <div class="mb-[var(--spacing-section-y)]">
        <EditorialQuote quote={copy.sections.quote[currentLang]} />
      </div>

      <section class="mb-[var(--spacing-section-y)]">
        <div class="mx-auto mb-16 max-w-[760px] text-center">
          <h2 class="am-text-title">{copy.sections.reviewsTitle[currentLang]}</h2>
          <p class="am-text-body italic text-muted"><InlineEmphasis text={copy.sections.reviewsNote[currentLang]} /></p>
        </div>

        <div class="grid gap-[clamp(2rem,4vw,3rem)] lg:grid-cols-3">
          {copy.reviews.map((review) => (
            <article class="border border-on-surface/5 bg-surface p-[clamp(2rem,3vw,2.5rem)]">
              <p class="am-text-caption mb-6 text-on-surface/60 opacity-75">{review.meta[currentLang]}</p>
              <p class="am-text-body leading-[1.85] text-strong">&ldquo;{review.copy[currentLang]}&rdquo;</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mx-auto mb-[var(--spacing-section-y)] max-w-[900px]">
        <div class="mx-auto mb-16 max-w-[760px] text-center">
          <h2 class="am-text-title">{copy.sections.mentionsTitle[currentLang]}</h2>
          <p class="am-text-body italic text-muted"><InlineEmphasis text={copy.sections.mentionsNote[currentLang]} /></p>
        </div>

        <div class="border-t-2 border-on-surface">
          {copy.proofPoints[currentLang].map((item) => (
            <div class="grid border-b border-on-surface/10 py-[1.8rem]">
              <p class="am-text-body m-0 text-strong"><InlineEmphasis text={item} /></p>
            </div>
          ))}
        </div>
      </section>

      <section class="-mx-[5vw] mb-[var(--spacing-section-y)] bg-surface px-[clamp(2rem,5vw,5rem)] py-[clamp(4rem,8vw,8rem)]">
        <div class="mx-auto mb-16 max-w-[760px] text-center">
          <h2 class="am-text-title mb-6">{copy.sections.awardsTitle[currentLang]}</h2>
          <p class="am-text-body text-subtle"><InlineEmphasis text={copy.sections.awardsBody[currentLang]} /></p>
          <p class="am-text-body italic text-muted"><InlineEmphasis text={copy.sections.awardsSource[currentLang]} /></p>
        </div>

        <div class="mx-auto grid max-w-[1100px] gap-[clamp(2rem,4vw,4rem)] lg:grid-cols-2">
          <div class="border border-on-surface/5 bg-white p-[clamp(2rem,4vw,3rem)] shadow-[var(--shadow-editorial-card)]">
            <h3 class="am-text-caption mb-6 border-b border-on-surface/10 pb-[0.6rem] text-muted">Frigiliana</h3>
            <ul class="am-text-body m-0 list-none p-0 text-on-surface">
              {copy.awards.frigiliana.map((award) => (
                <li class="relative mb-4 pl-5 before:absolute before:left-0 before:text-on-surface/35 before:content-['-'] last:mb-0">{formatAward(award)}</li>
              ))}
            </ul>
          </div>

          <div class="border border-on-surface/5 bg-white p-[clamp(2rem,4vw,3rem)] shadow-[var(--shadow-editorial-card)]">
            <h3 class="am-text-caption mb-6 border-b border-on-surface/10 pb-[0.6rem] text-muted">Nerja & Tarifa</h3>
            <ul class="am-text-body m-0 list-none p-0 text-on-surface">
              {copy.awards.coast.map((award) => (
                <li class="relative mb-4 pl-5 before:absolute before:left-0 before:text-on-surface/35 before:content-['-'] last:mb-0">{formatAward(award)}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-[var(--spacing-section-y)]">
        <div class="mx-auto mb-16 max-w-[760px] text-center">
          <h2 class="am-text-title">{copy.sections.locationTitle[currentLang]}</h2>
          <p class="am-text-body text-subtle"><InlineEmphasis text={copy.sections.locationLead[currentLang]} /></p>
        </div>

        <div class="grid gap-[clamp(2rem,4vw,4rem)] lg:grid-cols-3">
          <a href={resolveLink('location_frigiliana', currentLang)} class="am-card-link group block">
            <div class="mb-6 aspect-[3/4] overflow-hidden bg-on-surface/[0.03]">
              <AmaraImage
                src={frigilianaLocationImage}
                alt=""
                profile="card"
                class="block h-full w-full object-cover [transition:transform_0.45s_ease] group-hover:scale-[1.025] group-focus-visible:scale-[1.025] motion-reduce:transition-none"
                sizes="(max-width: 1000px) 90vw, (max-width: 1555px) 29vw, 420px"
              />
            </div>
            <div>
              <h3 class="am-text-subtitle mb-2 text-on-surface">Frigiliana</h3>
              <p class="am-text-body text-subtle"><InlineEmphasis text={copy.sections.locationFrigiliana[currentLang]} /></p>
            </div>
          </a>

          <a href={resolveLink('location_nerja', currentLang)} class="am-card-link group block">
            <div class="mb-6 aspect-[3/4] overflow-hidden bg-on-surface/[0.03]">
              <AmaraImage
                src={nerjaLocationImage}
                alt=""
                profile="card"
                class="block h-full w-full object-cover [transition:transform_0.45s_ease] group-hover:scale-[1.025] group-focus-visible:scale-[1.025] motion-reduce:transition-none"
                sizes="(max-width: 1000px) 90vw, (max-width: 1555px) 29vw, 420px"
              />
            </div>
            <div>
              <h3 class="am-text-subtitle mb-2 text-on-surface">Nerja</h3>
              <p class="am-text-body text-subtle"><InlineEmphasis text={copy.sections.locationNerja[currentLang]} /></p>
            </div>
          </a>

          <a href={resolveLink('location_tarifa', currentLang)} class="am-card-link group block">
            <div class="mb-6 aspect-[3/4] overflow-hidden bg-on-surface/[0.03]">
              <AmaraImage
                src={tarifaLocationImage}
                alt=""
                profile="card"
                class="block h-full w-full object-cover [transition:transform_0.45s_ease] group-hover:scale-[1.025] group-focus-visible:scale-[1.025] motion-reduce:transition-none"
                sizes="(max-width: 1000px) 90vw, (max-width: 1555px) 29vw, 420px"
              />
            </div>
            <div>
              <h3 class="am-text-subtitle mb-2 text-on-surface">Tarifa</h3>
              <p class="am-text-body text-subtle"><InlineEmphasis text={copy.sections.locationTarifa[currentLang]} /></p>
            </div>
          </a>
        </div>
      </section>

      <EditorialClosingCta
        title={copy.sections.nextTitle[currentLang]}
        lead={copy.sections.nextLead[currentLang]}
        links={closingCtaLinks}
        lang={currentLang}
      />
</TrustPageLayout>
