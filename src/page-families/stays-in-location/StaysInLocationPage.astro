---
/**
 * Stays-in-location collection page.
 *
 * The property catalogue for one destination, living inside the localized stays
 * silo (e.g. /de/unterkuenfte/frigiliana). Cards are derived from the vacation
 * rental entities filtered by city, so the stay links and specs follow the
 * manifest and the entity data; the editorial frame comes from
 * staysInLocationContent, keyed by location.
 */
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  staysInLocationContent,
  staysInLocationSeo,
  staysInLocationUnits,
  type StayLocation
} from '../../content/staysInLocationContent';
import { vacationRentalEntities } from '../../content/vacationRentalEntities';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import { resolveLocale } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';

import imgFarah from '../../assets/images/home/amara-farah-67-amara-frigiliana.jpg';
import imgLounis from '../../assets/images/home/amara-lounis-15-amara-frigiliana.jpg';
import imgZaid from '../../assets/images/home/amara-zaid-terraza-5.jpg';
import imgMaha from '../../assets/images/home/amara-maha-29-amara-frigiliana.jpg';

interface Props {
  location: StayLocation;
  lang?: string;
}

const { location, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);

const locationCatalogue = staysInLocationContent as Partial<
  Record<StayLocation, (typeof staysInLocationContent)['frigiliana']>
>;
const locationContent = locationCatalogue[location];

if (!locationContent) {
  throw new Error(`[AMARA] stays-in-location has no content for "${location}".`);
}

const copy = resolveLocale(locationContent, currentLang);
const units = resolveLocale(staysInLocationUnits, currentLang);
const seo = staysInLocationSeo[location];

const cityByLocation: Record<StayLocation, string> = {
  frigiliana: 'Frigiliana',
  nerja: 'Nerja',
  tarifa: 'Tarifa'
};

const stayImages: Record<string, ImageMetadata> = {
  'la-amara-farah': imgFarah,
  'la-amara-lounis': imgLounis,
  'la-amara-zaid': imgZaid,
  'la-amara-maha': imgMaha
};

const rentals = vacationRentalEntities.filter(
  (rental) => rental.city === cityByLocation[location]
);

const stayNotes = copy.stayNotes as Record<string, string>;

const cards = rentals.map((rental) => {
  const specs = [
    rental.city,
    `${rental.occupancy} ${units.guests}`,
    `${rental.interiorAreaSqm} m²`,
    rental.exteriorAreaSqm
      ? `${units.terrace} ${rental.exteriorAreaSqm} m²`
      : undefined
  ].filter(Boolean);

  return {
    slug: rental.slug,
    name: rental.name,
    image: stayImages[rental.slug],
    alt: `${rental.name}, ${rental.city}`,
    specs: specs.join(' · '),
    note: stayNotes[rental.slug],
    href: buildOwnedLocalizedPath(rental.slug, currentLang)
  };
});

const handoffLinks = {
  whereToStay: buildOwnedLocalizedPath(`${location}.where-to-stay`, currentLang),
  place: buildOwnedLocalizedPath(location, currentLang)
};

const requiredLink = createRequiredLinkResolver(currentLang, `AMARA stays in ${cityByLocation[location]}`);
const closingLinks = {
  book: requiredLink('book'),
  stays: requiredLink('romantic_hideaways')
};

const footerHighlights: LabeledLink[] = [
  { token: 'romantic_hideaways', label: copy.footerHighlights.stays },
  { token: `location_${location}`, label: copy.footerHighlights.place }
];
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  contextBreadcrumbTitle={cityByLocation[location]}
  footerHighlights={footerHighlights}
  showContextNavigation={false}
  pageFamily="stays-in-location"
  navigationLanguageToken="romantic_hideaways"
>
  <AmaraPageShell family="stays-in-location" dataLang={currentLang} flush whiteCanvas>
    <AmaraSection dataComponent="stays-location-hero">
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{copy.hero.kicker}</p>
          <h1 class="am-text-display mt-5 text-on-surface">{copy.hero.title}</h1>
          <p class="am-text-subtitle mt-6 text-on-surface-variant">{copy.hero.lead}</p>
          <div class="mt-8 space-y-5">
            {copy.hero.answer.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>
      </div>
    </AmaraSection>

    <AmaraSection dataComponent="stays-location-collection">
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
        <div class="flex items-baseline justify-between gap-6 border-b border-outline-variant/15 pb-4">
          <h2 class="am-text-title text-on-surface">{copy.collection.title}</h2>
          <span class="am-text-caption text-on-surface-variant">{copy.collection.count}</span>
        </div>

        <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-x-10 md:gap-y-16">
          {cards.map((card) => (
            <article class="flex flex-col">
              {card.image && (
                <AmaraImage
                  src={card.image}
                  alt={card.alt}
                  profile="gallery"
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <h3 class="am-text-subtitle mt-6 text-on-surface">{card.name}</h3>
              <p class="am-text-caption mt-2 text-on-surface-variant">{card.specs}</p>
              <p class="am-text-body mt-3 flex-1 leading-relaxed text-on-surface-variant">{card.note}</p>
              <a class="am-inline-link mt-5 w-fit" href={card.href}>
                {units.view}<span aria-hidden="true"> →</span>
              </a>
            </article>
          ))}
        </div>

        <div class="mt-16 grid gap-10 border-t border-outline-variant/15 pt-12 md:grid-cols-2">
          <div>
            <p class="am-text-eyebrow text-primary">{copy.handoff.advisory.eyebrow}</p>
            <p class="am-text-body mt-3 max-w-md leading-relaxed text-on-surface-variant">{copy.handoff.advisory.text}</p>
            <a class="am-inline-link mt-4 w-fit" href={handoffLinks.whereToStay}>
              {copy.handoff.advisory.label}<span aria-hidden="true"> →</span>
            </a>
          </div>
          <div>
            <p class="am-text-eyebrow text-primary">{copy.handoff.place.eyebrow}</p>
            <p class="am-text-body mt-3 max-w-md leading-relaxed text-on-surface-variant">{copy.handoff.place.text}</p>
            <a class="am-inline-link mt-4 w-fit" href={handoffLinks.place}>
              {copy.handoff.place.label}<span aria-hidden="true"> →</span>
            </a>
          </div>
        </div>
      </div>
    </AmaraSection>

    <EditorialClosingCta
      dataComponent="stays-location-closing"
      title={copy.closing.title}
      lead={copy.closing.lead}
      paragraphs={[copy.closing.lead]}
      lang={currentLang}
      links={[
        { href: closingLinks.stays, label: copy.closing.collectionCta, style: 'text' },
        { href: closingLinks.book, label: copy.closing.cta, style: 'inline' }
      ]}
      spacing="page"
      role="next-action"
      family="experience"
      tone="romance"
    />
  </AmaraPageShell>
</BaseLayout>
