---
import type { ImageMetadata } from 'astro';
import AmaraImage from '../../components/AmaraImage.astro';
import Hero from '../../components/Hero.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import Navigation from '../../components/Navigation.astro';
import {
  frigilianaWinterStaysContent,
  frigilianaWinterStaysSeo
} from '../../content/frigilianaWinterStaysContent';
import heroImage from '../../assets/images/content/hero-frigiliana.jpg';
import comfortImage from '../../assets/images/content/amara-lounis/17-amara-frigiliana.jpg';
import coastImage from '../../assets/images/content/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg';
import farahImage from '../../assets/images/home/amara-farah-67-amara-frigiliana.jpg';
import lounisImage from '../../assets/images/content/amara-lounis/28-amara-frigiliana.jpg';
import zaidImage from '../../assets/images/home/amara-zaid-terraza-5.jpg';
import mahaImage from '../../assets/images/home/amara-maha-29-amara-frigiliana.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveLink, type LinkToken } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaWinterStaysContent[currentLang];

const requiredLink = (token: LinkToken) =>
  resolveLink(token, currentLang, { context: 'Frigiliana winter stays' });

const links = {
  book: requiredLink('book'),
  weather: requiredLink('weather_frigiliana'),
  whereToStay: requiredLink('frigiliana_stairs'),
  comparison: requiredLink('nerja_vs_frigiliana'),
  farah: requiredLink('farah'),
  lounis: requiredLink('lounis'),
  zaid: requiredLink('zaid'),
  maha: requiredLink('maha')
};

const pelletStayKeys = ['lounis', 'zaid', 'maha'] as const;
const pelletImages: Record<(typeof pelletStayKeys)[number], ImageMetadata> = {
  lounis: lounisImage,
  zaid: zaidImage,
  maha: mahaImage
};
---

<BaseLayout
  seo={frigilianaWinterStaysSeo}
  pageLang={currentLang}
  contextBreadcrumbTitle={copy.hero.title}
  showContextNavigation={false}
>
  <Navigation
    currentLang={currentLang}
    currentToken="frigiliana_winter_stays"
    languageToken="frigiliana_winter_stays"
  />
  <LocationContextNav activeId="winter" lang={currentLang} />

  <main
    id="am-main-content"
    tabindex="-1"
    class="min-h-screen overflow-hidden scroll-mt-[104px] lg:scroll-mt-[112px]"
    data-am-page="frigiliana-winter-stays"
  >
    <Hero imageSrc={heroImage} imageAlt={copy.hero.imageAlt}>
      <span class="am-text-caption text-primary mb-8 block">
        {copy.hero.kicker}
      </span>
      <h1 class="am-text-display italic text-on-surface mb-7 break-words tracking-tighter md:mb-8">
        {copy.hero.title}
      </h1>
      <div class="mb-10">
        <a class="am-btn am-btn--primary" href={links.book}>
          {copy.hero.cta}
        </a>
      </div>
      <div class="max-w-2xl space-y-5 border-l border-primary/20 pl-6 md:pl-10">
        {copy.hero.paragraphs.map((paragraph, index) => (
          <p
            class:list={[
              index === 0
                ? 'am-text-subtitle italic text-on-surface leading-relaxed'
                : 'am-text-body text-on-surface-variant leading-relaxed'
            ]}
          >
            {paragraph}
          </p>
        ))}
      </div>
    </Hero>

    <section class="border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto grid max-w-screen-2xl gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {copy.village.title}
          </h2>
        </div>
        <div class="max-w-3xl space-y-5 lg:col-span-7 lg:col-start-6">
          {copy.village.paragraphs.map((paragraph) => (
            <p class="am-text-body text-on-surface-variant leading-relaxed">{paragraph}</p>
          ))}
          <a class="am-inline-link inline-block" href={links.weather}>
            {copy.village.weatherLink}
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <AmaraImage
            src={comfortImage}
            alt={copy.comfort.imageAlt}
            profile="gallery"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="max-w-2xl lg:col-span-5 lg:col-start-8">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {copy.comfort.title}
          </h2>
          <div class="mt-8 space-y-5">
            {copy.comfort.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant leading-relaxed">{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="winter-stays" class="scroll-mt-36 border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
        <h2 class="am-text-title max-w-3xl italic text-on-surface tracking-tight">
          {copy.pelletStays.title}
        </h2>
        <div class="mt-14 grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          {pelletStayKeys.map((stayKey) => {
            const stay = copy.pelletStays.stays[stayKey];
            return (
              <article class="flex min-w-0 flex-col">
                <a href={links[stayKey]} class="block overflow-hidden">
                  <AmaraImage
                    src={pelletImages[stayKey]}
                    alt={stay.imageAlt}
                    profile="card"
                    class="aspect-[4/3] h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <h3 class="am-text-subtitle mt-6 text-on-surface">{stay.title}</h3>
                <p class="am-text-body mt-3 flex-1 text-on-surface-variant leading-relaxed">
                  {stay.text}
                </p>
                <div class="mt-6">
                  <a class="am-btn am-btn--secondary" href={links[stayKey]}>{stay.cta}</a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12 lg:gap-16">
        <div class="max-w-2xl lg:col-span-5">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {copy.farah.title}
          </h2>
          <div class="mt-8 space-y-5">
            {copy.farah.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant leading-relaxed">{paragraph}</p>
            ))}
          </div>
          <a class="am-btn am-btn--secondary mt-8" href={links.farah}>{copy.farah.cta}</a>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <AmaraImage
            src={farahImage}
            alt={copy.farah.imageAlt}
            profile="gallery"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface-container-low">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <AmaraImage
            src={coastImage}
            alt={copy.coast.imageAlt}
            profile="gallery"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="max-w-2xl lg:col-span-6 lg:col-start-7">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {copy.coast.title}
          </h2>
          <div class="mt-8 space-y-5">
            {copy.coast.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant leading-relaxed">{paragraph}</p>
            ))}
          </div>
          <a class="am-btn am-btn--secondary mt-8" href={links.comparison}>{copy.coast.cta}</a>
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto max-w-4xl px-6 py-20 text-center md:px-12 md:py-28">
        <h2 class="am-text-title italic text-on-surface tracking-tight">
          {copy.duration.title}
        </h2>
        <div class="mx-auto mt-8 max-w-3xl space-y-5">
          {copy.duration.paragraphs.map((paragraph) => (
            <p class="am-text-body text-on-surface-variant leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-surface">
      <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
        <h2 class="am-text-title max-w-3xl italic text-on-surface tracking-tight">
          {copy.planning.title}
        </h2>
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          <p class="am-text-body border-t border-outline-variant/20 pt-5 text-on-surface-variant leading-relaxed">
            {copy.planning.weather.text}{' '}
            <a class="am-inline-link" href={links.weather}>{copy.planning.weather.link}</a>.
          </p>
          <p class="am-text-body border-t border-outline-variant/20 pt-5 text-on-surface-variant leading-relaxed">
            {copy.planning.whereToStay.text}{' '}
            <a class="am-inline-link" href={links.whereToStay}>{copy.planning.whereToStay.link}</a>.
          </p>
          <p class="am-text-body border-t border-outline-variant/20 pt-5 text-on-surface-variant leading-relaxed">
            {copy.planning.comparison.text}{' '}
            <a class="am-inline-link" href={links.comparison}>{copy.planning.comparison.link}</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-outline-variant/5 bg-on-surface text-surface">
      <div class="mx-auto max-w-4xl px-6 py-20 text-center md:px-12 md:py-28">
        <h2 class="am-text-title italic tracking-tight text-surface">
          {copy.finalCta.title}
        </h2>
        <div class="mx-auto mt-8 max-w-3xl space-y-5">
          {copy.finalCta.paragraphs.map((paragraph) => (
            <p class="am-text-body leading-relaxed text-surface/80">{paragraph}</p>
          ))}
        </div>
        <a class="am-btn am-btn--primary mt-9" href={links.book}>{copy.finalCta.cta}</a>
      </div>
    </section>
  </main>
</BaseLayout>
