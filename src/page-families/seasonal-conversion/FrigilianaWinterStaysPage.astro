---
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaWinterStaysContent,
  frigilianaWinterStaysSeo
} from '../../content/frigilianaWinterStaysContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import WinterStaysAuthorityArticle from '../location-authority/WinterStaysAuthorityArticle.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = frigilianaWinterStaysContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana winter stays');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_frigiliana');
const bookingHref = requiredLink('book');
const footerHighlights: LabeledLink[] = [
  { token: 'frigiliana_winter_stays', label: content.navLabel },
  { token: 'weather_frigiliana', label: content.related.links[0].label },
  { token: 'frigiliana_stairs', label: content.related.links[1].label }
];
---

<LocationAuthorityLayout
  seo={frigilianaWinterStaysSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_winter_stays"
  >
    <LocationContextNav slot="context-navigation" activeId="winter" lang={currentLang} />
  </Navigation>

  <WinterStaysAuthorityArticle
    pageId="frigiliana-winter-stays"
    lang={currentLang}
    content={content}
    seo={frigilianaWinterStaysSeo}
    authorHref={aboutHref}
    locationHref={locationHref}
    propertyHref={bookingHref}
    resolveHref={requiredLink}
  />
</LocationAuthorityLayout>
