---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import ExploreCampaignHero from '../../components/experience/ExploreCampaignHero.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialCallout from '../../components/content/EditorialCallout.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import heroImage from '../../assets/images/home/amara-lounis-15-amara-frigiliana.jpg';
import choiceImage from '../../assets/images/home/amara-zaid-terraza-5.jpg';
import { honeymoonContent, honeymoonSeo } from '../../content/honeymoonContent';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createAmaraImage } from '../../lib/images/amaraImageProfiles';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import { resolveLocale } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = resolveLocale(honeymoonContent, currentLang);
const seoHeroImage = await createAmaraImage(heroImage, 'hero');
const seo = { ...honeymoonSeo, ogImage: seoHeroImage.src };
const requiredLink = createRequiredLinkResolver(currentLang, 'Honeymoon in Andalusia');

const links = {
  book: requiredLink('book'),
  stays: requiredLink('romantic_hideaways')
};

const stayItems = copy.stayOptions.items.map((item) => ({
  ...item,
  href: requiredLink(item.linkToken)
}));

const footerHighlights: (LabeledLink & { decoration: 'heart' })[] = [
  { token: 'honeymoon', label: copy.footerHighlights.honeymoon, decoration: 'heart' },
  { token: 'romantic_hideaways', label: copy.footerHighlights.stays, decoration: 'heart' },
  { token: 'reviews_hub', label: copy.footerHighlights.reviews, decoration: 'heart' },
  { token: 'direct_booking_benefits', label: copy.footerHighlights.direct, decoration: 'heart' }
];
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  contextBreadcrumbTitle={copy.hero.title}
  footerHighlights={footerHighlights}
  showContextNavigation={false}
  pageFamily="campaign-honeymoon"
  navigationCurrentToken="honeymoon"
  navigationLanguageToken="honeymoon"
>
  <AmaraPageShell family="honeymoon" dataLang={currentLang} flush whiteCanvas>
    <ExploreCampaignHero
      imageSrc={heroImage}
      imageAlt={copy.hero.imageAlt}
      kicker={copy.hero.kicker}
      kickerDecoration="heart"
      title={copy.hero.title}
      lead={copy.hero.lead}
      paragraphs={copy.hero.paragraphs}
      action={{ href: '#honeymoon-stay', label: copy.hero.cta }}
    />

    <AmaraSection
      id="honeymoon-stay"
      dataComponent="honeymoon-stay"
      class="scroll-mt-36"
    >
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-6">
            <AmaraImage
              src={choiceImage}
              alt={copy.choice.imageAlt}
              profile="gallery"
              class="aspect-[4/3] h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="max-w-2xl lg:col-span-5 lg:col-start-8">
            <h2 class="am-text-subtitle text-on-surface">
              {copy.choice.title}
            </h2>
            <div class="mt-6 space-y-5">
              {copy.choice.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
          </div>
        </div>

        <div class="mt-16 border-t border-outline-variant/10 pt-12">
          <h2 class="am-text-title max-w-3xl text-on-surface">
            {copy.stayOptions.title}
          </h2>
          <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant">
            {copy.stayOptions.intro}
          </p>
          <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
            {stayItems.map((item) => (
              <article class="flex flex-col border-t border-outline-variant/20 pt-6">
                <p class="am-text-caption text-primary">{item.eyebrow}</p>
                <h3 class="am-honeymoon-stay-card__title am-text-subtitle mt-4 text-on-surface">{item.title}</h3>
                <p class="am-text-body mt-4 flex-1 leading-relaxed text-on-surface-variant">
                  {item.text}
                </p>
                <a class="am-inline-link mt-5 w-fit" href={item.href}>
                  {item.linkLabel}<span aria-hidden="true"> →</span>
                </a>
              </article>
            ))}
          </div>
          <EditorialCallout class="mt-10 max-w-4xl">
            {copy.stayOptions.note}
          </EditorialCallout>
        </div>
      </div>
    </AmaraSection>

    <EditorialClosingCta
      dataComponent="honeymoon-closing"
      title={copy.closing.title}
      lead={copy.closing.paragraphs[0]}
      paragraphs={copy.closing.paragraphs}
      lang={currentLang}
      links={[
        { href: links.stays, label: copy.stayOptions.collectionCta, style: 'text' },
        { href: links.book, label: copy.closing.cta, style: 'inline' }
      ]}
      spacing="page"
      role="next-action"
      family="experience"
      tone="romance"
    />
  </AmaraPageShell>
</BaseLayout>

<style>
  @media (min-width: 48rem) {
    .am-honeymoon-stay-card__title {
      min-block-size: 3lh;
    }
  }
</style>
