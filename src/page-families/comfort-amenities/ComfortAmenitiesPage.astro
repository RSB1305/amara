---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import {
  comfortAmenitiesCopy,
  comfortAmenitiesFooterLabels,
  comfortAmenitiesNav,
  comfortAmenitiesProperties,
  comfortAmenitiesSeo
} from '../../content/comfortAmenitiesContent';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const page = comfortAmenitiesCopy[currentLang];
const seo = comfortAmenitiesSeo;
const navBrandLabel = comfortAmenitiesNav.brandLabel[currentLang];
const navCtaLabel = comfortAmenitiesNav.ctaLabel[currentLang];
const footerHighlights = [
  { token: 'amenities', label: comfortAmenitiesFooterLabels.amenities[currentLang] },
  { token: 'faq_general', label: comfortAmenitiesFooterLabels.faq_general[currentLang] },
  { token: 'instagram', label: comfortAmenitiesFooterLabels.instagram[currentLang] }
];
const properties = comfortAmenitiesProperties;
const heroCtaLinks = [
  { token: 'about', label: page.hero.ctaAbout },
  { token: 'reviews_hub', label: page.hero.ctaReviews }
]
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    brandName="AMARA"
    brandLabel={navBrandLabel}
    links={page.trustLinks}
    variant="trust"
    languageToken="amenities"
    ctaLabel={navCtaLabel}
  />

  <div id="am-page-amenities" class="am-root font-body bg-white text-on-surface" data-am-page="amenities" data-current-lang={currentLang}>
    <section aria-label={page.sections.inventoryAria}>
      <div class="am-exp-page bg-white max-w-[1400px] mx-auto px-[5vw]">
        <TrustHero
          subtitle={page.hero.subtitle}
          title={page.hero.title}
          lead={page.hero.lead}
          supportText={page.hero.supportText}
          ctaLinks={heroCtaLinks}
        />
      </div>

      <div class="am-wrap w-full max-w-[76rem] mx-auto px-6 pb-20 max-md:px-4">

        <section class="am-section mb-12" aria-label={page.sections.conceptAria}>
          <h2 class="am-h2 mb-4 am-text-title font-medium leading-tight tracking-tight text-on-surface">{page.sections.conceptTitle}</h2>

          <div class="am-grid block">
            <article class="am-card mb-10 border-0 rounded-none bg-transparent shadow-none">
              <div class="am-card-body p-0">
                <h3 class="am-h2 mb-4 am-text-subtitle font-medium leading-tight tracking-tight text-on-surface">{page.sections.coreTitle}</h3>

                <div class="am-elist is-tight block">
                  {page.bullets.core.map((bullet, index) => (
                    <div class="am-elist-item block mb-4">
                      <div class="am-elist-ico hidden" aria-hidden="true">
                        {index === 0 && (
                          <svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                        )}
                        {index === 1 && (
                          <svg viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
                        )}
                        {index === 2 && (
                          <svg viewBox="0 0 24 24"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                        )}
                      </div>
                      <div class="am-elist-body">
                        <p class="am-elist-title mb-0.5 am-text-body font-semibold text-on-surface">{bullet.title}</p>
                        <p class="am-elist-desc m-0 am-text-body leading-relaxed text-on-surface-variant">{bullet.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>

            <article class="am-card mb-10 border-0 rounded-none bg-transparent shadow-none">
              <div class="am-card-body p-0">
                <h3 class="am-h2 mb-4 am-text-subtitle font-medium leading-tight tracking-tight text-on-surface">{page.sections.separateTitle}</h3>

                <div class="am-elist is-tight block">
                  {page.bullets.separate.map((bullet, index) => (
                    <div class="am-elist-item block mb-4">
                      <div class="am-elist-ico hidden" aria-hidden="true">
                        {index === 0 && (
                          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        )}
                        {index === 1 && (
                          <svg viewBox="0 0 24 24"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"></path></svg>
                        )}
                        {index === 2 && (
                          <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        )}
                      </div>
                      <div class="am-elist-body">
                        <p class="am-elist-title mb-0.5 am-text-body font-semibold text-on-surface">{bullet.title}</p>
                        <p class="am-elist-desc m-0 am-text-body leading-relaxed text-on-surface-variant">{bullet.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          </div>
        </section>

        <section class="am-section mb-12" aria-label={page.sections.inventoryAria}>
          <h2 class="am-h2 mb-4 am-text-title font-medium leading-tight tracking-tight text-on-surface">{page.sections.inventoryTitle}</h2>

          <div class="am-grid block">
            {properties.map((property) => (
              <article class="am-card mb-10 border-0 rounded-none bg-transparent shadow-none" data-rental-id={property.id}>
                <div class="am-card-body p-0">
                  <h3 class="am-h2 mb-4 am-text-subtitle font-medium leading-tight tracking-tight text-on-surface">{property.name}</h3>
                  <div class="am-prose max-w-[46rem]">
                    <p class="am-body am-text-body">
                      <a class="am-inline-link text-on-surface/80 underline underline-offset-[0.18em]" href={property.href}>{page.inventory.detailsLabel}</a>
                    </p>
                  </div>

                  <ul class="am-list-specs mt-4 m-0 p-0 list-none grid gap-y-[0.55rem] am-text-body leading-relaxed text-on-surface-variant">
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.license}</strong> <span class="text-right max-md:text-left">{property.specs.license}</span></li>
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.maxOccupancy}</strong> <span class="text-right max-md:text-left">{property.specs.maxOccupancy[currentLang]}</span></li>
                    {property.specs.bed && <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.bed}</strong> <span class="text-right max-md:text-left">{property.specs.bed}</span></li>}
                    {property.specs.beds && <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.beds}</strong> <span class="text-right max-md:text-left">{property.specs.beds[currentLang]}</span></li>}
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.price}</strong> <span class="text-right max-md:text-left">{property.specs.price[currentLang]}</span></li>
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.accessNote}</strong> <span class="text-right max-md:text-left">{property.specs.accessNote[currentLang]}</span></li>
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.pets}</strong> <span class="text-right max-md:text-left">{property.specs.pets[currentLang]}</span></li>
                    {property.specs.pool && <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.pool}</strong> <span class="text-right max-md:text-left">{property.specs.pool[currentLang]}</span></li>}
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.view}</strong> <span class="text-right max-md:text-left">{property.specs.view[currentLang]}</span></li>
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.outdoor}</strong> <span class="text-right max-md:text-left">{property.specs.outdoor[currentLang]}</span></li>
                    <li class="flex justify-between gap-4 pb-[0.55rem] border-b border-outline-variant/20 max-md:flex-col max-md:gap-0.5 max-md:items-start"><strong class="font-semibold text-on-surface">{page.inventory.labels.kitchen}</strong> <span class="text-right max-md:text-left">{property.specs.kitchen[currentLang]}</span></li>
                  </ul>

                  <div class="am-btn-row mt-5">
                    <a href={property.href} class="am-btn am-btn--primary">{page.inventory.directBooking}</a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="am-prose max-w-[46rem]">
            <p class="am-small mt-4 am-text-body leading-relaxed text-on-surface-variant">
              <strong>{page.noteTitle}</strong> {page.noteText}
            </p>

            <p class="am-small mt-8 border-t border-outline-variant/20 pt-2.5 am-text-caption text-muted">
              {page.aiLegalLabel}
            </p>
          </div>
        </section>
      </div>
    </section>

