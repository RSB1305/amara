<script>
  const amenitiesPage = document.querySelector<HTMLElement>('#am-page-amenities');

  if (amenitiesPage) {
    const amenityFilterButtons = Array.from(
      amenitiesPage.querySelectorAll<HTMLButtonElement>('[data-amenity-filter]')
    );
    const propertyFilterButtons = Array.from(
      amenitiesPage.querySelectorAll<HTMLButtonElement>('[data-property-filter]')
    );
    const propertyCards = Array.from(
      amenitiesPage.querySelectorAll<HTMLElement>('[data-rental-id]')
    );
    const emptyMessage = amenitiesPage.querySelector<HTMLElement>('[data-filter-empty]');
    let selectedCategory = 'all';
    let selectedProperty = 'all';

    const applyCombinedFilters = () => {
      amenityFilterButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          button.dataset.amenityFilter === selectedCategory ? 'true' : 'false'
        );
      });
      propertyFilterButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          button.dataset.propertyFilter === selectedProperty ? 'true' : 'false'
        );
      });

      let visiblePropertyCount = 0;
      propertyCards.forEach((card) => {
        const amenityRows = Array.from(
          card.querySelectorAll<HTMLElement>('[data-amenity-row="true"]')
        );
        const showAll = selectedCategory === 'all';
        const matchesProperty = selectedProperty === 'all'
          || card.dataset.rentalId === selectedProperty;
        const matchesAmenity = showAll || amenityRows.some(
          (row) => row.dataset.amenityCategory === selectedCategory
        );
        const isVisible = matchesProperty && matchesAmenity;

        card.hidden = !isVisible;
        if (isVisible) visiblePropertyCount += 1;
        amenityRows.forEach((row) => {
          row.hidden = !showAll && row.dataset.amenityCategory !== selectedCategory;
        });
      });

      if (emptyMessage) emptyMessage.hidden = visiblePropertyCount > 0;
    };

    amenityFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.amenityFilter;
        if (!category) return;
        selectedCategory = category;
        applyCombinedFilters();
      });
    });

    propertyFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const property = button.dataset.propertyFilter;
        if (!property) return;
        selectedProperty = property;
        applyCombinedFilters();
      });
    });
  }
</script>

<style>
  .filter-chip[aria-pressed='true'] {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .amenity-filter-scroll {
    scrollbar-width: none;
  }

  .amenity-filter-scroll::-webkit-scrollbar {
    display: none;
  }

  :global(#am-page-amenities [data-amenity-row][hidden]),
  :global(#am-page-amenities [data-rental-id][hidden]),
  :global(#am-page-amenities [data-filter-empty][hidden]) {
    display: none !important;
  }
</style>
