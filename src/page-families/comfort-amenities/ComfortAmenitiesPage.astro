---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import AmenitySpecRow, {
  type AmenitySpecIcon
} from '../../components/amenities/AmenitySpecRow.astro';
import {
  comfortAmenityExclusionsByPropertyId,
  comfortAmenityOverridesByPropertyId,
  comfortAmenityCategoryOptions,
  comfortAmenityFilterCopy,
  expandedComfortAmenities,
  expandedComfortAmenityPropertyIds,
  type ComfortAmenityCategory
} from '../../content/comfortAmenityCatalog';
import {
  comfortAmenitiesCopy,
  comfortAmenitiesFooterLabels,
  comfortAmenitiesNav,
  comfortAmenitiesProperties,
  comfortAmenitiesSeo
} from '../../content/comfortAmenitiesContent';
import { trustLabels } from '../../content/trustLabels';
import { vacationRentalEntities } from '../../content/vacationRentalEntities';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const page = comfortAmenitiesCopy[currentLang];
const seo = comfortAmenitiesSeo;
const navBrandLabel = comfortAmenitiesNav.brandLabel[currentLang];
const footerHighlights = [
  { token: 'reviews_hub', label: page.hero.ctaReviews },
  { token: 'faq_general', label: comfortAmenitiesFooterLabels.faq_general[currentLang] },
  { token: 'instagram', label: comfortAmenitiesFooterLabels.instagram[currentLang] }
];
const rentalHrefByPropertyId = Object.fromEntries(
  vacationRentalEntities.map((rental) => [
    rental.propertyId,
    buildOwnedLocalizedPath(rental.slug, currentLang)
  ])
);
const properties = comfortAmenitiesProperties.map((property) => ({
  ...property,
  href: rentalHrefByPropertyId[property.id] ?? property.href
}));
type Property = (typeof properties)[number];
type AmenityRow = {
  icon: AmenitySpecIcon;
  label: string;
  value?: string;
  category?: ComfortAmenityCategory;
};

const buildExistingAmenityRows = (property: Property): AmenityRow[] => [
  {
    icon: 'occupancy',
    label: page.inventory.labels.maxOccupancy,
    value: property.specs.maxOccupancy[currentLang]
  },
  ...(property.specs.bed
    ? [{ icon: 'bed' as const, label: page.inventory.labels.bed, value: property.specs.bed }]
    : []),
  ...(property.specs.beds
    ? [{ icon: 'bed' as const, label: page.inventory.labels.beds, value: property.specs.beds[currentLang] }]
    : []),
  {
    icon: 'price',
    label: page.inventory.labels.price,
    value: property.specs.price[currentLang]
  },
  {
    icon: 'access',
    label: page.inventory.labels.accessNote,
    value: property.specs.accessNote[currentLang]
  },
  ...(property.specs.parking
    ? [{ icon: 'parking' as const, label: page.inventory.labels.parking, value: property.specs.parking[currentLang] }]
    : []),
  {
    icon: 'pets',
    label: page.inventory.labels.pets,
    value: property.specs.pets[currentLang]
  },
  ...(property.specs.pool
    ? [{ icon: 'pool' as const, label: page.inventory.labels.pool, value: property.specs.pool[currentLang] }]
    : []),
  {
    icon: 'view',
    label: page.inventory.labels.view,
    value: property.specs.view[currentLang]
  },
  ...(property.specs.outdoor
    ? [{ icon: 'outdoor' as const, label: page.inventory.labels.outdoor, value: property.specs.outdoor[currentLang] }]
    : []),
  ...(property.specs.sunLoungers
    ? [{ icon: 'sun-loungers' as const, label: page.inventory.labels.sunLoungers, value: property.specs.sunLoungers[currentLang] }]
    : []),
  ...(property.specs.hammock
    ? [{ icon: 'hammock' as const, label: page.inventory.labels.hammock, value: property.specs.hammock[currentLang] }]
    : []),
  ...(property.specs.outdoorShower
    ? [{ icon: 'outdoor-shower' as const, label: page.inventory.labels.outdoorShower, value: property.specs.outdoorShower[currentLang] }]
    : []),
  {
    icon: 'kitchen',
    label: page.inventory.labels.kitchen,
    value: property.specs.kitchen[currentLang]
  },
  ...(property.specs.washingMachine
    ? [{ icon: 'washing-machine' as const, label: page.inventory.labels.washingMachine, value: property.specs.washingMachine[currentLang] }]
    : []),
  ...(property.specs.pelletStove
    ? [{ icon: 'pellet-stove' as const, label: page.inventory.labels.pelletStove, value: property.specs.pelletStove[currentLang] }]
    : []),
  ...(property.specs.fireplace
    ? [{ icon: 'fireplace' as const, label: page.inventory.labels.fireplace, value: property.specs.fireplace[currentLang] }]
    : []),
  ...(property.specs.shower
    ? [{ icon: 'shower' as const, label: page.inventory.labels.shower, value: property.specs.shower[currentLang] }]
    : []),
  {
    icon: 'air-conditioning',
    label: page.inventory.labels.airCon,
    value: property.specs.airCon[currentLang]
  },
  {
    icon: 'license',
    label: page.inventory.labels.license,
    value: property.specs.license
  }
];
const buildKeyFactRows = (property: Property): AmenityRow[] => [
  {
    icon: 'occupancy',
    label: page.inventory.labels.maxOccupancy,
    value: property.specs.maxOccupancy[currentLang]
  },
  ...(property.specs.bed
    ? [{ icon: 'bed' as const, label: page.inventory.labels.bed, value: property.specs.bed }]
    : []),
  ...(property.specs.beds
    ? [{ icon: 'bed' as const, label: page.inventory.labels.beds, value: property.specs.beds[currentLang] }]
    : []),
  {
    icon: 'price',
    label: page.inventory.labels.price,
    value: property.specs.price[currentLang]
  },
  {
    icon: 'access',
    label: page.inventory.labels.accessNote,
    value: property.specs.accessNote[currentLang]
  },
  ...(property.specs.parking
    ? [{ icon: 'parking' as const, label: page.inventory.labels.parking, value: property.specs.parking[currentLang] }]
    : []),
  {
    icon: 'pets',
    label: page.inventory.labels.pets,
    value: property.specs.pets[currentLang]
  },
  ...(property.specs.pool
    ? [{ icon: 'pool' as const, label: page.inventory.labels.pool, value: property.specs.pool[currentLang] }]
    : []),
  {
    icon: 'view',
    label: page.inventory.labels.view,
    value: property.specs.view[currentLang]
  },
  {
    icon: 'license',
    label: page.inventory.labels.license,
    value: property.specs.license
  }
];
const buildFilterableAmenityRows = (property: Property): AmenityRow[] => {
  if (!expandedComfortAmenityPropertyIds.has(property.id)) return [];
  const exclusions = comfortAmenityExclusionsByPropertyId[property.id];
  const overrides = comfortAmenityOverridesByPropertyId[property.id];
  const amenities = expandedComfortAmenities.filter((amenity) => (
    !exclusions?.categories?.includes(amenity.category)
    && !exclusions?.keys?.includes(amenity.key)
  ));

  return [
    ...amenities.map((amenity) => {
      const override = overrides?.[amenity.key];

      return {
        icon: amenity.icon,
        label: override?.title?.[currentLang] ?? amenity.title[currentLang],
        value: override && 'description' in override
          ? override.description?.[currentLang]
          : amenity.description?.[currentLang],
        category: amenity.category
      };
    }),
    ...(property.specs.hammock
      ? [{
          icon: 'hammock' as const,
          label: page.inventory.labels.hammock,
          value: property.specs.hammock[currentLang],
          category: 'outdoor' as const
        }]
      : []),
    ...(property.specs.shower
      ? [{
          icon: 'shower' as const,
          label: page.inventory.labels.shower,
          value: property.specs.shower[currentLang],
          category: 'bathroom' as const
        }]
      : [])
  ];
};
const amenityFilterCopy = comfortAmenityFilterCopy[currentLang];
const amenityFilters = comfortAmenityCategoryOptions.map((category) => ({
  key: category.key,
  label: category.label[currentLang]
}));
const propertyFilters = [
  { key: 'all', label: amenityFilterCopy.allProperties },
  ...properties.map((property) => ({
    key: property.id,
    label: property.name.replace(/^AMARA\s+/, '').replace(/,\s.*$/, '')
  }))
];
const closingCopy: Record<AmaraLanguage, { title: string; lead: string; primary: string; explore: string }> = {
  en: {
    title: 'Find the AMARA stay that suits you.',
    lead: 'Compare the details that matter to you, then check availability or explore all AMARA stays.',
    primary: trustLabels.book.en,
    explore: trustLabels.romantic_hideaways.en
  },
  de: {
    title: 'Findet die AMARA-Unterkunft, die zu euch passt.',
    lead: 'Vergleicht die Details, die euch wichtig sind, und prüft anschließend die Verfügbarkeit oder entdeckt alle AMARA-Unterkünfte.',
    primary: trustLabels.book.de,
    explore: trustLabels.romantic_hideaways.de
  },
  es: {
    title: 'Encontrad el alojamiento AMARA que mejor os encaja.',
    lead: 'Comparad los detalles que más os importan y consultad después la disponibilidad o descubrid todos los alojamientos AMARA.',
    primary: trustLabels.book.es,
    explore: trustLabels.romantic_hideaways.es
  },
  nl: {
    title: 'Vind het AMARA-verblijf dat bij jullie past.',
    lead: 'Vergelijk de details die voor jullie belangrijk zijn en bekijk daarna de beschikbaarheid of ontdek alle AMARA-verblijven.',
    primary: trustLabels.book.nl,
    explore: trustLabels.romantic_hideaways.nl
  },
  sv: {
    title: 'Hitta det AMARA-boende som passar er.',
    lead: 'Jämför detaljerna som är viktiga för er och kontrollera sedan tillgängligheten eller upptäck alla AMARA-boenden.',
    primary: trustLabels.book.sv,
    explore: trustLabels.romantic_hideaways.sv
  }
};
const closing = closingCopy[currentLang];
const heroCtaLinks = [
  { token: 'book', label: page.inventory.directBooking },
  { token: 'reviews_hub', label: page.hero.ctaReviews }
]
  .map((link) => {
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { href, label: link.label } : null;
  })
  .filter((link): link is { href: string; label: string } => Boolean(link));
const closingCtaLinks = [
  { token: 'book', label: closing.primary, style: 'primary' as const },
  { token: 'romantic_hideaways', label: closing.explore, style: 'secondary' as const }
];
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    brandName="AMARA"
    brandLabel={navBrandLabel}
    links={page.trustLinks}
    variant="trust"
    languageToken="amenities"
  />

  <div id="am-page-amenities" class="am-root font-body bg-white text-on-surface" data-am-page="amenities" data-current-lang={currentLang}>
      <div class="am-exp-page bg-white max-w-[1400px] mx-auto px-[5vw]">
        <TrustHero
          subtitle={page.hero.subtitle}
          title={page.hero.title}
          lead={page.hero.lead}
          supportText={page.hero.supportText}
          ctaLinks={heroCtaLinks}
          ctaVariant="conversion"
        />
      </div>

      <main class="am-wrap w-full max-w-[76rem] mx-auto px-6 max-md:px-4">

        <section class="am-section mb-12" aria-label={page.sections.inventoryAria}>
          <h2 class="mb-4 am-text-title text-on-surface">{page.sections.inventoryTitle}</h2>

          <div class="mb-12 border-y border-outline-variant/30 py-6">
            <p id="property-filter-label" class="am-text-caption mb-4 font-semibold text-on-surface">
              {amenityFilterCopy.propertyLabel}
            </p>
            <div
              class="amenity-filter-scroll flex flex-nowrap gap-2.5 overflow-x-auto border-b border-outline-variant/25 pb-6 md:flex-wrap md:overflow-visible"
              role="group"
              aria-labelledby="property-filter-label"
              aria-controls="amenity-inventory"
            >
              {propertyFilters.map((filter) => (
                <button
                  type="button"
                  class="filter-chip inline-flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-full border border-outline-variant/50 bg-white px-4 py-2 am-text-caption font-medium text-on-surface transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25 focus-visible:ring-offset-2"
                  data-property-filter={filter.key}
                  aria-pressed={filter.key === 'all' ? 'true' : 'false'}
                >
                  {filter.label}
                </button>
              ))}
            </div>

            <p id="amenity-filter-label" class="am-text-caption mb-4 mt-6 font-semibold text-on-surface">
              {amenityFilterCopy.amenityLabel}
            </p>
            <div
              class="amenity-filter-scroll flex flex-nowrap gap-2.5 overflow-x-auto pb-2 md:flex-wrap md:overflow-visible md:pb-0"
              role="group"
              aria-labelledby="amenity-filter-label"
              aria-controls="amenity-inventory"
            >
              {amenityFilters.map((filter) => (
                <button
                  type="button"
                  class="filter-chip inline-flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-full border border-outline-variant/50 bg-white px-4 py-2 am-text-caption font-medium text-on-surface transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25 focus-visible:ring-offset-2"
                  data-amenity-filter={filter.key}
                  aria-pressed={filter.key === 'all' ? 'true' : 'false'}
                >
                  {filter.label}
                </button>
              ))}
            </div>
          </div>

          <div id="amenity-inventory" class="am-grid block" aria-live="polite">
            <p
              class="am-text-body mb-12 border-y border-outline-variant/30 py-8 text-on-surface-variant"
              data-filter-empty
              hidden
            >
              {amenityFilterCopy.noResults}
            </p>
            {properties.map((property) => {
              const hasExpandedAmenities = expandedComfortAmenityPropertyIds.has(property.id);
              const factRows = hasExpandedAmenities
                ? buildKeyFactRows(property)
                : buildExistingAmenityRows(property);
              const amenityRows = buildFilterableAmenityRows(property);

              return (
              <article
                class="am-card mb-14 border-0 rounded-none bg-transparent shadow-none"
                data-rental-id={property.id}
                data-expanded-amenities={hasExpandedAmenities ? 'true' : 'false'}
              >
                <div class="am-card-body p-0">
                  <h3 class="mb-4 am-text-subtitle text-on-surface">
                    <a
                      href={property.href}
                      class="inline-flex transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25 focus-visible:ring-offset-4"
                    >
                      {property.name}
                    </a>
                  </h3>
                  <ul class="mt-6 grid list-none gap-x-12 p-0 md:grid-cols-2">
                    {factRows.map((row) => (
                      <AmenitySpecRow icon={row.icon} label={row.label} value={row.value} />
                    ))}
                  </ul>

                  {amenityRows.length > 0 && (
                    <section class="mt-9" data-amenity-section>
                      <h4 class="am-text-subtitle text-on-surface">
                        {amenityFilterCopy.amenityHeading}
                      </h4>
                      <ul class="mt-4 grid list-none gap-x-12 p-0 md:grid-cols-2">
                        {amenityRows.map((row) => (
                          <AmenitySpecRow
                            icon={row.icon}
                            label={row.label}
                            value={row.value}
                            category={row.category}
                            filterable={true}
                          />
                        ))}
                      </ul>
                    </section>
                  )}
                </div>
              </article>
              );
            })}
          </div>

          <div class="am-prose max-w-[46rem]">
            <p class="am-small mt-4 am-text-body leading-relaxed text-on-surface-variant">
              <strong>{page.noteTitle}</strong> {page.noteText}
            </p>

          </div>
        </section>

        <EditorialClosingCta
          title={closing.title}
          lead={closing.lead}
          links={closingCtaLinks}
          lang={currentLang}
        />
      </main>

      <script id="amara-inventory-data" type="application/json">
