---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import BookingDecisionPanel from '../../components/conversion/BookingDecisionPanel.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import RentalPhotoGallery from '../../components/vacation-rental/RentalPhotoGallery.astro';
import StayBookingCalendar from '../../components/vacation-rental/StayBookingCalendar.astro';
import StayStickyBookingBar from '../../components/vacation-rental/StayStickyBookingBar.astro';
import {
  Accessibility,
  BadgeCheck,
  BadgeEuro,
  BedDouble,
  CarFront,
  Check,
  CircleParking,
  Clock3,
  Eye,
  KeyRound,
  Languages,
  PawPrint,
  ShieldCheck
} from '@lucide/astro';
import type { AstroComponent } from '@lucide/astro';
import {
  amenityIcons,
  rentalAmenityIcons
} from '../../components/amenities/amenityIcons';
import {
  buildVacationRentalSeo,
  familySurfConversionContent,
  formatVacationRentalBedDimensions,
  formatVacationRentalFromPrice,
  formatVacationRentalPriceRange,
  vacationRentalEntitiesByKey,
  type VacationRentalAmenityFeature,
  type VacationRentalEntity
} from '../../content/vacationRentalEntities';
import {
  amenityLabels,
  amenityValueLabels,
  bathroomUnderfloorHeating,
  bedTypeLabels,
  bunkBedLabel,
  coolingAndHeating,
  getVacationRentalSunLoungerLabel,
  getVacationRentalTvLabel,
  getVacationRentalVehicleAccessLabel,
  highSpeedFiberInternet,
  outdoorPool,
  privateTerraceAreaLabel,
  terraceAreaLabel,
  ui,
  vacationRentalCountryLabel,
  vacationRentalHostLanguages,
  vacationRentalPriceLocales,
  vacationRentalRegionLabel,
  type LocalizedText
} from '../../content/vacationRentalPageContent';
import { directBookingTrustSignals } from '../../content/directBookingBenefitsContent';
import { airbnbRatingLabel, airbnbReviewEvidence } from '../../content/reviewEvidence';
import { stayCollectionLabels } from '../../content/stayCollectionLabels';
import { trustLabels } from '../../content/trustLabels';
import { getVacationRentalImageAlts } from '../../content/vacationRentalImageAlts';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { buildRentalBookingUrl } from '../../lib/directBooking';
import type { DestinationId } from '../../lib/location/destinationBranchNavigation';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  rental: VacationRentalEntity;
  lang?: string;
}

type ExternalReviewPlatform = 'airbnb' | 'booking';

const { rental: rentalProp, lang = 'es' } = Astro.props;
const rental = vacationRentalEntitiesByKey[rentalProp.key] ?? rentalProp;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const isFamilySurf = rental.key === 'amara-family-surf';
const familySurfContent = isFamilySurf ? familySurfConversionContent[currentLang] : undefined;
const seo = buildVacationRentalSeo(rental);
const bookingHref = buildRentalBookingUrl(rental.slug, currentLang);

const t = (value: LocalizedText) => value[currentLang] ?? value.en;
const highlights = rental.highlights[currentLang] ?? rental.highlights.en ?? [];
const tvSizeInches = rental.tvSizeInches ?? (
  rental.city === 'Nerja' ? 50 : rental.city === 'Tarifa' ? 60 : 40
);
const formatAmenity = (feature: VacationRentalAmenityFeature) => {
  const featuresShownElsewhere = new Set([
    'balcony',
    'internetType',
    'licenseNum',
    'parkingType',
    'patio',
    'privateTerrace',
    'selfCheckinCheckout'
  ]);
  const hasAirConditioning = rental.amenityFeatures.some(
    (item) => item.name === 'ac' && item.value !== false
  );

  if (feature.name === 'kitchen') {
    return t(rental.kitchenNote);
  }

  if (
    feature.value === false ||
    featuresShownElsewhere.has(feature.name) ||
    (feature.name === 'heating' && hasAirConditioning)
  ) {
    return null;
  }

  if (feature.name === 'wifi') {
    return t(highSpeedFiberInternet);
  }

  if (feature.name === 'ac') {
    return t(coolingAndHeating);
  }

  if (feature.name === 'tv') {
    return t(getVacationRentalTvLabel(tvSizeInches));
  }

  if (feature.name === 'pool' && rental.amenityFeatures.some((item) => item.name === 'poolType')) {
    return null;
  }

  if (feature.name === 'poolType' && feature.value === 'Outdoor') {
    return t(outdoorPool);
  }

  if (feature.name === 'sunLoungers' && typeof feature.value === 'string') {
    return t(getVacationRentalSunLoungerLabel(feature.value));
  }

  const label = t(amenityLabels[feature.name] ?? {
    en: feature.name,
    de: feature.name,
    es: feature.name,
    nl: feature.name,
    sv: feature.name
  });

  if (feature.value === true) {
    return label;
  }

  const localizedValue = amenityValueLabels[feature.value]?.[currentLang] ?? feature.value;
  return `${label}: ${localizedValue}`;
};

const formatBed = (bed: VacationRentalEntity['bed'][number]) => {
  if (bed.label === 'Bunk bed') {
    return t(bunkBedLabel);
  }

  const count = bed.numberOfBeds > 1 ? `${bed.numberOfBeds} × ` : '';
  const dimensions = formatVacationRentalBedDimensions(bed.label);
  return dimensions
    ? `${count}${t(bedTypeLabels[bed.typeOfBed])} · ${dimensions}`
    : `${count}${t(bedTypeLabels[bed.typeOfBed])}`;
};

const indicativePriceRange = formatVacationRentalPriceRange(rental.pricing, currentLang, 'symbol');
const priceCheckedDate = new Intl.DateTimeFormat(vacationRentalPriceLocales[currentLang], {
  dateStyle: 'medium',
  timeZone: 'UTC'
}).format(new Date(`${rental.pricing.lastVerified}T00:00:00Z`));

const amenityValue = (name: string) =>
  rental.amenityFeatures.find((feature) => feature.name === name)?.value;
const hasAmenity = (name: string) => Boolean(amenityValue(name));
const parkingValue = amenityValue('parkingType');
const localizedParking = parkingValue === 'ReservedUndergroundIncluded'
  ? t(amenityValueLabels.ReservedUndergroundIncluded)
  : t(ui.labels.freeParking as LocalizedText);
const localizedAreaLabel = rental.exteriorAreaSqm && hasAmenity('privateTerrace')
  ? t(privateTerraceAreaLabel)
  : rental.exteriorAreaSqm && hasAmenity('patio')
    ? t(terraceAreaLabel)
    : t((rental.exteriorAreaSqm
        ? ui.labels.interiorExteriorArea
        : ui.labels.interiorArea) as LocalizedText);

type FactRow = {
  label: string;
  value: string;
  Icon: AstroComponent;
  wide?: boolean;
};

const factRows: FactRow[] = [
  { label: t(ui.labels.guests as LocalizedText), value: String(rental.occupancy), Icon: amenityIcons.occupancy },
  { label: t(ui.labels.bedrooms as LocalizedText), value: String(rental.bedrooms), Icon: amenityIcons.bed },
  { label: t(ui.labels.bathrooms as LocalizedText), value: String(rental.bathrooms), Icon: amenityIcons.bathroom },
  ...(rental.interiorAreaSqm
    ? [{
        label: localizedAreaLabel,
        value: rental.exteriorAreaSqm
          ? `${rental.interiorAreaSqm} m² / ${rental.exteriorAreaSqm} m²`
          : `${rental.interiorAreaSqm} m²`,
        Icon: amenityIcons.area
      }]
    : []),
  ...(rental.exteriorAreaSqm
    ? []
    : [{
        label: t(ui.labels.outdoor as LocalizedText),
        value: t(rental.outdoorNote),
        Icon: amenityIcons.terrace,
        wide: true
      }]),
  {
    label: t(ui.labels.pricePerNight as LocalizedText),
    value: indicativePriceRange,
    Icon: BadgeEuro
  },
  {
    label: t(ui.labels.license as LocalizedText),
    value: rental.license,
    Icon: BadgeCheck
  }
];

const vehicleAccessHours = rental.accessFacts.vehicleAccessHours;
const localizedVehicleAccess: LocalizedText | undefined = vehicleAccessHours
  ? getVacationRentalVehicleAccessLabel(vehicleAccessHours)
  : undefined;

const detailRows = [
  { label: t(ui.labels.bedSize as LocalizedText), value: rental.bed.map(formatBed).join(', '), Icon: BedDouble },
  { label: t(ui.labels.view as LocalizedText), value: t(rental.viewNote), Icon: Eye },
  { label: t(ui.labels.access as LocalizedText), value: t(rental.accessNote), Icon: Accessibility },
  ...(localizedVehicleAccess
    ? [{ label: t(ui.labels.vehicleAccess as LocalizedText), value: t(localizedVehicleAccess), Icon: CarFront }]
    : []),
  { label: t(ui.labels.pets as LocalizedText), value: t(rental.petsNote), Icon: PawPrint },
  { label: t(ui.labels.hostLanguages as LocalizedText), value: t(vacationRentalHostLanguages), Icon: Languages },
  ...(parkingValue
    ? [{ label: t(ui.labels.parking as LocalizedText), value: localizedParking, Icon: CircleParking }]
    : [])
];

const scheduleRows = [
  { label: t(ui.labels.checkin as LocalizedText), value: rental.checkinTime.slice(0, 5), Icon: Clock3 },
  { label: t(ui.labels.checkout as LocalizedText), value: rental.checkoutTime.slice(0, 5), Icon: Clock3 },
  ...(hasAmenity('selfCheckinCheckout')
    ? [{ label: t(ui.labels.selfCheckin as LocalizedText), value: t(ui.labels.available as LocalizedText), Icon: KeyRound }]
    : [])
];
const descriptionParagraphs = t(rental.description)
  .split(/\n{2,}/u)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const visibleAddress = `${rental.street}, ${rental.zip} ${rental.city}, ${t(vacationRentalRegionLabel)}, ${t(vacationRentalCountryLabel)}`;
const mapsQuery = `${rental.street}, ${rental.zip} ${rental.city}, ${rental.region}, Spain`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`;
const addressNoteSegments = rental.addressNote
  ? t(rental.addressNote).split(/(Calle Chorruelo|Calle Real)/g)
  : [];


type AmenityDisplayItem = {
  key: string;
  label: string;
  Icon: AstroComponent;
};

const visibleAmenities: AmenityDisplayItem[] = rental.amenityFeatures
  .map((feature) => {
    const label = formatAmenity(feature);
    const icon = rentalAmenityIcons[feature.name];
    return label
      ? { key: feature.name, label, Icon: icon ? amenityIcons[icon] : BadgeCheck }
      : null;
  })
  .filter((item): item is AmenityDisplayItem => Boolean(item));

if (rental.bathroomUnderfloorHeating) {
  visibleAmenities.push({
    key: 'bathroomUnderfloorHeating',
    label: t(bathroomUnderfloorHeating),
    Icon: amenityIcons.heating
  });
}

const featuredAmenityKeys = {
  'amara-farah': ['rainShower', 'bathroomUnderfloorHeating', 'ac', 'wifi'],
  'amara-lounis': ['washingMachine', 'doubleRainShower', 'outdoorShower', 'hammock'],
  'amara-zaid': ['washingMachine', 'doubleRainShower', 'outdoorShower', 'hammock'],
  'amara-maha': ['outdoorGrill', 'outdoorShower', 'hammock', 'privateTerrace'],
  'amara-playa': ['beachAccess', 'balcony', 'elevator', 'washingMachine'],
  'amara-family-surf': ['poolType', 'elevator', 'washingMachine', 'fireplace']
} satisfies Record<VacationRentalEntity['key'], string[]>;
const highlightedAmenities = featuredAmenityKeys[rental.key]
  .map((key) => visibleAmenities.find((amenity) => amenity.key === key))
  .filter((amenity): amenity is AmenityDisplayItem => Boolean(amenity));
const highlightedAmenityKeys = new Set(highlightedAmenities.map((amenity) => amenity.key));
const additionalAmenities = visibleAmenities.filter((amenity) => !highlightedAmenityKeys.has(amenity.key));

const footerHighlights: LabeledLink[] = [
  { token: 'romantic_hideaways', label: t(stayCollectionLabels.shortLabel) },
  { token: 'amenities', label: t(ui.amenitiesTitle as LocalizedText) },
  {
    token: 'direct_booking_benefits',
    label: trustLabels.direct_booking_benefits[currentLang]
  }
];
const collectionHref = resolveOptionalLink('romantic_hideaways', currentLang, { suppressMissing: true });
const amenitiesHref = resolveOptionalLink('amenities', currentLang, { suppressMissing: true });
const reviewsHref = resolveOptionalLink('reviews_hub', currentLang, { suppressMissing: true });
const directBookingBenefitsHref = resolveOptionalLink('direct_booking_benefits', currentLang, { suppressMissing: true });
const bookingTermsHref = resolveOptionalLink('booking_stay_terms', currentLang, { suppressMissing: true });
const stayFaqHref = resolveOptionalLink('faq_general', currentLang, { suppressMissing: true });
const bookingSupportLinks = [
  { href: bookingTermsHref, label: trustLabels.booking_stay_terms[currentLang] },
  { href: stayFaqHref, label: trustLabels.faq_general[currentLang] }
].filter((item): item is { href: string; label: string } => Boolean(item.href));
const sameHouseLinks = Object.values(vacationRentalEntitiesByKey)
  .filter((otherRental) =>
    otherRental.key !== rental.key &&
    otherRental.street === rental.street &&
    otherRental.city === rental.city
  )
  .map((otherRental) => ({
    href: resolveOptionalLink(otherRental.token, currentLang, { suppressMissing: true }),
    label: otherRental.shortName
  }))
  .filter((item): item is { href: string; label: string } => Boolean(item.href));
const casaAmaraGroupsHref = sameHouseLinks.length > 0
  ? resolveOptionalLink('casa_amara_groups', currentLang, { suppressMissing: true })
  : undefined;
const familySurfWindHref = familySurfContent
  ? resolveOptionalLink(familySurfContent.surf.ctaToken, currentLang, { suppressMissing: true })
  : undefined;
const localizedHostRating: LocalizedText = {
  en: `Host rating: ${airbnbRatingLabel.en}/5 · ${airbnbReviewEvidence.reviewCountLabel} Airbnb reviews`,
  de: `Gastgeberbewertung: ${airbnbRatingLabel.de}/5 · ${airbnbReviewEvidence.reviewCountLabel} Airbnb-Bewertungen`,
  es: `Valoración del anfitrión: ${airbnbRatingLabel.es}/5 · ${airbnbReviewEvidence.reviewCountLabel} reseñas en Airbnb`,
  nl: `Hostbeoordeling: ${airbnbRatingLabel.nl}/5 · ${airbnbReviewEvidence.reviewCountLabel} Airbnb-beoordelingen`,
  sv: `Värdomdöme: ${airbnbRatingLabel.sv}/5 · ${airbnbReviewEvidence.reviewCountLabel} Airbnb-omdömen`
};
const bookingTrustSignals = [
  directBookingTrustSignals.lowestAvailablePrice[currentLang],
  directBookingTrustSignals.directHostContact[currentLang],
  localizedHostRating[currentLang]
];
const aboutHref = resolveOptionalLink('about', currentLang, { suppressMissing: true });
// Deep link to the host profile itself, not the top of the About page: the
// claim "direct contact with the host" is only worth as much as its evidence.
const hostProfileHref = aboutHref ? `${aboutHref}#host` : undefined;
const bookingTrustLinks = [
  {
    href: directBookingBenefitsHref,
    label: trustLabels.direct_booking_benefits[currentLang]
  },
  {
    href: reviewsHref,
    label: trustLabels.reviews_hub[currentLang]
  }
].filter((item): item is { href: string; label: string } => Boolean(item.href));
const externalReviewProfiles = rental.sameAs.flatMap((href) => {
  const platform: ExternalReviewPlatform | undefined = href.includes('airbnb.')
    ? 'airbnb'
    : href.includes('booking.com')
      ? 'booking'
      : undefined;

  return platform
    ? [{
        href,
        platform,
        label: t(ui.externalReviewLinkLabels[platform] as LocalizedText)
      }]
    : [];
});
const locationLinkSpecs: LabeledLink[] = [
  ...((rental.city === 'Frigiliana'
    ? [
        { token: 'location_frigiliana', label: t(ui.frigilianaLocationGuide as LocalizedText) },
        { token: 'frigiliana_experience_hub', label: t(ui.experiencesGuide as LocalizedText) }
      ]
    : isFamilySurf
      ? [
          { token: 'location_tarifa', label: t(ui.tarifaLocationGuide as LocalizedText) },
          { token: 'tarifa_experience_hub', label: t(ui.experiencesGuide as LocalizedText) },
          { token: 'tarifa_beaches_authority', label: t(ui.tarifaBeachesGuide as LocalizedText) },
          { token: 'tarifa_wind_kitesurfing_authority', label: t(ui.tarifaWindGuide as LocalizedText) }
        ]
    : rental.city === 'Nerja'
      ? [
          { token: 'location_nerja', label: 'Nerja' },
          { token: 'nerja_experience_hub', label: t(ui.experiencesGuide as LocalizedText) }
        ]
      : []) satisfies LabeledLink[]),
  // Moved here from the context navigation: arrival belongs with planning, not with site-wide links.
  { token: 'arrival_guide', label: t(ui.arrivalGuide as LocalizedText) }
];
const locationLinks = locationLinkSpecs.flatMap(({ token, label }) => {
  const href = resolveOptionalLink(token, currentLang, { suppressMissing: true });
  return href ? [{ href, label }] : [];
});
const locationBody = locationLinks.length > 0
  ? t(ui.locationBodyWithGuides as LocalizedText)
  : t(ui.locationBodyWithoutGuides as LocalizedText);
// The eight initially visible images mirror the complete image set emitted in JSON-LD.
// Additional lightbox images remain unloaded until a guest opens the gallery.
const visibleImages = rental.images.slice(0, 8);
const heroImage = visibleImages[0];
const imageAlts = getVacationRentalImageAlts(rental, currentLang);
// The live booking module owns the conversion path. Page-level calls to action
// hand over to it in place; the external booking site stays available as the
// resilience fallback when the gateway cannot answer.
const bookingSectionId = `${rental.bookingKey}-booking`;
const bookingSectionHref = `#${bookingSectionId}`;
const fromPrice = formatVacationRentalFromPrice(rental.pricing, currentLang, false);
// The compact key facts answer the suitability question before the price does:
// a guest who needs more beds should be able to leave on the first screen.
const keyFacts: { label: string; Icon: AstroComponent }[] = [
  {
    label: t(
      (rental.occupancy === 1 ? ui.labels.guestInline : ui.labels.guestsInline) as LocalizedText
    ).replace('{count}', String(rental.occupancy)),
    Icon: amenityIcons.occupancy
  },
  {
    label: t(
      (rental.bedrooms === 1 ? ui.labels.bedroomInline : ui.labels.bedroomsInline) as LocalizedText
    ).replace('{count}', String(rental.bedrooms)),
    Icon: amenityIcons.bed
  },
  {
    label: t(bedTypeLabels[rental.bed[0].typeOfBed]),
    Icon: BedDouble
  },
  ...(hasAmenity('privateTerrace')
    ? [{ label: t(amenityLabels.privateTerrace), Icon: amenityIcons.terrace }]
    : hasAmenity('patio')
      ? [{ label: t(amenityLabels.patio), Icon: amenityIcons.terrace }]
      : hasAmenity('balcony')
        ? [{ label: t(amenityLabels.balcony), Icon: amenityIcons.terrace }]
        : [])
];
const breadcrumbRentalName = rental.name.replace(/^AMARA\s+/u, '');
const contextDestination: DestinationId | undefined =
  rental.city === 'Frigiliana'
    ? 'frigiliana'
    : rental.city === 'Nerja'
      ? 'nerja'
      : rental.city === 'Tarifa'
        ? 'tarifa'
        : undefined;
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  contextBreadcrumbTitle={`${breadcrumbRentalName}, ${rental.city}`}
  contextDestination={contextDestination}
>
  <Navigation
    currentLang={currentLang}
    languageToken={rental.token}
  />

  <AmaraPageShell family="vacation-rental">
      <AmaraSection variant="hero" class="am-stay-hero">
        <figure class="am-stay-hero__photo relative aspect-[5/4] max-h-[min(720px,62vh)] overflow-hidden bg-surface-container-low md:aspect-[3/2] xl:aspect-[16/9]">
          <button
            type="button"
            class="group block h-full w-full cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary"
            data-am-rental-photo-open
            data-am-photo-index="0"
            aria-haspopup="dialog"
            aria-label={`${t(ui.galleryTitle as LocalizedText)}: ${rental.name}`}
          >
            <AmaraImage
              src={heroImage}
              alt={imageAlts[0] ?? t(rental.imageAlt)}
              profile="hero"
              sizes="(max-width: 639px) 100vw, (max-width: 767px) calc(100vw - 3rem), (max-width: 1535px) calc(100vw - 6rem), 1440px"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.01] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <span class="am-hero-photo-count am-text-label" aria-hidden="true">
              1 / {rental.images.length}
            </span>
          </button>
        </figure>

        <div class="mt-6 max-w-4xl md:mt-10">
          <p class="am-text-eyebrow text-primary">
            {t(rental.eyebrow)}
          </p>
          <h1 class="am-text-display text-on-surface mt-3 max-w-4xl text-balance">
            {rental.name}
          </h1>
          <p class="am-text-title text-on-surface mt-4 max-w-4xl text-balance">
            {t(rental.headline)}
          </p>

          <ul
            class="am-text-body mt-6 flex flex-wrap gap-x-5 gap-y-2 text-on-surface"
            aria-label={t(ui.keyFactsLabel as LocalizedText)}
            data-am-component="stay-key-facts"
          >
            {keyFacts.map(({ label, Icon }) => (
              <li class="inline-flex items-center gap-2">
                <Icon class="h-4 w-4 shrink-0 text-primary" stroke-width={1.5} aria-hidden="true" />
                <span>{label}</span>
              </li>
            ))}
          </ul>

          {collectionHref && (
            <p class="am-text-caption mt-3 font-normal">
              <a class="am-inline-link" href={collectionHref}>
                {t(stayCollectionLabels.backToCollectionLabel)}
              </a>
            </p>
          )}

          <BookingDecisionPanel
            priceLabel={t(ui.labels.pricePerNight as LocalizedText)}
            price={fromPrice}
            primary={{
              href: bookingSectionHref,
              label: t(ui.chooseDates as LocalizedText)
            }}
            primaryInPage
            priceNote={t(ui.indicativePriceNote as LocalizedText)}
            supportLinks={bookingSupportLinks}
          />

          <p
            class:list={[
              'am-text-body text-on-surface-variant mt-8 max-w-2xl leading-relaxed',
              { 'whitespace-pre-line': isFamilySurf }
            ]}
          >
            {t(rental.lead)}
          </p>
        </div>

        <div class="mt-7 max-w-4xl md:mt-9">
          {highlights.length > 0 && (
            <ul class="grid max-w-2xl gap-2">
              {highlights.map((highlight) => (
                <li class="am-text-body text-on-surface flex gap-3 leading-relaxed">
                  <Check class="mt-[0.35em] h-4 w-4 shrink-0 text-primary" stroke-width={1.75} aria-hidden="true" />
                  <span class:list={[{ 'whitespace-pre-line': isFamilySurf }]}>{highlight}</span>
                </li>
              ))}
            </ul>
          )}

          <div
            data-am-component="property-booking-trust"
            class="mt-7 border-t border-border-subtle pt-5"
          >
            <div class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
              <ShieldCheck class="mt-0.5 h-5 w-5 text-primary" stroke-width={1.5} aria-hidden="true" />
              <div>
                <p class="am-text-body font-bold text-on-surface">
                  {directBookingTrustSignals.directWithAmara[currentLang]}
                </p>
                <ul class="am-text-body mt-3 grid gap-x-6 gap-y-2 text-on-surface-variant sm:grid-cols-2">
                  {bookingTrustSignals.map((signal) => (
                    <li class="grid grid-cols-[1rem_minmax(0,1fr)] items-start gap-2">
                      <Check class="mt-1 h-3.5 w-3.5 text-primary" stroke-width={1.75} aria-hidden="true" />
                      <span>{signal}</span>
                    </li>
                  ))}
                </ul>
                {bookingTrustLinks.length > 0 && (
                  <div class="am-text-body mt-4 flex flex-wrap gap-x-5 gap-y-2">
                    {bookingTrustLinks.map((link) => (
                      <a class="am-inline-link" href={link.href}>{link.label}</a>
                    ))}
                  </div>
                )}
