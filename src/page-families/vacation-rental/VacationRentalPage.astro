          <div class="max-w-3xl">
            <h2 id="rental-location-title" class="am-text-subtitle text-on-surface">
              {t(ui.locationTitle as LocalizedText)}
            </h2>
            {
              rental.addressNote && (
                <p class="am-text-body text-on-surface-variant mt-5 leading-relaxed">
                  {addressNoteSegments.map((segment) =>
                    segment === 'Calle Chorruelo' || segment === 'Calle Real'
                      ? <strong class="font-bold text-on-surface">{segment}</strong>
                      : segment
                  )}
                </p>
              )
