                  href={link.href}
                  class="group min-w-0"
                  data-am-stay-planning-link={link.icon}
                >
                  <span class="am-text-body flex items-center gap-2">
                    {link.icon === 'reviews' ? (
                      <MessageCircle
                        class="size-4 shrink-0 text-primary"
                        stroke-width={1.5}
                        aria-hidden="true"
                        data-am-stay-planning-icon="reviews"
                      />
                    ) : (
                      <LocationGuideIcon name={link.icon} class="size-4" />
                    )}
                    <span class="min-w-0">
                      {link.label}
                    </span>
                  </span>
                </AmaraActionLink>
              ))}
            </nav>
            {externalReviewProfiles.length > 0 && (
              <aside
                class="am-text-annotation flex flex-wrap items-baseline gap-x-3 gap-y-1 leading-relaxed text-on-surface-variant lg:justify-end"
                aria-label={t(ui.externalProfilesLabel as LocalizedText)}
                data-am-component="external-review-profiles"
              >
                <span>{t(ui.externalProfilesLabel as LocalizedText)}:</span>
                {externalReviewProfiles.map((profile) => (
                  <a
                    class="am-inline-link"
                    href={profile.href}
                    target="_blank"
                    rel="noopener noreferrer external"
                    data-am-external-review-profile={profile.platform}
                    aria-label={`${profile.label}. ${t(ui.opensInNewTab as LocalizedText)}`}
                  >
                    {profile.label}
                  </a>
                ))}
              </aside>
            )}
          </div>
        </div>

      </AmaraSection>
  </AmaraPageShell>

  <StayStickyBookingBar
    price={fromPrice}
    href={bookingSectionHref}
    label={t(ui.chooseDates as LocalizedText)}
    bookingLabel={t(ui.bookNow as LocalizedText)}
  />
</BaseLayout>

