                    widths={[96, 112, 128]}
                    sizes="(min-width: 640px) 7rem, 6rem"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </div>
              <h2 id="family-surf-proof-title" class="am-text-title text-on-surface mt-4 text-balance">
