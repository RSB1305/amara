                <a class="am-inline-link" href={casaAmaraGroupsHref}>
                  {t(ui.groupStay as LocalizedText)}
                </a>
              )}
            </div>
          </div>
        )}
      </AmaraSection>

      <AmaraSection labelledby="rental-location-title" variant="closing" pageEndRole="editorial-close" pageEndFamily="stay">
