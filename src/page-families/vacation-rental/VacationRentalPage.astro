                </dd>
              </div>
            </dl>
          </div>
          <div class="grid gap-4 lg:justify-items-end">
            <nav
              aria-label={t(ui.locationTitle as LocalizedText)}
              class="grid w-full gap-x-4 gap-y-1 sm:grid-cols-2 2xl:grid-cols-4"
              data-am-component="stay-planning-links"
