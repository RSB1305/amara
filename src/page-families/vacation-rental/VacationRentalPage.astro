                    <li>
                      <a
                        class="am-inline-link am-text-body"
                        href={offer.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {t(offer.label)}
                        <span aria-hidden="true"> &nearr;</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 bg-surface-container-low p-5 sm:p-6">
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {t(familySurfContent.surf.fallback.text)}
                </p>
                <p class="am-text-body mt-4">
                  <a
                    class="am-inline-link"
                    href={familySurfContent.surf.fallback.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t(familySurfContent.surf.fallback.ctaLabel)}
                    <span aria-hidden="true"> &nearr;</span>
                  </a>
                </p>
              </div>
            </div>

            <aside class="border-t border-border-subtle pt-7 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
              <h3 class="am-text-subtitle text-on-surface text-balance">
                {t(familySurfContent.family.title)}
