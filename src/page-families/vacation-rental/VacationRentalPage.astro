                <dl class="bg-surface-container-low px-5 sm:px-6">
                  {detailRows.map(({ label, value, Icon }) => (
                    <div class="grid min-h-[4.5rem] grid-cols-[2.25rem_minmax(0,1fr)] content-center gap-x-4 border-b border-border-subtle py-4 last:border-b-0 md:min-h-[5.75rem] md:py-5">
                      <dt class="col-span-2 grid grid-cols-[2.25rem_minmax(0,1fr)] items-center gap-x-4">
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-surface text-primary" aria-hidden="true">
                          <Icon class="h-[1.125rem] w-[1.125rem]" stroke-width={1.5} />
                        </span>
                        <span class="min-w-0 am-text-annotation text-on-surface-variant">
                          {label}
                        </span>
                      </dt>
                      <dd class="am-text-body col-start-2 mt-1 text-on-surface">
                        {value}
                      </dd>
                    </div>
                  ))}
