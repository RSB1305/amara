                <ul class="grid gap-x-10 gap-y-3 pb-4 sm:grid-cols-2 sm:gap-y-4">
                  {additionalAmenities.map(({ label, Icon }) => (
                    <li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-3 py-2">
                      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container-low text-primary">
                        <Icon class="h-5 w-5" stroke-width={1.5} aria-hidden="true" />
                      </span>
                      <span class="am-text-body pt-1 text-on-surface">
                        {label}
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            {amenitiesHref && (
              <p class="am-text-body mt-7">
                <a class="am-inline-link" href={amenitiesHref}>
                  {t(ui.moreAmenities as LocalizedText)}
                  <span aria-hidden="true"> &rarr;</span>
                </a>
              </p>
            )}
          </div>
        </div>
        {sameHouseLinks.length > 0 && (
          <div class="mt-10 border-t border-border-subtle pt-8">
            <h3 class="am-text-annotation am-text-annotation--wide text-on-surface">
              {t(ui.sameHouseTitle as LocalizedText)}
            </h3>
            <div class="am-text-body mt-4 flex flex-wrap gap-x-5 gap-y-2">
              {sameHouseLinks.map((link) => (
                <a class="am-inline-link" href={link.href}>{link.label}</a>
              ))}
