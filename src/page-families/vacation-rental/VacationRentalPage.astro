<style is:global>
  /**
   * The opening photo is the page's first argument, so it meets every viewport
   * edge and forms the transition from the page ground into the white stay
   * canvas. `.am-page-shell` already clips horizontally, so escaping the shell
   * inset and the frame gutter cannot introduce a sideways scroll.
   */
  .am-stay-hero {
    padding-top: 0;
  }

  .am-stay-hero__photo {
    /* Reaching the viewport edge means clearing the frame gutter the hero
       section re-applies inside its own negative margin, plus the shell inset
       around the frame. Deriving both from the values that create them keeps
       the photo exactly viewport-wide without counting in the scrollbar, which
       a viewport unit would. */
    --am-stay-hero-inset: calc(var(--spacing-page-gutter) + clamp(0.5rem, 1vw, 0.875rem));
    width: calc(100% + var(--am-stay-hero-inset) * 2);
    max-width: none;
    margin-inline: calc(var(--am-stay-hero-inset) * -1);
  }

  /**
   * The hero photo carries the entry into the full gallery. The counter names
   * how much more there is to see without covering the image itself.
   */
  .am-hero-photo-count {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: var(--radius-control);
    background: rgb(0 0 0 / 0.55);
    padding: 0.3rem 0.65rem;
    color: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(2px);
  }

  @media (min-width: 48rem) {
    .am-hero-photo-count {
      right: 1.25rem;
      bottom: 1.25rem;
    }
  }

  @media (max-width: 47.999rem) {
    [data-am-page='vacation-rental'] ~ .footer .footer-minimal {
      padding-block: 1.5rem;
    }

    [data-am-page='vacation-rental'] ~ .footer .footer-minimal__list {
      row-gap: 0.75rem;
    }
  }
</style>
