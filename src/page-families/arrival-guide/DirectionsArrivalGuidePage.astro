---
import {
  BusFront,
  CarFront,
  CircleParking,
  Footprints,
  Luggage,
  MapPin,
  Phone,
  ShieldAlert,
  X
} from '@lucide/astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import {
  arrivalGuideBusRoutes,
  arrivalGuideCopy,
  arrivalGuideSeo,
  arrivalGuideSteps,
  arrivalGuideUi
} from '../../content/arrivalGuideContent';
import {
  nerjaArrivalGuideBusRoutes,
  nerjaArrivalGuideCopy,
  nerjaArrivalGuideSeo,
  nerjaArrivalGuideSteps
} from '../../content/nerjaArrivalGuideContent';
import {
  tarifaArrivalGuideBusRoutes,
  tarifaArrivalGuideCopy,
  tarifaArrivalGuideSeo,
  tarifaArrivalGuideSteps
} from '../../content/tarifaArrivalGuideContent';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import Navigation from '../../components/Navigation.astro';
import ContextNavigation from '../../components/navigation/ContextNavigation.astro';
import { getDestinationContextNavigation } from '../../lib/location/destinationBranchNavigation';
import { createRequiredLinkResolver } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
  destination?: 'frigiliana' | 'nerja' | 'tarifa';
}

const { lang = 'es', destination = 'frigiliana' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const ui = arrivalGuideUi;
const requiredLink = createRequiredLinkResolver(currentLang, 'arrival guide context navigation');

const variants = {
  frigiliana: {
    seo: arrivalGuideSeo,
    copy: arrivalGuideCopy,
    steps: arrivalGuideSteps,
    busRoutes: arrivalGuideBusRoutes,
    languageToken: 'arrival_guide',
    locationToken: 'location_frigiliana',
    journeyToken: 'getting_to_frigiliana',
    parkingToken: 'frigiliana_parking',
    label: 'Frigiliana',
    family: 'frigiliana-arrival-guide',
    heroImage: '/images/amara-entrada/casa-amara-frigiliana-fuerra-ii.jpg',
    routeImage: '/images/arrival-map.jpg',
    mapHref: 'https://maps.app.goo.gl/S7AzRNc2QMCRyBBN6',
    addressLines: ['Calle Chorruelo 5', '29788 Frigiliana'],
    dropOffValue: 'Avenida Carlos Cano 42',
    fourthFactValue: { en: 'Parada de Autobús · C. Real', de: 'Parada de Autobús · C. Real', es: 'Parada de Autobús · C. Real', nl: 'Parada de Autobús · C. Real', sv: 'Parada de Autobús · C. Real' },
    contactHref: 'tel:+34952533131',
    contactValue: '+34 952 533 131'
  },
  nerja: {
    seo: nerjaArrivalGuideSeo,
    copy: nerjaArrivalGuideCopy,
    steps: nerjaArrivalGuideSteps,
    busRoutes: nerjaArrivalGuideBusRoutes,
    languageToken: 'nerja_arrival_guide',
    locationToken: 'location_nerja',
    journeyToken: 'getting_to_nerja',
    parkingToken: 'nerja_parking',
    label: 'Nerja',
    family: 'nerja-arrival-guide',
    heroImage: '/images/amara-playa/apartment/chaparril-13.webp',
    routeImage: '/images/amara-playa/apartment/chaparril-24.webp',
    mapHref: 'https://maps.app.goo.gl/E886L2Huw3fXBQTt9',
    addressLines: ['Calle Castilla Pérez 60', '29780 Nerja'],
    dropOffValue: 'Calle Castilla Pérez 60',
    fourthFactValue: { en: 'Public · not guaranteed', de: 'Öffentlich · nicht garantiert', es: 'Público · no garantizado', nl: 'Openbaar · niet gegarandeerd', sv: 'Allmän · inte garanterad' },
    contactHref: 'https://maps.app.goo.gl/E886L2Huw3fXBQTt9',
    contactValue: 'Google Maps'
  },
  tarifa: {
    seo: tarifaArrivalGuideSeo,
    copy: tarifaArrivalGuideCopy,
    steps: tarifaArrivalGuideSteps,
    busRoutes: tarifaArrivalGuideBusRoutes,
    languageToken: 'tarifa_arrival_guide',
    locationToken: 'location_tarifa',
    journeyToken: 'getting_to_tarifa',
    parkingToken: 'tarifa_parking',
    label: 'Tarifa',
    family: 'tarifa-arrival-guide',
    heroImage: '/images/amara-tarifa/amara-tarifa-apartment23.webp',
    routeImage: '/images/amara-tarifa/amara-tarifa-apartment23.webp',
    mapHref: 'https://www.google.com/maps/search/?api=1&query=Mar+Adriatico+29+11380+Tarifa',
    addressLines: ['Mar Adriático 29', '11380 Tarifa'],
    dropOffValue: 'Las Terrazas de la Marina',
    fourthFactValue: { en: 'Calle Batalla del Salado', de: 'Calle Batalla del Salado', es: 'Calle Batalla del Salado', nl: 'Calle Batalla del Salado', sv: 'Calle Batalla del Salado' },
    contactHref: 'https://www.google.com/maps/search/?api=1&query=Mar+Adriatico+29+11380+Tarifa',
    contactValue: 'Google Maps'
  }
} as const;

const variant = variants[destination];
const seo = variant.seo;
const copy = variant.copy;
const arrivalSteps = variant.steps[currentLang];
const busRoutes = variant.busRoutes[currentLang];
const destinationContextNavigation = getDestinationContextNavigation(destination, currentLang);
const mapHref = variant.mapHref;
const journeyHref = requiredLink(variant.journeyToken);
const parkingHref = requiredLink(variant.parkingToken);
const c = {
  header: {
    eyebrow: copy.header.eyebrow[currentLang],
    title: copy.header.title[currentLang],
    subtitle: copy.header.subtitle[currentLang]
  },
  journeyIntro: {
    title: copy.content.journeyIntro.title[currentLang],
    text: copy.content.journeyIntro.text[currentLang],
    cta: copy.content.journeyIntro.cta[currentLang],
    parkingCta: copy.content.journeyIntro.parkingCta[currentLang]
  },
  parking: { title: copy.content.parking.title[currentLang], text: copy.content.parking.text[currentLang] },
  walkingAccess: { title: copy.content.walkingAccess.title[currentLang], text: copy.content.walkingAccess.text[currentLang] },
  arrivalTip: {
    title: copy.content.arrivalTip.title[currentLang],
    text: copy.content.arrivalTip.text[currentLang],
    taxiNote: copy.content.arrivalTip.taxiNote[currentLang]
  },
  arrivalByBus: {
    title: copy.content.arrivalByBus.title[currentLang],
    text: copy.content.arrivalByBus.text[currentLang]
  },
  luggageAdvice: { title: copy.content.luggageAdvice.title[currentLang], text: copy.content.luggageAdvice.text[currentLang] },
  faq: { title: copy.content.faq.title[currentLang], items: copy.content.faq.items[currentLang] },
  sidebar: copy.sidebar
};
const arrivalTipParagraphs = c.arrivalTip.text.split('\n\n');
const busIntro = c.arrivalByBus.text.split('\n\n')[0];
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  showContextNavigation={false}
>
  <Navigation
    currentLang={currentLang}
    languageToken={variant.languageToken}
  >
    <ContextNavigation
      slot="context-navigation"
      branches={destinationContextNavigation.branchNavigation.items}
      branchSwitcherAriaLabel={destinationContextNavigation.branchNavigation.ariaLabel}
      breadcrumbAriaLabel={destinationContextNavigation.breadcrumbAriaLabel}
      breadcrumbs={[
        { label: 'AMARA', href: requiredLink('home') },
        { label: variant.label, href: requiredLink(variant.locationToken) },
        { label: c.header.title }
      ]}
      context="location"
      switcherAriaLabel={destinationContextNavigation.switcherAriaLabel}
    />
  </Navigation>

  <AmaraPageShell family={variant.family} dataLang={currentLang} flush whiteCanvas>
    <div class="mx-auto w-full max-w-screen-2xl px-6 pb-6 md:px-12 md:pb-16">
      <AmaraSection variant="hero" dataComponent="arrival-guide-hero">
        <div class="max-w-4xl">
          <p class="text-on-surface-variant am-text-label">
            {c.header.eyebrow}
          </p>
          <h1 class="am-text-display mt-5 max-w-4xl text-balance text-on-surface">
            {c.header.title}
          </h1>
          <p class="am-text-title mt-5 max-w-4xl text-balance text-on-surface">
            <InlineEmphasis text={c.header.subtitle} />
          </p>
        </div>

        <figure class="am-mobile-full-bleed mt-8 aspect-[16/9] max-h-[720px] overflow-hidden bg-surface-container-low md:mt-10">
          <AmaraImage
            src={variant.heroImage}
            alt={c.header.title}
            profile="hero"
            sizes="(max-width: 639px) 100vw, (max-width: 767px) calc(100vw - 3rem), (max-width: 1535px) calc(100vw - 6rem), 1440px"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <div class="mt-8 max-w-4xl md:mt-10">
          <div class="border-y border-border-subtle py-6">
            <div>
              <p class="text-on-surface-variant am-text-label">
                {c.journeyIntro.title}
              </p>
              <p class="am-text-body mt-3 max-w-2xl leading-relaxed text-on-surface-variant">
                {c.journeyIntro.text}
              </p>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a class="am-inline-link am-text-body w-fit shrink-0" href={journeyHref}>
                {c.journeyIntro.cta}
                <span aria-hidden="true"> &rarr;</span>
              </a>
              <a class="am-inline-link am-text-body w-fit shrink-0" href={parkingHref}>
                {c.journeyIntro.parkingCta}
                <span aria-hidden="true"> &rarr;</span>
              </a>
            </div>
          </div>

          <h2 class="am-text-title mt-10 text-on-surface">{c.parking.title}</h2>
          <p class="am-text-body mt-5 max-w-3xl leading-relaxed text-on-surface-variant">
            {c.parking.text}
          </p>
          <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
            <a
              class="am-btn am-btn--primary w-full justify-center sm:w-auto"
              href={mapHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {ui.openInMaps[currentLang]}
            </a>
          </div>
        </div>
      </AmaraSection>

      <AmaraSection labelledby="arrival-facts-title" dataComponent="arrival-guide-facts">
        <div class="flex flex-col gap-8">
          <h2 id="arrival-facts-title" class="am-text-subtitle text-on-surface">
            {c.sidebar.title[currentLang]}
          </h2>
          <dl class="grid grid-cols-2 gap-x-5 gap-y-7 sm:gap-x-10 sm:gap-y-8 lg:grid-cols-4">
            <div class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
              <dt class="col-span-2 grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container-low text-primary sm:h-10 sm:w-10" aria-hidden="true">
                  <MapPin class="h-5 w-5" stroke-width={1.5} />
                </span>
                <span class="min-w-0 pt-0.5 am-text-annotation text-on-surface-variant">
                  {c.sidebar.address[currentLang]}
                </span>
              </dt>
              <dd class="am-text-body col-start-2 mt-1 leading-relaxed text-on-surface">
                {variant.addressLines[0]}<br />{variant.addressLines[1]}
              </dd>
            </div>

            <div class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
              <dt class="col-span-2 grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container-low text-primary sm:h-10 sm:w-10" aria-hidden="true">
                  <CircleParking class="h-5 w-5" stroke-width={1.5} />
                </span>
                <span class="min-w-0 pt-0.5 am-text-annotation text-on-surface-variant">
                  {c.sidebar.dropOff[currentLang]}
                </span>
              </dt>
              <dd class="am-text-body col-start-2 mt-1 leading-relaxed text-on-surface">{variant.dropOffValue}</dd>
            </div>

            <div class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
              <dt class="col-span-2 grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container-low text-primary sm:h-10 sm:w-10" aria-hidden="true">
                  <Footprints class="h-5 w-5" stroke-width={1.5} />
                </span>
                <span class="min-w-0 pt-0.5 am-text-annotation text-on-surface-variant">
                  {c.sidebar.walkingDistance[currentLang]}
                </span>
              </dt>
              <dd class="am-text-body col-start-2 mt-1 leading-relaxed text-on-surface">
                <InlineEmphasis text={c.sidebar.walkingValue[currentLang]} />
              </dd>
            </div>

            <div class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
              <dt class="col-span-2 grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-2.5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container-low text-primary sm:h-10 sm:w-10" aria-hidden="true">
                  <BusFront class="h-5 w-5" stroke-width={1.5} />
                </span>
                <span class="min-w-0 pt-0.5 am-text-annotation text-on-surface-variant">
                  {c.sidebar.busStop[currentLang]}
                </span>
              </dt>
              <dd class="am-text-body col-start-2 mt-1 leading-relaxed text-on-surface">{variant.fourthFactValue[currentLang]}</dd>
            </div>
          </dl>
        </div>
      </AmaraSection>

      <AmaraSection labelledby="arrival-car-title" dataComponent="arrival-guide-car">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-low text-primary" aria-hidden="true">
                <CarFront class="h-5 w-5" stroke-width={1.5} />
              </span>
              <h2 id="arrival-car-title" class="am-text-title text-on-surface">{c.arrivalTip.title}</h2>
            </div>
            <div class="mt-6 grid max-w-2xl gap-5">
              {arrivalTipParagraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>
              ))}
            </div>
            <div class="mt-7 border-t border-border-subtle pt-5">
              <p class="am-text-body leading-relaxed text-on-surface-variant">
                <strong class="font-bold text-on-surface">{c.sidebar.taxiNoteLabel[currentLang]}:</strong>
                {' '}{c.arrivalTip.taxiNote}
              </p>
            </div>
          </div>

          <div class="self-start border-y border-border-subtle">
            <div class="flex min-h-11 items-center py-5">
              <h3 class="am-text-annotation am-text-annotation--wide text-on-surface">
                {ui.stepLabel[currentLang]}
              </h3>
            </div>
            <ol class="bg-surface-container-low px-5 sm:px-6">
              {arrivalSteps.map((step, index) => (
                <li class="grid min-h-[4.5rem] grid-cols-[2.25rem_minmax(0,1fr)] content-center gap-x-4 border-b border-border-subtle py-4 last:border-b-0 md:min-h-[5.25rem] md:py-5">
                  <span class="am-text-label flex h-9 w-9 items-center justify-center rounded-full bg-surface text-primary" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="am-text-body self-center leading-relaxed text-on-surface">{step}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </AmaraSection>

      <AmaraSection labelledby="arrival-map-title" dataComponent="arrival-guide-map">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center">
          <figure class="am-mobile-full-bleed overflow-hidden bg-surface-container-low md:mx-0 md:w-full">
            <button
              type="button"
              class="group block w-full cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary"
              data-am-map-open
              aria-haspopup="dialog"
              aria-label={destination === 'frigiliana' ? ui.expandMap[currentLang] : c.sidebar.mapTitle[currentLang]}
            >
              <AmaraImage
                src={variant.routeImage}
                alt={destination === 'frigiliana' ? c.sidebar.mapTitle[currentLang] : c.header.title}
                profile="gallery"
                sizes="(max-width: 1023px) 100vw, 60vw"
                class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.01] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>

          <div>
            <p class="text-on-surface-variant am-text-label">
              {c.sidebar.routeTitle[currentLang]}
            </p>
            <h2 id="arrival-map-title" class="am-text-title mt-4 text-balance text-on-surface">
              {c.sidebar.mapTitle[currentLang]}
            </h2>
            <p class="am-text-body mt-5 leading-relaxed text-on-surface-variant">
              <InlineEmphasis text={c.sidebar.walkingValue[currentLang]} />
            </p>
            <div class="mt-7 grid gap-3 sm:flex sm:flex-wrap">
              <a
                class="am-btn am-btn--secondary w-full justify-center sm:w-auto"
                href={mapHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                {ui.openInMaps[currentLang]}
              </a>
            </div>
          </div>
        </div>
      </AmaraSection>

      <AmaraSection labelledby="arrival-bus-title" dataComponent="arrival-guide-bus">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div class="max-w-xl">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-low text-primary" aria-hidden="true">
                <BusFront class="h-5 w-5" stroke-width={1.5} />
              </span>
              <h2 id="arrival-bus-title" class="am-text-title text-on-surface">{c.arrivalByBus.title}</h2>
            </div>
            <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{busIntro}</p>
          </div>

          <div>
            <h3 class="am-text-annotation am-text-annotation--wide text-on-surface">
              {ui.routeChoice[currentLang]}
            </h3>
            <div class="mt-5 border-y border-border-subtle">
              {busRoutes.map((route) => (
                <article class="border-b border-border-subtle py-6 last:border-b-0">
                  <p class="text-primary am-text-label">{route.meta}</p>
                  <h3 class="am-text-subtitle mt-3 text-on-surface">{route.title}</h3>
                  <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{route.text}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </AmaraSection>

      <AmaraSection dataComponent="arrival-guide-access">
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
          <article>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-low text-primary" aria-hidden="true">
                <Footprints class="h-5 w-5" stroke-width={1.5} />
              </span>
              <h2 class="am-text-subtitle text-on-surface">{c.walkingAccess.title}</h2>
            </div>
            <p class="am-text-body mt-5 max-w-2xl leading-relaxed text-on-surface-variant">{c.walkingAccess.text}</p>
          </article>

          <article class="border-t border-border-subtle pt-8 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-low text-primary" aria-hidden="true">
                <Luggage class="h-5 w-5" stroke-width={1.5} />
              </span>
              <h2 class="am-text-subtitle text-on-surface">{c.luggageAdvice.title}</h2>
            </div>
            <p class="am-text-body mt-5 max-w-2xl leading-relaxed text-on-surface-variant">{c.luggageAdvice.text}</p>
          </article>
        </div>
      </AmaraSection>

      <AmaraSection labelledby="arrival-contact-title" dataComponent="arrival-guide-contact">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <h2 id="arrival-contact-title" class="am-text-subtitle text-on-surface">
            {c.sidebar.quickContact[currentLang]}
          </h2>
          <dl class="grid gap-0 bg-surface-container-low px-5 sm:grid-cols-2 sm:px-6">
            <div class="grid min-h-[5.5rem] grid-cols-[2.25rem_minmax(0,1fr)] content-center gap-x-4 border-b border-border-subtle py-4 sm:border-b-0 sm:border-r sm:pr-6">
              <dt class="col-span-2 grid grid-cols-[2.25rem_minmax(0,1fr)] items-center gap-x-4">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-surface text-primary" aria-hidden="true">
                  {destination === 'frigiliana'
                    ? <Phone class="h-[1.125rem] w-[1.125rem]" stroke-width={1.5} />
                    : <MapPin class="h-[1.125rem] w-[1.125rem]" stroke-width={1.5} />}
                </span>
                <span class="am-text-annotation text-on-surface-variant">
                  {c.sidebar.taxi[currentLang]}
                </span>
              </dt>
              <dd class="am-text-body col-start-2 mt-1 font-bold text-on-surface">
                <a
                  class="am-link"
                  href={variant.contactHref}
                  target={destination === 'frigiliana' ? undefined : '_blank'}
                  rel={destination === 'frigiliana' ? undefined : 'noopener noreferrer'}
                >{variant.contactValue}</a>
              </dd>
            </div>
            <div class="grid min-h-[5.5rem] grid-cols-[2.25rem_minmax(0,1fr)] content-center gap-x-4 py-4 sm:pl-6">
              <dt class="col-span-2 grid grid-cols-[2.25rem_minmax(0,1fr)] items-center gap-x-4">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-surface text-primary" aria-hidden="true">
                  <ShieldAlert class="h-[1.125rem] w-[1.125rem]" stroke-width={1.5} />
                </span>
                <span class="am-text-annotation text-on-surface-variant">
                  {c.sidebar.emergency[currentLang]}
                </span>
              </dt>
              <dd class="am-text-body col-start-2 mt-1 font-bold text-on-surface">
                <a class="am-link" href="tel:112">112</a>
              </dd>
            </div>
          </dl>
        </div>
      </AmaraSection>

      <AmaraSection variant="closing" divider={false} labelledby="arrival-faq-title" dataComponent="arrival-guide-faq">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div>
            <h2 id="arrival-faq-title" class="am-text-title text-on-surface">{c.faq.title}</h2>
          </div>
          <div class="border-t border-border-subtle">
            {c.faq.items.map((item) => (
              <details class="group border-b border-border-subtle">
                <summary class="am-accordion__trigger min-h-11 items-center py-5">
                  <span class="am-text-annotation am-text-annotation--wide pr-6 text-on-surface transition-colors group-hover:text-primary">
                    {item.question}
                  </span>
                  <span class="am-accordion__indicator" aria-hidden="true">
                    <span class="group-open:hidden">+</span>
                    <span class="hidden group-open:inline">−</span>
                  </span>
                </summary>
                <p class="am-text-body max-w-2xl pb-6 leading-relaxed text-on-surface-variant">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </AmaraSection>
    </div>
  </AmaraPageShell>

  <dialog
    id="map-overlay"
    class="am-map-dialog"
    data-am-map-overlay
    aria-label={c.sidebar.mapTitle[currentLang]}
  >
    <div class="relative w-full" data-am-map-panel>
      <button
        type="button"
        class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-on-surface text-surface transition-colors hover:bg-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        data-am-map-close
        aria-label={ui.closeMap[currentLang]}
      >
        <X class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
      </button>

      <AmaraImage
        src={variant.routeImage}
        alt={destination === 'frigiliana' ? c.sidebar.mapTitle[currentLang] : c.header.title}
        profile="gallery"
        sizes="90vw"
        class="h-auto w-full"
        loading="lazy"
        decoding="async"
      />

      <div class="mt-4 text-center">
        <a
          href={mapHref}
          target="_blank"
          rel="noopener noreferrer"
          class="am-btn am-btn--secondary am-btn--inverse"
        >
          {ui.openInMaps[currentLang]}
        </a>
      </div>
    </div>
  </dialog>

  <script>
    (() => {
      const dialog = document.querySelector<HTMLDialogElement>('[data-am-map-overlay]');
      const opener = document.querySelector<HTMLElement>('[data-am-map-open]');
      const closer = dialog?.querySelector<HTMLElement>('[data-am-map-close]');
      if (!dialog || !opener || !closer) return;

      opener.addEventListener('click', () => dialog.showModal());
      closer.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    })();
  </script>

  <style>
    .am-map-dialog {
      max-width: min(64rem, 92vw);
      width: 100%;
      padding: 1.5rem;
      border: 0;
      background: transparent;
      overflow: visible;
    }

    .am-map-dialog::backdrop {
      background: rgb(0 0 0 / 0.72);
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary {
      list-style: none;
    }
  </style>
</BaseLayout>
