---
/**
 * AMARA v3 Arrival Guide
 * Guest-facing operational arrival page for La AMARA.
 *
 * Architectural intent:
 * - This page is treated as a practical utility page for existing or arriving guests.
 * - It must remain operational, calm, and easy to scan.
 * - It is intentionally not positioned as a Typ D conversion page.
 * - SEO still runs through the global resolver contract already used by UtilityLayout.
 */
import {
  arrivalGuideBusRoutes,
  arrivalGuideCopy,
  arrivalGuideSeo,
  arrivalGuideSteps,
  arrivalGuideUi
} from '../../content/arrivalGuideContent';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const seo = arrivalGuideSeo;
const copy = arrivalGuideCopy;
const arrivalSteps = arrivalGuideSteps;
const busRoutes = arrivalGuideBusRoutes;
const ui = arrivalGuideUi;
const c = {
  nav: { brand: copy.nav.brand[currentLang], links: copy.nav.links.map((l) => ({ token: l.token, label: l.label[currentLang] })) },
  header: {
    eyebrow: copy.header.eyebrow[currentLang],
    title: copy.header.title[currentLang],
    subtitle: copy.header.subtitle[currentLang],
    backLinkWord: copy.header.backLinkWord[currentLang]
  },
  parking: { title: copy.content.parking.title[currentLang], text: copy.content.parking.text[currentLang] },
  walkingAccess: { title: copy.content.walkingAccess.title[currentLang], text: copy.content.walkingAccess.text[currentLang] },
  arrivalTip: {
    title: copy.content.arrivalTip.title[currentLang],
    text: copy.content.arrivalTip.text[currentLang],
    taxiNote: copy.content.arrivalTip.taxiNote[currentLang]
  },
  arrivalByBus: {
    title: copy.content.arrivalByBus.title[currentLang],
    text: copy.content.arrivalByBus.text[currentLang]
  },
  arrivalSection: {
    title: copy.content.arrivalSection.title[currentLang],
    steps: [
      {
        num: '01',
        headline: copy.content.arrivalByBus.title[currentLang],
        text: copy.content.arrivalSection.busStep[currentLang]
      },
      {
        num: '02',
        headline: copy.content.walkingAccess.title[currentLang],
        text: copy.content.walkingAccess.text[currentLang]
      },
      {
        num: '03',
        headline: copy.content.luggageAdvice.title[currentLang],
        text: copy.content.luggageAdvice.text[currentLang]
      }
    ]
  },
  luggageAdvice: { title: copy.content.luggageAdvice.title[currentLang], text: copy.content.luggageAdvice.text[currentLang] },
  faq: { title: copy.content.faq.title[currentLang], items: copy.content.faq.items[currentLang] },
  sidebar: copy.sidebar,
  footer: { brand: copy.footer.brand[currentLang], rights: copy.footer.rights[currentLang] }
};
---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} showContextNavigation={false} bodyBackgroundClass="bg-white">
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="arrival_guide"
  />
  <LocationContextNav activeId="arrival" lang={currentLang} />

  <div data-am-page="frigiliana-arrival-guide">
    <div class="w-full max-w-screen-2xl mx-auto px-6 md:px-12 pt-20 pb-20">
      <header class="mb-20 border-b border-black/10 pb-12">
        <span class="am-text-caption text-primary mb-4 block">{c.header.eyebrow}</span>
        <h1 class="am-text-display italic text-on-surface mb-6">{c.header.title}</h1>
        <p class="am-text-body text-on-surface-variant italic opacity-70 max-w-2xl">{c.header.subtitle}</p>
      </header>

      <div class="pt-8 space-y-20">
        {/* Operational orientation start (Arrival Guide): intro + step-by-step module */}
        <section class="grid gap-10 lg:grid-cols-12 items-start">
          <div class="lg:col-span-8 space-y-6">
            <h2 class="am-text-title italic text-on-surface">{c.parking.title}</h2>

            <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
              {c.parking.text}
            </p>

            <div class="rounded-editorial border border-outline-variant/5 bg-surface p-8">
              <h3 class="am-text-caption uppercase tracking-[0.18em] text-primary mb-5">
                {ui.stepLabel[currentLang]}
              </h3>
              <ol class="space-y-4">
                {arrivalSteps[currentLang].map((step, index) => (
                  <li class="flex gap-4">
                    <span class="mt-0.5 shrink-0 am-text-caption uppercase tracking-[0.18em] text-primary/70">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="am-text-body text-on-surface leading-relaxed">{step}</span>
                  </li>
                ))}
              </ol>
            </div>

            <section class="space-y-6 pt-10">
              <h2 class="am-text-title italic text-on-surface">{c.arrivalTip.title}</h2>

              <div class="space-y-6">
                <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
                  {c.arrivalTip.text.split('\n\n')[0]}
                </p>

                <p class="am-text-body text-on-surface-variant leading-relaxed max-w-3xl">
                  {c.arrivalTip.text.split('\n\n').slice(1).join('\n\n')}
                </p>

                <p class="am-text-body text-on-surface-variant leading-relaxed max-w-3xl">
                  <strong class="text-on-surface">{c.sidebar.taxiNoteLabel[currentLang]}:</strong> {c.arrivalTip.taxiNote}
                </p>
              </div>
            </section>

            <section class="space-y-8 pt-10">
              <h2 class="am-text-title italic text-on-surface">{c.arrivalByBus.title}</h2>

              <div class="space-y-6">
                <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
                  {c.arrivalByBus.text.split('\n\n')[0]}
                </p>

                <div class="rounded-editorial border border-outline-variant/5 bg-surface p-8 max-w-3xl">
                  <h3 class="am-text-caption uppercase tracking-[0.18em] text-primary mb-6">
                    {ui.routeChoice[currentLang]}
                  </h3>

                  <div class="space-y-6">
                    {busRoutes[currentLang].map((route) => (
                      <article class="border-b border-outline-variant/10 pb-6 last:border-b-0 last:pb-0">
                        <h3 class="am-text-subtitle text-on-surface font-normal leading-snug">{route.title}</h3>
                        <p class="am-text-caption uppercase tracking-[0.18em] opacity-50 mt-2 mb-3">
                          {route.meta}
                        </p>
                        <p class="am-text-body text-on-surface-variant leading-relaxed">
                          {route.text}
                        </p>
                      </article>
                    ))}
                  </div>
                </div>
              </div>
            </section>
          </div>

          <div class="lg:col-span-4">
            <div class="space-y-6">
              <div class="p-8 bg-surface border border-outline-variant/5 rounded-editorial">
                <h3 class="am-text-subtitle italic text-on-surface mb-8">{c.sidebar.title[currentLang]}</h3>

                <div class="space-y-6">
                  <div class="border-b border-outline-variant/10 pb-4">
                    <span class="am-text-caption uppercase tracking-[0.18em] opacity-50 mb-2 block">
                      {c.sidebar.address[currentLang]}
                    </span>
                    <p class="am-text-body text-on-surface leading-relaxed">Calle Chorruelo 5<br />29788 Frigiliana</p>
                  </div>

                  <div class="border-b border-outline-variant/10 pb-4">
                    <span class="am-text-caption uppercase tracking-[0.18em] opacity-50 mb-2 block">
                      {c.sidebar.dropOff[currentLang]}
                    </span>
                    <p class="am-text-body text-on-surface leading-relaxed">Avenida Carlos Cano 42</p>
                  </div>

                  <div class="border-b border-outline-variant/10 pb-4">
                    <span class="am-text-caption uppercase tracking-[0.18em] opacity-50 mb-2 block">
                      {c.sidebar.walkingDistance[currentLang]}
                    </span>
                    <p class="am-text-body text-on-surface leading-relaxed">{c.sidebar.walkingValue[currentLang]}</p>
                  </div>

                  <div>
                    <span class="am-text-caption uppercase tracking-[0.18em] opacity-50 mb-2 block">
                      {c.sidebar.busStop[currentLang]}
                    </span>
                    <p class="am-text-body text-on-surface leading-relaxed">Parada de Autobus - C. Real</p>
                  </div>
                </div>
              </div>

              <div class="space-y-6">
                <div class="rounded-editorial overflow-hidden border border-outline-variant/5 bg-surface">
                  <button
                    type="button"
                    class="block w-full"
                    data-am-map-open
                    aria-haspopup="dialog"
                  >
                    <AmaraImage
                      src="/images/arrival-map.jpg"
                      alt="Walking route from Avenida Carlos Cano 42 to La AMARA Frigiliana"
                      profile="gallery"
                      sizes="(max-width: 1023px) calc(100vw - 3rem), 50vw"
                      class="w-full h-auto"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                </div>

                <div>
                  <a
                    href="https://maps.app.goo.gl/S7AzRNc2QMCRyBBN6"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="am-cta-link"
                  >
                    Open route in Google Maps
                  </a>
                </div>
              </div>

              <div class="p-8 bg-surface border border-outline-variant/5 rounded-editorial max-w-xl">
                <h3 class="am-text-caption mb-8 text-primary">{c.sidebar.quickContact[currentLang]}</h3>
                <ul class="space-y-6">
                  <li class="flex flex-col border-b border-outline-variant/10 pb-4">
                    <span class="am-text-caption uppercase opacity-50 mb-1">{c.sidebar.taxi[currentLang]}</span>
                    <span class="am-text-body font-bold text-on-surface">+34 952 533 131</span>
                  </li>
                  <li class="flex flex-col">
                    <span class="am-text-caption uppercase opacity-50 mb-1">{c.sidebar.emergency[currentLang]}</span>
                    <span class="am-text-body font-bold text-primary">112</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <section class="space-y-6">
          <h2 class="am-text-title italic text-on-surface">{c.walkingAccess.title}</h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
            {c.walkingAccess.text}
          </p>
        </section>

        <section class="space-y-6">
          <h2 class="am-text-title italic text-on-surface">{c.luggageAdvice.title}</h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
            {c.luggageAdvice.text}
          </p>
        </section>

        <FaqAccordion
          arrivalTitle={c.arrivalSection.title}
          steps={c.arrivalSection.steps}
          faqTitle={c.faq.title}
          items={c.faq.items}
        />
      </div>
    </div>
  </div>

  <dialog id="map-overlay" class="am-map-dialog" data-am-map-overlay aria-label="Expanded route map">
    <div class="relative w-full" data-am-map-panel>
      <button
        type="button"
        class="absolute top-4 right-4 text-on-primary am-text-subtitle"
        data-am-map-close
      >
        ✕
      </button>

      <AmaraImage
        src="/images/arrival-map.jpg"
        alt="Expanded route map"
        profile="gallery"
        sizes="90vw"
        class="w-full h-auto rounded-editorial"
        loading="lazy"
        decoding="async"
      />

      <div class="mt-4 text-center">
        <a
          href="https://www.google.com/maps/dir/Avenida+Carlos+Cano+42,+Frigiliana/Calle+Chorruelo+5,+Frigiliana"
          target="_blank"
          rel="noopener noreferrer"
          class="am-cta-link am-cta-link--inverse"
        >
          Open route in Google Maps
        </a>
      </div>
    </div>
  </dialog>

  <script>
    // Map overlay behaviour. This was four inline onclick attributes, one of them
    // using the deprecated global `event`. A native <dialog> handles the modal
    // contract itself: top layer, focus trap, background inert, Escape to dismiss
    // and focus restored to the trigger. Only backdrop-dismiss needs wiring, and
    // the markup stays free of behaviour so a strict CSP remains possible.
    (() => {
      const dialog = document.querySelector<HTMLDialogElement>('[data-am-map-overlay]');
      const opener = document.querySelector<HTMLElement>('[data-am-map-open]');
      const closer = dialog?.querySelector<HTMLElement>('[data-am-map-close]');
      if (!dialog || !opener || !closer) return;

      opener.addEventListener('click', () => dialog.showModal());
      closer.addEventListener('click', () => dialog.close());

      // A click on ::backdrop reports the dialog itself as the target; a click on
      // the panel reports an element inside it. The panel has no full-bleed wrapper
      // above it, so this distinction actually holds for real pointer events.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    })();
  </script>

  <style>
    /*
     * The dialog is the panel box, not a full-viewport layer: ::backdrop supplies the
     * dimming. That keeps a real backdrop click targeting the dialog element rather
     * than an intermediate wrapper.
     */
    .am-map-dialog {
      max-width: min(64rem, 92vw);
      width: 100%;
      padding: 1.5rem;
      border: 0;
      background: transparent;
      overflow: visible;
    }

    .am-map-dialog::backdrop {
      background: rgb(0 0 0 / 0.7);
    }
  </style>
</LocationAuthorityLayout>
