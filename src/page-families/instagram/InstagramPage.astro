---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);

const seo: AmaraAuthoringSeo = {
  version: '2026-07-19-instagram-landing-v2.0-C',
  pageType: 'C',
  entityKey: 'amara-brand',
  languages: {
    en: {
      title: 'Instagram',
      description: 'Follow AMARA for apartment updates, local tips and behind-the-scenes posts from Frigiliana, Nerja and Tarifa.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    de: {
      title: 'Instagram',
      description: 'Folgt AMARA für Neuigkeiten zu den Unterkünften, lokale Tipps und Einblicke hinter die Kulissen aus Frigiliana, Nerja und Tarifa.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    es: {
      title: 'Instagram',
      description: 'Seguid a AMARA para ver novedades de los alojamientos, recomendaciones locales y momentos entre bastidores de Frigiliana, Nerja y Tarifa.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    nl: {
      title: 'Instagram',
      description: 'Volg AMARA voor nieuws over de verblijven, lokale tips en een kijkje achter de schermen in Frigiliana, Nerja en Tarifa.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    sv: {
      title: 'Instagram',
      description: 'Följ AMARA för nyheter om boendena, lokala tips och inblickar bakom kulisserna i Frigiliana, Nerja och Tarifa.',
      robots: 'noindex, follow',
      canonical: 'auto'
    }
  }
};

const copy = {
  kicker: {
    en: 'AMARA on Instagram',
    de: 'AMARA auf Instagram',
    es: 'AMARA en Instagram',
    nl: 'AMARA op Instagram',
    sv: 'AMARA på Instagram'
  },
  heading: {
    en: 'See what is happening at AMARA.',
    de: 'Was es bei AMARA Neues gibt.',
    es: 'Lo que ocurre en AMARA.',
    nl: 'Bekijk wat er bij AMARA gebeurt.',
    sv: 'Se vad som händer hos AMARA.'
  },
  lead: {
    en: 'Apartment updates, new photographs and the places we recommend around Frigiliana, Nerja and Tarifa.',
    de: 'Neuigkeiten zu den Unterkünften, neue Fotos und Orte, die wir rund um Frigiliana, Nerja und Tarifa empfehlen.',
    es: 'Novedades de los alojamientos, fotos nuevas y lugares que recomendamos en Frigiliana, Nerja y Tarifa.',
    nl: 'Nieuws over de verblijven, nieuwe foto’s en plekken die we aanraden rond Frigiliana, Nerja en Tarifa.',
    sv: 'Nyheter om boendena, nya bilder och platser vi rekommenderar runt Frigiliana, Nerja och Tarifa.'
  },
  support: {
    en: 'Photos from the six AMARA stays, plus restaurants, beaches and practical local tips from Frigiliana, Nerja and Tarifa.',
    de: 'Fotos aus den sechs AMARA-Unterkünften sowie Restaurants, Strände und praktische Tipps aus Frigiliana, Nerja und Tarifa.',
    es: 'Fotos de los seis alojamientos AMARA, además de restaurantes, playas y consejos prácticos de Frigiliana, Nerja y Tarifa.',
    nl: 'Foto’s van de zes AMARA-verblijven, plus restaurants, stranden en praktische tips uit Frigiliana, Nerja en Tarifa.',
    sv: 'Bilder från AMARAs sex boenden, plus restauranger, stränder och praktiska tips från Frigiliana, Nerja och Tarifa.'
  },
  externalLabel: {
    en: 'Follow @amaralodging',
    de: '@amaralodging folgen',
    es: 'Seguir a @amaralodging',
    nl: 'Volg @amaralodging',
    sv: 'Följ @amaralodging'
  },
  apartmentsLabel: {
    en: 'Explore the apartments',
    de: 'Apartments entdecken',
    es: 'Descubrir los apartamentos',
    nl: 'Ontdek de appartementen',
    sv: 'Upptäck lägenheterna'
  }
};

const instagramUrl = resolveOptionalLink('instagram', currentLang, { suppressMissing: true });
const apartmentsHref = resolveOptionalLink('romantic_hideaways', currentLang, { suppressMissing: true });
---

<BaseLayout seo={seo} pageLang={currentLang}>
  <Navigation
    currentLang={currentLang}
    currentToken="instagram_landing"
  />

  <AmaraPageShell family="instagram" dataLang={currentLang} whiteCanvas>
    <AmaraSection variant="hero" divider={false} dataComponent="instagram-landing">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:items-end lg:gap-12">
        <header class="lg:col-span-7">
          <span class="mb-8 block am-text-label text-primary">
            {copy.kicker[currentLang]}
          </span>
          <h1 class="max-w-[12ch] am-text-display text-on-surface">
            {copy.heading[currentLang]}
          </h1>
        </header>

        <div class="lg:col-span-5 lg:pb-3">
          <p class="max-w-xl am-text-body text-on-surface-variant">
            {copy.lead[currentLang]}
          </p>
          <p class="mt-6 max-w-xl am-text-body text-muted">
            {copy.support[currentLang]}
          </p>
          <div class="mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
            {instagramUrl && (
              <a
                href={instagramUrl}
                class="am-btn am-btn--primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                {copy.externalLabel[currentLang]}
              </a>
            )}
            {apartmentsHref && (
              <a href={apartmentsHref} class="am-cta-link">
                {copy.apartmentsLabel[currentLang]}
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="mt-20 grid grid-cols-3 gap-2 md:mt-28 md:gap-5" aria-hidden="true">
        <AmaraImage
          src="/images/amara-insta-facebook/108-amara-frigiliana.jpg"
          alt=""
          profile="card"
          class="aspect-[2/3] h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
        <AmaraImage
          src="/images/amara-insta-facebook/casa-amara-frigiliana-zaid-ducha-exterior.jpg"
          alt=""
          profile="card"
          class="aspect-[2/3] h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <AmaraImage
          src="/images/amara-insta-facebook/casa-amara-frigiliana-maha-chimenea.jpg"
          alt=""
          profile="card"
          class="aspect-[2/3] h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </AmaraSection>
  </AmaraPageShell>
</BaseLayout>
