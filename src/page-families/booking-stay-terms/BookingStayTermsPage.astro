---
import { resolveLocale } from '../../types/content';
import type { BookingStayTermSection } from '../../content/bookingStayTermsContent';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import AmaraPageShell from '../../components/layout/AmaraPageShell.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import {
  BOOKING_STAY_TERMS_PUBLISHED_AT,
  BOOKING_STAY_TERMS_VERSION,
  bookingStayTermsContent
} from '../../content/bookingStayTermsContent';
import { legalIdentity, legalIdentityAddress } from '../../content/legalIdentity';
import { resolveLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = resolveLocale(bookingStayTermsContent, currentLang);

const seo: AmaraAuthoringSeo = {
  version: '2026-08-17-booking-stay-terms-v1.0-C',
  pageType: 'C',
  entityKey: 'amara-brand',
  languages: {
    en: { ...resolveLocale(bookingStayTermsContent.seo, 'en'), robots: 'index, follow', canonical: 'auto' },
    de: { ...resolveLocale(bookingStayTermsContent.seo, 'de'), robots: 'index, follow', canonical: 'auto' },
    es: { ...resolveLocale(bookingStayTermsContent.seo, 'es'), robots: 'index, follow', canonical: 'auto' },
    nl: { ...resolveLocale(bookingStayTermsContent.seo, 'nl'), robots: 'index, follow', canonical: 'auto' },
    sv: { ...resolveLocale(bookingStayTermsContent.seo, 'sv'), robots: 'index, follow', canonical: 'auto' }
  }
};

const identityRows = [
  { label: copy.identity.name, value: legalIdentity.name },
  { label: copy.identity.tradingAs, value: legalIdentity.tradingName },
  { label: copy.identity.address, value: `${legalIdentityAddress}, ${copy.identity.country}` },
  { label: copy.identity.status, value: copy.identity.statusValue }
];

const privacyHref = resolveLink('legal_notice', currentLang);
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  pageFamily="booking-stay-terms"
  contextBreadcrumbTitle={copy.hero.title.replaceAll('&shy;', '')}
>
  <Navigation currentLang={currentLang} languageToken="booking_stay_terms" />

  <AmaraPageShell
    family="booking-stay-terms"
    dataLang={currentLang}
    documentVersion={BOOKING_STAY_TERMS_VERSION}
    publishedAt={BOOKING_STAY_TERMS_PUBLISHED_AT}
    class="am-document-surface"
  >
    <AmaraSection variant="hero" dataComponent="booking-terms-hero">
      <TrustHero
        eyebrow={copy.hero.subtitle}
        title={copy.hero.title}
        lead={copy.hero.lead}
        spacing="section"
      />
    </AmaraSection>

    <div class="am-document-content mx-auto">
      {(copy.sections as BookingStayTermSection[]).map((section) => (
        <AmaraSection
          id={section.id}
          class="scroll-mt-32"
          labelledby={`${section.id}-title`}
          dataComponent="booking-term-section"
        >
          <h2 id={`${section.id}-title`} class="am-text-title text-on-surface">{section.title}</h2>
          <div class="mt-6 max-w-3xl space-y-4">
            {section.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
            {section.bullets && (
              <ul class="space-y-3 pl-5 am-text-body text-on-surface-variant marker:text-primary">
                {section.bullets.map((item) => <li class="pl-2">{item}</li>)}
              </ul>
            )}
          </div>
        </AmaraSection>
      ))}

      <AmaraSection labelledby="contracting-party" dataComponent="booking-terms-contracting-party">
        <h2 id="contracting-party" class="am-text-title text-on-surface">{copy.identity.heading}</h2>
        <dl class="mt-6 grid gap-x-10 gap-y-5 am-text-body text-on-surface-variant md:grid-cols-2">
          {identityRows.map((row) => (
            <div class="grid gap-1">
              <dt class="am-text-label text-on-surface">{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
          <div class="grid gap-1">
            <dt class="am-text-label text-on-surface">{copy.identity.email}</dt>
            <dd><a class="am-inline-link" href={`mailto:${legalIdentity.email}`}>{legalIdentity.email}</a></dd>
          </div>
        </dl>
      </AmaraSection>

      <AmaraSection variant="compact" divider={false} dataComponent="booking-terms-version">
        <aside class="border-l-2 border-primary/60 pl-5 sm:pl-7" aria-label={copy.privacyLinkLabel}>
          <p class="am-text-body text-on-surface-variant"><InlineEmphasis text={copy.closingNote} /></p>
          <a class="am-cta-link mt-4 inline-flex" href={privacyHref}>{copy.privacyLinkLabel}</a>
          <p class="am-text-label mt-5 text-on-surface-variant">{copy.versionNote}</p>
        </aside>
      </AmaraSection>
    </div>
  </AmaraPageShell>
</BaseLayout>
