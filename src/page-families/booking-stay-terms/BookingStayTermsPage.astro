---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TrustHero from '../../components/hero/TrustHero.astro';
import {
  BOOKING_STAY_TERMS_DOCUMENT_ID,
  BOOKING_STAY_TERMS_PUBLISHED_AT,
  BOOKING_STAY_TERMS_VERSION,
  bookingStayTermsContent
} from '../../content/bookingStayTermsContent';
import { legalIdentity, legalIdentityAddress } from '../../content/legalIdentity';
import { resolveLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = bookingStayTermsContent[currentLang];

const seo: AmaraAuthoringSeo = {
  version: '2026-08-17-booking-stay-terms-v1.0-C',
  pageType: 'C',
  entityKey: 'amara-brand',
  languages: {
    en: { ...bookingStayTermsContent.en.seo, robots: 'index, follow', canonical: 'auto' },
    de: { ...bookingStayTermsContent.de.seo, robots: 'index, follow', canonical: 'auto' },
    es: { ...bookingStayTermsContent.es.seo, robots: 'index, follow', canonical: 'auto' },
    nl: { ...bookingStayTermsContent.nl.seo, robots: 'index, follow', canonical: 'auto' },
    sv: { ...bookingStayTermsContent.sv.seo, robots: 'index, follow', canonical: 'auto' }
  }
};

const metadata = [
  { label: copy.metadata.document, value: BOOKING_STAY_TERMS_DOCUMENT_ID },
  { label: copy.metadata.version, value: BOOKING_STAY_TERMS_VERSION },
  { label: copy.metadata.published, value: copy.metadata.publishedValue },
  { label: copy.metadata.appliesTo, value: copy.metadata.appliesToValue }
];

const identityRows = [
  { label: copy.identity.name, value: legalIdentity.name },
  { label: copy.identity.tradingAs, value: legalIdentity.tradingName },
  { label: copy.identity.address, value: `${legalIdentityAddress}, ${copy.identity.country}` },
  { label: copy.identity.taxId, value: legalIdentity.taxId },
  { label: copy.identity.status, value: copy.identity.statusValue }
];

const privacyHref = resolveLink('legal_notice', currentLang);
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  contextBreadcrumbTitle={copy.hero.title.replaceAll('&shy;', '')}
  bodyBackgroundClass="bg-surface-container-lowest"
>
  <Navigation currentLang={currentLang} languageToken="booking_stay_terms" />

  <div class="bg-surface-container-lowest" data-am-page="booking-stay-terms" data-document-version={BOOKING_STAY_TERMS_VERSION} data-published-at={BOOKING_STAY_TERMS_PUBLISHED_AT}>
    <div class="mx-auto w-full max-w-[1400px] px-[5vw]" data-lang={currentLang}>
      <TrustHero subtitle={copy.hero.subtitle} title={copy.hero.title} lead={copy.hero.lead} />

      <main id="am-main-content" tabindex="-1" class="mx-auto max-w-screen-lg scroll-mt-[104px] pb-28 lg:scroll-mt-[112px]">
        <section class="border-y border-outline-variant/15 py-8" aria-label={copy.metadata.document}>
          <dl class="grid gap-x-8 gap-y-6 md:grid-cols-2">
            {metadata.map((item) => (
              <div class="grid gap-1">
                <dt class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">{item.label}</dt>
                <dd class="am-text-body text-on-surface">{item.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="py-14 md:py-16" aria-labelledby="booking-terms-model">
          <div class="max-w-3xl space-y-4">
            <h2 id="booking-terms-model" class="am-text-title italic text-on-surface">{copy.model.heading}</h2>
            <p class="am-text-body text-on-surface-variant">{copy.model.intro}</p>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            <article class="border border-outline-variant/15 bg-surface px-7 py-7 md:px-8 md:py-8">
              <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-primary">01</p>
              <h3 class="am-text-subtitle mt-4 italic text-on-surface">{copy.model.stableTitle}</h3>
              <p class="am-text-body mt-4 text-on-surface-variant">{copy.model.stableText}</p>
            </article>
            <article class="border border-outline-variant/15 bg-surface px-7 py-7 md:px-8 md:py-8">
              <p class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-primary">02</p>
              <h3 class="am-text-subtitle mt-4 italic text-on-surface">{copy.model.flexibleTitle}</h3>
              <p class="am-text-body mt-4 text-on-surface-variant">{copy.model.flexibleText}</p>
            </article>
          </div>
        </section>

        <section class="border border-outline-variant/15 bg-surface px-7 py-8 md:px-10 md:py-10" aria-labelledby="contracting-party">
          <h2 id="contracting-party" class="am-text-title italic text-on-surface">{copy.identity.heading}</h2>
          <dl class="mt-8 space-y-4 am-text-body text-on-surface-variant">
            {identityRows.map((row) => (
              <div class="grid gap-2 border-b border-outline-variant/10 pb-4 last:border-b-0 last:pb-0 md:grid-cols-[minmax(0,16rem)_1fr]">
                <dt class="font-semibold text-on-surface">{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
            <div class="grid gap-2 border-b border-outline-variant/10 pb-4 md:grid-cols-[minmax(0,16rem)_1fr]">
              <dt class="font-semibold text-on-surface">{copy.identity.email}</dt>
              <dd><a class="am-inline-link" href={`mailto:${legalIdentity.email}`}>{legalIdentity.email}</a></dd>
            </div>
            <div class="grid gap-2 md:grid-cols-[minmax(0,16rem)_1fr]">
              <dt class="font-semibold text-on-surface">{copy.identity.phone}</dt>
              <dd><a class="am-inline-link" href={`tel:${legalIdentity.phoneHref}`}>{legalIdentity.phoneDisplay}</a></dd>
            </div>
          </dl>
        </section>

        <div class="mt-16 space-y-14 md:mt-20 md:space-y-16">
          {copy.sections.map((section) => (
            <section id={section.id} class="scroll-mt-32 border-t border-outline-variant/15 pt-8" aria-labelledby={`${section.id}-title`}>
              <h2 id={`${section.id}-title`} class="am-text-title italic text-on-surface">{section.title}</h2>
              <div class="mt-6 max-w-3xl space-y-4">
                {section.paragraphs.map((paragraph) => (
                  <p class="am-text-body text-on-surface-variant">{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul class="space-y-3 pl-5 am-text-body text-on-surface-variant marker:text-primary">
                    {section.bullets.map((item) => <li class="pl-2">{item}</li>)}
                  </ul>
                )}
              </div>
            </section>
          ))}
        </div>

        <aside class="mt-16 border-l-2 border-primary/60 bg-surface-container-low px-7 py-6 md:mt-20 md:px-8" aria-label={copy.privacyLinkLabel}>
          <p class="am-text-body text-on-surface-variant">{copy.closingNote}</p>
          <a class="am-cta-link mt-4 inline-flex" href={privacyHref}>{copy.privacyLinkLabel}</a>
        </aside>
      </main>
    </div>
  </div>
</BaseLayout>
