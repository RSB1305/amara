---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import BeachesCoastGraphic, { type BeachesCoastGraphicData } from '../../components/location/BeachesCoastGraphic.astro';
import Navigation from '../../components/Navigation.astro';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import { getNerjaCoastGuideFacts } from '../../content/sharedExperienceFacts';
import {
  nerjaBeachesPageContent,
  nerjaBeachesSeo
} from '../../content/nerjaExperienceAdditionsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import BeachPracticalSection from './BeachPracticalSection.astro';
import BeachSectionList from './BeachSectionList.astro';
import ExperienceRelatedSection from './ExperienceRelatedSection.astro';
import { routeHero } from '../../lib/images/routeImages';

interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = routeHero('nerja.experience.beaches', currentLang);
const shared = getNerjaCoastGuideFacts(currentLang);
const copy = nerjaBeachesPageContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja beaches');

const footerHighlights: LabeledLink[] = [
  { token: 'nerja_beaches_authority', label: copy.navLabel },
  { token: 'nerja_food_authority', label: copy.related.items[0].title },
  { token: 'nerja_balcon_de_europa', label: copy.related.items[1].title }
];

const beachesGraphicByLang: Record<AmaraLanguage, BeachesCoastGraphicData> = {
  en: {
    place: 'nerja', eyebrow: 'Beaches & coves', destination: 'Nerja',
    region: 'Costa del Sol · Axarquía', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Coast map with six beaches along the Nerja shoreline',
    context: [
      { label: 'Beaches', value: 'Six along the coast' },
      { label: 'Character', value: 'Quiet · Nature · Town' },
      { label: 'Coves', value: 'East towards Maro' }
    ]
  },
  de: {
    place: 'nerja', eyebrow: 'Strände & Buchten', destination: 'Nerja',
    region: 'Costa del Sol · Axarquía', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Küstenkarte mit sechs Stränden entlang der Küste von Nerja',
    context: [
      { label: 'Strände', value: 'Sechs an der Küste' },
      { label: 'Charakter', value: 'Ruhig · Natur · Stadt' },
      { label: 'Buchten', value: 'Östlich Richtung Maro' }
    ]
  },
  es: {
    place: 'nerja', eyebrow: 'Playas y calas', destination: 'Nerja',
    region: 'Costa del Sol · Axarquía', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Mapa de la costa con seis playas a lo largo del litoral de Nerja',
    context: [
      { label: 'Playas', value: 'Seis en la costa' },
      { label: 'Carácter', value: 'Tranquila · Naturaleza · Ciudad' },
      { label: 'Calas', value: 'Al este hacia Maro' }
    ]
  },
  nl: {
    place: 'nerja', eyebrow: 'Stranden & baaien', destination: 'Nerja',
    region: 'Costa del Sol · Axarquía', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Kustkaart met zes stranden langs de kust van Nerja',
    context: [
      { label: 'Stranden', value: 'Zes langs de kust' },
      { label: 'Karakter', value: 'Rustig · Natuur · Stad' },
      { label: 'Baaien', value: 'Oostwaarts richting Maro' }
    ]
  },
  sv: {
    place: 'nerja', eyebrow: 'Stränder & vikar', destination: 'Nerja',
    region: 'Costa del Sol · Axarquía', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Kustkarta med sex stränder längs Nerjas kust',
    context: [
      { label: 'Stränder', value: 'Sex längs kusten' },
      { label: 'Karaktär', value: 'Lugnt · Natur · Stad' },
      { label: 'Vikar', value: 'Österut mot Maro' }
    ]
  }
};
const beachesGraphicData = beachesGraphicByLang[currentLang];

---

<LocationAuthorityLayout seo={nerjaBeachesSeo} pageLang={currentLang} footerHighlights={footerHighlights} pageFamily="experience-nerja-beaches">
  <Navigation slot="navigation" contextDestination="nerja" currentLang={currentLang} languageToken="nerja_beaches_authority" >
    <ExperienceContextNav slot="context-navigation" currentId="beaches" destination="nerja" lang={currentLang} />
  </Navigation>

  <div data-am-page="nerja-beaches">
    <LocationExperienceHero
      {...hero}
      topic="beaches"
      eyebrow={copy.hero.kicker}
      title={copy.hero.title}
      paragraphs={copy.hero.paragraphs}
    >
      <BeachesCoastGraphic slot="visual" data={beachesGraphicData} />
    </LocationExperienceHero>

    <AuthorityFeatureSection
      id="coast"
      title={copy.overview.title}
      intro={copy.overview.intro}
      items={copy.overview.items}
      emphasizeText
    />

    <BeachSectionList
      sections={shared.sections}
      labels={shared.cardLabels}
      emphasizeText
    />

    <AuthorityFeatureSection
      id="conditions"
      title={shared.conditions.title}
      intro={shared.conditions.intro}
      items={shared.conditions.items}
      emphasizeText
    />

    <BeachPracticalSection
      title={shared.practical.title}
      intro={shared.practical.intro}
      items={shared.practical.items}
      accessNote={shared.practical.accessNote}
      columns={4}
      emphasizeText
    />

    <ExperienceRelatedSection
      title={copy.related.title}
      items={copy.related.items}
      resolveHref={requiredLink}
      surface="tint"
    />

    <GuestGuideBridge lang={currentLang} destination="nerja" guideSlugs={['nerja-guest-beaches']} />

    <AuthorityStayBridge
      eyebrow={experienceStayBridge.eyebrow[currentLang]}
      title={copy.closing.title}
      reason={copy.closing.lead}
      stayHref={requiredLink('playa')}
      stayLabel={copy.closing.propertyLabel}
      availabilityHref={requiredLink('book')}
      availabilityLabel={experienceStayBridge.availabilityLabel[currentLang]}
    />
  </div>
</LocationAuthorityLayout>
