---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import PhotoBrief from './PhotoBrief.astro';
import Navigation from '../../components/Navigation.astro';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import { getNerjaCoastGuideFacts } from '../../content/sharedExperienceFacts';
import {
  nerjaBeachesPageContent,
  nerjaBeachesSeo
} from '../../content/nerjaExperienceAdditionsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import BeachPracticalSection from './BeachPracticalSection.astro';
import BeachSectionList from './BeachSectionList.astro';
import ExperienceRelatedSection from './ExperienceRelatedSection.astro';

interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const shared = getNerjaCoastGuideFacts(currentLang);
const copy = nerjaBeachesPageContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja beaches');

const footerHighlights: LabeledLink[] = [
  { token: 'nerja_beaches_authority', label: copy.navLabel },
  { token: 'nerja_food_authority', label: copy.related.items[0].title },
  { token: 'nerja_balcon_de_europa', label: copy.related.items[1].title }
];

---

<LocationAuthorityLayout seo={nerjaBeachesSeo} pageLang={currentLang} footerHighlights={footerHighlights} pageFamily="experience-nerja-beaches">
  <Navigation slot="navigation" contextDestination="nerja" currentLang={currentLang} languageToken="nerja_beaches_authority" >
    <ExperienceContextNav slot="context-navigation" currentId="beaches" destination="nerja" lang={currentLang} />
  </Navigation>

  <div data-am-page="nerja-beaches">
    <LocationExperienceHero
      topic="beaches"
      eyebrow={copy.hero.kicker}
      title={copy.hero.title}
      paragraphs={copy.hero.paragraphs}
    >
      <PhotoBrief slot="visual" class="aspect-[3/4] h-full w-full" motif="Playa de Burriana oder Playa Carabeo vom Weg oberhalb, Bucht und Wasser" format="hochkant 3:4" light="vormittags" />
    </LocationExperienceHero>

    <AuthorityFeatureSection
      id="coast"
      title={copy.overview.title}
      intro={copy.overview.intro}
      items={copy.overview.items}
      emphasizeText
    />

    <BeachSectionList
      sections={shared.sections}
      labels={shared.cardLabels}
      emphasizeText
    />

    <AuthorityFeatureSection
      id="conditions"
      title={shared.conditions.title}
      intro={shared.conditions.intro}
      items={shared.conditions.items}
      emphasizeText
    />

    <BeachPracticalSection
      title={shared.practical.title}
      intro={shared.practical.intro}
      items={shared.practical.items}
      accessNote={shared.practical.accessNote}
      columns={4}
      emphasizeText
    />

    <ExperienceRelatedSection
      title={copy.related.title}
      items={copy.related.items}
      resolveHref={requiredLink}
      surface="tint"
    />

    <AuthorityStayBridge
      eyebrow={experienceStayBridge.eyebrow[currentLang]}
      title={copy.closing.title}
      reason={copy.closing.lead}
      stayHref={requiredLink('playa')}
      stayLabel={copy.closing.propertyLabel}
      availabilityHref={requiredLink('book')}
      availabilityLabel={experienceStayBridge.availabilityLabel[currentLang]}
    />
  </div>
</LocationAuthorityLayout>
