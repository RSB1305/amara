---
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  getWeatherAuthorityContent,
  getWeatherSeo,
  weatherForecastUrls,
  weatherMonthLabels
} from '../../content/locationWeatherAuthorityContent';
import { climateDataSourceUrls, locationClimateProfiles, comparisonCityByLang, comparisonCityHighs, comparisonCityRecords } from '../../content/locationClimateData';
import { climateComparisonContent } from '../../content/climateComparisonContent';
import { climateMicroclimateContent } from '../../content/climateMicroclimateContent';
import { weatherConnections } from '../../content/weatherConnectionsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import type { LocationGuideIconName } from '../../components/location/locationGuideIconContract';
import WeatherAuthorityBody from './WeatherAuthorityBody.astro';

type Destination = 'frigiliana' | 'nerja' | 'tarifa';

interface Props {
  destination: Destination;
  lang?: string;
}

const { destination, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = getWeatherAuthorityContent(destination, currentLang);
const seo = getWeatherSeo(destination);

const config = {
  frigiliana: {
    resolverName: 'Frigiliana weather',
    languageToken: 'weather_frigiliana',
    primaryToken: 'location_frigiliana',
    secondaryToken: 'frigiliana_stairs'
  },
  nerja: {
    resolverName: 'Nerja weather',
    languageToken: 'nerja_weather',
    primaryToken: 'location_nerja',
    secondaryToken: 'nerja_where_to_stay'
  },
  tarifa: {
    resolverName: 'Tarifa weather',
    languageToken: 'tarifa_weather',
    primaryToken: 'location_tarifa',
    secondaryToken: 'tarifa_where_to_stay'
  }
} as const satisfies Record<Destination, {
  resolverName: string;
  languageToken: string;
  primaryToken: string;
  secondaryToken: string;
}>;

const pageConfig = config[destination];
const requiredLink = createRequiredLinkResolver(currentLang, pageConfig.resolverName);
const months = locationClimateProfiles[destination].map((month, index) => ({
  month: weatherMonthLabels[currentLang][index],
  ...month
}));
const comparisonCopy = climateComparisonContent[destination]?.[currentLang];
const comparisonCity = comparisonCityByLang[currentLang];
const comparison = comparisonCopy && comparisonCity
  ? {
      eyebrow: comparisonCopy.eyebrow,
      title: comparisonCopy.title,
      cityLabel: comparisonCity.name,
      cityHighs: [...comparisonCityHighs[comparisonCity.key]],
      cityRecords: [...comparisonCityRecords[comparisonCity.key]],
      compareLabel: comparisonCopy.compareLabel,
      summer: {
        eyebrow: comparisonCopy.summer.eyebrow,
        title: comparisonCopy.summer.title,
        body: comparisonCopy.summer.body,
        linkLabel: comparisonCopy.summer.linkLabel,
        linkHref: requiredLink(comparisonCopy.summer.linkToken)
      },
      winter: {
        eyebrow: comparisonCopy.winter.eyebrow,
        title: comparisonCopy.winter.title,
        body: comparisonCopy.winter.body,
        linkLabel: comparisonCopy.winter.linkLabel,
        linkHref: requiredLink(comparisonCopy.winter.linkToken)
      }
    }
  : undefined;
const microCopy = climateMicroclimateContent[destination]?.[currentLang];
// The first panel's symbol differs by destination: heat where the summer story
// is heat (Frigiliana/Nerja), the two opposing winds where it is wind (Tarifa).
const microSeasonIcons: Record<Destination, { summer: LocationGuideIconName; winter: LocationGuideIconName }> = {
  frigiliana: { summer: 'temperature', winter: 'evening' },
  nerja: { summer: 'temperature', winter: 'evening' },
  tarifa: { summer: 'comparison', winter: 'evening' }
};
const microclimate = microCopy
  ? {
      eyebrow: microCopy.eyebrow,
      title: microCopy.title,
      intro: microCopy.intro,
      summer: { ...microCopy.summer, icon: microSeasonIcons[destination].summer },
      winter: { ...microCopy.winter, icon: microSeasonIcons[destination].winter },
      links: microCopy.links.map((link) => ({ label: link.label, href: requiredLink(link.token) }))
    }
  : undefined;
const connectionItems = (weatherConnections[destination] ?? [])
  .filter((item) => item.languages.includes(currentLang))
  .map((item) => ({
    icon: item.icon,
    eyebrow: item.eyebrow[currentLang]!,
    title: item.title[currentLang]!,
    body: item.body[currentLang]!,
    linkLabel: item.linkLabel[currentLang]!,
    linkHref: requiredLink(item.linkToken)
  }));
const connections = connectionItems.length > 0 ? connectionItems : undefined;
const footerHighlights: LabeledLink[] | undefined = destination === 'tarifa'
  ? [
      { token: 'tarifa_weather', label: content.navLabel },
      { token: 'tarifa_where_to_stay', label: content.related.links[1].label }
    ]
  : undefined;
const liveForecast = content.forecast.live
  ? {
      endpoint: `/api/weather/${destination}`,
      lang: currentLang,
      labels: content.forecast.live
    }
  : undefined;
---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights} pageFamily="location-weather">
  <Navigation slot="navigation" contextDestination={destination} currentLang={currentLang} languageToken={pageConfig.languageToken} >
    {destination === 'frigiliana' && (
      <LocationContextNav slot="context-navigation" activeId="weather" lang={currentLang} />
    )}
    {destination === 'nerja' && (
      <NerjaContextNav slot="context-navigation" activeId="weather-seasons" childLabel={content.navLabel} lang={currentLang} />
    )}
    {destination === 'tarifa' && (
      <TarifaContextNav slot="context-navigation" activeId="overview" activeChildId="weather-seasons" currentLabel="Tarifa" childLabel={content.navLabel} lang={currentLang} />
    )}
  </Navigation>
  <WeatherAuthorityBody
    pageId={`${destination}-weather`}
    lang={currentLang}
    content={content}
    months={months}
    comparison={comparison}
    microclimate={microclimate}
    connections={connections}
    climateSource={{ label: content.sources.links[0].label, href: climateDataSourceUrls[destination] }}
    forecastHref={weatherForecastUrls[destination]}
    liveForecast={liveForecast}
    primaryHref={requiredLink(pageConfig.primaryToken)}
    secondaryHref={requiredLink(pageConfig.secondaryToken)}
  />
</LocationAuthorityLayout>
