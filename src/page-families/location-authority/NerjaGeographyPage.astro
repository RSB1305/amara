---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import Navigation from '../../components/Navigation.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import type { LocationGuideIconName } from '../../components/location/LocationGuideIcon.astro';
import {
  nerjaGeographyContent,
  nerjaGeographySeo
} from '../../content/nerjaGeographyContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthoritySectionCardGrid from './AuthoritySectionCardGrid.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = nerjaGeographyContent[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja geography');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_nerja');
const propertyHref = requiredLink('playa');
const footerHighlights: LabeledLink[] = [
  { token: 'nerja_geography', label: content.navLabel },
  { token: 'getting_to_nerja', label: content.related.links[0].label },
  { token: 'nerja_where_to_stay', label: content.related.links[1].label }
];
const [coastSection, builtUpSection, sierraSection, riverSection, staySection] = content.sections;
const landscapeSections = [builtUpSection, sierraSection, riverSection];
const landscapeIcons: LocationGuideIconName[] = [
  'village',
  'elevation',
  'coast'
];
---

<LocationAuthorityLayout
  seo={nerjaGeographySeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="nerja_geography"
  />
  <NerjaContextNav
    activeId="geography-orientation"
    childLabel={content.navLabel}
    lang={currentLang}
  />

  <AuthorityArticle
    pageId="nerja-geography"
    family="location"
    topic="geography"
    lang={currentLang}
    hero={content.hero}
    authorName={nerjaGeographySeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
    secondaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    presentation="guide"
    guideSummary={{
      eyebrow: content.navLabel,
      body: content.hero.standfirst,
      items: [content.facts[1], content.facts[2], content.facts[3]]
    }}
  >
    <section
      aria-labelledby="nerja-orientation-title"
      class="border-b border-border-subtle bg-inverse-surface px-6 py-20 text-inverted-on-surface md:px-12 md:py-28"
      data-am-orientation="nerja"
    >
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary-fixed-dim">{content.orientation.eyebrow}</p>
          <h2 id="nerja-orientation-title" class="am-text-title mt-5 text-balance text-inverted-on-surface">{content.orientation.title}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={content.orientation.intro} /></p>
        </div>
        <ol class="grid border-y border-inverted-on-surface/20 sm:grid-cols-2 lg:col-span-8">
          {content.orientation.items.map((item, index) => (
            <li
              class:list={[
                'border-inverted-on-surface/20 px-1 py-6 sm:px-7',
                index > 1 && 'border-t',
                index % 2 === 1 && 'sm:border-l'
              ]}
              data-am-orientation-point={index + 1}
            >
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary-fixed-dim">{item.label}</span>
              <span class="am-text-subtitle mt-3 block text-inverted-on-surface">{item.value}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <AuthorityTextSection section={coastSection} index={0} presentation="guide" />

    <AuthoritySectionCardGrid sections={landscapeSections} icons={landscapeIcons} />

    <AuthorityTextSection section={staySection} index={0} presentation="guide" />

    <AuthorityRelatedLinks
      related={content.related}
      columns="md:grid-cols-2"
      resolveHref={requiredLink}
      presentation="guide"
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
