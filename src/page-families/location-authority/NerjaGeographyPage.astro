---
import Navigation from '../../components/Navigation.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import type { LocationGuideIconName } from '../../components/location/LocationGuideIcon.astro';
import {
  nerjaGeographyContent,
  nerjaGeographySeo
} from '../../content/nerjaGeographyContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import GeographyAuthorityBody from './GeographyAuthorityBody.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = nerjaGeographyContent[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja geography');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_nerja');
const propertyHref = requiredLink('playa');
const footerHighlights: LabeledLink[] = [
  { token: 'nerja_geography', label: content.navLabel },
  { token: 'getting_to_nerja', label: content.related.links[0].label },
  { token: 'nerja_where_to_stay', label: content.related.links[1].label }
];
const landscapeIcons: LocationGuideIconName[] = [
  'village',
  'elevation',
  'coast'
];
---

<LocationAuthorityLayout
  seo={nerjaGeographySeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="nerja_geography"
  >
    <NerjaContextNav slot="context-navigation"
      activeId="geography-orientation"
      childLabel={content.navLabel}
      lang={currentLang}
    />
  </Navigation>

  <AuthorityArticle
    pageId="nerja-geography"
    family="location"
    topic="geography"
    lang={currentLang}
    hero={content.hero}
    authorName={nerjaGeographySeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
    secondaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    presentation="guide"
    guideSummary={{
      eyebrow: content.navLabel,
      body: content.hero.standfirst,
      items: content.facts.slice(0, 3)
    }}
  >
    <GeographyAuthorityBody
      destination="nerja"
      orientation={content.orientation}
      sections={content.sections}
      middleIcons={landscapeIcons}
    />

    <AuthorityRelatedLinks
      related={content.related}
      columns="md:grid-cols-2"
      resolveHref={requiredLink}
      presentation="guide"
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
