---
/**
 * One authored text section of an authority article.
 *
 * The alternating surface, the eyebrow/heading column and the paragraph rhythm
 * are identical across the family; only the paragraph that carries the pull
 * quote and the ground it sits on differ, so those are the sole options. Any
 * `data-am-*` attribute a page already ships on its sections is passed through
 * unchanged.
 */
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';


interface AuthoritySection {
  id: string;
  eyebrow: string;
  title: string;
  paragraphs: string[];
}

interface Props {
  section: AuthoritySection;
  /** Position in the section list; decides the alternating surface. */
  index: number;
  /** Paragraph carrying the pull quote. Defaults to the closing paragraph. */
  highlightIndex?: number;
  /** Ground the pull quote sits on; the getting-to pages use the low container. */
  highlightSurface?: 'bg-surface' | 'bg-surface-container-low';
  presentation?: 'article' | 'guide';
  [attribute: `data-am-${string}`]: string | undefined;
}

const {
  section,
  index,
  highlightIndex = section.paragraphs.length - 1,
  highlightSurface = 'bg-surface',
  presentation = 'article',
  ...sectionAttributes
} = Astro.props;
---

<section
  id={section.id}
  class:list={[
    'scroll-mt-32 border-b border-border-subtle px-6 py-20 md:px-12 md:py-28',
    index % 2 === 0 ? 'bg-surface' : 'bg-surface-container-low'
  ]}
  {...sectionAttributes}
>
  <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{section.eyebrow}</p>
      <h2
        class:list={[
          'am-text-title mt-5 max-w-xl text-balance text-on-surface',
          presentation === 'guide' && 'italic'
        ]}
      >
        {section.title}
      </h2>
    </div>
    <div class="max-w-4xl space-y-5 lg:col-span-7">
      {section.paragraphs.map((paragraph, paragraphIndex) => (
        <p
          class:list={[
            paragraphIndex === 0 ? 'am-text-subtitle' : 'am-text-body',
            'leading-relaxed text-on-surface-variant',
            paragraphIndex === highlightIndex &&
              `border-l-2 border-primary/35 ${highlightSurface} px-6 py-5 text-on-surface`
          ]}
        >
          <InlineEmphasis text={paragraph} />
        </p>
      ))}
    </div>
  </div>
</section>
