---
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import EssenceGrid from '../../components/EssenceGrid.astro';
import ClimateExperienceSection from '../../components/location/ClimateExperienceSection.astro';
import VillageStructureInsight from '../../components/location/VillageStructureInsight.astro';
import PhotoShow from '../../components/PhotoShow.astro';
import StayDecision from '../../components/StayDecision.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import LocationEditorialComparison from '../../components/location/LocationEditorialComparison.astro';
import SectionAnchorNav from '../../components/navigation/SectionAnchorNav.astro';
import {
  frigilianaLocationCopy,
  frigilianaLocationSeo
} from '../../content/frigilianaLocationContent';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { getFrigilianaAuthoritySubnav } from '../../lib/frigiliana/frigilianaAuthoritySubnav';
import { buildOwnedLocalizedPath, isPublicLinkEnabled } from '../../lib/routeOwnership';
import { getWeatherWithFallback } from '../../lib/weather/weatherService';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const seo = frigilianaLocationSeo;
const copy = frigilianaLocationCopy;
const optionalLink = (token: string) =>
  resolveOptionalLink(token, currentLang, { suppressMissing: true });
const arrivalGuideHref = buildOwnedLocalizedPath('directions-arrival-guide', currentLang);
const parkingHref = buildOwnedLocalizedPath('frigiliana-parking', currentLang);
const weatherHref = buildOwnedLocalizedPath('frigiliana-weather', currentLang);
const allFaqsHref = optionalLink('frigiliana_faq');

const c = {
  nav: {
    brand: copy.nav.brand[currentLang],
    links: copy.nav.links.map((l) => ({ token: l.token, label: l.label[currentLang] }))
  },
  hero: {
    eyebrow: copy.hero.eyebrow[currentLang],
    h1: copy.hero.h1[currentLang],
    body: copy.hero.body[currentLang],
    introLeadBefore: copy.hero.introLead[currentLang].before,
    introLeadLinkLabel: copy.hero.introLead[currentLang].linkLabel,
    introLeadAfter: copy.hero.introLead[currentLang].after,
    ctaMain: copy.hero.ctaMain[currentLang],
    ctaAlt: copy.hero.ctaAlt[currentLang]
  },
  essence: { eyebrow: copy.essence.eyebrow[currentLang], title: copy.essence.title[currentLang], intro: copy.essence.intro[currentLang], items: copy.essence.items.map(item => ({ kicker: item.kicker[currentLang], headline: item.headline[currentLang], text: item.text[currentLang], imageSrc: item.imageSrc, imageAlt: item.headline[currentLang], href: item.token && isPublicLinkEnabled(item.token) ? optionalLink(item.token) : undefined, linkLabel: item.linkLabel ? item.linkLabel[currentLang] : undefined })) },
  climate: {
    eyebrowCurrent: copy.climate.eyebrowCurrent[currentLang],
    heroTemp: copy.climate.heroTemp[currentLang],
    heroTagline: copy.climate.heroTagline[currentLang],
    headline: copy.climate.headline[currentLang],
    body: copy.climate.body[currentLang],
    metricHumidity: copy.climate.metricHumidity[currentLang],
    metricWind: copy.climate.metricWind[currentLang],
    metricUv: copy.climate.metricUv[currentLang],
    metricSunset: copy.climate.metricSunset[currentLang],
    factSunDays: copy.climate.factSunDays[currentLang],
    factCoolerVsCoast: copy.climate.factCoolerVsCoast[currentLang],
    cta: copy.climate.cta[currentLang]
  },
  comparison: {
    eyebrow: copy.comparison.eyebrow[currentLang],
    title: copy.comparison.title[currentLang],
    intro: copy.comparison.intro[currentLang],
    items: copy.comparison.items[currentLang],
    imagePrimary: {
      src: copy.comparison.imagePrimary.src,
      alt: copy.comparison.imagePrimary.alt[currentLang]
    },
    imageSecondary: {
      src: copy.comparison.imageSecondary.src,
      alt: copy.comparison.imageSecondary.alt[currentLang]
    }
  },
  villageStructure: {
    imageSrc: copy.villageStructure.imageSrc,
    imageAlt: copy.villageStructure.imageAlt[currentLang],
    eyebrow: copy.villageStructure.eyebrow[currentLang],
    headline: copy.villageStructure.headline[currentLang],
    supporting: copy.villageStructure.supporting[currentLang],
    signal: copy.villageStructure.signal[currentLang],
    cta: copy.villageStructure.cta[currentLang]
  },
  gallery: { eyebrow: copy.gallery.eyebrow[currentLang], title: copy.gallery.title[currentLang], images: copy.gallery.items.map(img => ({ src: img.src, alt: img.alt[currentLang] || img.alt.en, caption: img.caption[currentLang] || img.caption.en })) },
  decision: { eyebrow: copy.decision.eyebrow[currentLang], title: copy.decision.title[currentLang], profiles: copy.decision.profiles.map(p => ({ title: p.title[currentLang], description: p.description[currentLang], suitability: p.suitability[currentLang] })) },
  faq: {
    arrivalTitle: copy.faq.arrivalTitle[currentLang],
    steps: copy.faq.steps.map((s) => ({ num: s.num, headline: s.h[currentLang], text: s.t[currentLang] })),
    faqTitle: copy.faq.faqTitle[currentLang],
    items: copy.faq.items.map((item) => ({ question: item.q[currentLang], answer: item.a[currentLang] })),
    arrivalDetailCta: { href: arrivalGuideHref, label: copy.faq.arrivalDetailCta[currentLang] },
    allFaqsCta: allFaqsHref ? { href: allFaqsHref, label: copy.faq.allFaqsCta[currentLang] } : undefined
  },
  footer: { brand: copy.footer.brand[currentLang], rights: copy.footer.rights[currentLang], links: copy.footer.nav.map(link => ({ token: link.token, label: link.label[currentLang] })) }
};

/** Live snapshot for the climate band (Open-Meteo + cache + safe default â€” never throws). */
const weatherSnapshot = await getWeatherWithFallback();

const climateMetricLabels: Record<
  AmaraLanguage,
  { humidity: string; wind: string; uv: string; sunset: string }
> = {
  en: { humidity: 'Humidity', wind: 'Wind', uv: 'UV', sunset: 'Sunset' },
  de: { humidity: 'Feuchte', wind: 'Wind', uv: 'UV', sunset: 'Sonnenuntergang' },
  es: { humidity: 'Humedad', wind: 'Viento', uv: 'UV', sunset: 'Atardecer' },
  nl: { humidity: 'Vochtigheid', wind: 'Wind', uv: 'UV', sunset: 'Zonsondergang' },
  sv: { humidity: 'Luftfuktighet', wind: 'Vind', uv: 'UV', sunset: 'SolnedgÃ¥ng' }
};

const ml = climateMetricLabels[currentLang] ?? climateMetricLabels.en;

const liveClimate = {
  heroTemp: Number.isFinite(weatherSnapshot.temperature)
    ? `${Math.round(weatherSnapshot.temperature)}Â°`
    : 'â€”',
  metricHumidity: `${ml.humidity} Â· ${weatherSnapshot.humidity}%`,
  metricWind: `${ml.wind} Â· ${weatherSnapshot.wind}`,
  metricUv: `${ml.uv} Â· ${weatherSnapshot.uv}`,
  metricSunset: `${ml.sunset} Â· ${weatherSnapshot.sunset}`
};

const heroImage = {
  src: '/images/amara-lounis/15-amara-frigiliana.jpg',
  alt: 'Frigiliana hillside homes in afternoon light',
  width: 1920,
  height: 1282,
  sizes: '(max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) 60vw, 40vw'
};

const sectionNavItems = getFrigilianaAuthoritySubnav(currentLang);
---

<LocationAuthorityLayout seo={seo} pageLang={currentLang}>
  <Navigation
    currentLang={currentLang}
    brandName={c.nav.brand}
    links={c.nav.links}
    languageToken="location_frigiliana"
    locationAuthorityNav={true}
  />
  <SectionAnchorNav items={sectionNavItems} activeId="intro" />
  <div class="am-root" data-am-page="frigiliana-location">
    <div class="am-wrap w-full">
  <div id="intro">
  <Hero imageSrc={heroImage.src} imageAlt={heroImage.alt} imageWidth={heroImage.width} imageHeight={heroImage.height} imageSizes={heroImage.sizes}>
    <span class="am-text-caption text-primary mb-8 block">{c.hero.eyebrow}</span>
    <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter" set:html={c.hero.h1} />
    <div class="pl-10 border-l border-primary/20 max-w-lg mb-14">
      <p class="am-text-body text-on-surface-variant leading-relaxed">{c.hero.body}</p>
      <p class="am-text-body text-on-surface-variant leading-relaxed mt-6">
        {c.hero.introLeadBefore}
        <a href={parkingHref} class="am-inline-link">{c.hero.introLeadLinkLabel}</a>
        {c.hero.introLeadAfter}
      </p>
    </div>
    <div class="flex flex-wrap gap-8">
      <span class="am-link-disabled bg-primary text-on-primary px-12 py-5 am-text-caption uppercase tracking-[0.2em] transition-all">{c.hero.ctaMain}</span>
      <a href={arrivalGuideHref} class="border border-outline-variant/30 text-on-surface px-12 py-5 am-text-caption uppercase tracking-[0.2em] hover:bg-surface-container-low transition-all">{c.hero.ctaAlt}</a>
    </div>
  </Hero>
  </div>
  <section id="photo" class="am-section am-section--plain w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
    <PhotoShow eyebrow={c.gallery.eyebrow} title={c.gallery.title} images={c.gallery.images} />
  </section>
  <section id="key-facts" class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
    <EssenceGrid eyebrow={c.essence.eyebrow} title={c.essence.title} intro={c.essence.intro} items={c.essence.items} />
  </section>
  <section id="weather-climate" class="am-section am-section--plain">
    <ClimateExperienceSection
      eyebrowCurrent={c.climate.eyebrowCurrent}
      heroTemperature={liveClimate.heroTemp}
      heroTagline={c.climate.heroTagline}
      headline={c.climate.headline}
      body={c.climate.body}
      metricHumidity={liveClimate.metricHumidity}
      metricWind={liveClimate.metricWind}
      metricUv={liveClimate.metricUv}
      metricSunset={liveClimate.metricSunset}
      factSunDays={c.climate.factSunDays}
      factCoolerVsCoast={c.climate.factCoolerVsCoast}
      ctaLabel={c.climate.cta}
      ctaHref={weatherHref}
    />
  </section>
  <section id="comparison" class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
    <LocationEditorialComparison
      eyebrow={c.comparison.eyebrow}
      title={c.comparison.title}
      intro={c.comparison.intro}
      items={c.comparison.items}
      imagePrimary={c.comparison.imagePrimary}
      imageSecondary={c.comparison.imageSecondary}
    />
  </section>
  <div id="experiences">
  <VillageStructureInsight
    eyebrow={c.villageStructure.eyebrow}
    headline={c.villageStructure.headline}
    supporting={c.villageStructure.supporting}
    signal={c.villageStructure.signal}
    ctaLabel={c.villageStructure.cta}
    ctaHref={arrivalGuideHref}
    imageSrc={c.villageStructure.imageSrc}
    imageAlt={c.villageStructure.imageAlt}
  />
  </div>
  <section id="where-to-stay" class="am-section am-section--plain w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
    <StayDecision eyebrow={c.decision.eyebrow} title={c.decision.title} profiles={c.decision.profiles} />
  </section>
  <section class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
    <FaqAccordion
      arrivalTitle={c.faq.arrivalTitle}
      steps={c.faq.steps}
      faqTitle={c.faq.faqTitle}
      items={c.faq.items}
      anchorArrivalId="arrival"
      anchorFaqId="faq"
      arrivalDetailCta={c.faq.arrivalDetailCta}
      allFaqsCta={c.faq.allFaqsCta}
    />
  </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  .am-link-disabled {
    pointer-events: none;
    cursor: default;
    opacity: 0.6;
  }

  /**
   * Two-tone shell (surface + surface-container-low only): child sections use band color from parent.
   * Components keep their own layout; backgrounds are not edited in component files.
   */
  .am-section--plain > :global(section),
  .am-section--tint > :global(section) {
    background-color: transparent !important;
  }

  /** PhotoShow: shell + slide wells use approved tokens only */
  .am-section--plain :global(amara-photoshow) {
    background-color: var(--color-surface) !important;
  }

  .am-section--plain :global(amara-photoshow .bg-surface-container) {
    background-color: var(--color-surface-container-low) !important;
  }

  /** EssenceGrid: replace disallowed container greys with surface or tint token */
  .am-section--tint :global(.bg-surface-container) {
    background-color: var(--color-surface) !important;
  }
</style>
