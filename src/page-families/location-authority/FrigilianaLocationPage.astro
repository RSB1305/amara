---
import AmaraImage from '../../components/AmaraImage.astro';
import FrigilianaOrientationMap from '../../components/location/FrigilianaOrientationMap.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import LocationHubHero from '../../components/location/LocationHubHero.astro';
import Navigation from '../../components/Navigation.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import decisionImage from '../../assets/images/content/amara-lounis/15-amara-frigiliana.jpg';
import {
  frigilianaLocationHeroImageAlt,
  frigilianaLocationSeo,
  getFrigilianaLocationCopy
} from '../../content/frigilianaLocationContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink, type LinkToken } from '../../lib/linkResolver';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import LocationModule from './LocationModule.astro';
import LocationStaySplitSection from './LocationStaySplitSection.astro';

interface Props {
  lang?: string;
}

type EditorialImageAlt = {
  evening: string;
  heritage: string;
  oldTown: string;
  hiking: string;
  beaches: string;
  decision: string;
};

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const c = getFrigilianaLocationCopy(currentLang);
const optionalLink = (token: LinkToken) =>
  resolveOptionalLink(token, currentLang, { suppressMissing: true });

const aboutHref = optionalLink('about');
const romanticHideawaysHref = optionalLink('romantic_hideaways');
const geographyHref = optionalLink('frigiliana_geography');
const oldTownHref = optionalLink('frigiliana_old_town');
const stairsHref = optionalLink('frigiliana_stairs');
const dailyLifeHref = optionalLink('frigiliana_daily_life');
const gettingThereHref = buildOwnedLocalizedPath('getting-to-frigiliana', currentLang);
const parkingHref = buildOwnedLocalizedPath('frigiliana-parking', currentLang);

const experienceTokenById = {
  'old-town': 'frigiliana_old_town',
  hiking: 'frigiliana_hiking_authority',
  beaches: 'frigiliana_beaches_authority',
  all: 'frigiliana_experience_hub'
} as const satisfies Record<(typeof c.exploreBridge.links)[number]['id'], LinkToken>;

const experienceImageById = {
  'old-town':
    '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/08-frigiliana-pueblo.jpg',
  hiking: '/images/hero-frigiliana.jpg',
  beaches: '/images/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg'
} as const;

const experienceLinks = c.exploreBridge.links
  .map((link) => ({ ...link, href: optionalLink(experienceTokenById[link.id]) }))
  .filter((link): link is typeof link & { href: string } => Boolean(link.href));
const featuredExperiences = experienceLinks
  .filter((link) => link.id !== 'all')
  .map((link) => ({
    ...link,
    image: experienceImageById[link.id as keyof typeof experienceImageById]
  }));
const allExperiencesLink = experienceLinks.find((link) => link.id === 'all');

const villageLinks = [
  { href: stairsHref, ...c.planning.stairs },
  { href: dailyLifeHref, ...c.planning.dailyLife },
  { href: gettingThereHref, ...c.planning.gettingThere },
  { href: parkingHref, ...c.planning.parking }
].filter((item): item is { href: string; label: string; text: string } => Boolean(item.href));

const footerHighlights: LabeledLink[] = [
  { token: 'frigiliana_daily_life', label: c.planning.dailyLife.label },
  { token: 'frigiliana_stairs', label: c.planning.stairs.label },
  {
    token: 'frigiliana_experience_hub',
    label: allExperiencesLink?.label ?? c.exploreBridge.title
  },
  {
    token: 'romantic_hideaways',
    label: c.decision.subsections[0].ctas.find((cta) => cta.token === 'FRIGILIANA_STAYS')?.label
      ?? c.decision.subsections[0].title
  }
];

const editorialImageAlt: Record<AmaraLanguage, EditorialImageAlt> = {
  en: {
    evening: 'A quiet lane in Frigiliana in warm evening light',
    heritage: 'A stepped lane between white village houses in Frigiliana',
    oldTown: 'White houses and flower pots along a lane in Frigiliana old village',
    hiking: 'Frigiliana lanes with the mountain landscape beyond',
    beaches: 'Nerja and its small beaches seen from above',
    decision: 'Casa AMARA terrace and old well in Frigiliana'
  },
  de: {
    evening: 'Eine ruhige Gasse in Frigiliana im warmen Abendlicht',
    heritage: 'Eine ansteigende Gasse zwischen weißen Dorfhäusern in Frigiliana',
    oldTown: 'Weiße Häuser und Blumentöpfe in einer Gasse der Altstadt von Frigiliana',
    hiking: 'Gassen von Frigiliana mit der Berglandschaft dahinter',
    beaches: 'Nerja und seine kleinen Strände aus der Luft',
    decision: 'Terrasse und alter Brunnen der Casa AMARA in Frigiliana'
  },
  es: {
    evening: 'Una calle tranquila de Frigiliana con la luz cálida del atardecer',
    heritage: 'Una calle escalonada entre casas blancas de Frigiliana',
    oldTown: 'Casas blancas y macetas en una calle del casco antiguo de Frigiliana',
    hiking: 'Calles de Frigiliana con el paisaje de montaña al fondo',
    beaches: 'Nerja y sus pequeñas playas vistas desde el aire',
    decision: 'Terraza y antiguo pozo de Casa AMARA en Frigiliana'
  },
  nl: {
    evening: 'Een rustig straatje in Frigiliana in warm avondlicht',
    heritage: 'Een oplopend straatje tussen witte dorpshuizen in Frigiliana',
    oldTown: 'Witte huizen en bloempotten in een straatje van de oude kern van Frigiliana',
    hiking: 'Straatjes van Frigiliana met het berglandschap erachter',
    beaches: 'Nerja en zijn kleine stranden vanuit de lucht',
    decision: 'Terras en oude waterput van Casa AMARA in Frigiliana'
  },
  sv: {
    evening: 'En lugn gränd i Frigiliana i varmt kvällsljus',
    heritage: 'En trappgränd mellan vita byhus i Frigiliana',
    oldTown: 'Vita hus och blomkrukor i en gränd i Frigilianas gamla by',
    hiking: 'Frigilianas gränder med bergslandskapet bakom',
    beaches: 'Nerja och de små stränderna sedda från luften',
    decision: 'Terrass och gammal brunn på Casa AMARA i Frigiliana'
  }
};

const imageAlt = editorialImageAlt[currentLang];
const experienceAltById = {
  'old-town': imageAlt.oldTown,
  hiking: imageAlt.hiking,
  beaches: imageAlt.beaches
} as const;

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/04-frigiliana-pueblo.jpg',
  alt: frigilianaLocationHeroImageAlt[currentLang],
  width: 2000,
  sizes: '(max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) 60vw, 35vw'
};

const editorialImages = {
  evening:
    '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/06-frigiliana-pueblo.jpg',
  heritage:
    '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/07-frigiliana-pueblo.jpg'
} as const;

const decisionStay = c.decision.subsections[0];
const decisionStaysCta = decisionStay.ctas.find((cta) => cta.token === 'FRIGILIANA_STAYS');
const exactCasaAccess = c.faq.items.find((item) => item.id === 'steepness')?.answer;
const casaFacts = [
  c.villageLife.paragraphs[0],
  exactCasaAccess,
  c.decision.facts.find((fact) => fact.id === 'parking')?.value
].filter((fact): fact is string => Boolean(fact));
---

<LocationAuthorityLayout
  pageFamily="location-frigiliana-overview"
  seo={frigilianaLocationSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  showContextNavigation={false}
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="location_frigiliana"
  >
    <LocationContextNav slot="context-navigation" activeId="intro" lang={currentLang} />
  </Navigation>

  <div class="overflow-x-hidden">
    <main
      data-am-page="frigiliana-location"
      data-am-family="location"
      data-am-role="hub"
      data-am-presentation="editorial"
    >
      <div id="intro" class="frigiliana-hero">
        <LocationHubHero
          eyebrow={c.heroKicker}
          title={c.h1}
          subtitle={c.h1Subtitle}
          paragraphs={c.intro}
          accent={c.introPullLine}
          imageSrc={heroImage.src}
          imageAlt={heroImage.alt}
          imageWidth={heroImage.width}
          imageSizes={heroImage.sizes}
          byline={frigilianaLocationSeo.article && aboutHref ? {
            lang: currentLang,
            authorName: frigilianaLocationSeo.article.authorName,
            authorHref: aboutHref,
            updated: c.heroUpdated,
            note: c.heroNote
          } : undefined}
        />
      </div>

      <section id="overnight" class="am-section am-section--plain py-24 md:py-32 lg:py-40">
        <div class="mx-auto grid max-w-screen-2xl items-center gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <h2 class="am-text-title italic tracking-tight text-on-surface">
              {c.evening.title}
            </h2>
            <div class="mt-9 space-y-6">
              {
                c.evening.paragraphs.map((paragraph, index) => (
                  <p class:list={[
                    'leading-relaxed',
                    index === 1
                      ? 'am-text-subtitle italic text-on-surface'
                      : 'am-text-body text-on-surface-variant'
                  ]}>
                    <InlineEmphasis text={paragraph} />
                  </p>
                ))
              }
            </div>
          </div>
          <div class="am-mobile-full-bleed overflow-hidden bg-surface-container-low lg:col-span-7">
            <AmaraImage
              src={editorialImages.evening}
              alt={imageAlt.evening}
              profile="gallery"
              sizes="(max-width: 1023px) 100vw, 55vw"
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <LocationModule
        id="village-character"
        surface="inverse"
        spacing="closing"
        class="lg:py-40"
        data-am-location-story="heritage"
      >
        <div class="mx-auto max-w-screen-2xl">
          <div class="grid min-w-0 items-center gap-14 lg:grid-cols-12 lg:gap-20">
            <div class="min-w-0 lg:col-span-6">
              <p class="am-text-eyebrow text-primary-fixed-dim">{c.planning.oldTown.label}</p>
              <h2 class="am-text-title mt-6 text-balance text-inverted-on-surface">
                {c.history.title}
              </h2>
              <div class="mt-9 space-y-6">
                {c.history.paragraphs.map((paragraph, index) => (
                  <p class:list={[
                    'am-text-body leading-relaxed',
                    index === 0
                      ? 'text-inverted-on-surface/90'
                      : 'text-inverted-on-surface/75'
                  ]}>
                    <InlineEmphasis text={paragraph} />
                  </p>
                ))}
              </div>

              {c.history.subsections.map((section) => (
                <div class="mt-10 max-w-2xl">
                  <h3 class="am-text-subtitle text-primary-fixed-dim">{section.title}</h3>
                  {section.paragraphs.map((paragraph) => (
                    <p class="am-text-body mt-4 leading-relaxed text-inverted-on-surface/75">
                      <InlineEmphasis text={paragraph} />
                    </p>
                  ))}
                </div>
              ))}

              {oldTownHref && (
                <a href={oldTownHref} class="am-btn am-btn--inverse am-btn--secondary mt-10">
                  {c.heritageLinkLabel}
                </a>
              )}
            </div>

            <div class="min-w-0 overflow-hidden bg-inverse-surface lg:col-span-5 lg:col-start-8">
              <AmaraImage
                src={editorialImages.heritage}
                alt={imageAlt.heritage}
                profile="gallery"
                sizes="(max-width: 1023px) 100vw, 40vw"
                class="aspect-[4/5] w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <dl class="mt-16 grid gap-9 border-t border-inverted-on-surface/20 pt-9 md:grid-cols-3 lg:mt-24">
            {c.heritageFacts.map((fact) => (
              <div>
                <dt class="am-text-label am-text-label--sm text-primary-fixed-dim">{fact.value}</dt>
                <dd class="am-text-body mt-3 max-w-sm leading-relaxed text-inverted-on-surface/70">
                  {fact.label}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </LocationModule>

      <section id="between-mountains-and-sea" class="am-section am-section--tint py-24 md:py-32 lg:py-40">
        <div class="mx-auto grid max-w-screen-2xl items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:order-1 lg:col-span-7" data-am-orientation-map="frigiliana">
            <FrigilianaOrientationMap
              label={c.orientation.mapLabel}
              note={c.orientation.mapNote}
              lang={currentLang}
            />
          </div>
          <div class="lg:order-2 lg:col-span-4 lg:col-start-9">
            <p class="am-text-eyebrow text-primary">{c.orientation.eyebrow}</p>
            <h2 class="am-text-title mt-6 italic tracking-tight text-on-surface">
              {c.orientation.title}
            </h2>
            <div class="mt-9 space-y-6">
              {c.orientation.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={paragraph} />
                </p>
              ))}
            </div>
            <div class="mt-10">
              <h3 class="am-text-subtitle italic text-on-surface">{c.coast.title}</h3>
              {c.coast.paragraphs.map((paragraph) => (
                <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={paragraph} />
                </p>
              ))}
            </div>
            <div class="mt-9 flex flex-wrap gap-x-8 gap-y-4">
              {geographyHref && (
                <a href={geographyHref} class="am-cta-link">{c.orientation.geographyLabel}</a>
              )}
              {gettingThereHref && (
                <a href={gettingThereHref} class="am-cta-link">{c.orientation.arrivalLabel}</a>
              )}
            </div>
          </div>
        </div>
      </section>

      <section id="experiences" class="am-section am-section--plain py-24 md:py-32 lg:py-40">
        <div class="mx-auto max-w-screen-2xl">
          <div class="max-w-4xl">
            <p class="am-text-eyebrow text-primary">{c.exploreBridge.eyebrow}</p>
            <h2 class="am-text-title mt-6 italic tracking-tight text-on-surface">
              {c.exploreBridge.title}
            </h2>
            <p class="am-text-subtitle mt-8 max-w-3xl leading-relaxed text-on-surface-variant">
              {c.exploreBridge.text}
            </p>
          </div>

          <div class="mt-16 grid gap-12 md:grid-cols-3 lg:mt-20 lg:gap-10">
            {
              featuredExperiences.map((experience) => (
                <a href={experience.href} class="group block">
                  <div class="overflow-hidden bg-surface-container-low">
                    <AmaraImage
                      src={experience.image}
                      alt={experienceAltById[experience.id as keyof typeof experienceAltById]}
                      profile="gallery"
                      sizes="(max-width: 767px) 100vw, 33vw"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <h3 class="am-text-subtitle mt-7 text-on-surface">{experience.label}</h3>
                  <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">
                    {experience.text}
                  </p>
                  <span class="am-cta-link mt-6 inline-flex" aria-hidden="true">→</span>
                </a>
              ))
            }
          </div>

          {
            allExperiencesLink && (
              <a
                href={`${allExperiencesLink.href}#experiences`}
                class="am-btn am-btn--secondary mt-14"
              >
                {allExperiencesLink.label}
              </a>
            )
          }
        </div>
      </section>

      <section id="closer-to-the-village" class="am-section am-section--tint py-24 md:py-32 lg:py-40">
        <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="am-text-eyebrow text-primary">{c.planning.eyebrow}</p>
            <h2 class="am-text-title mt-6 italic tracking-tight text-on-surface">
              {c.planning.title}
            </h2>
            <p class="am-text-subtitle mt-8 leading-relaxed text-on-surface-variant">
              {c.planning.intro}
            </p>
          </div>
          <div class="space-y-9 lg:col-span-6 lg:col-start-7">
            {
              villageLinks.map((link) => (
                <a href={link.href} class="group block border-t border-outline-variant/25 pt-7">
                  <h3 class="am-text-subtitle text-on-surface group-hover:text-primary">
                    {link.label}
                  </h3>
                  <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">
                    {link.text}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <div id="stay-at-amara">
        <LocationStaySplitSection
          imageSrc={decisionImage}
          imageAlt={imageAlt.decision}
          eyebrow={c.decision.eyebrow}
          title={decisionStay.title}
          paragraphs={[...c.decision.paragraphs, ...decisionStay.paragraphs]}
          facts={casaFacts}
          link={decisionStaysCta && romanticHideawaysHref
            ? { href: romanticHideawaysHref, label: decisionStaysCta.label }
            : undefined}
        />
      </div>
    </main>
  </div>
</LocationAuthorityLayout>

<style>
  .frigiliana-hero :global([data-am-guide-hero] > div > .am-mobile-full-bleed) {
    align-self: stretch;
  }

  .frigiliana-hero :global([data-am-guide-hero] > div > .am-mobile-full-bleed img) {
    aspect-ratio: auto;
  }
</style>
