---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} showContextNavigation={false} bodyBackgroundClass="bg-white">
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    brandName="Nerja"
    languageToken="nerja_weather"
    locationAuthorityNav={true}
  />

  <NerjaContextNav activeId="weather-seasons" childLabel={t(copy.header.h1)} lang={currentLang} />

  <div data-am-page="nerja-weather">
    <div class="w-full max-w-screen-2xl mx-auto px-12 pt-20 pb-20">
      <header class="mb-20 border-b border-black/10 pb-12">
        <span class="am-text-caption text-primary mb-4 block">{t(copy.header.eyebrow)}</span>
        <h1 class="am-text-display italic text-on-surface mb-6">{t(copy.header.h1)}</h1>
        <p class="am-text-body text-on-surface-variant italic opacity-70 max-w-2xl">{t(copy.header.lead)}</p>
      </header>

      <div class="pt-8 space-y-20">
        <section class="grid gap-10 lg:grid-cols-12 items-start">
          <div class="lg:col-span-8 space-y-6">
            <h2 class="am-text-title italic text-on-surface">{t(copy.glance.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
              {t(copy.glance.intro)}
            </p>
          </div>
          <div class="lg:col-span-4 space-y-4">
            <HairlineStatCard
              label={t(copy.glance.stats.sea.label)}
              value={t(copy.glance.stats.sea.value)}
              description={t(copy.glance.stats.sea.note)}
            />
            <HairlineStatCard
              label={t(copy.glance.stats.dry.label)}
              value={t(copy.glance.stats.dry.value)}
              description={t(copy.glance.stats.dry.note)}
            />
            <HairlineStatCard
              label={t(copy.glance.stats.rain.label)}
              value={t(copy.glance.stats.rain.value)}
              description={t(copy.glance.stats.rain.note)}
            />
          </div>
        </section>

        <section>
          <div class="mb-12 max-w-2xl">
            <h2 class="am-text-title text-on-surface mb-4">{t(copy.pattern.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">{t(copy.pattern.body)}</p>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-16">
            {patternFacts.map((item) => (
              <div>
                <div class="h-px w-10 bg-outline-variant/25"></div>
                <div class="mt-4 am-text-caption uppercase tracking-[0.18em] text-on-surface-variant/70">
                  {item.label}
                </div>
                <div class="mt-2 am-text-subtitle tracking-tight text-on-surface">{item.value}</div>
                <p class="mt-3 am-text-body leading-relaxed text-on-surface-variant/80 max-w-[44ch]">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="mb-12 max-w-2xl">
            <h2 class="am-text-title text-on-surface mb-4">{t(copy.seasons.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">{t(copy.seasons.intro)}</p>
          </div>

          <div class="grid gap-10 md:grid-cols-2 xl:grid-cols-4">
            <SeasonalPillar
              eyebrow={t(seasonLabels.spring.eyebrow)}
              title={t(seasonLabels.spring.title)}
              subtitle={t(seasonLabels.spring.subtitle)}
              highTemp="21°C"
              lowTemp="12°C"
              vibe={t(seasonLabels.spring.vibe)}
              hint={t(seasonLabels.spring.hint)}
            />
            <SeasonalPillar
              eyebrow={t(seasonLabels.summer.eyebrow)}
              title={t(seasonLabels.summer.title)}
              subtitle={t(seasonLabels.summer.subtitle)}
              highTemp="28°C"
              lowTemp="21°C"
              vibe={t(seasonLabels.summer.vibe)}
              hint={t(seasonLabels.summer.hint)}
            />
            <SeasonalPillar
              eyebrow={t(seasonLabels.autumn.eyebrow)}
              title={t(seasonLabels.autumn.title)}
              subtitle={t(seasonLabels.autumn.subtitle)}
              highTemp="24°C"
              lowTemp="16°C"
              vibe={t(seasonLabels.autumn.vibe)}
              hint={t(seasonLabels.autumn.hint)}
              isHighlighted={true}
            />
            <SeasonalPillar
              eyebrow={t(seasonLabels.winter.eyebrow)}
              title={t(seasonLabels.winter.title)}
              subtitle={t(seasonLabels.winter.subtitle)}
              highTemp="17°C"
              lowTemp="10°C"
              vibe={t(seasonLabels.winter.vibe)}
              hint={t(seasonLabels.winter.hint)}
            />
          </div>
        </section>

        <section data-am-compare="nerja-frigiliana">
          <div class="mb-12 max-w-2xl">
            <h2 class="am-text-title text-on-surface mb-4">{t(copy.compare.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">{t(copy.compare.body)}</p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full min-w-[34rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-outline-variant/25">
                  <th scope="col" class="py-4 pr-6 am-text-caption uppercase tracking-[0.18em] text-on-surface-variant/70">
                    <span class="sr-only">{t(copy.compare.title)}</span>
                  </th>
                  <th scope="col" class="py-4 pr-6 am-text-caption uppercase tracking-[0.18em] text-primary">
                    {t(copy.compare.headings.nerja)}
                  </th>
                  <th scope="col" class="py-4 am-text-caption uppercase tracking-[0.18em] text-on-surface-variant/70">
                    {t(copy.compare.headings.frigiliana)}
                  </th>
                </tr>
              </thead>
              <tbody>
                {compareRows.map((row) => (
                  <tr class="border-b border-outline-variant/15">
                    <th scope="row" class="py-5 pr-6 am-text-body font-normal text-on-surface-variant">{row.metric}</th>
                    <td class="py-5 pr-6 am-text-subtitle tracking-tight text-on-surface">{row.nerja}</td>
                    <td class="py-5 am-text-subtitle tracking-tight text-on-surface-variant/80">{row.frigiliana}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-10 max-w-3xl border-l-2 border-primary/35 py-2 pl-6 am-text-body leading-relaxed text-on-surface">
            {t(copy.compare.verdict)}
          </p>
        </section>

        <section class="rounded-editorial border border-outline-variant/10 bg-surface px-10 py-10">
          <h2 class="am-text-title italic text-on-surface">{t(copy.notice.title)}</h2>
          <p class="mt-6 am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
            {t(copy.notice.body)}
          </p>
        </section>

        <section class="space-y-6">
          <h2 class="am-text-title italic text-on-surface">{t(copy.interpretation.title)}</h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
            {t(copy.interpretation.body)}
          </p>
        </section>
      </div>
    </div>

    <EditorialGuideLinkSection
      eyebrow={t(copy.related.eyebrow)}
      title={t(copy.related.title)}
      intro={t(copy.related.intro)}
      links={relatedLinks}
    />

    <section class="max-w-screen-2xl mx-auto px-12 pt-8">
      <EditorialClosingCta
        title={t(copy.closing.title)}
        lead={t(copy.closing.lead)}
        lang={currentLang}
        links={[
          { token: 'playa', label: t(copy.header.cta), style: 'primary' },
          { token: 'book', label: t(copy.closing.availabilityCta), style: 'secondary' }
        ]}
      />
    </section>
  </div>
</LocationAuthorityLayout>
