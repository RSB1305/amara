const t = <T extends Record<AmaraLanguage, string>>(row: T) => row[currentLang] ?? row.en;

const patternFacts = copy.pattern.facts[currentLang] ?? copy.pattern.facts.en;

const relatedLinks = [
  { href: geographyHref, label: t(copy.related.links.geography.label), text: t(copy.related.links.geography.text) },
  { href: whereToStayHref, label: t(copy.related.links.stay.label), text: t(copy.related.links.stay.text) },
  { href: arrivalHref, label: t(copy.related.links.arrival.label), text: t(copy.related.links.arrival.text) },
  { href: locationHref, label: t(copy.related.links.location.label), text: t(copy.related.links.location.text) }
];

