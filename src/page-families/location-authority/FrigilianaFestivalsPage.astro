---
import Hero from '../../components/Hero.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialFeatureGrid from '../../components/editorial/EditorialFeatureGrid.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import ExperiencePreFooter from '../../components/experience/ExperiencePreFooter.astro';
import {
  frigilianaFestivalsContent,
  frigilianaFestivalsSeo
} from '../../content/frigilianaFestivalsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaFestivalsContent[currentLang];

const footerHighlights = [
  {
    token: 'frigiliana_events_authority',
    label: copy.footerHighlights.festivals
  },
  {
    token: 'frigiliana_food_authority',
    label: copy.footerHighlights.restaurants
  },
  {
    token: 'frigiliana_beaches_authority',
    label: copy.footerHighlights.beaches
  }
];

const combineItems = copy.combine.items.map((item) => ({
  ...item,
  href: resolveOptionalLink(item.linkToken, currentLang, {
    suppressMissing: true
  })
}));

const heroImage = {
  src: '/images/hero-frigiliana.jpg',
  width: 1080,
  height: 721
};
---

<LocationAuthorityLayout
  seo={frigilianaFestivalsSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
>
  <Navigation
    currentLang={currentLang}
    brandName="Frigiliana"
    languageToken="frigiliana_events_authority"
    locationAuthorityNav={true}
  />
  <ExperienceContextNav currentId="festivals" lang={currentLang} />

  <div class="am-root" data-am-page="frigiliana-festivals">
    <div class="am-wrap w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {copy.hero.kicker}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {copy.hero.title}
        </h1>
        <div class="pl-10 border-l border-primary/20 max-w-xl space-y-6">
          {
            copy.hero.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant leading-relaxed">
                {paragraph}
              </p>
            ))
          }
        </div>
      </Hero>

      <section
        id="choose"
        class="am-section am-section--tint !px-6 md:!px-12"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.overview.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.overview.intro}
          </p>
          <p class="mt-6 am-text-caption normal-case tracking-normal text-on-surface-variant">
            {copy.overview.reviewed}
          </p>
        </div>

        <EditorialFeatureGrid
          cards={copy.overview.items.map((item) => ({
            title: item.title,
            copy: item.text
          }))}
        />
      </section>

      <section
        id="calendar"
        class="am-section am-section--plain !px-6 md:!px-12"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.calendar.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.calendar.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-16">
          {
            copy.calendar.seasons.map((season) => (
              <section
                class="border-t border-outline-variant/25 pt-8"
                aria-labelledby={`season-${season.id}`}
              >
                <h3
                  id={`season-${season.id}`}
                  class="am-text-subtitle text-on-surface mb-3"
                >
                  {season.title}
                </h3>
                <p class="am-text-body text-on-surface-variant leading-relaxed mb-8">
                  {season.intro}
                </p>

                <div class="space-y-9">
                  {season.events.map((event) => (
                    <article>
                      <h4 class="am-text-body font-bold text-on-surface mb-3">
                        {event.name}
                      </h4>
                      <dl class="flex flex-wrap gap-x-3 gap-y-2 mb-4">
                        <div class="rounded-pill border border-outline-variant/30 bg-surface-container-lowest px-3 py-1 am-text-caption normal-case tracking-normal text-on-surface-variant">
                          <dt class="sr-only">{copy.cardLabels.timing}</dt>
                          <dd>{event.timing}</dd>
                        </div>
                        <div class="rounded-pill border border-outline-variant/30 bg-surface-container-lowest px-3 py-1 am-text-caption normal-case tracking-normal text-on-surface-variant">
                          <dt class="sr-only">{copy.cardLabels.place}</dt>
                          <dd>{event.place}</dd>
                        </div>
                        <div class="rounded-pill border border-primary/20 bg-surface-container-low px-3 py-1 am-text-caption normal-case tracking-normal text-primary">
                          <dt class="sr-only">{copy.cardLabels.dateStatus}</dt>
                          <dd>{event.dateStatus}</dd>
                        </div>
                      </dl>
                      <p class="am-text-body text-on-surface-variant leading-relaxed">
                        {event.summary}
                      </p>
                      {event.officialHref && (
                        <p class="mt-4 am-text-body">
                          <a
                            href={event.officialHref}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="am-inline-link"
                          >
                            {copy.cardLabels.officialInformation}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        </p>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </section>

      <section
        id="experiences"
        class="am-section am-section--tint !px-6 md:!px-12"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.experiences.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.experiences.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-16">
          {
            copy.experiences.items.map((experience) => (
              <article class="border-t border-outline-variant/25 pt-8 flex h-full flex-col">
                <h3 class="am-text-subtitle text-on-surface mb-5">
                  {experience.title}
                </h3>
                <dl class="flex flex-wrap gap-x-3 gap-y-2 mb-6">
                  <div class="rounded-pill border border-outline-variant/30 bg-surface-container-lowest px-3 py-1 am-text-caption normal-case tracking-normal text-on-surface-variant">
                    <dt class="sr-only">{copy.cardLabels.timing}</dt>
                    <dd>{experience.timing}</dd>
                  </div>
                  <div class="rounded-pill border border-outline-variant/30 bg-surface-container-lowest px-3 py-1 am-text-caption normal-case tracking-normal text-on-surface-variant">
                    <dt class="sr-only">{copy.cardLabels.place}</dt>
                    <dd>{experience.place}</dd>
                  </div>
                  <div class="rounded-pill border border-primary/20 bg-surface-container-low px-3 py-1 am-text-caption normal-case tracking-normal text-primary">
                    <dt class="sr-only">{copy.cardLabels.dateStatus}</dt>
                    <dd>{experience.dateStatus}</dd>
                  </div>
                </dl>

                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {experience.description}
                </p>

                <p class="mt-6 border-l border-primary/20 bg-surface-container-low px-4 py-3 am-text-body leading-relaxed text-on-surface-variant">
                  <span class="font-bold text-primary">
                    {copy.cardLabels.amaraNote}:
                  </span>{' '}
                  {experience.planningNote}
                </p>

                {experience.officialHref && (
                  <p class="mt-5 lg:mt-auto lg:pt-5 am-text-body">
                    <a
                      href={experience.officialHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="am-inline-link"
                    >
                      {copy.cardLabels.officialInformation}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section
        id="planning"
        class="am-section am-section--plain !px-6 md:!px-12"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.planning.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.planning.intro}
          </p>
        </div>

        <EditorialFeatureGrid
          cards={copy.planning.items.map((item) => ({
            title: item.title,
            copy: item.text
          }))}
        />

        <p class="mt-12 border-l border-primary/20 bg-surface-container-low px-4 py-3 am-text-body leading-relaxed text-on-surface-variant max-w-3xl">
          {copy.planning.note}
        </p>
      </section>

      <section class="am-section am-section--tint !px-6 md:!px-12">
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.combine.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.combine.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14">
          {
            combineItems.map((item) => (
              <article class="border-t border-outline-variant/25 pt-8">
                <h3 class="am-text-subtitle text-on-surface mb-5">
                  {item.title}
                </h3>
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {item.text}
                </p>
                {item.href && (
                  <p class="mt-5 am-text-body">
                    <a href={item.href} class="am-inline-link">
                      {item.linkLabel}
                      <span aria-hidden="true"> →</span>
                    </a>
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <ExperiencePreFooter currentId="festivals" lang={currentLang} />

      <section class="max-w-screen-2xl mx-auto px-6 pt-24 md:px-12">
        <EditorialClosingCta
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.apartmentsCta,
              style: 'primary'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>
