---
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import EssenceGrid from '../../components/EssenceGrid.astro';
import PhotoShow from '../../components/PhotoShow.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import {
  nerjaLocationCopy,
  nerjaLocationSeo
} from '../../content/nerjaLocationContent';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const seo = nerjaLocationSeo;
const copy = nerjaLocationCopy;
function t<T>(value: Readonly<Record<AmaraLanguage, T>>): T {
  return value[currentLang];
}
const optionalLink = (token: string) =>
  resolveOptionalLink(token, currentLang, { suppressMissing: true });

const playaHref = optionalLink('playa') ?? '#amara-playa';
const comparisonHref = optionalLink('nerja_vs_frigiliana') ?? '#nerja-frigiliana';
const beachesHref = optionalLink('frigiliana_beaches_authority');

const c = {
  nav: {
    brand: t(copy.nav.brand)
  },
  hero: {
    eyebrow: t(copy.hero.eyebrow),
    h1: t(copy.hero.h1),
    body: t(copy.hero.body),
    ctaMain: t(copy.hero.ctaMain),
    ctaAlt: t(copy.hero.ctaAlt),
    imageAlt: t(copy.hero.imageAlt)
  },
  essence: {
    eyebrow: t(copy.essence.eyebrow),
    title: t(copy.essence.title),
    intro: t(copy.essence.intro),
    items: copy.essence.items.map((item) => ({
      kicker: t(item.kicker),
      headline: t(item.headline),
      text: t(item.text),
      imageSrc: 'imageSrc' in item ? item.imageSrc : undefined,
      imageAlt: 'imageSrc' in item ? t(copy.hero.imageAlt) : undefined
    }))
  },
  areas: {
    eyebrow: t(copy.areas.eyebrow),
    title: t(copy.areas.title),
    intro: t(copy.areas.intro),
    labels: {
      everyday: t(copy.areas.labels.everyday),
      benefit: t(copy.areas.labels.benefit),
      tradeoff: t(copy.areas.labels.tradeoff),
      suits: t(copy.areas.labels.suits)
    },
    items: copy.areas.items[currentLang]
  },
  beaches: {
    eyebrow: t(copy.beaches.eyebrow),
    title: t(copy.beaches.title),
    intro: t(copy.beaches.intro),
    items: copy.beaches.items.map((item) => ({
      title: t(item.title),
      text: t(item.text)
    })),
    cta: t(copy.beaches.cta)
  },
  practical: {
    eyebrow: t(copy.practical.eyebrow),
    title: t(copy.practical.title),
    intro: t(copy.practical.intro),
    cards: copy.practical.cards.map((card) => ({
      kicker: t(card.kicker),
      title: t(card.title),
      bullets: t(card.bullets)
    }))
  },
  comparison: {
    eyebrow: t(copy.comparison.eyebrow),
    title: t(copy.comparison.title),
    intro: t(copy.comparison.intro),
    profiles: copy.comparison.profiles.map((profile) => ({
      title: t(profile.title),
      text: t(profile.text)
    })),
    bridge: t(copy.comparison.bridge),
    cta: t(copy.comparison.cta)
  },
  gallery: {
    eyebrow: t(copy.gallery.eyebrow),
    title: t(copy.gallery.title),
    images: copy.gallery.items.map((image) => ({
      src: image.src,
      alt: t(image.alt),
      caption: t(image.caption)
    }))
  },
  playa: {
    eyebrow: t(copy.playa.eyebrow),
    title: t(copy.playa.title),
    intro: t(copy.playa.intro),
    proofPoints: t(copy.playa.proofPoints),
    limitation: t(copy.playa.limitation),
    cta: t(copy.playa.cta)
  },
  faq: {
    decisionTitle: t(copy.faq.decisionTitle),
    steps: copy.faq.steps.map((step) => ({
      num: step.num,
      headline: t(step.h),
      text: t(step.t)
    })),
    faqTitle: t(copy.faq.faqTitle),
    items: copy.faq.items.map((item) => ({
      question: t(item.q),
      answer: t(item.a)
    }))
  }
};

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg',
  alt: c.hero.imageAlt,
  width: 666,
  height: 1000,
  sizes: '(max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) 60vw, 40vw'
};

const footerHighlights = [
  {
    token: 'playa',
    label: 'AMARA Playa'
  },
  {
    token: 'location_frigiliana',
    label: {
      en: 'Frigiliana guide',
      de: 'Frigiliana-Guide',
      es: 'Guía de Frigiliana',
      nl: 'Frigiliana-gids',
      sv: 'Frigiliana-guide'
    }[currentLang]
  },
  {
    token: 'romantic_hideaways',
    label: {
      en: 'All stays',
      de: 'Alle Unterkünfte',
      es: 'Todos los alojamientos',
      nl: 'Alle verblijven',
      sv: 'Alla boenden'
    }[currentLang]
  }
];
---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights} showContextNavigation={false}>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    brandName={c.nav.brand}
    languageToken="location_nerja"
    locationAuthorityNav={true}
  />
  <NerjaContextNav activeId="intro" lang={currentLang} />

  <div data-am-page="nerja-location">
    <div class="w-full">
      <div id="intro">
        <Hero
          imageSrc={heroImage.src}
          imageAlt={heroImage.alt}
          imageWidth={heroImage.width}
          imageHeight={heroImage.height}
          imageSizes={heroImage.sizes}
        >
          <span class="am-text-caption text-primary mb-8 block">{c.hero.eyebrow}</span>
          <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">{c.hero.h1}</h1>
          <div class="pl-10 border-l border-primary/20 max-w-xl mb-14">
            <p class="am-text-body text-on-surface-variant leading-relaxed">{c.hero.body}</p>
          </div>
          <div class="flex flex-wrap gap-8">
            <a href="#where-to-stay-in-nerja" class="am-btn am-btn--primary">
              {c.hero.ctaMain}
            </a>
            <a href="#nerja-frigiliana" class="am-btn am-btn--secondary">
              {c.hero.ctaAlt}
            </a>
          </div>
        </Hero>
      </div>

      <section id="key-facts" class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
        <EssenceGrid
          eyebrow={c.essence.eyebrow}
          title={c.essence.title}
          intro={c.essence.intro}
          items={c.essence.items}
        />
      </section>

      <section id="where-to-stay-in-nerja" class="am-section am-section--plain w-full max-w-none !mx-0 !border-t-0 !px-0">
        <div class="max-w-screen-2xl mx-auto px-12 py-40 border-t border-outline-variant/5">
          <div class="max-w-3xl mb-20">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">{c.areas.eyebrow}</span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">{c.areas.title}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">{c.areas.intro}</p>
          </div>

          <div class="grid grid-cols-1 xl:grid-cols-2 gap-x-20 border-t border-outline-variant/20">
            {
              c.areas.items.map((item) => (
                <article class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-6 py-12 border-b border-outline-variant/20">
                  <span class="am-text-subtitle italic text-primary" aria-hidden="true">{item.kicker}</span>
                  <div>
                    <h3 class="am-text-subtitle text-on-surface mb-4">{item.title}</h3>
                    <p class="am-text-body italic text-on-surface-variant leading-relaxed">{item.location}</p>
                    <dl class="mt-8 space-y-5">
                      <div class="grid grid-cols-1 sm:grid-cols-[9rem_minmax(0,1fr)] gap-2 sm:gap-5">
                        <dt class="am-text-caption uppercase tracking-[0.18em] text-primary">{c.areas.labels.everyday}</dt>
                        <dd class="am-text-body text-on-surface-variant leading-relaxed">{item.everyday}</dd>
                      </div>
                      <div class="grid grid-cols-1 sm:grid-cols-[9rem_minmax(0,1fr)] gap-2 sm:gap-5">
                        <dt class="am-text-caption uppercase tracking-[0.18em] text-primary">{c.areas.labels.benefit}</dt>
                        <dd class="am-text-body text-on-surface-variant leading-relaxed">{item.benefit}</dd>
                      </div>
                      <div class="grid grid-cols-1 sm:grid-cols-[9rem_minmax(0,1fr)] gap-2 sm:gap-5">
                        <dt class="am-text-caption uppercase tracking-[0.18em] text-primary">{c.areas.labels.tradeoff}</dt>
                        <dd class="am-text-body text-on-surface-variant leading-relaxed">{item.tradeoff}</dd>
                      </div>
                      <div class="grid grid-cols-1 sm:grid-cols-[9rem_minmax(0,1fr)] gap-2 sm:gap-5">
                        <dt class="am-text-caption uppercase tracking-[0.18em] text-primary">{c.areas.labels.suits}</dt>
                        <dd class="am-text-body text-on-surface-variant leading-relaxed">{item.suits}</dd>
                      </div>
                    </dl>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="beach-or-town" class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0">
        <div class="max-w-screen-2xl mx-auto px-12 py-40 border-t border-outline-variant/5">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
            <div class="lg:col-span-5">
              <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">{c.beaches.eyebrow}</span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">{c.beaches.title}</h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed max-w-xl mb-10">{c.beaches.intro}</p>
              {beachesHref && (
                <a href={beachesHref} class="am-cta-link">{c.beaches.cta}</a>
              )}
            </div>
            <div class="lg:col-span-7 space-y-12">
              {
                c.beaches.items.map((item) => (
                  <article class="border-t border-outline-variant/20 pt-8">
                    <h3 class="am-text-subtitle italic text-on-surface mb-4">{item.title}</h3>
                    <p class="am-text-body text-on-surface-variant leading-relaxed">{item.text}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="practical-nerja" class="am-section am-section--plain w-full max-w-none !mx-0 !border-t-0 !px-0">
        <div class="max-w-screen-2xl mx-auto px-12 py-40 border-t border-outline-variant/5">
          <div class="max-w-3xl mb-20">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">{c.practical.eyebrow}</span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">{c.practical.title}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">{c.practical.intro}</p>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            {
              c.practical.cards.map((card) => (
                <article class="border-l border-outline-variant/20 pl-8 py-3">
                  <span class="am-text-caption uppercase tracking-[0.28em] text-primary block mb-4">{card.kicker}</span>
                  <h3 class="am-text-subtitle italic text-on-surface mb-8">{card.title}</h3>
                  <ul class="space-y-5">
                    {card.bullets.map((bullet) => (
                      <li class="am-text-body text-on-surface-variant leading-relaxed border-t border-outline-variant/10 pt-5 first:border-t-0 first:pt-0">
                        {bullet}
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="nerja-frigiliana" class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0">
        <div class="max-w-screen-2xl mx-auto px-12 py-40 border-t border-outline-variant/5">
          <div class="max-w-3xl mb-20">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">{c.comparison.eyebrow}</span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">{c.comparison.title}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">{c.comparison.intro}</p>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            {
              c.comparison.profiles.map((profile) => (
                <article class="border-l border-primary/30 pl-8 py-3">
                  <h3 class="am-text-subtitle italic text-on-surface mb-5">{profile.title}</h3>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">{profile.text}</p>
                </article>
              ))
            }
          </div>
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 border-t border-outline-variant/20 pt-10">
            <p class="am-text-subtitle italic text-on-surface max-w-2xl">{c.comparison.bridge}</p>
            <a href={comparisonHref} class="am-cta-link shrink-0">{c.comparison.cta}</a>
          </div>
        </div>
      </section>

      <div id="amara-playa" class="am-section am-section--plain w-full max-w-none !mx-0 !border-t-0 !px-0">
        <section class="max-w-screen-2xl mx-auto px-12 py-40 border-t border-outline-variant/5">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
            <div class="lg:col-span-5">
              <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">{c.playa.eyebrow}</span>
              <h2 class="am-text-title italic text-on-surface tracking-tight">{c.playa.title}</h2>
            </div>
            <div class="lg:col-span-7">
              <p class="am-text-body text-on-surface-variant leading-relaxed mb-10">{c.playa.intro}</p>
              <ul class="divide-y divide-outline-variant/10 border-y border-outline-variant/10">
                {c.playa.proofPoints.map((point) => (
                  <li class="am-text-body text-on-surface-variant leading-relaxed py-6">{point}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <PhotoShow eyebrow={c.gallery.eyebrow} title={c.gallery.title} images={c.gallery.images} />

        <div class="max-w-screen-2xl mx-auto px-12 py-24 border-b border-outline-variant/5">
          <div class="max-w-3xl ml-auto border-l border-primary/30 pl-8">
            <p class="am-text-body italic text-on-surface-variant leading-relaxed mb-10">{c.playa.limitation}</p>
            <a href={playaHref} class="am-btn am-btn--primary">{c.playa.cta}</a>
          </div>
        </div>
      </div>

      <section class="am-section am-section--tint w-full max-w-none !mx-0 !border-t-0 !px-0 !py-0">
        <FaqAccordion
          arrivalTitle={c.faq.decisionTitle}
          steps={c.faq.steps}
          faqTitle={c.faq.faqTitle}
          items={c.faq.items}
          anchorArrivalId="nerja-base-check"
          anchorFaqId="faq"
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  .am-section--plain > :global(section),
  .am-section--tint > :global(section) {
    background-color: transparent !important;
  }

  .am-section--plain :global(amara-photoshow) {
    background-color: var(--color-surface) !important;
  }

  .am-section--plain :global(amara-photoshow .bg-surface-container) {
    background-color: var(--color-surface-container-low) !important;
  }

  .am-section--tint :global(.bg-surface-container) {
    background-color: var(--color-surface) !important;
  }
</style>
