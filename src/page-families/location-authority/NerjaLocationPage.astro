---
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import Navigation from '../../components/Navigation.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import WhereToStayBody from './WhereToStayBody.astro';
import {
  nerjaLocationCopy,
  nerjaLocationSeo
} from '../../content/nerjaLocationContent';
import { nerjaWhereToStayContent } from '../../content/nerjaWhereToStayContent';
import { trustLabels } from '../../content/trustLabels';
import { whereToStayOrientationGraphicContent } from '../../content/whereToStayOrientationGraphicContent';
import { resolveOptionalLink, type LinkToken, type LabeledLink } from '../../lib/linkResolver';
import { getLocationGuideTopicLabels } from '../../lib/location/locationGuideTopics';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const orientationGraphic = whereToStayOrientationGraphicContent.nerja[currentLang];
const whereToStayLabel = getLocationGuideTopicLabels(currentLang)['where-to-stay'];
const seo = nerjaLocationSeo;
const copy = nerjaLocationCopy;
function t<T>(value: Readonly<Record<AmaraLanguage, T>>): T {
  return value[currentLang];
}
const optionalLink = (token: LinkToken) => resolveOptionalLink(token, currentLang, { suppressMissing: true });

const content = nerjaWhereToStayContent[currentLang];
const bookBase = optionalLink('book');
const bookHref = bookBase ? `${bookBase}?destination=nerja` : '#';
const bookLabel = trustLabels.book[currentLang];
const pointerHref = optionalLink(content.pointer.linkToken) ?? '#';

const faq = {
  decisionTitle: t(copy.faq.decisionTitle),
  steps: copy.faq.steps.map((step) => ({ num: step.num, headline: t(step.h), text: t(step.t) })),
  faqTitle: t(copy.faq.faqTitle),
  items: copy.faq.items.map((item) => ({ question: t(item.q), answer: t(item.a) }))
};

const footerHighlights: LabeledLink[] = [
  { token: 'playa', label: 'AMARA Playa' },
  {
    token: 'location_frigiliana',
    label: { en: 'Frigiliana guide', de: 'Frigiliana-Guide', es: 'Guía de Frigiliana', nl: 'Frigiliana-gids', sv: 'Frigiliana-guide' }[currentLang]
  },
  {
    token: 'romantic_hideaways',
    label: { en: 'All stays', de: 'Alle Unterkünfte', es: 'Todos los alojamientos', nl: 'Alle verblijven', sv: 'Alla boenden' }[currentLang]
  }
];
---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights} showContextNavigation={false} pageFamily="nerja-where-to-stay">
  <Navigation
    slot="navigation"
    contextDestination="nerja"
    currentLang={currentLang}
    languageToken="nerja_where_to_stay"
  >
    <NerjaContextNav slot="context-navigation" activeId="where-to-stay" childLabel={whereToStayLabel} lang={currentLang} />
  </Navigation>

  <div data-am-page="nerja-where-to-stay" data-am-family="location" data-am-role="spoke" data-am-topic="where-to-stay" data-am-presentation="guide">
    <WhereToStayBody
      content={content}
      orientationGraphic={orientationGraphic}
      bookHref={bookHref}
      bookLabel={bookLabel}
      pointerHref={pointerHref}
    />

    <section class="am-section am-section--tint w-full max-w-none mx-0 border-t-0 px-0 py-0">
      <FaqAccordion
        arrivalTitle={faq.decisionTitle}
        steps={faq.steps}
        faqTitle={faq.faqTitle}
        items={faq.items}
        anchorArrivalId="nerja-base-check"
        anchorFaqId="faq"
        pageEndFamily="location"
      />
    </section>
  </div>
</LocationAuthorityLayout>

<style>
  .am-section--tint > :global(section) {
    background-color: transparent;
  }
  .am-section--tint :global(.bg-surface-container) {
    background-color: var(--color-surface);
  }
</style>
