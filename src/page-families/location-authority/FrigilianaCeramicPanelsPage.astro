---
import Navigation from '../../components/Navigation.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraMediaFrame from '../../components/media/AmaraMediaFrame.astro';
import AmaraKeyFigures from '../../components/content/AmaraKeyFigures.astro';
import LocationPanoramaHero from '../../components/location/LocationPanoramaHero.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialFeatureGrid from '../../components/editorial/EditorialFeatureGrid.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import FrigilianaCeramicPanelsMap from '../../components/location/FrigilianaCeramicPanelsMap.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import heroImage from '../../assets/images/content/frigiliana/frigiliana-keramiktafel-morisken-landwirtschaft.jpg';
import contextImage from '../../assets/images/content/frigiliana/frigiliana-gasse-bogen-kieselmosaik-abend.jpg';
import {
  frigilianaCeramicPanelsCopy,
  frigilianaCeramicPanelsSeo
} from '../../content/frigilianaCeramicPanelsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import type { LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaCeramicPanelsCopy;
const heroAlt = t({
  en: 'A hand-painted ceramic panel in Frigiliana’s old town depicting a scene of the Morisco story',
  de: 'Eine handbemalte Keramiktafel in Frigilianas Altstadt mit einer Szene der Morisken-Geschichte',
  es: 'Un panel de cerámica pintado a mano en el casco antiguo de Frigiliana con una escena de la historia morisca',
  nl: 'Een handbeschilderd keramisch paneel in de oude kern van Frigiliana met een scène uit de Moriskse geschiedenis',
  sv: 'En handmålad keramikpanel i Frigilianas gamla stan med en scen ur den moriskiska historien'
});

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_old_town',
    label: t({
      en: 'Old town & history',
      de: 'Altstadt & Geschichte',
      es: 'Casco antiguo e historia',
      nl: 'Oude kern & geschiedenis',
      sv: 'Gamla stan & historia'
    })
  }
];

const provenanceCards = copy.provenance.items.map((item) => ({
  title: t(item.title),
  copy: t(item.text)
}));

const historiographyItems = copy.historiography.items.map((item) => ({
  title: t(item.title),
  text: t(item.text)
}));

const panels = copy.panels.map((panel) => ({
  n: panel.n,
  titleEs: panel.titleEs,
  scene: t(panel.scene),
  translation: t(panel.translation),
  transcription: panel.transcription
}));

const transcriptionLabel = t(copy.register.transcriptionLabel);
const readMoreLabel = t(copy.register.readMoreLabel);

/* This page's concrete guest-guide perk is the audio guide, so the bridge speaks to
   that instead of the generic recommendations, and the phone shows the audio screen. */
const bridgeCopyOverride = {
  eyebrow: t(copy.bridge.eyebrow),
  title: t(copy.bridge.title),
  lead: t(copy.bridge.lead),
  lines: copy.bridge.lines.map((line) => t(line))
};
const phoneTopicPreview = {
  eyebrow: copy.phonePreview.eyebrow,
  title: copy.phonePreview.title,
  subtitle: copy.phonePreview.subtitle,
  cards: copy.phonePreview.cards.map((card) => ({ icon: card.icon, title: card.title, meta: card.meta }))
};

const keyFigures = copy.keyFigures.figures.map((figure) => ({ value: figure.value, label: t(figure.label) }));
const keyFiguresNote = t(copy.keyFigures.note);

const contextEyebrow = t({ en: 'The story', de: 'Die Geschichte', es: 'La historia', nl: 'Het verhaal', sv: 'Berättelsen' });
const provenanceEyebrow = t({ en: 'Where they come from', de: 'Woher sie kommen', es: 'De dónde vienen', nl: 'Waar ze vandaan komen', sv: 'Varifrån de kommer' });
const registerEyebrow = t({ en: 'The walk', de: 'Der Rundgang', es: 'El recorrido', nl: 'De wandeling', sv: 'Vandringen' });
const historiographyEyebrow = t({ en: 'Memory vs. record', de: 'Erinnerung vs. Beleg', es: 'Memoria y documento', nl: 'Herinnering vs. bron', sv: 'Minne mot källa' });
const contextAlt = t({
  en: 'A stepped lane with an arch and pebble mosaic in the upper old town of Frigiliana at dusk',
  de: 'Eine Treppengasse mit Bogen und Kieselmosaik im oberen Altstadtviertel von Frigiliana in der Abenddämmerung',
  es: 'Una calle escalonada con arco y mosaico de guijarros en la parte alta del casco antiguo de Frigiliana al anochecer',
  nl: 'Een trapstraat met boog en kiezelmozaïek in de hoge oude kern van Frigiliana in de schemering',
  sv: 'En trappgränd med valv och kiselmosaik i övre gamla stan i Frigiliana i skymningen'
});
---

<LocationAuthorityLayout
  pageFamily="experience-frigiliana-ceramic-panels"
  seo={frigilianaCeramicPanelsSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_old_town"
  >
    <ExperienceContextNav slot="context-navigation" currentId="oldTown" destination="frigiliana" lang={currentLang} />
  </Navigation>

  <article class="overflow-x-clip bg-surface" data-am-page="frigiliana-ceramic-panels" data-am-family="location" data-am-role="spoke">
    <LocationPanoramaHero
      eyebrow={t(copy.hero.kicker)}
      title={t(copy.hero.title)}
      subtitle={t(copy.hero.subtitle)}
      paragraphs={[t(copy.hero.paragraphs[0])]}
      imageSrc={heroImage}
      imageAlt={heroAlt}
      focalPoint="50% 45%"
      role="spoke"
      topic="old-town"
    />

    <section class="bg-surface px-6 pb-16 pt-12 md:px-12 md:pb-20" aria-label={keyFigures.map((figure) => figure.label).join(' · ')}>
      <div class="mx-auto max-w-screen-2xl">
        <AmaraKeyFigures figures={keyFigures} note={keyFiguresNote} />
      </div>
    </section>

    <section id="context" class="scroll-mt-28 bg-surface-white px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
          <AmaraMediaFrame role="gallery" mobileFullBleed class="am-bleed-start lg:col-span-6">
            <AmaraImage src={contextImage} alt={contextAlt} profile="gallery" class="h-full w-full object-cover" mediaRole="gallery" focalPoint="50% 50%" />
          </AmaraMediaFrame>
          <div class="am-overlap-start bg-surface-white lg:col-span-6">
            <p class="am-text-eyebrow text-primary">{contextEyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{t(copy.context.title)}</h2>
            <div class="mt-6 max-w-2xl space-y-5">
              {copy.context.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant">{t(paragraph)}</p>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-4xl text-center">
        <blockquote class="am-text-display italic text-balance text-on-surface">{t(copy.pullQuote)}</blockquote>
      </div>
    </section>

    <section id="provenance" class="scroll-mt-28 bg-surface-white px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <p class="am-text-eyebrow text-primary">{provenanceEyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{t(copy.provenance.title)}</h2>
        <p class="am-text-subtitle mt-6 max-w-2xl text-on-surface-variant">{t(copy.provenance.intro)}</p>
        <div class="mt-14">
          <EditorialFeatureGrid cards={provenanceCards} titleRole="card" />
        </div>
      </div>
    </section>

    <section id="register" class="scroll-mt-28 bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl mb-12">
          <p class="am-text-eyebrow text-primary">{registerEyebrow}</p>
          <h2 class="am-text-title mt-5 text-balance text-on-surface">{t(copy.register.title)}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{t(copy.register.intro)}</p>
          <p class="am-text-caption normal-case tracking-normal text-on-surface-variant mt-4">{t(copy.register.note)}</p>
        </div>

        <div class="mb-16">
          <FrigilianaCeramicPanelsMap lang={currentLang} />
        </div>

        <ol class="am-panel-register grid gap-x-10 gap-y-12 lg:grid-cols-2">
          {
            panels.map((panel) => (
              <li class="am-panel" id={`panel-${panel.n}`}>
                <div class="am-panel__head">
                  <span class="am-panel__num" aria-hidden="true">
                    {String(panel.n).padStart(2, '0')}
                  </span>
                  <h3 class="am-panel__title">{panel.titleEs}</h3>
                </div>
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {panel.scene}
                </p>
                <details class="am-panel__quote">
                  <summary>{readMoreLabel}</summary>
                  <p class="am-panel__translation">{panel.translation}</p>
                  <p class="am-panel__orig-caption">{transcriptionLabel}</p>
                  <p lang="es" class="am-panel__transcription">{panel.transcription}</p>
                </details>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="historiography" class="scroll-mt-28 bg-surface-white px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <p class="am-text-eyebrow text-primary">{historiographyEyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{t(copy.historiography.title)}</h2>
            <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{t(copy.historiography.intro)}</p>
          </div>
          <div class="grid gap-y-12 lg:col-span-7 lg:col-start-6">
            {
              historiographyItems.map((item) => (
                <article class="border-t border-outline-variant/30 pt-7">
                  <h3 class="am-text-subtitle text-on-surface mb-4">{item.title}</h3>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <GuestGuideBridge
      lang={currentLang}
      destination="frigiliana"
      guideSlugs={['frigiliana-guest-ceramic-panels']}
        copyOverride={bridgeCopyOverride}
        topicPreview={phoneTopicPreview}
      />

      <section class="max-w-screen-2xl mx-auto px-6 pt-20 pb-24 md:px-12">
        <EditorialClosingCta
          title={t(copy.closing.title)}
          lead={t(copy.closing.lead)}
          lang={currentLang}
          links={[
            {
              token: 'frigiliana_old_town',
              label: t(copy.closing.oldTownCta),
              style: 'primary'
            },
            {
              token: 'book',
              label: t(copy.closing.availabilityCta),
              style: 'secondary'
            }
          ]}
        />
      </section>
  </article>
</LocationAuthorityLayout>

<style>
  /* Ceramic-panel register: numbered cards, each with a collapsible original
     Spanish transcription. */
  .am-panel-register {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .am-panel {
    border-top: 1px solid var(--color-outline-variant);
    padding-top: 1.5rem;
    scroll-margin-top: 6rem;
  }

  .am-panel__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .am-panel__num {
    font-family: var(--font-headline);
    font-style: italic;
    font-weight: 300;
    font-size: 1.35rem;
    color: color-mix(in srgb, var(--color-primary) 55%, transparent);
  }

  .am-panel__title {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-on-surface);
    margin: 0;
  }

  .am-panel__quote {
    margin-top: 1rem;
  }

  .am-panel__quote > summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-primary);
    list-style: none;
  }

  .am-panel__quote > summary::-webkit-details-marker {
    display: none;
  }

  .am-panel__quote > summary::before {
    content: '+';
    font-size: 1rem;
    line-height: 1;
    font-weight: 400;
  }

  .am-panel__quote[open] > summary::before {
    content: '\2013';
  }

  .am-panel__translation {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant);
  }

  .am-panel__orig-caption {
    margin: 1.25rem 0 0;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-on-surface-variant);
  }

  .am-panel__transcription {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-outline-variant);
    font-family: var(--font-headline);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant);
  }
</style>
