---
import { resolveLocale } from '../../types/content';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraMediaFrame from '../../components/media/AmaraMediaFrame.astro';
import Navigation from '../../components/Navigation.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import { nerjaBalconContent, nerjaBalconSeo } from '../../content/nerjaBalconContent';
import { nerjaCavesContent, nerjaCavesSeo } from '../../content/nerjaCavesContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  page: 'balcon' | 'caves';
  lang?: string;
}

const { page, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const isCaves = page === 'caves';
const content = isCaves ? resolveLocale(nerjaCavesContent, currentLang) : resolveLocale(nerjaBalconContent, currentLang);
const seo = isCaves ? nerjaCavesSeo : nerjaBalconSeo;
const languageToken = isCaves ? 'nerja_caves' : 'nerja_balcon_de_europa';
const contextId = isCaves ? 'caves' : 'balcon';
const pageId = isCaves ? 'nerja-caves' : 'nerja-balcon-de-europa';
const requiredLink = createRequiredLinkResolver(
  currentLang,
  isCaves ? 'Nerja caves' : 'Nerja balcon'
);

const aboutHref = requiredLink('about');
const propertyHref = requiredLink('playa');
const personal = isCaves ? resolveLocale(nerjaCavesContent, currentLang).personal : null;
const footerHighlights: LabeledLink[] = isCaves
  ? [
      { token: 'nerja_caves', label: content.navLabel },
      { token: 'nerja_geography', label: content.related.links[0].label },
      { token: 'nerja_weather', label: content.related.links[1].label }
    ]
  : [
      { token: 'nerja_balcon_de_europa', label: content.navLabel },
      { token: 'nerja_nightlife_authority', label: content.related.links[0].label },
      { token: 'nerja_geography', label: content.related.links[1].label }
    ];
---

<LocationAuthorityLayout
  pageFamily="experience-nerja-article"
  seo={seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation slot="navigation" contextDestination="nerja" currentLang={currentLang} languageToken={languageToken}>
    <ExperienceContextNav
      slot="context-navigation"
      currentId={contextId}
      destination="nerja"
      lang={currentLang}
    />
  </Navigation>

  <AuthorityArticle
    pageId={pageId}
    family="experience"
    topic={contextId}
    lang={currentLang}
    hero={content.hero}
    authorName={seo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
    secondaryCta={{ href: requiredLink('book'), label: experienceStayBridge.availabilityLabel[currentLang] }}
  >
    {content.sections.map((section, index) => (
      <AuthorityTextSection section={section} index={index} />
    ))}

    {personal && (
      <section
 id="our-visit"
 class="scroll-mt-32 bg-surface px-6 py-20 md:px-12 md:py-28"
 >
        <div class="mx-auto grid max-w-screen-2xl items-center gap-12 lg:grid-cols-12 lg:gap-20">
          <AmaraMediaFrame role="split" class="lg:col-span-5">
            <AmaraImage
              src="/images/nerja/nerja-cave-VR.jpeg"
              alt={personal.imageAlt}
              profile="card"
              class="w-full object-cover aspect-[3/4]"
              loading="lazy"
              decoding="async"
              mediaRole="split"
            />
          </AmaraMediaFrame>
          <div class="lg:col-span-7">
            <p class="am-text-eyebrow text-primary">{personal.eyebrow}</p>
            <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{personal.title}</h2>
            <div class="mt-8 max-w-3xl space-y-5">
              {personal.paragraphs.map((paragraph, paragraphIndex) => (
                <p
                  class:list={[
                    paragraphIndex === 0 ? 'am-text-subtitle' : 'am-text-body',
                    'leading-relaxed text-on-surface-variant'
                  ]}
                >
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
    {personal && ' '}

    <AuthorityRelatedLinks
      related={content.related}
      columns={isCaves ? 'md:grid-cols-3' : 'md:grid-cols-2'}
      resolveHref={requiredLink}
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
