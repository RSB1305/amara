---
import Hero from '../../components/Hero.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import HairlineStatCard from '../../components/location/HairlineStatCard.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaFaqCopy,
  frigilianaFaqExternalLinks,
  frigilianaFaqSeo
} from '../../content/frigilianaFaqContent';
import {
  frigilianaPreFooterCopy,
  getFrigilianaPreFooterDescription
} from '../../content/frigilianaPreFooterContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaFaqCopy;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const gettingHereHref = buildOwnedLocalizedPath('getting-to-frigiliana', currentLang);

const navLinks = copy.nav.links.map((link) => ({
  token: link.token,
  label: t(link.label)
}));

const orientationFacts = copy.orientation.items.map((item) => ({
  label: t(item.label),
  value: t(item.value),
  note: t(item.note)
}));

const faqSections = copy.sections.map((section) => ({
  id: section.id,
  number: section.number,
  eyebrow: t(section.eyebrow),
  title: t(section.title),
  intro: t(section.intro),
  items: section.items.map((item) => {
    const linkToken = 'linkToken' in item ? item.linkToken : undefined;
    const linkLabel = 'linkLabel' in item ? item.linkLabel[currentLang] : '';
    const linkHref =
      linkToken && linkLabel
        ? resolveOptionalLink(linkToken, currentLang, {
            suppressMissing: true
          })
        : null;

    return {
      question: t(item.q),
      answer: t(item.a),
      link:
        linkHref && linkLabel
          ? {
              href: linkHref,
              label: linkLabel
            }
          : null
    };
  })
}));

const liveInfoLinks = copy.liveInfo.links.map((link) => ({
  href:
    frigilianaFaqExternalLinks[
      link.key as keyof typeof frigilianaFaqExternalLinks
    ],
  label: t(link.label),
  text: t(link.text)
}));

const relatedLinks = copy.related.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, {
    suppressMissing: true
  });

  return href
    ? [{
        href,
        label: t(link.label),
        text: getFrigilianaPreFooterDescription(link.token, currentLang)
      }]
    : [];
});

const footerHighlights = [
  {
    token: 'frigiliana_faq',
    label: t(copy.nav.links[2].label)
  },
  {
    token: 'getting_to_frigiliana',
    label: t(copy.nav.links[1].label)
  },
  {
    token: 'location_frigiliana',
    label: t(copy.nav.links[0].label)
  }
];

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/02-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};
---

<LocationAuthorityLayout
  seo={frigilianaFaqSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
>
  <Navigation
    currentLang={currentLang}
    brandName={t(copy.nav.brand)}
    links={navLinks}
    languageToken="frigiliana_faq"
    locationAuthorityNav={true}
  />
  <LocationContextNav activeId="faq" lang={currentLang} />

  <div class="am-root" data-am-page="frigiliana-faq">
    <div class="am-wrap w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={t(copy.hero.imageAlt)}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {t(copy.hero.eyebrow)}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {t(copy.hero.title)}
        </h1>
        <div class="pl-10 border-l border-primary/20 max-w-xl mb-14 space-y-6">
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.lead)}
          </p>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.body)}
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href="#faq-sections"
            class="am-btn am-btn--primary"
          >
            {t(copy.hero.primaryCta)}
          </a>
          <a
            href={gettingHereHref}
            class="am-btn am-btn--secondary"
          >
            {t(copy.hero.secondaryCta)}
          </a>
        </div>
      </Hero>

      <section class="max-w-screen-2xl mx-auto px-12 pb-32">
        <div class="max-w-3xl mb-14">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {t(copy.orientation.title)}
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-12 gap-y-12">
          {
            orientationFacts.map((fact) => (
              <HairlineStatCard
                label={fact.label}
                value={fact.value}
                description={fact.note}
              />
            ))
          }
        </div>
      </section>

      <section
        id="faq-sections"
        class="border-t border-outline-variant/10"
        aria-label={t(copy.hero.title)}
      >
        {
          faqSections.map((section, index) => (
            <article
              id={section.id}
              class:list={[
                'border-b border-outline-variant/10',
                index % 2 === 1 && 'bg-surface-container-low'
              ]}
            >
              <div class="max-w-screen-2xl mx-auto px-12 py-28 grid grid-cols-1 lg:grid-cols-12 gap-x-20 gap-y-14">
                <header class="lg:col-span-4 lg:pr-6">
                  <div class="flex items-baseline justify-between gap-8 mb-8">
                    <span class="am-text-caption uppercase tracking-[0.32em] text-primary">
                      {section.eyebrow}
                    </span>
                    <span
                      class="font-headline text-[clamp(2.75rem,5vw,5rem)] italic leading-none text-outline-variant/45"
                      aria-hidden="true"
                    >
                      {section.number}
                    </span>
                  </div>
                  <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                    {section.title}
                  </h2>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {section.intro}
                  </p>
                </header>

                <div class="lg:col-span-7 lg:col-start-6 border-t border-outline-variant/15">
                  {section.items.map((item) => (
                    <details class="group border-b border-outline-variant/15">
                      <summary class="am-faq-summary py-9 cursor-pointer">
                        <h3 class="am-text-subtitle text-on-surface pr-8 group-hover:text-primary transition-colors">
                          {item.question}
                        </h3>
                        <span class="am-accordion__indicator shrink-0" aria-hidden="true">
                          <span class="group-open:hidden">+</span>
                          <span class="hidden group-open:inline">−</span>
                        </span>
                      </summary>
                      <div class="pb-9 pr-14">
                        <p class="am-text-body text-on-surface-variant leading-relaxed max-w-2xl">
                          {item.answer}
                        </p>
                        {
                          item.link && (
                            <a href={item.link.href} class="am-cta-link mt-6 inline-flex">
                              {item.link.label}
                            </a>
                          )
                        }
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <section class="bg-surface-container-low border-b border-outline-variant/5">
        <div class="max-w-screen-2xl mx-auto px-12 py-32">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
            <div class="lg:col-span-4">
              <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
                {t(copy.liveInfo.eyebrow)}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                {t(copy.liveInfo.title)}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed mb-6">
                {t(copy.liveInfo.intro)}
              </p>
              <p class="am-text-caption uppercase tracking-[0.14em] text-on-surface-variant/70">
                {t(copy.liveInfo.checked)}
              </p>
            </div>
            <div class="lg:col-span-8 border-t border-outline-variant/15">
              {
                liveInfoLinks.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="am-card-link group grid grid-cols-[1fr_auto] gap-8 py-9 border-b border-outline-variant/15"
                  >
                    <span>
                      <span class="am-text-subtitle text-on-surface block mb-3 group-hover:text-primary transition-colors">
                        {link.label}
                      </span>
                      <span class="am-text-body text-on-surface-variant leading-relaxed">
                        {link.text}
                      </span>
                    </span>
                    <span
                      class="am-text-subtitle text-primary transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <EditorialGuideLinkSection
        eyebrow={frigilianaPreFooterCopy.eyebrow[currentLang]}
        title={t(copy.related.title)}
        intro={frigilianaPreFooterCopy.intro[currentLang]}
        links={relatedLinks}
      />

      <section class="max-w-screen-2xl mx-auto px-12 pt-8">
        <EditorialClosingCta
          title={t(copy.closing.title)}
          lead={t(copy.closing.lead)}
          lang={currentLang}
          links={[
            {
              token: 'location_frigiliana',
              label: t(copy.closing.guideCta),
              style: 'primary'
            },
            {
              token: 'romantic_hideaways',
              label: t(copy.closing.stayCta),
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  .am-faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .am-faq-summary::-webkit-details-marker {
    display: none;
  }

  details[open] > div {
    animation: am-faq-reveal 0.35s ease-out;
  }

  @keyframes am-faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    :global([data-am-page='frigiliana-faq'] .px-12) {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>
