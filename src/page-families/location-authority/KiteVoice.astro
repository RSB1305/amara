---
/**
 * A named voice woven into the editorial flow of the Tarifa kitesurf pages: a
 * small round portrait beside a first-person insight, signed inline with name
 * and role. Robert and Mark speak here from their own experience — never an
 * AMARA rule — and the treatment deliberately reads as part of the article, not
 * as a boxed quote card: no fill, no frame, just the portrait as a quiet marker
 * that a real person is speaking, so the passage flows into the surrounding copy
 * as first-hand added value.
 */
import type { ImageMetadata } from 'astro';
import AmaraImage from '../../components/AmaraImage.astro';

interface Props {
  id: string;
  name: string;
  role: string;
  paragraphs: string[];
  lead?: string;
  imageSrc: ImageMetadata | string;
  imageAlt: string;
  focalPoint?: string;
  /** Kept for caller compatibility; the woven-in treatment no longer boxes the voice. */
  tone?: 'on-tint' | 'on-white';
  class?: string;
}

const { id, name, role, paragraphs, lead, imageSrc, imageAlt, focalPoint = '50% 20%', class: className } = Astro.props;
---

<figure class:list={['am-kite-voice m-0 flex gap-4 sm:gap-5', className]} data-am-voice={id}>
  <span class="mt-1 h-12 w-12 shrink-0 overflow-hidden rounded-full bg-surface-container-low ring-1 ring-outline-variant/40">
    <AmaraImage
      src={imageSrc}
      alt={imageAlt}
      profile="card"
      width={96}
      widths={[48, 72, 96]}
      sizes="48px"
      class="h-full w-full object-cover"
      focalPoint={focalPoint}
      loading="lazy"
      decoding="async"
    />
  </span>
  <div class="min-w-0 max-w-2xl">
    {lead && <p class="am-text-label am-text-label--sm text-primary">{lead}</p>}
    <blockquote class:list={['m-0 space-y-3', { 'mt-1.5': Boolean(lead) }]}>
      {paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface">{paragraph}</p>)}
    </blockquote>
    <figcaption class="am-text-label am-text-label--sm mt-3 text-muted">— {name} · {role}</figcaption>
  </div>
</figure>
