---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import GuideClosingSection from './GuideClosingSection.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import { publicBeachCard } from '../../lib/placeProjection';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  frigilianaBeachesContent,
  frigilianaBeachesSeo
} from '../../content/frigilianaBeachesContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import BeachPracticalSection from './BeachPracticalSection.astro';
import BeachSectionList from './BeachSectionList.astro';
import GuideLinkCardSection from './GuideLinkCardSection.astro';
import { routeHero } from '../../lib/images/routeImages';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = routeHero('frigiliana.experience.beaches', currentLang);
const copy = frigilianaBeachesContent[currentLang];

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_beaches_authority',
    label: copy.footerHighlights.beaches
  },
  {
    token: 'frigiliana_hiking_authority',
    label: copy.footerHighlights.hiking
  },
  { token: 'romantic_hideaways', label: copy.footerHighlights.stays }
];

const beachSections = copy.beachSections.map((section) => ({
  ...section,
  beaches: section.beachIds.map((id) => publicBeachCard(id, currentLang))
}));

const combineItems = copy.combine.items.map((item) => ({
  ...item,
  href: resolveOptionalLink(item.linkToken, currentLang, {
    suppressMissing: true
  })
}));
const baseDecisionHref = resolveOptionalLink(
  copy.combine.baseDecision.linkToken,
  currentLang,
  { suppressMissing: true }
);

---

<LocationAuthorityLayout
  seo={frigilianaBeachesSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-beaches"
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_beaches_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="beaches" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-beaches">
    <div class="w-full">
      <LocationExperienceHero
        {...hero}
        topic="beaches"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        paragraphs={copy.hero.paragraphs}
      />

      <AuthorityFeatureSection
        id="coast"
        title={copy.overview.title}
        intro={copy.overview.intro}
        items={copy.overview.items}
      />

      <BeachSectionList sections={beachSections} labels={copy.beachCardLabels} />

      <AuthorityFeatureSection
        id="conditions"
        title={copy.conditions.title}
        intro={copy.conditions.intro}
        items={copy.conditions.items}
      />

      <BeachPracticalSection
        title={copy.practical.title}
        intro={copy.practical.intro}
        items={copy.practical.items}
        accessNote={copy.practical.accessNote}
        columns={3}
      />

      <GuideLinkCardSection
        title={copy.combine.title}
        intro={copy.combine.intro}
        items={combineItems}
        surface="tint"
        headerLinkNote={{
          before: copy.combine.baseDecision.before,
          href: baseDecisionHref,
          label: copy.combine.baseDecision.linkLabel,
          after: copy.combine.baseDecision.after
        }}
      />

      <GuestGuideBridge
        lang={currentLang}
        destination="frigiliana"
        guideSlugs={['frigiliana-guest-beaches']}
      />

      <GuideClosingSection
        title={copy.closing.title}
        lead={copy.closing.lead}
        lang={currentLang}
        links={[
          {
            token: 'location_nerja',
            label: copy.closing.nextCta,
            style: 'text'
          }
        ]}
        role="next-action"
        family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
