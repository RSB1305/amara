---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import nerjaStayImage from '../../assets/images/home/amara-playa-chaparril-13.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import LocationHubHero from '../../components/location/LocationHubHero.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import { nerjaLocationHubContent } from '../../content/nerjaLocationHubContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LinkToken, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = nerjaLocationHubContent.locales[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja location hub');
const featureHref = (link?: { token?: LinkToken; anchor?: string }) =>
  link?.token ? requiredLink(link.token) : link?.anchor;
const aboutHref = requiredLink('about');
const stayHref = requiredLink('playa');
const footerHighlights: LabeledLink[] = [
  { token: 'location_nerja', label: 'Nerja' },
  { token: 'getting_to_nerja', label: content.discovery.items[0].label },
  { token: 'nerja_where_to_stay', label: content.discovery.items[2].label }
];
---

<LocationAuthorityLayout
  seo={nerjaLocationHubContent.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken={nerjaLocationHubContent.token}
  >
    <NerjaContextNav slot="context-navigation" activeId="intro" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="nerja-location-hub" data-am-family="location" data-am-role="hub">
    <LocationHubHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      paragraphs={[content.hero.standfirst]}
      imageSrc={nerjaStayImage}
      imageAlt={content.amara.imageAlt}
      byline={nerjaLocationHubContent.seo.article ? {
        lang: currentLang,
        authorName: nerjaLocationHubContent.seo.article.authorName,
        authorHref: aboutHref,
        updated: content.hero.updated,
        note: content.hero.note
      } : undefined}
    />

    {/*
      The six-tile discovery block was removed: it repeated the topics already
      shown in the context navigation directly above, which left readers unsure
      whether the two lists led to the same places. `content.discovery` is kept
      as the authoring source for the footer highlight labels.
    */}

    <section id="orientation" class="scroll-mt-28 border-b border-border-subtle bg-surface px-6 py-24 md:px-12 md:py-32 lg:py-40">
      <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.orientation.eyebrow}</p>
          <h2 class="am-text-display mt-6 max-w-5xl text-balance text-on-surface">{content.orientation.title}</h2>
          <div class="mt-10 max-w-3xl space-y-5">
            {content.orientation.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>
        <dl class="self-end border-y border-border-subtle lg:col-span-5">
          {content.orientation.markers.map((marker, index) => (
            <div class:list={['grid grid-cols-[0.65fr_1.35fr] gap-6 py-7', index > 0 && 'border-t border-border-subtle']}>
              <dt class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary">{marker.label}</dt>
              <dd class="am-text-subtitle text-on-surface">{marker.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.arrival.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.arrival.title}</h2>
        </div>
        <div class="max-w-4xl space-y-5 lg:col-span-7">
          {content.arrival.paragraphs.map((paragraph, index) => (
            <p class:list={[index === 0 ? 'am-text-subtitle' : 'am-text-body', 'leading-relaxed text-on-surface-variant']}>{paragraph}</p>
          ))}
          <a href={featureHref(content.arrival.link)} class="am-cta-link mt-8 inline-flex">{content.arrival.link?.label}</a>
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-inverse-surface px-6 py-24 text-inverted-on-surface md:px-12 md:py-32 lg:py-40">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary-fixed-dim">{content.areas.eyebrow}</p>
            <h2 class="am-text-display mt-6 text-balance text-inverted-on-surface">{content.areas.title}</h2>
          </div>
          <div class="space-y-5 lg:col-span-7">
            {content.areas.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-inverted-on-surface/75"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>
        <div class="mt-16 grid gap-x-8 md:grid-cols-2 lg:mt-24 lg:grid-cols-4">
          {content.areas.archetypes.map((area, index) => (
            <div class="border-t border-inverted-on-surface/20 py-7">
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary-fixed-dim">0{index + 1}</span>
              <h3 class="am-text-subtitle mt-4 text-inverted-on-surface">{area.title}</h3>
              <p class="am-text-body mt-3 leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={area.consequence} /></p>
            </div>
          ))}
        </div>
        <a href={featureHref(content.areas.link)} class="am-btn am-btn--primary mt-10">{content.areas.link?.label}</a>
      </div>
    </section>

    <div class="border-b border-border-subtle bg-surface">
      <div class="mx-auto grid max-w-screen-2xl lg:grid-cols-2">
        <section class="border-b border-border-subtle px-6 py-20 md:px-12 md:py-28 lg:border-b-0 lg:border-r">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.coast.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.coast.title}</h2>
          <div class="mt-7 space-y-5">
            {content.coast.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
          </div>
        </section>
        <section id="daily-life" class="scroll-mt-28 px-6 py-20 md:px-12 md:py-28">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.dailyLife.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.dailyLife.title}</h2>
          <div class="mt-7 space-y-5">
            {content.dailyLife.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
          </div>
          <a href={featureHref(content.dailyLife.link)} class="am-cta-link mt-8 inline-flex">{content.dailyLife.link?.label}</a>
        </section>
      </div>
    </div>

    <section id="seasons" class="scroll-mt-28 border-b border-border-subtle bg-surface-container-low px-6 py-24 md:px-12 md:py-32">
      <div class="mx-auto max-w-screen-2xl border-y border-primary/20 py-14 md:py-20">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.seasons.eyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.seasons.title}</h2>
          </div>
          <div class="space-y-5 lg:col-span-7">
            {content.seasons.paragraphs.map((paragraph, index) => (
              <p class:list={[index === 0 ? 'am-text-subtitle' : 'am-text-body', 'leading-relaxed text-on-surface-variant']}>{paragraph}</p>
            ))}
            {content.seasons.link && (
              <a href={featureHref(content.seasons.link)} class="am-cta-link mt-8 inline-flex">{content.seasons.link.label}</a>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface-container-low lg:grid-cols-[0.9fr_1.1fr]">
        <figure class="am-mobile-full-bleed min-h-[340px] bg-surface-container-high lg:min-h-[520px]">
          <AmaraImage src={nerjaStayImage} alt={content.amara.imageAlt} profile="gallery" class="h-full w-full object-cover" sizes="(max-width: 1023px) 100vw, 45vw" loading="lazy" decoding="async" />
        </figure>
        <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.amara.eyebrow}</p>
          <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.amara.title}</h2>
          <div class="mt-7 space-y-5">
            {content.amara.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
          </div>
          <ul class="mt-7 space-y-3 border-l border-primary/30 pl-5">
            {content.amara.facts.map((fact) => <li class="am-text-body leading-relaxed text-on-surface">{fact}</li>)}
          </ul>
          <a href={stayHref} class="am-cta-link mt-9 inline-flex self-start">{content.amara.link?.label}</a>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-24 md:px-12 md:py-32">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
        <div class="lg:col-span-7">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.experience.eyebrow}</p>
          <h2 class="am-text-display mt-6 text-balance text-on-surface">{content.experience.title}</h2>
        </div>
        <div class="lg:col-span-5">
          {content.experience.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
          <a href={featureHref(content.experience.link)} class="am-btn am-btn--primary mt-8">{content.experience.link?.label}</a>
        </div>
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
