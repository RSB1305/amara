---
import LocationStaySplitSection from './LocationStaySplitSection.astro';
import LocationAreasBand from './LocationAreasBand.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import nerjaStayImage from '../../assets/images/home/amara-playa-chaparril-13.webp';
import nerjaCoastImage from '../../assets/images/content/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg';
import Navigation from '../../components/Navigation.astro';
import LocationHubHero from '../../components/location/LocationHubHero.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import { getNerjaLocationHubLocale, nerjaLocationHubContent } from '../../content/nerjaLocationHubContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LinkToken, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = getNerjaLocationHubLocale(currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja location hub');
const featureHref = (link?: { token?: LinkToken; anchor?: string }) =>
  link?.token ? requiredLink(link.token) : link?.anchor;
const aboutHref = requiredLink('about');
const stayHref = requiredLink('playa');
const experienceLinks = content.experience.links ?? [];
const locationFeatures = [
  {
    id: 'coast',
    copy: content.coast,
    paragraphs: content.coast.paragraphs.slice(0, 1),
    link: experienceLinks[0]
  },
  {
    id: 'daily-life',
    copy: content.dailyLife,
    paragraphs: content.dailyLife.paragraphs.slice(0, 1),
    link: content.dailyLife.link
  },
  {
    id: 'seasons',
    copy: content.seasons,
    paragraphs: content.seasons.paragraphs.slice(0, 2),
    link: content.seasons.link
  }
];
const footerHighlights: LabeledLink[] = [
  { token: 'location_nerja', label: 'Nerja' },
  { token: 'getting_to_nerja', label: content.discovery.items[0].label },
  { token: 'nerja_where_to_stay', label: content.discovery.items[2].label }
];
---

<LocationAuthorityLayout
  pageFamily="nerja-location-hub"
  seo={nerjaLocationHubContent.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="nerja"
    currentLang={currentLang}
    languageToken={nerjaLocationHubContent.token}
  >
    <NerjaContextNav slot="context-navigation" activeId="intro" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="nerja-location-hub" data-am-family="location" data-am-role="hub">
    <LocationHubHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      subtitle={content.hero.subtitle}
      paragraphs={[content.hero.standfirst]}
      imageSrc={nerjaCoastImage}
      imageAlt={content.hero.imageAlt ?? content.amara.imageAlt}
      byline={nerjaLocationHubContent.seo.article ? {
        lang: currentLang,
        authorName: nerjaLocationHubContent.seo.article.authorName,
        authorHref: aboutHref,
        updated: content.hero.updated,
        note: content.hero.note
      } : undefined}
    />

    {/*
      The six-tile discovery block was removed: it repeated the topics already
      shown in the context navigation directly above, which left readers unsure
      whether the two lists led to the same places. `content.discovery` is kept
      as the authoring source for the footer highlight labels.
    */}

    <section id="orientation" class="scroll-mt-28 bg-surface px-6 py-24 md:px-12 md:py-32 lg:py-40">
      <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7">
          <p class="am-text-eyebrow text-primary">{content.orientation.eyebrow}</p>
          <h2 class="am-text-title mt-6 max-w-5xl text-balance text-on-surface">{content.orientation.title}</h2>
          <div class="mt-10 max-w-3xl space-y-5">
            {content.orientation.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>
        <dl class="self-end border-y border-border-subtle lg:col-span-5">
          {content.orientation.markers.map((marker, index) => (
            <div class:list={['grid grid-cols-[0.65fr_1.35fr] gap-6 py-7', index > 0 && 'border-t border-border-subtle']}>
              <dt class="text-primary am-text-label am-text-label--sm">{marker.label}</dt>
              <dd class="am-text-subtitle text-on-surface">{marker.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="arrival" class="scroll-mt-28 bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary">{content.arrival.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.arrival.title}</h2>
        </div>
        <div class="max-w-4xl space-y-5 lg:col-span-7">
          {content.arrival.paragraphs.slice(0, 2).map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
          {content.arrival.link && (
            <a href={featureHref(content.arrival.link)} class="am-cta-link inline-flex">{content.arrival.link.label}</a>
          )}
        </div>
      </div>
    </section>

    <LocationAreasBand
      eyebrow={content.areas.eyebrow}
      title={content.areas.title}
      paragraphs={content.areas.paragraphs}
      archetypes={content.areas.archetypes}
      link={content.areas.link ? { href: featureHref(content.areas.link), label: content.areas.link.label } : undefined}
    />

    {locationFeatures.map((feature, index) => (
      <section
 id={feature.id}
 class:list={[
 'scroll-mt-28 px-6 py-20 md:px-12 md:py-28',
 index % 2 === 0 ? 'bg-surface' : 'bg-surface-container-low'
 ]}
 >
        <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="am-text-eyebrow text-primary">{feature.copy.eyebrow}</p>
            <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{feature.copy.title}</h2>
          </div>
          <div class="max-w-4xl space-y-5 lg:col-span-7">
            {feature.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
            {feature.link && (
              <a href={featureHref(feature.link)} class="am-cta-link inline-flex">{feature.link.label}</a>
            )}
          </div>
        </div>
      </section>
    ))}

    <section class="bg-surface px-6 py-24 md:px-12 md:py-32">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
        <div class="lg:col-span-7">
          <p class="am-text-eyebrow text-primary">{content.experience.eyebrow}</p>
          <h2 class="am-text-title mt-6 text-balance text-on-surface">{content.experience.title}</h2>
        </div>
        <div class="lg:col-span-5">
          {content.experience.paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
          <div class="mt-8 flex flex-col items-start gap-5">
            {experienceLinks.slice(1).map((link) => (
              <a href={featureHref(link)} class="am-cta-link">{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LocationStaySplitSection
      imageSrc={nerjaStayImage}
      imageAlt={content.amara.imageAlt}
      eyebrow={content.amara.eyebrow}
      title={content.amara.title}
      paragraphs={[content.amara.paragraphs[1], content.amara.paragraphs[3]]}
      facts={content.amara.facts}
      link={content.amara.link ? { href: stayHref, label: content.amara.link.label } : undefined}
    />
  </article>
</LocationAuthorityLayout>
