---
import AmaraImage from '../../components/AmaraImage.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import LocationModule from './LocationModule.astro';
import type { WhereToStayAuthorityContent } from './whereToStayAuthority';

interface Props {
  content: WhereToStayAuthorityContent;
}

const { content } = Astro.props;
---

<LocationModule
  data-am-stay-module="decision"
>
  <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <p class="am-text-eyebrow text-primary">{content.decision.eyebrow}</p>
      <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-on-surface">{content.decision.title}</h2>
      <div class="mt-7 max-w-xl space-y-5">
        {content.decision.intro.map((paragraph) => (
          <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
        ))}
      </div>
    </div>
    <ol class="grid border-y border-border-subtle sm:grid-cols-2 lg:col-span-7">
      {content.decision.points.map((point, index) => (
        <li
          class:list={[
            'min-w-0 py-7 sm:px-7',
            index > 0 && 'border-t border-border-subtle sm:border-t-0',
            index > 1 && 'sm:border-t',
            index % 2 === 1 && 'sm:border-l sm:border-border-subtle'
          ]}
        >
          <span class="text-primary am-text-label am-text-label--sm">
            {point.label ?? String(index + 1).padStart(2, '0')}
          </span>
          {point.title && <h3 class="am-text-subtitle mt-4 text-balance text-on-surface">{point.title}</h3>}
          <p class:list={[point.title ? 'mt-4' : 'mt-3', 'am-text-body leading-relaxed text-on-surface-variant']}>
            <InlineEmphasis text={point.text} />
          </p>
        </li>
      ))}
    </ol>
  </div>
</LocationModule>

<LocationModule
  id={content.areas.id}
  surface="tint"
  class="scroll-mt-32"
  data-am-stay-module="areas"
>
  <div class="mx-auto max-w-screen-2xl">
    <div class="max-w-4xl">
      <p class="am-text-eyebrow text-primary">{content.areas.eyebrow}</p>
      <h2 class="am-text-display mt-6 min-w-0 text-balance hyphens-auto text-on-surface [overflow-wrap:anywhere]">{content.areas.title}</h2>
      <p class="am-text-body mt-7 max-w-3xl leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.areas.intro} /></p>
    </div>

    <div class="mt-14 border-t border-border-subtle md:mt-16">
      {content.areas.items.map((area) => {
        const details = [
          area.fit ? { label: content.areas.labels.fit, text: area.fit } : null,
          area.daily ? { label: content.areas.labels.daily, text: area.daily } : null,
          area.tradeoff ? { label: content.areas.labels.tradeoff, text: area.tradeoff } : null
        ].filter((item): item is { label: string; text: string } => Boolean(item));

        return (
          <article class="grid gap-8 border-b border-border-subtle py-12 lg:grid-cols-12 lg:gap-16 lg:py-16">
            <div class="lg:col-span-4">
              <span class="font-serif text-5xl italic leading-none text-primary/55" aria-hidden="true">{area.number}</span>
              <h3 class="am-text-title mt-5 max-w-lg text-balance text-on-surface">{area.title}</h3>
            </div>
            <div class="min-w-0 lg:col-span-5">
              <div class="space-y-5">
                {area.paragraphs.map((paragraph) => (
                  <p class="am-text-body hyphens-auto leading-relaxed text-on-surface-variant [overflow-wrap:anywhere]"><InlineEmphasis text={paragraph} /></p>
                ))}
              </div>
            </div>
            {details.length > 0 && (
              <dl class="border-y border-border-subtle lg:col-span-3 lg:border-y-0 lg:border-l lg:pl-8">
                {details.map((detail, index) => (
                  <div class:list={['py-5 lg:first:pt-0', index > 0 && 'border-t border-border-subtle']}>
                    <dt class="text-primary am-text-label am-text-label--sm">{detail.label}</dt>
                    <dd class="am-text-body mt-3 leading-relaxed text-on-surface"><InlineEmphasis text={detail.text} /></dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        );
      })}
    </div>
  </div>
</LocationModule>

<LocationModule
  surface="inverse"
  data-am-stay-module="tradeoffs"
>
  <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <p class="am-text-eyebrow text-primary-fixed-dim">{content.tradeoffs.eyebrow}</p>
      <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-inverted-on-surface">{content.tradeoffs.title}</h2>
      {content.tradeoffs.intro && (
        <p class="am-text-body mt-7 max-w-xl leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={content.tradeoffs.intro} /></p>
      )}
    </div>
    <ol class="border-y border-inverted-on-surface/20 lg:col-span-7">
      {content.tradeoffs.items.map((item, index) => (
        <li class:list={['grid gap-5 py-7 sm:grid-cols-[3rem_minmax(0,1fr)]', index > 0 && 'border-t border-inverted-on-surface/20']}>
          <span class="font-label text-[10px] font-bold tracking-[0.14em] text-primary-fixed-dim">{String(index + 1).padStart(2, '0')}</span>
          <div class="min-w-0">
            {item.title && <h3 class="am-text-subtitle text-inverted-on-surface">{item.title}</h3>}
            <div class:list={[item.title ? 'mt-3' : '', 'space-y-3']}>
              {item.paragraphs.map((paragraph) => (
                <p class="am-text-body hyphens-auto leading-relaxed text-inverted-on-surface/75 [overflow-wrap:anywhere]">
                  <InlineEmphasis text={paragraph} />
                </p>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
    {content.tradeoffs.action && (
      <a href={content.tradeoffs.action.href} class="am-cta-link text-primary-fixed-dim lg:col-start-6 lg:col-span-7">
        {content.tradeoffs.action.label}
      </a>
    )}
  </div>
</LocationModule>

<LocationModule
  id={content.mobility.id}
  class="scroll-mt-32"
  data-am-stay-module="mobility"
>
  <div class="mx-auto max-w-screen-2xl">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="am-text-eyebrow text-primary">{content.mobility.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-on-surface">{content.mobility.title}</h2>
      </div>
      <div class="space-y-5 lg:col-span-7">
        {content.mobility.intro.map((paragraph) => (
          <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
        ))}
      </div>
    </div>
    <div class="mt-12 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">
      {content.mobility.items.map((item, index) => (
        <article class="border-t border-primary/35 py-8">
          <span class="font-serif text-3xl leading-none text-primary/55">{item.number ?? String(index + 1).padStart(2, '0')}</span>
          <h3 class="am-text-subtitle mt-5 text-balance text-on-surface">{item.title}</h3>
          {item.paragraphs && (
            <div class="mt-5 space-y-4">
              {item.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
          )}
          {item.actions && item.actions.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
              {item.actions.map((action) => <a href={action.href} class="am-cta-link">{action.label}</a>)}
            </div>
          )}
        </article>
      ))}
    </div>
    {content.mobility.conclusion && (
      <p class="am-text-subtitle mt-8 max-w-4xl border-l-2 border-primary/35 bg-surface-container-low px-6 py-5 text-on-surface">
        <InlineEmphasis text={content.mobility.conclusion} />
      </p>
    )}
  </div>
</LocationModule>

<LocationModule
  surface="tint"
  data-am-stay-module="fit"
>
  <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-4">
      <p class="am-text-eyebrow text-primary">{content.fit.eyebrow}</p>
      <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-on-surface">{content.fit.title}</h2>
      <div class="mt-7 space-y-5">
        {content.fit.intro.map((paragraph) => (
          <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
        ))}
      </div>
    </div>
    <div class="grid gap-x-10 md:grid-cols-2 lg:col-span-8">
      {content.fit.items.map((item) => (
        <article class="border-t border-border-subtle py-8">
          <h3 class="am-text-subtitle text-balance text-on-surface">{item.title}</h3>
          <div class="mt-5 space-y-4">
            {item.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </article>
      ))}
      {content.fit.action && (
        <a href={content.fit.action.href} class="am-cta-link self-start py-8">{content.fit.action.label}</a>
      )}
    </div>
  </div>
</LocationModule>

<LocationModule
  data-am-stay-module="amara"
>
  <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface-container-low lg:grid-cols-2">
    <figure class="am-mobile-full-bleed min-h-[340px] bg-surface-container-high lg:min-h-[580px]">
      <AmaraImage
        src={content.amara.image.src}
        alt={content.amara.image.alt}
        profile="gallery"
        class="h-full w-full object-cover"
        sizes="(max-width: 1023px) 100vw, 50vw"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
      <p class="am-text-eyebrow text-primary">{content.amara.eyebrow}</p>
      <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{content.amara.title}</h2>
      <div class="mt-7 space-y-5">
        {content.amara.paragraphs.map((paragraph) => (
          <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
        ))}
      </div>
      {content.amara.facts && content.amara.facts.length > 0 && (
        <ul class="mt-7 space-y-3 border-l border-primary/30 pl-5">
          {content.amara.facts.map((fact) => (
            <li class="am-text-body leading-relaxed text-on-surface"><InlineEmphasis text={fact} /></li>
          ))}
        </ul>
      )}
      {content.amara.action && <a href={content.amara.action.href} class="am-cta-link mt-9 inline-flex self-start">{content.amara.action.label}</a>}
    </div>
  </div>
</LocationModule>
