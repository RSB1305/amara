---
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraMediaFrame from '../../components/media/AmaraMediaFrame.astro';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import KiteClusterNav, { type KiteClusterPageId } from '../../components/experience/KiteClusterNav.astro';
import KitePartnerLogoBand from '../../components/experience/KitePartnerLogoBand.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import Navigation from '../../components/Navigation.astro';
import { tarifaKitesurfSpokeContent, type TarifaKitesurfSpokeId } from '../../content/tarifaKitesurfContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import { resolveLocale, type LocalizedText } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';
import LocationModule from './LocationModule.astro';
import { requireRouteImage } from '../../lib/images/routeImages';

/**
 * Practical spokes of the co-branded Tarifa kitesurf cluster (school, camp,
 * gear). The offer cards are the data object of each page: the club's formats
 * and prices with their date, then the evergreen explanation, a named voice,
 * the co-branding band and the closing contact.
 */
interface Props { spoke: TarifaKitesurfSpokeId; lang?: string; }

const { spoke, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const clusterPageId: KiteClusterPageId = ({ 'kite-school': 'school', kitecamp: 'camp', equipment: 'equipment' } as const)[spoke];
const content = resolveLocale(tarifaKitesurfSpokeContent[spoke], currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf spoke');
const aboutHref = requiredLink('about');
const contactHref = `https://wa.me/34604440964?text=${encodeURIComponent(content.closing.contactMessage)}`;
const robertPortrait = '/images/robert-amara-host.jpg';
const hubLabel = { en: 'Kitesurfing in Tarifa', de: 'Kitesurfen in Tarifa', es: 'Kitesurf en Tarifa', nl: 'Kitesurfen in Tarifa', sv: 'Kitesurfing i Tarifa' } satisfies LocalizedText;
const ui = {
  updated: { en: 'As of September 2026', de: 'Stand September 2026', es: 'Actualizado en septiembre de 2026', nl: 'Stand september 2026', sv: 'Uppdaterad september 2026' },
  note: { en: 'Tarifa Surf Club prices as of 3 September 2026.', de: 'Preise des Tarifa Surf Club, Stand 3. September 2026.', es: 'Precios del Tarifa Surf Club, actualizados el 3 de septiembre de 2026.', nl: 'Prijzen van de Tarifa Surf Club, stand 3 september 2026.', sv: 'Tarifa Surf Clubs priser per den 3 september 2026.' },
  relatedEyebrow: { en: 'The same kite stay', de: 'Derselbe Kite-Aufenthalt', es: 'La misma estancia de kite', nl: 'Hetzelfde kiteverblijf', sv: 'Samma kitevistelse' },
  relatedTitle: { en: 'Continue with the next practical detail', de: 'Weiter zum nächsten praktischen Detail', es: 'Seguid con el siguiente detalle práctico', nl: 'Ga verder met het volgende praktische detail', sv: 'Fortsätt med nästa praktiska del' },
  includes: { en: 'Included', de: 'Inklusive', es: 'Incluido', nl: 'Inbegrepen', sv: 'Ingår' },
  beginnerEyebrow: { en: 'New to kiting?', de: 'Neu beim Kiten?', es: '¿Empiezas con el kite?', nl: 'Nieuw met kiten?', sv: 'Ny på kite?' },
  beginnerButton: { en: 'Open the beginner guide', de: 'Zum Anfänger-Guide', es: 'Abrir la guía de iniciación', nl: 'Naar de beginnersgids', sv: 'Till nybörjarguiden' },
  partnerVoiceTitle: { en: 'How Mark teaches', de: 'Wie Mark unterrichtet', es: 'Cómo enseña Mark', nl: 'Hoe Mark lesgeeft', sv: 'Så undervisar Mark' }
} satisfies Record<string, LocalizedText>;
const t = (value: LocalizedText) => value[currentLang];
// The beginner guide leads the school page as a highlighted callout near the top,
// so it is pulled out of the "continue" cards to avoid a duplicate link.
const beginnerGuide = content.related.find((link) => link.token === 'tarifa_kitesurf_beginner_guide');
const relatedCards = content.related.filter((link) => link.token !== 'tarifa_kitesurf_beginner_guide');
const routeKey = ({ 'kite-school': 'tarifa.kitesurfing.school', kitecamp: 'tarifa.kitesurfing.kitecamp', equipment: 'tarifa.kitesurfing.equipment' } as const)[spoke];
const heroPhoto = requireRouteImage(routeKey, 'hero', currentLang);
const photo = requireRouteImage(routeKey, 'photo', currentLang);
const markImage = requireRouteImage('tarifa.kitesurfing.surf-club', 'mark', currentLang);
const footerHighlights: LabeledLink[] = [
  { token: 'tarifa_kitesurfing_hub', label: t(hubLabel) },
  ...content.related.slice(0, 3).map((item) => ({ token: item.token, label: item.label }))
];
---

<LocationAuthorityLayout seo={tarifaKitesurfSpokeContent[spoke].seo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights} pageFamily="experience-tarifa-kite-spoke">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken={content.token}>
    <ExperienceContextNav slot="context-navigation" currentId="kitesurfing" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="am-tarifa-surface overflow-x-clip bg-surface" data-am-page={`tarifa-${content.id}`} data-am-family="experience" data-am-role="spoke" data-am-topic={content.id}>
    <KiteClusterNav lang={currentLang} currentId={clusterPageId} />

    <LocationGuideHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      subtitle={content.hero.subtitle}
      paragraphs={[content.hero.lead]}
      family="experience"
      role="spoke"
      topic={content.id}
      visualBreakpoint="lg"
    >
      <EditorialByline slot="meta" lang={currentLang} authorName="Robert Sebastian Böhmer" authorHref={aboutHref} updated={t(ui.updated)} note={t(ui.note)} />
      <AmaraImage
        slot="visual"
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        profile="hero"
        width={1080}
        widths={[480, 640, 800, 1080]}
        sizes="(max-width: 1023px) 100vw, 36vw"
        class:list={['w-full object-cover', spoke === 'kitecamp' ? 'aspect-[3/2]' : 'aspect-[3/4]']}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </LocationGuideHero>

    <LocationModule id="facts" labelledby="facts-title" surface="tint" spacing="compact" data-am-topic="facts">
      <dl class="mx-auto grid max-w-screen-2xl gap-6 md:grid-cols-3" aria-labelledby="facts-title">
        <h2 id="facts-title" class="sr-only">{content.hero.title}</h2>
        {content.facts.map((fact) => (
          <div class="border-l-2 border-primary/35 pl-5" data-fact={fact.id}>
            <dt class="am-text-label am-text-label--sm text-on-surface-variant">{fact.label}</dt>
            <dd class="am-text-subtitle mt-2 text-on-surface">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </LocationModule>

    {beginnerGuide && (
      <LocationModule id="beginner-guide-cta" spacing="compact" data-am-topic="beginner-guide-cta">
        <div class="mx-auto max-w-screen-2xl">
          <a
            href={requiredLink(beginnerGuide.token)}
            class="group block border-l-4 border-primary bg-primary/10 px-6 py-7 transition-colors hover:bg-primary/15 md:px-10 md:py-8 lg:flex lg:items-center lg:justify-between lg:gap-10"
          >
            <div class="max-w-2xl">
              <p class="am-text-eyebrow text-primary">{t(ui.beginnerEyebrow)}</p>
              <h2 class="am-text-subtitle mt-3 text-on-surface transition-colors group-hover:text-primary">{beginnerGuide.label}</h2>
              <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{beginnerGuide.text}</p>
            </div>
            <span class="am-btn am-btn--primary mt-6 justify-center lg:mt-0 lg:shrink-0">
              {t(ui.beginnerButton)}
              <span aria-hidden="true" class="ml-2 inline-flex transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        </div>
      </LocationModule>
    )}

    <LocationModule id="offers" labelledby="offers-title" spacing="compact" data-am-topic="offers">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{content.offers.eyebrow}</p>
          <h2 id="offers-title" class="am-text-title mt-5 text-balance text-on-surface">{content.offers.title}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{content.offers.intro}</p>
        </div>
        <div class:list={['mt-10 grid gap-5 md:grid-cols-2', content.offers.items.length > 3 ? 'xl:grid-cols-4' : 'xl:grid-cols-3']}>
          {content.offers.items.map((offer) => (
            <section id={offer.id} class="flex min-w-0 scroll-mt-32 flex-col border-l-2 border-primary/35 bg-surface-container-low px-6 py-7" aria-labelledby={`offer-${offer.id}`} data-offer={offer.id}>
              <h3 id={`offer-${offer.id}`} class="am-text-subtitle text-on-surface">{offer.title}</h3>
              <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{offer.detail}</p>
              <p class="am-text-title mt-6 tabular-nums text-on-surface">{offer.price}</p>
              <p class="am-text-caption mt-1 normal-case tracking-normal text-muted">{offer.priceNote}</p>
              <p class="am-text-label am-text-label--sm mt-6 text-primary">{t(ui.includes)}</p>
              <ul class="mt-3 space-y-2">
                {offer.includes.map((item) => (
                  <li class="flex gap-3 am-text-body leading-relaxed text-on-surface-variant">
                    <span aria-hidden="true" class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="am-text-caption mt-6 max-w-3xl normal-case tracking-normal text-muted">{content.offers.stand}</p>
        <AmaraActionLink href={content.offers.href} variant="editorial" external class="mt-5 inline-flex">{content.offers.linkLabel}</AmaraActionLink>
      </div>
    </LocationModule>

    {content.partnerQuotes && content.partnerQuotes.length > 0 && (
      <LocationModule id="from-mark" labelledby="from-mark-title" spacing="compact" data-am-topic="partner-voice">
        <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
          <figure class="m-0 lg:col-span-4" data-am-voice="mark">
            <AmaraImage src={markImage.src} alt={markImage.alt} profile="card" width={900} widths={[320, 480, 600, 900]} sizes="(max-width: 1023px) calc(100vw - 3rem), 30vw" class="aspect-[3/4] w-full max-w-sm object-cover" />
            <figcaption class="am-text-label am-text-label--sm mt-4 text-primary">{content.partnerQuotes[0].name} · {content.partnerQuotes[0].role}</figcaption>
          </figure>
          <div class="lg:col-span-8">
            <h2 id="from-mark-title" class="am-text-title text-balance text-on-surface">{t(ui.partnerVoiceTitle)}</h2>
            <div class="mt-8 space-y-8">
              {content.partnerQuotes.map((quote) => (
                <blockquote class="m-0" data-am-voice-quote={quote.id}>
                  <p class="am-text-subtitle max-w-3xl leading-relaxed text-on-surface">{quote.text}</p>
                </blockquote>
              ))}
            </div>
          </div>
        </div>
      </LocationModule>
    )}

    {content.sections.map((section, index) => (
      <LocationModule id={section.id} labelledby={`${section.id}-title`} surface={index % 2 === 0 ? 'tint' : 'white'} spacing="compact" data-am-topic="explanation">
        <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="am-text-eyebrow text-primary">{section.eyebrow}</p>
            <h2 id={`${section.id}-title`} class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{section.title}</h2>
          </div>
          <div class="lg:col-span-7">
            <div class="space-y-5">
              {section.paragraphs.map((paragraph) => <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{paragraph}</p>)}
            </div>
            {section.href && section.linkLabel && (
              <AmaraActionLink href={section.href} variant="editorial" external class="mt-7 inline-flex">{section.linkLabel}</AmaraActionLink>
            )}
          </div>
        </div>
      </LocationModule>
    ))}

    {/* Panorama band with the voice of the house rising into it (Tarifa art direction). */}
    <section class="bg-surface" data-am-topic="editorial-photo">
      <AmaraMediaFrame role="panorama">
        <AmaraImage src={photo.src} alt={photo.alt} profile="background" class="h-full w-full object-cover" focalPoint={photo.focalPoint} />
      </AmaraMediaFrame>
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12 lg:flex lg:items-start lg:gap-8">
        {content.quote ? (
          <figure id="voice" class="am-overlap-up flex items-start gap-5 bg-surface pb-12 pt-10 md:gap-8" data-am-topic="voice" data-am-voice={content.quote.portrait} aria-labelledby="voice-title">
            <AmaraImage src={content.quote.portrait === 'mark' ? markImage.src : robertPortrait} alt={content.quote.name} profile="card" width={192} widths={[96, 144, 192]} sizes="5rem" class="h-16 w-16 shrink-0 rounded-full object-cover md:h-20 md:w-20" />
            <div class="min-w-0">
              <h2 id="voice-title" class="sr-only">{content.quote.name}</h2>
              <blockquote class="m-0"><p class="am-text-quote max-w-3xl text-balance text-on-surface">{content.quote.text}</p></blockquote>
              <figcaption class="am-text-label am-text-label--sm mt-5 text-primary">— {content.quote.name} · {content.quote.role}</figcaption>
            </div>
          </figure>
        ) : null}
        <p class="am-text-caption mt-3 normal-case tracking-normal text-muted lg:flex-1 lg:text-right">{photo.caption}</p>
      </div>
    </section>

    <LocationModule id="related" labelledby="related-title" surface="tint" spacing="compact" data-am-topic="related">
      <div class="mx-auto max-w-screen-2xl">
        <p class="am-text-eyebrow text-primary">{t(ui.relatedEyebrow)}</p>
        <h2 id="related-title" class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{t(ui.relatedTitle)}</h2>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {relatedCards.map((link) => (
            <AmaraActionLink href={requiredLink(link.token)} variant="card" class="group bg-surface px-6 pb-8 pt-7 transition-colors hover:bg-surface-container-lowest">
              <h3 class="am-text-subtitle text-on-surface transition-colors group-hover:text-primary">{link.label}</h3>
              <span class="am-text-body mt-4 block leading-relaxed text-on-surface-variant">{link.text}</span>
              <span aria-hidden="true" class="mt-6 inline-flex text-primary transition-transform group-hover:translate-x-1">→</span>
            </AmaraActionLink>
          ))}
        </div>
      </div>
    </LocationModule>

    <LocationModule id="closing" labelledby="closing-title" spacing="closing" data-am-topic="closing">
      <div class="mx-auto max-w-4xl text-center">
        <h2 id="closing-title" class="am-text-title text-balance text-on-surface">{content.closing.title}</h2>
        <p class="am-text-body mx-auto mt-6 max-w-3xl leading-relaxed text-on-surface-variant">{content.closing.text}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={contactHref} target="_blank" rel="noopener noreferrer" class="am-btn am-btn--primary w-full justify-center sm:w-auto">{content.closing.contactLabel}</a>
          <a href={requiredLink('tarifa_kitesurfing_hub')} class="am-btn am-btn--secondary w-full justify-center sm:w-auto">{t(hubLabel)}</a>
        </div>
      </div>
    </LocationModule>

    <KitePartnerLogoBand lang={currentLang} />
  </article>
</LocationAuthorityLayout>
