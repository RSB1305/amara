---
import tarifaSurfClubTeamImage from '../../assets/images/content/tarifa/tarifa-surf-club-team.webp';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import TarifaWindBriefing from '../../components/TarifaWindBriefing.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import { tarifaKitesurfSpokeContent, type LocalizedKiteText, type TarifaKitesurfSpokeId } from '../../content/tarifaKitesurfContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props { spoke: TarifaKitesurfSpokeId; lang?: string; }

const { spoke, lang = 'es' } = Astro.props;
const content = tarifaKitesurfSpokeContent[spoke];
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const t = (value: LocalizedKiteText) => value[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf spoke');
const aboutHref = requiredLink('about');
const contactHref = `https://wa.me/34604440964?text=${encodeURIComponent(t(content.closing.contactMessage))}`;
const localizedSections = content.sections.map((section) => ({ id: section.id, eyebrow: t(section.eyebrow), title: t(section.title), paragraphs: section.paragraphs.map(t) }));
const hubLabel = { en: 'Kitesurfing in Tarifa', de: 'Kitesurfen in Tarifa', es: 'Kitesurf en Tarifa', nl: 'Kitesurfen in Tarifa', sv: 'Kitesurfing i Tarifa' } satisfies LocalizedKiteText;
const footerHighlights: LabeledLink[] = [
  { token: 'tarifa_wind_kitesurfing_authority', label: t(hubLabel) },
  ...content.related.slice(0, 3).map((item) => ({ token: item.token, label: t(item.label) }))
];

const ui = {
  relatedEyebrow: { en: 'The same kite stay', de: 'Derselbe Kite-Aufenthalt', es: 'La misma estancia de kite', nl: 'Hetzelfde kiteverblijf', sv: 'Samma kitevistelse' },
  relatedTitle: { en: 'Continue with the next practical detail', de: 'Weiter zum nächsten praktischen Detail', es: 'Seguid con el siguiente detalle práctico', nl: 'Ga verder met het volgende praktische detail', sv: 'Fortsätt med nästa praktiska del' }
} satisfies Record<string, LocalizedKiteText>;
---

<LocationAuthorityLayout seo={content.seo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights} pageFamily="experience-tarifa-kite-spoke">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken={content.token}>
    <ExperienceContextNav slot="context-navigation" currentId="wind" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page={`tarifa-${content.id}`} data-am-family="experience" data-am-role="spoke" data-am-topic={content.id}>
    <LocationExperienceHero
      eyebrow={t(content.hero.eyebrow)}
      title={t(content.hero.title)}
      subtitle={t(content.hero.subtitle)}
      paragraphs={[t(content.hero.lead)]}
      imageSrc={tarifaSurfClubTeamImage}
      imageAlt={t(content.hero.imageAlt)}
      imageWidth={1200}
      role="spoke"
      topic={content.id}
      byline={{ lang: currentLang, authorName: content.seo.article!.authorName, authorHref: aboutHref, updated: currentLang === 'de' ? 'Geprüft im September 2026' : currentLang === 'es' ? 'Revisado en septiembre de 2026' : currentLang === 'nl' ? 'Gecontroleerd in september 2026' : currentLang === 'sv' ? 'Granskad i september 2026' : 'Reviewed September 2026', note: t(content.hero.subtitle) }}
    />

    <section class="bg-surface-container-low px-6 py-12 md:px-12 md:py-16">
      <dl class="mx-auto grid max-w-screen-2xl gap-8 md:grid-cols-3">
        {content.facts.map((fact) => (
          <div class="border-l border-primary/25 pl-5">
            <dt class="am-text-label am-text-label--sm text-on-surface-variant">{t(fact.label)}</dt>
            <dd class="am-text-subtitle mt-2 text-on-surface">{t(fact.value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {spoke === 'wind-spots-safety' && <TarifaWindBriefing lang={currentLang} />}

    {localizedSections.map((section, index) => <AuthorityTextSection section={section} index={index} />)}

    <aside class="bg-inverse-surface px-6 py-20 text-inverted-on-surface md:px-12 md:py-24">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5"><h2 class="am-text-title max-w-xl text-balance text-inverted-on-surface">{t(content.partner.title)}</h2></div>
        <div class="lg:col-span-7">
          <p class="am-text-body max-w-3xl leading-relaxed text-inverted-on-surface/80">{t(content.partner.text)}</p>
          <a href={content.partner.href} target="_blank" rel="noopener noreferrer" class="am-cta-link mt-7 inline-flex text-primary-fixed-dim">{t(content.partner.label)} ↗</a>
        </div>
      </div>
    </aside>

    <section class="bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <p class="am-text-eyebrow text-primary">{t(ui.relatedEyebrow)}</p>
        <h2 class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{t(ui.relatedTitle)}</h2>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {content.related.map((link) => (
            <AmaraActionLink href={requiredLink(link.token)} variant="card" class="group bg-surface px-6 pb-8 pt-7 transition-colors hover:bg-surface-container-lowest">
              <h3 class="am-text-subtitle text-on-surface transition-colors group-hover:text-primary">{t(link.label)}</h3>
              <span class="am-text-body mt-4 block leading-relaxed text-on-surface-variant">{t(link.text)}</span>
              <span aria-hidden="true" class="mt-6 inline-flex text-primary transition-transform group-hover:translate-x-1">→</span>
            </AmaraActionLink>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="am-text-title text-balance text-on-surface">{t(content.closing.title)}</h2>
        <p class="am-text-body mx-auto mt-6 max-w-3xl leading-relaxed text-on-surface-variant">{t(content.closing.text)}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={contactHref} target="_blank" rel="noopener noreferrer" class="am-btn am-btn--primary w-full justify-center sm:w-auto">{t(content.closing.contactLabel)}</a>
          <a href={requiredLink('tarifa_wind_kitesurfing_authority')} class="am-btn am-btn--secondary w-full justify-center sm:w-auto">{t(hubLabel)}</a>
        </div>
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
