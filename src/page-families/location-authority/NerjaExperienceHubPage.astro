---
import { resolveLocale } from '../../types/content';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import ExperienceHubTopicGrid from '../../components/experience/ExperienceHubTopicGrid.astro';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  nerjaExperienceHubContent,
  nerjaExperienceHubSeo
} from '../../content/nerjaExperienceHubContent';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = resolveLocale(nerjaExperienceHubContent, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja experience hub');

const themes = copy.themes.map((theme) => ({
  ...theme,
  href: resolveOptionalLink(theme.token, currentLang, { suppressMissing: true })
}));
const toTopic = (theme: (typeof themes)[number]) => ({
  id: `experience-${theme.id}`,
  title: theme.title,
  text: theme.text,
  href: theme.href ?? undefined,
  linkLabel: theme.linkLabel
});
const featuredThemeTopics = themes.slice(0, 4).map(toTopic);
const additionalThemeTopics = themes.slice(4).map(toTopic);

const footerHighlights: LabeledLink[] = [
  { token: 'nerja_experience_hub', label: copy.hero.eyebrow },
  ...copy.themes.slice(0, 2).map((theme) => ({ token: theme.token, label: theme.title }))
];
---

<LocationAuthorityLayout
  seo={nerjaExperienceHubSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
  pageFamily="experience-nerja-hub"
>
  <Navigation
    slot="navigation"
    contextDestination="nerja"
    currentLang={currentLang}
    currentToken="nerja_experience_hub"
    languageToken="nerja_experience_hub"
  >
    <ExperienceContextNav slot="context-navigation" destination="nerja" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="nerja-experience-hub" data-am-family="experience" data-am-role="hub">
    <LocationExperienceHero
      role="hub"
      topic="overview"
      eyebrow={copy.hero.eyebrow}
      title={copy.hero.title}
      paragraphs={[copy.hero.standfirst]}
      imageSrc="/images/amara-frigiliana-pueblo/nerja-coast-aerial.jpeg"
      imageAlt={copy.hero.imageAlt}
      imageWidth={2000}
      actions={[
        { href: '#experiences', label: copy.intro.eyebrow, style: 'primary' }
      ]}
    />

    <section id="experiences" class="am-section am-section--plain">
      <div class="grid grid-cols-1 gap-10 border-b border-outline-variant/20 pb-14 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="am-text-caption mb-5 text-primary">{copy.intro.eyebrow}</p>
          <h2 class="am-text-title max-w-4xl text-balance italic tracking-tight text-on-surface">
            {copy.intro.title}
          </h2>
        </div>
        <p class="am-text-body leading-relaxed text-on-surface-variant lg:col-span-5">
          {copy.intro.text}
        </p>
      </div>

      <div class="mt-16"><ExperienceHubTopicGrid topics={featuredThemeTopics} columns={4} /></div>

      <div class="mt-20 grid grid-cols-1 gap-10 border-t border-outline-variant/20 pt-14 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="am-text-caption mb-5 text-primary">{copy.moreThemes.eyebrow}</p>
          <h2 class="am-text-title max-w-4xl text-balance italic tracking-tight text-on-surface">
            {copy.moreThemes.title}
          </h2>
        </div>
        <p class="am-text-body leading-relaxed text-on-surface-variant lg:col-span-5">
          {copy.moreThemes.text}
        </p>
      </div>

      <div class="mt-12"><ExperienceHubTopicGrid topics={additionalThemeTopics} /></div>
    </section>

    <AuthorityStayBridge
      eyebrow={copy.closing.eyebrow}
      title={copy.closing.title}
      reason={copy.closing.text}
      stayHref={requiredLink('playa')}
      stayLabel={copy.closing.stayLabel}
      availabilityHref={requiredLink('book')}
      availabilityLabel={experienceStayBridge.availabilityLabel[currentLang]}
    />
  </article>
</LocationAuthorityLayout>
