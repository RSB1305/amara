---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialFeatureGrid from '../../components/editorial/EditorialFeatureGrid.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import AmaraMediaFrame from '../../components/media/AmaraMediaFrame.astro';
import type { ImageMetadata } from 'astro';
import historicVillageImage from '../../assets/images/content/frigiliana/frigiliana-historisches-foto-dorf-panorama.jpg';
import elIngenioImage from '../../assets/images/content/frigiliana/frigiliana-el-ingenio-palast-zuckerrohrfabrik.jpg';
import roofscapeImage from '../../assets/images/content/frigiliana/frigiliana-luftaufnahme-daecher-mosaik-gasse.jpg';
import ceramicPanelsImage from '../../assets/images/content/frigiliana/frigiliana-keramiktafel-morisken-landwirtschaft.jpg';
import calleRealImage from '../../assets/images/content/frigiliana/frigiliana-mann-auf-maultier-altstadtgasse.jpg';
import barribartoImage from '../../assets/images/content/frigiliana/frigiliana-gasse-bogen-kieselmosaik-abend.jpg';
import {
  frigilianaOldTownCopy,
  frigilianaOldTownExternalLinks,
  frigilianaOldTownSeo
} from '../../content/frigilianaOldTownContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import { routeHero } from '../../lib/images/routeImages';
import GuideLinkCardSection from './GuideLinkCardSection.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = routeHero('frigiliana.experience.old-town', currentLang);
const copy = frigilianaOldTownCopy;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_old_town',
    label: t(copy.footerHighlights.oldTown)
  },
  {
    token: 'frigiliana_events_authority',
    label: t(copy.footerHighlights.festivals)
  },
  {
    token: 'frigiliana_market',
    label: t(copy.footerHighlights.market)
  }
];

const sights = copy.sights.items.map((item) => ({
  title: t(item.title),
  subline: t(item.subline),
  text: t(item.text)
}));

/**
 * Card media aligned to `copy.sights.items` by index. Casa del Apero (index 2)
 * and the Iglesia de San Antonio (index 3) have no dedicated photograph, so
 * they render as typographic tiles rather than an empty image frame.
 */
const sightMedia: ReadonlyArray<{
  image?: ImageMetadata;
  alt?: LocalizedRow;
  focalPoint?: string;
  href?: string;
  linkLabel?: LocalizedRow;
}> = [
  {
    image: ceramicPanelsImage,
    alt: {
      en: 'Hand-painted ceramic panel in Frigiliana’s old town showing a scene of the Morisco story',
      de: 'Handbemalte Keramiktafel in Frigilianas Altstadt mit einer Szene der Morisken-Geschichte',
      es: 'Panel de cerámica pintado a mano en el casco antiguo de Frigiliana con una escena de la historia morisca',
      nl: 'Handbeschilderd keramisch paneel in de oude kern van Frigiliana met een scène uit de Moriskse geschiedenis',
      sv: 'Handmålad keramikpanel i Frigilianas gamla stan med en scen ur den moriskiska historien'
    },
    focalPoint: '50% 50%',
    href: resolveOptionalLink('frigiliana_ceramic_panels', currentLang, { suppressMissing: true }) ?? undefined,
    linkLabel: {
      en: 'All twelve panels, with the original texts',
      de: 'Alle zwölf Tafeln, mit den Originaltexten',
      es: 'Los doce azulejos, con los textos originales',
      nl: 'Alle twaalf panelen, met de originele teksten',
      sv: 'Alla tolv panelerna, med originaltexterna'
    }
  },
  {
    image: elIngenioImage,
    alt: {
      en: 'El Ingenio, the former sugar works, at the lower edge of Frigiliana’s old town',
      de: 'El Ingenio, das ehemalige Zuckerwerk, am unteren Rand von Frigilianas Altstadt',
      es: 'El Ingenio, la antigua fábrica azucarera, en el borde bajo del casco antiguo de Frigiliana',
      nl: 'El Ingenio, de voormalige suikerfabriek, aan de onderrand van de oude kern van Frigiliana',
      sv: 'El Ingenio, det före detta sockerbruket, i nedre kanten av Frigilianas gamla stan'
    },
    focalPoint: '50% 45%',
    href: resolveOptionalLink('frigiliana_ingenio', currentLang, { suppressMissing: true }) ?? undefined,
    linkLabel: {
      en: 'El Ingenio: palace, sugar works and the ibex on the roof',
      de: 'El Ingenio: Palast, Zuckerwerk und die Steinböcke auf dem Dach',
      es: 'El Ingenio: palacio, ingenio azucarero y las cabras del tejado',
      nl: 'El Ingenio: paleis, suikerfabriek en de steenbokken op het dak',
      sv: 'El Ingenio: palats, sockerbruk och stenbockarna på taket'
    }
  },
  {
    href: resolveOptionalLink('frigiliana_casa_del_apero', currentLang, { suppressMissing: true }) ?? undefined,
    linkLabel: {
      en: 'Casa del Apero: the farm store that became the cultural centre',
      de: 'Casa del Apero: der Wirtschaftshof, der zum Kulturzentrum wurde',
      es: 'Casa del Apero: el almacén agrícola que se hizo centro cultural',
      nl: 'Casa del Apero: de boerenopslag die cultureel centrum werd',
      sv: 'Casa del Apero: lantbruksmagasinet som blev kulturcentrum'
    }
  },
  {
    href: resolveOptionalLink('frigiliana_san_antonio', currentLang, { suppressMissing: true }) ?? undefined,
    linkLabel: {
      en: 'San Antonio de Padua: the 1676 parish church',
      de: 'San Antonio de Padua: die Pfarrkirche von 1676',
      es: 'San Antonio de Padua: la parroquia de 1676',
      nl: 'San Antonio de Padua: de parochiekerk uit 1676',
      sv: 'San Antonio de Padua: sockenkyrkan från 1676'
    }
  },
  {
    image: calleRealImage,
    alt: {
      en: 'A man on a mule in a lane of Frigiliana’s old town',
      de: 'Ein Mann auf einem Maultier in einer Gasse von Frigilianas Altstadt',
      es: 'Un hombre a lomos de un mulo por una calle del casco antiguo de Frigiliana',
      nl: 'Een man op een muildier in een straatje van de oude kern van Frigiliana',
      sv: 'En man på en mulåsna i en gränd i Frigilianas gamla stan'
    },
    focalPoint: '50% 50%'
  },
  {
    image: barribartoImage,
    alt: {
      en: 'Stepped lane with an arch and pebble mosaic in the upper old town of Frigiliana at dusk',
      de: 'Treppengasse mit Bogen und Kieselmosaik im oberen Altstadtviertel von Frigiliana in der Abenddämmerung',
      es: 'Calle escalonada con arco y mosaico de guijarros en la parte alta del casco antiguo de Frigiliana al anochecer',
      nl: 'Trapstraat met boog en kiezelmozaïek in de hoge oude kern van Frigiliana in de schemering',
      sv: 'Trappgränd med valv och kiselmosaik i övre gamla stan i Frigiliana i skymningen'
    },
    focalPoint: '50% 50%'
  }
];

const historySteps = copy.history.items.map((item) => ({
  title: t(item.title),
  subline: t(item.subline),
  text: t(item.text)
}));

const preservedCards = copy.preserved.items.map((item) => ({
  title: t(item.title),
  copy: t(item.text)
}));

const heritageItems = copy.livingHeritage.items.map((item) => ({
  title: t(item.title),
  text: t(item.text)
}));

const combineItems = copy.combine.items.map((item) => ({
  title: t(item.title),
  text: t(item.text),
  linkLabel: t(item.linkLabel),
  href: resolveOptionalLink(item.token, currentLang, { suppressMissing: true })
}));

const visualAlts = {
  history: {
    en: 'Historic photograph of Frigiliana below the Peñón, with the old sugar-works chimneys',
    de: 'Historische Aufnahme von Frigiliana unterhalb des Peñón, mit den Schornsteinen des alten Zuckerwerks',
    es: 'Fotografía histórica de Frigiliana bajo el Peñón, con las chimeneas del antiguo ingenio',
    nl: 'Historische foto van Frigiliana onder de Peñón, met de schoorstenen van de oude suikerfabriek',
    sv: 'Historiskt fotografi av Frigiliana nedanför Peñón, med skorstenarna från det gamla sockerbruket'
  },
  heritage: {
    en: 'Aerial view of Frigiliana’s tiled roofs and a pebble-mosaic lane',
    de: 'Luftaufnahme von Frigilianas Ziegeldächern und einer Kieselmosaik-Gasse',
    es: 'Vista aérea de los tejados de Frigiliana y una calle con mosaico de guijarros',
    nl: 'Luchtfoto van de pannendaken van Frigiliana en een straat met kiezelmozaïek',
    sv: 'Flygbild över Frigilianas tegeltak och en gränd med kiselmosaik'
  }
} as const satisfies Record<string, LocalizedRow>;
---

<LocationAuthorityLayout
  pageFamily="experience-frigiliana-old-town"
  seo={frigilianaOldTownSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_old_town"
  >
    <ExperienceContextNav slot="context-navigation" currentId="oldTown" destination="frigiliana" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-old-town">
    <div class="w-full">
      <div id="intro">
        <LocationExperienceHero
          topic="old-town"
          eyebrow={t(copy.hero.kicker)}
          title={t(copy.hero.title)}
          subtitle={t(copy.hero.subtitle)}
          paragraphs={copy.hero.paragraphs.map((paragraph) => t(paragraph))}
          {...hero}
        />
      </div>

      <section id="sights" class="am-section bg-surface">
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {t(copy.sights.title)}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.sights.intro)}
          </p>
        </div>

        <div class="am-oldtown-sights grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            sights.map((item, index) => {
              const media = sightMedia[index];
              const number = String(index + 1).padStart(2, '0');
              return (
                <article class="am-oldtown-sight" data-has-photo={media?.image ? 'true' : undefined}>
                  <AmaraMediaFrame
                    role="card"
                    interactive={Boolean(media?.image)}
                    class="am-oldtown-sight__frame"
                  >
                    {media?.image ? (
                      <AmaraImage
                        src={media.image}
                        alt={media.alt ? t(media.alt) : item.title}
                        profile="card"
                        class="h-full w-full object-cover"
                        mediaRole="card"
                        focalPoint={media.focalPoint}
                      />
                    ) : (
                      <div class="am-oldtown-sight__typo">
                        <span class="am-oldtown-sight__typo-number" aria-hidden="true">
                          {number}
                        </span>
                      </div>
                    )}
                  </AmaraMediaFrame>

                  <div class="am-oldtown-sight__body">
                    {media?.image ? (
                      <span class="am-text-subtitle italic text-primary/55 block mb-1" aria-hidden="true">
                        {number}
                      </span>
                    ) : null}
                    <h3 class="am-text-subtitle text-on-surface mb-2">
                      {item.title}
                    </h3>
                    <p class="am-text-caption normal-case tracking-normal text-primary mb-3">
                      {item.subline}
                    </p>
                    <p class="am-text-body text-on-surface-variant leading-relaxed">
                      {item.text}
                    </p>
                    {media?.href && media?.linkLabel ? (
                      <a href={media.href} class="am-inline-link mt-4 inline-block">
                        {t(media.linkLabel)}
                        <span aria-hidden="true"> &rarr;</span>
                      </a>
                    ) : null}
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section id="history" class="am-section bg-surface-container-low">
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {t(copy.history.title)}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.history.intro)}
          </p>
        </div>

        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <AmaraMediaFrame role="gallery" mobileFullBleed class="lg:col-span-5 lg:self-start">
            <AmaraImage
              src={historicVillageImage}
              alt={t(visualAlts.history)}
              profile="gallery"
              class="h-full w-full object-cover"
              mediaRole="gallery"
              focalPoint="50% 50%"
            />
          </AmaraMediaFrame>

          <div class="space-y-10 lg:col-span-6 lg:col-start-7">
            {
              historySteps.map((item, index) => (
                <article class="grid grid-cols-[2.75rem_minmax(0,1fr)] gap-5 border-t border-outline-variant/30 pt-7">
                  <span class="am-text-subtitle italic text-primary/55" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="am-text-subtitle text-on-surface mb-3">
                      {item.title}
                    </h3>
                    <p class="am-text-caption normal-case tracking-normal text-primary mb-4">
                      {item.subline}
                    </p>
                    <p class="am-text-body text-on-surface-variant leading-relaxed">
                      {item.text}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="preserved" class="am-section bg-surface">
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {t(copy.preserved.title)}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.preserved.intro)}
          </p>
        </div>

        <EditorialFeatureGrid cards={preservedCards} />
      </section>

      <div class="bg-surface px-6 pb-16 md:px-12 md:pb-24">
        <div class="mx-auto max-w-screen-2xl">
          <AmaraMediaFrame role="editorial" mobileFullBleed>
            <AmaraImage
              src={roofscapeImage}
              alt={t(visualAlts.heritage)}
              profile="gallery"
              class="h-full w-full object-cover"
              mediaRole="editorial"
              focalPoint="50% 50%"
            />
          </AmaraMediaFrame>
        </div>
      </div>

      <section id="living-heritage" class="am-section bg-surface-container-low">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
              {t(copy.livingHeritage.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.livingHeritage.intro)}
            </p>
          </div>

          <div class="grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
            {
              heritageItems.map((item) => (
                <article class="border-t border-outline-variant/30 pt-7">
                  <h3 class="am-text-subtitle text-on-surface mb-5">
                    {item.title}
                  </h3>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {item.text}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <GuideLinkCardSection
        title={t(copy.combine.title)}
        intro={t(copy.combine.intro)}
        items={combineItems}
        surface="surface"
        columns={3}
      />

      <GuestGuideBridge
        lang={currentLang}
        destination="frigiliana"
        guideSlugs={['frigiliana-guest-sightseeing']}
      />

      <section class="am-section bg-surface-container-low">
        <div class="max-w-3xl">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {t(copy.sources.title)}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.sources.text)}
          </p>
          <p class="mt-6 am-text-body">
            <a
              href={frigilianaOldTownExternalLinks.officialMonuments}
              class="am-inline-link"
              target="_blank"
              rel="noopener"
            >
              {t(copy.sources.linkLabel)}
              <span aria-hidden="true"> &rarr;</span>
            </a>
          </p>
        </div>
      </section>

      <section class="max-w-screen-2xl mx-auto px-6 pt-24 pb-24 md:px-12">
        <EditorialClosingCta
          title={t(copy.closing.title)}
          lead={t(copy.closing.lead)}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: t(copy.closing.apartmentsCta),
              style: 'primary'
            },
            {
              token: 'book',
              label: t(copy.closing.availabilityCta),
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  /* Old-town sights, Muster C: uniform image tiles; the two sights without a
     dedicated photograph (Casa del Apero, Iglesia de San Antonio) fall back to
     a typographic tile so the grid stays whole without an empty image frame. */
  .am-oldtown-sight {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface-white);
    border-radius: var(--radius-overlay);
  }

  .am-oldtown-sight__body {
    flex: 1;
    padding: 1.4rem 1.5rem 1.75rem;
  }

  .am-oldtown-sight:not([data-has-photo]) .am-oldtown-sight__body {
    background: var(--color-surface-container-low);
  }

  .am-oldtown-sight__typo {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 1.4rem 1.5rem;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-primary) 88%, black),
      color-mix(in srgb, var(--color-primary) 60%, black)
    );
  }

  .am-oldtown-sight__typo-number {
    font-family: var(--font-headline);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    font-size: clamp(3rem, 6vw, 4.5rem);
    color: color-mix(in srgb, var(--color-surface-white) 82%, transparent);
  }
</style>
