---
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  dailyLifeGuideContent,
  dailyLifeGuideSeo,
  type DailyLifeDestination,
  type DailyLifeTopic
} from '../../content/dailyLifeGuideContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink, type LinkToken } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import DailyLifeGuideSections from './DailyLifeGuideSections.astro';
import { getLocationGuideTopicLabels } from '../../lib/location/locationGuideTopics';

interface Props {
  destination: DailyLifeDestination;
  topic: DailyLifeTopic;
  lang?: string;
}

const { destination, topic, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = dailyLifeGuideContent[destination][topic][currentLang];
const seo = dailyLifeGuideSeo[destination][topic];

const config: Record<DailyLifeDestination, {
  label: string;
  shoppingToken: LinkToken;
  healthToken: LinkToken;
  locationToken: LinkToken;
  arrivalToken: LinkToken;
  parkingToken: LinkToken;
}> = {
  frigiliana: { label: 'Frigiliana', shoppingToken: 'frigiliana_daily_life', healthToken: 'frigiliana_health_emergency', locationToken: 'location_frigiliana', arrivalToken: 'getting_to_frigiliana', parkingToken: 'frigiliana_parking' },
  nerja: { label: 'Nerja', shoppingToken: 'nerja_daily_life', healthToken: 'nerja_health_emergency', locationToken: 'location_nerja', arrivalToken: 'getting_to_nerja', parkingToken: 'nerja_parking' },
  tarifa: { label: 'Tarifa', shoppingToken: 'tarifa_daily_life', healthToken: 'tarifa_health_emergency', locationToken: 'location_tarifa', arrivalToken: 'getting_to_tarifa', parkingToken: 'tarifa_parking' }
};

const pageConfig = config[destination];
const languageToken = topic === 'shopping-markets' ? pageConfig.shoppingToken : pageConfig.healthToken;
const siblingToken = topic === 'shopping-markets' ? pageConfig.healthToken : pageConfig.shoppingToken;
const siblingTopic: DailyLifeTopic = topic === 'shopping-markets' ? 'health-emergency' : 'shopping-markets';
const requiredLink = createRequiredLinkResolver(currentLang, `${pageConfig.label} ${topic}`);
const aboutHref = requiredLink('about');
const availabilityHref = requiredLink('book');
const locationHref = requiredLink(pageConfig.locationToken);

const footerHighlights: LabeledLink[] = [
  { token: languageToken, label: content.navLabel },
  { token: siblingToken, label: getLocationGuideTopicLabels(currentLang)[siblingTopic] },
  { token: pageConfig.locationToken, label: content.closing.locationLabel }
];
---

<LocationAuthorityLayout
  seo={seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
  pageFamily="location-daily-life"
>
  <Navigation slot="navigation" contextDestination={destination} currentLang={currentLang} languageToken={languageToken}>
    {destination === 'frigiliana' && (
      <LocationContextNav slot="context-navigation" activeId={topic === 'shopping-markets' ? 'dailyLife' : 'health'} lang={currentLang} />
    )}
    {destination === 'nerja' && (
      <NerjaContextNav
        slot="context-navigation"
        activeId={topic}
        childLabel={content.navLabel}
        lang={currentLang}
      />
    )}
    {destination === 'tarifa' && (
      <TarifaContextNav
        slot="context-navigation"
        activeId="overview"
        activeChildId={topic}
        currentLabel="Tarifa"
        childLabel={content.navLabel}
        lang={currentLang}
      />
    )}
  </Navigation>

  <AuthorityArticle
    pageId={topic === 'shopping-markets' ? `${destination}-daily-life` : `${destination}-health-emergency`}
    family="location"
    topic={topic}
    lang={currentLang}
    hero={content.hero}
    authorName={seo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    factIcons={content.factIcons}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: availabilityHref, label: content.closing.availabilityLabel }}
    secondaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    presentation="guide"
    closingRole="next-action"
    closingActionMode="restrained"
    guideVisual={{
      eyebrow: content.facts[0].label,
      mark: pageConfig.label,
      note: content.facts[0].value
    }}
  >
    <DailyLifeGuideSections sections={content.sections} />

    {content.related && (
      <AuthorityRelatedLinks
        related={content.related}
        columns="md:grid-cols-3"
        resolveHref={requiredLink}
        presentation="guide"
      />
    )}
  </AuthorityArticle>
</LocationAuthorityLayout>

<style>
  :global(article[data-am-topic='shopping-markets']),
  :global(article[data-am-topic='health-emergency']) {
    overflow-x: clip;
  }
</style>
