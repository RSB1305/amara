---
/**
 * The split "our place here" section on a destination location hub: a
 * full-height image beside an eyebrow, title, paragraphs, a bordered fact list
 * and a link onward to the stay.
 *
 * Nerja and Tarifa had authored this composition twice, identical apart from
 * the image and the resolved link. Both arrive as props so the section stays
 * presentation only.
 */
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraMediaFrame from '../../components/media/AmaraMediaFrame.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';

interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  title: string;
  paragraphs: string[];
  facts: string[];
  link?: { href?: string; label: string };
}

const { imageSrc, imageAlt, eyebrow, title, paragraphs, facts, link } = Astro.props;
---

<section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28">
  <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface-container-low lg:grid-cols-[0.9fr_1.1fr]">
    <AmaraMediaFrame role="split" mobileFullBleed class="min-h-[340px] bg-surface-container-high lg:min-h-[520px]">
      <AmaraImage
        src={imageSrc}
        alt={imageAlt}
        profile="gallery"
        class="h-full w-full object-cover"
        sizes="(max-width: 1023px) 100vw, 45vw"
        loading="lazy"
        decoding="async"
        mediaRole="split"
      />
    </AmaraMediaFrame>
    <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
      <p class="am-text-eyebrow text-primary">{eyebrow}</p>
      <h2 class="am-text-title mt-5 text-balance text-on-surface">{title}</h2>
      <div class="mt-7 space-y-5">
        {paragraphs.map((paragraph) => (
          <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
        ))}
      </div>
      <ul class="mt-7 space-y-3 border-l border-primary/30 pl-5">
        {facts.map((fact) => (
          <li class="am-text-body leading-relaxed text-on-surface">{fact}</li>
        ))}
      </ul>
      {link && <a href={link.href} class="am-cta-link mt-9 inline-flex self-start">{link.label}</a>}
    </div>
  </div>
</section>
