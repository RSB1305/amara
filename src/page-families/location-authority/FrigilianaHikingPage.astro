---
import type { LabeledLink } from '../../lib/linkResolver';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import GuideClosingSection from './GuideClosingSection.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import ExperiencePreFooter from '../../components/experience/ExperiencePreFooter.astro';
import HikingRouteStatStrip from './HikingRouteStatStrip.astro';
import {
  frigilianaHikingSeo,
  getFrigilianaHikingContent
} from '../../content/frigilianaHikingContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'de' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = getFrigilianaHikingContent(currentLang);

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_hiking_authority',
    label: copy.footerHighlights.hiking
  },
  { token: 'location_frigiliana', label: copy.footerHighlights.guide },
  { token: 'romantic_hideaways', label: copy.footerHighlights.stays }
];

const heroImage = {
  src: '/images/hero-frigiliana.jpg',
  width: 1080
};
---

<LocationAuthorityLayout
  seo={frigilianaHikingSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-hiking"
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_hiking_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="hiking" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-hiking">
    <div class="w-full">
      <LocationExperienceHero
        topic="hiking"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        paragraphs={copy.hero.paragraphs}
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
      />

      {
        copy.routeSections.map((section, index) => (
          <section
            id={section.id}
            class:list={[
              'am-section',
              index % 2 === 0 ? 'am-section--tint' : 'am-section--plain'
            ]}
          >
            <div class="max-w-3xl mb-16">
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
                {section.title}
              </h2>
              {section.intro && (
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {section.intro}
                </p>
              )}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14">
              {section.routes.map((route) => (
                <article class="border-t border-outline-variant/25 pt-8">
                  <h3 class="am-text-subtitle text-on-surface mb-5 lg:min-h-[2.3em]">
                    {route.title}
                  </h3>
                  <HikingRouteStatStrip
                    duration={route.duration}
                    elevationGain={'elevationGain' in route ? route.elevationGain : undefined}
                    distance={route.distance}
                    difficulty={route.difficulty}
                    experience={route.experience}
                    labels={copy.routeCardLabels}
                  />
                  <div class="mt-6 space-y-4">
                    {route.paragraphs.map((paragraph) => (
                      <p class="am-text-body text-on-surface-variant leading-relaxed">
                        {paragraph}
                      </p>
                    ))}
                  </div>
                  <ul class="mt-7 space-y-4" aria-label={copy.routeCardLabels.statsAriaLabel}>
                    {route.links.map((link) => (
                      <li>
                        <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="am-inline-link"
                        >{link.label}</a>
                        <p class="mt-1 am-text-meta text-on-surface-variant">
                          {link.context}
                        </p>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        ))
      }

      <section class="am-section am-section--plain" aria-labelledby="rio-chillar-closure-title">
        <div class="max-w-3xl border-l-2 border-primary pl-6 sm:pl-8">
          <p class="am-text-eyebrow text-primary mb-4">{copy.closureNotice.eyebrow}</p>
          <h2 id="rio-chillar-closure-title" class="am-text-title italic text-on-surface tracking-tight">
            {copy.closureNotice.title}
          </h2>
          <div class="mt-6 space-y-4">
            {copy.closureNotice.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant leading-relaxed">{paragraph}</p>
            ))}
          </div>
          <p class="mt-5 am-text-meta text-on-surface-variant">{copy.closureNotice.checked}</p>
          <a
            href={copy.closureNotice.href}
            target="_blank"
            rel="noopener noreferrer"
            class="am-inline-link mt-5 inline-flex"
          >{copy.closureNotice.linkLabel}</a>
        </div>
      </section>

      <AuthorityFeatureSection
        id="practical"
        title={copy.practical.title}
        items={copy.practical.items}
      />

      <section class="am-section am-section--plain" aria-labelledby="hiking-next-questions-title">
        <div class="max-w-3xl mb-12">
          <h2 id="hiking-next-questions-title" class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.combine.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">{copy.combine.intro}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10">
          {copy.combine.items.map((item) => (
            <article class="border-t border-outline-variant/25 pt-7">
              <h3 class="am-text-subtitle text-on-surface">{item.title}</h3>
              <p class="mt-4 am-text-body text-on-surface-variant leading-relaxed">{item.text}</p>
              <a href={resolveLink(item.token, currentLang)} class="am-inline-link mt-5 inline-flex">
                {item.label}
              </a>
            </article>
          ))}
        </div>
      </section>

      <ExperiencePreFooter currentId="hiking" lang={currentLang} />

      <GuideClosingSection
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.staysCta,
              style: 'text'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'text'
            }
          ]}
          role="next-action"
          family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
