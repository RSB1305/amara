---
import type { LabeledLink } from '../../lib/linkResolver';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import GuideClosingSection from './GuideClosingSection.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import ExperiencePreFooter from '../../components/experience/ExperiencePreFooter.astro';
import HikingRouteStatStrip from './HikingRouteStatStrip.astro';
import {
  frigilianaHikingContent,
  frigilianaHikingSeo
} from '../../content/frigilianaHikingContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'de' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaHikingContent[currentLang];

if (!copy) {
  throw new Error(
    `[AMARA] Frigiliana hiking copy is not published for "${currentLang}".`
  );
}

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_hiking_authority',
    label: copy.footerHighlights.hiking
  },
  { token: 'location_frigiliana', label: copy.footerHighlights.guide },
  { token: 'romantic_hideaways', label: copy.footerHighlights.stays }
];

const heroImage = {
  src: '/images/hero-frigiliana.jpg',
  width: 1080
};
---

<LocationAuthorityLayout
  seo={frigilianaHikingSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-hiking"
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_hiking_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="hiking" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-hiking">
    <div class="w-full">
      <LocationExperienceHero
        topic="hiking"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        paragraphs={copy.hero.paragraphs}
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
      />

      {
        copy.routeSections.map((section, index) => (
          <section
            id={section.id}
            class:list={[
              'am-section',
              index % 2 === 0 ? 'am-section--tint' : 'am-section--plain'
            ]}
          >
            <div class="max-w-3xl mb-16">
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
                {section.title}
              </h2>
              {section.intro && (
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {section.intro}
                </p>
              )}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14">
              {section.routes.map((route) => (
                <article class="border-t border-outline-variant/25 pt-8">
                  <h3 class="am-text-subtitle text-on-surface mb-5 lg:min-h-[2.3em]">
                    {route.title}
                  </h3>
                  <HikingRouteStatStrip
                    duration={route.duration}
                    elevationGain={route.elevationGain}
                    distance={route.distance}
                    difficulty={route.difficulty}
                    experience={route.experience}
                    labels={copy.routeCardLabels}
                  />
                  <p class="mt-6 am-text-body text-on-surface-variant leading-relaxed">
                    {route.text}
                  </p>
                  {route.statusLink && (
                    <p class="am-text-body text-on-surface-variant leading-relaxed mt-6">
                      {route.statusLink.before}<a
                        href={route.statusLink.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="am-inline-link"
                      >{route.statusLink.label}</a>{route.statusLink.after}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }

      <AuthorityFeatureSection
        id="practical"
        title={copy.practical.title}
        items={copy.practical.items}
      />

      <AuthorityFeatureSection
        title={copy.combine.title}
        intro={copy.combine.intro}
        items={copy.combine.items}
        surface="plain"
      />

      <ExperiencePreFooter currentId="hiking" lang={currentLang} />

      <GuideClosingSection
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.apartmentsCta,
              style: 'text'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'text'
            }
          ]}
          role="next-action"
          family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
