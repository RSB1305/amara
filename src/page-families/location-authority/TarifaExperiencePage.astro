---
import type { TarifaExperienceSection } from '../../content/tarifaExperienceContent';
import { resolveLocale } from '../../types/content';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  TARIFA_EXPERIENCE_TOKEN,
  tarifaExperienceContent,
  tarifaExperienceSeo
} from '../../content/tarifaExperienceContent';
import { tarifaGuideContent } from '../../content/tarifaGuideContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = resolveLocale(tarifaExperienceContent, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa Experience');

const footerHighlights: LabeledLink[] = [
  { token: 'location_tarifa', label: tarifaGuideContent.overview.navLabel[currentLang] },
  { token: TARIFA_EXPERIENCE_TOKEN, label: copy.navLabel },
  { token: 'tarifa_beaches_authority', label: tarifaGuideContent.beaches.navLabel[currentLang] },
  { token: 'tarifa_wind_kitesurfing_authority', label: tarifaGuideContent.wind.navLabel[currentLang] }
];
---

<LocationAuthorityLayout
  seo={tarifaExperienceSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    currentToken={TARIFA_EXPERIENCE_TOKEN}
    languageToken={TARIFA_EXPERIENCE_TOKEN}
  >
    <ExperienceContextNav slot="context-navigation" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="tarifa-experience" data-am-family="experience" data-am-role="hub">
    <LocationExperienceHero
      role="hub"
      topic="overview"
      eyebrow={`Tarifa · ${copy.navLabel}`}
      title={copy.hero.title}
      paragraphs={copy.hero.lead}
      imageSrc="/images/amara-tarifa/amara-tarifa-apartment10.webp"
      imageAlt={copy.hero.imageAlt}
      imageWidth={1080}
    />

    {/*
      The six-topic link list was removed: it repeated the context navigation
      directly above it, and the day chooser below now routes to the same six
      guides with a reason to click. `copy.discovery` stays as the authoring
      source for the footer highlight labels.
    */}

    <section class="border-y border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <h2 class="am-text-title text-balance text-on-surface">{copy.dayChooser.title}</h2>
          {copy.dayChooser.intro.length > 0 && (
            <div class="mt-6 space-y-4">
              {copy.dayChooser.intro.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
          )}
        </div>

        <div class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {copy.dayChooser.days.map((day, index) => (
            <article class="border-t border-primary/35 pt-6">
              <p class="text-primary am-text-label am-text-label--sm am-text-label--wide">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="am-text-subtitle mt-4 text-on-surface">{day.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">{day.text}</p>
              {day.token && (
                <p class="mt-4">
                  <a href={requiredLink(day.token)} class="am-inline-link text-sm">
                    {day.linkLabel}<span aria-hidden="true"> →</span>
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    {(copy.sections as TarifaExperienceSection[]).map((section, index) => (
      <>
        <AuthorityTextSection
          section={{
            id: section.id,
            eyebrow: String(index + 1).padStart(2, '0'),
            title: section.title,
            paragraphs: section.paragraphs
          }}
          index={index}
          data-am-experience-section={section.id}
        />
        {section.cta && (
          <div class="border-b border-border-subtle bg-surface px-6 py-8 md:px-12">
            <p class="mx-auto max-w-screen-2xl text-right">
              <a href={requiredLink(section.cta.token)} class="am-inline-link">
                {section.cta.label}<span aria-hidden="true"> →</span>
              </a>
            </p>
          </div>
        )}
      </>
    ))}

    <section class="bg-surface px-6 pt-24 md:px-12 md:pt-32">
      <div class="mx-auto max-w-screen-2xl">
        <EditorialClosingCta
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: copy.closing.token,
              label: copy.closing.ctaLabel,
              style: 'primary'
            },
            ...(copy.closing.secondaryToken
              ? [
                  {
                    token: copy.closing.secondaryToken,
                    label: copy.closing.secondaryLabel!,
                    style: 'secondary' as const
                  }
                ]
              : [])
          ]}
        />
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
