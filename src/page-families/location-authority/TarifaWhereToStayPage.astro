---
import tarifaStayImage from '../../assets/images/home/amara-tarifa-apartment01.webp';
import Navigation from '../../components/Navigation.astro';
import LocationTopicHero from '../../components/location/LocationTopicHero.astro';
import WhereToStayOrientationGraphic from '../../components/location/WhereToStayOrientationGraphic.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import { tarifaWhereToStayContent } from '../../content/tarifaWhereToStayContent';
import { whereToStayOrientationGraphicContent } from '../../content/whereToStayOrientationGraphicContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import WhereToStayAuthorityBody from './WhereToStayAuthorityBody.astro';
import type { WhereToStayAuthorityContent } from './whereToStayAuthority';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const orientationGraphic = whereToStayOrientationGraphicContent.tarifa[currentLang];
const content = tarifaWhereToStayContent.location[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa where to stay');
const aboutHref = requiredLink('about');
const stayHref = requiredLink('casa');
const locationHref = requiredLink('location_tarifa');
const breadcrumbLabels: Record<AmaraLanguage, string> = {
  en: 'Where to stay',
  de: 'Wo übernachten',
  es: 'Dónde alojarse',
  nl: 'Waar overnachten',
  sv: 'Var ska man bo'
};
const ui: Record<
  AmaraLanguage,
  {
    editorialNote: string;
    howEyebrow: string;
    howTitle: string;
    comparisonEyebrow: string;
    comparisonTitle: string;
    settingsEyebrow: string;
    contextTitle: string;
    dimensionsEyebrow: string;
    dimensionsTitle: string;
    fitEyebrow: string;
    continueEyebrow: string;
    continueTitle: string;
    backToLocation: string;
    beaches: string;
    wind: string;
  }
> = {
  en: {
    editorialNote: 'An independent AMARA guide for planning your stay — not a live conditions service.',
    howEyebrow: 'Start with your stay',
    howTitle: 'Begin with the days you want in Tarifa',
    comparisonEyebrow: 'At a glance',
    comparisonTitle: 'The trade-offs before the detail',
    settingsEyebrow: 'Four accommodation settings',
    contextTitle: 'The westbound coast is context, not a fifth town neighbourhood',
    dimensionsEyebrow: 'Across every area',
    dimensionsTitle: 'Car use, wind and everyday life still shape the choice',
    fitEyebrow: 'For different kinds of stay',
    continueEyebrow: 'Continue planning',
    continueTitle: 'Return to Tarifa Location or continue with beaches and wind',
    backToLocation: 'Back to Tarifa Location',
    beaches: 'Explore Tarifa beaches',
    wind: 'Explore wind & kitesurfing'
  },
  de: {
    editorialNote: 'Ein unabhängiger AMARA-Guide zur Reiseplanung – kein Live-Dienst für aktuelle Bedingungen.',
    howEyebrow: 'Euer Aufenthalt',
    howTitle: 'Beginnt mit den Tagen, die ihr in Tarifa verbringen möchtet',
    comparisonEyebrow: 'Auf einen Blick',
    comparisonTitle: 'Die Abwägungen vor dem Detail',
    settingsEyebrow: 'Vier Wohnlagen',
    contextTitle: 'Die Westküste ist Kontext – kein fünftes Stadtviertel',
    dimensionsEyebrow: 'In jeder Lage',
    dimensionsTitle: 'Auto, Wind und Alltag prägen die Entscheidung weiterhin',
    fitEyebrow: 'Für unterschiedliche Aufenthalte',
    continueEyebrow: 'Weiter planen',
    continueTitle: 'Zurück zum Lage-Guide oder weiter zu Strand und Wind',
    backToLocation: 'Zurück zum Tarifa Lage-Guide',
    beaches: 'Tarifas Strände entdecken',
    wind: 'Wind & Kitesurfen in Tarifa'
  },
  es: {
    editorialNote: 'Una guía independiente de AMARA para planificar la estancia; no es un servicio de condiciones en directo.',
    howEyebrow: 'Vuestra estancia',
    howTitle: 'Empieza por los días que queréis pasar en Tarifa',
    comparisonEyebrow: 'De un vistazo',
    comparisonTitle: 'Las contrapartidas antes del detalle',
    settingsEyebrow: 'Cuatro entornos de alojamiento',
    contextTitle: 'La costa occidental es contexto, no un quinto barrio urbano',
    dimensionsEyebrow: 'En cualquier zona',
    dimensionsTitle: 'El coche, el viento y la vida diaria siguen definiendo la elección',
    fitEyebrow: 'Para distintos tipos de estancia',
    continueEyebrow: 'Seguir planificando',
    continueTitle: 'Vuelve a la guía de ubicación o sigue con playas y viento',
    backToLocation: 'Volver a Ubicación Tarifa',
    beaches: 'Explorar las playas de Tarifa',
    wind: 'Viento y kitesurf en Tarifa'
  },
  nl: {
    editorialNote: 'Een onafhankelijke AMARA-gids voor jullie reisplanning — geen live informatiedienst.',
    howEyebrow: 'Jullie verblijf',
    howTitle: 'Begin bij de dagen die jullie in Tarifa willen doorbrengen',
    comparisonEyebrow: 'In één oogopslag',
    comparisonTitle: 'De afwegingen vóór de details',
    settingsEyebrow: 'Vier verblijfssettings',
    contextTitle: 'De westkust is context, geen vijfde stadswijk',
    dimensionsEyebrow: 'In elk gebied',
    dimensionsTitle: 'Auto, wind en dagelijks leven blijven de keuze bepalen',
    fitEyebrow: 'Voor verschillende soorten verblijf',
    continueEyebrow: 'Verder plannen',
    continueTitle: 'Ga terug naar de locatiegids of verder naar strand en wind',
    backToLocation: 'Terug naar Tarifa Locatie',
    beaches: 'Ontdek de stranden van Tarifa',
    wind: 'Lees over wind & kitesurfen'
  },
  sv: {
    editorialNote: 'En oberoende AMARA-guide för reseplanering – inte en tjänst för liveförhållanden.',
    howEyebrow: 'Er vistelse',
    howTitle: 'Börja med dagarna ni vill tillbringa i Tarifa',
    comparisonEyebrow: 'I korthet',
    comparisonTitle: 'Avvägningarna före detaljerna',
    settingsEyebrow: 'Fyra boendemiljöer',
    contextTitle: 'Västkusten är ett sammanhang, inte en femte stadsdel',
    dimensionsEyebrow: 'I varje område',
    dimensionsTitle: 'Bil, vind och vardag fortsätter att forma valet',
    fitEyebrow: 'För olika slags vistelser',
    continueEyebrow: 'Fortsätt planera',
    continueTitle: 'Gå tillbaka till lägesguiden eller vidare till strand och vind',
    backToLocation: 'Tillbaka till Tarifa lägesguide',
    beaches: 'Upptäck Tarifas stränder',
    wind: 'Vind & kitesurfing i Tarifa'
  }
};
const copy = ui[currentLang];
const footerHighlights: LabeledLink[] = [
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_where_to_stay', label: breadcrumbLabels[currentLang] },
  { token: 'tarifa_beaches_authority', label: copy.beaches }
];

const moduleLabels = {
  en: { fit: 'Best fit', daily: 'Everyday life', tradeoff: 'Keep in mind', amara: 'AMARA in Tarifa' },
  de: { fit: 'Passt gut für', daily: 'Im Alltag', tradeoff: 'Bedenkt dabei', amara: 'AMARA in Tarifa' },
  es: { fit: 'Encaja con', daily: 'En el día a día', tradeoff: 'Tened en cuenta', amara: 'AMARA en Tarifa' },
  nl: { fit: 'Past bij', daily: 'In het dagelijks ritme', tradeoff: 'Houd rekening met', amara: 'AMARA in Tarifa' },
  sv: { fit: 'Passar för', daily: 'I vardagen', tradeoff: 'Tänk på', amara: 'AMARA i Tarifa' }
}[currentLang];

const stayContent: WhereToStayAuthorityContent = {
  decision: {
    eyebrow: copy.howEyebrow,
    title: copy.howTitle,
    intro: content.car.paragraphs,
    points: content.microLocations.items.map((area, index) => ({
      label: String(index + 1).padStart(2, '0'),
      title: area.title,
      text: area.fit ?? area.paragraphs[0]
    }))
  },
  areas: {
    id: 'where-to-stay-areas',
    eyebrow: copy.settingsEyebrow,
    title: content.microLocations.title,
    intro: content.microLocations.clarification,
    labels: { fit: moduleLabels.fit, daily: moduleLabels.daily, tradeoff: moduleLabels.tradeoff },
    items: content.microLocations.items.map((area, index) => ({
      number: String(index + 1).padStart(2, '0'),
      title: area.title,
      paragraphs: area.paragraphs,
      fit: area.fit
    }))
  },
  tradeoffs: {
    eyebrow: copy.comparisonEyebrow,
    title: copy.comparisonTitle,
    intro: [content.tradeoffs.intro, ...(content.tradeoffs.closing ?? [])].filter(Boolean).join(' '),
    items: content.tradeoffs.items.map((item) => ({ paragraphs: [item] }))
  },
  mobility: {
    id: 'car-wind-everyday-life',
    eyebrow: copy.dimensionsEyebrow,
    title: copy.dimensionsTitle,
    intro: [],
    items: [content.car, content.wind, content.dailyLife].map((section) => ({
      title: section.title,
      paragraphs: section.paragraphs,
      actions: 'links' in section && section.links
        ? section.links.map((link) => ({ href: requiredLink(link.token), label: link.label }))
        : undefined
    }))
  },
  fit: {
    eyebrow: copy.fitEyebrow,
    title: content.stayFits.title,
    intro: [],
    items: content.stayFits.items
  },
  amara: {
    eyebrow: moduleLabels.amara,
    title: content.amara.title,
    paragraphs: content.amara.paragraphs,
    facts: content.amara.facts,
    image: { src: tarifaStayImage, alt: content.amara.imageAlt },
    action: { href: stayHref, label: content.closing.secondary.label }
  }
};
---

<LocationAuthorityLayout
  seo={tarifaWhereToStayContent.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken={tarifaWhereToStayContent.token}
  >
    <TarifaContextNav slot="context-navigation"
      activeId="overview"
      activeChildId="where-to-stay"
      currentLabel="Tarifa"
      childLabel={breadcrumbLabels[currentLang]}
      lang={currentLang}
    />
  </Navigation>

  <article
    class="bg-surface"
    data-am-page="tarifa-where-to-stay"
    data-am-family="location"
    data-am-role="spoke"
    data-am-topic="where-to-stay"
  >
    <LocationTopicHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      paragraphs={content.hero.lead}
      topic="where-to-stay"
      byline={tarifaWhereToStayContent.seo.article ? {
        lang: currentLang,
        authorName: tarifaWhereToStayContent.seo.article.authorName,
        authorHref: aboutHref,
        updated: content.hero.updated,
        note: copy.editorialNote
      } : undefined}
    >
      <WhereToStayOrientationGraphic slot="visual" data={orientationGraphic} />
    </LocationTopicHero>

    <WhereToStayAuthorityBody content={stayContent} />

    <section class="bg-surface px-6 py-24 md:px-12 md:py-32">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
        <div class="lg:col-span-7">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{copy.continueEyebrow}</p>
          <h2 class="am-text-display mt-6 text-balance text-on-surface">{copy.continueTitle}</h2>
        </div>
        <div class="flex flex-col items-start gap-5 lg:col-span-5">
          <a href={locationHref} class="am-btn am-btn--primary">{copy.backToLocation}</a>
          <a href={requiredLink('tarifa_beaches_authority')} class="am-cta-link">{copy.beaches}</a>
          <a href={requiredLink('tarifa_wind_kitesurfing_authority')} class="am-cta-link">{copy.wind}</a>
        </div>
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
