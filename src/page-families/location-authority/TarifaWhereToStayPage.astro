---
import Navigation from '../../components/Navigation.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import WhereToStayBody from './WhereToStayBody.astro';
import { tarifaWhereToStayContent } from '../../content/tarifaWhereToStayContent';
import { tarifaWhereToStayDe } from '../../content/tarifaWhereToStayBodyContent';
import { trustLabels } from '../../content/trustLabels';
import { whereToStayOrientationGraphicContent } from '../../content/whereToStayOrientationGraphicContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import {
  createRequiredLinkResolver,
  resolveOptionalLink,
  type LabeledLink,
  type LinkToken
} from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const orientationGraphic = whereToStayOrientationGraphicContent.tarifa[currentLang];
const content = tarifaWhereToStayDe;

const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa where to stay');
const optionalLink = (token: LinkToken) => resolveOptionalLink(token, currentLang, { suppressMissing: true });
const bookBase = optionalLink('book');
const bookHref = bookBase ? `${bookBase}?destination=tarifa` : '#';
const bookLabel = trustLabels.book[currentLang];
const pointerHref = optionalLink(content.pointer.linkToken) ?? '#';
const locationHref = requiredLink('location_tarifa');

const breadcrumbLabels: Record<AmaraLanguage, string> = {
  en: 'Where to stay',
  de: 'Wo übernachten',
  es: 'Dónde alojarse',
  nl: 'Waar overnachten',
  sv: 'Var ska man bo'
};

const ui: Record<AmaraLanguage, { continueEyebrow: string; continueTitle: string; backToLocation: string; beaches: string; wind: string }> = {
  en: { continueEyebrow: 'More Tarifa guides', continueTitle: 'Beaches, wind and the Tarifa overview', backToLocation: 'Tarifa overview', beaches: 'Explore Tarifa beaches', wind: 'Explore wind & kitesurfing' },
  de: { continueEyebrow: 'Mehr zu Tarifa', continueTitle: 'Strände, Wind und der Tarifa-Überblick', backToLocation: 'Tarifa im Überblick', beaches: 'Tarifas Strände entdecken', wind: 'Wind & Kitesurfen in Tarifa' },
  es: { continueEyebrow: 'Más sobre Tarifa', continueTitle: 'Playas, viento y la guía general de Tarifa', backToLocation: 'Tarifa de un vistazo', beaches: 'Explorar las playas de Tarifa', wind: 'Viento y kitesurf en Tarifa' },
  nl: { continueEyebrow: 'Meer over Tarifa', continueTitle: 'Stranden, wind en het Tarifa-overzicht', backToLocation: 'Tarifa in het kort', beaches: 'Ontdek de stranden van Tarifa', wind: 'Lees over wind & kitesurfen' },
  sv: { continueEyebrow: 'Mer om Tarifa', continueTitle: 'Stränder, vind och översikten över Tarifa', backToLocation: 'Tarifa i korthet', beaches: 'Upptäck Tarifas stränder', wind: 'Vind & kitesurfing i Tarifa' }
};
const copy = ui[currentLang];

const footerHighlights: LabeledLink[] = [
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_where_to_stay', label: breadcrumbLabels[currentLang] },
  { token: 'tarifa_beaches_authority', label: copy.beaches }
];
---

<LocationAuthorityLayout
  pageFamily="location-tarifa-where-to-stay"
  seo={tarifaWhereToStayContent.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="tarifa"
    currentLang={currentLang}
    languageToken={tarifaWhereToStayContent.token}
  >
    <TarifaContextNav slot="context-navigation"
      activeId="overview"
      activeChildId="where-to-stay"
      currentLabel="Tarifa"
      childLabel={breadcrumbLabels[currentLang]}
      lang={currentLang}
    />
  </Navigation>

  <div
    data-am-page="tarifa-where-to-stay"
    data-am-family="location"
    data-am-role="spoke"
    data-am-topic="where-to-stay"
    data-am-presentation="guide"
  >
    <WhereToStayBody
      content={content}
      orientationGraphic={orientationGraphic}
      bookHref={bookHref}
      bookLabel={bookLabel}
      pointerHref={pointerHref}
    />

    <section class="bg-surface px-6 py-24 md:px-12 md:py-32">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
        <div class="lg:col-span-7">
          <p class="am-text-eyebrow text-primary">{copy.continueEyebrow}</p>
          <h2 class="am-text-title mt-6 text-balance text-on-surface">{copy.continueTitle}</h2>
        </div>
        <div class="flex flex-col items-start gap-5 lg:col-span-5">
          <a href={locationHref} class="am-btn am-btn--primary">{copy.backToLocation}</a>
          <a href={requiredLink('tarifa_beaches_authority')} class="am-cta-link">{copy.beaches}</a>
          <a href={requiredLink('tarifa_wind_kitesurfing_authority')} class="am-cta-link">{copy.wind}</a>
        </div>
      </div>
    </section>
  </div>
</LocationAuthorityLayout>
