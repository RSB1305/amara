---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import tarifaStayImage from '../../assets/images/home/amara-tarifa-apartment01.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import LocationTopicHero from '../../components/location/LocationTopicHero.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import { tarifaWhereToStayContent } from '../../content/tarifaWhereToStayContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = tarifaWhereToStayContent.location[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa where to stay');
const aboutHref = requiredLink('about');
const stayHref = requiredLink('casa');
const locationHref = requiredLink('location_tarifa');
const breadcrumbLabels: Record<AmaraLanguage, string> = {
  en: 'Where to stay',
  de: 'Wo übernachten',
  es: 'Dónde alojarse',
  nl: 'Waar overnachten',
  sv: 'Var ska man bo'
};
const ui: Record<
  AmaraLanguage,
  {
    editorialNote: string;
    howEyebrow: string;
    howTitle: string;
    comparisonEyebrow: string;
    comparisonTitle: string;
    settingsEyebrow: string;
    contextTitle: string;
    dimensionsEyebrow: string;
    dimensionsTitle: string;
    fitEyebrow: string;
    continueEyebrow: string;
    continueTitle: string;
    backToLocation: string;
    beaches: string;
    wind: string;
  }
> = {
  en: {
    editorialNote: 'An independent AMARA guide for planning your stay — not a live conditions service.',
    howEyebrow: 'Start with your stay',
    howTitle: 'Begin with the days you want in Tarifa',
    comparisonEyebrow: 'At a glance',
    comparisonTitle: 'The trade-offs before the detail',
    settingsEyebrow: 'Four accommodation settings',
    contextTitle: 'The westbound coast is context, not a fifth town neighbourhood',
    dimensionsEyebrow: 'Across every area',
    dimensionsTitle: 'Car use, wind and everyday life still shape the choice',
    fitEyebrow: 'For different kinds of stay',
    continueEyebrow: 'Continue planning',
    continueTitle: 'Return to Tarifa Location or continue with beaches and wind',
    backToLocation: 'Back to Tarifa Location',
    beaches: 'Explore Tarifa beaches',
    wind: 'Explore wind & kitesurfing'
  },
  de: {
    editorialNote: 'Ein unabhängiger AMARA-Guide zur Reiseplanung – kein Live-Dienst für aktuelle Bedingungen.',
    howEyebrow: 'Euer Aufenthalt',
    howTitle: 'Beginnt mit den Tagen, die ihr in Tarifa verbringen möchtet',
    comparisonEyebrow: 'Auf einen Blick',
    comparisonTitle: 'Die Abwägungen vor dem Detail',
    settingsEyebrow: 'Vier Wohnlagen',
    contextTitle: 'Die Westküste ist Kontext – kein fünftes Stadtviertel',
    dimensionsEyebrow: 'In jeder Lage',
    dimensionsTitle: 'Auto, Wind und Alltag prägen die Entscheidung weiterhin',
    fitEyebrow: 'Für unterschiedliche Aufenthalte',
    continueEyebrow: 'Weiter planen',
    continueTitle: 'Zurück zum Lage-Guide oder weiter zu Strand und Wind',
    backToLocation: 'Zurück zum Tarifa Lage-Guide',
    beaches: 'Tarifas Strände entdecken',
    wind: 'Wind & Kitesurfen in Tarifa'
  },
  es: {
    editorialNote: 'Una guía independiente de AMARA para planificar la estancia; no es un servicio de condiciones en directo.',
    howEyebrow: 'Vuestra estancia',
    howTitle: 'Empieza por los días que queréis pasar en Tarifa',
    comparisonEyebrow: 'De un vistazo',
    comparisonTitle: 'Las contrapartidas antes del detalle',
    settingsEyebrow: 'Cuatro entornos de alojamiento',
    contextTitle: 'La costa occidental es contexto, no un quinto barrio urbano',
    dimensionsEyebrow: 'En cualquier zona',
    dimensionsTitle: 'El coche, el viento y la vida diaria siguen definiendo la elección',
    fitEyebrow: 'Para distintos tipos de estancia',
    continueEyebrow: 'Seguir planificando',
    continueTitle: 'Vuelve a la guía de ubicación o sigue con playas y viento',
    backToLocation: 'Volver a Ubicación Tarifa',
    beaches: 'Explorar las playas de Tarifa',
    wind: 'Viento y kitesurf en Tarifa'
  },
  nl: {
    editorialNote: 'Een onafhankelijke AMARA-gids voor jullie reisplanning — geen live informatiedienst.',
    howEyebrow: 'Jullie verblijf',
    howTitle: 'Begin bij de dagen die jullie in Tarifa willen doorbrengen',
    comparisonEyebrow: 'In één oogopslag',
    comparisonTitle: 'De afwegingen vóór de details',
    settingsEyebrow: 'Vier verblijfssettings',
    contextTitle: 'De westkust is context, geen vijfde stadswijk',
    dimensionsEyebrow: 'In elk gebied',
    dimensionsTitle: 'Auto, wind en dagelijks leven blijven de keuze bepalen',
    fitEyebrow: 'Voor verschillende soorten verblijf',
    continueEyebrow: 'Verder plannen',
    continueTitle: 'Ga terug naar de locatiegids of verder naar strand en wind',
    backToLocation: 'Terug naar Tarifa Locatie',
    beaches: 'Ontdek de stranden van Tarifa',
    wind: 'Lees over wind & kitesurfen'
  },
  sv: {
    editorialNote: 'En oberoende AMARA-guide för reseplanering – inte en tjänst för liveförhållanden.',
    howEyebrow: 'Er vistelse',
    howTitle: 'Börja med dagarna ni vill tillbringa i Tarifa',
    comparisonEyebrow: 'I korthet',
    comparisonTitle: 'Avvägningarna före detaljerna',
    settingsEyebrow: 'Fyra boendemiljöer',
    contextTitle: 'Västkusten är ett sammanhang, inte en femte stadsdel',
    dimensionsEyebrow: 'I varje område',
    dimensionsTitle: 'Bil, vind och vardag fortsätter att forma valet',
    fitEyebrow: 'För olika slags vistelser',
    continueEyebrow: 'Fortsätt planera',
    continueTitle: 'Gå tillbaka till lägesguiden eller vidare till strand och vind',
    backToLocation: 'Tillbaka till Tarifa lägesguide',
    beaches: 'Upptäck Tarifas stränder',
    wind: 'Vind & kitesurfing i Tarifa'
  }
};
const copy = ui[currentLang];
const footerHighlights: LabeledLink[] = [
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_where_to_stay', label: breadcrumbLabels[currentLang] },
  { token: 'tarifa_beaches_authority', label: copy.beaches }
];
---

<LocationAuthorityLayout
  seo={tarifaWhereToStayContent.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken={tarifaWhereToStayContent.token}
  />
  <TarifaContextNav
    activeId="overview"
    activeChildId="where-to-stay"
    currentLabel="Tarifa"
    childLabel={breadcrumbLabels[currentLang]}
    lang={currentLang}
  />

  <article
    class="bg-surface"
    data-am-page="tarifa-where-to-stay"
    data-am-family="location"
    data-am-role="spoke"
    data-am-topic="where-to-stay"
  >
    <LocationTopicHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      paragraphs={content.hero.lead}
      imageSrc={tarifaStayImage}
      imageAlt={content.amara.imageAlt}
      topic="where-to-stay"
      byline={tarifaWhereToStayContent.seo.article ? {
        lang: currentLang,
        authorName: tarifaWhereToStayContent.seo.article.authorName,
        authorHref: aboutHref,
        updated: content.hero.updated,
        note: copy.editorialNote
      } : undefined}
    />

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28" data-am-stay-module="decision">
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{copy.howEyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{copy.howTitle}</h2>
        </div>
        <div class="max-w-4xl space-y-5 lg:col-span-7">
          {content.car.paragraphs.map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface px-6 py-24 md:px-12 md:py-32" data-am-stay-module="areas">
      <div class="mx-auto max-w-screen-2xl">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{copy.settingsEyebrow}</p>
        <h2 class="am-text-display mt-6 max-w-4xl text-balance text-on-surface">{content.microLocations.title}</h2>
        <div class="mt-16 border-t border-border-subtle">
          {content.microLocations.items.map((area, index) => (
            <section class="grid gap-8 border-b border-border-subtle py-12 lg:grid-cols-12 lg:gap-16 lg:py-16">
              <div class="lg:col-span-5">
                <span class="font-label text-[10px] font-bold uppercase tracking-[0.16em] text-primary">0{index + 1}</span>
                <h3 class="am-text-title mt-4 max-w-xl text-balance text-on-surface">{area.title}</h3>
                {area.fit && <p class="am-text-subtitle mt-7 border-l border-primary/30 pl-5 text-on-surface"><InlineEmphasis text={area.fit} /></p>}
              </div>
              <div class="max-w-4xl space-y-5 lg:col-span-7">
                {area.paragraphs.map((paragraph) => (
                  <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
                ))}
              </div>
            </section>
          ))}
        </div>
        <aside class="mt-12 grid gap-6 border-l-2 border-primary/35 bg-surface-container-low px-7 py-9 md:px-10 lg:grid-cols-12 lg:gap-16">
          <h2 class="am-text-subtitle text-on-surface lg:col-span-5">{copy.contextTitle}</h2>
          <p class="am-text-body leading-relaxed text-on-surface-variant lg:col-span-7"><InlineEmphasis text={content.microLocations.clarification} /></p>
        </aside>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-inverse-surface px-6 py-20 text-inverted-on-surface md:px-12 md:py-28" data-am-stay-module="tradeoffs">
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary-fixed-dim">{copy.comparisonEyebrow}</p>
          <h2 class="am-text-title mt-5 text-balance text-inverted-on-surface">{copy.comparisonTitle}</h2>
          {content.tradeoffs.intro && <p class="am-text-body mt-6 leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={content.tradeoffs.intro} /></p>}
        </div>
        <ol class="border-y border-inverted-on-surface/20 lg:col-span-7">
          {content.tradeoffs.items.map((item, index) => (
            <li class:list={['grid grid-cols-[auto_1fr] gap-5 py-6', index > 0 && 'border-t border-inverted-on-surface/20']}>
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary-fixed-dim">0{index + 1}</span>
              <span class="am-text-body leading-relaxed text-inverted-on-surface/80">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28" data-am-stay-module="mobility">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-4xl">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{copy.dimensionsEyebrow}</p>
          <h2 class="am-text-title mt-5 text-balance text-on-surface">{copy.dimensionsTitle}</h2>
        </div>
        <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:gap-12">
          {[content.wind, content.dailyLife].map((section) => (
            <section class="border-t border-border-subtle bg-surface px-7 pb-9 pt-8 md:px-9 md:pb-11">
              <h3 class="am-text-subtitle text-balance text-on-surface">{section.title}</h3>
              <div class="mt-6 space-y-4">
                {section.paragraphs.map((paragraph) => (
                  <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
                ))}
              </div>
              {'links' in section && section.links && (
                <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3">
                  {section.links.map((link) => (
                    <a href={requiredLink(link.token)} class="am-cta-link">{link.label}</a>
                  ))}
                </div>
              )}
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28" data-am-stay-module="fit">
      <div class="mx-auto max-w-screen-2xl">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{copy.fitEyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{content.stayFits.title}</h2>
        <div class="mt-12 grid gap-x-10 md:grid-cols-2">
          {content.stayFits.items.map((item) => (
            <section class="border-t border-border-subtle py-8">
              <h3 class="am-text-subtitle text-on-surface">{item.title}</h3>
              <div class="mt-5 space-y-4">
                {item.paragraphs.map((paragraph) => (
                  <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28" data-am-stay-module="amara">
      <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface lg:grid-cols-2">
        <figure class="am-mobile-full-bleed min-h-[360px] bg-surface-container-high lg:min-h-[580px]">
          <AmaraImage
            src={tarifaStayImage}
            alt={content.amara.imageAlt}
            profile="gallery"
            class="h-full w-full object-cover"
            sizes="(max-width: 1023px) 100vw, 50vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
          <h2 class="am-text-title text-balance text-on-surface">{content.amara.title}</h2>
          <div class="mt-7 space-y-5">
            {content.amara.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
          <ul class="mt-7 space-y-3 border-l border-primary/30 pl-5">
            {content.amara.facts.map((fact) => (
              <li class="am-text-body leading-relaxed text-on-surface">{fact}</li>
            ))}
          </ul>
          <a href={stayHref} class="am-cta-link mt-9 inline-flex self-start">{content.closing.secondary.label}</a>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-24 md:px-12 md:py-32">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
        <div class="lg:col-span-7">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{copy.continueEyebrow}</p>
          <h2 class="am-text-display mt-6 text-balance text-on-surface">{copy.continueTitle}</h2>
        </div>
        <div class="flex flex-col items-start gap-5 lg:col-span-5">
          <a href={locationHref} class="am-btn am-btn--primary">{copy.backToLocation}</a>
          <a href={requiredLink('tarifa_beaches_authority')} class="am-cta-link">{copy.beaches}</a>
          <a href={requiredLink('tarifa_wind_kitesurfing_authority')} class="am-cta-link">{copy.wind}</a>
        </div>
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
