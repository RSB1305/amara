---
import Hero from '../../components/Hero.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import HairlineStatCard from '../../components/location/HairlineStatCard.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaStreetsStairsCopy,
  frigilianaStreetsStairsSeo
} from '../../content/frigilianaStreetsStairsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaStreetsStairsCopy;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const factors = copy.factors.items.map((item) => ({
  label: t(item.label),
  value: t(item.value),
  note: t(item.note)
}));

const locationModels = copy.models.items.map((item) => ({
  number: item.number,
  title: t(item.title),
  summary: t(item.summary),
  fit: t(item.fit),
  daily: t(item.daily),
  tradeoff: t(item.tradeoff)
}));

const dailyRouteSteps = copy.dailyRoute.steps.map((step) => ({
  number: step.number,
  label: t(step.label)
}));

const fitGuideItems = copy.fitGuide.items.map((item) => ({
  title: t(item.title),
  text: t(item.text)
}));

const selfCheckSteps = copy.selfCheck.steps.map((step) => ({
  num: step.num,
  headline: t(step.title),
  text: t(step.text)
}));

const faqItems = copy.selfCheck.faq.map((item) => ({
  question: t(item.question),
  answer: t(item.answer)
}));

const relatedLinks = copy.related.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, {
    suppressMissing: true
  });

  return href
    ? [{
        href,
        label: t(link.label),
        text: t(link.text)
      }]
    : [];
});

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_stairs',
    label: t(copy.nav.links[1].label)
  },
  {
    token: 'frigiliana_parking',
    label: t(copy.nav.links[2].label)
  },
  {
    token: 'getting_to_frigiliana',
    label: t(copy.related.links[2].label)
  }
];

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/08-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};

const proofImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/04-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};
---

<LocationAuthorityLayout
  seo={frigilianaStreetsStairsSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_stairs"
  />
  <LocationContextNav activeId="stay" lang={currentLang} />

  <div data-am-page="frigiliana-streets-stairs">
    <div class="w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={t(copy.hero.imageAlt)}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {t(copy.hero.eyebrow)}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {t(copy.hero.title)}
        </h1>
        <div class="pl-7 border-l border-primary/20 max-w-xl mb-12 space-y-5 md:pl-10 md:mb-14 md:space-y-6">
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.lead)}
          </p>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.body)}
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="#location-models" class="am-btn am-btn--primary">
            {t(copy.hero.primaryCta)}
          </a>
          <a href="#daily-route" class="am-btn am-btn--secondary">
            {t(copy.hero.secondaryCta)}
          </a>
        </div>
      </Hero>

      <section class="max-w-screen-2xl mx-auto px-12 pb-24 md:pb-32">
        <div class="max-w-4xl mb-14 md:mb-16">
          <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
            {t(copy.principle.eyebrow)}
          </span>
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
            {t(copy.principle.title)}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed max-w-3xl">
            {t(copy.principle.body)}
          </p>
        </div>
        <h3 class="am-text-subtitle text-on-surface mb-10 md:mb-12">{t(copy.factors.title)}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-12 gap-y-10 md:gap-y-12">
          {
            factors.map((factor) => (
              <HairlineStatCard
                label={factor.label}
                value={factor.value}
                description={factor.note}
              />
            ))
          }
        </div>
      </section>

      <section
        id="location-models"
        class="bg-surface-container-low border-y border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-12 py-24 md:py-32">
          <div class="max-w-3xl mb-16 md:mb-20">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.models.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.models.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.models.intro)}
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-16 lg:gap-y-20">
            {
              locationModels.map((model) => (
                <article class="border-t border-outline-variant/25 pt-8">
                  <div class="flex items-start justify-between gap-6 mb-8">
                    <h3 class="am-text-subtitle text-on-surface max-w-md">{model.title}</h3>
                    <span
                      class="font-headline text-[clamp(2.5rem,5vw,4.5rem)] italic leading-none text-outline-variant/45"
                      aria-hidden="true"
                    >
                      {model.number}
                    </span>
                  </div>
                  <p class="am-text-body text-on-surface-variant leading-relaxed max-w-xl">
                    {model.summary}
                  </p>
                  <dl class="mt-8 divide-y divide-outline-variant/10 border-y border-outline-variant/10">
                    <div class="py-5">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {t(copy.models.labels.fit)}
                      </dt>
                      <dd class="am-text-body text-on-surface leading-relaxed">
                        {model.fit}
                      </dd>
                    </div>
                    <div class="py-5">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {t(copy.models.labels.daily)}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {model.daily}
                      </dd>
                    </div>
                    <div class="py-5">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {t(copy.models.labels.tradeoff)}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {model.tradeoff}
                      </dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="max-w-screen-2xl mx-auto px-12 py-24 md:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="am-mobile-full-bleed am-mobile-full-bleed--wide lg:col-span-6">
            <AmaraImage
              src={proofImage.src}
              alt={t(copy.proof.imageAlt)}
              profile="card"
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="lg:col-span-6 lg:pl-10">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.proof.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.proof.title)}
            </h2>
            <div class="space-y-6 max-w-xl">
              {
                copy.proof.paragraphs.map((paragraph) => (
                  <p class="am-text-body text-on-surface-variant leading-relaxed">{t(paragraph)}</p>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section
        id="daily-route"
        class="bg-surface-container-low border-y border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-12 py-24 md:py-32">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-start">
            <div class="lg:col-span-5">
              <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
                {t(copy.dailyRoute.eyebrow)}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                {t(copy.dailyRoute.title)}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed mb-8">
                {t(copy.dailyRoute.intro)}
              </p>
              <p class="am-text-body text-on-surface leading-relaxed border-l border-primary/30 pl-7">
                {t(copy.dailyRoute.conclusion)}
              </p>
            </div>
            <ol class="lg:col-span-7 border-t border-outline-variant/15">
              {
                dailyRouteSteps.map((step) => (
                  <li class="grid grid-cols-[auto_1fr] gap-6 md:gap-8 items-center py-6 md:py-7 border-b border-outline-variant/15">
                    <span class="font-headline text-4xl italic leading-none text-outline-variant/60" aria-hidden="true">
                      {step.number}
                    </span>
                    <span class="am-text-subtitle text-on-surface">{step.label}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="max-w-screen-2xl mx-auto px-12 py-24 md:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-4">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.fitGuide.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.fitGuide.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.fitGuide.intro)}
            </p>
          </div>
          <div class="lg:col-span-7 lg:col-start-6 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10">
            {
              fitGuideItems.map((item) => (
                <article class="border-t border-outline-variant/20 pt-7">
                  <h3 class="am-text-subtitle text-on-surface mb-5">{item.title}</h3>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <FaqAccordion
        arrivalTitle={t(copy.selfCheck.title)}
        steps={selfCheckSteps}
        faqTitle={t(copy.selfCheck.faqTitle)}
        items={faqItems}
      />

      <EditorialGuideLinkSection
        eyebrow={t(copy.related.eyebrow)}
        title={t(copy.related.title)}
        intro={t(copy.related.intro)}
        links={relatedLinks}
      />

      <section class="max-w-screen-2xl mx-auto px-12 pt-8">
        <EditorialClosingCta
          title={t(copy.closing.title)}
          lead={t(copy.closing.lead)}
          lang={currentLang}
          links={[
            {
              token: 'location_frigiliana',
              label: t(copy.closing.hubCta),
              style: 'primary'
            },
            {
              token: 'romantic_hideaways',
              label: t(copy.closing.staysCta),
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  @media (max-width: 767px) {
    :global([data-am-page='frigiliana-streets-stairs'] .px-12) {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>
