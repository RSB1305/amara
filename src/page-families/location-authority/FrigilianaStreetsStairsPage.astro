---
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import LocationTopicHero from '../../components/location/LocationTopicHero.astro';
import WhereToStayOrientationGraphic from '../../components/location/WhereToStayOrientationGraphic.astro';
import LocationModule from './LocationModule.astro';
import { trustLabels } from '../../content/trustLabels';
import {
  frigilianaStreetsStairsCopy,
  frigilianaStreetsStairsSeo
} from '../../content/frigilianaStreetsStairsContent';
import { whereToStayOrientationGraphicContent } from '../../content/whereToStayOrientationGraphicContent';
import { frigilianaWhereToStayContent } from '../../content/frigilianaWhereToStayContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaStreetsStairsCopy;
const c = frigilianaWhereToStayContent[currentLang];
const orientationGraphic = whereToStayOrientationGraphicContent.frigiliana[currentLang];

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const selfCheckSteps = copy.selfCheck.steps.map((step) => ({
  num: step.num,
  headline: t(step.title),
  text: t(step.text)
}));
const faqItems = copy.selfCheck.faq.map((item) => ({
  question: t(item.question),
  answer: t(item.answer)
}));
const relatedLinks = copy.related.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
  return href ? [{ href, label: t(link.label), text: t(link.text) }] : [];
});
const footerHighlights: LabeledLink[] = [
  { token: 'location_frigiliana', label: t(copy.nav.links[0].label) },
  { token: 'frigiliana_parking', label: t(copy.nav.links[2].label) },
  { token: 'getting_to_frigiliana', label: t(copy.related.links[2].label) }
];

const bookBase = resolveOptionalLink('book', currentLang, { suppressMissing: true });
const bookHref = bookBase ? `${bookBase}?destination=frigiliana` : '#';
const pointerHref = resolveOptionalLink(c.pointer.linkToken, currentLang, { suppressMissing: true }) ?? '#';
const bookLabel = trustLabels.book[currentLang];

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<LocationAuthorityLayout
  pageFamily="location-frigiliana-streets"
  seo={frigilianaStreetsStairsSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_stairs"
  >
    <LocationContextNav slot="context-navigation" activeId="stay" lang={currentLang} />
  </Navigation>

  <div
    data-am-page="frigiliana-where-to-stay"
    data-am-family="location"
    data-am-role="spoke"
    data-am-topic="where-to-stay"
    data-am-presentation="guide"
  >
    <LocationTopicHero
      topic="where-to-stay"
      eyebrow={c.hero.eyebrow}
      title={c.hero.title}
      subtitle={c.hero.lede}
      paragraphs={[c.hero.body]}
      actions={[
        { href: '#zones', label: c.heroCtaZones, style: 'primary' },
        { href: bookHref, label: bookLabel, style: 'secondary' }
      ]}
    >
      <WhereToStayOrientationGraphic slot="visual" data={orientationGraphic} />
    </LocationTopicHero>

    <LocationModule data-am-stay-module="figures">
      <div class="mx-auto grid max-w-screen-2xl gap-x-10 gap-y-8 border-t border-border-subtle pt-10 sm:grid-cols-3">
        {c.hero.stats.map((s) => (
          <div>
            <div class="am-text-title leading-none text-primary">{s.k}</div>
            <p class="am-text-caption am-text-caption--upper am-text-caption--wide mt-3 max-w-[24ch] text-on-surface-variant">{s.l}</p>
          </div>
        ))}
      </div>
    </LocationModule>

    <LocationModule data-am-stay-module="glance">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <h2 class="am-text-title text-balance italic text-on-surface">{c.glanceTitle}</h2>
          <p class="am-text-body mt-6 max-w-2xl leading-relaxed text-on-surface-variant">{c.glanceIntro}</p>
        </div>
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          {c.glance.map((g, i) => (
            <a href={`#${g.id}`} class="group block border-t-2 border-primary/70 pt-6">
              <span class="font-serif text-3xl italic leading-none text-primary/60">{pad(i)}</span>
              <h3 class="am-text-subtitle mt-4 text-on-surface transition-colors group-hover:text-primary">{g.title}</h3>
              <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{g.blurb}</p>
            </a>
          ))}
        </div>
      </div>
    </LocationModule>

    <LocationModule surface="tint" data-am-stay-module="steps">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary">{c.stepsEyebrow}</p>
          <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{c.steps.title}</h2>
          <p class="am-text-body mt-6 max-w-xl leading-relaxed text-on-surface-variant">{c.steps.intro}</p>
        </div>
        <div class="lg:col-span-7">
          <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={c.steps.copy} /></p>
          <p class="am-text-subtitle mt-6 max-w-xl text-balance italic text-primary">{c.steps.note}</p>
          <ol class="mt-8 border-t border-border-subtle">
            {c.steps.day.map((label, i) => (
              <li class="flex items-baseline gap-5 border-b border-border-subtle py-4">
                <span class="am-text-label am-text-label--sm am-text-label--wide text-primary">{pad(i)}</span>
                <span class="am-text-body text-on-surface-variant">{label}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </LocationModule>

    <LocationModule id="zones" class="scroll-mt-32" data-am-stay-module="zones">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{c.zonesEyebrow}</p>
          <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{c.zonesTitle}</h2>
          <p class="am-text-body mt-6 max-w-2xl leading-relaxed text-on-surface-variant">{c.zonesIntro}</p>
        </div>
        <div class="mt-12 border-t border-border-subtle">
          {c.zones.map((zone, i) => (
            <article id={zone.id} class="grid gap-8 border-b border-border-subtle py-12 scroll-mt-32 lg:grid-cols-12 lg:gap-16 lg:py-14">
              <div class="lg:col-span-4">
                <span class="font-serif text-5xl italic leading-none text-primary/55">{pad(i)}</span>
                <p class="am-text-caption am-text-caption--upper am-text-caption--wide mt-5 text-primary">{zone.sub}</p>
                <h3 class="am-text-title mt-3 max-w-md text-balance text-on-surface">{zone.h3}</h3>
              </div>
              <div class="lg:col-span-8">
                <p class="am-text-body leading-relaxed text-on-surface-variant">{zone.desc}</p>
                {zone.quarters && (
                  <div class="mt-6 grid gap-6 sm:grid-cols-2">
                    {zone.quarters.map((q) => (
                      <div class="border-l-2 border-primary/50 pl-4">
                        <p class="am-text-subtitle text-on-surface">{q.name}</p>
                        <p class="am-text-body mt-1 leading-relaxed text-on-surface-variant">{q.note}</p>
                      </div>
                    ))}
                  </div>
                )}
                <div class="mt-7 grid gap-x-12 gap-y-6 border-t border-border-subtle pt-7 sm:grid-cols-2">
                  <div>
                    <p class="am-text-label am-text-label--sm am-text-label--wide text-primary">{c.labelIdealFor}</p>
                    <p class="am-text-body mt-2 leading-relaxed text-on-surface">{zone.idealFor}</p>
                  </div>
                  <div>
                    <p class="am-text-label am-text-label--sm am-text-label--wide text-primary">{c.labelHonest}</p>
                    <p class="am-text-body mt-2 leading-relaxed text-on-surface"><InlineEmphasis text={zone.honest} /></p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </LocationModule>

    <LocationModule surface="tint" data-am-stay-module="who">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-4">
            <h2 class="am-text-title text-balance italic text-on-surface">{c.whoTitle}</h2>
            <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{c.whoIntro}</p>
          </div>
          <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8">
            {c.who.map((w) => (
              <article class="border-t border-border-subtle pt-6">
                <h3 class="am-text-subtitle text-balance text-on-surface">{w.title}</h3>
                <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{w.text}</p>
              </article>
            ))}
          </div>
        </div>
        <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-l-2 border-primary/60 bg-surface px-7 py-6">
          <p class="am-text-body max-w-3xl text-on-surface-variant"><InlineEmphasis text={c.pointer.text} /></p>
          <a href={pointerHref} class="am-cta-link">{c.pointer.linkLabel}</a>
        </div>
      </div>
    </LocationModule>

    <LocationModule surface="inverse" data-am-stay-module="verdict">
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary-fixed-dim">{c.verdict.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-inverted-on-surface">{c.verdict.title}</h2>
          <p class="am-text-body mt-6 max-w-md leading-relaxed text-inverted-on-surface/70">
            {c.verdict.caption} <span class="text-inverted-on-surface/50">{c.verdict.mapNote}</span>
          </p>
        </div>
        <div class="lg:col-span-7">
          <p class="am-text-body leading-relaxed text-inverted-on-surface/80"><InlineEmphasis text={c.verdict.lead} /></p>
          <ul class="mt-7 border-t border-inverted-on-surface/20">
            {c.verdict.facts.map((fact) => (
              <li class="am-text-body border-b border-inverted-on-surface/20 py-4 text-inverted-on-surface/80"><InlineEmphasis text={fact} /></li>
            ))}
          </ul>
          <p class="am-text-subtitle mt-7 max-w-2xl border-l-2 border-primary-fixed-dim pl-5 text-balance italic text-inverted-on-surface/75">{c.verdict.honest}</p>
          <a href={bookHref} class="am-btn am-btn--primary am-btn--inverse mt-9 inline-flex">{bookLabel}</a>
        </div>
      </div>
    </LocationModule>

    <FaqAccordion
      arrivalTitle={t(copy.selfCheck.title)}
      steps={selfCheckSteps}
      faqTitle={t(copy.selfCheck.faqTitle)}
      items={faqItems}
    />

    <EditorialGuideLinkSection
      eyebrow={t(copy.related.eyebrow)}
      title={t(copy.related.title)}
      intro={t(copy.related.intro)}
      links={relatedLinks}
    />

    <section class="max-w-screen-2xl mx-auto px-6 md:px-12 pt-8">
      <EditorialClosingCta
        title={t(copy.closing.title)}
        lead={t(copy.closing.lead)}
        lang={currentLang}
        links={[
          { token: 'location_frigiliana', label: t(copy.closing.hubCta), style: 'primary' },
          { token: 'romantic_hideaways', label: t(copy.closing.staysCta), style: 'secondary' }
        ]}
      />
    </section>
  </div>
</LocationAuthorityLayout>
