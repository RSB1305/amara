---
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaStreetsStairsCopy,
  frigilianaStreetsStairsSeo
} from '../../content/frigilianaStreetsStairsContent';
import { frigilianaWhereToStayDe } from '../../content/frigilianaWhereToStayContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaStreetsStairsCopy;
const c = frigilianaWhereToStayDe;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const selfCheckSteps = copy.selfCheck.steps.map((step) => ({
  num: step.num,
  headline: t(step.title),
  text: t(step.text)
}));
const faqItems = copy.selfCheck.faq.map((item) => ({
  question: t(item.question),
  answer: t(item.answer)
}));
const relatedLinks = copy.related.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
  return href ? [{ href, label: t(link.label), text: t(link.text) }] : [];
});
const footerHighlights: LabeledLink[] = [
  { token: 'location_frigiliana', label: t(copy.nav.links[0].label) },
  { token: 'frigiliana_parking', label: t(copy.nav.links[2].label) },
  { token: 'getting_to_frigiliana', label: t(copy.related.links[2].label) }
];

const bookBase = resolveOptionalLink('book', currentLang, { suppressMissing: true });
const bookHref = bookBase ? `${bookBase}?destination=frigiliana` : '#';
const pointerHref = resolveOptionalLink(c.pointer.linkToken, currentLang, { suppressMissing: true }) ?? '#';
---

<LocationAuthorityLayout
  pageFamily="location-frigiliana-streets"
  seo={frigilianaStreetsStairsSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_stairs"
  >
    <LocationContextNav slot="context-navigation" activeId="stay" lang={currentLang} />
  </Navigation>

  <div
    class="wts"
    data-am-page="frigiliana-where-to-stay"
    data-am-family="location"
    data-am-role="spoke"
    data-am-topic="where-to-stay"
    data-am-presentation="guide"
  >
    <header class="wts-hero wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1>{c.hero.title}</h1>
          <p class="lede">{c.hero.lede}</p>
          <p class="hbody"><InlineEmphasis text={c.hero.body} /></p>
          <div class="traits">
            {c.hero.traits.map((trait) => <span class="trait"><InlineEmphasis text={trait} /></span>)}
          </div>
        </div>
        <aside class="hero-aside">
          {c.hero.stats.map((stat) => (
            <div class="krow"><div class="k">{stat.k}</div><div class="kl">{stat.l}</div></div>
          ))}
        </aside>
      </div>
    </header>

    <section class="band">
      <div class="wrap">
        <div class="sec-head sec-head--tight">
          <h2>{c.glanceTitle}</h2>
          <p class="intro">{c.glanceIntro}</p>
        </div>
        <div class="glance">
          {c.glance.map((g) => (
            <a class="glance-item" href={g.href}>
              <span class="gi-idx">{g.idx}</span>
              <b>{g.title}</b>
              <span>{g.blurb}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="sec-head">
          <h2>{c.steps.title}</h2>
          <p class="intro">{c.steps.intro}</p>
        </div>
        <div class="steps-grid">
          <div class="steps-copy">
            <p><InlineEmphasis text={c.steps.copy} /></p>
            <p class="steps-note">{c.steps.note}</p>
          </div>
          <ol class="daylist">
            {c.steps.day.map((label, i) => (
              <li><span>{String(i + 1).padStart(2, '0')}</span> {label}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="sec-head">
          <h2>{c.zonesTitle}</h2>
          <p class="intro">{c.zonesIntro}</p>
        </div>
        {c.zones.map((zone, i) => (
          <article class="loc" id={zone.id}>
            <div class:list={['loc-img', zone.img]}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="cap">{zone.cap}</span>
            </div>
            <div class="loc-body">
              <p class="sub">{zone.sub}</p>
              <h3>{zone.h3}</h3>
              <p class="desc">{zone.desc}</p>
              <div class="loc-meta">
                <div><div class="ml">Ideal für</div><div class="mv">{zone.idealFor}</div></div>
                <div><div class="ml">Ehrlich dazu</div><div class="mv"><InlineEmphasis text={zone.honest} /></div></div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="sec-head">
          <h2>{c.whoTitle}</h2>
          <p class="intro">{c.whoIntro}</p>
        </div>
        <div class="types">
          {c.who.map((w) => (
            <div class="type"><h3>{w.title}</h3><p>{w.text}</p></div>
          ))}
        </div>
        <div class="pointer">
          <p><InlineEmphasis text={c.pointer.text} /></p>
          <a href={pointerHref} class="am-pointer-link">{c.pointer.linkLabel} →</a>
        </div>
      </div>
    </section>

    <section class="verdict">
      <div class="wrap">
        <div class="verdict-grid">
          <div>
            <p class="eyebrow eyebrow--gold">{c.verdict.eyebrow}</p>
            <h2>{c.verdict.title}</h2>
            <div class="hill">
              <svg viewBox="0 0 460 230" role="img" aria-label="Höhendiagramm: höher gelegene Altstadt-Adressen am Hang, AMARA vergleichsweise tief an der ebenen Hauptachse">
                <path d="M0,200 L460,54 L460,230 L0,230 Z" fill="rgba(237,191,113,.09)"></path>
                <line x1="0" y1="200" x2="460" y2="54" stroke="rgba(255,255,255,.28)" stroke-width="1.5"></line>
                <line x1="18" y1="203" x2="175" y2="192" stroke="rgba(237,191,113,.6)" stroke-width="2" stroke-dasharray="6 5"></line>
                <circle cx="300" cy="108" r="4.5" fill="#c9c6bf"></circle>
                <circle cx="352" cy="90" r="4.5" fill="#c9c6bf"></circle>
                <circle cx="406" cy="72" r="4.5" fill="#c9c6bf"></circle>
                <text x="286" y="140" fill="#c9c6bf" font-size="12.5">höher gelegene</text>
                <text x="286" y="157" fill="#c9c6bf" font-size="12.5">Altstadt-Adressen</text>
                <circle cx="112" cy="196" r="7.5" fill="#edbf71"></circle>
                <circle cx="112" cy="196" r="13" fill="none" stroke="#edbf71" stroke-opacity=".45"></circle>
                <text x="130" y="192" fill="#fff" font-size="13.5" font-weight="600">AMARA</text>
                <text x="130" y="209" fill="#c9c6bf" font-size="11.5">Calle Real / Chorruelo</text>
                <text x="18" y="223" fill="#a79f93" font-size="11">ebene Hauptachse · Zufahrt</text>
              </svg>
              <p class="hcap">{c.verdict.caption}</p>
            </div>
          </div>
          <div>
            <p class="lead"><InlineEmphasis text={c.verdict.lead} /></p>
            <ul class="vfacts">
              {c.verdict.facts.map((fact) => <li><InlineEmphasis text={fact} /></li>)}
            </ul>
            <p class="honest">{c.verdict.honest}</p>
            <div class="cta-row">
              <a href={bookHref} class="btn">{c.verdict.primaryCta}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FaqAccordion
      arrivalTitle={t(copy.selfCheck.title)}
      steps={selfCheckSteps}
      faqTitle={t(copy.selfCheck.faqTitle)}
      items={faqItems}
    />

    <EditorialGuideLinkSection
      eyebrow={t(copy.related.eyebrow)}
      title={t(copy.related.title)}
      intro={t(copy.related.intro)}
      links={relatedLinks}
    />

    <section class="max-w-screen-2xl mx-auto px-6 md:px-12 pt-8 pb-4">
      <EditorialClosingCta
        title={t(copy.closing.title)}
        lead={t(copy.closing.lead)}
        lang={currentLang}
        links={[
          { token: 'location_frigiliana', label: t(copy.closing.hubCta), style: 'primary' },
          { token: 'romantic_hideaways', label: t(copy.closing.staysCta), style: 'secondary' }
        ]}
      />
    </section>
  </div>
</LocationAuthorityLayout>

<style>
  .wts {
    --ground: var(--color-surface);
    --ground-low: var(--color-surface-container-low);
    --card: var(--color-surface-white, #fff);
    --ink: var(--color-on-surface);
    --ink-soft: var(--color-on-surface-variant);
    --muted: var(--color-muted);
    --primary: var(--color-primary);
    --gold: var(--color-gold);
    --gold-lite: var(--color-primary-fixed-dim);
    --dark: var(--color-inverse-surface);
    --on-dark: var(--color-inverse-on-surface);
    --on-dark-soft: var(--color-inverted-on-surface-muted);
    --line: var(--color-border-subtle);
    --line-soft: rgba(27, 28, 26, 0.08);
    --serif: var(--font-headline);
    --sans: var(--font-body);
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.65;
  }
  .wts .wrap { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
  .wts h1, .wts h2, .wts h3 { font-family: var(--serif); font-weight: 400; margin: 0; }
  .wts p { margin: 0; }
  .wts .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--primary); }

  .wts-hero { padding: 60px 0 26px; }
  .wts-hero h1 { font-size: clamp(2.9rem, 6vw, 4.6rem); line-height: 1.02; letter-spacing: -.01em; max-width: 15ch; margin-top: 8px; }
  .wts-hero .lede { font-family: var(--serif); font-style: italic; font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.4; color: var(--ink-soft); margin-top: 22px; max-width: 34ch; }
  .wts-hero .hbody { margin-top: 22px; color: var(--ink-soft); max-width: 60ch; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: end; }
  .traits { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .trait { font-size: 13px; color: var(--ink-soft); background: var(--ground-low); border: 1px solid var(--line-soft); border-radius: 999px; padding: 8px 15px; }
  .hero-aside { border-left: 2px solid var(--primary); padding: 6px 0 6px 26px; }
  .hero-aside .k { font-family: var(--serif); font-size: 2.6rem; line-height: 1; color: var(--primary); }
  .hero-aside .krow + .krow { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--line); }
  .hero-aside .kl { font-size: 13px; color: var(--muted); margin-top: 6px; }

  .wts section { padding: 56px 0; }
  .wts .band { border-top: 1px solid var(--line); }
  .sec-head { display: grid; grid-template-columns: .9fr 1.1fr; gap: 40px; align-items: start; margin-bottom: 34px; }
  .sec-head--tight { margin-bottom: 8px; }
  .sec-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); line-height: 1.08; letter-spacing: -.01em; max-width: 16ch; }
  .sec-head .intro { color: var(--ink-soft); max-width: 52ch; }

  .glance { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .glance-item { display: block; text-decoration: none; color: inherit; background: var(--card); border: 1px solid var(--line-soft); border-left: 3px solid var(--primary); padding: 20px 22px; transition: border-color .15s; }
  .glance-item:hover { border-left-color: var(--gold); }
  .glance-item .gi-idx { font-family: var(--serif); font-style: italic; color: var(--primary); font-size: 1.05rem; }
  .glance-item b { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.4rem; margin: 5px 0 7px; }
  .glance-item span:last-child { display: block; font-size: 14px; color: var(--ink-soft); line-height: 1.5; }

  .steps-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: start; }
  .steps-copy p { color: var(--ink-soft); }
  .steps-note { margin-top: 18px; font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--primary); line-height: 1.3; }
  .daylist { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .daylist li { display: flex; gap: 16px; align-items: baseline; padding: 14px 2px; border-bottom: 1px solid var(--line-soft); font-size: 15.5px; color: var(--ink-soft); }
  .daylist li span { font-family: var(--serif); font-style: italic; color: var(--primary); font-size: 1.15rem; min-width: 26px; }

  .loc { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); margin-top: 22px; background: var(--card); scroll-margin-top: 90px; }
  .loc:nth-of-type(even) .loc-img { order: 2; }
  .loc-img { min-height: 340px; position: relative; overflow: hidden; }
  .loc-img .cap { position: absolute; left: 18px; bottom: 16px; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.9); text-shadow: 0 1px 6px rgba(0,0,0,.4); }
  .loc-img .idx { position: absolute; left: 20px; top: 16px; font-family: var(--serif); font-style: italic; font-size: 2.4rem; color: rgba(255,255,255,.92); text-shadow: 0 1px 8px rgba(0,0,0,.35); }
  .g1 { background: linear-gradient(150deg, #e9e2d4 0%, #d8c8ad 45%, #b89b6b 100%); }
  .g2 { background: linear-gradient(150deg, #cfe0e6 0%, #a9c6cf 50%, #7c929a 100%); }
  .g3 { background: linear-gradient(150deg, #e7ddc9 0%, #c9b487 48%, #8a7a3f 100%); }
  .loc-body { padding: 34px 36px; }
  .loc-body h3 { font-size: 1.9rem; line-height: 1.1; margin-bottom: 6px; }
  .loc-body .sub { font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--primary); font-weight: 600; }
  .loc-body .desc { margin-top: 16px; color: var(--ink-soft); font-size: 15.5px; }
  .loc-meta { margin-top: 22px; border-top: 1px solid var(--line-soft); }
  .loc-meta > div { padding: 14px 0; border-bottom: 1px solid var(--line-soft); }
  .loc-meta .ml { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--primary); font-weight: 600; }
  .loc-meta .mv { margin-top: 5px; font-size: 14.5px; color: var(--ink-soft); }

  .types { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .type { background: var(--card); border: 1px solid var(--line-soft); border-top: 2px solid var(--primary); padding: 22px 20px 24px; }
  .type h3 { font-size: 1.28rem; margin-bottom: 8px; }
  .type p { font-size: 14.5px; color: var(--ink-soft); line-height: 1.55; }

  .pointer { margin-top: 28px; border: 1px solid var(--line); border-left: 3px solid var(--gold); background: var(--ground-low); padding: 20px 26px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .pointer p { font-size: 15px; color: var(--ink-soft); }
  .am-pointer-link { white-space: nowrap; font-size: 14px; font-weight: 600; color: var(--primary); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--primary) 32%, transparent); padding-bottom: 2px; }

  .verdict { background: var(--dark); color: var(--on-dark); }
  .verdict .eyebrow--gold { color: var(--gold-lite); }
  .verdict-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 48px; align-items: start; }
  .verdict h2 { font-size: clamp(2rem, 3.6vw, 2.9rem); line-height: 1.08; color: #fff; max-width: 14ch; font-style: italic; margin-top: 18px; }
  .verdict .lead { color: var(--on-dark-soft); font-size: 16.5px; }
  .vfacts { list-style: none; padding: 0; margin: 22px 0 0; }
  .vfacts li { padding: 13px 0; border-top: 1px solid rgba(255,255,255,.14); font-size: 15px; color: var(--on-dark-soft); }
  .honest { margin-top: 22px; border-left: 2px solid var(--gold-lite); padding: 4px 0 4px 18px; font-family: var(--serif); font-style: italic; color: var(--on-dark-soft); font-size: 15.5px; line-height: 1.5; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 30px; }
  .btn { display: inline-block; background: var(--gold-lite); color: #241a06; font-weight: 600; font-size: 15px; padding: 14px 26px; border-radius: 2px; text-decoration: none; }
  .hill { margin-top: 26px; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.03); padding: 18px 18px 14px; }
  .hill svg { width: 100%; height: auto; display: block; }
  .hill svg text { font-family: var(--sans); }
  .hcap { margin-top: 10px; font-size: 12px; color: var(--on-dark-soft); }

  @media (max-width: 860px) {
    .hero-grid, .sec-head, .verdict-grid, .steps-grid, .glance, .types { grid-template-columns: 1fr; gap: 30px; }
    .types { grid-template-columns: 1fr 1fr; }
    .loc { grid-template-columns: 1fr; }
    .loc .loc-img { order: 0; }
    .loc-img { min-height: 220px; }
  }
</style>
