---
import Hero from '../../components/Hero.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import HairlineStatCard from '../../components/location/HairlineStatCard.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaStreetsStairsCopy,
  frigilianaStreetsStairsSeo
} from '../../content/frigilianaStreetsStairsContent';
import {
  frigilianaPreFooterCopy,
  getFrigilianaPreFooterDescription
} from '../../content/frigilianaPreFooterContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { getFrigilianaAuthoritySubnav } from '../../lib/frigiliana/frigilianaAuthoritySubnav';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaStreetsStairsCopy;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const streetsHref = buildOwnedLocalizedPath('frigiliana-streets-stairs', currentLang);
const parkingHref = buildOwnedLocalizedPath('frigiliana-parking', currentLang);

const sectionNavItems = getFrigilianaAuthoritySubnav(currentLang).map((item) =>
  item.id === 'structure'
    ? {
        ...item,
        href: streetsHref,
        label: t(copy.nav.links[1].label)
      }
    : item
);

const navLinks = copy.nav.links.map((link) => ({
  token: link.token,
  label: t(link.label)
}));

const factors = copy.factors.items.map((item) => ({
  label: t(item.label),
  value: t(item.value),
  note: t(item.note)
}));

const zones = copy.zones.items.map((item) => ({
  number: item.number,
  title: t(item.title),
  summary: t(item.summary),
  rhythm: t(item.rhythm),
  tradeoff: t(item.tradeoff)
}));

const rhythmSteps = copy.rhythm.steps.map((step) => ({
  number: step.number,
  label: t(step.label)
}));

const selfCheckSteps = copy.selfCheck.steps.map((step) => ({
  num: step.num,
  headline: t(step.title),
  text: t(step.text)
}));

const faqItems = copy.selfCheck.faq.map((item) => ({
  question: t(item.question),
  answer: t(item.answer)
}));

const relatedLinks = copy.related.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, {
    suppressMissing: true
  });

  return href
    ? [{
        href,
        label: t(link.label),
        text: getFrigilianaPreFooterDescription(link.token, currentLang)
      }]
    : [];
});

const footerHighlights = [
  {
    token: 'frigiliana_stairs',
    label: t(copy.nav.links[1].label)
  },
  {
    token: 'frigiliana_parking',
    label: t(copy.nav.links[2].label)
  },
  {
    token: 'getting_to_frigiliana',
    label: t(copy.related.links[2].label)
  }
];

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/08-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};

const contextImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/04-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};
---

<LocationAuthorityLayout
  seo={frigilianaStreetsStairsSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    currentLang={currentLang}
    brandName={t(copy.nav.brand)}
    links={navLinks}
    languageToken="frigiliana_stairs"
    locationAuthorityNav={true}
  />
  <LocationContextNav items={sectionNavItems} activeId="structure" lang={currentLang} />

  <div class="am-root" data-am-page="frigiliana-streets-stairs">
    <div class="am-wrap w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={t(copy.hero.imageAlt)}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {t(copy.hero.eyebrow)}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {t(copy.hero.title)}
        </h1>
        <div class="pl-10 border-l border-primary/20 max-w-xl mb-14 space-y-6">
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.lead)}
          </p>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.body)}
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href="#village-levels"
            class="am-btn am-btn--primary"
          >
            {t(copy.hero.primaryCta)}
          </a>
          <a
            href={parkingHref}
            class="am-btn am-btn--secondary"
          >
            {t(copy.hero.secondaryCta)}
          </a>
        </div>
      </Hero>

      <section class="max-w-screen-2xl mx-auto px-12 pb-32">
        <div class="max-w-4xl mb-16">
          <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
            {t(copy.principle.eyebrow)}
          </span>
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
            {t(copy.principle.title)}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed max-w-3xl">
            {t(copy.principle.body)}
          </p>
        </div>
        <h3 class="am-text-subtitle text-on-surface mb-12">{t(copy.factors.title)}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-12 gap-y-12">
          {
            factors.map((factor) => (
              <HairlineStatCard
                label={factor.label}
                value={factor.value}
                description={factor.note}
              />
            ))
          }
        </div>
      </section>

      <section
        id="village-levels"
        class="bg-surface-container-low border-y border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-12 py-32">
          <div class="max-w-3xl mb-20">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.zones.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.zones.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.zones.intro)}
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-12 gap-y-16">
            {
              zones.map((zone) => (
                <article class="border-t border-outline-variant/25 pt-8">
                  <div class="flex items-baseline justify-between gap-6 mb-10">
                    <h3 class="am-text-subtitle text-on-surface">{zone.title}</h3>
                    <span
                      class="font-headline text-[clamp(2.5rem,5vw,4.75rem)] italic leading-none text-outline-variant/45"
                      aria-hidden="true"
                    >
                      {zone.number}
                    </span>
                  </div>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {zone.summary}
                  </p>
                  <dl class="mt-10 divide-y divide-outline-variant/10 border-y border-outline-variant/10">
                    <div class="py-6">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {t(copy.zones.labels.rhythm)}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {zone.rhythm}
                      </dd>
                    </div>
                    <div class="py-6">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {t(copy.zones.labels.tradeoff)}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {zone.tradeoff}
                      </dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="max-w-screen-2xl mx-auto px-12 py-32">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
          <div class="lg:col-span-5">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.rhythm.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.rhythm.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed mb-8">
              {t(copy.rhythm.intro)}
            </p>
            <p class="am-text-body text-on-surface leading-relaxed border-l border-primary/30 pl-7">
              {t(copy.rhythm.conclusion)}
            </p>
          </div>
          <ol class="lg:col-span-7 border-t border-outline-variant/15">
            {
              rhythmSteps.map((step) => (
                <li class="grid grid-cols-[auto_1fr] gap-8 items-center py-8 border-b border-outline-variant/15">
                  <span class="font-headline text-4xl italic leading-none text-outline-variant/60" aria-hidden="true">
                    {step.number}
                  </span>
                  <span class="am-text-subtitle text-on-surface">{step.label}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <FaqAccordion
        arrivalTitle={t(copy.selfCheck.title)}
        steps={selfCheckSteps}
        faqTitle={t(copy.selfCheck.faqTitle)}
        items={faqItems}
      />

      <section class="bg-surface-container-low border-y border-outline-variant/5">
        <div class="max-w-screen-2xl mx-auto px-12 py-32">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
            <div class="lg:col-span-6">
              <AmaraImage
                src={contextImage.src}
                alt={t(copy.context.imageAlt)}
                profile="card"
                class="w-full aspect-[4/3] object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="lg:col-span-6 lg:pl-10">
              <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
                {t(copy.context.eyebrow)}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                {t(copy.context.title)}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed max-w-xl">
                {t(copy.context.body)}
              </p>
            </div>
          </div>
        </div>
      </section>

      <EditorialGuideLinkSection
        eyebrow={frigilianaPreFooterCopy.eyebrow[currentLang]}
        title={t(copy.related.title)}
        intro={frigilianaPreFooterCopy.intro[currentLang]}
        links={relatedLinks}
      />

      <section class="max-w-screen-2xl mx-auto px-12 pt-8">
        <EditorialClosingCta
          title={t(copy.closing.title)}
          lead={t(copy.closing.lead)}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: t(copy.closing.staysCta),
              style: 'primary'
            },
            {
              token: 'frigiliana_parking',
              label: t(copy.closing.parkingCta),
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  @media (max-width: 767px) {
    :global([data-am-page='frigiliana-streets-stairs'] .px-12) {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>
