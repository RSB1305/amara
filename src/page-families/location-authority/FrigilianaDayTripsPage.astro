---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import GuideClosingSection from './GuideClosingSection.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import ExperiencePreFooter from '../../components/experience/ExperiencePreFooter.astro';
import {
  frigilianaDayTripsContent,
  frigilianaDayTripsSeo
} from '../../content/frigilianaDayTripsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import DayTripDestinationList from './DayTripDestinationList.astro';
import GuideLinkCardSection from './GuideLinkCardSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaDayTripsContent[currentLang];

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_daytrips_authority',
    label: copy.footerHighlights.dayTrips
  },
  {
    token: 'frigiliana_beaches_authority',
    label: copy.footerHighlights.beaches
  },
  {
    token: 'frigiliana_food_authority',
    label: copy.footerHighlights.restaurants
  }
];

const combineItems = copy.combine.items.map((item) => ({
  ...item,
  href: resolveOptionalLink(item.linkToken, currentLang, {
    suppressMissing: true
  })
}));

const heroImage = {
  src: '/images/hero-frigiliana.jpg',
  width: 1080
};
---

<LocationAuthorityLayout
  seo={frigilianaDayTripsSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-frigiliana-day-trips"
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_daytrips_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="dayTrips" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-day-trips">
    <div class="w-full">
      <LocationExperienceHero
        topic="day-trips"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        paragraphs={copy.hero.paragraphs}
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
      />

      <AuthorityFeatureSection
        id="overview"
        title={copy.overview.title}
        intro={copy.overview.intro}
        items={copy.overview.items}
        headerCallout={{ text: copy.overview.rule, surface: 'lowest' }}
        reviewed={copy.overview.reviewed}
      />

      <DayTripDestinationList destinations={copy.destinations} />

      <AuthorityFeatureSection
        id="practical"
        title={copy.practical.title}
        intro={copy.practical.intro}
        items={copy.practical.items}
      />

      <GuideLinkCardSection
        title={copy.combine.title}
        intro={copy.combine.intro}
        items={combineItems}
      />

      <ExperiencePreFooter currentId="dayTrips" lang={currentLang} />

      <GuideClosingSection
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.staysCta,
              style: 'text'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'text'
            }
          ]}
          role="next-action"
          family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
