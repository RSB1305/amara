---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import DayTripRadiusGraphic, { type DayTripRadiusGraphicData } from '../../components/location/DayTripRadiusGraphic.astro';
import Navigation from '../../components/Navigation.astro';
import GuideClosingSection from './GuideClosingSection.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  frigilianaDayTripsContent,
  frigilianaDayTripsSeo
} from '../../content/frigilianaDayTripsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import DayTripDestinationList from './DayTripDestinationList.astro';
import { publicDayTrip } from '../../lib/placeProjection';
import { routeHero } from '../../lib/images/routeImages';
import GuideLinkCardSection from './GuideLinkCardSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = routeHero('frigiliana.experience.day-trips', currentLang);
const copy = frigilianaDayTripsContent[currentLang];

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_daytrips_authority',
    label: copy.footerHighlights.dayTrips
  },
  {
    token: 'frigiliana_beaches_authority',
    label: copy.footerHighlights.beaches
  },
  {
    token: 'frigiliana_food_authority',
    label: copy.footerHighlights.restaurants
  }
];

const destinations = copy.destinationIds.map((id) => publicDayTrip(id, currentLang));

const combineItems = copy.combine.items.map((item) => ({
  ...item,
  href: resolveOptionalLink(item.linkToken, currentLang, {
    suppressMissing: true
  })
}));

const dayTripGraphicByLang: Record<AmaraLanguage, DayTripRadiusGraphicData> = {
  en: {
    place: 'frigiliana', eyebrow: 'Day trips', destination: 'Frigiliana',
    region: 'Andalusia', baseLabel: 'FRIGILIANA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Map of four Andalusian day trips from Frigiliana with drive times',
    context: [
      { label: 'Destinations', value: 'Four day trips' },
      { label: 'Drive time', value: '50 min – 2 h' },
      { label: 'Our advice', value: 'One per day' }
    ]
  },
  de: {
    place: 'frigiliana', eyebrow: 'Tagesausflüge', destination: 'Frigiliana',
    region: 'Andalusien', baseLabel: 'FRIGILIANA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Karte mit vier andalusischen Tagesausflügen ab Frigiliana samt Fahrzeiten',
    context: [
      { label: 'Ziele', value: 'Vier Tagesausflüge' },
      { label: 'Fahrzeit', value: '50 Min. – 2 Std.' },
      { label: 'Empfehlung', value: 'Eins pro Tag' }
    ]
  },
  es: {
    place: 'frigiliana', eyebrow: 'Excursiones', destination: 'Frigiliana',
    region: 'Andalucía', baseLabel: 'FRIGILIANA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Mapa de cuatro excursiones andaluzas desde Frigiliana con tiempos de coche',
    context: [
      { label: 'Destinos', value: 'Cuatro excursiones' },
      { label: 'Trayecto', value: '50 min – 2 h' },
      { label: 'Consejo', value: 'Uno por día' }
    ]
  },
  nl: {
    place: 'frigiliana', eyebrow: 'Dagtochten', destination: 'Frigiliana',
    region: 'Andalusië', baseLabel: 'FRIGILIANA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Kaart met vier Andalusische dagtochten vanuit Frigiliana met rijtijden',
    context: [
      { label: 'Bestemmingen', value: 'Vier dagtochten' },
      { label: 'Rijtijd', value: '50 min – 2 u' },
      { label: 'Ons advies', value: 'Eén per dag' }
    ]
  },
  sv: {
    place: 'frigiliana', eyebrow: 'Dagsutflykter', destination: 'Frigiliana',
    region: 'Andalusien', baseLabel: 'FRIGILIANA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Karta med fyra andalusiska dagsutflykter från Frigiliana med restider',
    context: [
      { label: 'Mål', value: 'Fyra dagsutflykter' },
      { label: 'Restid', value: '50 min – 2 h' },
      { label: 'Vårt råd', value: 'En per dag' }
    ]
  }
};
const dayTripGraphicData = dayTripGraphicByLang[currentLang];

---

<LocationAuthorityLayout
  seo={frigilianaDayTripsSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-frigiliana-day-trips"
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_daytrips_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="dayTrips" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-day-trips">
    <div class="w-full">
      <LocationExperienceHero
        {...hero}
        topic="day-trips"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        subtitle={copy.hero.subtitle}
        paragraphs={copy.hero.paragraphs}
      >
        <DayTripRadiusGraphic slot="visual" data={dayTripGraphicData} />
      </LocationExperienceHero>

      <AuthorityFeatureSection
        id="overview"
        title={copy.overview.title}
        intro={copy.overview.intro}
        items={copy.overview.items}
        headerCallout={{ text: copy.overview.rule, surface: 'lowest' }}
        reviewed={copy.overview.reviewed}
      />

      <DayTripDestinationList destinations={destinations} />

      <AuthorityFeatureSection
        id="practical"
        title={copy.practical.title}
        intro={copy.practical.intro}
        items={copy.practical.items}
      />

      <GuideLinkCardSection
        title={copy.combine.title}
        intro={copy.combine.intro}
        items={combineItems}
      />

      <GuestGuideBridge
        lang={currentLang}
        destination="frigiliana"
        guideSlugs={['frigiliana-guest-day-trips']}
      />

      <GuideClosingSection
        title={copy.closing.title}
        lead={copy.closing.lead}
        lang={currentLang}
        links={[
          {
            token: 'frigiliana_parking',
            label: copy.closing.nextCta,
            style: 'text'
          }
        ]}
        role="next-action"
        family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
