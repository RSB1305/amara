---
import Hero from '../../components/Hero.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialFeatureGrid from '../../components/editorial/EditorialFeatureGrid.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import ExperiencePreFooter from '../../components/experience/ExperiencePreFooter.astro';
import {
  frigilianaDayTripsContent,
  frigilianaDayTripsSeo
} from '../../content/frigilianaDayTripsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaDayTripsContent[currentLang];

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_daytrips_authority',
    label: copy.footerHighlights.dayTrips
  },
  {
    token: 'frigiliana_beaches_authority',
    label: copy.footerHighlights.beaches
  },
  {
    token: 'frigiliana_food_authority',
    label: copy.footerHighlights.restaurants
  }
];

const combineItems = copy.combine.items.map((item) => ({
  ...item,
  href: resolveOptionalLink(item.linkToken, currentLang, {
    suppressMissing: true
  })
}));

const heroImage = {
  src: '/images/hero-frigiliana.jpg',
  width: 1080,
  height: 721
};
---

<LocationAuthorityLayout
  seo={frigilianaDayTripsSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_daytrips_authority"
  />
  <ExperienceContextNav currentId="dayTrips" lang={currentLang} />

  <div data-am-page="frigiliana-day-trips">
    <div class="w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {copy.hero.kicker}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {copy.hero.title}
        </h1>
        <div class="pl-10 border-l border-primary/20 max-w-xl space-y-6">
          {
            copy.hero.paragraphs.map((paragraph) => (
              <p class="am-text-body text-on-surface-variant leading-relaxed">
                {paragraph}
              </p>
            ))
          }
        </div>
      </Hero>

      <section
        id="overview"
        class="am-section am-section--tint !px-6 md:!px-12"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.overview.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.overview.intro}
          </p>
          <p class="mt-8 border-l border-primary/20 bg-surface-container-lowest px-4 py-3 am-text-body leading-relaxed text-on-surface-variant">
            {copy.overview.rule}
          </p>
          <p class="mt-6 am-text-caption normal-case tracking-normal text-on-surface-variant">
            {copy.overview.reviewed}
          </p>
        </div>

        <EditorialFeatureGrid
          cards={copy.overview.items.map((item) => ({
            title: item.title,
            copy: item.text
          }))}
        />
      </section>

      {
        copy.destinations.map((destination, index) => (
          <section
            id={destination.id}
            class:list={[
              'am-section !px-6 md:!px-12',
              index % 2 === 0 ? 'am-section--plain' : 'am-section--tint'
            ]}
          >
            <div class="max-w-3xl mb-16">
              <p class="am-text-caption text-primary mb-5">
                {destination.kicker}
              </p>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
                {destination.title}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed">
                {destination.summary}
              </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-14">
              <article class="lg:col-span-5 border-t border-outline-variant/25 pt-8">
                <dl class="space-y-7">
                  {destination.facts.map((fact) => (
                    <div>
                      <dt class="am-text-caption text-primary mb-2">
                        {fact.label}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {fact.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              </article>

              <article class="lg:col-span-7 border-t border-outline-variant/25 pt-8">
                <h3 class="am-text-subtitle text-on-surface mb-6">
                  {destination.planningTitle}
                </h3>
                <p class="border-l border-primary/20 bg-surface-container-low px-4 py-3 am-text-body leading-relaxed text-on-surface-variant">
                  {destination.callout}
                </p>
                <p class="mt-7 am-text-body text-on-surface-variant leading-relaxed">
                  {destination.details}
                </p>
                <p class="mt-7 am-text-body">
                  <a
                    href={destination.officialHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="am-inline-link"
                  >
                    {destination.officialLabel}
                    <span aria-hidden="true"> &rarr;</span>
                  </a>
                </p>
              </article>
            </div>
          </section>
        ))
      }

      <section
        id="practical"
        class="am-section am-section--tint !px-6 md:!px-12"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.practical.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.practical.intro}
          </p>
        </div>

        <EditorialFeatureGrid
          cards={copy.practical.items.map((item) => ({
            title: item.title,
            copy: item.text
          }))}
        />
      </section>

      <section class="am-section am-section--plain !px-6 md:!px-12">
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.combine.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.combine.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14">
          {
            combineItems.map((item) => (
              <article class="border-t border-outline-variant/25 pt-8">
                <h3 class="am-text-subtitle text-on-surface mb-5">
                  {item.title}
                </h3>
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {item.text}
                </p>
                {item.href && (
                  <p class="mt-5 am-text-body">
                    <a href={item.href} class="am-inline-link">
                      {item.linkLabel}
                      <span aria-hidden="true"> &rarr;</span>
                    </a>
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <ExperiencePreFooter currentId="dayTrips" lang={currentLang} />

      <section class="max-w-screen-2xl mx-auto px-6 pt-24 md:px-12">
        <EditorialClosingCta
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.staysCta,
              style: 'primary'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>
