---
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  nerjaCavesContent,
  nerjaCavesSeo
} from '../../content/nerjaCavesContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = nerjaCavesContent[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja caves');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_nerja');
const propertyHref = requiredLink('playa');
const personalImage = '/images/nerja/nerja-cave-VR.jpeg';
const footerHighlights: LabeledLink[] = [
  { token: 'nerja_caves', label: content.navLabel },
  { token: 'nerja_geography', label: content.related.links[0].label },
  { token: 'nerja_weather', label: content.related.links[1].label }
];
---

<LocationAuthorityLayout
  seo={nerjaCavesSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="nerja_caves"
  />
  <ExperienceContextNav currentId="caves" destination="nerja" lang={currentLang} />

  <AuthorityArticle
    pageId="nerja-caves"
    lang={currentLang}
    hero={content.hero}
    authorName={nerjaCavesSeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
    secondaryCta={{ href: locationHref, label: content.closing.locationLabel }}
  >
    {content.sections.map((section, index) => (
      <AuthorityTextSection section={section} index={index} />
    ))}

    <section
      id="our-visit"
      class="scroll-mt-32 border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28"
    >
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <AmaraImage
            src={personalImage}
            alt={content.personal.imageAlt}
            profile="card"
            class="w-full object-cover aspect-[3/4]"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="lg:col-span-7">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{content.personal.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.personal.title}</h2>
          <div class="mt-8 max-w-3xl space-y-5">
            {content.personal.paragraphs.map((paragraph, paragraphIndex) => (
              <p
                class:list={[
                  paragraphIndex === 0 ? 'am-text-subtitle' : 'am-text-body',
                  'leading-relaxed text-on-surface-variant'
                ]}
              >
                {paragraph}
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <AuthorityRelatedLinks
      related={content.related}
      columns="md:grid-cols-2"
      resolveHref={requiredLink}
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
