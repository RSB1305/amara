---
import tarifaStayImage from '../../assets/images/home/amara-tarifa-apartment01.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  gettingToTarifaContent,
  gettingToTarifaSeo
} from '../../content/gettingToTarifaContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = gettingToTarifaContent[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Getting to Tarifa');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_tarifa');
const areasHref = requiredLink('tarifa_where_to_stay');
const footerHighlights: LabeledLink[] = [
  { token: 'getting_to_tarifa', label: content.navLabel },
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_where_to_stay', label: content.closing.areasLabel }
];
---

<LocationAuthorityLayout
  seo={gettingToTarifaSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="getting_to_tarifa"
  />
  <TarifaContextNav
    activeId="overview"
    activeChildId="arrival-mobility"
    currentLabel="Tarifa"
    childLabel={content.navLabel}
    lang={currentLang}
  />

  <AuthorityArticle
    pageId="getting-to-tarifa"
    lang={currentLang}
    hero={content.hero}
    authorName={gettingToTarifaSeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    secondaryCta={{ href: areasHref, label: content.closing.areasLabel }}
  >
    <div
      slot="hero-mark"
      aria-hidden="true"
      class="hidden font-serif text-[clamp(3.5rem,8vw,8.5rem)] leading-[0.72] text-primary/10 lg:col-span-4 lg:block"
    >
      Tarifa
    </div>

    {content.sections.map((section, index) => (
      <>
        <AuthorityTextSection
          section={section}
          index={index}
          highlightIndex={2}
          highlightSurface="bg-surface-container-low"
        />

        {index === 2 && (
          <section class="border-b border-border-subtle bg-inverse-surface px-6 py-16 md:px-12 md:py-20">
            <div class="mx-auto grid max-w-screen-2xl overflow-hidden lg:grid-cols-[0.9fr_1.1fr]">
              <figure class="am-mobile-full-bleed min-h-[320px] bg-surface-container-high lg:min-h-[500px]">
                <AmaraImage
                  src={tarifaStayImage}
                  alt=""
                  profile="gallery"
                  class="h-full w-full object-cover"
                  sizes="(max-width: 1023px) 100vw, 45vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="flex flex-col justify-center p-8 text-inverted-on-surface md:p-14 lg:p-16">
                <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary-fixed-dim">AMARA Family & Surf</p>
                <p class="am-text-title mt-5 text-balance text-inverted-on-surface">Mar Adriático 29 · La Marina · Tarifa</p>
                <p class="am-text-body mt-7 max-w-xl leading-relaxed text-inverted-on-surface/75">{content.hero.standfirst}</p>
              </div>
            </div>
          </section>
        )}
      </>
    ))}
  </AuthorityArticle>
</LocationAuthorityLayout>
