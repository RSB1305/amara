---
import tarifaSurfClubTeamImage from '../../assets/images/content/tarifa/tarifa-surf-club-team.webp';
import markRobertTarifaImage from '../../assets/images/content/tarifa/mark-robert-tarifa-surf-club.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import { tarifaGuideContent, type LocalizedText, type TarifaTopicGuideContent } from '../../content/tarifaGuideContent';
import { tarifaKitesurfSpokeContent, type TarifaKitesurfSpokeId } from '../../content/tarifaKitesurfContent';
import { tarifaKitePartnerContent } from '../../content/tarifaKitePartnerContent';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import { tarifaKitesurfSpotsContent, tarifaKitesurfSpotsHandoff } from '../../content/tarifaKitesurfSpotsContent';
import { tarifaKitesurfWindContent } from '../../content/tarifaKitesurfWindContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink, type LinkToken } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import LocationModule from './LocationModule.astro';

/**
 * Hub of the Tarifa kitesurf cluster: the authority page for kitesurfing in
 * Tarifa. Its text base is the wind topic of the Tarifa guide: the two wind
 * systems, the main areas, the check before launching, the safety notice,
 * practical questions and sources. The spokes (school, camp, equipment,
 * partner page) and the knowledge pages (wind, spots, forecast) hang off it.
 * The partnership with Tarifa Surf Club is one module here; it has its own
 * page under amara-tarifa-surf-club.
 */
interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const t = (value: LocalizedText) => value[currentLang];
const content = tarifaGuideContent.wind as TarifaTopicGuideContent;
const partnership = content.partnership!;
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf hub');
const aboutHref = requiredLink('about');
const propertyHref = requiredLink('tarifa');
const partnerHref = requiredLink('amara_tarifa_surf_club');
const contactHref = `https://wa.me/34604440964?text=${encodeURIComponent(t(partnership.contactMessage))}`;

const ui = {
  hubLabel: { en: 'Kitesurfing in Tarifa', de: 'Kitesurfen in Tarifa', es: 'Kitesurf en Tarifa', nl: 'Kitesurfen in Tarifa', sv: 'Kitesurfing i Tarifa' },
  heroImageAlt: { en: 'Tarifa Surf Club team together at the beach in Tarifa', de: 'Das Team des Tarifa Surf Club gemeinsam am Strand von Tarifa', es: 'El equipo de Tarifa Surf Club reunido en la playa de Tarifa', nl: 'Het team van Tarifa Surf Club samen op het strand van Tarifa', sv: 'Tarifa Surf Club-teamet samlat på stranden i Tarifa' },
  factsEyebrow: { en: 'In short', de: 'Kurz gesagt', es: 'En resumen', nl: 'In het kort', sv: 'Kort sagt' },
  pathsEyebrow: { en: 'Your kite stay', de: 'Euer Kite-Aufenthalt', es: 'Vuestra estancia de kite', nl: 'Jullie kiteverblijf', sv: 'Er kitevistelse' },
  pathsTitle: { en: 'Everything you need, clearly separated', de: 'Alles, was ihr braucht, klar gegliedert', es: 'Todo lo que necesitáis, bien ordenado', nl: 'Alles wat jullie nodig hebben, overzichtelijk', sv: 'Allt ni behöver, tydligt uppdelat' },
  spotsEyebrow: { en: 'Where you ride', de: 'Wo ihr fahrt', es: 'Dónde navegáis', nl: 'Waar jullie varen', sv: 'Var ni åker' },
  windEyebrow: { en: 'Before the water', de: 'Vor dem Wasser', es: 'Antes del agua', nl: 'Vóór het water', sv: 'Före vattnet' },
  schoolEyebrow: { en: 'Kite school in Tarifa', de: 'Kiteschule in Tarifa', es: 'Escuela de kite en Tarifa', nl: 'Kiteschool in Tarifa', sv: 'Kiteskola i Tarifa' },
  schoolTitle: { en: 'Gear, rental and courses', de: 'Material, Leihen und Kurse', es: 'Material, alquiler y cursos', nl: 'Materiaal, huren en lessen', sv: 'Utrustning, hyra och kurser' },
  schoolText: { en: 'Courses at Tarifa Surf Club with gear included, rental and shop for your own sessions, prices with their date.', de: 'Kurse beim Tarifa Surf Club mit Material inklusive, Verleih und Shop für eigene Sessions, Preise mit Stand.', es: 'Cursos en Tarifa Surf Club con material incluido, alquiler y tienda para vuestras propias sesiones, precios con fecha.', nl: 'Lessen bij Tarifa Surf Club met materiaal inbegrepen, verhuur en shop voor eigen sessies, prijzen met datum.', sv: 'Kurser hos Tarifa Surf Club med utrustning inkluderad, uthyrning och butik för egna sessioner, priser med datum.' },
  partnerCardEyebrow: { en: 'The partnership', de: 'Die Partnerschaft', es: 'La colaboración', nl: 'Het partnerschap', sv: 'Partnerskapet' },
  readMore: { en: 'Explore this topic', de: 'Thema entdecken', es: 'Descubrir este tema', nl: 'Ontdek dit thema', sv: 'Upptäck ämnet' },
  windsLink: { en: 'Wind, weather and safety in depth', de: 'Wind, Wetter und Sicherheit im Detail', es: 'Viento, tiempo y seguridad en detalle', nl: 'Wind, weer en veiligheid in detail', sv: 'Vind, väder och säkerhet i detalj' },
  areasLink: { en: 'The kitesurf spots with map', de: 'Die Kitesurf-Spots mit Karte', es: 'Los spots de kitesurf con mapa', nl: 'De kitesurfspots met kaart', sv: 'Kitesurfspots med karta' },
  checklistLink: { en: 'Today in Tarifa: warnings, briefing, Windguru', de: 'Heute in Tarifa: Warnungen, Briefing, Windguru', es: 'Hoy en Tarifa: avisos, briefing, Windguru', nl: 'Vandaag in Tarifa: waarschuwingen, briefing, Windguru', sv: 'I dag i Tarifa: varningar, briefing, Windguru' },
  personalTitle: { en: 'Short lines between AMARA and the Surf Club', de: 'Kurze Wege zwischen AMARA und dem Surf Club', es: 'Comunicación directa entre AMARA y el Surf Club', nl: 'Korte lijnen tussen AMARA en de Surf Club', sv: 'Direkt kontakt mellan AMARA och Surf Club' },
  partnerPageLink: { en: 'The partnership in detail: AMARA × Tarifa Surf Club', de: 'Die Partnerschaft im Detail: AMARA × Tarifa Surf Club', es: 'La colaboración en detalle: AMARA × Tarifa Surf Club', nl: 'Het partnerschap in detail: AMARA × Tarifa Surf Club', sv: 'Partnerskapet i detalj: AMARA × Tarifa Surf Club' },
  faqEyebrow: { en: 'FAQ', de: 'FAQ', es: 'FAQ', nl: 'FAQ', sv: 'FAQ' },
  faqTitle: { en: 'Practical questions', de: 'Praktische Fragen', es: 'Preguntas prácticas', nl: 'Praktische vragen', sv: 'Praktiska frågor' },
  sourcesEyebrow: { en: 'Editorial transparency', de: 'Redaktionelle Transparenz', es: 'Transparencia editorial', nl: 'Redactionele transparantie', sv: 'Redaktionell transparens' },
  sourcesTitle: { en: 'Sources for this guide', de: 'Quellen dieses Guides', es: 'Fuentes de esta guía', nl: 'Bronnen van deze gids', sv: 'Källor till den här guiden' },
  sourcesText: { en: 'Official rules, the municipal beach plan and the partner school. Signs, buoys and current orders on site take priority.', de: 'Amtliche Regeln, der kommunale Strandplan und die Partnerschule. Beschilderung, Bojen und aktuelle Anordnungen vor Ort gehen vor.', es: 'Normas oficiales, el plan municipal de playas y la escuela asociada. La señalización, las boyas y las órdenes vigentes sobre el terreno tienen prioridad.', nl: 'Officiële regels, het gemeentelijke strandplan en de partnerschool. Borden, boeien en actuele aanwijzingen ter plaatse gaan voor.', sv: 'Officiella regler, kommunens strandplan och partnerskolan. Skyltar, bojar och aktuella anvisningar på plats gäller först.' },
  propertyLabel: { en: 'View AMARA Family & Surf', de: 'AMARA Family & Surf ansehen', es: 'Ver AMARA Family & Surf', nl: 'Bekijk AMARA Family & Surf', sv: 'Visa AMARA Family & Surf' }
} satisfies Record<string, LocalizedText>;

const spokeOrder: TarifaKitesurfSpokeId[] = ['kite-school', 'kitecamp', 'equipment'];
const cards = [
  { id: 'spots', href: requiredLink('tarifa_kitesurf_spots'), eyebrow: t(ui.spotsEyebrow), title: t(tarifaKitesurfSpotsContent.hero.headline), text: t(tarifaKitesurfSpotsContent.hero.subtitle) },
  { id: 'wind', href: requiredLink('tarifa_wind_kitesurfing_authority'), eyebrow: t(ui.windEyebrow), title: t(tarifaKitesurfWindContent.hero.title), text: t(tarifaKitesurfWindContent.hero.subtitle) },
  { id: 'school', href: requiredLink(tarifaKitesurfSpokeContent['kite-school'].token), eyebrow: t(ui.schoolEyebrow), title: t(ui.schoolTitle), text: t(ui.schoolText) },
  { id: 'partner', href: partnerHref, eyebrow: t(ui.partnerCardEyebrow), title: t(tarifaKitePartnerContent.navLabel), text: t(tarifaKitePartnerContent.hero.subtitle) }
];

const sectionLinks: Record<string, { token: LinkToken; label: LocalizedText } | undefined> = {
  winds: { token: 'tarifa_wind_kitesurfing_authority', label: ui.windsLink },
  areas: { token: 'tarifa_kitesurf_spots', label: ui.areasLink },
  checklist: { token: 'tarifa_kitesurf_forecast', label: ui.checklistLink }
};

const footerHighlights: LabeledLink[] = [
  { token: 'tarifa_kitesurfing_hub', label: t(ui.hubLabel) },
  ...spokeOrder.map((id) => ({ token: tarifaKitesurfSpokeContent[id].token, label: t(tarifaKitesurfSpokeContent[id].navLabel) }))
];
---

<LocationAuthorityLayout seo={content.seo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights} pageFamily="experience-tarifa-kite-hub">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken="tarifa_kitesurfing_hub">
    <ExperienceContextNav slot="context-navigation" currentId="kitesurfing" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="tarifa-kitesurf-hub" data-am-family="experience" data-am-role="hub" data-am-topic="kitesurfing">
    <LocationExperienceHero
      eyebrow={t(content.hero.eyebrow)}
      title={t(content.hero.title)}
      subtitle={t(content.hero.subtitle!)}
      paragraphs={[t(content.hero.lead)]}
      imageSrc={tarifaSurfClubTeamImage}
      imageAlt={t(ui.heroImageAlt)}
      imageWidth={1200}
      role="hub"
      topic="kitesurfing"
      byline={{ lang: currentLang, authorName: content.seo.article!.authorName, authorHref: aboutHref, updated: t(content.hero.updated), note: t(content.hero.editorialNote) }}
    />

    <LocationModule id="facts" labelledby="facts-title" surface="tint" spacing="compact" data-am-topic="facts">
      <div class="mx-auto max-w-screen-2xl">
        <p id="facts-title" class="am-text-eyebrow text-primary">{t(ui.factsEyebrow)}</p>
        <dl class="mt-6 grid gap-5 md:grid-cols-3">
          {content.facts.map((fact) => (
            <div class="border-l-2 border-primary/35 pl-5">
              <dt class="am-text-label am-text-label--sm text-on-surface-variant">{t(fact.label)}</dt>
              <dd class="am-text-subtitle mt-1 text-on-surface">{t(fact.value)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </LocationModule>

    <LocationModule id="kite-paths" labelledby="kite-paths-title" spacing="compact" data-am-topic="paths">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{t(ui.pathsEyebrow)}</p>
          <h2 id="kite-paths-title" class="am-text-title mt-5 text-balance text-on-surface">{t(ui.pathsTitle)}</h2>
          <p class="am-text-body mt-7 leading-relaxed text-on-surface-variant">
            {t(tarifaKitesurfSpotsHandoff.text)}{' '}
            <a class="am-link" href={requiredLink('tarifa_kitesurf_spots')}>{t(tarifaKitesurfSpotsHandoff.label)}</a>.
          </p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {cards.map((card) => (
            <AmaraActionLink href={card.href} variant="card" class="group bg-surface-container-low px-7 pb-8 pt-7 transition-colors hover:bg-surface-container-lowest">
              <span class="am-text-label am-text-label--sm text-primary">{card.eyebrow}</span>
              <h3 class="am-text-subtitle mt-4 text-on-surface transition-colors group-hover:text-primary">{card.title}</h3>
              <span class="am-text-body mt-4 block max-w-xl leading-relaxed text-on-surface-variant">{card.text}</span>
              <span class="am-cta-link mt-7 inline-flex">{t(ui.readMore)}</span>
            </AmaraActionLink>
          ))}
        </div>
      </div>
    </LocationModule>

    {content.sections.map((section, index) => {
      const link = sectionLinks[section.id];
      const tint = index % 2 === 0;
      return (
        <LocationModule id={section.id} labelledby={`${section.id}-title`} surface={tint ? 'tint' : 'white'} spacing="compact" data-am-topic={section.id}>
          <div class="mx-auto max-w-screen-2xl">
            <div class="max-w-3xl">
              <p class="am-text-eyebrow text-primary">{t(section.eyebrow)}</p>
              <h2 id={`${section.id}-title`} class="am-text-title mt-5 text-balance text-on-surface">{t(section.title)}</h2>
              <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{t(section.intro)}</p>
            </div>
            <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {section.cards.map((card) => (
                <section class:list={['min-w-0 px-6 py-7 md:px-8', tint ? 'bg-surface' : 'bg-surface-container-low']}>
                  <span class="am-text-label am-text-label--sm text-primary">{t(card.kicker)}</span>
                  <h3 class="am-text-subtitle mt-4 text-on-surface">{t(card.title)}</h3>
                  <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{t(card.text)}</p>
                </section>
              ))}
            </div>
            {link && <a href={requiredLink(link.token)} class="am-cta-link mt-8 inline-flex">{t(link.label)}</a>}
          </div>
        </LocationModule>
      );
    })}

    <LocationModule id="safety-notice" labelledby="safety-notice-title" surface="inverse" spacing="compact" data-am-topic="safety">
      <div class="mx-auto grid max-w-screen-2xl gap-8 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-inverted-on-surface/70">{t(content.notice.eyebrow)}</p>
          <h2 id="safety-notice-title" class="am-text-title mt-5 max-w-xl text-balance text-inverted-on-surface">{t(content.notice.title)}</h2>
        </div>
        <p class="am-text-body max-w-3xl leading-relaxed text-inverted-on-surface/85 lg:col-span-7">{t(content.notice.text)}</p>
      </div>
    </LocationModule>

    <LocationModule id="partnership" labelledby="partnership-title" spacing="compact" data-am-topic="partnership">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-12 lg:grid-cols-12 lg:gap-20">
        <figure class="lg:col-span-5">
          <AmaraImage src={markRobertTarifaImage} alt={t(partnership.imageAlt)} profile="hero" class="aspect-[4/3] w-full object-cover" widths={[480, 720, 960, 1200]} sizes="(max-width: 1023px) 100vw, 42vw" />
          <figcaption class="am-text-caption mt-4 normal-case tracking-normal text-muted">{t(partnership.imageCaption)}</figcaption>
        </figure>
        <div class="lg:col-span-7">
          <div class="flex items-center gap-5">
            <AmaraImage src="/images/tarifa/tarifa-surf-club-logo.webp" alt="Tarifa Surf Club" profile="card" class="h-16 w-16 object-contain md:h-20 md:w-20" width={192} widths={[96, 192]} sizes="80px" />
            <p class="am-text-eyebrow text-primary">{t(partnership.eyebrow)}</p>
          </div>
          <h2 id="partnership-title" class="am-text-title mt-6 max-w-3xl text-balance text-on-surface">{t(ui.personalTitle)}</h2>
          <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface">{t(partnership.personalNote)}</p>
          <p class="am-text-body mt-4 max-w-3xl leading-relaxed text-on-surface-variant">{t(partnership.contactText)}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={contactHref} target="_blank" rel="noopener noreferrer" class="am-btn am-btn--primary justify-center">{t(partnership.contactLabel)}</a>
            <a href="https://tarifasurfclub.com/" target="_blank" rel="noopener noreferrer" class="am-btn am-btn--secondary justify-center">{t(partnership.partnerLabel)}</a>
          </div>
          <a href={partnerHref} class="am-cta-link mt-6 inline-flex">{t(ui.partnerPageLink)}</a>
        </div>
      </div>
    </LocationModule>

    <LocationModule id="faq" labelledby="faq-title" surface="tint" spacing="compact" data-am-topic="faq">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <p class="am-text-eyebrow text-primary">{t(ui.faqEyebrow)}</p>
          <h2 id="faq-title" class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{t(ui.faqTitle)}</h2>
        </div>
        <div class="divide-y divide-border-subtle border-y border-border-subtle lg:col-span-8">
          {content.faq.map((item) => (
            <section class="py-6">
              <h3 class="am-text-subtitle text-on-surface">{t(item.question)}</h3>
              <p class="am-text-body mt-3 max-w-3xl leading-relaxed text-on-surface-variant">{t(item.answer)}</p>
            </section>
          ))}
        </div>
      </div>
    </LocationModule>

    <LocationModule id="sources" labelledby="sources-title" spacing="compact" data-am-topic="sources" data-am-editorial-sources="">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary">{t(ui.sourcesEyebrow)}</p>
          <h2 id="sources-title" class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{t(ui.sourcesTitle)}</h2>
          <p class="am-text-caption mt-6 normal-case tracking-normal text-muted">{t(content.hero.updated)}</p>
        </div>
        <div class="lg:col-span-7">
          <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{t(ui.sourcesText)}</p>
          <ul class="mt-8 space-y-4">
            {content.sources.map((source) => (
              <li class="border-l-2 border-primary/35 pl-5">
                <a class="am-link am-text-body" href={source.href} target="_blank" rel="noopener noreferrer">{t(source.label)}<span aria-hidden="true"> ↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </LocationModule>

    <AuthorityStayBridge
      eyebrow={t(partnership.eyebrow)}
      title={t(partnership.title)}
      reason={t(partnership.intro)}
      stayHref={propertyHref}
      stayLabel={t(ui.propertyLabel)}
      availabilityHref={requiredLink('book')}
      availabilityLabel={experienceStayBridge.availabilityLabel[currentLang]}
    />
  </article>
</LocationAuthorityLayout>
