---
import AmaraImage from '../../components/AmaraImage.astro';
import Hero from '../../components/Hero.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  experienceCatalog,
  experienceHubContent,
  experienceHubSeo,
  type ExperienceId
} from '../../content/experienceHubContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = experienceHubContent[currentLang];

const moodAnchorLinks = copy.moods.items.map((item) => ({
  label: item.label,
  href: `#experience-${item.id}`
}));
const moodDiscoveryLinks = copy.moods.discoveryLinks.flatMap((item) => {
  const href = resolveOptionalLink(item.token, currentLang, {
    suppressMissing: true
  });

  return href ? [{ label: item.label, href }] : [];
});
const moodLinks = [...moodAnchorLinks, ...moodDiscoveryLinks];

const getExperience = (id: ExperienceId) => {
  const definition = experienceCatalog[id];

  return {
    ...definition,
    editorial: copy.stories[id],
    href: resolveOptionalLink(definition.token, currentLang, {
      suppressMissing: true
    })
  };
};

const [leadId, ...secondaryIds] = copy.editorial.featuredIds;
const leadStory = getExperience(leadId);
const secondaryStories = secondaryIds.map(getExperience);
const allExperiences = copy.catalog.order.map(getExperience);

const footerHighlights: LabeledLink[] = [
  { token: 'frigiliana_experience_hub', label: copy.footerHighlights.hub },
  {
    token: experienceCatalog[leadId].token,
    label: copy.footerHighlights.first
  },
  {
    token: experienceCatalog[secondaryIds[0]].token,
    label: copy.footerHighlights.second
  }
];

const heroImage = {
  src: '/images/hero-frigiliana.jpg',
  width: 1080,
  height: 721
};
---

<LocationAuthorityLayout
  seo={experienceHubSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    currentToken="frigiliana_experience_hub"
    languageToken="frigiliana_experience_hub"
  />
  <ExperienceContextNav lang={currentLang} />

  <div data-am-page="frigiliana-experience-hub">
    <div class="w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {copy.hero.kicker}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {copy.hero.title}
        </h1>
        <div class="max-w-xl space-y-6 border-l border-primary/20 pl-10">
          {
            copy.hero.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant">
                {paragraph}
              </p>
            ))
          }
        </div>
        <p class="mt-12">
          <a href="#moods" class="am-btn am-btn--primary">
            {copy.hero.exploreCta}
          </a>
        </p>
      </Hero>

      <section
        id="editorial"
        class="am-section am-section--plain !px-6 md:!px-12"
      >
        <div class="grid grid-cols-1 gap-10 border-b border-outline-variant/20 pb-12 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="am-text-caption mb-5 text-primary">
              {copy.editorial.kicker}
            </p>
            <h2 class="am-text-title max-w-4xl italic tracking-tight text-on-surface">
              {copy.editorial.title}
            </h2>
          </div>
          <p class="am-text-body leading-relaxed text-on-surface-variant lg:col-span-4">
            {copy.editorial.intro}
          </p>
        </div>

        <div class="mt-16 grid grid-cols-1 gap-x-12 gap-y-16 lg:grid-cols-12">
          <article class="group lg:col-span-7">
            <div class="overflow-hidden bg-surface-container-low">
              <AmaraImage
                src={leadStory.image}
                alt={leadStory.editorial.imageAlt}
                profile="card"
                width={1200}
                widths={[480, 720, 960, 1200]}
                sizes="(max-width: 1023px) calc(100vw - 3rem), 58vw"
                class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.015]"
              />
            </div>
            <div class="mt-7 grid grid-cols-[auto_1fr] gap-5">
              <span class="font-label text-[11px] font-semibold tracking-[0.16em] text-primary">
                01
              </span>
              <div>
                <p class="am-text-caption mb-3 text-primary">
                  {leadStory.editorial.kicker}
                </p>
                <h3 class="am-text-title mb-5 italic tracking-tight text-on-surface">
                  {
                    leadStory.href ? (
                      <a href={leadStory.href} class="am-magazine-title-link">
                        {leadStory.editorial.title}
                      </a>
                    ) : (
                      leadStory.editorial.title
                    )
                  }
                </h3>
                <p class="am-text-body max-w-2xl leading-relaxed text-on-surface-variant">
                  {leadStory.editorial.text}
                </p>
                {
                  leadStory.href && (
                    <p class="mt-6">
                      <a href={leadStory.href} class="am-inline-link">
                        {leadStory.editorial.linkLabel}
                        <span aria-hidden="true"> &rarr;</span>
                      </a>
                    </p>
                  )
                }
              </div>
            </div>
          </article>

          <div class="grid grid-cols-1 gap-14 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
            {
              secondaryStories.map((story, index) => (
                <article class="group border-t border-outline-variant/25 pt-7">
                  <div class="grid grid-cols-1 gap-6 xl:grid-cols-5 xl:items-start">
                    <div class="overflow-hidden bg-surface-container-low xl:col-span-2">
                      <AmaraImage
                        src={story.image}
                        alt={story.editorial.imageAlt}
                        profile="card"
                        width={720}
                        widths={[320, 480, 720]}
                        sizes="(max-width: 639px) calc(100vw - 3rem), (max-width: 1023px) 45vw, 18vw"
                        class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02] xl:aspect-[3/4]"
                      />
                    </div>
                    <div class="xl:col-span-3">
                      <div class="mb-4 flex items-center justify-between gap-4">
                        <p class="am-text-caption text-primary">
                          {story.editorial.kicker}
                        </p>
                        <span class="font-label text-[10px] font-semibold tracking-[0.16em] text-on-surface/35">
                          0{index + 2}
                        </span>
                      </div>
                      <h3 class="am-text-subtitle mb-4 text-on-surface">
                        {
                          story.href ? (
                            <a href={story.href} class="am-magazine-title-link">
                              {story.editorial.title}
                            </a>
                          ) : (
                            story.editorial.title
                          )
                        }
                      </h3>
                      <p class="text-sm leading-relaxed text-on-surface-variant">
                        {story.editorial.text}
                      </p>
                      {
                        story.href && (
                          <p class="mt-5 text-sm">
                            <a href={story.href} class="am-inline-link">
                              {story.editorial.linkLabel}
                              <span aria-hidden="true"> &rarr;</span>
                            </a>
                          </p>
                        )
                      }
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="moods"
        class="am-section am-section--tint !px-6 md:!px-12"
      >
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-5">
            <h2 class="am-text-title mb-5 italic tracking-tight text-on-surface">
              {copy.moods.title}
            </h2>
            <p class="am-text-body leading-relaxed text-on-surface-variant">
              {copy.moods.intro}
            </p>
          </div>
          <nav class="lg:col-span-7" aria-label={copy.moods.title}>
            <ul class="grid grid-cols-1 border-t border-outline-variant/25 sm:grid-cols-2">
              {
                moodLinks.map((item) => (
                  <li class="border-b border-outline-variant/25 sm:odd:border-r">
                    <a
                      href={item.href}
                      class="group flex min-h-20 items-center justify-between gap-5 px-4 py-5 text-on-surface transition-colors hover:bg-surface-container-lowest"
                    >
                      <span class="font-headline text-xl italic">
                        {item.label}
                      </span>
                      <span
                        class="text-primary transition-transform group-hover:translate-x-1"
                        aria-hidden="true"
                      >
                        &rarr;
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </section>

      <section id="all" class="am-section am-section--plain !px-6 md:!px-12">
        <div class="mb-16 max-w-3xl">
          <p class="am-text-caption mb-5 text-primary">
            {copy.catalog.kicker}
          </p>
          <h2 class="am-text-title mb-6 italic tracking-tight text-on-surface">
            {copy.catalog.title}
          </h2>
          <p class="am-text-body leading-relaxed text-on-surface-variant">
            {copy.catalog.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-x-12 gap-y-14 md:grid-cols-2 xl:grid-cols-4">
          {
            allExperiences.map((experience, index) => (
              <article
                id={`experience-${experience.id}`}
                class="scroll-mt-36 border-t border-outline-variant/30 pt-6"
              >
                <span class="mb-7 block font-label text-[10px] font-semibold tracking-[0.16em] text-primary">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="am-text-caption mb-3 text-primary">
                  {experience.editorial.kicker}
                </p>
                <h3 class="am-text-subtitle mb-5 text-on-surface">
                  {
                    experience.href ? (
                      <a href={experience.href} class="am-magazine-title-link">
                        {experience.editorial.title}
                      </a>
                    ) : (
                      experience.editorial.title
                    )
                  }
                </h3>
                <p class="text-sm leading-relaxed text-on-surface-variant">
                  {experience.editorial.text}
                </p>
                {
                  experience.href && (
                    <p class="mt-6 text-sm">
                      <a href={experience.href} class="am-inline-link">
                        {experience.editorial.linkLabel}
                        <span aria-hidden="true"> &rarr;</span>
                      </a>
                    </p>
                  )
                }
              </article>
            ))
          }
        </div>
      </section>

      <section class="mx-auto max-w-screen-2xl px-6 pt-24 md:px-12">
        <EditorialClosingCta
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.staysCta,
              style: 'primary'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  .am-magazine-title-link {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 32%, transparent);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .am-magazine-title-link:hover,
  .am-magazine-title-link:focus-visible {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }

  .am-magazine-title-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-am-page='frigiliana-experience-hub'] img) {
      transition: none;
    }
  }
</style>
