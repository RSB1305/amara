---
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import type { AmaraLanguage } from '../../types/seo';

/**
 * The invariant frame of a location-authority article.
 *
 * It owns the parts that ten authority pages repeat without variation: the
 * article root and its page contract attribute, the editorial header with the
 * single H1 and byline, the fact strip, the external source list and the
 * closing block. Everything between the fact strip and the sources is authored
 * by the page itself, so page-specific blocks and their DOM position stay
 * visible where they belong.
 */

interface Fact {
  label: string;
  value: string;
}

interface SourceLink {
  label: string;
  text: string;
  href: string;
}

interface ClosingCta {
  href: string;
  label: string;
}

interface Props {
  /** Value of the article's `data-am-page` contract attribute. */
  pageId: string;
  lang: AmaraLanguage;
  hero: {
    eyebrow: string;
    title: string;
    standfirst: string;
    updated: string;
    note: string;
  };
  authorName: string;
  authorHref: string;
  facts: Fact[];
  sources: {
    eyebrow: string;
    title: string;
    intro: string;
    checked: string;
    links: SourceLink[];
  };
  closing: {
    eyebrow: string;
    title: string;
    body: string;
  };
  /** The filled button, always rendered ahead of the secondary link. */
  primaryCta: ClosingCta;
  secondaryCta: ClosingCta;
}

const {
  pageId,
  lang,
  hero,
  authorName,
  authorHref,
  facts,
  sources,
  closing,
  primaryCta,
  secondaryCta
} = Astro.props;
---

<article class="bg-surface" data-am-page={pageId}>
  <header class="overflow-hidden border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28 lg:py-36">
    <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="lg:col-span-8">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.2em] text-primary">
          {hero.eyebrow}
        </p>
        <h1 class="am-text-display mt-7 max-w-6xl text-balance text-on-surface">
          {hero.title}
        </h1>
      </div>
      <div class="border-l border-primary/30 pl-6 lg:col-span-4 lg:pl-9">
        <p class="am-text-subtitle text-balance leading-relaxed text-on-surface-variant">
          <InlineEmphasis text={hero.standfirst} />
        </p>
      </div>
      <div class="lg:col-span-8">
        <EditorialByline
          lang={lang}
          authorName={authorName}
          authorHref={authorHref}
          updated={hero.updated}
          note={hero.note}
        />
      </div>
      <slot name="hero-mark" />
    </div>
  </header>

  <section class="border-b border-border-subtle bg-surface-container-low px-6 py-16 md:px-12 md:py-20">
    <dl class="mx-auto grid max-w-screen-2xl gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((fact) => (
        <div class="border-t border-primary/30 pt-5">
          <dt class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary">{fact.label}</dt>
          <dd class="am-text-subtitle mt-3 text-on-surface">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <slot />

  <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
    <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{sources.eyebrow}</p>
        <h2 class="am-text-title mt-5 text-balance text-on-surface">{sources.title}</h2>
        <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={sources.intro} /></p>
        <p class="mt-6 font-label text-[10px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant/70">{sources.checked}</p>
      </div>
      <div class="border-t border-border-subtle lg:col-span-8">
        {sources.links.map((source) => (
          <a
            href={source.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-[1fr_auto] gap-8 border-b border-border-subtle py-7 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25"
          >
            <span>
              <span class="am-text-subtitle block text-on-surface transition-colors group-hover:text-primary">{source.label}</span>
              <span class="am-text-body mt-2 block leading-relaxed text-on-surface-variant"><InlineEmphasis text={source.text} /></span>
            </span>
            <span aria-hidden="true" class="am-text-subtitle text-primary">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-24 md:px-12 md:py-32">
    <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
      <div class="lg:col-span-7">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{closing.eyebrow}</p>
        <h2 class="am-text-display mt-6 text-balance text-on-surface">{closing.title}</h2>
      </div>
      <div class="lg:col-span-5">
        <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={closing.body} /></p>
        <div class="mt-8 flex flex-col items-start gap-5">
          <a href={primaryCta.href} class="am-btn am-btn--primary">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="am-cta-link">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>
</article>
