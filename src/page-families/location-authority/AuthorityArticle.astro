---
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import ArrivalJourneyGraphic, {
  type ArrivalJourneyGraphicData
} from '../../components/location/ArrivalJourneyGraphic.astro';
import ExperienceArticleHero from '../../components/experience/ExperienceArticleHero.astro';
import LocationGuideIcon, {
  type LocationGuideIconName
} from '../../components/location/LocationGuideIcon.astro';
import LocationGuideEvidence from '../../components/location/LocationGuideEvidence.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import LocationWeatherHero from '../../components/location/LocationWeatherHero.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import type { AmaraLanguage } from '../../types/seo';
import { getPageEndAttributes, type AmaraPageEndRole } from '../../components/page-end/pageEndContract';

/**
 * The invariant frame of a destination-authority article.
 *
 * It owns the shared family/topic contract, hero selection, fact strip,
 * external source list and closing block. Everything between the fact strip
 * and the sources remains authored by the page, so topic-specific modules and
 * their DOM position stay visible where they belong.
 */

interface Fact {
  label: string;
  value: string;
  description?: string;
}

interface SourceLink {
  label: string;
  text: string;
  href: string;
}

interface ClosingCta {
  href: string;
  label: string;
}

interface Props {
  /** Value of the article's `data-am-page` contract attribute. */
  pageId: string;
  family: 'location' | 'experience';
  topic: string;
  lang: AmaraLanguage;
  hero: {
    eyebrow: string;
    title: string;
    standfirst: string;
    updated?: string;
    note?: string;
  };
  authorName?: string;
  authorHref?: string;
  facts: Fact[];
  factsTitle?: string;
  /** Optional symbols for the fact strip; positional to preserve existing content models. */
  factIcons?: LocationGuideIconName[];
  sources: {
    eyebrow: string;
    title: string;
    intro: string;
    checked: string;
    links: SourceLink[];
  };
  closing: {
    eyebrow: string;
    title: string;
    body: string;
  };
  /** The primary action, always rendered ahead of the secondary link. */
  primaryCta: ClosingCta;
  secondaryCta: ClosingCta;
  /** Family-owned hero presentation for editorial, guide and weather topics. */
  presentation?: 'article' | 'guide' | 'weather';
  guideVisual?: {
    eyebrow: string;
    mark: string;
    note?: string;
  };
  guideSummary?: {
    eyebrow: string;
    body: string;
    items: Array<{ label: string; value: string }>;
  };
  arrivalVisual?: ArrivalJourneyGraphicData;
  weatherVisual?: {
    eyebrow: string;
    mark: string;
    note?: string;
  };
  heroMark?: string;
  closingRole?: Extract<AmaraPageEndRole, 'editorial-close' | 'next-action' | 'conversion'>;
  closingActionMode?: 'decision' | 'restrained';
}

const {
  pageId,
  family,
  topic,
  lang,
  hero,
  authorName,
  authorHref,
  facts,
  factsTitle,
  factIcons = [],
  sources,
  closing,
  primaryCta,
  secondaryCta,
  presentation = 'article',
  guideVisual,
  guideSummary,
  arrivalVisual,
  weatherVisual,
  heroMark,
  closingRole,
  closingActionMode = 'decision'
} = Astro.props;

const byline = authorName && authorHref && hero.updated && hero.note
  ? {
      lang,
      authorName,
      authorHref,
      updated: hero.updated,
      note: hero.note
    }
  : undefined;

if (presentation === 'guide' && !guideVisual && !guideSummary && !arrivalVisual) {
  throw new Error('[AMARA] Guide AuthorityArticle requires visual, summary or arrival content.');
}

if (presentation === 'weather' && !weatherVisual) {
  throw new Error('[AMARA] Weather AuthorityArticle requires weatherVisual content.');
}

if (presentation === 'article' && !byline) {
  throw new Error('[AMARA] Article AuthorityArticle requires complete author and review metadata.');
}
---

<article
  class="bg-surface"
  data-am-page={pageId}
  data-am-family={family}
  data-am-role="spoke"
  data-am-topic={topic}
  data-am-presentation={presentation}
>
  {
    presentation === 'weather' ? (
      <LocationWeatherHero
        eyebrow={hero.eyebrow}
        title={hero.title}
        paragraphs={[hero.standfirst]}
        evidenceEyebrow={weatherVisual!.eyebrow}
        evidenceMark={weatherVisual!.mark}
        evidenceNote={weatherVisual!.note}
        byline={byline}
      />
    ) : presentation === 'guide' ? (
      <LocationGuideHero
        eyebrow={hero.eyebrow}
        title={hero.title}
        paragraphs={guideSummary ? [] : [hero.standfirst]}
        topic={topic}
        visualBeforeMetaOnMobile={Boolean(guideSummary)}
        visualBreakpoint={arrivalVisual ? 'lg' : 'md'}
      >
        {byline && <EditorialByline slot="meta" {...byline} />}
        {arrivalVisual ? (
          <ArrivalJourneyGraphic slot="visual" data={arrivalVisual} />
        ) : guideSummary ? (
          <LocationGuideEvidence
            slot="visual"
            eyebrow={guideSummary.eyebrow}
            summary={guideSummary.body}
            items={guideSummary.items}
          />
        ) : (
          <LocationGuideEvidence
            slot="visual"
            eyebrow={guideVisual!.eyebrow}
            mark={guideVisual!.mark}
            note={guideVisual!.note}
          />
        )}
      </LocationGuideHero>
    ) : (
      <ExperienceArticleHero
        eyebrow={hero.eyebrow}
        title={hero.title}
        standfirst={hero.standfirst}
        lang={lang}
        authorName={byline!.authorName}
        authorHref={byline!.authorHref}
        updated={byline!.updated}
        note={byline!.note}
        mark={heroMark}
        topic={topic}
      />
    )
  }

  <section class="border-b border-border-subtle bg-surface-container-low px-6 py-16 md:px-12 md:py-20">
    <div class="mx-auto max-w-screen-2xl">
      {factsTitle && <h2 class="am-text-title mb-12 text-balance italic text-on-surface">{factsTitle}</h2>}
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((fact, index) => (
        <div
          class:list={[
            'min-w-0 border-t border-primary/30 pt-5',
            factIcons[index] && 'grid grid-cols-[1.5rem_minmax(0,1fr)] items-start gap-3'
          ]}
        >
          {factIcons[index] && <LocationGuideIcon name={factIcons[index]} class="mt-0.5 h-5 w-5" />}
          <div class="min-w-0">
            <dt class="min-w-0 text-primary [overflow-wrap:anywhere] am-text-label am-text-label--sm">{fact.label}</dt>
            <dd class="am-text-subtitle mt-3 min-w-0 hyphens-auto text-on-surface [overflow-wrap:anywhere]">{fact.value}</dd>
            {fact.description && <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{fact.description}</p>}
          </div>
        </div>
      ))}
    </dl>
    </div>
  </section>

  <slot />

  <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
    <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <p class="am-text-eyebrow text-primary">{sources.eyebrow}</p>
        <h2
          class:list={[
            'am-text-title mt-5 text-balance text-on-surface',
            presentation !== 'article' && 'italic'
          ]}
        >
          {sources.title}
        </h2>
        <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={sources.intro} /></p>
        <p class="mt-6 am-text-label am-text-label--sm text-muted">{sources.checked}</p>
      </div>
      <div class="border-t border-border-subtle lg:col-span-8">
        {sources.links.map((source) => (
          <a
            href={source.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-[1fr_auto] gap-8 border-b border-border-subtle py-7 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25"
          >
            <span>
              <span class="am-text-subtitle block text-on-surface transition-colors group-hover:text-primary">{source.label}</span>
              <span class="am-text-body mt-2 block leading-relaxed text-on-surface-variant"><InlineEmphasis text={source.text} /></span>
            </span>
            <span aria-hidden="true" class="am-text-subtitle text-primary">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-24 md:px-12 md:py-32" {...(closingRole ? getPageEndAttributes(closingRole, family) : {})}>
    <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
      <div class="lg:col-span-7">
        <p class="am-text-eyebrow text-primary">{closing.eyebrow}</p>
        <h2
          class:list={[
            'am-text-display mt-6 text-balance text-on-surface',
            presentation !== 'article' && 'italic'
          ]}
        >
          {closing.title}
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={closing.body} /></p>
        <div class="mt-8 flex flex-col items-start gap-5">
          <a href={primaryCta.href} class={closingActionMode === 'restrained' ? 'am-cta-link' : 'am-btn am-btn--primary'}>{primaryCta.label}</a>
          <a href={secondaryCta.href} class="am-cta-link">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>
</article>
