---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import LocationGuideEvidence from '../../components/location/LocationGuideEvidence.astro';
import Navigation from '../../components/Navigation.astro';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  nerjaNightlifeContent,
  nerjaNightlifeSeo
} from '../../content/nerjaNightlifeContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import { routeHero } from '../../lib/images/routeImages';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = routeHero('nerja.experience.nightlife', currentLang);
const copy = nerjaNightlifeContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja nightlife');

const footerHighlights: LabeledLink[] = [
  {
    token: 'nerja_nightlife_authority',
    label: copy.footerHighlights.nightlife
  },
  {
    token: 'location_nerja',
    label: copy.footerHighlights.nerja
  },
  {
    token: 'playa',
    label: copy.footerHighlights.apartments
  }
];

---

<LocationAuthorityLayout
  seo={nerjaNightlifeSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-nerja-nightlife"
>
  <Navigation
    slot="navigation"
    contextDestination="nerja"
    currentLang={currentLang}
    languageToken="nerja_nightlife_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="nightlife" destination="nerja" lang={currentLang} />
  </Navigation>

  <div data-am-page="nerja-nightlife">
    <div class="w-full">
      <LocationExperienceHero
        {...hero}
        topic="nightlife"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        paragraphs={copy.hero.paragraphs}
      >
        {copy.hero.summary && (
          <LocationGuideEvidence
            slot="visual"
            eyebrow={copy.hero.summary.eyebrow}
            summary={copy.hero.summary.body}
            items={copy.hero.summary.items}
          />
        )}
      </LocationExperienceHero>

      <section
        id="areas"
        class="am-section am-section--plain"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.areas.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.areas.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-10 gap-y-14">
          {
            copy.areas.items.map((area, index) => {
              const titleId = `nightlife-area-${index + 1}`;

              return (
                <article
                  class="border-t border-outline-variant/25 pt-8 flex h-full flex-col"
                  aria-labelledby={titleId}
                >
                  <h3
                    id={titleId}
                    class="am-text-subtitle text-on-surface mb-6"
                  >
                    {area.title}
                  </h3>
                  <div class="space-y-5">
                    {area.paragraphs.map((paragraph) => (
                      <p class="am-text-body text-on-surface-variant leading-relaxed">
                        {paragraph}
                      </p>
                    ))}
                  </div>
                  <p class="mt-8 border-l border-primary/20 bg-surface-container-low px-4 py-3 am-text-body leading-relaxed text-on-surface-variant">
                    <span class="font-bold text-primary">
                      {copy.cardLabels.bestFor}:
                    </span>{' '}
                    {area.bestFor}
                  </p>
                  <p class="mt-7 lg:mt-auto lg:pt-7 am-text-body">
                    <a
                      href={area.mapHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="am-inline-link"
                    >
                      {copy.cardLabels.map}
                      <span aria-hidden="true"> &rarr;</span>
                    </a>
                  </p>
                </article>
              );
            })
          }
        </div>
      </section>

      <section
        id="culture"
        class="am-section am-section--plain"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.culture.title}
          </h2>
          <div class="space-y-5">
            {
              copy.culture.paragraphs.map((paragraph) => (
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {paragraph}
                </p>
              ))
            }
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14">
          {
            copy.culture.items.map((item) => (
              <article class="border-t border-outline-variant/25 pt-8 flex h-full flex-col">
                <h3 class="am-text-subtitle text-on-surface mb-5">
                  {item.title}
                </h3>
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {item.text}
                </p>
                <p class="mt-6 lg:mt-auto lg:pt-6 am-text-body">
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="am-inline-link"
                  >
                    {item.linkLabel}
                    <span aria-hidden="true"> &rarr;</span>
                  </a>
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <GuestGuideBridge lang={currentLang} destination="nerja" guideSlugs={['nerja-guest-recommendations']} />

      <AuthorityStayBridge
          eyebrow={experienceStayBridge.eyebrow[currentLang]}
          title={copy.closing.title}
          reason={copy.closing.stayReason}
          stayHref={requiredLink('playa')}
          stayLabel={copy.closing.apartmentsCta}
          availabilityHref={requiredLink('book')}
          availabilityLabel={copy.closing.availabilityCta}
      />
    </div>
  </div>
</LocationAuthorityLayout>
