---
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import KiteClusterNav from '../../components/experience/KiteClusterNav.astro';
import KitePartnerLogoBand from '../../components/experience/KitePartnerLogoBand.astro';
import WindguruWidget from '../../components/experience/WindguruWidget.astro';
import AemetForecastPanel from '../../components/location/AemetForecastPanel.astro';
import AemetWarningsPanel from '../../components/location/AemetWarningsPanel.astro';
import KiteBriefingPanel from '../../components/location/KiteBriefingPanel.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import Navigation from '../../components/Navigation.astro';
import { tarifaKiteBriefingCopy } from '../../content/tarifaKiteBriefingContent';
import { tarifaKitesurfWindContent, tarifaKitesurfWindSeo } from '../../content/tarifaKitesurfWindContent';
import { tarifaWeatherWarningsCopy } from '../../content/tarifaWeatherWarningsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import { resolveLocale } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';
import LocationModule from './LocationModule.astro';
import LocationGuideIcon from '../../components/location/LocationGuideIcon.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import KiteThermalWindDiagram from '../../components/experience/KiteThermalWindDiagram.astro';
import { requireRouteImage } from '../../lib/images/routeImages';

/**
 * Wind, forecast, weather and safety page of the Tarifa kitesurf cluster.
 *
 * Reading order (operator direction, Sept 2026): the morning check first — a
 * compact "Heute" block with the official AEMET warning banner and the two
 * Windguru tables, with the official forecast and the hourly kite briefing kept
 * in a disclosure so the top stays lean. Then the evergreen story: Levante and
 * Poniente, how to read Windguru, and the thermal-wind diagram. Then one Safety
 * block — priority, zones, tides, private rescue and the maritime emergency
 * numbers. The four information classes stay visually separate so none can read
 * as a riding approval: modelled values, private rescue offers, official rules
 * and the personal experience of two named voices. Sections sit on
 * `LocationModule`, which owns the gutter and surface geometry inside the flush
 * authority shell.
 */
interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = requireRouteImage('tarifa.kitesurfing.wind', 'hero', currentLang);
const sunsetImage = requireRouteImage('tarifa.kitesurfing.wind', 'sunset', currentLang);
const partnerImage = requireRouteImage('tarifa.kitesurfing.wind', 'partner', currentLang);
const markImage = requireRouteImage('tarifa.kitesurfing.surf-club', 'mark', currentLang);
const content = resolveLocale(tarifaKitesurfWindContent, currentLang);
const briefingCopy = resolveLocale(tarifaKiteBriefingCopy, currentLang);
const warningsCopy = resolveLocale(tarifaWeatherWarningsCopy, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf wind spoke');
const aboutHref = requiredLink('about');
const contactHref = `https://wa.me/34604440964?text=${encodeURIComponent(content.partner.contactMessage)}`;
const robertPortrait = '/images/robert-amara-host.jpg';
const footerHighlights: LabeledLink[] = [
  { token: content.token, label: content.hero.title },
  ...content.related.links.map((link) => ({ token: link.token, label: link.title }))
];

---

<LocationAuthorityLayout seo={tarifaKitesurfWindSeo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights} pageFamily="experience-tarifa-kite-spoke">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken={content.token}>
    <ExperienceContextNav slot="context-navigation" currentId="kitesurfing" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="am-tarifa-surface overflow-x-clip bg-surface" data-am-page="tarifa-wind-kitesurfing" data-am-family="experience" data-am-role="spoke" data-am-topic="kitesurf-wind-forecast">
    <KiteClusterNav lang={currentLang} currentId="wind" />

    <LocationGuideHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      subtitle={content.hero.subtitle}
      paragraphs={[content.hero.lead]}
      family="experience"
      role="spoke"
      topic="kitesurf-wind-forecast"
      visualBreakpoint="lg"
    >
      <EditorialByline slot="meta" lang={currentLang} authorName="Robert Sebastian Böhmer" authorHref={aboutHref} updated={content.hero.updated} note={content.hero.note} />
      <AmaraImage
        slot="visual"
        src={hero.src}
        alt={hero.alt}
        profile="hero"
        width={1080}
        widths={[480, 640, 800, 1080]}
        sizes="(max-width: 1023px) 100vw, 36vw"
        class="aspect-[3/4] w-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </LocationGuideHero>

    {/* HEUTE — kompakt: amtlicher Warnstatus + Windguru-Tabellen; amtliche Vorhersage & Stundenbriefing aufklappbar */}
    <LocationModule id="heute" labelledby="heute-title" surface="tint" spacing="compact" data-am-topic="live-today">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2.5">
            <LocationGuideIcon name="temperature" class="h-4 w-4" />
            <p class="am-text-eyebrow text-primary">{content.live.briefingEyebrow}</p>
          </div>
          <h2 id="heute-title" class="am-text-title mt-5 text-balance text-on-surface">{content.live.forecastHeading}</h2>
        </div>

        <AemetWarningsPanel
          endpoint="/api/weather/tarifa-warnings"
          lang={currentLang}
          timezone="Europe/Madrid"
          copy={warningsCopy}
          officialHref="https://www.aemet.es/es/eltiempo/prediccion/avisos?w=hoy&l=611104"
        />

        <div class="mt-10 space-y-8">
          <figure class="m-0" data-am-windguru-model="gfs">
            <figcaption class="am-text-label am-text-label--sm mb-3 text-primary">{content.windguru.gfsLabel}</figcaption>
            <WindguruWidget lang={currentLang} model={3} rows="WINDSPD,GUST,SMER,TMP,RATING" reservedHeightClass="min-h-[16rem]" loadingLabel={content.windguru.loading} noscriptLabel={content.windguru.noscript} />
          </figure>
          <figure class="m-0" data-am-windguru-model="wrf3">
            <figcaption class="am-text-label am-text-label--sm mb-3 text-primary">{content.windguru.wrfLabel}</figcaption>
            <WindguruWidget lang={currentLang} model={37} loadingLabel={content.windguru.loading} noscriptLabel={content.windguru.noscript} />
          </figure>
          <p class="am-text-caption max-w-3xl normal-case tracking-normal text-muted">{content.windguru.lazyNote}</p>
          <AmaraActionLink href={content.windguru.linkHref} variant="editorial" external class="inline-flex">{content.windguru.linkLabel}</AmaraActionLink>
        </div>

        <details class="group mt-12 border-t border-border-subtle pt-6 outline-none" data-am-official-detail>
          <summary class="am-accordion__trigger items-center">
            <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.live.title}</h3>
            <span class="am-accordion__indicator" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant">{content.safety.aemetText}</p>
          <div class="mt-6 bg-surface px-6 pb-8 md:px-8" data-am-official-weather>
            <AemetForecastPanel
              endpoint="/api/weather/tarifa"
              lang={currentLang}
              labels={{
                loading: content.live.loading,
                today: content.live.today,
                tomorrow: content.live.tomorrow,
                high: content.live.high,
                low: content.live.low,
                rain: content.live.rain,
                issued: content.live.issued,
                unavailable: content.live.unavailableTitle,
                unavailableText: content.live.unavailableText,
                source: content.live.aemetLabel
              }}
              sourceHref={content.safety.aemetHref}
              fallbackLabel={content.live.aemetLabel}
            />
          </div>
          <AmaraActionLink href={content.safety.aemetHref} variant="editorial" external class="mt-5 inline-flex">{content.safety.aemetLabel}</AmaraActionLink>

          <div class="mt-10 border-t border-border-subtle pt-8">
            <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{content.live.pending}</p>
            <KiteBriefingPanel
              endpoint="/api/weather/tarifa-kite"
              warningsEndpoint="/api/weather/tarifa-warnings"
              lang={currentLang}
              timezone="Europe/Madrid"
              copy={briefingCopy}
              warningLevels={warningsCopy.levels}
              aemetHref={content.safety.aemetHref}
              aemetLabel={content.safety.aemetLabel}
            />
          </div>
        </details>
      </div>
    </LocationModule>

    {/* LEVANTE & PONIENTE — die beiden Winde erklärt */}
    <LocationModule id="poniente-levante" labelledby="poniente-levante-title" spacing="compact" data-am-topic="local-wind">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <div class="flex items-center gap-2.5">
              <LocationGuideIcon name="wind" class="h-4 w-4" />
              <p class="am-text-eyebrow text-primary">{content.localWind.eyebrow}</p>
            </div>
            <h2 id="poniente-levante-title" class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.localWind.title}</h2>
          </div>
          <div class="space-y-5 lg:col-span-7">
            {content.localWind.paragraphs.map((paragraph) => <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>)}
          </div>
        </div>

        <figure class="mt-12 grid gap-8 bg-surface-container-low px-6 py-8 md:grid-cols-12 md:gap-10 md:px-10 md:py-10" data-am-voice="robert">
          <div class="md:col-span-3 lg:col-span-2">
            <AmaraImage src={robertPortrait} alt={content.localWind.quote.imageAlt} profile="card" width={480} widths={[240, 360, 480]} sizes="(max-width: 767px) 10rem, 14rem" class="aspect-[4/5] w-40 object-cover md:w-full" focalPoint="50% 20%" />
          </div>
          <div class="md:col-span-9 lg:col-span-10">
            <blockquote class="m-0 space-y-5">
              {content.localWind.quote.paragraphs.map((paragraph) => <p class="am-text-body max-w-3xl leading-relaxed text-on-surface">{paragraph}</p>)}
            </blockquote>
            <figcaption class="am-text-label am-text-label--sm mt-5 text-primary">— {content.localWind.quote.name} · {content.localWind.quote.role}</figcaption>
          </div>
        </figure>

        <p class="am-text-body mt-10 max-w-3xl leading-relaxed text-on-surface-variant">
          {content.localWind.spotLink.before}{' '}
          <a class="am-link" href={requiredLink(content.localWind.spotLink.token)}>{content.localWind.spotLink.label}</a>{' '}
          {content.localWind.spotLink.after}
        </p>
      </div>
    </LocationModule>

    {/* WINDGURU FÜR ANFÄNGER — die Tabelle von oben lesen (Erklärung, aufklappbar) */}
    <LocationModule id="windguru" labelledby="windguru-title" surface="tint" spacing="compact" data-am-topic="windguru">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2.5">
            <LocationGuideIcon name="comparison" class="h-4 w-4" />
            <p class="am-text-eyebrow text-primary">{content.windguru.eyebrow}</p>
          </div>
          <h2 id="windguru-title" class="am-text-title mt-5 text-balance text-on-surface">{content.windguru.title}</h2>
        </div>

        <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant">{content.windguru.intro}</p>

        <details class="group mt-12 border-t border-border-subtle pt-6 outline-none" data-am-windguru-rows open>
          <summary class="am-accordion__trigger items-center">
            <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.windguru.rowsTitle}</h3>
            <span class="am-accordion__indicator" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <dl class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {content.windguru.rows.map((row) => (
              <div class="min-w-0 border-l-2 border-primary/35 bg-surface px-6 py-6" data-windguru-row={row.id}>
                <dt class="am-text-label am-text-label--sm text-on-surface">{row.title}</dt>
                <dd class="am-text-body mt-3 leading-relaxed text-on-surface-variant"><InlineEmphasis text={row.text} /></dd>
              </div>
            ))}
          </dl>
        </details>

        <details class="group mt-12 border-t border-border-subtle pt-6 outline-none" data-am-windguru-models>
          <summary class="am-accordion__trigger items-center">
            <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.windguru.modelsTitle}</h3>
            <span class="am-accordion__indicator" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <div class="mt-8 space-y-6">
            <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{content.windguru.modelsIntro}</p>
            <dl class="space-y-4">
              {content.windguru.models.map((model) => (
                <div class="border-l-2 border-primary/35 pl-5" data-windguru-model={model.id}>
                  <dt class="am-text-label text-on-surface">{model.name}</dt>
                  <dd class="am-text-body mt-1 leading-relaxed text-on-surface-variant">{model.text}</dd>
                </div>
              ))}
            </dl>
            <p class="am-text-body max-w-3xl leading-relaxed text-on-surface">{content.windguru.modelsWhy}</p>
          </div>
        </details>

        <details class="group mt-12 border-t border-border-subtle pt-6 outline-none" data-am-beaufort>
          <summary class="am-accordion__trigger items-center">
            <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.beaufort.title}</h3>
            <span class="am-accordion__indicator" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <p class="am-text-body mt-5 max-w-3xl leading-relaxed text-on-surface-variant">{content.beaufort.intro}</p>
          <div class="mt-6 overflow-x-auto bg-surface" role="region" aria-label={content.beaufort.title} tabindex="0">
            <table class="w-full min-w-[40rem] border-collapse text-left">
              <caption class="sr-only">{content.beaufort.title}</caption>
              <thead>
                <tr class="border-b border-border-subtle">
                  <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.beaufort.columnKnots}</th>
                  <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.beaufort.columnForce}</th>
                  <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.beaufort.columnName}</th>
                  <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.beaufort.columnSea}</th>
                </tr>
              </thead>
              <tbody>
                {content.beaufort.rows.map((row) => (
                  <tr class="border-b border-border-subtle last:border-b-0" data-beaufort={row.id}>
                    <th scope="row" class="whitespace-nowrap px-4 py-3 am-text-body tabular-nums text-on-surface">{row.knots} kn</th>
                    <td class="whitespace-nowrap px-4 py-3 am-text-body tabular-nums text-on-surface-variant">{row.force}</td>
                    <td class="whitespace-nowrap px-4 py-3 am-text-body text-on-surface-variant">{row.name}</td>
                    <td class="px-4 py-3 am-text-body text-on-surface-variant">{row.sea}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="am-text-caption mt-4 max-w-3xl normal-case tracking-normal text-muted">{content.beaufort.note}</p>
        </details>
      </div>
    </LocationModule>

    {/* THERMIK — kompaktes helles Diagramm */}
    <LocationModule id="thermik" spacing="compact" data-am-topic="thermal-wind">
      <div class="mx-auto max-w-screen-2xl">
        <KiteThermalWindDiagram lang={currentLang} />
      </div>
    </LocationModule>

    <section class="relative isolate overflow-hidden bg-inverse-surface" data-am-topic="editorial-photo">
      <div class="aspect-[4/5] w-full sm:aspect-video lg:aspect-[21/9]">
        <AmaraImage src={sunsetImage.src} alt={sunsetImage.alt} profile="background" class="h-full w-full object-cover" focalPoint={sunsetImage.focalPoint} />
      </div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto w-full max-w-screen-2xl px-6 pb-8 md:px-12 md:pb-12">
          <p class="am-text-subtitle max-w-2xl text-balance text-inverted-on-surface">{sunsetImage.caption}</p>
          <p class="am-text-caption mt-3 normal-case tracking-normal text-inverted-on-surface/65">{sunsetImage.credit}</p>
        </div>
      </div>
    </section>

    {/* SICHERHEIT — ein Block: Vorrang, Zonen, Tide, Rettung, Seenotruf */}
    <LocationModule id="safety" labelledby="safety-title" surface="tint" spacing="compact" data-am-topic="official-rules">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{content.safety.eyebrow}</p>
          <h2 id="safety-title" class="am-text-title mt-5 text-balance text-on-surface">{content.safety.title}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{content.safety.intro}</p>
        </div>
        <p class="am-text-subtitle mt-8 max-w-3xl border-l-2 border-primary/35 bg-surface px-6 py-5 leading-relaxed text-on-surface" data-am-priority-rule>{content.safety.priority}</p>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {content.safety.checks.map((check) => (
            <section class="min-w-0 bg-surface px-6 py-7" aria-labelledby={`safety-${check.id}`}>
              <h3 id={`safety-${check.id}`} class="am-text-subtitle text-on-surface">{check.title}</h3>
              <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{check.text}</p>
            </section>
          ))}
        </div>

        <p class="am-text-subtitle mt-5 max-w-4xl border-l-2 border-on-surface bg-surface px-6 py-5 leading-relaxed text-on-surface" data-am-lagoon-rule>{content.safety.lagoon}</p>

        <div class="mt-14 grid gap-6 lg:grid-cols-12 lg:gap-20" data-am-tides>
          <div class="lg:col-span-5">
            <h3 class="am-text-subtitle max-w-md text-balance text-on-surface">{content.safety.tides.title}</h3>
          </div>
          <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant lg:col-span-7">{content.safety.tides.text}</p>
        </div>

        <section class="mt-14 bg-surface px-6 py-8 md:px-10 md:py-10" aria-labelledby="private-rescue-title" data-am-rescue="private">
          <p class="am-text-eyebrow text-primary">{content.safety.rescueEyebrow}</p>
          <h3 id="private-rescue-title" class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{content.safety.rescueHeading}</h3>
          <p class="am-text-subtitle mt-5 max-w-3xl text-balance text-on-surface">{content.safety.rescueTitle}</p>
          <p class="am-text-body mt-4 max-w-3xl leading-relaxed text-on-surface-variant">{content.safety.rescueIntro}</p>
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            {content.safety.providers.map((provider) => (
              <section class="min-w-0 bg-surface-container-low px-6 py-7" aria-labelledby={`rescue-${provider.id}`}>
                <h4 id={`rescue-${provider.id}`} class="am-text-label text-on-surface">{provider.name}</h4>
                <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{provider.text}</p>
                <AmaraActionLink href={provider.href} variant="editorial" external class="mt-6 inline-flex">{provider.label}</AmaraActionLink>
              </section>
            ))}
          </div>

          <figure class="mt-10 grid gap-8 md:grid-cols-12 md:gap-10" data-am-voice="mark-rescue">
            <div class="md:col-span-3 lg:col-span-2">
              <AmaraImage src={markImage.src} alt={markImage.alt} profile="card" width={480} widths={[240, 360, 480]} sizes="(max-width: 767px) 10rem, 14rem" class="aspect-[4/5] w-40 object-cover md:w-full" focalPoint="50% 25%" />
            </div>
            <div class="md:col-span-9 lg:col-span-10">
              <p class="am-text-label am-text-label--sm text-primary">{content.safety.rescueQuote.lead}</p>
              <blockquote class="m-0 mt-3 space-y-4">
                {content.safety.rescueQuote.paragraphs.map((paragraph) => <p class="am-text-body max-w-3xl leading-relaxed text-on-surface">{paragraph}</p>)}
              </blockquote>
              <figcaption class="am-text-label am-text-label--sm mt-4 text-primary">— {content.safety.rescueQuote.name} · {content.safety.rescueQuote.role}</figcaption>
            </div>
          </figure>

          <p class="am-text-body mt-8 max-w-3xl leading-relaxed text-on-surface-variant">{content.safety.rescueContext}</p>
          <p class="am-text-subtitle mt-5 max-w-3xl leading-relaxed text-on-surface">{content.safety.rescuePlanB}</p>
        </section>

        <aside class="mt-6 bg-inverse-surface px-6 py-10 text-inverted-on-surface md:px-10 md:py-12" aria-labelledby="maritime-emergency-title" data-am-rescue="emergency">
          <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
            <div class="lg:col-span-5">
              <p class="am-text-eyebrow text-primary-fixed-dim">{content.safety.rescueEyebrow}</p>
              <h3 id="maritime-emergency-title" class="am-text-title mt-5 text-balance text-inverted-on-surface">{content.safety.emergencyTitle}</h3>
              <p class="am-text-body mt-6 leading-relaxed text-inverted-on-surface/80">{content.safety.emergencyText}</p>
            </div>
            <dl class="grid gap-6 self-center lg:col-span-7">
              {content.safety.emergencyNumbers.map((item) => (
                <div class="flex flex-col gap-1 border-l border-inverted-on-surface/30 pl-5 sm:flex-row sm:items-baseline sm:gap-8">
                  <dt class="am-text-label am-text-label--sm text-inverted-on-surface/70 sm:w-56 sm:shrink-0">{item.label}</dt>
                  <dd class="am-text-title whitespace-nowrap tabular-nums text-inverted-on-surface">{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </aside>
      </div>
    </LocationModule>

    {/* PARTNER — Tarifa Surf Club */}
    <LocationModule id="tarifa-surf-club" labelledby="tarifa-surf-club-title" spacing="compact" data-am-topic="partner">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6">
            <div class="flex items-center gap-2.5">
              <LocationGuideIcon name="private-transfer" class="h-4 w-4" />
              <p class="am-text-eyebrow text-primary">{content.partner.eyebrow}</p>
            </div>
            <h2 id="tarifa-surf-club-title" class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.partner.title}</h2>
            <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant">{content.partner.intro}</p>
            <div class="mt-8 space-y-6">
              {content.partner.benefits.map((benefit) => (
                <section class="border-l-2 border-primary/35 pl-5" aria-labelledby={`partner-${benefit.id}`}>
                  <h3 id={`partner-${benefit.id}`} class="am-text-subtitle text-on-surface">{benefit.title}</h3>
                  <p class="am-text-body mt-2 leading-relaxed text-on-surface-variant">{benefit.text}</p>
                </section>
              ))}
            </div>
            <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href={contactHref} target="_blank" rel="noopener noreferrer" class="am-btn am-btn--primary justify-center">{content.partner.contactLabel}</a>
              <a href={content.partner.partnerHref} target="_blank" rel="noopener noreferrer" class="am-btn am-btn--secondary justify-center">{content.partner.partnerLabel}</a>
            </div>
          </div>
          <figure class="lg:col-span-6">
            <AmaraImage src={partnerImage.src} alt={partnerImage.alt} profile="hero" width={1200} widths={[480, 720, 960, 1200]} sizes="(max-width: 1023px) 100vw, 48vw" class="aspect-video w-full object-cover" />
            <figcaption class="am-text-caption mt-4 normal-case tracking-normal text-muted">{partnerImage.caption}</figcaption>
          </figure>
        </div>

        <figure class="mt-16 grid gap-8 md:grid-cols-12 md:gap-10 lg:gap-16" data-am-voice="mark">
          <div class="md:col-span-3 lg:col-span-2">
            <AmaraImage src={markImage.src} alt={markImage.alt} profile="card" width={480} widths={[240, 360, 480]} sizes="(max-width: 767px) 10rem, 14rem" class="aspect-[4/5] w-40 object-cover md:w-full" focalPoint="50% 25%" />
          </div>
          <div class="md:col-span-9 lg:col-span-10">
            <h3 class="am-text-subtitle text-balance text-on-surface">{content.partner.voice.title}</h3>
            <div class="mt-6">
              {content.partner.voice.quotes.map((quote) => (
                <div class="mt-8 first:mt-0" data-am-voice-quote={quote.id}>
                  <p class="am-text-label am-text-label--sm text-primary">{quote.lead}</p>
                  <blockquote class="m-0 mt-3 space-y-4">
                    {quote.paragraphs.map((paragraph) => <p class="am-text-body max-w-3xl leading-relaxed text-on-surface">{paragraph}</p>)}
                  </blockquote>
                </div>
              ))}
            </div>
            <figcaption class="am-text-label am-text-label--sm mt-6 text-primary">— {content.partner.voice.name} · {content.partner.voice.role}</figcaption>
          </div>
        </figure>
      </div>
    </LocationModule>

    <GuestGuideBridge lang={currentLang} destination="tarifa" guideSlugs={['tarifa-guest-kitesurfing']} />

    {/* ABSCHLUSS — weiterführende Guides + Basecamp in einem Ende */}
    <LocationModule id="related-kite-guides" labelledby="related-kite-guides-title" surface="tint" spacing="closing" data-am-topic="closing">
      <div class="mx-auto max-w-screen-2xl">
        <div class="flex items-center gap-2.5">
          <LocationGuideIcon name="excursion" class="h-4 w-4" />
          <p class="am-text-eyebrow text-primary">{content.related.eyebrow}</p>
        </div>
        <h2 id="related-kite-guides-title" class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{content.related.title}</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {content.related.links.map((link) => (
            <AmaraActionLink href={requiredLink(link.token)} variant="card" class="group bg-surface px-7 pb-8 pt-7 transition-colors hover:bg-surface-container-lowest">
              <h3 class="am-text-subtitle text-on-surface transition-colors group-hover:text-primary">{link.title}</h3>
              <span class="am-text-body mt-4 block leading-relaxed text-on-surface-variant">{link.text}</span>
              <span aria-hidden="true" class="mt-7 inline-flex text-primary transition-transform group-hover:translate-x-1">→</span>
            </AmaraActionLink>
          ))}
        </div>

        <div id="tarifa-basecamp" class="mt-20 border-t border-border-subtle pt-16 text-center" data-am-topic="basecamp">
          <div class="flex items-center justify-center gap-2.5">
            <LocationGuideIcon name="village" class="h-4 w-4" />
            <p class="am-text-eyebrow text-primary">{content.closing.eyebrow}</p>
          </div>
          <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.closing.title}</h2>
          <p class="am-text-body mx-auto mt-7 max-w-3xl leading-relaxed text-on-surface-variant">{content.closing.text}</p>
          <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href={requiredLink('tarifa')} class="am-btn am-btn--secondary w-full justify-center sm:w-auto">{content.closing.stayLabel}</a>
            <a href={requiredLink('book')} class="am-btn am-btn--primary w-full justify-center sm:w-auto">{content.closing.availabilityLabel}</a>
          </div>
          <p class="am-text-body mx-auto mt-14 max-w-3xl leading-relaxed text-muted" data-am-final-line>{content.closing.finalLine}</p>
        </div>
      </div>
    </LocationModule>

    <KitePartnerLogoBand lang={currentLang} />
  </article>
</LocationAuthorityLayout>
