<style>
  /*
   * The anchor row sticks under the fixed site header. The script below
   * measures the header and sets the offset, on load, resize and scroll, because
   * the header changes height while scrolling; the row sits flush under it at
   * every viewport, and the chapters take header plus row as their scroll margin.
   * On phones the row scrolls sideways without a scrollbar.
   */
  .am-wind-toc {
    top: var(--am-wind-toc-top, 6.5rem);
  }
  [data-am-wind-chapter] {
    scroll-margin-top: var(--am-wind-chapter-offset, 10rem);
  }
  [data-am-wind-toc-scroller] {
    scrollbar-width: none;
  }
  [data-am-wind-toc-scroller]::-webkit-scrollbar {
    display: none;
  }
  [data-am-wind-toc-link].is-active {
    border-bottom-color: var(--color-on-surface);
  }
</style>

<script>
  /**
   * Anchor row: underline the chapter currently in view. Progressive
   * enhancement only — the links work without it.
   */
  const toc = document.querySelector<HTMLElement>('[data-am-wind-toc]');
  const header = Array.from(document.querySelectorAll<HTMLElement>('header')).find((el) => getComputedStyle(el).position === 'fixed');
  const placeToc = () => {
    if (!toc || !header) return;
    // The mobile context row hangs below the header box as a positioned child;
    // the open mobile menu is a tall child and is ignored.
    const headerBottom = Math.round(
      Math.max(
        header.getBoundingClientRect().bottom,
        ...Array.from(header.children)
          .map((child) => child.getBoundingClientRect())
          .filter((rect) => rect.height > 0 && rect.height < 160)
          .map((rect) => rect.bottom)
      )
    );
    document.documentElement.style.setProperty('--am-wind-toc-top', headerBottom + 'px');
    document.documentElement.style.setProperty('--am-wind-chapter-offset', headerBottom + toc.offsetHeight + 'px');
  };
  let placing = false;
  const schedulePlace = () => {
    if (placing) return;
    placing = true;
    requestAnimationFrame(() => {
      placing = false;
      placeToc();
    });
  };
  placeToc();
  window.addEventListener('resize', schedulePlace);
  window.addEventListener('scroll', schedulePlace, { passive: true });
  header?.addEventListener('transitionend', placeToc);

  // "Reading the table" is a folded block: any link to it opens it first.
  const tableDetail = document.querySelector<HTMLDetailsElement>('details[data-am-table-detail]');
  const openTable = () => { if (tableDetail) tableDetail.open = true; };
  if (tableDetail) {
    if (location.hash === '#' + tableDetail.id) openTable();
    window.addEventListener('hashchange', () => { if (location.hash === '#' + tableDetail.id) openTable(); });
    document.querySelectorAll<HTMLAnchorElement>('a[href="#' + tableDetail.id + '"]').forEach((link) => link.addEventListener('click', openTable));
  }

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-am-wind-toc-link]'));
  if (links.length > 0 && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((link) => [link.dataset.amWindTocLink ?? '', link]));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => link.classList.remove('is-active'));
          byId.get(entry.target.id)?.classList.add('is-active');
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    byId.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }
</script>
