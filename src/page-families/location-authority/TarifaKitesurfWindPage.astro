---
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import KiteClusterNav from '../../components/experience/KiteClusterNav.astro';
import KitePartnerLogoBand from '../../components/experience/KitePartnerLogoBand.astro';
import KiteThermalWindDiagram from '../../components/experience/KiteThermalWindDiagram.astro';
import WindguruExampleTable from '../../components/experience/WindguruExampleTable.astro';
import AemetForecastPanel from '../../components/location/AemetForecastPanel.astro';
import AemetWarningsPanel from '../../components/location/AemetWarningsPanel.astro';
import KiteBriefingPanel from '../../components/location/KiteBriefingPanel.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import LocationGuideIcon from '../../components/location/LocationGuideIcon.astro';
import Navigation from '../../components/Navigation.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import { tarifaKiteBriefingCopy } from '../../content/tarifaKiteBriefingContent';
import { tarifaKitesurfWindContent, tarifaKitesurfWindSeo } from '../../content/tarifaKitesurfWindContent';
import { tarifaWeatherWarningsCopy } from '../../content/tarifaWeatherWarningsContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { requireRouteImage } from '../../lib/images/routeImages';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import { resolveLocale } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';
import KiteChapterHead from './KiteChapterHead.astro';
import KiteVoice from './KiteVoice.astro';
import LocationModule from './LocationModule.astro';

/**
 * Wind, forecast, weather and safety page of the Tarifa kitesurf cluster.
 *
 * Reading order (operator direction, 11 September 2026): the page is the
 * morning of a kiter in Tarifa, in six chapters that the anchor row under
 * the hero repeats — Today (the official warning status and forecast,
 * folded; the picture of the Windguru table with the live link; and, folded
 * directly under it, Reading the table: a Windguru-style example of two
 * typical days, the rows explained under the same numbers, the models,
 * Beaufort), Which wind (Levante or Poniente), Thermal
 * wind (one clear day in three panels), Where to launch (which beach in
 * which wind, the zones, the tide) and In an emergency (private boats and
 * the state rescue, kept apart). The partner block, the guest-guide bridge
 * and the closing follow unchanged. Each chapter opens with a topic eyebrow, a
 * short label as the H2 and the former sentence heading as its subtitle; the
 * chapters carry no numbers (operator decision: peer tone, no textbook). The two named voices
 * speak where their topic is, not in one block at the end.
 *
 * The four information classes stay visually separate so none can read as a
 * riding approval: modelled values, private rescue offers, official rules and
 * the personal experience of two named voices. Sections sit on
 * `LocationModule`, which owns the gutter and surface geometry inside the
 * flush authority shell.
 */
interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = requireRouteImage('tarifa.kitesurfing.wind', 'hero', currentLang);
const sunsetImage = requireRouteImage('tarifa.kitesurfing.wind', 'sunset', currentLang);
const partnerImage = requireRouteImage('tarifa.kitesurfing.wind', 'partner', currentLang);
const windguruImage = requireRouteImage('tarifa.kitesurfing.wind', 'windguru', currentLang);
const markImage = requireRouteImage('tarifa.kitesurfing.surf-club', 'mark', currentLang);
const content = resolveLocale(tarifaKitesurfWindContent, currentLang);
const briefingCopy = resolveLocale(tarifaKiteBriefingCopy, currentLang);
const warningsCopy = resolveLocale(tarifaWeatherWarningsCopy, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf wind spoke');
const aboutHref = requiredLink('about');
const contactHref = `https://wa.me/34604440964?text=${encodeURIComponent(content.partner.contactMessage)}`;
const robertPortrait = '/images/robert-amara-host.jpg';
const photoLabel = { en: 'Photo', de: 'Foto', es: 'Foto', nl: 'Foto', sv: 'Foto' }[currentLang];
const footerHighlights: LabeledLink[] = [
  { token: content.token, label: content.hero.title },
  ...content.related.links.map((link) => ({ token: link.token, label: link.title }))
];
const calloutClass = 'am-text-label am-text-label--sm mr-2.5 inline-grid h-5 w-5 shrink-0 place-items-center rounded-full bg-primary tracking-normal text-surface';
---

<LocationAuthorityLayout seo={tarifaKitesurfWindSeo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights} pageFamily="experience-tarifa-kite-spoke">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken={content.token}>
    <ExperienceContextNav slot="context-navigation" currentId="kitesurfing" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="am-tarifa-surface overflow-x-clip bg-surface" data-am-page="tarifa-wind-kitesurfing" data-am-family="experience" data-am-role="spoke" data-am-topic="kitesurf-wind-forecast">
    <KiteClusterNav lang={currentLang} currentId="wind" />

    <LocationGuideHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      subtitle={content.hero.subtitle}
      paragraphs={[content.hero.lead]}
      family="experience"
      role="spoke"
      topic="kitesurf-wind-forecast"
      visualBreakpoint="lg"
    >
      <EditorialByline slot="meta" lang={currentLang} authorName="Robert Sebastian Böhmer" authorHref={aboutHref} updated={content.hero.updated} note={content.hero.note} />
      <AmaraImage
        slot="visual"
        src={hero.src}
        alt={hero.alt}
        profile="hero"
        width={1080}
        widths={[480, 640, 800, 1080]}
        sizes="(max-width: 1023px) 100vw, 36vw"
        class="aspect-[3/4] w-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </LocationGuideHero>

    {/* ANKERLEISTE — die sechs Abschnitte des Morgens, klebt unter dem festen Kopf */}
    <nav class="am-wind-toc sticky z-20 bg-surface px-6 md:px-12" aria-label={content.toc.label} data-am-wind-toc>
      <div class="mx-auto flex max-w-screen-2xl items-center gap-6 overflow-x-auto overscroll-x-contain" data-am-wind-toc-scroller>
        <span class="am-text-nav-context shrink-0 py-4 text-muted">{content.toc.label}</span>
        <ul class="m-0 flex shrink-0 list-none items-center gap-6 p-0">
          {content.toc.items.map((item) => (
            <li class="shrink-0">
              <a href={`#${item.id}`} class="am-text-nav-context inline-flex items-center border-b-2 border-transparent py-4 text-on-surface transition-colors hover:border-on-surface/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" data-am-wind-toc-link={item.id}>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    {/* HEUTE — amtlicher Warnstatus und Vorhersage (eingeklappt, Warnfarbe), Windguru live mit Bild, darunter „Die Tabelle lesen" aufklappbar */}
    <LocationModule id="heute" labelledby="heute-title" surface="tint" spacing="compact" data-am-wind-chapter="1" data-am-topic="live-today">
      <div class="mx-auto max-w-screen-2xl">
        <KiteChapterHead id="heute-title" label={content.today.label} title={content.today.title} subtitle={content.today.subtitle} icon="temperature" />

        <div class="mt-10">
          <AemetWarningsPanel
            endpoint="/api/weather/tarifa-warnings"
            lang={currentLang}
            timezone="Europe/Madrid"
            copy={warningsCopy}
            officialHref="https://www.aemet.es/es/eltiempo/prediccion/avisos?w=hoy&l=611104"
          />
        </div>

        <details class="group mt-6 bg-surface px-6 py-6 outline-none md:px-8" data-am-official-detail>
            <summary class="am-accordion__trigger items-center">
              <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.today.official.title}</h3>
              <span class="am-accordion__indicator" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.today.official.text} /></p>
            <div class="mt-6" data-am-official-weather>
              <AemetForecastPanel
                endpoint="/api/weather/tarifa"
                lang={currentLang}
                labels={{
                  loading: content.today.forecast.loading,
                  today: content.today.forecast.today,
                  tomorrow: content.today.forecast.tomorrow,
                  high: content.today.forecast.high,
                  low: content.today.forecast.low,
                  rain: content.today.forecast.rain,
                  issued: content.today.forecast.issued,
                  unavailable: content.today.forecast.unavailableTitle,
                  unavailableText: content.today.forecast.unavailableText,
                  source: content.today.forecast.aemetLabel
                }}
                sourceHref={content.today.official.href}
                fallbackLabel={content.today.forecast.aemetLabel}
              />
            </div>
            <AmaraActionLink href={content.today.official.href} variant="editorial" external class="mt-5 inline-flex">{content.today.official.linkLabel}</AmaraActionLink>

            <div class="mt-10">
              <p class="am-text-body leading-relaxed text-on-surface-variant">{content.today.official.briefingText}</p>
              <KiteBriefingPanel
                endpoint="/api/weather/tarifa-kite"
                warningsEndpoint="/api/weather/tarifa-warnings"
                lang={currentLang}
                timezone="Europe/Madrid"
                copy={briefingCopy}
                warningLevels={warningsCopy.levels}
                aemetHref={content.today.official.href}
                aemetLabel={content.today.official.linkLabel}
              />
            </div>
        </details>

        <figure class="m-0 mt-6 bg-inverse-surface px-6 py-8 text-inverted-on-surface md:px-8 md:py-10" data-am-windguru-live>
          <div class="max-w-3xl">
            <p class="am-text-eyebrow text-primary-fixed-dim">{content.today.windguru.eyebrow}</p>
            <h3 class="am-text-subtitle mt-4 text-balance text-inverted-on-surface">{content.today.windguru.title}</h3>
            <p class="am-text-body mt-4 leading-relaxed text-inverted-on-surface/80"><InlineEmphasis text={content.today.windguru.text} /></p>
          </div>
          <div class="mt-8 overflow-x-auto bg-surface p-2" role="region" aria-label={windguruImage.alt} tabindex="0">
            <AmaraImage src={windguruImage.src} alt={windguruImage.alt} profile="gallery" width={1150} widths={[768, 1150]} sizes="(max-width: 1023px) 48rem, 72rem" class="block h-auto w-full min-w-[48rem]" quality={90} avifQuality={80} />
          </div>
          <figcaption class="am-text-caption mt-3 max-w-3xl normal-case tracking-normal text-inverted-on-surface/70">{windguruImage.caption} · {windguruImage.credit}</figcaption>
          <AmaraActionLink href={content.today.windguru.linkHref} variant="secondary" inverse external class="mt-7 inline-flex">{content.today.windguru.linkLabel}</AmaraActionLink>
        </figure>

        {/* DIE TABELLE LESEN — aufklappbar direkt unter dem Windguru-Bild: Beispieltag, Zeilen unter denselben Nummern, Modelle, Beaufort */}
        <details id="tabelle" class="group mt-6 bg-surface px-6 py-6 outline-none md:px-8" data-am-wind-chapter="1" data-am-table-detail>
          <summary class="am-accordion__trigger items-center">
            <div class="pr-6">
              <div class="flex items-center gap-2.5">
                <LocationGuideIcon name="comparison" class="h-4 w-4" />
                <p class="am-text-eyebrow text-primary">{content.table.label}</p>
              </div>
              <h3 id="tabelle-title" class="am-text-title mt-4 text-balance text-on-surface transition-colors group-hover:text-primary">{content.table.title}</h3>
              <p class="am-text-subtitle mt-3 max-w-2xl text-balance text-on-surface-variant">{content.table.subtitle}</p>
            </div>
            <span class="am-accordion__indicator" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.table.intro} /></p>

          <div class="mt-10">
            <WindguruExampleTable copy={content.table.example} rows={content.table.rows} tone="on-white" />
          </div>

          <div class="mt-5 grid gap-5 md:grid-cols-2" data-am-reading-examples>
            {content.table.examples.map((example) => (
              <div class="min-w-0 border-l-2 border-on-surface bg-surface-container-low px-6 py-6" data-am-reading-example={example.id}>
                <p class="am-text-label am-text-label--sm text-primary">{example.label}</p>
                <p class="am-text-subtitle mt-2 text-balance text-on-surface">{example.value}</p>
                <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant"><InlineEmphasis text={example.text} /></p>
              </div>
            ))}
          </div>

          <dl class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {content.table.rows.map((row) => (
              <div class="min-w-0 border-l-2 border-primary/35 bg-surface-container-low px-6 py-6" data-windguru-row={row.id}>
                <dt class="am-text-label am-text-label--sm flex items-center text-on-surface"><span class={calloutClass} aria-hidden="true">{row.number}</span>{row.title}</dt>
                <dd class="am-text-body mt-3 leading-relaxed text-on-surface-variant"><InlineEmphasis text={row.text} /></dd>
              </div>
            ))}
            <div class="min-w-0 border-l-2 border-border-subtle bg-surface-container-low px-6 py-6" data-windguru-row="wave-note">
              <dt class="am-text-label am-text-label--sm text-muted">{content.table.waveNote.title}</dt>
              <dd class="am-text-body mt-3 leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.table.waveNote.text} /></dd>
            </div>
          </dl>

          <details class="group mt-12 pt-2 outline-none" data-am-windguru-models>
            <summary class="am-accordion__trigger items-center">
              <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.table.modelsTitle}</h3>
              <span class="am-accordion__indicator" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <div class="mt-8 space-y-6">
              <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{content.table.modelsIntro}</p>
              <dl class="space-y-4">
                {content.table.models.map((model) => (
                  <div class="border-l-2 border-primary/35 pl-5" data-windguru-model={model.id}>
                    <dt class="am-text-label text-on-surface">{model.name}</dt>
                    <dd class="am-text-body mt-1 leading-relaxed text-on-surface-variant"><InlineEmphasis text={model.text} /></dd>
                  </div>
                ))}
              </dl>
              <p class="am-text-body max-w-3xl leading-relaxed text-on-surface"><InlineEmphasis text={content.table.modelsWhy} /></p>
            </div>
          </details>

          <details class="group mt-10 pt-2 outline-none" data-am-beaufort>
            <summary class="am-accordion__trigger items-center">
              <h3 class="am-text-subtitle pr-6 text-on-surface transition-colors group-hover:text-primary">{content.table.beaufort.title}</h3>
              <span class="am-accordion__indicator" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <p class="am-text-body mt-5 max-w-3xl leading-relaxed text-on-surface-variant">{content.table.beaufort.intro}</p>
            <div class="mt-6 overflow-x-auto bg-surface-container-low" role="region" aria-label={content.table.beaufort.title} tabindex="0">
              <table class="w-full min-w-[40rem] border-collapse text-left">
                <caption class="sr-only">{content.table.beaufort.title}</caption>
                <thead>
                  <tr class="border-b border-border-subtle">
                    <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.table.beaufort.columnKnots}</th>
                    <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.table.beaufort.columnForce}</th>
                    <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.table.beaufort.columnName}</th>
                    <th scope="col" class="px-4 py-3 am-text-label am-text-label--sm text-on-surface-variant">{content.table.beaufort.columnSea}</th>
                  </tr>
                </thead>
                <tbody>
                  {content.table.beaufort.rows.map((row) => (
                    <tr class="border-b border-border-subtle last:border-b-0" data-beaufort={row.id}>
                      <th scope="row" class="whitespace-nowrap px-4 py-3 am-text-body tabular-nums text-on-surface">{row.knots} kn</th>
                      <td class="whitespace-nowrap px-4 py-3 am-text-body tabular-nums text-on-surface-variant">{row.force}</td>
                      <td class="whitespace-nowrap px-4 py-3 am-text-body text-on-surface-variant">{row.name}</td>
                      <td class="px-4 py-3 am-text-body text-on-surface-variant">{row.sea}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="am-text-caption mt-4 max-w-3xl normal-case tracking-normal text-muted">{content.table.beaufort.note}</p>
            <p class="am-text-body mt-4 max-w-3xl leading-relaxed text-on-surface"><InlineEmphasis text={content.table.beaufort.warningNote} /></p>
          </details>
        </details>

      </div>
    </LocationModule>

    {/* WELCHER WIND — Levante oder Poniente, am Morgen erkennen, Brücke zur Tabelle */}
    <LocationModule id="welcher-wind" labelledby="welcher-wind-title" spacing="compact" data-am-wind-chapter="1" data-am-topic="local-wind">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
          <KiteChapterHead id="welcher-wind-title" label={content.wind.label} title={content.wind.title} subtitle={content.wind.subtitle} icon="wind" class="lg:col-span-5" />
          <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant lg:col-span-7 lg:self-end"><InlineEmphasis text={content.wind.intro} /></p>
        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-12 lg:gap-20" data-am-wind-recognize>
          <h3 class="am-text-subtitle max-w-md text-balance text-on-surface lg:col-span-5">{content.wind.recognizeTitle}</h3>
          <div class="space-y-5 lg:col-span-7">
            <KiteVoice id="robert-morning" name={content.wind.robert.name} role={content.wind.robert.role} paragraphs={content.wind.robertMorning} imageSrc={robertPortrait} imageAlt={content.wind.robert.imageAlt} tone="on-white" />
            <KiteVoice id={content.wind.markReading.id} name={content.wind.mark.name} role={content.wind.mark.role} lead={content.wind.markReading.lead} paragraphs={content.wind.markReading.paragraphs} imageSrc={markImage.src} imageAlt={markImage.alt} focalPoint="50% 25%" tone="on-white" />
          </div>
        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-12 lg:gap-20" data-am-wind-experience>
          <h3 class="am-text-subtitle max-w-md text-balance text-on-surface lg:col-span-5">{content.wind.experienceTitle}</h3>
          <div class="lg:col-span-7">
            <KiteVoice id="robert-experience" name={content.wind.robert.name} role={content.wind.robert.role} paragraphs={content.wind.robertExperience} imageSrc={robertPortrait} imageAlt={content.wind.robert.imageAlt} tone="on-white" />
          </div>
        </div>

        <div class="mt-12 max-w-3xl border-l-2 border-primary/35 bg-surface-container-low px-6 py-6" data-am-bridge="table">
          <p class="am-text-label am-text-label--sm text-primary">{content.wind.bridge.label}</p>
          <p class="am-text-body mt-3 leading-relaxed text-on-surface"><InlineEmphasis text={content.wind.bridge.text} /></p>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
            {content.wind.bridge.links.map((link) => <a class="am-link am-text-label am-text-label--sm" href={`#${link.anchor}`}>{link.label} ↓</a>)}
          </p>
        </div>
      </div>
    </LocationModule>

    {/* THERMIK — ein klarer Tag in drei Tafeln, dann Poniente und Levante */}
    <LocationModule id="thermik" labelledby="thermik-title" spacing="compact" data-am-wind-chapter="1" data-am-topic="thermal-wind">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
          <KiteChapterHead id="thermik-title" label={content.thermal.label} title={content.thermal.title} subtitle={content.thermal.subtitle} icon="sunshine" class="lg:col-span-5" />
          <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant lg:col-span-7 lg:self-end"><InlineEmphasis text={content.thermal.intro} /></p>
        </div>

        <div class="mt-12">
          <KiteThermalWindDiagram panels={content.thermal.panels} />
        </div>

        <div class="mt-5 grid gap-5 md:grid-cols-2" data-am-thermal-consequences>
          {content.thermal.consequences.map((item) => (
            <div class="min-w-0 border-l-2 border-primary/35 bg-surface-container-low px-6 py-6" data-am-thermal-consequence={item.id}>
              <h3 class="am-text-label am-text-label--sm text-on-surface">{item.title}</h3>
              <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant"><InlineEmphasis text={item.text} /></p>
            </div>
          ))}
        </div>

        <div class="mt-10 max-w-3xl border-l-2 border-primary/35 bg-surface-container-low px-6 py-6" data-am-bridge="thermal">
          <p class="am-text-label am-text-label--sm text-primary">{content.thermal.bridge.label}</p>
          <p class="am-text-body mt-3 leading-relaxed text-on-surface"><InlineEmphasis text={content.thermal.bridge.text} /></p>
        </div>
      </div>
    </LocationModule>

    <section class="relative isolate overflow-hidden bg-inverse-surface" data-am-topic="editorial-photo">
      <div class="aspect-[4/5] w-full sm:aspect-video lg:aspect-[21/9]">
        <AmaraImage src={sunsetImage.src} alt={sunsetImage.alt} profile="background" class="h-full w-full object-cover" focalPoint={sunsetImage.focalPoint} />
      </div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto w-full max-w-screen-2xl px-6 pb-8 md:px-12 md:pb-12">
          <p class="am-text-subtitle max-w-2xl text-balance text-inverted-on-surface">{sunsetImage.caption}</p>
          <p class="am-text-caption mt-3 normal-case tracking-normal text-inverted-on-surface/65">{photoLabel}: {sunsetImage.credit}</p>
        </div>
      </div>
    </section>

    {/* WO RAUS — Strand je Wind, Zonen und Bojen, Lagune, Tide */}
    <LocationModule id="wo-raus" labelledby="wo-raus-title" surface="tint" spacing="compact" data-am-wind-chapter="1" data-am-topic="official-rules">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
