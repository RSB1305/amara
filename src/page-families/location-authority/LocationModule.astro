---
import AmaraSection from '../../components/layout/AmaraSection.astro';

interface Props {
  id?: string;
  labelledby?: string;
  surface?: 'white' | 'tint' | 'inverse';
  spacing?: 'standard' | 'compact' | 'closing';
  class?: string;
  [attribute: `data-am-${string}`]: string | undefined;
}

const {
  id,
  labelledby,
  surface = 'white',
  spacing = 'standard',
  class: className,
  ...moduleAttributes
} = Astro.props;

const surfaceClass = {
  white: 'bg-surface',
  tint: 'bg-surface-container-low',
  inverse: 'bg-inverse-surface text-inverted-on-surface'
}[surface];

const canonicalSurface = {
  white: 'plain',
  tint: 'tint',
  inverse: 'inverse'
}[surface] as 'plain' | 'tint' | 'inverse';

const spacingClass = {
  standard: 'py-20 md:py-28',
  compact: 'py-16 md:py-20',
  closing: 'py-24 md:py-32'
}[spacing];

const moduleClass = ['mx-0 px-6 md:px-12', spacingClass, surfaceClass, className]
  .filter(Boolean)
  .join(' ');
---

<AmaraSection
  id={id}
  labelledby={labelledby}
  surface={canonicalSurface}
  family="location"
  class={moduleClass}
  {...moduleAttributes}
>
  <slot />
</AmaraSection>
