---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import LocationClimateTable from '../../components/location/LocationClimateTable.astro';
import SeasonalPillar from '../../components/location/SeasonalPillar.astro';
import LocationWeatherHero from '../../components/location/LocationWeatherHero.astro';
import AemetForecastPanel from '../../components/location/AemetForecastPanel.astro';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import LocationModule from './LocationModule.astro';
import type { LocationClimateMonth } from '../../content/locationClimateData';
import type { WeatherAuthorityContent } from './weatherAuthority';
import { getPageEndAttributes } from '../../components/page-end/pageEndContract';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  pageId: string;
  content: WeatherAuthorityContent;
  months: Array<LocationClimateMonth & { month: string }>;
  climateSource: { label: string; href: string };
  forecastHref: string;
  liveForecast?: {
    endpoint: string;
    lang: AmaraLanguage;
    labels: NonNullable<WeatherAuthorityContent['forecast']['live']>;
  };
  resolveHref: (token: WeatherAuthorityContent['related']['links'][number]['token']) => string;
  primaryHref: string;
  secondaryHref: string;
}

const {
  pageId,
  content,
  months,
  climateSource,
  forecastHref,
  liveForecast,
  resolveHref,
  primaryHref,
  secondaryHref
} = Astro.props;
---

<article
  class="bg-surface"
  data-am-page={pageId}
  data-am-family="location"
  data-am-role="spoke"
  data-am-topic="weather"
  data-am-presentation="weather"
  data-am-weather-family="climate-seasons"
>
  <LocationWeatherHero
    eyebrow={content.hero.eyebrow}
    title={content.hero.title}
    paragraphs={[content.hero.lead]}
    evidenceEyebrow={content.hero.summaryEyebrow}
    evidenceSummary={content.hero.summary}
    evidenceItems={content.hero.summaryItems}
  />

  <LocationModule data-am-weather-module="factors">
    <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="am-text-eyebrow text-primary">{content.factors.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-on-surface">{content.factors.title}</h2>
        <div class="mt-7 max-w-xl space-y-5">
          {content.factors.paragraphs.map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
        </div>
      </div>
      <div class="border-y border-border-subtle lg:col-span-7">
        {content.factors.items.map((item, index) => (
          <article class:list={['grid gap-4 py-7 sm:grid-cols-[3rem_minmax(0,1fr)]', index > 0 && 'border-t border-border-subtle']}>
            <span class="am-text-label am-text-label--sm am-text-label--wide text-primary">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="am-text-subtitle text-on-surface">{item.title}</h3>
              <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant"><InlineEmphasis text={item.text} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </LocationModule>

  <div data-am-weather-module="monthly-data">
    <LocationClimateTable
      eyebrow={content.table.eyebrow}
      title={content.table.title}
      intro={content.table.intro}
      months={months}
      labels={{
        month: content.table.labels.month,
        high: content.table.labels.high,
        low: content.table.labels.low,
        rain: content.table.labels.rain,
        sunHours: content.table.labels.sunHours,
        details: content.table.labels.details
      }}
      chartLabels={{
        temperature: content.table.labels.temperature,
        rainfall: content.table.labels.rainfall
      }}
      sourceTitle={content.table.sourceTitle}
      sourceText={content.table.sourceText}
      sources={[climateSource]}
    />
  </div>

  <LocationModule surface="tint" data-am-weather-module="seasons">
    <div class="mx-auto max-w-screen-2xl">
      <div class="max-w-3xl">
        <p class="am-text-eyebrow text-primary">{content.seasons.eyebrow}</p>
        <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{content.seasons.title}</h2>
        <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.seasons.intro} /></p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {content.seasons.items.map((season, index) => (
          <SeasonalPillar
            eyebrow={season.period}
            title={season.title}
            vibe={season.summary}
            practicalLabel={content.seasons.planningLabel}
            hint={season.planning}
            isHighlighted={index === 1}
          />
        ))}
      </div>
    </div>
  </LocationModule>

  <LocationModule surface="inverse" data-am-weather-module="travel-fit">
    <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="am-text-eyebrow text-primary-fixed-dim">{content.bestTime.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-inverted-on-surface">{content.bestTime.title}</h2>
        <p class="am-text-body mt-7 max-w-xl leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={content.bestTime.intro} /></p>
      </div>
      <div class="grid border-y border-inverted-on-surface/20 sm:grid-cols-2 lg:col-span-7">
        {content.bestTime.items.map((item, index) => (
          <article class:list={['p-7', index > 1 && 'border-t border-inverted-on-surface/20', index % 2 === 1 && 'sm:border-l sm:border-inverted-on-surface/20']}>
            <h3 class="am-text-subtitle text-inverted-on-surface">{item.title}</h3>
            <p class="am-text-body mt-4 leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={item.text} /></p>
            {item.link && (
              <a
                href={resolveHref(item.link.token)}
                class="am-cta-link mt-5 inline-flex text-primary-fixed-dim"
              >
                {item.link.label}
              </a>
            )}
            {item.extraLink && (
              <a
                href={resolveHref(item.extraLink.token)}
                class="am-cta-link mt-3 inline-flex text-inverted-on-surface/70"
              >
                {item.extraLink.label}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </LocationModule>

  <LocationModule data-am-weather-module="practical">
    <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
      <div class:list={[content.practical.items.length > 0 ? 'lg:col-span-7' : 'lg:col-span-12']}>
        <p class="am-text-eyebrow text-primary">{content.practical.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-2xl text-balance italic text-on-surface">{content.practical.title}</h2>
        <div class="mt-7 max-w-3xl space-y-5">
          {content.practical.paragraphs.map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
        </div>
      </div>
      {content.practical.items.length > 0 && (
        <div class="bg-surface-container-low p-8 lg:col-span-5 md:p-10">
        <h3 class="am-text-eyebrow text-primary">{content.practical.listTitle}</h3>
        <ul class="mt-6 border-t border-border-subtle">
          {content.practical.items.map((item) => (
            <li class="am-text-body border-b border-border-subtle py-4 leading-relaxed text-on-surface"><InlineEmphasis text={item} /></li>
          ))}
        </ul>
        </div>
      )}
    </div>
  </LocationModule>

  <LocationModule surface="tint" data-am-weather-module="forecast">
    <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="am-text-eyebrow text-primary">{content.forecast.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-xl text-balance italic text-on-surface">{content.forecast.title}</h2>
      </div>
      <div class="lg:col-span-7">
        <div class="space-y-5">
          {content.forecast.paragraphs.map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
        </div>
        {liveForecast ? (
          <AemetForecastPanel
            endpoint={liveForecast.endpoint}
            lang={liveForecast.lang}
            labels={liveForecast.labels}
            sourceHref={forecastHref}
            fallbackLabel={content.forecast.cta}
          />
        ) : (
          <AmaraActionLink href={forecastHref} variant="editorial" external class="mt-8 inline-flex">
            {content.forecast.cta}
          </AmaraActionLink>
        )}
      </div>
    </div>
  </LocationModule>

  <LocationModule data-am-weather-module="sources">
    <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <p class="am-text-eyebrow text-primary">{content.sources.eyebrow}</p>
        <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{content.sources.title}</h2>
        <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.sources.intro} /></p>
        <p class="mt-6 am-text-label am-text-label--sm text-muted">{content.sources.checked}</p>
      </div>
      <div class="border-t border-border-subtle lg:col-span-8">
        {content.sources.links.map((source) => (
          <a href={source.href} target="_blank" rel="noopener noreferrer" class="group grid grid-cols-[1fr_auto] gap-8 border-b border-border-subtle py-7">
            <span>
              <span class="am-text-subtitle block text-on-surface group-hover:text-primary">{source.label}</span>
              <span class="am-text-body mt-2 block leading-relaxed text-on-surface-variant"><InlineEmphasis text={source.text} /></span>
            </span>
            <span aria-hidden="true" class="am-text-subtitle text-primary">↗</span>
          </a>
        ))}
      </div>
    </div>
  </LocationModule>

  <AuthorityRelatedLinks related={content.related} columns="md:grid-cols-3" resolveHref={resolveHref} />

  <LocationModule spacing="closing" divider={false} {...getPageEndAttributes('next-action', 'location')}>
    <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-end lg:gap-20">
      <div class="lg:col-span-7">
        <p class="am-text-eyebrow text-primary">{content.closing.eyebrow}</p>
        <h2 class="am-text-display mt-6 text-balance italic text-on-surface">{content.closing.title}</h2>
      </div>
      <div class="lg:col-span-5">
        <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={content.closing.body} /></p>
        <div class="mt-8 flex flex-col items-start gap-5">
          <a href={primaryHref} class="am-cta-link">{content.closing.primaryLabel}</a>
          <a href={secondaryHref} class="am-inline-link">{content.closing.secondaryLabel}</a>
        </div>
      </div>
    </div>
  </LocationModule>
</article>
