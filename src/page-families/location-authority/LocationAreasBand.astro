---
/**
 * The inverted "areas" band on a destination location hub: an eyebrow and
 * display title alongside the orientation paragraphs, then the numbered
 * archetype columns and an optional call to action.
 *
 * Nerja and Tarifa had authored this band twice, character for character apart
 * from how each page resolved its link. The link arrives resolved here so the
 * band stays a presentation component and does not reach into either page's
 * link contract.
 */
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';

export interface LocationAreaArchetype {
  title: string;
  consequence: string;
}

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  archetypes: LocationAreaArchetype[];
  link?: { href: string; label: string };
}

const { eyebrow, title, paragraphs, archetypes, link } = Astro.props;
---

<section class="border-b border-border-subtle bg-inverse-surface px-6 py-24 text-inverted-on-surface md:px-12 md:py-32 lg:py-40">
  <div class="mx-auto max-w-screen-2xl">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="am-text-eyebrow text-primary-fixed-dim">{eyebrow}</p>
        <h2 class="am-text-display mt-6 text-balance text-inverted-on-surface">{title}</h2>
      </div>
      <div class="space-y-5 lg:col-span-7">
        {paragraphs.map((paragraph) => (
          <p class="am-text-body leading-relaxed text-inverted-on-surface/75"><InlineEmphasis text={paragraph} /></p>
        ))}
      </div>
    </div>
    <div class="mt-16 grid gap-x-8 md:grid-cols-2 lg:mt-24 lg:grid-cols-4">
      {archetypes.map((area, index) => (
        <div class="border-t border-inverted-on-surface/20 py-7">
          <span class="text-primary-fixed-dim am-text-label am-text-label--sm">0{index + 1}</span>
          <h3 class="am-text-subtitle mt-4 text-inverted-on-surface">{area.title}</h3>
          <p class="am-text-body mt-3 leading-relaxed text-inverted-on-surface/70"><InlineEmphasis text={area.consequence} /></p>
        </div>
      ))}
    </div>
    {link && (
      <a href={link.href} class="am-btn am-btn--primary mt-10">{link.label}</a>
    )}
  </div>
</section>
