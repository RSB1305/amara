---
import EditorialFeatureGrid from '../../components/editorial/EditorialFeatureGrid.astro';
import EditorialCallout from '../../components/content/EditorialCallout.astro';
import AmaraSectionIntro from '../../components/layout/AmaraSectionIntro.astro';

interface FeatureItem {
  title: string;
  text: string;
}

interface Props {
  id?: string;
  title: string;
  intro?: string;
  items: readonly FeatureItem[];
  emphasizeText?: boolean;
  surface?: 'plain' | 'tint';
  eyebrow?: string;
  reviewed?: string;
  headerCallout?: {
    text: string;
    surface?: 'low' | 'lowest';
  };
  footerCallout?: {
    text: string;
    surface?: 'low' | 'lowest';
  };
}

const {
  id,
  title,
  intro,
  items,
  emphasizeText = false,
  surface = 'tint',
  eyebrow,
  reviewed,
  headerCallout,
  footerCallout
} = Astro.props;
const sectionClass = surface === 'plain' ? 'am-section--plain' : 'am-section--tint';
const hasHeaderDetails = Boolean(intro || eyebrow || reviewed || headerCallout);
---

<section id={id} class:list={['am-section', sectionClass]}>
  {hasHeaderDetails ? (
    <AmaraSectionIntro
      title={title}
      eyebrow={eyebrow}
      intro={intro}
      variant="editorial"
      emphasizeIntro={emphasizeText}
    >
      {headerCallout && (
        <EditorialCallout class="mt-3 max-w-3xl" surface={headerCallout.surface}>
          {headerCallout.text}
        </EditorialCallout>
      )}
      {reviewed && (
        <p class="mt-6 am-text-caption normal-case tracking-normal text-on-surface-variant">
          {reviewed}
        </p>
      )}
    </AmaraSectionIntro>
  ) : (
    <AmaraSectionIntro title={title} variant="editorial" />
  )}
  <EditorialFeatureGrid cards={items.map((item) => ({ title: item.title, copy: item.text }))} />
  {footerCallout && (
    <EditorialCallout class="mt-12 max-w-3xl" surface={footerCallout.surface}>
      {footerCallout.text}
    </EditorialCallout>
  )}
</section>
