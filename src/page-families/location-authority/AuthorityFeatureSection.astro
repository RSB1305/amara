---
import EditorialFeatureGrid from '../../components/editorial/EditorialFeatureGrid.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';

interface FeatureItem {
  title: string;
  text: string;
}

interface Props {
  id?: string;
  title: string;
  intro?: string;
  items: readonly FeatureItem[];
  emphasizeText?: boolean;
  surface?: 'plain' | 'tint';
  eyebrow?: string;
  reviewed?: string;
  headerCallout?: {
    text: string;
    surface?: 'low' | 'lowest';
  };
  footerCallout?: {
    text: string;
    surface?: 'low' | 'lowest';
  };
}

const {
  id,
  title,
  intro,
  items,
  emphasizeText = false,
  surface = 'tint',
  eyebrow,
  reviewed,
  headerCallout,
  footerCallout
} = Astro.props;
const sectionClass = surface === 'plain' ? 'am-section--plain' : 'am-section--tint';
const hasHeaderDetails = Boolean(intro || eyebrow || reviewed || headerCallout);
const calloutSurfaceClass = (value?: 'low' | 'lowest') => value === 'lowest'
  ? 'bg-surface-container-lowest'
  : 'bg-surface-container-low';
---

<section id={id} class:list={['am-section', sectionClass]}>
  {hasHeaderDetails ? (
    <div class="mb-16 max-w-3xl">
      {eyebrow && <p class="am-text-caption mb-5 text-primary">{eyebrow}</p>}
      <h2 class="am-text-title mb-6 italic tracking-tight text-on-surface">{title}</h2>
      {intro && (
        <p class="am-text-body leading-relaxed text-on-surface-variant">
          {emphasizeText ? <InlineEmphasis text={intro} /> : intro}
        </p>
      )}
      {headerCallout && (
        <p class:list={[
          'mt-8 max-w-3xl border-l border-primary/20 px-4 py-3 am-text-body leading-relaxed text-on-surface-variant',
          calloutSurfaceClass(headerCallout.surface)
        ]}>
          {headerCallout.text}
        </p>
      )}
      {reviewed && (
        <p class="mt-6 am-text-caption normal-case tracking-normal text-on-surface-variant">
          {reviewed}
        </p>
      )}
    </div>
  ) : (
    <h2 class="am-text-title mb-16 italic tracking-tight text-on-surface">{title}</h2>
  )}
  <EditorialFeatureGrid cards={items.map((item) => ({ title: item.title, copy: item.text }))} />
  {footerCallout && (
    <p class:list={[
      'mt-12 max-w-3xl border-l border-primary/20 px-4 py-3 am-text-body leading-relaxed text-on-surface-variant',
      calloutSurfaceClass(footerCallout.surface)
    ]}>
      {footerCallout.text}
    </p>
  )}
</section>
