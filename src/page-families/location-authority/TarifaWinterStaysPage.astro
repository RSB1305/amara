---
import Navigation from '../../components/Navigation.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  tarifaWinterStaysContent,
  tarifaWinterStaysSeo
} from '../../content/tarifaWinterStaysContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = tarifaWinterStaysContent[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa winter stays');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_tarifa');
const propertyHref = requiredLink('casa');
const footerHighlights: LabeledLink[] = [
  { token: 'tarifa_winter_stays', label: content.navLabel },
  { token: 'tarifa_weather', label: content.related.links[0].label },
  { token: 'tarifa_daily_life', label: content.related.links[1].label }
];
---

<LocationAuthorityLayout
  seo={tarifaWinterStaysSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="tarifa_winter_stays"
  />
  <TarifaContextNav
    activeId="overview"
    activeChildId="winter-stays"
    currentLabel="Tarifa"
    childLabel={content.navLabel}
    lang={currentLang}
  />

  <AuthorityArticle
    pageId="tarifa-winter-stays"
    family="location"
    topic="winter-stays"
    lang={currentLang}
    hero={content.hero}
    authorName={tarifaWinterStaysSeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    secondaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
    presentation="guide"
    guideVisual={{
      eyebrow: content.facts[0].label,
      mark: content.hero.mark,
      note: content.facts[0].value
    }}
  >
    {content.sections.map((section, index) => (
      <AuthorityTextSection
        section={section}
        index={index}
        data-am-winter-stays-section={section.id}
      />
    ))}

    <AuthorityRelatedLinks
      related={content.related}
      columns="md:grid-cols-2"
      resolveHref={requiredLink}
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
