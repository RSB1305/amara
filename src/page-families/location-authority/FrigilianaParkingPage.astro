---
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaParkingGuideContent,
  frigilianaParkingGuideSeo
} from '../../content/frigilianaParkingGuideContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import ParkingAuthorityArticle from './ParkingAuthorityArticle.astro';

interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = frigilianaParkingGuideContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana parking');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_frigiliana');
const propertyHref = requiredLink('romantic_hideaways');
const footerHighlights: LabeledLink[] = [
  { token: 'frigiliana_parking', label: content.navLabel },
  { token: 'getting_to_frigiliana', label: content.related.links[0].label },
  { token: 'frigiliana_stairs', label: content.related.links[1].label }
];
---

<LocationAuthorityLayout seo={frigilianaParkingGuideSeo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights}>
  <Navigation slot="navigation" currentLang={currentLang} languageToken="frigiliana_parking" />
  <LocationContextNav activeId="parking" lang={currentLang} />
  <ParkingAuthorityArticle
    pageId="frigiliana-parking"
    lang={currentLang}
    content={content}
    seo={frigilianaParkingGuideSeo}
    authorHref={aboutHref}
    locationHref={locationHref}
    propertyHref={propertyHref}
    resolveHref={requiredLink}
  />
</LocationAuthorityLayout>
