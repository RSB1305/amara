---
import type { LabeledLink } from '../../lib/linkResolver';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import HairlineStatCard from '../../components/location/HairlineStatCard.astro';
import {
  frigilianaMarketCopy,
  frigilianaMarketExternalLinks,
  frigilianaMarketSeo
} from '../../content/frigilianaMarketContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import GuideClosingSection from './GuideClosingSection.astro';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaMarketCopy;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const parkingHref = buildOwnedLocalizedPath('frigiliana-parking', currentLang);

const facts = copy.facts.items.map((item) => ({
  label: t(item.label),
  value: t(item.value),
  note: t(item.note)
}));

const stallTypes = copy.stalls.items.map((item) => ({
  number: item.number,
  title: t(item.title),
  summary: t(item.summary),
  expect: t(item.expect),
  remember: t(item.remember)
}));

const morningSteps = copy.morning.steps.map((step) => ({
  num: step.num,
  headline: t(step.title),
  text: t(step.text)
}));

const faqItems = copy.morning.faq.map((item) => ({
  question: t(item.question),
  answer: t(item.answer)
}));

const liveInfoLinks = copy.liveInfo.links.map((link) => ({
  href:
    frigilianaMarketExternalLinks[
      link.key as keyof typeof frigilianaMarketExternalLinks
    ],
  label: t(link.label),
  text: t(link.text)
}));

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_market',
    label: t(copy.nav.links[1].label)
  },
  {
    token: 'frigiliana_parking',
    label: t(copy.nav.links[2].label)
  },
  {
    token: 'location_frigiliana',
    label: t(copy.related.links[3].label)
  }
];

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/06-frigiliana-pueblo.jpg',
  width: 2000
};

const ingenioImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/05-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};
---

<LocationAuthorityLayout
  seo={frigilianaMarketSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-market"
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_market"
  >
    <ExperienceContextNav slot="context-navigation" currentId="market" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-market">
    <div class="w-full">
      <LocationExperienceHero
        topic="market"
        eyebrow={t(copy.hero.eyebrow)}
        title={t(copy.hero.title)}
        paragraphs={[t(copy.hero.lead), t(copy.hero.body)]}
        imageSrc={heroImage.src}
        imageAlt={t(copy.hero.imageAlt)}
        imageWidth={heroImage.width}
        actions={[
          { href: '#market-facts', label: t(copy.hero.primaryCta), style: 'primary' },
          { href: parkingHref, label: t(copy.hero.secondaryCta), style: 'secondary' }
        ]}
      />

      <section id="market-facts" class="max-w-screen-2xl mx-auto px-6 md:px-12 pb-32">
        <div class="max-w-3xl mb-14">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {t(copy.facts.title)}
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-12 gap-y-12">
          {
            facts.map((fact) => (
              <HairlineStatCard
                label={fact.label}
                value={fact.value}
                description={fact.note}
              />
            ))
          }
        </div>
      </section>

      <section class="bg-surface-container-low border-y border-outline-variant/5">
        <div class="max-w-screen-2xl mx-auto px-6 md:px-12 py-32">
          <div class="max-w-3xl mb-20">
            <span class="am-text-section-caption text-primary mb-6">
              {t(copy.stalls.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.stalls.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.stalls.intro)}
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-12 gap-y-16">
            {
              stallTypes.map((stall) => (
                <article class="border-t border-outline-variant/25 pt-8">
                  <div class="flex items-baseline justify-between gap-6 mb-10">
                    <h3 class="am-text-subtitle text-on-surface">{stall.title}</h3>
                    <span
                      class="am-text-ordinal-display italic text-outline-variant/45"
                      aria-hidden="true"
                    >
                      {stall.number}
                    </span>
                  </div>
                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {stall.summary}
                  </p>
                  <dl class="mt-10 divide-y divide-outline-variant/10 border-y border-outline-variant/10">
                    <div class="py-6">
                      <dt class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary mb-3">
                        {t(copy.stalls.labels.expect)}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {stall.expect}
                      </dd>
                    </div>
                    <div class="py-6">
                      <dt class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary mb-3">
                        {t(copy.stalls.labels.remember)}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {stall.remember}
                      </dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <FaqAccordion
        arrivalTitle={t(copy.morning.title)}
        steps={morningSteps}
        faqTitle={t(copy.morning.faqTitle)}
        items={faqItems}
      />

      <section class="bg-surface-container-low border-y border-outline-variant/5">
        <div class="max-w-screen-2xl mx-auto px-6 md:px-12 py-32">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
            <div class="am-mobile-full-bleed lg:col-span-6">
              <AmaraImage
                src={ingenioImage.src}
                alt={t(copy.ingenio.imageAlt)}
                profile="card"
                class="w-full aspect-[4/3] object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="lg:col-span-6 lg:pl-10">
              <span class="am-text-section-caption text-primary mb-6">
                {t(copy.ingenio.eyebrow)}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                {t(copy.ingenio.title)}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed max-w-xl mb-9">
                {t(copy.ingenio.body)}
              </p>
              <AmaraActionLink
                href={frigilianaMarketExternalLinks.officialIngenio}
                variant="editorial"
                external
              >
                {t(copy.ingenio.cta)}
              </AmaraActionLink>
            </div>
          </div>
        </div>
      </section>

      <section class="max-w-screen-2xl mx-auto px-6 md:px-12 py-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-4">
            <span class="am-text-section-caption text-primary mb-6">
              {t(copy.marketTypes.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight">
              {t(copy.marketTypes.title)}
            </h2>
          </div>
          <p class="lg:col-span-7 lg:col-start-6 am-text-body text-on-surface-variant leading-relaxed border-l border-primary/25 pl-8">
            {t(copy.marketTypes.body)}
          </p>
        </div>
      </section>

      <section class="bg-surface-container-low border-y border-outline-variant/5">
        <div class="max-w-screen-2xl mx-auto px-6 md:px-12 py-32">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
            <div class="lg:col-span-4">
              <span class="am-text-section-caption text-primary mb-6">
                {t(copy.liveInfo.eyebrow)}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                {t(copy.liveInfo.title)}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed mb-6">
                {t(copy.liveInfo.intro)}
              </p>
              <p class="am-text-caption am-text-caption--upper text-muted">
                {t(copy.liveInfo.checked)}
              </p>
            </div>
            <div class="lg:col-span-8 border-t border-outline-variant/15">
              {
                liveInfoLinks.map((link) => (
                  <AmaraActionLink
                    href={link.href}
                    variant="card"
                    external
                    class="group grid grid-cols-[1fr_auto] gap-8 py-9 border-b border-outline-variant/15"
                  >
                    <span>
                      <span class="am-text-subtitle text-on-surface block mb-3 group-hover:text-primary transition-colors">
                        {link.label}
                      </span>
                      <span class="am-text-body text-on-surface-variant leading-relaxed">
                        {link.text}
                      </span>
                    </span>
                    <span
                      class="am-text-subtitle text-primary transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </AmaraActionLink>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <GuideClosingSection
        title={t(copy.closing.title)}
        lead={t(copy.closing.lead)}
        lang={currentLang}
        links={[
          {
            token: 'frigiliana_daily_life',
            label: t(copy.closing.nextCta),
            style: 'text'
          }
        ]}
        role="next-action"
        family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
