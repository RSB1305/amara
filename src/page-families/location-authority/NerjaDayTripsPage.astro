---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import DayTripRadiusGraphic, { type DayTripRadiusGraphicData } from '../../components/location/DayTripRadiusGraphic.astro';
import Navigation from '../../components/Navigation.astro';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  nerjaDayTripOriginContext,
  nerjaDayTripsPageContent,
  nerjaDayTripsSeo
} from '../../content/nerjaExperienceAdditionsContent';
import { getAndalusiaDayTripFacts } from '../../content/sharedExperienceFacts';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import DayTripDestinationList from './DayTripDestinationList.astro';
import { routeHero, routeImages } from '../../lib/images/routeImages';
import LocationPhotoGallery from '../../components/location/LocationPhotoGallery.astro';
import ExperienceRelatedSection from './ExperienceRelatedSection.astro';

interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = routeHero('nerja.experience.day-trips', currentLang);
const galleryImages = routeImages('nerja.experience.day-trips', 'gallery', currentLang);
const shared = getAndalusiaDayTripFacts(currentLang);
const copy = nerjaDayTripsPageContent[currentLang];
const origin = nerjaDayTripOriginContext[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Nerja day trips');
const destinations = shared.destinations.map((destination) => ({
  ...destination,
  summary: destination.id === 'malaga' ? origin.malagaSummary : destination.summary,
  facts: destination.facts.map((fact, index) =>
    index === 0 ? { ...fact, value: (origin.driveTimes[destination.id as keyof typeof origin.driveTimes] ?? fact.value) } : fact
  ),
  details: destination.id === 'ronda' ? origin.rondaDetails : destination.details
}));
const practical = {
  ...shared.practical,
  items: shared.practical.items.map((item, index) =>
    index === shared.practical.items.length - 1
      ? { ...item, text: origin.returnText }
      : item
  )
};
const footerHighlights: LabeledLink[] = [
  { token: 'nerja_daytrips_authority', label: copy.navLabel },
  { token: 'nerja_beaches_authority', label: copy.related.items[0].title },
  { token: 'nerja_food_authority', label: copy.related.items[1].title }
];

const dayTripGraphicByLang: Record<AmaraLanguage, DayTripRadiusGraphicData> = {
  en: {
    place: 'nerja', eyebrow: 'Day trips', destination: 'Nerja',
    region: 'Andalusia', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Map of four Andalusian day trips from Nerja with drive times',
    context: [
      { label: 'Destinations', value: 'Four day trips' },
      { label: 'Drive time', value: '50 min – 2 h' },
      { label: 'Our advice', value: 'One per day' }
    ]
  },
  de: {
    place: 'nerja', eyebrow: 'Tagesausflüge', destination: 'Nerja',
    region: 'Andalusien', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Karte mit vier andalusischen Tagesausflügen ab Nerja samt Fahrzeiten',
    context: [
      { label: 'Ziele', value: 'Vier Tagesausflüge' },
      { label: 'Fahrzeit', value: '50 Min. – 2 Std.' },
      { label: 'Empfehlung', value: 'Eins pro Tag' }
    ]
  },
  es: {
    place: 'nerja', eyebrow: 'Excursiones', destination: 'Nerja',
    region: 'Andalucía', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Mapa de cuatro excursiones andaluzas desde Nerja con tiempos de coche',
    context: [
      { label: 'Destinos', value: 'Cuatro excursiones' },
      { label: 'Trayecto', value: '50 min – 2 h' },
      { label: 'Consejo', value: 'Uno por día' }
    ]
  },
  nl: {
    place: 'nerja', eyebrow: 'Dagtochten', destination: 'Nerja',
    region: 'Andalusië', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Kaart met vier Andalusische dagtochten vanuit Nerja met rijtijden',
    context: [
      { label: 'Bestemmingen', value: 'Vier dagtochten' },
      { label: 'Rijtijd', value: '50 min – 2 u' },
      { label: 'Ons advies', value: 'Eén per dag' }
    ]
  },
  sv: {
    place: 'nerja', eyebrow: 'Dagsutflykter', destination: 'Nerja',
    region: 'Andalusien', baseLabel: 'NERJA', seaLabel: 'MEDITERRÁNEO',
    ariaLabel: 'Karta med fyra andalusiska dagsutflykter från Nerja med restider',
    context: [
      { label: 'Mål', value: 'Fyra dagsutflykter' },
      { label: 'Restid', value: '50 min – 2 h' },
      { label: 'Vårt råd', value: 'En per dag' }
    ]
  }
};
const dayTripGraphicData = dayTripGraphicByLang[currentLang];
---

<LocationAuthorityLayout seo={nerjaDayTripsSeo} pageLang={currentLang} footerHighlights={footerHighlights} pageFamily="experience-nerja-day-trips">
  <Navigation slot="navigation" contextDestination="nerja" currentLang={currentLang} languageToken="nerja_daytrips_authority" >
    <ExperienceContextNav slot="context-navigation" currentId="dayTrips" destination="nerja" lang={currentLang} />
  </Navigation>

  <div data-am-page="nerja-day-trips">
    <LocationExperienceHero
      {...hero}
      topic="day-trips"
      eyebrow={copy.hero.kicker}
      title={copy.hero.title}
      subtitle={copy.hero.subtitle}
      paragraphs={copy.hero.paragraphs}
    >
      <DayTripRadiusGraphic slot="visual" data={dayTripGraphicData} />
    </LocationExperienceHero>

    <AuthorityFeatureSection
      id="overview"
      title={copy.overview.title}
      intro={copy.overview.intro}
      items={copy.overview.items}
      emphasizeText
    />

    <DayTripDestinationList destinations={destinations} emphasizeText />

    <LocationPhotoGallery images={galleryImages} />

    <AuthorityFeatureSection
      id="practical"
      title={practical.title}
      intro={practical.intro}
      items={practical.items}
      emphasizeText
    />

    <ExperienceRelatedSection
      title={copy.related.title}
      items={copy.related.items}
      resolveHref={requiredLink}
    />

    <GuestGuideBridge lang={currentLang} destination="nerja" guideSlugs={['nerja-guest-adventure']} />

    <AuthorityStayBridge
      eyebrow={experienceStayBridge.eyebrow[currentLang]}
      title={copy.closing.title}
      reason={copy.closing.lead}
      stayHref={requiredLink('playa')}
      stayLabel={copy.closing.propertyLabel}
      availabilityHref={requiredLink('book')}
      availabilityLabel={experienceStayBridge.availabilityLabel[currentLang]}
    />
  </div>
</LocationAuthorityLayout>
