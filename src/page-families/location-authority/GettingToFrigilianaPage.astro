---
import Hero from '../../components/Hero.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialClosingCta from '../../components/editorial/EditorialClosingCta.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import HairlineStatCard from '../../components/location/HairlineStatCard.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  gettingToFrigilianaCopy,
  gettingToFrigilianaExternalLinks,
  gettingToFrigilianaSeo
} from '../../content/gettingToFrigilianaContent';
import {
  frigilianaPreFooterCopy,
  getFrigilianaPreFooterDescription
} from '../../content/frigilianaPreFooterContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { getFrigilianaAuthoritySubnav } from '../../lib/frigiliana/frigilianaAuthoritySubnav';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { buildOwnedLocalizedPath } from '../../lib/routeOwnership';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = gettingToFrigilianaCopy;

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const gettingHereHref = buildOwnedLocalizedPath('getting-to-frigiliana', currentLang);
const parkingHref = buildOwnedLocalizedPath('frigiliana-parking', currentLang);
const bookedArrivalHref = buildOwnedLocalizedPath('directions-arrival-guide', currentLang);

const sectionNavItems = getFrigilianaAuthoritySubnav(currentLang).map((item) =>
  item.id === 'arrival'
    ? {
        ...item,
        href: gettingHereHref,
        label: t(copy.nav.links[2].label)
      }
    : item
);

const navLinks = copy.nav.links.map((link) => ({
  token: link.token,
  label: t(link.label)
}));

const facts = copy.facts.items.map((item) => ({
  label: t(item.label),
  value: t(item.value),
  note: t(item.note)
}));

const optionLabels = {
  timing: t(copy.options.labels.timing),
  bestFor: t(copy.options.labels.bestFor),
  consideration: t(copy.options.labels.consideration)
};

const options = copy.options.items.map((item) => ({
  id: item.id,
  kicker: t(item.kicker),
  title: t(item.title),
  summary: t(item.summary),
  timing: t(item.timing),
  bestFor: t(item.bestFor),
  consideration: t(item.consideration)
}));

const publicTransportSteps = copy.publicTransport.steps.map((step) => ({
  num: step.num,
  headline: t(step.title),
  text: t(step.text)
}));

const faqItems = copy.publicTransport.faq.map((item) => ({
  question: t(item.question),
  answer: t(item.answer)
}));

const sourceLinks = copy.sources.links.map((source) => ({
  href:
    gettingToFrigilianaExternalLinks[
      source.key as keyof typeof gettingToFrigilianaExternalLinks
    ],
  label: t(source.label),
  text: t(source.text)
}));

const relatedLinks = copy.related.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, {
    suppressMissing: true
  });

  return href
    ? [{
        href,
        label: t(link.label),
        text: getFrigilianaPreFooterDescription(link.token, currentLang)
      }]
    : [];
});

const footerHighlights = [
  {
    token: 'getting_to_frigiliana',
    label: t(copy.nav.links[2].label)
  },
  {
    token: 'frigiliana_parking',
    label: t(copy.nav.links[1].label)
  },
  {
    token: 'romantic_hideaways',
    label: t(copy.closing.apartmentsCta)
  }
];

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/01-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};

const approachImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/03-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};
---

<LocationAuthorityLayout
  seo={gettingToFrigilianaSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    currentLang={currentLang}
    brandName={t(copy.nav.brand)}
    links={navLinks}
    languageToken="getting_to_frigiliana"
    locationAuthorityNav={true}
  />
  <LocationContextNav items={sectionNavItems} activeId="arrival" lang={currentLang} />

  <div data-am-page="getting-to-frigiliana">
    <div class="w-full">
      <Hero
        imageSrc={heroImage.src}
        imageAlt={t(copy.hero.imageAlt)}
        imageWidth={heroImage.width}
        imageHeight={heroImage.height}
      >
        <span class="am-text-caption text-primary mb-8 block">
          {t(copy.hero.eyebrow)}
        </span>
        <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
          {t(copy.hero.title)}
        </h1>
        <div class="pl-10 border-l border-primary/20 max-w-xl mb-14 space-y-6">
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.lead)}
          </p>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {t(copy.hero.body)}
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href="#arrival-options"
            class="am-btn am-btn--primary"
          >
            {t(copy.hero.primaryCta)}
          </a>
          <a
            href="#official-timetables"
            class="am-btn am-btn--secondary"
          >
            {t(copy.hero.secondaryCta)}
          </a>
        </div>
      </Hero>

      <section class="max-w-screen-2xl mx-auto px-12 pb-32">
        <div class="max-w-3xl mb-14">
          <h2 class="am-text-title italic text-on-surface tracking-tight">
            {t(copy.facts.title)}
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-14 gap-y-12">
          {
            facts.map((fact) => (
              <HairlineStatCard
                label={fact.label}
                value={fact.value}
                description={fact.note}
              />
            ))
          }
        </div>
      </section>

      <section
        id="arrival-options"
        class="bg-surface-container-low border-y border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-12 py-32">
          <div class="max-w-3xl mb-20">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.options.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
              {t(copy.options.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.options.intro)}
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-12 gap-y-16">
            {
              options.map((option, index) => (
                <article class="border-t border-outline-variant/25 pt-8">
                  <div class="flex items-baseline justify-between gap-6 mb-10">
                    <span class="am-text-caption uppercase tracking-[0.2em] text-primary">
                      {option.kicker}
                    </span>
                    <span
                      class="font-headline text-[clamp(2.5rem,5vw,4.75rem)] italic leading-none text-outline-variant/45"
                      aria-hidden="true"
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </div>
                  <h3 class="am-text-subtitle text-on-surface mb-6">{option.title}</h3>
                  <p class="am-text-body text-on-surface-variant leading-relaxed min-h-[7.5rem]">
                    {option.summary}
                  </p>
                  <dl class="mt-10 divide-y divide-outline-variant/10 border-y border-outline-variant/10">
                    <div class="py-6">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {optionLabels.timing}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {option.timing}
                      </dd>
                    </div>
                    <div class="py-6">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {optionLabels.bestFor}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {option.bestFor}
                      </dd>
                    </div>
                    <div class="py-6">
                      <dt class="am-text-caption uppercase tracking-[0.16em] text-primary mb-3">
                        {optionLabels.consideration}
                      </dt>
                      <dd class="am-text-body text-on-surface-variant leading-relaxed">
                        {option.consideration}
                      </dd>
                    </div>
                  </dl>
                  {
                    option.id === 'car' && (
                      <a href={parkingHref} class="am-cta-link inline-block mt-8">
                        {t(copy.reality.parkingCta)}
                      </a>
                    )
                  }
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <FaqAccordion
        arrivalTitle={t(copy.publicTransport.title)}
        steps={publicTransportSteps}
        faqTitle={t(copy.publicTransport.faqTitle)}
        items={faqItems}
      />

      <section class="bg-surface-container-low border-y border-outline-variant/5">
        <div class="max-w-screen-2xl mx-auto px-12 py-32">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
            <div class="am-mobile-full-bleed am-mobile-full-bleed--wide lg:col-span-6">
              <AmaraImage
                src={approachImage.src}
                alt={t(copy.reality.imageAlt)}
                profile="card"
                class="w-full aspect-[4/3] object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="lg:col-span-6 lg:pl-10">
              <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
                {t(copy.reality.eyebrow)}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
                {t(copy.reality.title)}
              </h2>
              <p class="am-text-body text-on-surface-variant leading-relaxed max-w-xl mb-10">
                {t(copy.reality.body)}
              </p>
              <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8">
                <a href={parkingHref} class="am-cta-link">
                  {t(copy.reality.parkingCta)}
                </a>
                <a href={bookedArrivalHref} class="am-cta-link">
                  {t(copy.reality.bookedCta)}
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="official-timetables" class="max-w-screen-2xl mx-auto px-12 py-32">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
          <div class="lg:col-span-4">
            <span class="am-text-caption uppercase tracking-[0.35em] text-primary block mb-6">
              {t(copy.sources.eyebrow)}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight mb-8">
              {t(copy.sources.title)}
            </h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed mb-6">
              {t(copy.sources.intro)}
            </p>
            <p class="am-text-caption uppercase tracking-[0.14em] text-on-surface-variant/70">
              {t(copy.sources.checked)}
            </p>
          </div>
          <div class="lg:col-span-8 border-t border-outline-variant/15">
            {
              sourceLinks.map((source) => (
                <a
                  href={source.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="am-card-link group grid grid-cols-[1fr_auto] gap-8 py-9 border-b border-outline-variant/15"
                >
                  <span>
                    <span class="am-text-subtitle text-on-surface block mb-3 group-hover:text-primary transition-colors">
                      {source.label}
                    </span>
                    <span class="am-text-body text-on-surface-variant leading-relaxed">
                      {source.text}
                    </span>
                  </span>
                  <span
                    class="am-text-subtitle text-primary transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <EditorialGuideLinkSection
        eyebrow={frigilianaPreFooterCopy.eyebrow[currentLang]}
        title={t(copy.related.title)}
        intro={frigilianaPreFooterCopy.intro[currentLang]}
        links={relatedLinks}
      />

      <section class="max-w-screen-2xl mx-auto px-12 pt-32">
        <EditorialClosingCta
          title={t(copy.closing.title)}
          lead={t(copy.closing.lead)}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: t(copy.closing.apartmentsCta),
              style: 'primary'
            },
            {
              token: 'direct_booking_benefits',
              label: t(copy.closing.directBookingCta),
              style: 'secondary'
            }
          ]}
        />
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  @media (max-width: 767px) {
    :global([data-am-page='getting-to-frigiliana'] .px-12) {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>
