---
// Tarifa Location Hub in the Tarifa art direction (DR-DESIGN-020), composed for every
// guest, not for kitesurfers: the town, the two coasts, the old town or La Marina,
// who Tarifa suits, the wind as one fact among others, the quiet season, the stay.
// The page shell carries `am-tarifa-surface`, the opening is the panorama hero,
// verified key figures follow, photographs run to the frame edge with copy panels
// over their edges. The page renders only photographs that exist; the image
// manifest still holds briefs for motifs to come (strait, evening), and the
// kite photograph stays only where wind is the topic.
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import AmaraKeyFigures from '../../components/content/AmaraKeyFigures.astro';
import AmaraMediaFrame from '../../components/media/AmaraMediaFrame.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import Navigation from '../../components/Navigation.astro';
import LocationPanoramaHero from '../../components/location/LocationPanoramaHero.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import IberiaOrientationMap from '../../components/location/IberiaOrientationMap.astro';
import { tarifaLocationContent } from '../../content/tarifaLocationContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import { requireRouteImage } from '../../lib/images/routeImages';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const hero = requireRouteImage('tarifa', 'hero', currentLang);
const walkImage = requireRouteImage('tarifa', 'walk', currentLang);
const castleImage = requireRouteImage('tarifa', 'castle', currentLang);
const stayImage = requireRouteImage('tarifa', 'stay', currentLang);
const oldTownImage = requireRouteImage('tarifa', 'old-town', currentLang);
const sunsetImage = requireRouteImage('tarifa', 'sunset', currentLang);
const content = tarifaLocationContent.locales[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa location hub');
const aboutHref = requiredLink('about');
const stayHref = requiredLink('tarifa');
const footerHighlights: LabeledLink[] = [
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_where_to_stay', label: content.areas.link?.label ?? 'Where to stay' },
  { token: 'tarifa_experience_hub', label: content.experience.links[0].label }
];
const byline = tarifaLocationContent.seo.article
  ? {
      lang: currentLang,
      authorName: tarifaLocationContent.seo.article.authorName,
      authorHref: aboutHref,
      updated: content.hero.updated,
      note: content.hero.note
    }
  : undefined;
---

<LocationAuthorityLayout
  pageFamily="location-tarifa-overview"
  seo={tarifaLocationContent.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="tarifa"
    currentLang={currentLang}
    languageToken={tarifaLocationContent.token}
  >
    <TarifaContextNav slot="context-navigation" activeId="overview" currentLabel="Tarifa" lang={currentLang} />
  </Navigation>

  <article class="am-tarifa-surface overflow-x-clip bg-surface" data-am-page="tarifa-location-hub" data-am-family="location" data-am-role="hub">
    <LocationPanoramaHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      subtitle={content.hero.subtitle}
      paragraphs={[content.hero.standfirst]}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      focalPoint={hero.focalPoint}
      role="hub"
      topic="overview"
    >
      {byline && <EditorialByline slot="meta" {...byline} />}
    </LocationPanoramaHero>

    <section class="bg-surface px-6 pb-16 pt-12 md:px-12 md:pb-20" aria-label={content.keyFigures.figures.map((figure) => figure.label).join(' · ')}>
      <div class="mx-auto max-w-screen-2xl">
        <AmaraKeyFigures figures={content.keyFigures.figures} note={content.keyFigures.note} />
      </div>
    </section>

    <!-- Where you are: the two coasts. Photo brief: Playa Chica and the causeway to the Isla. -->
    <section id="geography-orientation" class="am-section am-section--plain scroll-mt-28 py-24 md:py-32 lg:py-40">
      <div class="mx-auto grid max-w-screen-2xl items-center gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:order-1 lg:col-span-7" data-am-orientation-map="tarifa">
          <IberiaOrientationMap
            place="tarifa"
            label={content.geography.mapLabel}
            note={content.geography.mapNote}
            lang={currentLang}
          />
        </div>
        <div class="lg:order-2 lg:col-span-4 lg:col-start-9">
          <p class="am-text-eyebrow text-primary">{content.geography.eyebrow}</p>
          <h2 class="am-text-title mt-6 italic tracking-tight text-on-surface">{content.geography.title}</h2>
          <div class="mt-9 space-y-6">
            {content.geography.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
          <dl class="mt-10 border-t border-border-subtle">
            {content.geography.markers.map((marker) => (
              <div class="grid grid-cols-[0.75fr_1.25fr] gap-6 border-b border-border-subtle py-5">
                <dt class="am-text-label am-text-label--sm text-primary">{marker.label}</dt>
                <dd class="am-text-body text-on-surface">{marker.value}</dd>
              </div>
            ))}
          </dl>
          {content.geography.link?.token && (
            <div class="mt-9">
              <a href={requiredLink(content.geography.link.token)} class="am-cta-link">{content.geography.link.label}</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Arrival: on foot in town, by car to the western beaches. -->
    <section id="arrival-mobility" class="scroll-mt-28 bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
          <figure class="am-bleed-start lg:col-span-4">
            <AmaraImage src={oldTownImage.src} alt={oldTownImage.alt} profile="card" class="aspect-[4/5] h-full w-full object-cover" focalPoint={oldTownImage.focalPoint} />
          </figure>
          <div class="am-overlap-start bg-surface lg:col-span-8">
            <p class="am-text-eyebrow text-primary">{content.arrival.eyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.arrival.title}</h2>
            <div class="mt-6 max-w-3xl space-y-5">
              {content.arrival.paragraphs.slice(1).map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>
              ))}
            </div>
            {content.arrival.link?.token && (
              <a href={requiredLink(content.arrival.link.token)} class="am-cta-link mt-8 inline-flex">
                {content.arrival.link.label}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Where to stay: light, numbered, no band. -->
    <section id="where-to-stay" class="scroll-mt-28 bg-surface-white px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <p class="am-text-eyebrow text-primary">{content.areas.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-4xl text-balance text-on-surface">{content.areas.title}</h2>
        <p class="am-text-subtitle mt-6 max-w-2xl text-on-surface-variant">{content.areas.paragraphs[0]}</p>
        <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-12 xl:grid-cols-4">
          {content.areas.archetypes.map((archetype, index) => (
            <div>
              <span class="am-text-label am-text-label--wide text-primary">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="am-text-functional-heading mt-4 text-on-surface">{archetype.title}</h3>
              <p class="mt-3 text-on-surface-variant">{archetype.consequence}</p>
            </div>
          ))}
        </div>
        {content.areas.link?.token && (
          <a href={requiredLink(content.areas.link.token)} class="am-cta-link mt-12 inline-flex">{content.areas.link.label}</a>
        )}
      </div>
    </section>

    <!-- Wind and seasons: the one place the kite photograph belongs. -->
    <section id="weather-seasons" class="scroll-mt-28 bg-surface-white px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
          <div class="am-overlap-end bg-surface-white lg:col-span-5">
            <p class="am-text-eyebrow text-primary">{content.weather.eyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.weather.title}</h2>
            <div class="mt-6 max-w-2xl space-y-5">
              {content.weather.paragraphs.slice(0, 2).map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
            {content.weather.link && (
              <a href={requiredLink(content.weather.link.token!)} class="am-cta-link mt-8 inline-flex">{content.weather.link.label}</a>
            )}
          </div>
          <figure class="am-bleed-end lg:col-span-7">
            <AmaraImage src={walkImage.src} alt={walkImage.alt} profile="hero" class="aspect-[3/2] h-full w-full object-cover" focalPoint={walkImage.focalPoint} />
            <figcaption class="am-text-caption mt-3 normal-case tracking-normal text-muted">{walkImage.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- From September: the serif quote reaches into the photo column, the portrait hangs into the next section. -->
    <section id="from-september" class="scroll-mt-28 bg-surface px-6 pt-20 md:px-12 md:pt-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16">
          <div class="lg:col-span-7 lg:pt-8">
            <p class="am-text-eyebrow text-primary">{content.winter.eyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.winter.title}</h2>
            <p class="am-text-quote am-overlap-end--text mt-8 bg-surface text-balance text-on-surface">{content.winter.paragraphs[1]}</p>
            <div class="mt-8 max-w-2xl space-y-5">
              {[content.winter.paragraphs[0], content.winter.paragraphs[2]].map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>
              ))}
            </div>
          </div>
          <figure class="am-bleed-end am-hang lg:col-span-5 lg:self-end">
            <AmaraImage src={castleImage.src} alt={castleImage.alt} profile="card" class="aspect-[4/5] h-full w-full object-cover" focalPoint={castleImage.focalPoint} />
            <figcaption class="am-text-caption mt-3 normal-case tracking-normal text-muted lg:hidden">{castleImage.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- The stay: the photograph runs to the start edge, facts as a white panel over its edge. -->
    <section id="amara-family-surf" class="scroll-mt-28 bg-surface-white px-6 pb-20 pt-24 md:px-12 md:pb-28 lg:pt-36">
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
          <figure class="am-bleed-start lg:col-span-6">
            <AmaraImage src={stayImage.src} alt={stayImage.alt} profile="hero" class="aspect-[4/3] h-full w-full object-cover" focalPoint={stayImage.focalPoint} />
          </figure>
          <div class="am-overlap-start bg-surface-white lg:col-span-6">
            <p class="am-text-eyebrow text-primary">{content.amara.eyebrow}</p>
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.amara.title}</h2>
            <div class="mt-6 max-w-2xl space-y-5">
              {content.amara.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>
              ))}
            </div>
            <ul class="mt-8 grid gap-3">
              {content.amara.facts.map((fact) => (
                <li class="relative pl-5 text-on-surface before:absolute before:left-0 before:top-[0.75em] before:h-px before:w-2 before:bg-primary before:content-['']">{fact}</li>
              ))}
            </ul>
            {content.amara.link && (
              <a href={stayHref} class="am-btn am-btn--primary mt-10">{content.amara.link.label}</a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Close: evening panorama, the sand panel with the closing line rises into it. -->
    <section id="experiences" class="scroll-mt-28 bg-surface">
      <AmaraMediaFrame role="panorama">
        <AmaraImage src={sunsetImage.src} alt={sunsetImage.alt} profile="background" class="h-full w-full object-cover" focalPoint={sunsetImage.focalPoint} />
      </AmaraMediaFrame>
      <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
        <div class="am-overlap-up bg-surface py-12">
          <p class="am-text-eyebrow text-primary">{content.experience.eyebrow}</p>
          {content.closing ? (
            <>
              <p class="am-text-quote mt-5 max-w-3xl text-balance text-on-surface">{content.closing.title}</p>
              <p class="am-text-subtitle mt-5 max-w-2xl text-on-surface-variant">{content.closing.lead}</p>
            </>
          ) : (
            <h2 class="am-text-title mt-5 text-balance text-on-surface">{content.experience.title}</h2>
          )}
          <div class="mt-5 max-w-2xl">
            {content.experience.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
            {content.experience.links.map((link) => (
              <a href={requiredLink(link.token!)} class="am-cta-link">{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
