---
interface GuideLinkCard {
  title: string;
  text: string;
  href: string | null;
  linkLabel: string;
}

interface Props {
  title: string;
  intro: string;
  items: readonly GuideLinkCard[];
  surface?: 'plain' | 'tint' | 'surface';
}

const { title, intro, items, surface = 'plain' } = Astro.props;
const surfaceClass = surface === 'tint'
  ? 'am-section--tint'
  : surface === 'surface'
    ? 'bg-surface'
    : 'am-section--plain';
---

<section class:list={['am-section', surfaceClass]}>
  <div class="mb-16 max-w-3xl">
    <h2 class="am-text-title mb-6 italic tracking-tight text-on-surface">{title}</h2>
    <p class="am-text-body leading-relaxed text-on-surface-variant">{intro}</p>
  </div>

  <div class="grid grid-cols-1 gap-x-16 gap-y-14 lg:grid-cols-2">
    {items.map((item) => (
      <article class="border-t border-outline-variant/25 pt-8">
        <h3 class="am-text-subtitle mb-5 text-on-surface">{item.title}</h3>
        <p class="am-text-body leading-relaxed text-on-surface-variant">{item.text}</p>
        {item.href && (
          <p class="mt-5 am-text-body">
            <a href={item.href} class="am-inline-link">
              {item.linkLabel}<span aria-hidden="true"> →</span>
            </a>
          </p>
        )}
      </article>
    ))}
  </div>
</section>
