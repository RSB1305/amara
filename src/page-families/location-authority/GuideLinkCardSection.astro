---
import { getAmaraContentModuleAttributes } from '../../components/content/moduleContract';
import AmaraSectionIntro from '../../components/layout/AmaraSectionIntro.astro';

interface GuideLinkCard {
  title: string;
  text: string;
  href: string | null;
  linkLabel: string;
}

interface Props {
  title: string;
  intro: string;
  items: readonly GuideLinkCard[];
  surface?: 'plain' | 'tint' | 'surface';
  columns?: 2 | 3;
  headerLinkNote?: {
    before: string;
    href: string | null;
    label: string;
    after: string;
  };
}

const {
  title,
  intro,
  items,
  surface = 'plain',
  columns = 2,
  headerLinkNote
} = Astro.props;
const surfaceClass = surface === 'tint'
  ? 'am-section--tint'
  : surface === 'surface'
    ? 'bg-surface'
    : 'am-section--plain';
const gridClass = columns === 3
  ? 'grid-cols-1 gap-x-12 gap-y-14 lg:grid-cols-3'
  : 'grid-cols-1 gap-x-16 gap-y-14 lg:grid-cols-2';
const moduleAttributes = getAmaraContentModuleAttributes({
  job: 'guide-link-grid',
  status: 'family',
  family: 'location'
});
---

<section {...moduleAttributes} class:list={['am-section', surfaceClass]}>
  <AmaraSectionIntro title={title} intro={intro} variant="editorial">
    {headerLinkNote?.href && (
      <p class="am-text-body leading-relaxed text-on-surface-variant">
        {headerLinkNote.before}<a href={headerLinkNote.href} class="am-inline-link">
          {headerLinkNote.label}
        </a>{headerLinkNote.after}
      </p>
    )}
  </AmaraSectionIntro>

  <div class:list={['grid', gridClass]}>
    {items.map((item) => (
      <article class="border-t border-outline-variant/25 pt-8">
        <h3 class="am-text-subtitle mb-5 text-on-surface">{item.title}</h3>
        <p class="am-text-body leading-relaxed text-on-surface-variant">{item.text}</p>
        {item.href && (
          <p class="mt-5 am-text-body">
            <a href={item.href} class="am-inline-link">
              {item.linkLabel}<span aria-hidden="true"> →</span>
            </a>
          </p>
        )}
      </article>
    ))}
  </div>
</section>
