---
import type { LinkToken, RequiredLinkResolver } from '../../lib/linkResolver';

/**
 * The inverse-surface related-link block that closes the body of an authority
 * article. Destinations stay registry tokens: the page hands in its own bound
 * required-link resolver, so a missing link still fails the build with that
 * page's context.
 */

interface RelatedLink {
  token: LinkToken;
  label: string;
  text: string;
}

interface Props {
  related: {
    eyebrow: string;
    title: string;
    links: RelatedLink[];
  };
  /** The column count this page delivers for its related grid. */
  columns: 'md:grid-cols-2' | 'md:grid-cols-3';
  resolveHref: RequiredLinkResolver;
  presentation?: 'article' | 'guide';
}

const { related, columns, resolveHref, presentation = 'article' } = Astro.props;
---

<section class="bg-inverse-surface px-6 py-20 text-inverted-on-surface md:px-12 md:py-28">
  <div class="mx-auto max-w-screen-2xl">
    <p class="am-text-eyebrow text-primary-fixed-dim">{related.eyebrow}</p>
    <h2
      class:list={[
        'am-text-title mt-5 max-w-3xl text-balance text-inverted-on-surface',
        presentation === 'guide' && 'italic'
      ]}
    >
      {related.title}
    </h2>
    <div class:list={['mt-12 grid gap-x-10', columns]}>
      {related.links.map((link) => (
        <a
          href={resolveHref(link.token)}
          class="group border-t border-inverted-on-surface/20 py-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-fixed-dim/40"
        >
          <span class="am-text-subtitle block text-inverted-on-surface transition-colors group-hover:text-primary-fixed-dim">{link.label}</span>
          <span class="am-text-body mt-3 block leading-relaxed text-inverted-on-surface/70">{link.text}</span>
        </a>
      ))}
    </div>
  </div>
</section>
