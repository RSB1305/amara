---
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import LocationGuideIcon, {
  type LocationGuideIconName
} from '../../components/location/LocationGuideIcon.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import {
  frigilianaDailyLifeContent,
  frigilianaDailyLifeSeo
} from '../../content/frigilianaDailyLifeContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthoritySectionCardGrid from './AuthoritySectionCardGrid.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = frigilianaDailyLifeContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana daily life');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_frigiliana');
const comparisonHref = requiredLink('nerja_vs_frigiliana');
const footerHighlights: LabeledLink[] = [
  { token: 'frigiliana_daily_life', label: content.navLabel },
  { token: 'frigiliana_market', label: content.related.links[0].label },
  { token: 'getting_to_frigiliana', label: content.related.links[2].label }
];
const [
  shoppingSection,
  largerShopSection,
  healthSection,
  openingHoursSection,
  carFreeSection,
  longerStaySection,
  comparisonSection,
  amaraSection
] = content.sections;
const serviceSections = [largerShopSection, healthSection, openingHoursSection];
const serviceIcons: LocationGuideIconName[] = ['supermarket', 'pharmacy', 'opening-hours'];
---

<LocationAuthorityLayout
  seo={frigilianaDailyLifeSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_daily_life"
  />
  <LocationContextNav activeId="dailyLife" lang={currentLang} />

  <AuthorityArticle
    pageId="frigiliana-daily-life"
    family="location"
    topic="daily-life"
    lang={currentLang}
    hero={content.hero}
    authorName={frigilianaDailyLifeSeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    factIcons={['local-shops', 'bakery', 'supermarket', 'walkable']}
    sources={content.sources}
    closing={content.closing}
    presentation="guide"
    guideVisual={{
      eyebrow: content.facts[0].label,
      mark: '50–300 m',
      note: content.facts[3].value
    }}
    primaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    secondaryCta={{ href: comparisonHref, label: content.closing.comparisonLabel }}
  >
    <AuthorityTextSection
      section={shoppingSection}
      index={0}
      presentation="guide"
      data-am-daily-life-section={shoppingSection.id}
    />

    <AuthoritySectionCardGrid
      sections={serviceSections}
      icons={serviceIcons}
      sectionDataAttribute="data-am-daily-life-section"
    />

    <div class="border-b border-border-subtle bg-inverse-surface px-6 py-20 text-inverted-on-surface md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:gap-20">
        <article
          id={carFreeSection.id}
          class="min-w-0 scroll-mt-32 lg:col-span-7"
          data-am-daily-life-section={carFreeSection.id}
          data-am-daily-life-layout="mobility"
        >
          <div class="flex items-center gap-3 text-primary-fixed-dim">
            <LocationGuideIcon name="walkable" class="h-6 w-6 !text-primary-fixed-dim" />
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em]">
              {carFreeSection.eyebrow}
            </p>
          </div>
          <h2 class="am-text-title mt-6 min-w-0 max-w-3xl text-balance hyphens-auto italic text-inverted-on-surface [overflow-wrap:anywhere]">
            {carFreeSection.title}
          </h2>
          <div class="mt-8 max-w-3xl space-y-5">
            {carFreeSection.paragraphs.map((paragraph) => (
              <p class="am-text-body min-w-0 hyphens-auto leading-relaxed text-inverted-on-surface/75 [overflow-wrap:anywhere]">
                <InlineEmphasis text={paragraph} />
              </p>
            ))}
          </div>
        </article>

        <article
          id={longerStaySection.id}
          class="min-w-0 scroll-mt-32 border-t border-inverted-on-surface/20 pt-8 lg:col-span-5 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0"
          data-am-daily-life-section={longerStaySection.id}
          data-am-daily-life-layout="longer-stay"
        >
          <div class="flex items-center gap-3 text-primary-fixed-dim">
            <LocationGuideIcon name="longer-stay" class="!text-primary-fixed-dim" />
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em]">
              {longerStaySection.eyebrow}
            </p>
          </div>
          <h2 class="am-text-subtitle mt-6 min-w-0 max-w-lg text-balance hyphens-auto text-inverted-on-surface [overflow-wrap:anywhere]">
            {longerStaySection.title}
          </h2>
          <div class="mt-7 space-y-5">
            {longerStaySection.paragraphs.map((paragraph) => (
              <p class="am-text-body min-w-0 hyphens-auto leading-relaxed text-inverted-on-surface/75 [overflow-wrap:anywhere]">
                <InlineEmphasis text={paragraph} />
              </p>
            ))}
          </div>
        </article>
      </div>
    </div>

    <article
      id={comparisonSection.id}
      class="min-w-0 scroll-mt-32 border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28"
      data-am-daily-life-section={comparisonSection.id}
      data-am-daily-life-layout="comparison"
    >
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:items-center lg:gap-20">
        <div class="lg:col-span-5">
          <div class="flex items-center gap-3 text-primary">
            <LocationGuideIcon name="comparison" class="h-6 w-6" />
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em]">
              {comparisonSection.eyebrow}
            </p>
          </div>
          <h2 class="am-text-title mt-6 min-w-0 max-w-2xl text-balance hyphens-auto italic text-on-surface [overflow-wrap:anywhere]">
            {comparisonSection.title}
          </h2>
        </div>
        <div class="border-t border-primary/30 pt-8 lg:col-span-7 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
          {comparisonSection.paragraphs.map((paragraph) => (
            <p class="am-text-subtitle min-w-0 max-w-3xl hyphens-auto leading-relaxed text-on-surface-variant [overflow-wrap:anywhere]">
              <InlineEmphasis text={paragraph} />
            </p>
          ))}
        </div>
      </div>
    </article>

    <AuthorityTextSection
      section={amaraSection}
      index={1}
      presentation="guide"
      data-am-daily-life-section={amaraSection.id}
    />

    <FaqAccordion
      arrivalTitle={content.decisions.title}
      steps={content.decisions.steps}
      faqTitle={content.faq.title}
      items={content.faq.items}
      anchorFaqId="daily-life-faq"
    />

    <AuthorityRelatedLinks
      related={content.related}
      columns="md:grid-cols-2"
      resolveHref={requiredLink}
      presentation="guide"
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
