---
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaDailyLifeContent,
  frigilianaDailyLifeSeo
} from '../../content/frigilianaDailyLifeContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = frigilianaDailyLifeContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana daily life');

const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_frigiliana');
const comparisonHref = requiredLink('nerja_vs_frigiliana');
const footerHighlights: LabeledLink[] = [
  { token: 'frigiliana_daily_life', label: content.navLabel },
  { token: 'frigiliana_market', label: content.related.links[0].label },
  { token: 'getting_to_frigiliana', label: content.related.links[2].label }
];
---

<LocationAuthorityLayout
  seo={frigilianaDailyLifeSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="frigiliana_daily_life"
  />
  <LocationContextNav activeId="dailyLife" lang={currentLang} />

  <AuthorityArticle
    pageId="frigiliana-daily-life"
    lang={currentLang}
    hero={content.hero}
    authorName={frigilianaDailyLifeSeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    factIcons={['local-shops', 'bakery', 'supermarket', 'walkable']}
    sources={content.sources}
    closing={content.closing}
    presentation="guide"
    guideVisual={{
      eyebrow: content.facts[0].label,
      mark: '50–300 m',
      note: content.facts[3].value
    }}
    primaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    secondaryCta={{ href: comparisonHref, label: content.closing.comparisonLabel }}
  >
    {content.sections.map((section, index) => (
      <AuthorityTextSection
        section={section}
        index={index}
        presentation="guide"
        data-am-daily-life-section={section.id}
      />
    ))}

    <FaqAccordion
      arrivalTitle={content.decisions.title}
      steps={content.decisions.steps}
      faqTitle={content.faq.title}
      items={content.faq.items}
      anchorFaqId="daily-life-faq"
    />

    <AuthorityRelatedLinks
      related={content.related}
      columns="md:grid-cols-2"
      resolveHref={requiredLink}
      presentation="guide"
    />
  </AuthorityArticle>
</LocationAuthorityLayout>
