---
import AmaraMetaChip from '../../components/chips/AmaraMetaChip.astro';
import EditorialCallout from '../../components/content/EditorialCallout.astro';
import LocationGuideIcon, {
  type LocationGuideIconName
} from '../../components/location/LocationGuideIcon.astro';

interface Props {
  duration?: string;
  elevationGain?: string;
  distance?: string;
  difficulty?: string;
  experience: string;
  labels: {
    statsAriaLabel: string;
    duration: string;
    elevationGain: string;
    distance: string;
    difficulty: string;
    experience: string;
  };
}

const {
  duration,
  elevationGain,
  distance,
  difficulty,
  experience,
  labels
} = Astro.props;

const stats = [
  duration && { label: labels.duration, value: duration, icon: 'journey-time' as LocationGuideIconName },
  elevationGain && {
    label: labels.elevationGain,
    value: elevationGain,
    icon: 'elevation' as LocationGuideIconName
  },
  distance && { label: labels.distance, value: distance, icon: 'distance' as LocationGuideIconName }
].filter(Boolean);

const hasStats = stats.length > 0 || Boolean(difficulty);
---

<div>
  {
    hasStats ? (
      <div
        class="flex flex-wrap items-center gap-x-5 gap-y-3 lg:min-h-6"
        aria-label={labels.statsAriaLabel}
      >
        {stats.map((stat) => {
          if (!stat) return null;
          return (
            <span
              class="inline-flex items-center gap-2 whitespace-nowrap"
              aria-label={`${stat.label}: ${stat.value}`}
            >
              <LocationGuideIcon name={stat.icon} class="h-4 w-4" />
              <span class="am-text-caption normal-case tracking-normal text-on-surface">
                {stat.value}
              </span>
            </span>
          );
        })}

        {difficulty && (
          <AmaraMetaChip
            tone="accent"
            aria-label={`${labels.difficulty}: ${difficulty}`}
          >
            {difficulty}
          </AmaraMetaChip>
        )}
      </div>
    ) : (
      <div class="hidden lg:block lg:min-h-6" aria-hidden="true" />
    )
  }

  <EditorialCallout
    class={`lg:min-h-28 ${hasStats ? 'mt-5' : 'lg:mt-5'}`}
  >
    <span class="font-bold text-primary">{labels.experience}:</span> {experience}
  </EditorialCallout>
</div>
