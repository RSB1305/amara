---
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import Navigation from '../../components/Navigation.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import GuideClosingSection from './GuideClosingSection.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import ExperiencePreFooter from '../../components/experience/ExperiencePreFooter.astro';
import {
  frigilianaWellnessContent,
  frigilianaWellnessSeo
} from '../../content/frigilianaWellnessContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityFeatureSection from './AuthorityFeatureSection.astro';
import GuideLinkCardSection from './GuideLinkCardSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaWellnessContent[currentLang];

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_wellness_authority',
    label: copy.footerHighlights.wellness
  },
  {
    token: 'frigiliana_food_authority',
    label: copy.footerHighlights.restaurants
  },
  {
    token: 'frigiliana_hiking_authority',
    label: copy.footerHighlights.hiking
  }
];

const combineItems = copy.combine.items.map((item) => ({
  ...item,
  href: resolveOptionalLink(item.linkToken, currentLang, {
    suppressMissing: true
  })
}));

const heroImage = {
  src: '/images/wellness/frigiliana-wellness-2.jpeg',
  width: 1512
};

const providerImages = {
  frigilianaWellness: '/images/wellness/frigiliana-wellness-1.jpeg',
  lidia: '/images/wellness/masaje_californiano-1.webp'
} as const;
---

<LocationAuthorityLayout
  seo={frigilianaWellnessSeo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily="experience-wellness"
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_wellness_authority"
  >
    <ExperienceContextNav slot="context-navigation" currentId="wellness" lang={currentLang} />
  </Navigation>

  <div data-am-page="frigiliana-wellness">
    <div class="w-full">
      <LocationExperienceHero
        topic="wellness"
        eyebrow={copy.hero.kicker}
        title={copy.hero.title}
        paragraphs={copy.hero.paragraphs}
        imageSrc={heroImage.src}
        imageAlt={copy.hero.imageAlt}
        imageWidth={heroImage.width}
      />

      <AuthorityFeatureSection
        id="choose"
        title={copy.overview.title}
        intro={copy.overview.intro}
        items={copy.overview.items}
        reviewed={copy.overview.reviewed}
      />

      <section
        id="providers"
        class="am-section am-section--plain"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.providers.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.providers.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-16">
          {
            copy.providers.items.map((provider) => {
              const titleId = `provider-${provider.id}`;
              const imageSrc = providerImages[provider.id];

              return (
                <article
                  class="border-t border-outline-variant/25 pt-8 flex h-full flex-col"
                  aria-labelledby={titleId}
                >
                  {
                    imageSrc && provider.imageAlt && (
                      <div class="mb-8 overflow-hidden bg-surface-container-low">
                        <AmaraImage
                          src={imageSrc}
                          alt={provider.imageAlt}
                          profile="card"
                          width={720}
                          widths={[360, 480, 720]}
                          sizes="(max-width: 1023px) calc(100vw - 3rem), 42vw"
                          class="aspect-[4/3] h-full w-full object-cover"
                        />
                      </div>
                    )
                  }
                  <p class="am-text-caption text-primary mb-3">
                    {provider.name}
                  </p>
                  <h3
                    id={titleId}
                    class="am-text-subtitle text-on-surface mb-5 lg:min-h-[2.3em]"
                  >
                    {provider.title}
                  </h3>

                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {provider.summary}
                  </p>

                  <div class="mt-8 space-y-7">
                    {provider.highlights.map((highlight) => (
                      <div class="border-l border-primary/20 pl-5">
                        <h4 class="am-text-body font-bold text-on-surface mb-2">
                          {highlight.title}
                        </h4>
                        <p class="am-text-body text-on-surface-variant leading-relaxed">
                          {highlight.text}
                        </p>
                      </div>
                    ))}
                  </div>

                  <p class="mt-8 border-l border-primary/20 bg-surface-container-low px-4 py-3 am-text-body leading-relaxed text-on-surface-variant">
                    <span class="font-bold text-primary">
                      {copy.cardLabels.bestFor}:
                    </span>{' '}
                    {provider.bestFor}
                  </p>

                  <div class="mt-8 lg:mt-auto lg:pt-8 flex flex-col sm:flex-row flex-wrap gap-3">
                    <a
                      href={provider.websiteHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="am-btn am-btn--primary w-full justify-center sm:w-auto"
                    >
                      {copy.cardLabels.website}
                    </a>
                    <a
                      href={provider.whatsappHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="am-btn am-btn--secondary w-full justify-center sm:w-auto"
                    >
                      {copy.cardLabels.whatsapp}
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section
        id="compare"
        class="am-section am-section--tint"
      >
        <div class="max-w-3xl mb-16">
          <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
            {copy.comparison.title}
          </h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed">
            {copy.comparison.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14">
          {
            copy.comparison.items.map((item) => (
              <article class="border-t border-outline-variant/25 pt-8">
                <h3 class="am-text-subtitle text-on-surface mb-7">
                  {item.name}
                </h3>
                <dl class="space-y-6">
                  <div>
                    <dt class="am-text-caption text-primary mb-2">
                      {copy.comparison.labels.mood}
                    </dt>
                    <dd class="am-text-body text-on-surface-variant leading-relaxed">
                      {item.mood}
                    </dd>
                  </div>
                  <div>
                    <dt class="am-text-caption text-primary mb-2">
                      {copy.comparison.labels.logistics}
                    </dt>
                    <dd class="am-text-body text-on-surface-variant leading-relaxed">
                      {item.logistics}
                    </dd>
                  </div>
                  <div>
                    <dt class="am-text-caption text-primary mb-2">
                      {copy.comparison.labels.ideal}
                    </dt>
                    <dd class="am-text-body text-on-surface-variant leading-relaxed">
                      {item.ideal}
                    </dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>

        <p class="mt-12 border-l border-primary/20 bg-surface-container-lowest px-4 py-3 am-text-body leading-relaxed text-on-surface-variant max-w-3xl">
          {copy.comparison.tip}
        </p>
      </section>

      <AuthorityFeatureSection
        id="planning"
        title={copy.planning.title}
        intro={copy.planning.intro}
        items={copy.planning.items}
        surface="plain"
        footerCallout={{ text: copy.planning.note }}
      />

      <GuideLinkCardSection
        title={copy.combine.title}
        intro={copy.combine.intro}
        items={combineItems}
        surface="tint"
      />

      <ExperiencePreFooter currentId="wellness" lang={currentLang} />

      <GuideClosingSection
          title={copy.closing.title}
          lead={copy.closing.lead}
          lang={currentLang}
          links={[
            {
              token: 'romantic_hideaways',
              label: copy.closing.apartmentsCta,
              style: 'text'
            },
            {
              token: 'book',
              label: copy.closing.availabilityCta,
              style: 'text'
            }
          ]}
          role="next-action"
          family="experience"
      />
    </div>
  </div>
</LocationAuthorityLayout>
