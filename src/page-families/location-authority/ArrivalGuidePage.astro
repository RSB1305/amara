---
import AmaraImage from '../../components/AmaraImage.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialGuideLinkSection from '../../components/editorial/EditorialGuideLinkSection.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import LocationGuideIcon from '../../components/location/LocationGuideIcon.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import {
  getArrivalGuideContent,
  type ArrivalGuideDestination
} from '../../content/destinationArrivalGuideContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';
import LocationModule from './LocationModule.astro';

/**
 * The single page-family template for destination arrival guides.
 *
 * Destination adapters select only a content record. Module order, visual
 * hierarchy and responsive behavior are owned here and therefore change once
 * for Frigiliana, Nerja and Tarifa together.
 */
interface Props {
  destination: ArrivalGuideDestination;
  lang?: string;
}

const { destination, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = getArrivalGuideContent(destination, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, `${destination} arrival guide`);

const authorHref = content.author ? requiredLink(content.author.token) : undefined;
const primaryCta = {
  href: requiredLink(content.closing.primary.token),
  label: content.closing.primary.label
};
const secondaryCta = {
  href: requiredLink(content.closing.secondary.token),
  label: content.closing.secondary.label
};

const finalMileLinks = content.finalMile?.links?.map((link) => ({
  href: requiredLink(link.token),
  label: link.label
})) ?? [];

const relatedLinks = content.related?.links.flatMap((link) => {
  const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
  return href ? [{ href, label: link.label, text: link.text ?? '' }] : [];
}) ?? [];

const optionGridClass = content.options.items.length === 2
  ? 'lg:grid-cols-2'
  : 'lg:grid-cols-3';
const gatewayGridClass = content.gateways?.items.length === 1
  ? 'lg:grid-cols-1'
  : 'lg:grid-cols-2';
const mobilityGridClass = content.mobility?.items.length === 2
  ? 'lg:grid-cols-2'
  : 'lg:grid-cols-3';
const isAuthorityReference = destination === 'frigiliana';
---

<LocationAuthorityLayout
  seo={content.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={content.footerHighlights}
  pageFamily="location-arrival"
>
  <Navigation
    slot="navigation"
    contextDestination={destination}
    currentLang={currentLang}
    languageToken={content.languageToken}
  >
    {
      destination === 'frigiliana' ? (
        <LocationContextNav slot="context-navigation" activeId="arrival" lang={currentLang} />
      ) : destination === 'nerja' ? (
        <NerjaContextNav
          slot="context-navigation"
          activeId="arrival-mobility"
          childLabel={content.navLabel}
          lang={currentLang}
        />
      ) : (
        <TarifaContextNav
          slot="context-navigation"
          activeId="overview"
          activeChildId="arrival-mobility"
          currentLabel="Tarifa"
          childLabel={content.navLabel}
          lang={currentLang}
        />
      )
    }
  </Navigation>

  <AuthorityArticle
    pageId={content.pageId}
    family="location"
    topic="arrival"
    lang={currentLang}
    hero={content.hero}
    authorName={content.author?.name}
    authorHref={authorHref}
    factsTitle={content.factsTitle}
    facts={content.facts}
    factIcons={content.factIcons}
    sources={content.sources}
    closing={content.closing}
    primaryCta={primaryCta}
    secondaryCta={secondaryCta}
    presentation="guide"
    arrivalVisual={content.heroVisual}
    closingRole="next-action"
    closingActionMode="restrained"
  >
    {
      content.gateways && (
        <LocationModule
          spacing={isAuthorityReference ? 'compact' : 'standard'}
          data-am-arrival-module="gateways"
        >
          <div class="mx-auto max-w-screen-2xl">
            <header class:list={['max-w-4xl', isAuthorityReference ? 'mb-10 md:mb-12' : 'mb-12 md:mb-16']}>
              <p class="am-text-eyebrow text-primary">
                {content.gateways.eyebrow}
              </p>
              <h2 class="am-text-title mt-5 text-balance italic text-on-surface">
                {content.gateways.title}
              </h2>
              {content.gateways.intro && (
                <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={content.gateways.intro} />
                </p>
              )}
            </header>

            <div class:list={['grid border-y border-border-subtle', gatewayGridClass]}>
              {content.gateways.items.map((item, index) => (
                <article
                  class:list={[
                    isAuthorityReference ? 'p-6 md:p-8 lg:p-10' : 'p-7 md:p-10 lg:p-12',
                    index > 0 && 'border-t border-border-subtle lg:border-l lg:border-t-0'
                  ]}
                >
                  <div class="flex items-center justify-between gap-6">
                    <LocationGuideIcon name={item.icon} class="h-6 w-6" />
                    <span class="am-text-subtitle italic text-primary/65">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </div>
                  <p class="mt-8 text-primary am-text-label am-text-label--sm am-text-label--wide">
                    {item.eyebrow}
                  </p>
                  <h3 class:list={[isAuthorityReference ? 'am-text-subtitle' : 'am-text-title', 'mt-4 text-balance text-on-surface']}>{item.title}</h3>
                  <p class:list={['am-text-body max-w-2xl leading-relaxed text-on-surface-variant', isAuthorityReference ? 'mt-5' : 'mt-7']}>
                    <InlineEmphasis text={item.summary} />
                  </p>
                  {item.details.map((detail) => (
                    <p class:list={['am-text-body border-t border-border-subtle leading-relaxed text-on-surface-variant', isAuthorityReference ? 'mt-5 pt-5' : 'mt-6 pt-6']}>
                      <InlineEmphasis text={detail} />
                    </p>
                  ))}
                </article>
              ))}
            </div>
          </div>
        </LocationModule>
      )
    }

    <LocationModule
      surface="tint"
      data-am-arrival-module="options"
    >
      <div class="mx-auto max-w-screen-2xl">
        <header class:list={['grid gap-8 lg:grid-cols-12 lg:items-end', isAuthorityReference ? 'mb-10 md:mb-12' : 'mb-12 md:mb-16']}>
          <div class="lg:col-span-7">
            <p class="am-text-eyebrow text-primary">
              {content.options.eyebrow}
            </p>
            <h2 class="am-text-title mt-5 text-balance italic text-on-surface">
              {content.options.title}
            </h2>
          </div>
          {content.options.intro && (
            <div class="max-w-2xl lg:col-span-5">
              <p class="am-text-body leading-relaxed text-on-surface-variant">
                <InlineEmphasis text={content.options.intro} />
              </p>
            </div>
          )}
        </header>

        <div class:list={[
          'grid gap-px overflow-hidden bg-border-subtle',
          isAuthorityReference && 'am-arrival-options-grid',
          !isAuthorityReference && 'border border-border-subtle',
          optionGridClass
        ]}>
          {content.options.items.map((item, index) => (
            <article class:list={[
              'min-w-0 bg-surface',
              isAuthorityReference ? 'am-arrival-option-card p-6 md:p-8 lg:p-10' : 'flex flex-col p-7 md:p-10 lg:p-12',
              isAuthorityReference && index === 0 && 'am-arrival-option-card--recommended'
            ]}>
              <div class="flex items-center justify-between gap-6">
                <LocationGuideIcon name={item.icon} class={isAuthorityReference ? 'h-8 w-8' : 'h-6 w-6'} />
                {isAuthorityReference && index === 0 && content.options.recommendationLabel && (
                  <span class="am-arrival-recommendation am-text-label am-text-label--sm">
                    {content.options.recommendationLabel}
                  </span>
                )}
                <span class="am-text-subtitle ml-auto italic text-primary/65">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <p class="mt-8 text-primary am-text-label am-text-label--sm am-text-label--wide">
                {item.eyebrow}
              </p>
              <h3 class:list={[isAuthorityReference ? 'am-text-subtitle' : 'am-text-title', 'mt-4 text-balance text-on-surface']}>{item.title}</h3>
              <p class:list={['am-text-body leading-relaxed text-on-surface-variant', isAuthorityReference ? 'mt-5' : 'mt-7']}>
                {isAuthorityReference ? (
                  <strong class="font-bold text-on-surface"><InlineEmphasis text={item.summary} /></strong>
                ) : (
                  <InlineEmphasis text={item.summary} />
                )}
              </p>

              {item.details.map((detail) => (
                <p class:list={['am-text-body border-t border-border-subtle leading-relaxed text-on-surface-variant', isAuthorityReference ? 'mt-5 pt-5' : 'mt-6 pt-6']}>
                  <InlineEmphasis text={detail} />
                </p>
              ))}

              {(item.timing || item.bestFor || item.consideration) && (
                <dl class:list={[
                  'border-t border-border-subtle',
                  isAuthorityReference ? 'am-arrival-option-details mt-6' : 'mt-8'
                ]}>
                  {item.timing && (
                    <div class:list={[!isAuthorityReference && 'border-b border-border-subtle py-5', isAuthorityReference && 'am-arrival-option-detail']}>
                      <dt class:list={['text-primary am-text-label am-text-label--sm', isAuthorityReference && 'am-arrival-option-term']}>
                        {content.options.labels.timing}
                      </dt>
                      <dd class:list={['am-text-body mt-3 leading-relaxed text-on-surface-variant', isAuthorityReference && 'am-arrival-option-description']}>
                        <InlineEmphasis text={item.timing} />
                      </dd>
                    </div>
                  )}
                  {item.bestFor && (
                    <div class:list={[!isAuthorityReference && 'border-b border-border-subtle py-5', isAuthorityReference && 'am-arrival-option-detail']}>
                      <dt class:list={['text-primary am-text-label am-text-label--sm', isAuthorityReference && 'am-arrival-option-term']}>
                        {content.options.labels.bestFor}
                      </dt>
                      <dd class:list={['am-text-body mt-3 leading-relaxed text-on-surface-variant', isAuthorityReference && 'am-arrival-option-description']}>
                        <InlineEmphasis text={item.bestFor} />
                      </dd>
                    </div>
                  )}
                  {item.consideration && (
                    <div class:list={[!isAuthorityReference && 'border-b border-border-subtle py-5', isAuthorityReference && 'am-arrival-option-detail']}>
                      <dt class:list={['text-primary am-text-label am-text-label--sm', isAuthorityReference && 'am-arrival-option-term']}>
                        {content.options.labels.consideration}
                      </dt>
                      <dd class:list={['am-text-body mt-3 leading-relaxed text-on-surface-variant', isAuthorityReference && 'am-arrival-option-description']}>
                        <InlineEmphasis text={item.consideration} />
                      </dd>
                    </div>
                  )}
                </dl>
              )}
            </article>
          ))}
        </div>
      </div>
    </LocationModule>

    {
      content.journeySteps && (
        <div data-am-arrival-module="journey-steps">
          <FaqAccordion
            arrivalTitle={content.journeySteps.title}
            steps={content.journeySteps.steps}
            faqTitle={content.journeySteps.faqTitle}
            items={content.journeySteps.faq}
          />
        </div>
      )
    }

    {
      content.mobility && (
        <LocationModule
          surface="inverse"
          data-am-arrival-module="mobility"
        >
          <div class="mx-auto max-w-screen-2xl">
            <header class:list={['max-w-4xl', isAuthorityReference ? 'mb-10 md:mb-12' : 'mb-12 md:mb-16']}>
              <p class="am-text-eyebrow text-primary-fixed">
                {content.mobility.eyebrow}
              </p>
              <h2 class="am-text-title mt-5 text-balance italic text-inverted-on-surface">
                {content.mobility.title}
              </h2>
              {content.mobility.intro && (
                <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-inverted-on-surface/75">
                  <InlineEmphasis text={content.mobility.intro} />
                </p>
              )}
            </header>

            <div class:list={[
              'grid gap-px overflow-hidden bg-white/15',
              !isAuthorityReference && 'border border-white/15',
              mobilityGridClass
            ]}>
              {content.mobility.items.map((item) => (
                <article class:list={['bg-inverse-surface', isAuthorityReference ? 'p-6 md:p-8 lg:p-10' : 'p-7 md:p-10 lg:p-12']}>
                  <LocationGuideIcon name={item.icon} class:list={['text-primary-fixed', isAuthorityReference ? 'h-8 w-8' : 'h-6 w-6']} />
                  <p class="mt-8 text-primary-fixed am-text-label am-text-label--sm am-text-label--wide">
                    {item.eyebrow}
                  </p>
                  <h3 class:list={[isAuthorityReference ? 'am-text-subtitle' : 'am-text-title', 'mt-4 text-balance text-inverted-on-surface']}>{item.title}</h3>
                  <p class:list={['am-text-body leading-relaxed text-inverted-on-surface/75', isAuthorityReference ? 'mt-5' : 'mt-7']}>
                    <InlineEmphasis text={item.summary} />
                  </p>
                  {item.details.map((detail) => (
                    <p class:list={['am-text-body border-t border-white/15 leading-relaxed text-inverted-on-surface/75', isAuthorityReference ? 'mt-5 pt-5' : 'mt-6 pt-6']}>
                      <InlineEmphasis text={detail} />
                    </p>
                  ))}
                </article>
              ))}
            </div>
          </div>
        </LocationModule>
      )
    }

    {
      content.parking && (
        <LocationModule
          id={content.parking.id}
          spacing={isAuthorityReference ? 'compact' : 'standard'}
          data-am-arrival-module="parking"
        >
          <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
            <header class="lg:col-span-5">
              <div class="flex items-center gap-4">
                <LocationGuideIcon name={content.parking.icon} class="h-6 w-6" />
                <p class="am-text-eyebrow text-primary">
                  {content.parking.eyebrow}
                </p>
              </div>
              <h2 class="am-text-title mt-6 text-balance italic text-on-surface">
                {content.parking.title}
              </h2>
            </header>
            <div class="border-t border-border-subtle lg:col-span-7">
              {[content.parking.summary, ...content.parking.details].map((paragraph, index) => (
                <div class:list={[
                  'grid grid-cols-[2.5rem_minmax(0,1fr)] gap-5 border-b border-border-subtle md:grid-cols-[3.5rem_minmax(0,1fr)]',
                  isAuthorityReference ? 'py-6 md:py-7' : 'py-7 md:py-9'
                ]}>
                  <span class="am-text-subtitle italic text-primary/65">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <p class="am-text-body leading-relaxed text-on-surface-variant">
                    <InlineEmphasis text={paragraph} />
                  </p>
                </div>
              ))}
            </div>
          </div>
        </LocationModule>
      )
    }

    {
      content.finalMile && (
        <LocationModule
          surface="tint"
          data-am-arrival-module="final-mile"
        >
          <div class:list={[
            'mx-auto max-w-screen-2xl',
            content.finalMile.image && (isAuthorityReference
              ? 'grid overflow-hidden bg-surface lg:grid-cols-12'
              : 'grid overflow-hidden bg-surface lg:grid-cols-2')
          ]}>
            {content.finalMile.image && (
              <figure class:list={[
                'am-mobile-full-bleed bg-surface-container-high',
                isAuthorityReference ? 'min-h-[280px] lg:col-span-5 lg:min-h-[480px]' : 'min-h-[320px] lg:min-h-[560px]'
              ]}>
                <AmaraImage
                  src={content.finalMile.image.src}
                  alt={content.finalMile.image.alt}
                  profile="gallery"
                  class="h-full w-full object-cover"
                  sizes="(max-width: 1023px) 100vw, 50vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
            <div class:list={[
              'flex flex-col justify-center',
              content.finalMile.image
                ? (isAuthorityReference ? 'p-7 md:p-10 lg:col-span-7 lg:p-14' : 'p-8 md:p-12 lg:p-16')
                : 'mx-auto max-w-5xl'
            ]}>
              <p class="am-text-eyebrow text-primary">
                {content.finalMile.eyebrow}
              </p>
              <h2 class="am-text-title mt-5 text-balance italic text-on-surface">
                {content.finalMile.title}
              </h2>
              {content.finalMile.paragraphs.map((paragraph) => (
                <p class="am-text-body mt-7 max-w-3xl leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={paragraph} />
                </p>
              ))}
              {content.finalMile.steps && (
                <div class="mt-10 border-t border-border-subtle">
                  {content.finalMile.steps.map((step, index) => (
                    <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-5 border-b border-border-subtle py-6 md:grid-cols-[3rem_minmax(0,1fr)]">
                      {content.finalMile?.stepIcons?.[index] ? (
                        <LocationGuideIcon name={content.finalMile.stepIcons[index]} class="mt-1 h-5 w-5" />
                      ) : (
                        <span class="am-text-subtitle italic text-primary/65">{index + 1}</span>
                      )}
                      <p class="am-text-body leading-relaxed text-on-surface-variant">
                        <InlineEmphasis text={step} />
                      </p>
                    </div>
                  ))}
                </div>
              )}
              {finalMileLinks.length > 0 && (
                <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
                  {finalMileLinks.map((link) => (
                    <a href={link.href} class="am-cta-link">{link.label}</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </LocationModule>
      )
    }

    {
      content.related && relatedLinks.length > 0 && (
        <EditorialGuideLinkSection
          eyebrow={content.related.eyebrow}
          title={content.related.title}
          intro={content.related.intro}
          links={relatedLinks}
        />
      )
    }
  </AuthorityArticle>
</LocationAuthorityLayout>

<style>
  .am-arrival-option-card--recommended {
    background: color-mix(in srgb, var(--color-primary) 5%, var(--color-surface-white));
    box-shadow: inset 0 4px 0 var(--color-primary);
  }

  .am-arrival-recommendation {
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-surface-white);
    padding: 0.45rem 0.65rem;
  }

  .am-arrival-option-details {
    border-bottom: 0;
  }

  .am-arrival-option-detail:last-child {
    border-bottom: 0;
  }

  .am-arrival-option-term {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 1.25rem;
  }

  .am-arrival-option-description {
    padding-bottom: 1.25rem;
  }

  @media (min-width: 64rem) {
    .am-arrival-options-grid {
      grid-template-rows: repeat(10, auto);
    }

    .am-arrival-option-card {
      display: grid;
      grid-row: span 10;
      grid-template-rows: subgrid;
    }

    .am-arrival-option-details {
      display: contents;
    }

    .am-arrival-option-detail {
      display: contents;
    }
  }
</style>
