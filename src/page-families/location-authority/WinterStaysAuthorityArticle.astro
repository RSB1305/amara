---
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';
import type { RequiredLinkResolver } from '../../lib/linkResolver';
import type { WinterStaysLocale } from '../../content/winterStaysContent';
import type { LocationGuideIconName } from '../../components/location/LocationGuideIcon.astro';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';
import LocationSunHoursChart from '../../components/location/LocationSunHoursChart.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import type { ResolvedRouteImage } from '../../lib/images/routeImages';

interface Props {
  pageId: string;
  lang: AmaraLanguage;
  content: WinterStaysLocale;
  seo: AmaraAuthoringSeo;
  authorHref: string;
  locationHref: string;
  propertyHref: string;
  resolveHref: RequiredLinkResolver;
  factIcons?: LocationGuideIconName[];
  /** Optional per-destination winter photographs. Absent destinations render no gallery. */
  galleryImages?: ResolvedRouteImage[];
  /** Wide editorial image that bridges the gallery into the sunshine-hours chart. */
  sunBridgeImage?: ResolvedRouteImage;
  /** Contextual handoff from winter light to the year-round temperatures on the weather page. */
  weatherLink?: { href: string; label: string };
  sunChart?: {
    eyebrow: string;
    title: string;
    intro: string;
    unitLabel: string;
    months: Array<{ month: string; sunHours: number }>;
    comparisonNote?: string;
  };
}

const {
  pageId,
  lang,
  content,
  seo,
  authorHref,
  locationHref,
  propertyHref,
  resolveHref,
  factIcons,
  galleryImages = [],
  sunBridgeImage,
  weatherLink,
  sunChart
} = Astro.props;

const galleryColsClass =
  ({ 2: 'lg:grid-cols-2', 4: 'lg:grid-cols-2' } as Record<number, string>)[galleryImages.length] ?? 'lg:grid-cols-3';
---

<AuthorityArticle
  pageId={pageId}
  family="location"
  topic="winter-stays"
  lang={lang}
  hero={content.hero}
  authorName={seo.article!.authorName}
  authorHref={authorHref}
  facts={content.facts}
  factIcons={factIcons}
  sources={content.sources}
  closing={content.closing}
  primaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
  secondaryCta={{ href: locationHref, label: content.closing.locationLabel }}
  presentation="guide"
  guideSummary={{
    eyebrow: content.navLabel,
    body: content.hero.standfirst
  }}
>
  {content.sections.map((section, index) => (
    <AuthorityTextSection
      section={section}
      index={index}
      presentation="guide"
      data-am-winter-stays-section={section.id}
    />
  ))}

  {galleryImages.length > 0 && (
    <section class="bg-surface px-6 py-14 md:px-12 md:py-16" data-am-winter-gallery>
      <div class="mx-auto max-w-screen-2xl">
        <div class:list={['grid gap-5 sm:grid-cols-2', galleryColsClass]}>
          {galleryImages.map((image) => (
            <figure class="m-0">
              <AmaraImage
                src={image.src}
                alt={image.alt}
                profile="gallery"
                focalPoint={image.focalPoint}
                class="aspect-[4/3] w-full rounded-sm object-cover"
              />
              {image.caption && (
                <figcaption class="am-text-caption mt-3 normal-case tracking-normal text-on-surface-variant">{image.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {sunBridgeImage && (
    <section class="bg-surface px-6 pb-6 md:px-12" data-am-winter-sun-bridge>
      <div class="mx-auto max-w-screen-2xl">
        <figure class="m-0">
          <div class="aspect-[16/9] w-full overflow-hidden rounded-sm lg:aspect-[21/9]">
            <AmaraImage
              src={sunBridgeImage.src}
              alt={sunBridgeImage.alt}
              profile="gallery"
              focalPoint={sunBridgeImage.focalPoint}
              class="h-full w-full object-cover"
            />
          </div>
          {sunBridgeImage.caption && (
            <figcaption class="am-text-caption mt-3 max-w-3xl normal-case tracking-normal text-on-surface-variant">{sunBridgeImage.caption}</figcaption>
          )}
        </figure>
      </div>
    </section>
  )}

  {sunChart && <LocationSunHoursChart lang={lang} {...sunChart} />}

  {weatherLink && (
    <section class="bg-surface px-6 pb-16 md:px-12" data-am-winter-weather-link>
      <div class="mx-auto max-w-screen-2xl">
        <a href={weatherLink.href} class="am-inline-link am-text-body">{weatherLink.label} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>
  )}

  <AuthorityRelatedLinks
    related={content.related}
    columns="md:grid-cols-2"
    resolveHref={resolveHref}
    presentation="guide"
  />
</AuthorityArticle>
