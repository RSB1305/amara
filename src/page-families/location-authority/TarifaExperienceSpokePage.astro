---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import Navigation from '../../components/Navigation.astro';
import ExperienceArticleHero from '../../components/experience/ExperienceArticleHero.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import {
  tarifaExperienceSpokeContent,
  type TarifaExperienceSpokeId,
  type LocalizedExperienceText
} from '../../content/tarifaExperienceSpokeContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import GuestGuideBridge from '../../components/experience/GuestGuideBridge.astro';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityStayBridge from './AuthorityStayBridge.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';
import { experienceStayBridge } from '../../content/experienceStayBridgeContent';
import AmaraActionLink from '../../components/actions/AmaraActionLink.astro';
import AmaraImage from '../../components/AmaraImage.astro';
import { getRouteImageSet, routeImage, routeImages } from '../../lib/images/routeImages';

interface Props {
  spoke: TarifaExperienceSpokeId;
  lang?: string;
}

const { spoke, lang = 'es' } = Astro.props;
const content = tarifaExperienceSpokeContent[spoke];
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const t = (value: LocalizedExperienceText) => value[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa experience');
const spokeGuideSlugs: Partial<Record<TarifaExperienceSpokeId, string>> = {
  'food-evening-life': 'tarifa-guest-food-drink',
  'old-town-history': 'tarifa-guest-sightseeing',
  'bolonia-baelo-claudia': 'tarifa-guest-sightseeing',
  yoga: 'tarifa-guest-activities',
  'whale-watching': 'tarifa-guest-sightseeing',
  family: 'tarifa-guest-activities'
};
const guideSlug = spokeGuideSlugs[spoke] ?? 'tarifa-guest-local-guide';

const aboutHref = requiredLink('about');
const propertyHref = requiredLink('tarifa');
const footerHighlights: LabeledLink[] = [
  { token: content.token, label: t(content.navLabel) },
  { token: 'tarifa_experience_hub', label: t(content.closing.hubLabel) },
  ...content.related.links.slice(0, 2).map((link) => ({
    token: link.token,
    label: t(link.label)
  }))
];
const localizedSections = content.sections.map((section) => ({
  id: section.id,
  eyebrow: t(section.eyebrow),
  title: t(section.title),
  paragraphs: section.paragraphs.map(t)
}));

// Photographs, when the spoke has an image source (whale-watching, yoga so far).
const routeKey = `tarifa.experience.${spoke}`;
const hasImages = Boolean(getRouteImageSet(routeKey));
const galleryImages = hasImages ? routeImages(routeKey, 'gallery', currentLang) : [];
const editorialImage = hasImages ? routeImage(routeKey, 'firmm-vision', currentLang) : undefined;
// The photo credit line, per route: the source's name and the link it points to.
const photoCredits: Partial<Record<string, { href: string; label: string }>> = {
  'tarifa.experience.whale-watching': { href: 'https://www.firmm.org', label: 'Fotos: foundation firmm' },
  'tarifa.experience.yoga': { href: 'https://www.mandalablueyoga.es', label: 'Fotos: Mandalablue Yoga' }
};
const photoCredit = photoCredits[routeKey];
// Static column classes so Tailwind keeps them; the grid follows the image count.
const galleryColsClass = ({ 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3' } as Record<number, string>)[galleryImages.length] ?? 'lg:grid-cols-4';
---

<LocationAuthorityLayout
  seo={content.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
  pageFamily="experience-tarifa-spoke"
>
  <Navigation
    slot="navigation"
    contextDestination="tarifa"
    currentLang={currentLang}
    languageToken={content.token}
  >
    <ExperienceContextNav slot="context-navigation" currentId={content.id} destination="tarifa" lang={currentLang} />
  </Navigation>

  <article
    class="am-tarifa-surface overflow-x-clip bg-surface"
    data-am-page={`tarifa-${content.id}`}
    data-am-family="experience"
    data-am-role="spoke"
    data-am-topic={content.id}
    data-am-experience-spoke={content.id}
  >
    <ExperienceArticleHero
      eyebrow={t(content.hero.eyebrow)}
      title={t(content.hero.title)}
      standfirst={t(content.hero.standfirst)}
      lang={currentLang}
      authorName={content.seo.article!.authorName}
      authorHref={aboutHref}
      updated={t(content.hero.updated)}
      note={t(content.hero.note)}
      mark="Tarifa"
      topic={content.id}
    />

    <section class="bg-surface-container-low px-6 py-16 md:px-12 md:py-20">
      <dl class="mx-auto grid max-w-screen-2xl gap-x-10 gap-y-8 md:grid-cols-3">
        {content.facts.map((fact) => (
          <div class="border-t border-primary/30 pt-5">
            <dt class="text-primary am-text-label am-text-label--sm">{t(fact.label)}</dt>
            <dd class="am-text-subtitle mt-3 text-on-surface">{t(fact.value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {galleryImages.length > 0 && (
      <section class="bg-surface px-6 py-16 md:px-12 md:py-20" data-am-experience-gallery>
        <div class="mx-auto max-w-screen-2xl">
          <div class:list={['grid gap-6 sm:grid-cols-2', galleryColsClass]}>
            {galleryImages.map((image) => (
              <figure>
                <AmaraImage
                  src={image.src}
                  alt={image.alt}
                  profile="gallery"
                  focalPoint={image.focalPoint}
                  class="aspect-[4/3] w-full rounded-sm object-cover"
                />
                {image.caption && (
                  <figcaption class="am-text-caption mt-3 normal-case tracking-normal text-on-surface-variant">{image.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
          {photoCredit && (
            <p class="am-text-caption mt-6 normal-case tracking-normal text-muted">
              <a
                href={photoCredit.href}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
              >{photoCredit.label}</a>
            </p>
          )}
        </div>
      </section>
    )}

    {localizedSections.map((section, index) => (
      <AuthorityTextSection
        section={section}
        index={index}
        variant={(['lead', 'columns', 'reverse', 'rail'] as const)[index % 4]}
        data-am-experience-section={section.id}
      />
    ))}

    <aside class="bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary">{t(content.host.eyebrow)}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{t(content.host.title)}</h2>
        </div>
        <div class="max-w-4xl space-y-5 lg:col-span-7">
          {content.host.paragraphs.map((paragraph, index) => (
            <p class:list={[index === 0 ? 'am-text-quote text-balance text-on-surface' : 'am-text-body leading-relaxed text-on-surface-variant']}>
              <InlineEmphasis text={t(paragraph)} />
            </p>
          ))}
        </div>
      </div>
    </aside>

    <section class="bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <p class="am-text-eyebrow text-primary">{t(content.related.eyebrow)}</p>
        <h2 class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{t(content.related.title)}</h2>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {content.related.links.map((link) => (
            <AmaraActionLink
              href={requiredLink(link.token)}
              variant="card"
              class="group border-t border-border-subtle bg-surface-container-low px-6 pb-8 pt-7 transition-colors hover:border-primary/45"
            >
              <h3 class="am-text-subtitle text-on-surface transition-colors group-hover:text-primary">{t(link.label)}</h3>
              <span class="am-text-body mt-4 block leading-relaxed text-on-surface-variant">{t(link.text)}</span>
              <span aria-hidden="true" class="mt-6 inline-flex text-primary transition-transform group-hover:translate-x-1">→</span>
            </AmaraActionLink>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <p class="am-text-eyebrow text-primary">{t(content.sources.eyebrow)}</p>
          <h2 class="am-text-title mt-5 text-balance text-on-surface">{t(content.sources.title)}</h2>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={t(content.sources.intro)} /></p>
          <p class="mt-6 am-text-label am-text-label--sm text-muted">{t(content.sources.checked)}</p>
        </div>
        <div class="border-t border-border-subtle lg:col-span-8">
          {content.sources.links.map((source) => (
            <a
              href={source.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group grid grid-cols-[1fr_auto] gap-8 border-b border-border-subtle py-7 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25"
            >
              <span>
                <span class="am-text-subtitle block text-on-surface transition-colors group-hover:text-primary">{t(source.label)}</span>
                <span class="am-text-body mt-2 block leading-relaxed text-on-surface-variant">{t(source.text)}</span>
              </span>
              <span aria-hidden="true" class="am-text-subtitle text-primary">↗︎</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {content.operators && (
      <section class="bg-surface px-6 py-20 md:px-12 md:py-28">
        <div class="mx-auto max-w-screen-2xl">
          <p class="am-text-eyebrow text-primary">{t(content.operators.eyebrow)}</p>
          <h2 class="am-text-title mt-5 max-w-3xl text-balance text-on-surface">{t(content.operators.title)}</h2>
          <p class="am-text-body mt-6 max-w-2xl leading-relaxed text-on-surface-variant">{t(content.operators.intro)}</p>
          {editorialImage && (
            <figure class="mt-10 max-w-3xl">
              <AmaraImage
                src={editorialImage.src}
                alt={editorialImage.alt}
                profile="gallery"
                focalPoint={editorialImage.focalPoint}
                sizes="(max-width: 767px) calc(100vw - 3rem), 768px"
                class="aspect-[3/2] w-full rounded-sm object-cover"
              />
              <figcaption class="am-text-caption mt-3 normal-case tracking-normal text-on-surface-variant">
                {editorialImage.caption}
                {photoCredit && (
                  <a
                    href={photoCredit.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
                  >{photoCredit.label}</a>
                )}
              </figcaption>
            </figure>
          )}
          <ul class="mt-10 max-w-2xl border-t border-border-subtle">
            {content.operators.items.map((op) => (
              <li class="border-b border-border-subtle py-5">
                {op.href ? (
                  <a
                    href={op.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="am-text-subtitle text-on-surface underline decoration-primary/50 underline-offset-4 transition-colors hover:text-primary"
                  >
                    {op.name}<span aria-hidden="true" class="text-primary"> ↗</span>
                  </a>
                ) : (
                  <span class="am-text-subtitle text-on-surface">{op.name}</span>
                )}
                <span class="am-text-body mt-2 block leading-relaxed text-on-surface-variant">{t(op.note)}</span>
              </li>
            ))}
          </ul>
          <p class="am-text-body mt-8 max-w-2xl leading-relaxed text-on-surface">{t(content.operators.guideNote)}</p>
        </div>
      </section>
    )}

    <GuestGuideBridge lang={currentLang} destination="tarifa" guideSlugs={[guideSlug]} topicPreview={content.guidePreview} />

    <AuthorityStayBridge
      eyebrow={t(content.closing.eyebrow)}
      title={t(content.closing.title)}
      reason={t(content.closing.body)}
      stayHref={propertyHref}
      stayLabel={t(content.closing.propertyLabel)}
      availabilityHref={requiredLink('book')}
      availabilityLabel={experienceStayBridge.availabilityLabel[currentLang]}
    />
  </article>
</LocationAuthorityLayout>
