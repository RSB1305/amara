---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import tarifaStayImage from '../../assets/images/home/amara-tarifa-apartment01.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import LocationExperienceHero from '../../components/location/LocationExperienceHero.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  tarifaGuideContent,
  type LocalizedText,
  type TarifaGuideId
} from '../../content/tarifaGuideContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  guide: TarifaGuideId;
  lang?: string;
}

const { guide, lang = 'es' } = Astro.props;
const content = tarifaGuideContent[guide];
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const t = (value: LocalizedText) => value[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa guide');
const stayHref = requiredLink('casa');
const bookHref = requiredLink('book');
const aboutHref = requiredLink('about');
const topicContent = content.id === 'overview' ? undefined : content;
const relatedGuides = topicContent?.related.map((id) => tarifaGuideContent[id]) ?? [];
const locationCopy = content.id === 'overview' ? content.location[currentLang] : undefined;

if (content.id === 'overview' && !locationCopy) {
  throw new Error(`[Tarifa guide] Missing location-authority copy for locale: ${currentLang}`);
}

const locationSections = locationCopy
  ? [locationCopy.car, locationCopy.wind, locationCopy.seasons]
  : [];

const ui = {
  faq: {
    en: 'Practical questions',
    de: 'Praktische Fragen',
    es: 'Preguntas prácticas',
    nl: 'Praktische vragen',
    sv: 'Praktiska frågor'
  },
  sourcesEyebrow: {
    en: 'Editorial transparency',
    de: 'Redaktionelle Transparenz',
    es: 'Transparencia editorial',
    nl: 'Redactionele transparantie',
    sv: 'Redaktionell transparens'
  },
  sourcesTitle: {
    en: 'Official sources and current rules',
    de: 'Offizielle Quellen und aktuelle Regeln',
    es: 'Fuentes oficiales y normas vigentes',
    nl: 'Officiële bronnen en actuele regels',
    sv: 'Officiella källor och aktuella regler'
  },
  sourcesBody: {
    en: 'AMARA uses these sources for orientation. Conditions, access and local rules can change after publication, so information on site takes priority.',
    de: 'AMARA nutzt diese Quellen zur Orientierung. Bedingungen, Zufahrt und lokale Regeln können sich nach Veröffentlichung ändern; Informationen vor Ort haben deshalb Vorrang.',
    es: 'AMARA utiliza estas fuentes como orientación. Las condiciones, los accesos y las normas locales pueden cambiar después de la publicación; prevalece la información sobre el terreno.',
    nl: 'AMARA gebruikt deze bronnen ter oriëntatie. Omstandigheden, toegang en lokale regels kunnen na publicatie veranderen; informatie ter plaatse heeft daarom voorrang.',
    sv: 'AMARA använder dessa källor som vägledning. Förhållanden, tillträde och lokala regler kan ändras efter publicering; information på plats gäller därför först.'
  },
  relatedEyebrow: {
    en: 'Continue planning',
    de: 'Weiter planen',
    es: 'Seguir planificando',
    nl: 'Verder plannen',
    sv: 'Fortsätt planera'
  },
  relatedTitle: {
    en: 'More Tarifa orientation',
    de: 'Mehr Orientierung für Tarifa',
    es: 'Más orientación sobre Tarifa',
    nl: 'Meer houvast voor Tarifa',
    sv: 'Mer vägledning om Tarifa'
  },
  readGuide: {
    en: 'Read guide',
    de: 'Guide lesen',
    es: 'Leer la guía',
    nl: 'Lees de gids',
    sv: 'Läs guiden'
  },
  stayEyebrow: {
    en: 'Your AMARA stay in Tarifa',
    de: 'Eure AMARA-Unterkunft in Tarifa',
    es: 'Vuestro alojamiento AMARA en Tarifa',
    nl: 'Jullie AMARA-verblijf in Tarifa',
    sv: 'Ert AMARA-boende i Tarifa'
  },
  stayTitle: {
    en: 'Space for active days and quiet evenings',
    de: 'Raum für aktive Tage und ruhige Abende',
    es: 'Espacio para días activos y noches tranquilas',
    nl: 'Ruimte voor actieve dagen en rustige avonden',
    sv: 'Utrymme för aktiva dagar och lugna kvällar'
  },
  stayBody: {
    en: 'AMARA Family & Surf welcomes up to four guests with sea views, a private terrace, pool access and a reserved underground parking space.',
    de: 'AMARA Family & Surf bietet bis zu vier Gästen Meerblick, eine private Terrasse, Poolzugang und einen reservierten Tiefgaragenstellplatz.',
    es: 'AMARA Family & Surf recibe hasta cuatro huéspedes con vistas al mar, terraza privada, acceso a piscina y plaza reservada en garaje subterráneo.',
    nl: 'AMARA Family & Surf biedt plaats aan maximaal vier gasten, met zeezicht, privéterras, toegang tot het zwembad en een gereserveerde ondergrondse parkeerplaats.',
    sv: 'AMARA Family & Surf välkomnar upp till fyra gäster med havsutsikt, privat terrass, tillgång till pool och reserverad plats i garage.'
  },
  viewStay: {
    en: 'View Family & Surf',
    de: 'Family & Surf ansehen',
    es: 'Ver Family & Surf',
    nl: 'Bekijk Family & Surf',
    sv: 'Visa Family & Surf'
  },
  availability: {
    en: 'Check availability',
    de: 'Verfügbarkeit prüfen',
    es: 'Consultar disponibilidad',
    nl: 'Beschikbaarheid bekijken',
    sv: 'Se tillgänglighet'
  },
  imageAlt: {
    en: 'Living space at AMARA Family & Surf in Tarifa',
    de: 'Wohnbereich bei AMARA Family & Surf in Tarifa',
    es: 'Salón de AMARA Family & Surf en Tarifa',
    nl: 'Woonruimte van AMARA Family & Surf in Tarifa',
    sv: 'Vardagsrum på AMARA Family & Surf i Tarifa'
  },
  beachesImageAlt: {
    en: 'View from AMARA over Tarifa toward the Atlantic coast',
    de: 'Blick von AMARA über Tarifa zur Atlantikküste',
    es: 'Vista desde AMARA sobre Tarifa hacia la costa atlántica',
    nl: 'Uitzicht vanaf AMARA over Tarifa richting de Atlantische kust',
    sv: 'Utsikt från AMARA över Tarifa mot Atlantkusten'
  },
  windImageAlt: {
    en: 'Surf details in the bedroom at AMARA Family & Surf in Tarifa',
    de: 'Surfdetails im Schlafzimmer von AMARA Family & Surf in Tarifa',
    es: 'Detalles de surf en el dormitorio de AMARA Family & Surf en Tarifa',
    nl: 'Surfdetails in de slaapkamer van AMARA Family & Surf in Tarifa',
    sv: 'Surfdetaljer i sovrummet på AMARA Family & Surf i Tarifa'
  }
} satisfies Record<string, LocalizedText>;

const topicHeroMedia = content.id === 'beaches'
  ? {
      src: '/images/amara-tarifa/amara-tarifa-apartment23.webp',
      alt: t(ui.beachesImageAlt)
    }
  : content.id === 'wind'
    ? {
        src: '/images/amara-tarifa/amara-tarifa-apartment21.webp',
        alt: t(ui.windImageAlt)
      }
    : undefined;

const footerHighlights: LabeledLink[] = [
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_experience_hub', label: 'Experience' },
  { token: 'tarifa_wind_kitesurfing_authority', label: t(tarifaGuideContent.wind.navLabel) },
  { token: 'tarifa_beaches_authority', label: t(tarifaGuideContent.beaches.navLabel) }
];
---

<LocationAuthorityLayout
  seo={content.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken={content.token}
  >
    <TarifaContextNav slot="context-navigation"
      activeId={content.id}
      currentLabel={t(content.breadcrumbLabel)}
      lang={currentLang}
    />
  </Navigation>

  {locationCopy ? (
    <article class="bg-surface" data-am-page="tarifa-overview">
      <header class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28">
        <div class="mx-auto max-w-screen-2xl">
          <div class="max-w-5xl">
            <p class="am-text-eyebrow text-primary">
              {locationCopy.hero.eyebrow}
            </p>
            <h1 class="am-text-display mt-7 max-w-5xl text-balance text-on-surface">
              {locationCopy.hero.title}
            </h1>
            <div class="mt-9 max-w-4xl space-y-5">
              {locationCopy.hero.lead.map((paragraph, index) => (
                <p
                  class:list={[
                    index === 0 ? 'am-text-title text-balance' : 'am-text-body',
                    'leading-relaxed text-on-surface-variant'
                  ]}
                >
                  {paragraph}
                </p>
              ))}
            </div>
            {content.seo.article && (
              <EditorialByline
                lang={currentLang}
                authorName={content.seo.article.authorName}
                authorHref={aboutHref}
                updated={locationCopy.hero.updated}
                note={locationCopy.hero.editorialNote}
              />
            )}
          </div>
        </div>
      </header>

      <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
        <div class="mx-auto max-w-screen-2xl">
          <h2 class="am-text-title max-w-3xl text-balance text-on-surface">
            {locationCopy.microLocations.title}
          </h2>
          <div class="mt-12 grid gap-5 md:grid-cols-2">
            {locationCopy.microLocations.items.map((item) => (
              <section class="border-t border-border-subtle bg-surface px-6 pb-8 pt-7 md:px-8 md:pb-10 md:pt-9">
                <h3 class="am-text-subtitle text-balance text-on-surface">{item.title}</h3>
                <div class="mt-5 space-y-4">
                  {item.paragraphs.map((paragraph) => (
                    <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
                  ))}
                </div>
                {item.fit && (
                  <p class="mt-6 border-l border-primary/30 pl-4 am-text-body leading-relaxed text-on-surface">
                    {item.fit}
                  </p>
                )}
              </section>
            ))}
          </div>
          <aside class="mt-8 border-l border-primary/30 bg-surface px-6 py-6 md:px-8">
            <p class="am-text-body max-w-5xl leading-relaxed text-on-surface-variant">
              {locationCopy.microLocations.clarification}
            </p>
            <a
              href={requiredLink(locationCopy.microLocations.link.token)}
              class="am-cta-link mt-5 inline-flex"
            >
              {locationCopy.microLocations.link.label}
            </a>
          </aside>
        </div>
      </section>

      {locationSections.map((section, sectionIndex) => (
        <section
          id={section.id}
          class:list={[
            'border-b border-border-subtle px-6 py-16 md:px-12 md:py-20',
            sectionIndex % 2 === 0 ? 'bg-surface' : 'bg-surface-container-low'
          ]}
        >
          <div class="mx-auto grid max-w-screen-2xl gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
            <h2 class="am-text-title max-w-xl text-balance text-on-surface">{section.title}</h2>
            <div class="max-w-4xl space-y-5">
              {section.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
              {section.links && (
                <div class="flex flex-wrap gap-x-6 gap-y-3 pt-3">
                  {section.links.map((link) => (
                    <a href={requiredLink(link.token)} class="am-cta-link">{link.label}</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      ))}

      <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-24">
        <div class="mx-auto max-w-screen-2xl">
          <h2 class="am-text-title max-w-3xl text-balance text-on-surface">{locationCopy.stayFits.title}</h2>
          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {locationCopy.stayFits.items.map((item) => (
              <section class="border-t border-border-subtle bg-surface px-6 pb-7 pt-6">
                <h3 class="am-text-subtitle text-on-surface">{item.title}</h3>
                <div class="mt-4 space-y-4">
                  {item.paragraphs.map((paragraph) => (
                    <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section id={locationCopy.dailyLife.id} class="border-b border-border-subtle bg-surface px-6 py-16 md:px-12 md:py-20">
        <div class="mx-auto grid max-w-screen-2xl gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
          <h2 class="am-text-title max-w-xl text-balance text-on-surface">{locationCopy.dailyLife.title}</h2>
          <div class="max-w-4xl space-y-4">
            {locationCopy.dailyLife.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>
      </section>

      <section class="border-b border-border-subtle bg-inverse-surface px-6 py-16 text-inverted-on-surface md:px-12 md:py-20">
        <div class="mx-auto grid max-w-screen-2xl gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
          <div>
            <h2 class="am-text-title max-w-xl text-balance text-inverted-on-surface">
              {locationCopy.tradeoffs.title}
            </h2>
            {locationCopy.tradeoffs.intro && (
              <p class="am-text-body mt-5 leading-relaxed text-inverted-on-surface/75">
                {locationCopy.tradeoffs.intro}
              </p>
            )}
          </div>
          <div>
            <ul class="divide-y divide-inverted-on-surface/15 border-y border-inverted-on-surface/15">
              {locationCopy.tradeoffs.items.map((item) => (
                <li class="py-5 am-text-body leading-relaxed text-inverted-on-surface/85">{item}</li>
              ))}
            </ul>
            {locationCopy.tradeoffs.closing && (
              <div class="mt-7 space-y-3">
                {locationCopy.tradeoffs.closing.map((paragraph) => (
                  <p class="am-text-body leading-relaxed text-inverted-on-surface/75"><InlineEmphasis text={paragraph} /></p>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>

      <section class="border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
        <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface lg:grid-cols-2">
          <figure class="am-mobile-full-bleed min-h-[360px] bg-surface-container-high lg:min-h-[560px]">
            <AmaraImage
              src={tarifaStayImage}
              alt={locationCopy.amara.imageAlt}
              profile="hero"
              class="h-full w-full object-cover"
              sizes="(max-width: 1023px) 100vw, 50vw"
            />
          </figure>
          <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
            <h2 class="am-text-title text-balance text-on-surface">{locationCopy.amara.title}</h2>
            <div class="mt-6 space-y-4">
              {locationCopy.amara.paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
              ))}
            </div>
            <ul class="mt-7 space-y-3 border-l border-primary/30 pl-5">
              {locationCopy.amara.facts.map((fact) => (
                <li class="am-text-body leading-relaxed text-on-surface">{fact}</li>
              ))}
            </ul>
            <div class="mt-9">
              <a href={stayHref} class="am-btn am-btn--primary">{locationCopy.closing.secondary.label}</a>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-surface px-6 py-20 md:px-12 md:py-28">
        <div class="mx-auto max-w-4xl text-center">
          <h2 class="am-text-title text-balance text-on-surface">{locationCopy.closing.title}</h2>
          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href={requiredLink(locationCopy.closing.primary.token)} class="am-btn am-btn--primary w-full justify-center sm:w-auto">
              {locationCopy.closing.primary.label}
            </a>
            <a href={requiredLink(locationCopy.closing.secondary.token)} class="am-btn am-btn--secondary w-full justify-center sm:w-auto">
              {locationCopy.closing.secondary.label}
            </a>
          </div>
        </div>
      </section>
    </article>
  ) : topicContent ? (
  <article
    class="bg-surface"
    data-am-page={`tarifa-${content.id}`}
    data-am-family="experience"
    data-am-role="spoke"
    data-am-topic={content.id}
  >
    <LocationExperienceHero
      eyebrow={t(topicContent.hero.eyebrow)}
      title={t(topicContent.hero.title)}
      paragraphs={[t(topicContent.hero.lead)]}
      imageSrc={topicHeroMedia!.src}
      imageAlt={topicHeroMedia!.alt}
      imageWidth={1600}
      topic={content.id}
      byline={{
        lang: currentLang,
        authorName: content.seo.article!.authorName,
        authorHref: aboutHref,
        updated: t(topicContent.hero.updated),
        note: t(topicContent.hero.editorialNote)
      }}
    />

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-8 md:px-12">
      <dl class="mx-auto grid max-w-screen-2xl gap-8 md:grid-cols-3">
        {topicContent.facts.map((fact) => (
          <div class="border-l border-primary/25 pl-5">
            <dt class="text-on-surface-variant am-text-label am-text-label--sm">
              {t(fact.label)}
            </dt>
            <dd class="am-text-subtitle mt-2 text-on-surface">{t(fact.value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {topicContent.sections.map((section, sectionIndex) => (
      <section
        id={section.id}
        class:list={[
          'border-b border-border-subtle px-6 py-20 md:px-12 md:py-28',
          sectionIndex % 2 === 0 ? 'bg-surface' : 'bg-surface-container-low'
        ]}
      >
        <div class="mx-auto max-w-screen-2xl">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-20">
            <div class="max-w-xl">
              <p class="text-primary am-text-label am-text-label--wide">
                {t(section.eyebrow)}
              </p>
              <h2 class="am-text-title mt-5 text-balance text-on-surface">{t(section.title)}</h2>
              <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant"><InlineEmphasis text={t(section.intro)} /></p>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              {section.cards.map((card) => (
                <section class="border-t border-border-subtle bg-surface/70 px-5 pb-7 pt-6">
                  <p class="text-primary am-text-label am-text-label--sm">
                    {t(card.kicker)}
                  </p>
                  <h3 class="am-text-subtitle mt-4 text-on-surface">{t(card.title)}</h3>
                  <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant"><InlineEmphasis text={t(card.text)} /></p>
                </section>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))}

    <aside class="bg-inverse-surface px-6 py-16 text-inverted-on-surface md:px-12 md:py-20">
      <div class="mx-auto grid max-w-screen-2xl gap-8 lg:grid-cols-[0.65fr_1.35fr] lg:gap-20">
        <p class="text-primary-fixed-dim am-text-label am-text-label--wide">
          {t(topicContent.notice.eyebrow)}
        </p>
        <div>
          <h2 class="am-text-title text-balance text-inverted-on-surface">{t(topicContent.notice.title)}</h2>
          <p class="am-text-body mt-6 max-w-4xl leading-relaxed text-inverted-on-surface/75">
            {t(topicContent.notice.text)}
          </p>
        </div>
      </div>
    </aside>

    <section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <h2 class="am-text-title text-on-surface">{t(ui.faq)}</h2>
        <div class="divide-y divide-border-subtle border-y border-border-subtle">
          {topicContent.faq.map((item) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 am-text-subtitle text-on-surface">
                <span>{t(item.question)}</span>
                <span aria-hidden="true" class="mt-1 text-primary transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="am-text-body max-w-3xl pb-2 pt-5 leading-relaxed text-on-surface-variant">
                {t(item.answer)}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-16 md:px-12 md:py-20">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="text-primary am-text-label am-text-label--wide">
            {t(ui.sourcesEyebrow)}
          </p>
          <h2 class="am-text-title mt-5 text-on-surface">{t(ui.sourcesTitle)}</h2>
          <p class="am-text-body mt-5 max-w-xl leading-relaxed text-on-surface-variant">
            {t(ui.sourcesBody)}
          </p>
        </div>
        <ul class="divide-y divide-border-subtle border-y border-border-subtle">
          {topicContent.sources.map((source) => (
            <li>
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-6 py-5 am-text-body text-on-surface transition-colors hover:text-primary"
              >
                <span>{t(source.label)}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-screen-2xl">
        <p class="text-primary am-text-label am-text-label--wide">
          {t(ui.relatedEyebrow)}
        </p>
        <h2 class="am-text-title mt-5 text-on-surface">{t(ui.relatedTitle)}</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {relatedGuides.map((guide) => (
            <a
              href={requiredLink(guide.token)}
              class="group border border-border-subtle bg-surface-container-low p-7 transition-colors hover:border-primary/40"
            >
              <h3 class="am-text-subtitle text-on-surface">{t(guide.breadcrumbLabel)}</h3>
              <span class="mt-6 inline-flex text-primary am-text-label am-text-label--sm">
                {t(ui.readGuide)} <span aria-hidden="true" class="ml-2 transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface lg:grid-cols-2">
        <figure class="am-mobile-full-bleed min-h-[360px] bg-surface-container-high lg:min-h-[560px]">
          <AmaraImage
            src={tarifaStayImage}
            alt={t(ui.imageAlt)}
            profile="hero"
            class="h-full w-full object-cover"
            sizes="(max-width: 1023px) 100vw, 50vw"
          />
        </figure>
        <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
          <p class="text-primary am-text-label am-text-label--wide">
            {t(ui.stayEyebrow)}
          </p>
          <h2 class="am-text-title mt-6 text-balance text-on-surface">{t(ui.stayTitle)}</h2>
          <p class="am-text-body mt-6 max-w-xl leading-relaxed text-on-surface-variant"><InlineEmphasis text={t(ui.stayBody)} /></p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={stayHref} class="am-btn am-btn--primary">{t(ui.viewStay)}</a>
            <a href={bookHref} class="am-btn am-btn--secondary">{t(ui.availability)}</a>
          </div>
        </div>
      </div>
    </section>
  </article>
  ) : null}
</LocationAuthorityLayout>
