---
import tarifaStayImage from '../../assets/images/home/amara-tarifa-apartment01.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  tarifaGuideContent,
  type LocalizedText,
  type TarifaGuideContent
} from '../../content/tarifaGuideContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  content: TarifaGuideContent;
  lang?: string;
}

const { content, lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const t = (value: LocalizedText) => value[currentLang];
const requiredLink = (token: string) => {
  const href = resolveOptionalLink(token, currentLang, { suppressMissing: true });

  if (!href) {
    throw new Error(`[Tarifa guide] Missing required link token: ${token}`);
  }

  return href;
};
const stayHref = requiredLink('casa');
const bookHref = requiredLink('book');
const relatedGuides = content.related.map((id) => tarifaGuideContent[id]);

const ui = {
  faq: {
    en: 'Practical questions',
    de: 'Praktische Fragen',
    es: 'Preguntas prácticas',
    nl: 'Praktische vragen',
    sv: 'Praktiska frågor'
  },
  sourcesEyebrow: {
    en: 'Editorial transparency',
    de: 'Redaktionelle Transparenz',
    es: 'Transparencia editorial',
    nl: 'Redactionele transparantie',
    sv: 'Redaktionell transparens'
  },
  sourcesTitle: {
    en: 'Official sources and current rules',
    de: 'Offizielle Quellen und aktuelle Regeln',
    es: 'Fuentes oficiales y normas vigentes',
    nl: 'Officiële bronnen en actuele regels',
    sv: 'Officiella källor och aktuella regler'
  },
  sourcesBody: {
    en: 'AMARA uses these sources for orientation. Conditions, access and local rules can change after publication, so information on site takes priority.',
    de: 'AMARA nutzt diese Quellen zur Orientierung. Bedingungen, Zufahrt und lokale Regeln können sich nach Veröffentlichung ändern; Informationen vor Ort haben deshalb Vorrang.',
    es: 'AMARA utiliza estas fuentes como orientación. Las condiciones, los accesos y las normas locales pueden cambiar después de la publicación; prevalece la información sobre el terreno.',
    nl: 'AMARA gebruikt deze bronnen ter oriëntatie. Omstandigheden, toegang en lokale regels kunnen na publicatie veranderen; informatie ter plaatse heeft daarom voorrang.',
    sv: 'AMARA använder dessa källor som vägledning. Förhållanden, tillträde och lokala regler kan ändras efter publicering; information på plats gäller därför först.'
  },
  relatedEyebrow: {
    en: 'Continue planning',
    de: 'Weiter planen',
    es: 'Seguir planificando',
    nl: 'Verder plannen',
    sv: 'Fortsätt planera'
  },
  relatedTitle: {
    en: 'More Tarifa orientation',
    de: 'Mehr Orientierung für Tarifa',
    es: 'Más orientación sobre Tarifa',
    nl: 'Meer houvast voor Tarifa',
    sv: 'Mer vägledning om Tarifa'
  },
  readGuide: {
    en: 'Read guide',
    de: 'Guide lesen',
    es: 'Leer la guía',
    nl: 'Lees de gids',
    sv: 'Läs guiden'
  },
  stayEyebrow: {
    en: 'Your AMARA base in Tarifa',
    de: 'Deine AMARA-Basis in Tarifa',
    es: 'Tu base AMARA en Tarifa',
    nl: 'Je AMARA-basis in Tarifa',
    sv: 'Din AMARA-bas i Tarifa'
  },
  stayTitle: {
    en: 'Space for active days and quiet evenings',
    de: 'Raum für aktive Tage und ruhige Abende',
    es: 'Espacio para días activos y noches tranquilas',
    nl: 'Ruimte voor actieve dagen en rustige avonden',
    sv: 'Utrymme för aktiva dagar och lugna kvällar'
  },
  stayBody: {
    en: 'AMARA Family & Surf welcomes up to four guests with sea views, a private terrace, pool access and a reserved underground parking space.',
    de: 'AMARA Family & Surf bietet bis zu vier Gästen Meerblick, eine private Terrasse, Poolzugang und einen reservierten Tiefgaragenstellplatz.',
    es: 'AMARA Family & Surf recibe hasta cuatro huéspedes con vistas al mar, terraza privada, acceso a piscina y plaza reservada en garaje subterráneo.',
    nl: 'AMARA Family & Surf biedt plaats aan maximaal vier gasten, met zeezicht, privéterras, toegang tot het zwembad en een gereserveerde ondergrondse parkeerplaats.',
    sv: 'AMARA Family & Surf välkomnar upp till fyra gäster med havsutsikt, privat terrass, tillgång till pool och reserverad plats i garage.'
  },
  viewStay: {
    en: 'View Family & Surf',
    de: 'Family & Surf ansehen',
    es: 'Ver Family & Surf',
    nl: 'Bekijk Family & Surf',
    sv: 'Visa Family & Surf'
  },
  availability: {
    en: 'Check availability',
    de: 'Verfügbarkeit prüfen',
    es: 'Consultar disponibilidad',
    nl: 'Beschikbaarheid bekijken',
    sv: 'Se tillgänglighet'
  },
  imageAlt: {
    en: 'Living space at AMARA Family & Surf in Tarifa',
    de: 'Wohnbereich bei AMARA Family & Surf in Tarifa',
    es: 'Salón de AMARA Family & Surf en Tarifa',
    nl: 'Woonruimte van AMARA Family & Surf in Tarifa',
    sv: 'Vardagsrum på AMARA Family & Surf i Tarifa'
  }
} satisfies Record<string, LocalizedText>;

const footerHighlights = [
  { token: 'location_tarifa', label: 'Tarifa' },
  { token: 'tarifa_wind_kitesurfing_authority', label: t(tarifaGuideContent.wind.navLabel) },
  { token: 'tarifa_beaches_authority', label: t(tarifaGuideContent.beaches.navLabel) }
];
---

<LocationAuthorityLayout
  seo={content.seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    currentLang={currentLang}
    brandName="Tarifa"
    languageToken={content.token}
    locationAuthorityNav={true}
  />
  <TarifaContextNav
    activeId={content.id}
    currentLabel={t(content.breadcrumbLabel)}
    lang={currentLang}
  />

  <article class="am-root bg-surface" data-am-page={`tarifa-${content.id}`}>
    <header class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-5xl">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
            {t(content.hero.eyebrow)}
          </p>
          <h1 class="am-text-display mt-7 max-w-5xl text-balance text-on-surface">
            {t(content.hero.title)}
          </h1>
          <p class="am-text-title mt-9 max-w-4xl text-balance leading-relaxed text-on-surface-variant">
            {t(content.hero.lead)}
          </p>
          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-border-subtle pt-6 font-label text-[10px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant">
            <span>{content.seo.article?.authorName}</span>
            <span>{t(content.hero.updated)}</span>
            <span class="normal-case tracking-normal">{t(content.hero.editorialNote)}</span>
          </div>
        </div>
      </div>
    </header>

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-8 md:px-12">
      <dl class="mx-auto grid max-w-screen-2xl gap-8 md:grid-cols-3">
        {content.facts.map((fact) => (
          <div class="border-l border-primary/25 pl-5">
            <dt class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-on-surface-variant">
              {t(fact.label)}
            </dt>
            <dd class="am-text-subtitle mt-2 text-on-surface">{t(fact.value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {content.sections.map((section, sectionIndex) => (
      <section
        id={section.id}
        class:list={[
          'border-b border-border-subtle px-6 py-20 md:px-12 md:py-28',
          sectionIndex % 2 === 0 ? 'bg-surface' : 'bg-surface-container-low'
        ]}
      >
        <div class="mx-auto max-w-screen-2xl">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-20">
            <div class="max-w-xl">
              <p class="font-label text-[11px] font-bold uppercase tracking-[0.16em] text-primary">
                {t(section.eyebrow)}
              </p>
              <h2 class="am-text-title mt-5 text-balance text-on-surface">{t(section.title)}</h2>
              <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{t(section.intro)}</p>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              {section.cards.map((card) => (
                <section class="border-t border-border-subtle bg-surface/70 px-5 pb-7 pt-6">
                  <p class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary">
                    {t(card.kicker)}
                  </p>
                  <h3 class="am-text-subtitle mt-4 text-on-surface">{t(card.title)}</h3>
                  <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{t(card.text)}</p>
                </section>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))}

    <aside class="bg-inverse-surface px-6 py-16 text-inverted-on-surface md:px-12 md:py-20">
      <div class="mx-auto grid max-w-screen-2xl gap-8 lg:grid-cols-[0.65fr_1.35fr] lg:gap-20">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.16em] text-primary-fixed-dim">
          {t(content.notice.eyebrow)}
        </p>
        <div>
          <h2 class="am-text-title text-balance text-inverted-on-surface">{t(content.notice.title)}</h2>
          <p class="am-text-body mt-6 max-w-4xl leading-relaxed text-inverted-on-surface/75">
            {t(content.notice.text)}
          </p>
        </div>
      </div>
    </aside>

    <section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <h2 class="am-text-title text-on-surface">{t(ui.faq)}</h2>
        <div class="divide-y divide-border-subtle border-y border-border-subtle">
          {content.faq.map((item) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 am-text-subtitle text-on-surface">
                <span>{t(item.question)}</span>
                <span aria-hidden="true" class="mt-1 text-primary transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="am-text-body max-w-3xl pb-2 pt-5 leading-relaxed text-on-surface-variant">
                {t(item.answer)}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface-container-low px-6 py-16 md:px-12 md:py-20">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.16em] text-primary">
            {t(ui.sourcesEyebrow)}
          </p>
          <h2 class="am-text-title mt-5 text-on-surface">{t(ui.sourcesTitle)}</h2>
          <p class="am-text-body mt-5 max-w-xl leading-relaxed text-on-surface-variant">
            {t(ui.sourcesBody)}
          </p>
        </div>
        <ul class="divide-y divide-border-subtle border-y border-border-subtle">
          {content.sources.map((source) => (
            <li>
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-6 py-5 am-text-body text-on-surface transition-colors hover:text-primary"
              >
                <span>{t(source.label)}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-screen-2xl">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.16em] text-primary">
          {t(ui.relatedEyebrow)}
        </p>
        <h2 class="am-text-title mt-5 text-on-surface">{t(ui.relatedTitle)}</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {relatedGuides.map((guide) => (
            <a
              href={requiredLink(guide.token)}
              class="group border border-border-subtle bg-surface-container-low p-7 transition-colors hover:border-primary/40"
            >
              <h3 class="am-text-subtitle text-on-surface">{t(guide.breadcrumbLabel)}</h3>
              <span class="mt-6 inline-flex font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary">
                {t(ui.readGuide)} <span aria-hidden="true" class="ml-2 transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface-container-low px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto grid max-w-screen-2xl overflow-hidden bg-surface lg:grid-cols-2">
        <figure class="min-h-[360px] bg-surface-container-high lg:min-h-[560px]">
          <AmaraImage
            src={tarifaStayImage}
            alt={t(ui.imageAlt)}
            profile="hero"
            class="h-full w-full object-cover"
            sizes="(max-width: 1023px) 100vw, 50vw"
          />
        </figure>
        <div class="flex flex-col justify-center p-8 md:p-14 lg:p-16">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.16em] text-primary">
            {t(ui.stayEyebrow)}
          </p>
          <h2 class="am-text-title mt-6 text-balance text-on-surface">{t(ui.stayTitle)}</h2>
          <p class="am-text-body mt-6 max-w-xl leading-relaxed text-on-surface-variant">{t(ui.stayBody)}</p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={stayHref} class="am-btn am-btn--primary">{t(ui.viewStay)}</a>
            <a href={bookHref} class="am-btn am-btn--secondary">{t(ui.availability)}</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</LocationAuthorityLayout>
