---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import nerjaStayImage from '../../assets/images/home/amara-playa-chaparril-13.webp';
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import LocationGuideIcon, {
  type LocationGuideIconName
} from '../../components/location/LocationGuideIcon.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import { gettingToNerjaContent, gettingToNerjaSeo } from '../../content/gettingToNerjaContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import AuthorityArticle from './AuthorityArticle.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = gettingToNerjaContent[currentLang];
const requiredLink = createRequiredLinkResolver(currentLang, 'Getting to Nerja');
const aboutHref = requiredLink('about');
const locationHref = requiredLink('location_nerja');
const areasHref = requiredLink('nerja_where_to_stay');
const [
  arrivalChoiceSection,
  carSection,
  busSection,
  airportSection,
  withoutCarSection,
  beachesSection,
  dayTripsSection,
  parkingStrategySection,
  parkingLastMileSection
] = content.sections;
const arrivalOptions: Array<{
  section: typeof carSection;
  icon: LocationGuideIconName;
  surface: string;
}> = [
  { section: carSection, icon: 'rental-car', surface: 'bg-surface' },
  { section: busSection, icon: 'bus', surface: 'bg-surface-container-lowest' },
  { section: airportSection, icon: 'airport', surface: 'bg-surface' }
];
const localMobilityOptions: Array<{
  section: typeof withoutCarSection;
  icon: LocationGuideIconName;
  inverse: boolean;
}> = [
  { section: withoutCarSection, icon: 'walkable', inverse: false },
  { section: dayTripsSection, icon: 'rental-car', inverse: true }
];
const finalMileIcons: LocationGuideIconName[] = ['taxi', 'rental-car', 'walkable'];
const footerHighlights: LabeledLink[] = [
  { token: 'getting_to_nerja', label: content.navLabel },
  { token: 'location_nerja', label: 'Nerja' },
  { token: 'nerja_where_to_stay', label: content.closing.areasLabel }
];
---

<LocationAuthorityLayout seo={gettingToNerjaSeo} pageLang={currentLang} showContextNavigation={false} footerHighlights={footerHighlights}>
  <Navigation slot="navigation" currentLang={currentLang} languageToken="getting_to_nerja" />
  <NerjaContextNav activeId="arrival-mobility" childLabel={content.navLabel} lang={currentLang} />

  <AuthorityArticle
    pageId="getting-to-nerja"
    family="location"
    topic="arrival"
    lang={currentLang}
    hero={content.hero}
    authorName={gettingToNerjaSeo.article!.authorName}
    authorHref={aboutHref}
    facts={content.facts}
    sources={content.sources}
    closing={content.closing}
    primaryCta={{ href: locationHref, label: content.closing.locationLabel }}
    secondaryCta={{ href: areasHref, label: content.closing.areasLabel }}
    presentation="guide"
    guideVisual={{
      eyebrow: content.facts[0].label,
      mark: content.facts[0].value,
      note: content.facts[1]?.value
    }}
  >
    <section
      id={arrivalChoiceSection.id}
      class="scroll-mt-32 border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28"
      data-am-arrival-module="decision"
    >
      <div class="mx-auto max-w-screen-2xl">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-7">
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{arrivalChoiceSection.eyebrow}</p>
            <h2 class="am-text-title mt-6 max-w-4xl text-balance text-on-surface">{arrivalChoiceSection.title}</h2>
          </div>
          <div class="self-end border-l-2 border-primary/35 bg-surface-container-low px-6 py-6 lg:col-span-5">
            <p class="am-text-subtitle leading-relaxed text-on-surface"><InlineEmphasis text={arrivalChoiceSection.paragraphs[0]} /></p>
          </div>
        </div>

        <div class="mt-12 grid gap-8 border-t border-border-subtle pt-8 md:grid-cols-2 lg:ml-[42%] lg:mt-16">
          {arrivalChoiceSection.paragraphs.slice(1).map((paragraph) => (
            <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
          ))}
        </div>

        <div class="mt-16 grid overflow-hidden border border-border-subtle bg-border-subtle lg:grid-cols-3">
          {arrivalOptions.map(({ section, icon, surface }, optionIndex) => (
            <article
              id={section.id}
              class:list={[
                'min-w-0 scroll-mt-32 p-7 md:p-9 lg:p-10',
                surface,
                optionIndex > 0 && 'border-t border-border-subtle lg:border-l lg:border-t-0'
              ]}
              data-am-arrival-option={section.id}
            >
              <div class="flex items-center justify-between gap-5 text-primary">
                <LocationGuideIcon name={icon} class="h-7 w-7" />
                <span class="font-serif text-4xl leading-none text-primary/55">{String(optionIndex + 1).padStart(2, '0')}</span>
              </div>
              <p class="mt-8 font-label text-[10px] font-bold uppercase tracking-[0.16em] text-primary">{section.eyebrow}</p>
              <h3 class="am-text-subtitle mt-4 text-balance text-on-surface">{section.title}</h3>
              <p class="am-text-body mt-7 font-medium leading-relaxed text-on-surface"><InlineEmphasis text={section.paragraphs[0]} /></p>
              <div class="mt-8 space-y-5 border-t border-border-subtle pt-7">
                {section.paragraphs.slice(1).map((paragraph) => (
                  <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border-subtle bg-inverse-surface px-6 py-16 md:px-12 md:py-20" data-am-arrival-module="property-anchor">
      <div class="mx-auto grid max-w-screen-2xl overflow-hidden lg:grid-cols-[0.9fr_1.1fr]">
        <figure class="am-mobile-full-bleed min-h-[320px] bg-surface-container-high lg:min-h-[500px]">
          <AmaraImage src={nerjaStayImage} alt="" profile="gallery" class="h-full w-full object-cover" sizes="(max-width: 1023px) 100vw, 45vw" loading="lazy" decoding="async" />
        </figure>
        <div class="flex flex-col justify-center p-8 text-inverted-on-surface md:p-14 lg:p-16">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary-fixed-dim">AMARA Playa</p>
          <p class="am-text-title mt-5 text-balance text-inverted-on-surface">Calle Castilla Pérez 60 · Nerja</p>
          <p class="am-text-body mt-7 max-w-xl leading-relaxed text-inverted-on-surface/75"><InlineEmphasis text={content.hero.standfirst} /></p>
        </div>
      </div>
    </section>

    <section
      id={beachesSection.id}
      class="scroll-mt-32 border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28"
      data-am-arrival-module="local-orientation"
    >
      <div class="mx-auto grid max-w-screen-2xl gap-12 lg:grid-cols-12 lg:items-center lg:gap-20">
        <div class="lg:col-span-5">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{beachesSection.eyebrow}</p>
          <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{beachesSection.title}</h2>
          <div class="mt-7 space-y-5">
            {beachesSection.paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant"><InlineEmphasis text={paragraph} /></p>
            ))}
          </div>
        </div>

        <figure class="relative min-h-[390px] overflow-hidden bg-surface px-7 py-8 shadow-sm lg:col-span-7 lg:min-h-[520px] lg:px-10 lg:py-10">
          <figcaption class="relative z-10 max-w-sm">
            <p class="font-label text-[10px] font-bold uppercase tracking-[0.16em] text-primary">{content.facts[0].label}</p>
            <p class="am-text-subtitle mt-3 text-on-surface">{content.facts[0].value}</p>
          </figcaption>
          <div class="absolute inset-x-[12%] top-[46%] h-px -rotate-6 bg-primary/35"></div>
          <div class="absolute left-[13%] top-[39%] grid h-16 w-16 place-items-center rounded-full bg-inverse-surface text-inverted-on-surface shadow-lg">
            <LocationGuideIcon name="village" class="h-7 w-7 text-primary-fixed-dim" />
          </div>
          <div class="absolute bottom-[14%] right-[12%] grid h-20 w-20 place-items-center rounded-full bg-primary text-on-primary shadow-lg">
            <LocationGuideIcon name="coast" class="h-8 w-8 text-on-primary" />
          </div>
          <div class="absolute bottom-[12%] left-[9%] max-w-[12rem] border-t border-primary/35 pt-4">
            <p class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary">{content.facts[2].label}</p>
            <p class="am-text-body mt-2 text-on-surface">{content.facts[2].value}</p>
          </div>
          <div class="absolute right-[8%] top-[24%] max-w-[11rem] text-right">
            <p class="font-label text-[10px] font-bold uppercase tracking-[0.14em] text-primary">{content.facts[1].label}</p>
            <p class="am-text-body mt-2 text-on-surface">{content.facts[1].value}</p>
          </div>
        </figure>
      </div>

      <div class="mx-auto mt-14 grid max-w-screen-2xl overflow-hidden border border-border-subtle lg:grid-cols-2">
        {localMobilityOptions.map(({ section, icon, inverse }, index) => (
          <article
            id={section.id}
            class:list={[
              'min-w-0 scroll-mt-32 p-8 md:p-10 lg:p-12',
              inverse ? 'bg-inverse-surface text-inverted-on-surface' : 'bg-surface text-on-surface',
              index > 0 && 'border-t border-border-subtle lg:border-l lg:border-t-0'
            ]}
            data-am-arrival-option={section.id}
          >
            <div class:list={['flex items-center gap-4', inverse ? 'text-primary-fixed-dim' : 'text-primary']}>
              <LocationGuideIcon name={icon} class:list={['h-7 w-7', inverse && 'text-primary-fixed-dim']} />
              <p class="font-label text-[10px] font-bold uppercase tracking-[0.16em]">{section.eyebrow}</p>
            </div>
            <h3 class:list={['am-text-subtitle mt-6 text-balance', inverse ? 'text-inverted-on-surface' : 'text-on-surface']}>{section.title}</h3>
            <div class="mt-7 space-y-5">
              {section.paragraphs.map((paragraph, paragraphIndex) => (
                <p
                  class:list={[
                    'am-text-body',
                    'leading-relaxed',
                    inverse ? 'text-inverted-on-surface/75' : 'text-on-surface-variant'
                  ]}
                >
                  <InlineEmphasis text={paragraph} />
                </p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section
      id={parkingStrategySection.id}
      class="scroll-mt-32 border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28"
      data-am-arrival-module="parking-strategy"
    >
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-5xl">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{parkingStrategySection.eyebrow}</p>
          <h2 class="am-text-title mt-6 text-balance text-on-surface">{parkingStrategySection.title}</h2>
        </div>
        <ol class="mt-14 grid gap-8 lg:grid-cols-3 lg:gap-12">
          {parkingStrategySection.paragraphs.map((paragraph, index) => (
            <li class="min-w-0 border-t border-primary/35 pt-6">
              <span class="font-serif text-5xl leading-none text-primary/55">{String(index + 1).padStart(2, '0')}</span>
              <p class="am-text-body mt-6 hyphens-auto leading-relaxed text-on-surface-variant [overflow-wrap:anywhere]"><InlineEmphasis text={paragraph} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      id={parkingLastMileSection.id}
      class="scroll-mt-32 border-b border-border-subtle bg-surface-container-low px-6 py-20 md:px-12 md:py-28"
      data-am-arrival-module="final-mile"
    >
      <div class="mx-auto max-w-screen-2xl overflow-hidden bg-inverse-surface text-inverted-on-surface">
        <div class="grid lg:grid-cols-[0.8fr_1.2fr]">
          <div class="p-8 md:p-12 lg:p-16">
            <p class="font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary-fixed-dim">{parkingLastMileSection.eyebrow}</p>
            <h2 class="am-text-subtitle mt-6 max-w-xl text-balance text-inverted-on-surface">{parkingLastMileSection.title}</h2>
          </div>
          <ol class="border-t border-inverted-on-surface/15 lg:border-l lg:border-t-0">
            {parkingLastMileSection.paragraphs.map((paragraph, index) => (
              <li class:list={['grid gap-5 p-7 md:grid-cols-[3rem_minmax(0,1fr)] md:p-9', index > 0 && 'border-t border-inverted-on-surface/15']}>
                <div class="flex items-start justify-between gap-3 text-primary-fixed-dim md:block">
                  <LocationGuideIcon name={finalMileIcons[index]} class="h-6 w-6 text-primary-fixed-dim" />
                  <span class="mt-3 hidden font-label text-[10px] font-bold uppercase tracking-[0.14em] md:block">0{index + 1}</span>
                </div>
                <p class="am-text-body min-w-0 hyphens-auto leading-relaxed text-inverted-on-surface/75 [overflow-wrap:anywhere]"><InlineEmphasis text={paragraph} /></p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </AuthorityArticle>
</LocationAuthorityLayout>
