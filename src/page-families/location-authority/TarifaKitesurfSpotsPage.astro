---
import type { ImageMetadata } from 'astro';
import AmaraImage from '../../components/AmaraImage.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import LocationGuideHero from '../../components/location/LocationGuideHero.astro';
import Navigation from '../../components/Navigation.astro';
import { tarifaKitesurfSpotsContent, tarifaKitesurfSpotsSeo } from '../../content/tarifaKitesurfSpotsContent';
import { vacationRentalEntitiesByKey } from '../../content/vacationRentalEntities';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import { resolveLocale } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';
import LocationModule from './LocationModule.astro';

/**
 * Kitesurf spots spoke of the Tarifa cluster. Same section grammar as the
 * wind spoke: `LocationModule` owns gutter and surfaces, each content class
 * gets its own form — spot cards, the decision list, one module per spot with
 * Robert's observation as an attributed quote, a numbered checklist.
 *
 * The illustrated spot map is optional on purpose: the page renders without
 * it, and picks it up as soon as the asset exists under the expected name.
 */
interface Props { lang?: string; }
const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = resolveLocale(tarifaKitesurfSpotsContent, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf spots');
const aboutHref = requiredLink('about');
const stay = vacationRentalEntitiesByKey['amara-family-surf'];
const robertPortrait = '/images/robert-amara-host.jpg';
const heroPhoto = '/images/amara-tarifa/amara-tarifa-apartment23.webp';

const spotMapModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/content/tarifa/tarifa-spots-map.{webp,png,jpg,jpeg}',
  { eager: true }
);
const spotMap = Object.values(spotMapModules)[0]?.default ?? null;
const spotNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<LocationAuthorityLayout seo={tarifaKitesurfSpotsSeo} pageLang={currentLang} showContextNavigation={false} pageFamily="experience-tarifa-guide">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken={content.token}>
    <ExperienceContextNav slot="context-navigation" currentId="kitesurf-spots" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="tarifa-kitesurf-spots" data-am-family="experience" data-am-role="spoke" data-am-topic="kitesurf-spots">
    <LocationGuideHero
      eyebrow={content.hero.eyebrow}
      title={content.hero.headline}
      subtitle={content.hero.subtitle}
      paragraphs={[content.hero.lead]}
      family="experience"
      role="spoke"
      topic="kitesurf-spots"
      visualBreakpoint="lg"
    >
      <EditorialByline slot="meta" lang={currentLang} authorName="Robert Sebastian Böhmer" authorHref={aboutHref} updated={content.hero.updated} note={content.hero.note} />
      <AmaraImage
        slot="visual"
        src={heroPhoto}
        alt={content.hero.imageAlt}
        profile="hero"
        width={1600}
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 1023px) 100vw, 36vw"
        class="aspect-[3/2] w-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </LocationGuideHero>

    <LocationModule id="spot-map" labelledby="spot-map-title" surface="tint" spacing="compact" data-am-topic="orientation">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{content.ui.orientationEyebrow}</p>
          <h2 id="spot-map-title" class="am-text-title mt-5 text-balance text-on-surface">{content.orientation.title}</h2>
        </div>

        {spotMap && (
          <figure class="am-mobile-full-bleed mt-10 md:mx-0 md:w-auto" data-am-spot-map>
            <AmaraImage
              src={spotMap}
              alt={content.orientation.mapAlt}
              profile="hero"
              width={1536}
              widths={[640, 960, 1280, 1536]}
              sizes="(max-width: 1535px) 100vw, 1440px"
              class="w-full bg-surface-container-lowest"
            />
            <figcaption class="am-text-caption mt-4 max-w-3xl px-6 normal-case tracking-normal text-muted sm:px-0">{content.orientation.mapCaption}</figcaption>
          </figure>
        )}

        <dl class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {content.orientation.rows.map((row) => (
            <div
              class:list={[
                'min-w-0 border-l-2 bg-surface px-6 py-6',
                row.id === 'lagoon' ? 'border-on-surface' : 'border-primary/35'
              ]}
              data-spot={row.id}
            >
              <dt>
                <span class:list={['am-text-label am-text-label--sm block', row.id === 'lagoon' ? 'text-on-surface' : 'text-primary']}>{row.role}</span>
                <span class="am-text-subtitle mt-2 block text-on-surface">{row.name}</span>
              </dt>
              <dd class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{row.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </LocationModule>

    <LocationModule id="main-decision" labelledby="decision-title" spacing="compact" data-am-topic="decision">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary">{content.ui.decisionEyebrow}</p>
          <h2 id="decision-title" class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.decision.title}</h2>
          <p class="am-text-body mt-6 max-w-md leading-relaxed text-on-surface-variant">{content.decision.note}</p>
        </div>
        <dl class="lg:col-span-7">
          {content.decision.rows.map((row, index) => (
            <div class:list={['grid gap-2 py-6 md:grid-cols-12 md:gap-8', index > 0 && 'border-t border-border-subtle']} data-decision={row.id}>
              <dt class="am-text-subtitle text-on-surface md:col-span-4">{row.condition}</dt>
              <dd class="am-text-body leading-relaxed text-on-surface-variant md:col-span-8">{row.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </LocationModule>

    {content.sections.map((section, index) => (
      <LocationModule id={section.id} labelledby={`${section.id}-title`} surface={index % 2 === 0 ? 'tint' : 'white'} spacing="compact" data-am-topic="spot">
        <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="am-text-eyebrow text-primary">{content.ui.spotsEyebrow} · {content.ui.spotLabel} {spotNumber(index)}</p>
            <h2 id={`${section.id}-title`} class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{section.title}</h2>
          </div>
          <div class="lg:col-span-7">
            <div class="space-y-5">
              {section.paragraphs.map((paragraph) => <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{paragraph}</p>)}
            </div>
            {section.observation && (
              <figure class:list={['mt-8 flex items-start gap-5 px-6 py-6', index % 2 === 0 ? 'bg-surface' : 'bg-surface-container-low']} data-am-voice="robert">
                <AmaraImage src={robertPortrait} alt={content.ui.portraitAlt} profile="card" width={192} widths={[96, 144, 192]} sizes="4rem" class="h-16 w-16 shrink-0 rounded-full object-cover" focalPoint="50% 32%" />
                <div class="min-w-0">
                  <blockquote class="m-0"><p class="am-text-body max-w-3xl leading-relaxed text-on-surface">{section.observation}</p></blockquote>
                  <figcaption class="am-text-label am-text-label--sm mt-3 text-primary">— {content.observationLabel}</figcaption>
                </div>
              </figure>
            )}
            {section.link && (
              <p class="am-text-body mt-8 max-w-3xl leading-relaxed text-on-surface-variant">
                {section.link.text}{' '}<a class="am-link" href={requiredLink(section.link.token)}>{section.link.label}</a>.
              </p>
            )}
          </div>
        </div>
      </LocationModule>
    ))}

    <LocationModule id="session-check" labelledby="session-check-title" surface="tint" spacing="compact" data-am-topic="checklist">
      <div class="mx-auto max-w-screen-2xl">
        <div class="max-w-3xl">
          <p class="am-text-eyebrow text-primary">{content.ui.checklistEyebrow}</p>
          <h2 id="session-check-title" class="am-text-title mt-5 text-balance text-on-surface">{content.checklist.title}</h2>
        </div>
        <ol class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
          {content.checklist.items.map((item, index) => (
            <li class="flex gap-4 bg-surface px-6 py-6" data-check={item.id}>
              <span aria-hidden="true" class="am-text-data-note mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary">{index + 1}</span>
              <p class="am-text-body leading-relaxed text-on-surface">{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </LocationModule>

    <LocationModule id="sources" labelledby="sources-title" spacing="compact" data-am-topic="sources" data-am-editorial-sources="">
      <div class="mx-auto grid max-w-screen-2xl gap-10 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="am-text-eyebrow text-primary">{content.sources.eyebrow}</p>
          <h2 id="sources-title" class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{content.sources.title}</h2>
          <p class="am-text-caption mt-6 normal-case tracking-normal text-muted">{content.hero.updated}</p>
        </div>
        <div class="lg:col-span-7">
          <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant">{content.sources.text}</p>
          <ul class="mt-8 space-y-4">
            {content.sources.items.map((source) => (
              <li class="border-l-2 border-primary/35 pl-5">
                <a class="am-link am-text-body" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </LocationModule>

    <LocationModule id="amara-family-surf" labelledby="stay-title" surface="tint" spacing="closing" data-am-topic="basecamp">
      <div class="mx-auto max-w-4xl text-center">
        <p class="am-text-eyebrow text-primary">{content.closing.eyebrow}</p>
        <h2 id="stay-title" class="am-text-title mt-5 text-balance text-on-surface">{stay.name}</h2>
        <figure class="mx-auto mt-8 flex max-w-2xl flex-col items-center gap-4" data-am-voice="robert">
          <AmaraImage src={robertPortrait} alt={content.ui.portraitAlt} profile="card" width={192} widths={[96, 144, 192]} sizes="4rem" class="h-16 w-16 rounded-full object-cover" focalPoint="50% 32%" />
          <blockquote class="m-0"><p class="am-text-body leading-relaxed text-on-surface">{content.closing.observation}</p></blockquote>
          <figcaption class="am-text-label am-text-label--sm text-primary">— {content.observationLabel}</figcaption>
        </figure>
        <p class="am-text-body mx-auto mt-7 max-w-3xl leading-relaxed text-on-surface-variant">{content.closing.text}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a class="am-btn am-btn--primary w-full justify-center sm:w-auto" href={requiredLink('tarifa')}>{content.closing.stayLabel}</a>
          <a class="am-btn am-btn--secondary w-full justify-center sm:w-auto" href={requiredLink('book')}>{content.closing.availabilityLabel}</a>
        </div>
      </div>
    </LocationModule>
  </article>
</LocationAuthorityLayout>
