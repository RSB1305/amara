---
import AmaraImage from '../../components/AmaraImage.astro';
import Navigation from '../../components/Navigation.astro';
import EditorialByline from '../../components/editorial/EditorialByline.astro';
import ExperienceContextNav from '../../components/experience/ExperienceContextNav.astro';
import AmaraSection from '../../components/layout/AmaraSection.astro';
import { getAmaraHeroAttributes } from '../../components/hero/heroContract';
import { tarifaKitesurfSpotsContent, tarifaKitesurfSpotsSeo } from '../../content/tarifaKitesurfSpotsContent';
import { vacationRentalEntitiesByKey } from '../../content/vacationRentalEntities';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import { resolveLocale } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';

interface Props { lang?: string; }
const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const content = resolveLocale(tarifaKitesurfSpotsContent, currentLang);
const requiredLink = createRequiredLinkResolver(currentLang, 'Tarifa kitesurf spots');
const aboutHref = requiredLink('about');
const stay = vacationRentalEntitiesByKey['amara-family-surf'];
const heroAttributes = getAmaraHeroAttributes({ family: 'experience', variant: 'authority-editorial', role: 'spoke', topic: 'kitesurf-spots' });
---

<LocationAuthorityLayout seo={tarifaKitesurfSpotsSeo} pageLang={currentLang} showContextNavigation={false} pageFamily="experience-tarifa-guide">
  <Navigation slot="navigation" contextDestination="tarifa" currentLang={currentLang} languageToken={content.token}>
    <ExperienceContextNav slot="context-navigation" currentId="kitesurf-spots" destination="tarifa" lang={currentLang} />
  </Navigation>

  <article class="bg-surface" data-am-page="tarifa-kitesurf-spots" data-am-family="experience" data-am-role="spoke" data-am-topic="kitesurf-spots">
    <header {...heroAttributes} class="px-6 py-16 md:px-12 md:py-24">
      <div class="mx-auto max-w-5xl">
        <p class="am-text-eyebrow text-primary">{content.hero.eyebrow}</p>
        <h1 class="am-text-title mt-7 text-balance italic text-on-surface">{content.hero.title}</h1>
        <p class="am-text-body mt-8 max-w-3xl leading-relaxed text-on-surface-variant">{content.hero.lead}</p>
      {/* The short visible author name uses the existing byline; its portrait is composed locally. */}
      <div class="spot-author mt-10 flex items-start gap-5 am-text-body">
        <a href={aboutHref} rel="author" aria-label="Robert Böhmer" class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-surface-container-low ring-1 ring-outline-variant/35 ring-offset-4 ring-offset-surface">
          <AmaraImage src="/images/robert-amara-host.jpg" alt="Robert Böhmer" profile="card" width={96} widths={[64, 96]} sizes="64px" class="h-full w-full object-cover" focalPoint="50% 32%" />
        </a>
        <EditorialByline lang={currentLang} authorName="Robert Böhmer" authorHref={aboutHref} updated={content.hero.updated} note={content.hero.note} />
      </div>
        <figure class="am-mobile-full-bleed mt-12">
          <AmaraImage src="/images/amara-tarifa/amara-tarifa-apartment23.webp" alt={content.hero.imageAlt} profile="hero" width={1600} widths={[480, 800, 1200, 1600]} sizes="(max-width: 767px) 100vw, 1024px" class="aspect-[16/9] w-full object-cover" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </header>

    <div class="px-6 md:px-12">
      <AmaraSection id="spot-map" family="experience" labelledby="spot-map-title" variant="compact">
        <div class="mx-auto max-w-5xl">
          <h2 id="spot-map-title" class="am-text-title text-balance text-on-surface">{content.orientation.title}</h2>
          <div class="mt-8 overflow-x-auto" role="region" aria-labelledby="spot-map-title" tabindex="0">
            <table class="w-full min-w-[34rem] border-collapse text-left am-text-body text-on-surface-variant">
              <caption class="sr-only">{content.orientation.title}</caption>
              <thead class="bg-surface-container-low text-on-surface">
                <tr>{content.orientation.columns.map((column) => <th scope="col" class="px-4 py-4 am-text-label am-text-label--sm">{column.label}</th>)}</tr>
              </thead>
              <tbody>
                {content.orientation.rows.map((row) => (
                  <tr class="border-b border-border-subtle" data-spot={row.id}>
                    <th scope="row" class="px-4 py-4 am-text-body text-on-surface">{row.name}</th>
                    <td class="px-4 py-4">{row.role}</td>
                    <td class="px-4 py-4">{row.text}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </AmaraSection>

      <AmaraSection id="main-decision" family="experience" labelledby="decision-title" variant="compact">
        <div class="mx-auto max-w-5xl">
          <h2 id="decision-title" class="am-text-title max-w-3xl text-balance text-on-surface">{content.decision.title}</h2>
          <div class="mt-8 overflow-x-auto" role="region" aria-labelledby="decision-title" tabindex="0">
            <table class="w-full min-w-[28rem] border-collapse text-left am-text-body text-on-surface-variant">
              <caption class="sr-only">{content.decision.title}</caption>
              <thead class="bg-surface-container-low text-on-surface">
                <tr>
                  <th scope="col" class="px-4 py-4 am-text-label am-text-label--sm">{content.decision.condition}</th>
                  <th scope="col" class="px-4 py-4 am-text-label am-text-label--sm">{content.decision.orientation}</th>
                </tr>
              </thead>
              <tbody>
                {content.decision.rows.map((row) => (
                  <tr class="border-b border-border-subtle" data-decision={row.id}>
                    <th scope="row" class="px-4 py-4 am-text-body text-on-surface">{row.condition}</th>
                    <td class="px-4 py-4">{row.text}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="am-text-body mt-6 max-w-3xl leading-relaxed text-on-surface-variant">{content.decision.note}</p>
        </div>
      </AmaraSection>

      {content.sections.map((section) => (
        <AmaraSection id={section.id} family="experience" labelledby={`${section.id}-title`} variant="compact">
          <div class="mx-auto max-w-3xl">
            <h2 id={`${section.id}-title`} class="am-text-title text-balance text-on-surface">{section.title}</h2>
            <div class="mt-7 space-y-5 am-text-body leading-relaxed text-on-surface-variant">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {section.observation && (
              <figure class="mt-8">
                <blockquote class="am-text-subtitle italic leading-relaxed text-on-surface"><p>{section.observation}</p></blockquote>
                <figcaption class="am-text-caption mt-4 text-primary">{content.observationLabel}</figcaption>
              </figure>
            )}
            {section.link && (
              <p class="am-text-body mt-7 leading-relaxed text-on-surface-variant">
                {section.link.text}{' '}<a class="am-link" href={requiredLink(section.link.token)}>{section.link.label}</a>.
              </p>
            )}
          </div>
        </AmaraSection>
      ))}

      <AmaraSection id="session-check" family="experience" labelledby="session-check-title" variant="compact">
        <div class="mx-auto max-w-3xl">
          <h2 id="session-check-title" class="am-text-title text-balance text-on-surface">{content.checklist.title}</h2>
          <ul class="mt-7 list-disc space-y-3 pl-5 am-text-body text-on-surface-variant">
            {content.checklist.items.map((item) => <li data-check={item.id}>{item.text}</li>)}
          </ul>
        </div>
      </AmaraSection>

      <aside class="mx-auto max-w-3xl py-10" aria-labelledby="sources-title" data-am-editorial-sources>
        <p class="am-text-eyebrow text-primary">{content.sources.eyebrow}</p>
        <h2 id="sources-title" class="am-text-subtitle mt-4 text-on-surface">{content.sources.title}</h2>
        <p class="am-text-body mt-5 leading-relaxed text-on-surface-variant">{content.sources.text}</p>
        <ul class="mt-5 space-y-4 am-text-body">
          {content.sources.items.map((source) => <li><a class="am-link" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}
        </ul>
        <p class="am-text-caption mt-5 text-muted">{content.hero.updated}</p>
      </aside>

      <AmaraSection id="amara-family-surf" family="experience" variant="closing" surface="tint" labelledby="stay-title">
        <div class="mx-auto max-w-3xl">
          <p class="am-text-eyebrow text-primary">{content.closing.eyebrow}</p>
          <h2 id="stay-title" class="am-text-title mt-5 text-on-surface">{stay.name}</h2>
          <figure class="mt-7">
            <blockquote class="am-text-body leading-relaxed text-on-surface-variant"><p>{content.closing.observation}</p></blockquote>
            <figcaption class="am-text-caption mt-3 text-primary">{content.observationLabel}</figcaption>
          </figure>
          <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{content.closing.text}</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a class="am-btn am-btn--primary" href={requiredLink('tarifa')}>{content.closing.stayLabel}</a>
            <a class="am-btn am-btn--secondary" href={requiredLink('book')}>{content.closing.availabilityLabel}</a>
          </div>
        </div>
      </AmaraSection>
    </div>
  </article>
</LocationAuthorityLayout>

<style>
  /* Keep the existing byline owner intact while composing its short-name portrait locally. */
  .spot-author :global([data-am-component='editorial-byline']) {
    margin-top: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .spot-author :global(a[rel='author'] > span > span) {
    display: inline;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .spot-author :global(a[rel='author'] > span > span:first-child)::after {
    content: ' ';
  }
  .spot-author :global(a[rel='author'] > span > span:last-child)::before {
    content: ' · ';
  }
</style>
