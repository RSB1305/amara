---
import InlineEmphasis from '../../components/text/InlineEmphasis.astro';
import type { LinkToken, RequiredLinkResolver } from '../../lib/linkResolver';

interface RelatedItem {
  token: LinkToken;
  title: string;
  text: string;
  label: string;
}

interface Props {
  title: string;
  items: readonly RelatedItem[];
  resolveHref: RequiredLinkResolver;
  surface?: 'plain' | 'tint';
}

const { title, items, resolveHref, surface = 'plain' } = Astro.props;
---

<section class:list={['am-section', surface === 'tint' ? 'am-section--tint' : 'am-section--plain']}>
  <div class="mb-12 max-w-3xl">
    <h2 class="am-text-title italic tracking-tight text-on-surface">{title}</h2>
  </div>
  <div class="grid grid-cols-1 gap-x-16 gap-y-12 lg:grid-cols-2">
    {items.map((item) => (
      <article class="border-t border-outline-variant/25 pt-8">
        <h3 class="am-text-subtitle text-on-surface">{item.title}</h3>
        <p class="mt-4 am-text-body leading-relaxed text-on-surface-variant">
          <InlineEmphasis text={item.text} />
        </p>
        <p class="mt-6">
          <a href={resolveHref(item.token)} class="am-inline-link">
            {item.label}<span aria-hidden="true"> →</span>
          </a>
        </p>
      </article>
    ))}
  </div>
</section>
