---
import Hero from '../../components/Hero.astro';
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  frigilianaOrNerjaContent,
  frigilianaOrNerjaSeo
} from '../../content/frigilianaOrNerjaContent';
import { stayCollectionLabels } from '../../content/stayCollectionLabels';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const copy = frigilianaOrNerjaContent[currentLang];

const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana or Nerja');

const links = {
  frigilianaLocation: requiredLink('location_frigiliana'),
  nerjaLocation: requiredLink('location_nerja'),
  frigilianaStairs: requiredLink('frigiliana_stairs'),
  romanticHideaways: requiredLink('romantic_hideaways'),
  playa: requiredLink('playa'),
  gettingToFrigiliana: requiredLink('getting_to_frigiliana')
};

const footerLabels: Record<
  AmaraLanguage,
  { frigiliana: string; nerja: string }
> = {
  en: {
    frigiliana: 'Frigiliana guide',
    nerja: 'Nerja guide'
  },
  de: {
    frigiliana: 'Frigiliana-Guide',
    nerja: 'Nerja-Guide'
  },
  es: {
    frigiliana: 'Guía de Frigiliana',
    nerja: 'Guía de Nerja'
  },
  nl: {
    frigiliana: 'Frigiliana-gids',
    nerja: 'Nerja-gids'
  },
  sv: {
    frigiliana: 'Guide till Frigiliana',
    nerja: 'Guide till Nerja'
  }
};

const footer = footerLabels[currentLang];
const footerHighlights: LabeledLink[] = [
  {
    token: 'romantic_hideaways',
    label: stayCollectionLabels.structuralName[currentLang]
  },
  {
    token: 'location_frigiliana',
    label: footer.frigiliana
  },
  {
    token: 'location_nerja',
    label: footer.nerja
  }
];

const heroImage = {
  src: '/images/amara-frigiliana-pueblo/JPG_Frigiliana_Pueblo/2000px_72dpi_sRGB/02-frigiliana-pueblo.jpg',
  width: 2000,
  height: 1333
};
---

<LocationAuthorityLayout
  seo={frigilianaOrNerjaSeo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="nerja_vs_frigiliana"
    locationAuthorityNav={true}
  />
  <LocationContextNav activeId="comparison" lang={currentLang} />

  <div data-am-page="frigiliana-or-nerja">
    <div class="w-full">
      <div id="intro">
        <Hero
          imageSrc={heroImage.src}
          imageAlt={copy.hero.imageAlt}
          imageWidth={heroImage.width}
          imageHeight={heroImage.height}
        >
          <span class="am-text-caption text-primary mb-8 block">
            {copy.hero.eyebrow}
          </span>
          <h1 class="am-text-display italic text-on-surface mb-10 tracking-tighter">
            {copy.hero.title}
          </h1>
          <div class="pl-8 md:pl-10 border-l border-primary/20 max-w-3xl space-y-6">
            <p class="am-text-subtitle italic text-on-surface leading-relaxed">
              {copy.hero.lead}
            </p>
            {
              copy.hero.body.map((paragraph) => (
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {paragraph}
                </p>
              ))
            }
          </div>
        </Hero>
      </div>

      <section
        id="core-question"
        class="am-section am-section--tint border-t border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-6 py-24 md:px-12 md:py-32 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-4">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">
              {copy.coreQuestion.eyebrow}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight">
              {copy.coreQuestion.title}
            </h2>
          </div>
          <div class="lg:col-span-7 lg:col-start-6 space-y-6">
            {
              copy.coreQuestion.paragraphs.map((paragraph) => (
                <p class="am-text-body text-on-surface-variant leading-relaxed">
                  {paragraph}
                </p>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="decision-factors"
        class="am-section am-section--plain border-t border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-6 py-24 md:px-12 md:py-36">
          <div class="max-w-3xl mb-16 md:mb-20">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">
              {copy.decisionFactors.eyebrow}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight">
              {copy.decisionFactors.title}
            </h2>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-14 lg:gap-y-20">
            {
              copy.decisionFactors.items.map((factor) => (
                <article class="border-t border-outline-variant/20 pt-8">
                  <div class="flex items-baseline gap-5 mb-8">
                    <span class="am-text-caption text-primary">{factor.number}</span>
                    <h3 class="am-text-subtitle italic text-on-surface">
                      {factor.title}
                    </h3>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-10">
                    <div>
                      <h4 class="am-text-caption uppercase tracking-[0.25em] text-primary mb-4">
                        Frigiliana
                      </h4>
                      <p class="am-text-body text-on-surface-variant leading-relaxed">
                        {factor.frigiliana}
                      </p>
                    </div>
                    <div>
                      <h4 class="am-text-caption uppercase tracking-[0.25em] text-primary mb-4">
                        Nerja
                      </h4>
                      <p class="am-text-body text-on-surface-variant leading-relaxed">
                        {factor.nerja}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="comparison"
        class="am-section am-section--tint border-t border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-6 py-24 md:px-12 md:py-36">
          <div class="max-w-3xl mb-16 md:mb-20">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">
              {copy.comparison.eyebrow}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight">
              {copy.comparison.title}
            </h2>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
            <article class="border-l border-primary/30 pl-7 md:pl-8 py-3">
              <h3 class="am-text-subtitle italic text-on-surface mb-7">
                {copy.comparison.nerja.title}
              </h3>
              <div class="space-y-5 mb-9">
                {
                  copy.comparison.nerja.paragraphs.map((paragraph) => (
                    <p class="am-text-body text-on-surface-variant leading-relaxed">
                      {paragraph}
                    </p>
                  ))
                }
              </div>
              <a href={links.nerjaLocation} class="am-cta-link">
                {copy.comparison.nerja.cta}
              </a>
            </article>

            <article class="border-l border-primary/30 pl-7 md:pl-8 py-3">
              <h3 class="am-text-subtitle italic text-on-surface mb-7">
                {copy.comparison.frigiliana.title}
              </h3>
              <div class="space-y-5 mb-9">
                {
                  copy.comparison.frigiliana.paragraphs.map((paragraph) => (
                    <p class="am-text-body text-on-surface-variant leading-relaxed">
                      {paragraph}
                    </p>
                  ))
                }
              </div>
              <a href={links.frigilianaLocation} class="am-cta-link">
                {copy.comparison.frigiliana.cta}
              </a>
            </article>
          </div>
        </div>
      </section>

      <section
        id="experience-both"
        class="am-section am-section--plain border-t border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-6 py-24 md:px-12 md:py-36 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="am-text-title italic text-on-surface tracking-tight">
              {copy.experienceBoth.title}
            </h2>
          </div>
          <div class="lg:col-span-7 lg:col-start-6">
            <div class="space-y-6">
              {
                copy.experienceBoth.paragraphs.map((paragraph) => (
                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {paragraph}
                  </p>
                ))
              }
            </div>
            <a
              href={links.gettingToFrigiliana}
              class="am-btn am-btn--secondary am-page-cta mt-10 w-full sm:w-auto"
            >
              {copy.experienceBoth.cta}
            </a>
          </div>
        </div>
      </section>

      <section
        id="micro-locations"
        class="am-section am-section--tint border-t border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-6 py-24 md:px-12 md:py-36">
          <div class="max-w-3xl mb-16 md:mb-20">
            <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">
              {copy.microLocations.eyebrow}
            </span>
            <h2 class="am-text-title italic text-on-surface tracking-tight">
              {copy.microLocations.title}
            </h2>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
            <article class="border-t border-outline-variant/20 pt-8">
              <h3 class="am-text-subtitle italic text-on-surface mb-6">
                {copy.microLocations.frigiliana.title}
              </h3>
              <p class="am-text-body text-on-surface-variant leading-relaxed mb-9">
                {copy.microLocations.frigiliana.text}
              </p>
              <a
                href={links.frigilianaStairs}
                class="am-btn am-btn--primary am-page-cta w-full sm:w-auto"
              >
                {copy.microLocations.frigiliana.cta}
              </a>
            </article>

            <article class="border-t border-outline-variant/20 pt-8">
              <h3 class="am-text-subtitle italic text-on-surface mb-6">
                {copy.microLocations.nerja.title}
              </h3>
              <p class="am-text-body text-on-surface-variant leading-relaxed mb-9">
                {copy.microLocations.nerja.text}
              </p>
              <a
                href={links.nerjaLocation}
                class="am-btn am-btn--primary am-page-cta w-full sm:w-auto"
              >
                {copy.microLocations.nerja.cta}
              </a>
            </article>
          </div>
        </div>
      </section>

      <section
        id="amara-stays"
        class="am-section am-section--plain border-t border-outline-variant/5"
      >
        <div class="max-w-screen-2xl mx-auto px-6 py-24 md:px-12 md:py-36">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 mb-16 md:mb-20">
            <div class="lg:col-span-4">
              <span class="am-text-caption uppercase tracking-[0.4em] text-primary block mb-6">
                {copy.amara.eyebrow}
              </span>
              <h2 class="am-text-title italic text-on-surface tracking-tight">
                {copy.amara.title}
              </h2>
            </div>
            <div class="lg:col-span-7 lg:col-start-6 space-y-6">
              {
                copy.amara.paragraphs.map((paragraph) => (
                  <p class="am-text-body text-on-surface-variant leading-relaxed">
                    {paragraph}
                  </p>
                ))
              }
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 border-t border-outline-variant/20 pt-10">
            <div>
              <span class="am-text-caption uppercase tracking-[0.25em] text-primary block mb-6">
                Frigiliana
              </span>
              <a
                href={links.romanticHideaways}
                class="am-btn am-btn--primary am-page-cta w-full sm:w-auto"
              >
                {copy.amara.frigilianaCta}
              </a>
            </div>
            <div>
              <span class="am-text-caption uppercase tracking-[0.25em] text-primary block mb-6">
                Nerja
              </span>
              <a
                href={links.playa}
                class="am-btn am-btn--primary am-page-cta w-full sm:w-auto"
              >
                {copy.amara.nerjaCta}
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</LocationAuthorityLayout>

<style>
  .am-section--plain {
    background-color: var(--color-surface);
  }

  .am-section--tint {
    background-color: var(--color-surface-container-low);
  }

  .am-page-cta {
    line-height: 1.4;
    text-align: center;
    white-space: normal;
  }
</style>
