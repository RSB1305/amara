---
import EditorialClosingCta, {
  type EditorialClosingCtaLink
} from '../../components/editorial/EditorialClosingCta.astro';
import type { AmaraLanguage } from '../../types/seo';
import type { AmaraPageEndFamily, AmaraPageEndRole } from '../../components/page-end/pageEndContract';

interface Props {
  title: string;
  lead: string;
  lang: AmaraLanguage;
  links: EditorialClosingCtaLink[];
  role?: Extract<AmaraPageEndRole, 'editorial-close' | 'next-action' | 'conversion'>;
  family?: AmaraPageEndFamily;
  eyebrow?: string;
  surface?: 'plain' | 'tint';
}

const { title, lead, lang, links, role, family, eyebrow, surface = 'plain' } = Astro.props;
---

<section class:list={['px-6 pt-24 md:px-12 md:pt-32', surface === 'tint' ? 'bg-surface-container-low' : 'bg-surface']}>
  <div class="mx-auto max-w-screen-2xl">
  {eyebrow && <p class="am-text-caption mb-5 text-primary">{eyebrow}</p>}
  <EditorialClosingCta
    title={title}
    lead={lead}
    lang={lang}
    links={links}
    role={role}
    family={family}
  />
  </div>
</section>
