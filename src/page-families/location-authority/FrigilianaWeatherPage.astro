      en: 'Find your AMARA stay',
      de: 'Findet eure AMARA-Unterkunft',
      es: 'Encontrad vuestro alojamiento AMARA',
      nl: 'Vind het AMARA-verblijf dat bij jullie past',
      sv: 'Hitta ert AMARA-boende'
    },
    lead: {
      en: 'Explore the AMARA stays and check availability when one feels right.',
      de: 'Entdeckt die AMARA-Unterkünfte und prüft die Verfügbarkeit, wenn eine zu euch passt.',
      es: 'Descubrid los alojamientos AMARA y consultad la disponibilidad cuando encontréis el que mejor os encaja.',
      nl: 'Ontdek de AMARA-verblijven en bekijk de beschikbaarheid zodra er een bij jullie past.',
      sv: 'Utforska AMARA-boendena och kontrollera tillgängligheten när något känns rätt för er.'
    },
    availabilityCta: {
      en: 'Check Availability',
      de: 'Verfügbarkeit prüfen',
      es: 'Consultar disponibilidad',
      nl: 'Beschikbaarheid bekijken',
      sv: 'Kontrollera tillgänglighet'
    }
  }
};

const t = <T extends Record<AmaraLanguage, string>>(row: T) => row[currentLang] ?? row.en;

const climateMonthLabels: Record<AmaraLanguage, string[]> = {
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  de: ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'],
  es: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
  nl: ['Jan', 'Feb', 'Mrt', 'Apr', 'Mei', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dec'],
  sv: ['Jan', 'Feb', 'Mar', 'Apr', 'Maj', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dec']
};

const climateMonths = locationClimateProfiles.frigiliana.map((month, index) => ({
  month: climateMonthLabels[currentLang][index],
  ...month
}));

const climateSources = [
  {
    label: currentLang === 'de'
      ? 'Climate-Data.org · Monatswerte Frigiliana'
      : currentLang === 'es'
        ? 'Climate-Data.org · valores mensuales de Frigiliana'
        : currentLang === 'nl'
          ? 'Climate-Data.org · maandwaarden Frigiliana'
          : currentLang === 'sv'
            ? 'Climate-Data.org · månadsvärden för Frigiliana'
            : 'Climate-Data.org · Frigiliana monthly values',
    href: climateDataSourceUrls.frigiliana
  }
];

const seasonalLabels = {
  high: currentLang === 'de'
    ? 'Mittl. Maximum'
    : currentLang === 'es'
      ? 'Máxima media'
      : currentLang === 'nl'
        ? 'Gem. maximum'
        : currentLang === 'sv'
          ? 'Medelmaximum'
          : 'Average high',
  low: currentLang === 'de'
    ? 'Mittl. Minimum'
    : currentLang === 'es'
      ? 'Mínima media'
      : currentLang === 'nl'
        ? 'Gem. minimum'
        : currentLang === 'sv'
          ? 'Medelminimum'
          : 'Average low',
  practical: currentLang === 'de'
    ? 'Praktischer Hinweis'
    : currentLang === 'es'
      ? 'Consejo práctico'
      : currentLang === 'nl'
        ? 'Praktische tip'
        : currentLang === 'sv'
          ? 'Praktiskt råd'
          : 'Practical note'
};

const relatedLinks = [
  {
    href: `${locationBase}#where-to-stay`,
    label: t(copy.related.links.stay),
    text: getFrigilianaPreFooterDescription('location_frigiliana', currentLang)
  },
  {
    href: parkingHref,
    label: t(copy.related.links.parking),
    text: getFrigilianaPreFooterDescription('frigiliana_parking', currentLang)
  },
  {
    href: arrivalGuideHref,
    label: t(copy.related.links.arrival),
    text: getFrigilianaPreFooterDescription('arrival_guide', currentLang)
  },
  {
    href: winterStaysHref,
    label: t(copy.related.links.winter),
    text: t(copy.related.links.winterText)
  }
];

---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} showContextNavigation={false}>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken="weather_frigiliana"
  />

  <LocationContextNav activeId="weather" lang={currentLang} />

  <div data-am-page="frigiliana-weather" data-am-family="location" data-am-role="spoke" data-am-topic="weather" data-am-presentation="weather">
    <LocationWeatherHero
      eyebrow={t(copy.header.eyebrow)}
      title={t(copy.header.h1)}
      paragraphs={[t(copy.header.lead)]}
      evidenceEyebrow={t(copy.glance.stats.sun.label)}
      evidenceMark={t(copy.glance.stats.sun.value)}
      evidenceNote={t(copy.glance.stats.sun.note)}
    />

    <div class="mx-auto w-full max-w-screen-2xl px-6 py-24 md:px-12 md:py-32">
      <div class="space-y-24">
        {/* 1) Weather at a Glance */}
        <section class="grid gap-10 lg:grid-cols-12 items-start">
          <div class="lg:col-span-8 space-y-6">
            <h2 class="am-text-title italic text-on-surface">{t(copy.glance.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
              {t(copy.glance.intro)}
            </p>
          </div>
          <div class="lg:col-span-4 space-y-4">
            <HairlineStatCard
              icon="temperature"
              label={t(copy.glance.stats.sun.label)}
              value={t(copy.glance.stats.sun.value)}
              description={t(copy.glance.stats.sun.note)}
            />
            <HairlineStatCard
              icon="evening"
              label={t(copy.glance.stats.evening.label)}
              value={t(copy.glance.stats.evening.value)}
              description={t(copy.glance.stats.evening.note)}
            />
            <HairlineStatCard
              icon="rainfall"
              label={t(copy.glance.stats.nights.label)}
              value={t(copy.glance.stats.nights.value)}
              description={t(copy.glance.stats.nights.note)}
            />
          </div>
        </section>

        {/* 2) The Frigiliana Pattern (AI Studio composition) */}
        <section>
          <div class="mb-12 max-w-2xl">
            <h2 class="am-text-title text-on-surface mb-4">{t(copy.pattern.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.pattern.body)}
            </p>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-16">
            {(copy.pattern.facts.title[currentLang] ?? copy.pattern.facts.title.en).map((item, index) => (
              <HairlineStatCard
                icon={patternFactIcons[index]}
                label={item.label}
                value={item.value}
                description={item.description}
                emphasize={item.emphasize}
              />
            ))}
          </div>
        </section>

        {/* 3) Month-by-month climate evidence */}
        <LocationClimateTable
          eyebrow={t(copy.climateData.eyebrow)}
          title={t(copy.climateData.title)}
          intro={t(copy.climateData.intro)}
          months={climateMonths}
          labels={{
            month: t(copy.climateData.labels.month),
            high: t(copy.climateData.labels.high),
            low: t(copy.climateData.labels.low),
            rain: t(copy.climateData.labels.rain),
            sunHours: t(copy.climateData.labels.sunHours)
          }}
          chartLabels={{
            temperature: t(copy.climateData.chartLabels.temperature),
            rainfall: t(copy.climateData.chartLabels.rainfall)
          }}
          sourceTitle={t(copy.climateData.sourceTitle)}
          sourceText={t(copy.climateData.sourceText)}
          sources={climateSources}
        />

        {/* 4) Best Time to Stay */}
        <section>
          <div class="mb-12 max-w-2xl">
            <h2 class="am-text-title text-on-surface mb-4">{t(copy.seasons.title)}</h2>
            <p class="am-text-body text-on-surface-variant leading-relaxed">
              {t(copy.seasons.intro)}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <SeasonalPillar
              eyebrow={currentLang === 'de' ? 'März – Mai' : currentLang === 'es' ? 'Marzo – mayo' : currentLang === 'nl' ? 'Maart – mei' : currentLang === 'sv' ? 'Mars – maj' : 'March - May'}
              title={currentLang === 'de' ? 'Frühling' : currentLang === 'es' ? 'Primavera' : currentLang === 'nl' ? 'Lente' : currentLang === 'sv' ? 'Vår' : 'Spring'}
              subtitle={currentLang === 'de' ? 'Erwachen & Wildblumen' : currentLang === 'es' ? 'Despertar y flores' : currentLang === 'nl' ? 'Ontwaken & wilde bloemen' : currentLang === 'sv' ? 'Uppvaknande & vildblommor' : 'Awakening & Wildflowers'}
              highTemp="≈ 17 °C"
              lowTemp="≈ 11 °C"
              highLabel={seasonalLabels.high}
              lowLabel={seasonalLabels.low}
              practicalLabel={seasonalLabels.practical}
              vibe={currentLang === 'de'
                ? 'Kühle Morgen und warme, helle Nachmittage. Das Tal ist grün – ideal für lange Wanderungen im Naturpark, bevor ihr den Abend auf der Terrasse ausklingen lasst.'
                : currentLang === 'es'
                  ? 'Mañanas frescas y tardes cálidas y luminosas. El valle está verde: ideal para caminatas largas antes de volver a la terraza.'
                  : currentLang === 'nl'
                    ? 'Frisse ochtenden en warme, heldere middagen. De vallei is groen: perfect voor lange wandelingen en daarna ontspanning op het terras.'
                    : currentLang === 'sv'
                      ? 'Krispiga morgnar och varma, ljusa eftermiddagar. Dalen är grön — perfekt för långa vandringar innan terrassen.'
                      : 'Crisp mornings and warm, bright afternoons. The valley turns lush — perfect for long hikes before relaxing on the terrace.'}
              hint={currentLang === 'de'
                ? 'Schichten einpacken; die Abende können noch kühl sein.'
                : currentLang === 'es'
                  ? 'Capas: por la noche aún refresca un poco.'
                : currentLang === 'nl'
                    ? 'Laagjes: ’s avonds kan het nog koel zijn.'
                    : currentLang === 'sv'
                      ? 'Packa lager; kvällar kan fortfarande vara svala.'
                      : 'Pack layers; evenings can still feel cool.'}
            />
            <SeasonalPillar
              eyebrow={currentLang === 'de' ? 'Juni – August' : currentLang === 'es' ? 'Junio – agosto' : currentLang === 'nl' ? 'Juni – augustus' : currentLang === 'sv' ? 'Juni – augusti' : 'June - August'}
              title={currentLang === 'de' ? 'Sommer' : currentLang === 'es' ? 'Verano' : currentLang === 'nl' ? 'Zomer' : currentLang === 'sv' ? 'Sommar' : 'Summer'}
              subtitle={currentLang === 'de' ? 'Heiße Tage & mildere Abende' : currentLang === 'es' ? 'Días calurosos y noches más suaves' : currentLang === 'nl' ? 'Hete dagen & zachtere avonden' : currentLang === 'sv' ? 'Heta dagar & mildare kvällar' : 'Hot Days & Gentler Evenings'}
              highTemp="≈ 26 °C"
              lowTemp="≈ 19 °C"
              highLabel={seasonalLabels.high}
              lowLabel={seasonalLabels.low}
              practicalLabel={seasonalLabels.practical}
              vibe={currentLang === 'de'
                ? 'Im Hochsommer kann es tagsüber heiß werden. Plant offene Wege außerhalb der Mittagshitze und richtet eure Abendpläne nach der aktuellen Vorhersage.'
                : currentLang === 'es'
                  ? 'En pleno verano los días pueden ser calurosos. Dejad los recorridos expuestos fuera de las horas centrales y guiad los planes de tarde por la previsión actual.'
                  : currentLang === 'nl'
                    ? 'Hoogzomerse dagen kunnen heet zijn. Plan open routes buiten de middagwarmte en baseer avondplannen op de actuele verwachting.'
                    : currentLang === 'sv'
                      ? 'Högsommardagar kan vara heta. Planera öppna stråk utanför middagsvärmen och utgå från den aktuella prognosen för kvällen.'
                      : 'High-summer days can be hot. Plan exposed routes outside the midday heat and use the current forecast for evening plans.'}
              hint={currentLang === 'de'
                ? 'Dicke Steinwände helfen, Innenräume natürlich kühler zu halten.'
                : currentLang === 'es'
                  ? 'Las paredes de piedra ayudan a mantener el interior más fresco.'
                  : currentLang === 'nl'
                    ? 'Dikke stenen muren helpen het binnen koeler te houden.'
                    : currentLang === 'sv'
                      ? 'Tjocka stenväggar hjälper interiören att hålla sig sval.'
                      : 'Thick stone walls help keep interiors naturally cooler.'}
            />
            <SeasonalPillar
              eyebrow={currentLang === 'de' ? 'Sept – Nov' : currentLang === 'es' ? 'Sept – nov' : currentLang === 'nl' ? 'Sep – nov' : currentLang === 'sv' ? 'Sep – nov' : 'Sept - Nov'}
              title={currentLang === 'de' ? 'Herbst' : currentLang === 'es' ? 'Otoño' : currentLang === 'nl' ? 'Herfst' : currentLang === 'sv' ? 'Höst' : 'Autumn'}
              subtitle={currentLang === 'de' ? 'Ernte & goldenes Licht' : currentLang === 'es' ? 'Cosecha y luz dorada' : currentLang === 'nl' ? 'Oogst & gouden licht' : currentLang === 'sv' ? 'Skörd & gyllene ljus' : 'Harvest & Golden Light'}
              highTemp="≈ 20 °C"
              lowTemp="≈ 14 °C"
              highLabel={seasonalLabels.high}
              lowLabel={seasonalLabels.low}
              practicalLabel={seasonalLabels.practical}
              isHighlighted={true}
              vibe={currentLang === 'de'
                ? 'Die Hitze kann nachlassen, das Licht wird goldener und die Mango- und Avocadoernte beginnt. Richtet Strandtage nach der aktuellen Wetterlage und den Meeresbedingungen.'
                : currentLang === 'es'
                  ? 'El calor puede aflojar, la luz se vuelve dorada y llega la cosecha de mango y aguacate. Para ir a la playa, consultad el tiempo y el estado actual del mar.'
                  : currentLang === 'nl'
                    ? 'De hitte kan afnemen, het licht wordt goud en de mango- en avocado-oogst begint. Bekijk voor stranddagen het actuele weer en de toestand van de zee.'
                    : currentLang === 'sv'
                      ? 'Värmen kan avta, ljuset blir gyllene och skörden av mango och avokado börjar. Kontrollera aktuellt väder och havsförhållanden inför stranddagar.'
                      : 'Heat can ease, light turns golden, and mango and avocado harvests begin. Check current weather and sea conditions for beach days.'}
              hint={currentLang === 'de'
                ? 'Eine gute Zeit, um bei passenden Bedingungen Strandtage und Wandern zu kombinieren.'
                : currentLang === 'es'
                  ? 'Una buena época para combinar playa y senderismo cuando las condiciones acompañan.'
                  : currentLang === 'nl'
                    ? 'Een goede periode om bij passend weer stranddagen met wandelen te combineren.'
                    : currentLang === 'sv'
                      ? 'En bra period för att kombinera strand och vandring när förhållandena passar.'
                      : 'A useful season for combining beach days with hiking when conditions suit.'}
            />
            <SeasonalPillar
              eyebrow={currentLang === 'de' ? 'Dez – Feb' : currentLang === 'es' ? 'Dic – feb' : currentLang === 'nl' ? 'Dec – feb' : currentLang === 'sv' ? 'Dec – feb' : 'Dec - Feb'}
              title={currentLang === 'de' ? 'Winter' : currentLang === 'es' ? 'Invierno' : currentLang === 'nl' ? 'Winter' : currentLang === 'sv' ? 'Vinter' : 'Winter'}
              subtitle={currentLang === 'de' ? 'Ruhig & klarer Himmel' : currentLang === 'es' ? 'Tranquilo y cielo claro' : currentLang === 'nl' ? 'Rustig & heldere lucht' : currentLang === 'sv' ? 'Lugnt & klar himmel' : 'Quiet & Clear Skies'}
              highTemp="≈ 13 °C"
              lowTemp="≈ 7 °C"
              highLabel={seasonalLabels.high}
              lowLabel={seasonalLabels.low}
              practicalLabel={seasonalLabels.practical}
              vibe={currentLang === 'de'
                ? 'Ruhig, mit wechselnden Winterbedingungen. Sonnige Tage können sich für ein Mittagessen draußen eignen; für den Abend gehören warme Schichten ins Gepäck.'
                : currentLang === 'es'
                  ? 'Tranquilidad y condiciones invernales variables. Los días soleados pueden prestarse a comer fuera; para la tarde conviene llevar capas de abrigo.'
                  : currentLang === 'nl'
                    ? 'Rustig, met wisselende winterse omstandigheden. Op zonnige dagen kan lunch buiten prettig zijn; neem warme lagen mee voor de avond.'
                    : currentLang === 'sv'
                      ? 'Lugnt, med varierande vinterförhållanden. Soliga dagar kan passa för lunch ute; ta med varma lager för kvällen.'
                      : 'Peaceful, with variable winter conditions. Sunny days can suit lunch outside; pack warm layers for the evening.'}
              hint={currentLang === 'de'
                ? 'Perfekt zum Schreiben, Lesen und tiefen Entspannen.'
                : currentLang === 'es'
                  ? 'Perfecto para escribir, leer y desconectar.'
                  : currentLang === 'nl'
                    ? 'Perfect om te schrijven, lezen en diep te ontspannen.'
                    : currentLang === 'sv'
                      ? 'Perfekt för skrivande, läsning och djup vila.'
                      : 'Perfect for writing, reading, and deep relaxation.'}
            />
          </div>
        </section>

        {/* 5) What Overnight Guests Actually Notice */}
        <section class="rounded-editorial border border-outline-variant/10 bg-surface px-10 py-10">
          <h2 class="am-text-title italic text-on-surface">{t(copy.notice.title)}</h2>
          <p class="mt-6 am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
            {t(copy.notice.body)}
          </p>
        </section>

        {/* 5) Practical Interpretation */}
        <section class="space-y-6">
          <h2 class="am-text-title italic text-on-surface">{t(copy.interpretation.title)}</h2>
          <p class="am-text-body text-on-surface-variant leading-relaxed italic max-w-3xl">
            {t(copy.interpretation.body)}
          </p>
        </section>

      </div>
    </div>

    <EditorialGuideLinkSection
      eyebrow={frigilianaPreFooterCopy.eyebrow[currentLang]}
      title={t(copy.related.title)}
      intro={frigilianaPreFooterCopy.intro[currentLang]}
      links={relatedLinks}
    />

    <section class="max-w-screen-2xl mx-auto px-6 md:px-12 pt-8">
      <EditorialClosingCta
        title={t(copy.closing.title)}
        lead={t(copy.closing.lead)}
        lang={currentLang}
        links={[
          {
            token: 'romantic_hideaways',
            label: t(copy.header.cta),
            style: 'primary'
          },
          {
            token: 'book',
            label: t(copy.closing.availabilityCta),
            style: 'secondary'
          }
        ]}
      />
    </section>
  </div>
</LocationAuthorityLayout>
