const parkingHref = buildOwnedLocalizedPath('frigiliana-parking', currentLang);
const winterStaysHref = buildOwnedLocalizedPath('frigiliana-winter-stays', currentLang);

const seo: AmaraAuthoringSeo = {
  version: '2026-04-01-frigiliana-weather-v1.0-A',
