  entityKey: 'amara-brand',
  languages: {
    en: {
      title: 'Frigiliana Weather: Climate & Best Months',
      description:
        'Plan around Frigiliana weather, seasonal conditions, summer heat, walking comfort, and the best months for a relaxed stay.',
      robots: 'index, follow',
      canonical: 'auto'
    },
    de: {
      title: 'Wetter in Frigiliana: Klima & beste Reisezeit',
      description:
        'Plant mit Wetter, Jahreszeiten, Sommerhitze, Gehkomfort und der besten Reisezeit für einen ruhigen Aufenthalt in Frigiliana.',
