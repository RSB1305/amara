const t = <T extends Record<AmaraLanguage, string>>(row: T) => row[currentLang] ?? row.en;

const relatedLinks = [
  {
    href: `${locationBase}#where-to-stay`,
    label: t(copy.related.links.stay),
    text: getFrigilianaPreFooterDescription('location_frigiliana', currentLang)
  },
  {
    href: parkingHref,
    label: t(copy.related.links.parking),
    text: getFrigilianaPreFooterDescription('frigiliana_parking', currentLang)
  },
  {
    href: arrivalGuideHref,
    label: t(copy.related.links.arrival),
    text: getFrigilianaPreFooterDescription('arrival_guide', currentLang)
  },
  {
    href: winterStaysHref,
    label: t(copy.related.links.winter),
    text: t(copy.related.links.winterText)
