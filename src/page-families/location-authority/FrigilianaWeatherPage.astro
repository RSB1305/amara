---
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import {
  getWeatherAuthorityContent,
  getWeatherSeo,
  weatherForecastUrls,
  weatherMonthLabels
} from '../../content/locationWeatherAuthorityContent';
import { climateDataSourceUrls, locationClimateProfiles } from '../../content/locationClimateData';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import WeatherAuthorityBody from './WeatherAuthorityBody.astro';

interface Props { lang?: string; }

const { lang = 'es' } = Astro.props;
const currentLang = normalizeLanguage(lang as AmaraLanguage);
const destination = 'frigiliana' as const;
const content = getWeatherAuthorityContent(destination, currentLang);
const seo = getWeatherSeo(destination);
const requiredLink = createRequiredLinkResolver(currentLang, 'Frigiliana weather');
const months = locationClimateProfiles[destination].map((month, index) => ({
  month: weatherMonthLabels[currentLang][index],
  ...month
}));
---

<LocationAuthorityLayout seo={seo} pageLang={currentLang} showContextNavigation={false}>
  <Navigation slot="navigation" currentLang={currentLang} languageToken="weather_frigiliana" >
    <LocationContextNav slot="context-navigation" activeId="weather" lang={currentLang} />
  </Navigation>
  <WeatherAuthorityBody
    pageId="frigiliana-weather"
    content={content}
    months={months}
    climateSource={{ label: content.sources.links[0].label, href: climateDataSourceUrls[destination] }}
    forecastHref={weatherForecastUrls[destination]}
    resolveHref={requiredLink}
    primaryHref={requiredLink('location_frigiliana')}
    secondaryHref={requiredLink('frigiliana_stairs')}
  />
</LocationAuthorityLayout>
