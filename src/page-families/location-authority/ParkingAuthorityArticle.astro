---
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';
import type { RequiredLinkResolver } from '../../lib/linkResolver';
import type { ParkingGuideLocale } from '../../content/parkingGuideContent';
import AuthorityArticle from './AuthorityArticle.astro';
import AuthorityRelatedLinks from './AuthorityRelatedLinks.astro';
import AuthorityTextSection from './AuthorityTextSection.astro';

interface Props {
  pageId: string;
  lang: AmaraLanguage;
  content: ParkingGuideLocale;
  seo: AmaraAuthoringSeo;
  authorHref: string;
  locationHref: string;
  propertyHref: string;
  resolveHref: RequiredLinkResolver;
}

const {
  pageId,
  lang,
  content,
  seo,
  authorHref,
  locationHref,
  propertyHref,
  resolveHref
} = Astro.props;

const isFrigilianaParking = pageId === 'frigiliana-parking';
---

<AuthorityArticle
  pageId={pageId}
  family="location"
  topic="parking"
  lang={lang}
  hero={content.hero}
  authorName={seo.article!.authorName}
  authorHref={authorHref}
  facts={content.facts}
  sources={content.sources}
  closing={content.closing}
  primaryCta={{ href: propertyHref, label: content.closing.propertyLabel }}
  secondaryCta={{ href: locationHref, label: content.closing.locationLabel }}
  presentation="guide"
  closingRole="next-action"
  closingActionMode="restrained"
  guideSummary={isFrigilianaParking ? undefined : {
    eyebrow: content.navLabel,
    body: content.hero.standfirst
  }}
  guideVisual={isFrigilianaParking ? {
    eyebrow: content.facts[1].label,
    mark: 'P',
    note: content.facts[1].value
  } : undefined}
>
  {content.sections.map((section, index) => (
    <AuthorityTextSection
      section={section}
      index={index}
      presentation="guide"
      data-am-parking-section={section.id}
    />
  ))}

  <AuthorityRelatedLinks
    related={content.related}
    columns="md:grid-cols-3"
    resolveHref={resolveHref}
    presentation="guide"
  />
</AuthorityArticle>
