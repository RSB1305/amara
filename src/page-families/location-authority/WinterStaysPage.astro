---
import { resolveLocale } from '../../types/content';
import Navigation from '../../components/Navigation.astro';
import LocationContextNav from '../../components/location/LocationContextNav.astro';
import NerjaContextNav from '../../components/location/NerjaContextNav.astro';
import TarifaContextNav from '../../components/location/TarifaContextNav.astro';
import {
  frigilianaWinterStaysContent,
  frigilianaWinterStaysSeo
} from '../../content/frigilianaWinterStaysContent';
import {
  nerjaWinterStaysContent,
  nerjaWinterStaysSeo
} from '../../content/nerjaWinterStaysContent';
import {
  tarifaWinterStaysContent,
  tarifaWinterStaysSeo
} from '../../content/tarifaWinterStaysContent';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import { createRequiredLinkResolver, type LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraLanguage } from '../../types/seo';
import type { LocationGuideIconName } from '../../components/location/LocationGuideIcon.astro';
import WinterStaysAuthorityArticle from './WinterStaysAuthorityArticle.astro';

type Destination = 'frigiliana' | 'nerja' | 'tarifa';

interface Props {
  destination: Destination;
  lang?: string;
}

const { destination, lang = 'es' } = Astro.props;

/** One symbol per winter fact. Held per destination because the facts themselves differ. */
const factIconsByDestination: Record<Destination, LocationGuideIconName[]> = {
  frigiliana: ['evening', 'walking-surface', 'longer-stay', 'coast'],
  nerja: ['rainfall', 'distance', 'village', 'coast'],
  tarifa: ['comparison', 'village', 'supermarket', 'rental-car']
};
const currentLang = normalizeLanguage(lang as AmaraLanguage);

const contentByDestination = {
  frigiliana: frigilianaWinterStaysContent,
  nerja: nerjaWinterStaysContent,
  tarifa: tarifaWinterStaysContent
} as const;
const seoByDestination = {
  frigiliana: frigilianaWinterStaysSeo,
  nerja: nerjaWinterStaysSeo,
  tarifa: tarifaWinterStaysSeo
} as const;
const config = {
  frigiliana: {
    resolverName: 'Frigiliana winter stays',
    languageToken: 'frigiliana_winter_stays',
    locationToken: 'location_frigiliana',
    propertyToken: 'book'
  },
  nerja: {
    resolverName: 'Nerja winter stays',
    languageToken: 'nerja_winter_stays',
    locationToken: 'location_nerja',
    propertyToken: 'playa'
  },
  tarifa: {
    resolverName: 'Tarifa winter stays',
    languageToken: 'tarifa_winter_stays',
    locationToken: 'location_tarifa',
    propertyToken: 'tarifa'
  }
} as const;

const content = resolveLocale(contentByDestination[destination], currentLang);
const seo = seoByDestination[destination];
const pageConfig = config[destination];
const requiredLink = createRequiredLinkResolver(currentLang, pageConfig.resolverName);

/**
 * Nerja and Tarifa have one stay each, so their winter call to action opens
 * that apartment. Frigiliana has four and opens the search instead - and the
 * search renders empty unless it is told which place, which reads to a guest
 * as a broken button.
 */
const basePropertyHref = requiredLink(pageConfig.propertyToken);
const propertyHref =
  pageConfig.propertyToken === 'book'
    ? `${basePropertyHref}?destination=${destination}`
    : basePropertyHref;
const footerHighlights: LabeledLink[] = content.related.links
  .slice(0, 3)
  .map(({ token, label }) => ({ token, label }));
---

<LocationAuthorityLayout
  pageFamily="location-winter-stays"
  seo={seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    currentLang={currentLang}
    languageToken={pageConfig.languageToken}
  >
    {destination === 'frigiliana' && (
      <LocationContextNav slot="context-navigation" activeId="winter" lang={currentLang} />
    )}
    {destination === 'nerja' && (
      <NerjaContextNav slot="context-navigation"
        activeId="winter-stays"
        childLabel={content.navLabel}
        lang={currentLang}
      />
    )}
    {destination === 'tarifa' && (
      <TarifaContextNav slot="context-navigation"
        activeId="overview"
        activeChildId="winter-stays"
        currentLabel="Tarifa"
        childLabel={content.navLabel}
        lang={currentLang}
      />
    )}
  </Navigation>

  <WinterStaysAuthorityArticle
    factIcons={factIconsByDestination[destination]}
    pageId={`${destination}-winter-stays`}
    lang={currentLang}
    content={content}
    seo={seo}
    authorHref={requiredLink('about')}
    locationHref={requiredLink(pageConfig.locationToken)}
    propertyHref={propertyHref}
    resolveHref={requiredLink}
  />
</LocationAuthorityLayout>
