---
import AmaraActionLink from '../actions/AmaraActionLink.astro';

export interface EditorialGuideLink {
  href: string;
  label: string;
  text: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  intro: string;
  links: EditorialGuideLink[];
}

const { id, eyebrow, title, intro, links } = Astro.props;
---

<section
  id={id}
  data-am-component="editorial-guide-link-section"
  class="am-section am-section--tint w-full max-w-none mx-0 border-t-0 px-0 py-0"
>
  <div class="max-w-screen-2xl mx-auto px-6 md:px-12 py-32">
    <div class="max-w-3xl mb-16">
      <span class="am-text-section-caption text-primary mb-6">
        {eyebrow}
      </span>
      <h2 class="am-text-title italic text-on-surface tracking-tight mb-6">
        {title}
      </h2>
      <p class="am-text-body text-on-surface-variant leading-relaxed">
        {intro}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
      {
        links.map((link) => (
          <AmaraActionLink href={link.href} variant="guide" class="group">
            <span class="am-text-section-caption text-primary mb-3">
              {link.label}
            </span>
            <p class="am-text-body text-on-surface-variant leading-relaxed transition-colors group-hover:text-on-surface">
              {link.text}
            </p>
          </AmaraActionLink>
        ))
      }
    </div>
  </div>
</section>
