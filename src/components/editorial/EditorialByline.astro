---
import type { AmaraLanguage } from '../../types/seo';
import AmaraImage from '../AmaraImage.astro';

interface Props {
  lang: AmaraLanguage;
  authorName: string;
  authorHref: string;
  updated?: string;
  note?: string;
  /**
   * Optional second author, shown next to the first as a modest co-author credit
   * (e.g. a named partner who co-wrote the page). Role and portrait are passed
   * resolved, since a co-author is not an AMARA host.
   */
  coAuthorName?: string;
  coAuthorRole?: string;
  coAuthorHref?: string;
  coAuthorPortrait?: string;
}

const { lang, authorName, authorHref, updated, note, coAuthorName, coAuthorRole, coAuthorHref, coAuthorPortrait } = Astro.props;
const bylineCopy = {
  en: { prefix: 'By', role: 'Host at AMARA' },
  de: { prefix: 'Von', role: 'Gastgeber bei AMARA' },
  es: { prefix: 'Por', role: 'Anfitrión de AMARA' },
  nl: { prefix: 'Door', role: 'Host bij AMARA' },
  sv: { prefix: 'Av', role: 'Värd på AMARA' }
} satisfies Record<AmaraLanguage, { prefix: string; role: string }>;
const portraitByAuthor = {
  'Robert Sebastian Böhmer': '/images/robert-amara-host.jpg'
} as const;
const portraitSrc = portraitByAuthor[authorName as keyof typeof portraitByAuthor];
const copy = bylineCopy[lang];
const authorLabel = `${copy.prefix} ${authorName} · ${copy.role}`;
const coAuthorLabel = coAuthorName ? `${authorName} · ${coAuthorName}${coAuthorRole ? ` · ${coAuthorRole}` : ''}` : undefined;
---

<div class="mt-10 flex max-w-3xl flex-col gap-8 sm:flex-row sm:items-center sm:justify-between" data-am-component="editorial-byline">
  <div class="flex min-w-0 flex-wrap items-center gap-x-8 gap-y-5">
    <a class="group flex min-w-0 items-center gap-5" href={authorHref} rel="author" aria-label={authorLabel}>
      {portraitSrc && (
        <span class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-surface-container-low ring-1 ring-outline-variant/35 ring-offset-4 ring-offset-surface">
          <AmaraImage
            src={portraitSrc}
            alt=""
            profile="card"
            width={96}
            widths={[64, 96]}
            sizes="64px"
            class="h-full w-full object-cover"
            focalPoint="50% 32%"
            loading="lazy"
            decoding="async"
          />
        </span>
      )}
      <span class="min-w-0">
        <span class="am-text-label am-text-label--sm block text-primary">{copy.prefix}</span>
        <span class="am-text-body mt-1 block text-on-surface transition-colors group-hover:text-primary">{authorName}</span>
        <span class="am-text-label am-text-label--sm mt-1 block text-muted">{copy.role}</span>
      </span>
    </a>
    {coAuthorName && (
      <a class="group flex min-w-0 items-center gap-5" href={coAuthorHref ?? authorHref} rel="author" aria-label={coAuthorLabel}>
        {coAuthorPortrait && (
          <span class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-surface-container-low ring-1 ring-outline-variant/35 ring-offset-4 ring-offset-surface">
            <AmaraImage
              src={coAuthorPortrait}
              alt=""
              profile="card"
              width={96}
              widths={[64, 96]}
              sizes="64px"
              class="h-full w-full object-cover"
              focalPoint="50% 25%"
              loading="lazy"
              decoding="async"
            />
          </span>
        )}
        <span class="min-w-0">
          <span class="am-text-label am-text-label--sm block text-primary" aria-hidden="true">&amp;</span>
          <span class="am-text-body mt-1 block text-on-surface transition-colors group-hover:text-primary">{coAuthorName}</span>
          {coAuthorRole && <span class="am-text-label am-text-label--sm mt-1 block text-muted">{coAuthorRole}</span>}
        </span>
      </a>
    )}
  </div>
  {(updated || note) && (
    <div class="min-w-0 max-w-md">
      {updated && <p class="am-text-label am-text-label--sm text-primary" data-am-byline-updated>{updated}</p>}
      {note && <p class:list={['am-text-body leading-relaxed text-on-surface-variant', updated && 'mt-2']} data-am-byline-note>{note}</p>}
    </div>
  )}
</div>
