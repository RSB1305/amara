---
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
  authorName: string;
  authorHref: string;
  updated: string;
  note: string;
}

const { lang, authorName, authorHref, updated, note } = Astro.props;
const authorLabel = {
  en: `By ${authorName} · Host at AMARA`,
  de: `Von ${authorName} · Gastgeber bei AMARA`,
  es: `Por ${authorName} · Anfitrión de AMARA`,
  nl: `Door ${authorName} · Host bij AMARA`,
  sv: `Av ${authorName} · Värd på AMARA`
} satisfies Record<AmaraLanguage, string>;
---

<div
  class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-border-subtle pt-6 font-label text-[10px] font-bold uppercase tracking-[0.12em] text-on-surface-variant"
  data-am-component="editorial-byline"
>
  <a class="am-link" href={authorHref} rel="author">{authorLabel[lang]}</a>
  <span>{updated}</span>
  <span class="normal-case tracking-normal">{note}</span>
</div>
