---
/**
 * EditorialClosingCta
 *
 * Centered closing headline, lead, optional note, and token-resolved CTA links.
 */
import { resolveOptionalLink } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';

export interface EditorialClosingCtaLink {
  label: string;
  /** When set, label resolves via `resolveLink`. Omit when `disabled` is true. */
  token?: string;
  /** Defaults to the existing editorial text-link treatment. */
  style?: 'text' | 'primary' | 'ghost';
  /** Renders a non-interactive label with the same typographic treatment as links. */
  disabled?: boolean;
}

interface Props {
  title: string;
  lead: string;
  note?: string;
  links: EditorialClosingCtaLink[];
  lang: AmaraLanguage;
}

const { title, lead, note, links, lang } = Astro.props;

const linkClass =
  'am-text-caption uppercase tracking-[0.1em] text-on-surface border-b border-on-surface/20 pb-1 no-underline transition-colors hover:border-on-surface';

const disabledClass =
  'am-text-caption uppercase tracking-[0.1em] text-on-surface border-b border-on-surface/20 pb-1 opacity-60 cursor-default pointer-events-none';
const hasButtonLinks = links.some((link) => link.style === 'primary' || link.style === 'ghost');
---

<section>
  <div class="text-center max-w-[800px] mx-auto pb-20">
    <h2 class="am-text-title text-on-surface mb-8">
      {title}
    </h2>
    <p class={`am-text-body text-subtle ${note ? 'mb-4' : 'mb-16'}`}>
      {lead}
    </p>
    {note ? <p class="italic text-muted mb-16">{note}</p> : null}
    <div class={`flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 ${hasButtonLinks ? '' : 'sm:gap-6'}`}>
      {
        links.map((link, index) => {
          const isDisabled = link.disabled === true || !link.token;
          const href = isDisabled
            ? null
            : resolveOptionalLink(link.token!, lang, { suppressMissing: true });
          const resolvedClass = link.style === 'primary'
            ? 'am-btn am-btn--primary w-full justify-center sm:w-auto'
            : link.style === 'ghost'
              ? 'am-btn am-btn--ghost w-full justify-center sm:w-auto'
              : linkClass;
          return (
            <>
              {index > 0 && !hasButtonLinks && <span class="hidden sm:inline text-on-surface/60">&middot;</span>}
              {!href ? (
                <span class={disabledClass}>{link.label}</span>
              ) : (
                <a href={href} class={resolvedClass}>
                  {link.label}
                </a>
              )}
            </>
          );
        })
      }
    </div>
  </div>
</section>
