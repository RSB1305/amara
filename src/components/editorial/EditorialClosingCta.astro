---
/**
 * EditorialClosingCta
 *
 * Centered closing headline, lead, optional note, and token-resolved CTA links.
 */
import { resolveOptionalLink, type LinkToken } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import InlineEmphasis from '../text/InlineEmphasis.astro';
import { getPageEndAttributes, type AmaraPageEndFamily, type AmaraPageEndRole } from '../page-end/pageEndContract';
import { getTrustFamilyAttributes, type AmaraTrustFamilyId } from '../trust/trustFamilyContract';

export interface EditorialClosingCtaLink {
  label: string;
  /** When set, label resolves via `resolveLink`. Omit when `disabled` is true. */
  token?: LinkToken;
  /** A pre-resolved href for family-owned links that already use the Link Registry. */
  href?: string;
  /** Defaults to the existing editorial text-link treatment. */
  style?: 'text' | 'inline' | 'primary' | 'secondary';
  /** Renders a non-interactive label with the same typographic treatment as links. */
  disabled?: boolean;
}

interface Props {
  title: string;
  titleId?: string;
  lead: string;
  note?: string;
  links: EditorialClosingCtaLink[];
  lang: AmaraLanguage;
  spacing?: 'legacy' | 'page';
  dataComponent?: string;
  role?: Extract<AmaraPageEndRole, 'editorial-close' | 'next-action' | 'conversion'>;
  family?: AmaraPageEndFamily;
  followsFaq?: boolean;
  paragraphs?: string[];
  tone?: 'default' | 'inverse' | 'romance';
  /** Backwards-compatible alias for tone="inverse". */
  inverse?: boolean;
  trustFamily?: AmaraTrustFamilyId;
}

const { title, titleId, lead, note, links, lang, spacing = 'legacy', dataComponent, role, family, followsFaq = false, paragraphs, tone, inverse = false, trustFamily } = Astro.props;

const hasButtonLinks = links.some((link) => link.style === 'primary' || link.style === 'secondary');
const resolvedTone = tone ?? (inverse ? 'inverse' : 'default');
const isInverse = resolvedTone === 'inverse';
const isRomance = resolvedTone === 'romance';
---

<section
  class:list={[
    'am-editorial-closing',
    {
      'am-page-section am-page-section--closing': spacing === 'page',
      'bg-on-surface text-surface': isInverse,
      'am-editorial-closing--romance': isRomance
    }
  ]}
  aria-labelledby={titleId}
  data-am-component={dataComponent}
  {...(trustFamily ? getTrustFamilyAttributes(trustFamily) : {})}
  {...(role && family ? getPageEndAttributes(role, family, followsFaq) : {})}
>
  <div class:list={['text-center max-w-[800px] mx-auto', { 'pb-20': spacing === 'legacy' }]}>
    {isRomance && (
      <div class="am-editorial-closing__hearts" aria-hidden="true">
        <span>❤︎</span><span>❤︎</span><span>❤︎</span>
      </div>
    )}
    <h2 id={titleId} class:list={['am-text-title mb-8', isInverse ? 'text-surface' : 'text-on-surface']}>
      {title}
    </h2>
    {paragraphs ? (
      <div class="mx-auto mb-12 max-w-3xl space-y-5">
        {paragraphs.map((paragraph) => <p class:list={['am-text-body leading-relaxed', isInverse ? 'text-surface/80' : 'text-subtle']}><InlineEmphasis text={paragraph} /></p>)}
      </div>
    ) : <p class={`am-text-body text-subtle ${note ? 'mb-4' : 'mb-16'}`}><InlineEmphasis text={lead} /></p>}
    {note ? <p class="italic text-muted mb-16"><InlineEmphasis text={note} /></p> : null}
    <div class={`flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 ${hasButtonLinks ? '' : 'sm:gap-6'}`}>
      {
        links.map((link, index) => {
          const isDisabled = link.disabled === true || (!link.token && !link.href);
          const href = isDisabled
            ? null
            : link.href ?? resolveOptionalLink(link.token!, lang, { suppressMissing: true });
          const variant = link.style === 'primary'
            ? 'primary'
            : link.style === 'secondary'
              ? 'secondary'
              : link.style === 'inline' ? 'inline' : 'editorial';
          const className = variant === 'primary' || variant === 'secondary'
            ? 'w-full justify-center sm:w-auto'
            : isInverse ? 'text-surface' : undefined;
          return (
            <>
              {index > 0 && !hasButtonLinks && !isInverse && <span class="hidden sm:inline text-on-surface/60">&middot;</span>}
              {!href ? (
                <AmaraActionLink variant="editorial" disabled>{link.label}</AmaraActionLink>
              ) : (
                <AmaraActionLink href={href} variant={variant} class={className}>
                  {link.label}
                </AmaraActionLink>
              )}
            </>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .am-editorial-closing--romance {
    --am-romance-accent: #a23d50;
    --am-romance-ink: #702b39;
    margin-inline: 0;
    background: color-mix(in srgb, var(--am-romance-accent) 11%, var(--color-surface-white));
  }

  .am-editorial-closing__hearts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-block-end: 1.5rem;
    color: var(--am-romance-accent);
    line-height: 1;
  }

  .am-editorial-closing__hearts span:nth-child(1),
  .am-editorial-closing__hearts span:nth-child(3) {
    font-size: 1.1rem;
    opacity: 0.52;
  }

  .am-editorial-closing__hearts span:nth-child(1) {
    transform: rotate(-12deg) translateY(0.15rem);
  }

  .am-editorial-closing__hearts span:nth-child(2) {
    font-size: 1.65rem;
    transform: translateY(-0.1rem);
  }

  .am-editorial-closing__hearts span:nth-child(3) {
    transform: rotate(12deg) translateY(0.15rem);
  }

  .am-editorial-closing--romance :global(.am-cta-link),
  .am-editorial-closing--romance :global(.am-inline-link) {
    color: var(--am-romance-ink);
    border-color: color-mix(in srgb, var(--am-romance-accent) 34%, transparent);
  }

  .am-editorial-closing--romance :global(.am-cta-link:hover),
  .am-editorial-closing--romance :global(.am-inline-link:hover) {
    color: var(--am-romance-accent);
  }
</style>
