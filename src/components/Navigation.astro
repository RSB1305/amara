---
// src/components/Navigation.astro
/**
 * AMARA canonical shared navigation
 *
 * Architectural intent:
 * All page types render the same header geometry. The center navigation and
 * CTA are global so guests see one stable route structure across the site.
 *
 * Typography: This component does not use `am-text-*` for structural copy. The brand
 * wordmark, subline, center nav links, and language dropdown use explicit Tailwind
 * font/size utilities (see `<style>` comment). The CTA remains `.am-btn`.
 */
import { experienceNavigationContent } from '../content/experienceHubContent';
import { resolveLink, resolveOptionalLink } from '../lib/linkResolver';
import { isPublicLinkEnabled } from '../lib/routeOwnership';
import { AMARA_LANGUAGE_LABELS } from '../lib/languageLabels';
import type { AmaraLanguage } from '../types/seo';

interface NavLink {
  token: string;
  label?: string;
  /** Non-interactive “coming soon” row (span + badge); checked before global token disable rules. */
  disabled?: boolean;
  /** Resolves a link even when the token is globally gated (e.g. explore_hub on the homepage). */
  forceEnabled?: boolean;
}

interface Props {
  currentLang: AmaraLanguage;
  brandName: string;
  brandLabel?: string;
  /** Deprecated compatibility input; the global shell ignores page-specific center links. */
  links?: NavLink[];
  /** Deprecated compatibility input; visual variants no longer change the global center navigation. */
  variant?: 'default' | 'trust';
  currentToken?: string;
  languageToken?: string;
  brandVariant?: 'default' | 'lodging';
  showBookingCta?: boolean;
  /**
   * Type A location authority pages: allow Frigiliana / Nerja / experiences hub links in the center
   * row even when those tokens are globally gated as disabled elsewhere.
   */
  locationAuthorityNav?: boolean;
}

const {
  currentLang,
  brandName,
  brandLabel,
  currentToken,
  languageToken,
  brandVariant = 'default',
  showBookingCta = true,
  locationAuthorityNav = false
} = Astro.props;

const languages: { code: AmaraLanguage; label: string }[] = [
  { code: 'en', label: AMARA_LANGUAGE_LABELS.en },
  { code: 'de', label: AMARA_LANGUAGE_LABELS.de },
  { code: 'es', label: AMARA_LANGUAGE_LABELS.es },
  { code: 'nl', label: AMARA_LANGUAGE_LABELS.nl },
  { code: 'sv', label: AMARA_LANGUAGE_LABELS.sv }
];

const defaultBrandLabels: Record<AmaraLanguage, string> = {
  en: 'Guest Guide',
  de: 'Gästeguide',
  es: 'Guía huésped',
  nl: 'Gastgids',
  sv: 'Gästguide'
};

const defaultCtaLabels: Record<AmaraLanguage, string> = {
  en: 'Check Availability',
  de: 'Verfügbarkeit prüfen',
  es: 'Consultar disponibilidad',
  nl: 'Beschikbaarheid checken',
  sv: 'Se tillgänglighet'
};

/** Compact label for the mobile header rail, where space next to the menu trigger is tight. */
const defaultCtaShortLabels: Record<AmaraLanguage, string> = {
  en: 'Book',
  de: 'Buchen',
  es: 'Reservar',
  nl: 'Boeken',
  sv: 'Boka'
};

const navigationUtilityLabels: Record<
  AmaraLanguage,
  { menu: string; closeMenu: string; selectLanguage: string; mobileNavigation: string }
> = {
  en: {
    menu: 'Open menu',
    closeMenu: 'Close menu',
    selectLanguage: 'Select language',
    mobileNavigation: 'Main navigation'
  },
  de: {
    menu: 'Menü öffnen',
    closeMenu: 'Menü schließen',
    selectLanguage: 'Sprache auswählen',
    mobileNavigation: 'Hauptnavigation'
  },
  es: {
    menu: 'Abrir menú',
    closeMenu: 'Cerrar menú',
    selectLanguage: 'Seleccionar idioma',
    mobileNavigation: 'Navegación principal'
  },
  nl: {
    menu: 'Menu openen',
    closeMenu: 'Menu sluiten',
    selectLanguage: 'Taal selecteren',
    mobileNavigation: 'Hoofdnavigatie'
  },
  sv: {
    menu: 'Öppna meny',
    closeMenu: 'Stäng meny',
    selectLanguage: 'Välj språk',
    mobileNavigation: 'Huvudnavigering'
  }
};

const utilityLabels = navigationUtilityLabels[currentLang] ?? navigationUtilityLabels.en;

const globalNavLabels = {
  locations: {
    en: 'Destinations',
    de: 'Reiseziele',
    es: 'Destinos',
    nl: 'Bestemmingen',
    sv: 'Resmål'
  },
  stays: {
    en: 'Stays',
    de: 'Unterkünfte',
    es: 'Alojamientos',
    nl: 'Verblijven',
    sv: 'Boenden'
  },
  aboutAmara: {
    en: 'About us',
    de: 'Über uns',
    es: 'Sobre nosotros',
    nl: 'Over ons',
    sv: 'Om oss'
  },
  locationFrigiliana: {
    en: 'Frigiliana',
    de: 'Frigiliana',
    es: 'Frigiliana',
    nl: 'Frigiliana',
    sv: 'Frigiliana'
  },
  locationNerja: {
    en: 'Nerja',
    de: 'Nerja',
    es: 'Nerja',
    nl: 'Nerja',
    sv: 'Nerja'
  },
  locationTarifa: {
    en: 'Tarifa',
    de: 'Tarifa',
    es: 'Tarifa',
    nl: 'Tarifa',
    sv: 'Tarifa'
  },
  locationFrigilianaMeta: {
    en: 'One of Andalusia’s most beautiful white villages.',
    de: 'Eines der schönsten weißen Dörfer Andalusiens.',
    es: 'Uno de los pueblos blancos más bonitos de Andalucía.',
    nl: 'Een van de mooiste witte dorpen van Andalusië.',
    sv: 'En av Andalusiens vackraste vita byar.'
  },
  locationNerjaMeta: {
    en: 'Mediterranean coast, beaches and the Balcón de Europa.',
    de: 'Mediterraner Küstenort mit Stränden und Balcón de Europa.',
    es: 'Costa mediterránea, playas y el Balcón de Europa.',
    nl: 'Mediterrane kust, stranden en het Balcón de Europa.',
    sv: 'Medelhavskust, stränder och Balcón de Europa.'
  },
  locationTarifaMeta: {
    en: 'Atlantic wind, wide horizons and kitesurfing.',
    de: 'Atlantik-Hotspot für Wind, Weite und Kitesurfen.',
    es: 'Viento atlántico, horizontes abiertos y kitesurf.',
    nl: 'Atlantische wind, weidse horizonten en kitesurfen.',
    sv: 'Atlantvindar, vida horisonter och kitesurfing.'
  },
  allStays: {
    en: 'View all stays',
    de: 'Alle Unterkünfte ansehen',
    es: 'Ver todos los alojamientos',
    nl: 'Alle verblijven bekijken',
    sv: 'Se alla boenden'
  },
  farahMeta: {
    en: 'Private boutique room · 2 guests',
    de: 'Privates Boutique-Zimmer · 2 Gäste',
    es: 'Habitación boutique privada · 2 huéspedes',
    nl: 'Private boutiquekamer · 2 gasten',
    sv: 'Privat boutiquerum · 2 gäster'
  },
  lounisMeta: {
    en: 'Historic apartment · 2 guests',
    de: 'Altstadt-Apartment · 2 Gäste',
    es: 'Apartamento histórico · 2 huéspedes',
    nl: 'Historisch appartement · 2 gasten',
    sv: 'Historisk lägenhet · 2 gäster'
  },
  zaidMeta: {
    en: 'Terrace apartment · 2 guests',
    de: 'Terrassen-Apartment · 2 Gäste',
    es: 'Apartamento con terraza · 2 huéspedes',
    nl: 'Terrasappartement · 2 gasten',
    sv: 'Terrasslägenhet · 2 gäster'
  },
  mahaMeta: {
    en: 'Apartment with large terrace · 2 guests',
    de: 'Apartment mit großer Terrasse · 2 Gäste',
    es: 'Apartamento con gran terraza · 2 huéspedes',
    nl: 'Appartement met groot terras · 2 gasten',
    sv: 'Lägenhet med stor terrass · 2 gäster'
  },
  playaMeta: {
    en: 'Beach apartment · 2 guests',
    de: 'Strandapartment · 2 Gäste',
    es: 'Apartamento de playa · 2 huéspedes',
    nl: 'Strandappartement · 2 gasten',
    sv: 'Strandlägenhet · 2 gäster'
  },
  familySurfMeta: {
    en: 'Holiday house · up to 4 guests',
    de: 'Ferienhaus · bis 4 Gäste',
    es: 'Casa vacacional · hasta 4 huéspedes',
    nl: 'Vakantiehuis · tot 4 gasten',
    sv: 'Semesterhus · upp till 4 gäster'
  },
  aboutMeta: {
    en: 'Our story, values and way of hosting.',
    de: 'Unsere Geschichte, Haltung und Art, Gastgeber zu sein.',
    es: 'Nuestra historia, nuestros valores y nuestra forma de recibir.',
    nl: 'Ons verhaal, onze waarden en onze manier van ontvangen.',
    sv: 'Vår historia, våra värderingar och vårt värdskap.'
  },
  reviewsMeta: {
    en: 'Verified experiences from AMARA guests.',
    de: 'Verifizierte Erfahrungen von AMARA-Gästen.',
    es: 'Experiencias verificadas de huéspedes de AMARA.',
    nl: 'Geverifieerde ervaringen van AMARA-gasten.',
    sv: 'Verifierade upplevelser från AMARA-gäster.'
  },
  directBookingMeta: {
    en: 'Best rate, mid-stay cleaning and direct contact.',
    de: 'Bestpreis, Zwischenreinigung und direkter Kontakt.',
    es: 'Mejor precio, limpieza intermedia y contacto directo.',
    nl: 'Beste prijs, tussentijdse schoonmaak en direct contact.',
    sv: 'Bästa pris, mellanstädning och direktkontakt.'
  },
  amenitiesMeta: {
    en: 'Comfort and services across all stays.',
    de: 'Komfort und Leistungen aller Unterkünfte im Überblick.',
    es: 'Comodidad y servicios de todos los alojamientos.',
    nl: 'Comfort en services van alle verblijven.',
    sv: 'Komfort och service i alla boenden.'
  },
  faqMeta: {
    en: 'Answers about booking, arrival and your stay.',
    de: 'Antworten zu Buchung, Anreise und Aufenthalt.',
    es: 'Respuestas sobre reserva, llegada y estancia.',
    nl: 'Antwoorden over boeken, aankomst en verblijf.',
    sv: 'Svar om bokning, ankomst och vistelse.'
  }
} satisfies Record<string, Record<AmaraLanguage, string>>;

const localizedNavLabels: Partial<Record<string, Record<AmaraLanguage, string>>> = {
  about: {
    en: 'Our Story',
    de: 'Unsere Geschichte',
    es: 'Nuestra historia',
    nl: 'Ons verhaal',
    sv: 'Vår historia'
  },
  reviews_hub: {
    en: 'Guest Reviews',
    de: 'Gästebewertungen',
    es: 'Reseñas de huéspedes',
    nl: 'Gastbeoordelingen',
    sv: 'Gästrecensioner'
  },
  direct_booking_benefits: {
    en: 'Direct Booking Benefits',
    de: 'Vorteile der Direktbuchung',
    es: 'Ventajas de reserva directa',
    nl: 'Voordelen van direct boeken',
    sv: 'Fördelar med direktbokning'
  },
  amenities: {
    en: 'Amenities',
    de: 'Ausstattung',
    es: 'Servicios',
    nl: 'Voorzieningen',
    sv: 'Bekvämligheter'
  },
  faq_general: {
    en: 'Stay FAQ',
    de: 'Aufenthalts-FAQ',
    es: 'FAQ de la estancia',
    nl: 'Verblijfs-FAQ',
    sv: 'FAQ för vistelsen'
  }
};

const ctaLink = {
  token: 'book',
  label: defaultCtaLabels[currentLang],
  shortLabel: defaultCtaShortLabels[currentLang]
};
const currentPath = Astro.url.pathname;
const languageSwitchToken = currentToken ?? languageToken ?? 'home';

const normalizePath = (path: string) => {
  if (path === '/') return '/';
  return path.endsWith('/') ? path.slice(0, -1) : path;
};

function getLanguageHref(token: string, code: AmaraLanguage) {
  try {
    return resolveOptionalLink(token, code, { suppressMissing: true });
  } catch {
    return null;
  }
}

const languageOptions = languages
  .map((lang) => {
    const href = getLanguageHref(languageSwitchToken, lang.code);
    return href ? { ...lang, href } : null;
  })
  .filter((option): option is { code: AmaraLanguage; label: string; href: string } => Boolean(option));

/** Brand always targets the locale homepage, not the current page’s language-switch canonical. */
const getBrandHref = () =>
  resolveOptionalLink('home', currentLang, { suppressMissing: true }) ??
  (currentLang === 'es' ? '/' : `/${currentLang}/`);

const resolvedBrandLabel =
  brandLabel ??
  (brandVariant === 'lodging' ? 'Lodging' : defaultBrandLabels[currentLang]);

const getIsActive = (token: string, href: string) => {
  if (languageToken) {
    return token === languageToken;
  }

  return normalizePath(currentPath) === normalizePath(href);
};

type GlobalNavItem = {
  token: string;
  label: string;
  description?: string;
  sectionLabel?: string;
  separatedSection?: boolean;
  overview?: boolean;
};

type GlobalNavGroup = {
  id: 'locations' | 'stays' | 'aboutAmara';
  label: string;
  items: GlobalNavItem[];
};

const tGlobal = (key: keyof typeof globalNavLabels) =>
  globalNavLabels[key][currentLang] ?? globalNavLabels[key].en;

const experienceNavigation = experienceNavigationContent[currentLang];

const globalNavGroups: GlobalNavGroup[] = [
  {
    id: 'locations',
    label: tGlobal('locations'),
    items: [
      {
        token: 'location_frigiliana',
        label: tGlobal('locationFrigiliana'),
        description: tGlobal('locationFrigilianaMeta')
      },
      {
        token: 'location_nerja',
        label: tGlobal('locationNerja'),
        description: tGlobal('locationNerjaMeta')
      },
      {
        token: 'location_tarifa',
        label: tGlobal('locationTarifa'),
        description: tGlobal('locationTarifaMeta')
      },
      {
        token: 'explore_hub',
        label: experienceNavigation.menuOverviewLabel,
        description: experienceNavigation.menuOverviewDescription,
        sectionLabel: experienceNavigation.menuSectionLabel,
        separatedSection: true
      }
    ]
  },
  {
    id: 'stays',
    label: tGlobal('stays'),
    items: [
      { token: 'romantic_hideaways', label: tGlobal('allStays'), overview: true },
      {
        token: 'farah',
        label: 'Farah',
        description: tGlobal('farahMeta'),
        sectionLabel: tGlobal('locationFrigiliana')
      },
      { token: 'lounis', label: 'Lounis', description: tGlobal('lounisMeta') },
      { token: 'zaid', label: 'Zaid', description: tGlobal('zaidMeta') },
      { token: 'maha', label: 'Maha', description: tGlobal('mahaMeta') },
      {
        token: 'playa',
        label: 'Playa',
        description: tGlobal('playaMeta'),
        sectionLabel: tGlobal('locationNerja')
      },
      {
        token: 'casa',
        label: 'Family & Surf',
        description: tGlobal('familySurfMeta'),
        sectionLabel: tGlobal('locationTarifa')
      }
    ]
  },
  {
    id: 'aboutAmara',
    label: tGlobal('aboutAmara'),
    items: [
      {
        token: 'about',
        label: localizedNavLabels.about?.[currentLang] ?? 'Our Story',
        description: tGlobal('aboutMeta')
      },
      {
        token: 'reviews_hub',
        label: localizedNavLabels.reviews_hub?.[currentLang] ?? 'Guest Reviews',
        description: tGlobal('reviewsMeta')
      },
      {
        token: 'direct_booking_benefits',
        label: localizedNavLabels.direct_booking_benefits?.[currentLang] ?? 'Direct Booking Benefits',
        description: tGlobal('directBookingMeta')
      },
      {
        token: 'amenities',
        label: localizedNavLabels.amenities?.[currentLang] ?? 'Amenities',
        description: tGlobal('amenitiesMeta')
      },
      {
        token: 'faq_general',
        label: localizedNavLabels.faq_general?.[currentLang] ?? 'Stay FAQ',
        description: tGlobal('faqMeta')
      }
    ]
  }
];

const resolveGlobalNavItem = (item: GlobalNavItem) => {
  const canResolve = isPublicLinkEnabled(item.token, {
    forceEnabled: ['location_frigiliana', 'location_nerja', 'location_tarifa'].includes(item.token),
    locationAuthorityNav
  });
  const href = canResolve ? resolveLink(item.token, currentLang) : null;

  return {
    ...item,
    href,
    isActive: href ? getIsActive(item.token, href) : false
  };
};

const resolvedGlobalNavGroups = globalNavGroups.map((group) => {
  const items = group.items.map(resolveGlobalNavItem);

  return {
    ...group,
    items,
    isActive: items.some((item) => item.isActive)
  };
});
---

<header
  class="fixed top-0 left-0 w-full z-[100] px-6 py-5 lg:px-12 lg:py-6 bg-surface/90 backdrop-blur-md border-b border-outline-variant/5"
  data-am-navigation
>
  <nav class="am-nav max-w-screen-2xl mx-auto">
    <div class="am-nav__brand">
      <a href={getBrandHref()} class="group inline-flex flex-col items-center text-center">
        <span class="font-headline italic text-xl text-on-surface tracking-tighter">
          {brandName}
        </span>
        <span class="-mt-1 block text-center font-label text-[8px] uppercase tracking-[0.5em] text-on-surface/40">
          {resolvedBrandLabel}
        </span>
      </a>
    </div>

    <div class="am-nav__center">
      <ul class="hidden lg:flex items-center gap-10">
        {resolvedGlobalNavGroups.map((group) => (
          <li class="am-nav__group">
            <button
              type="button"
              class="am-nav__link am-nav__group-trigger font-label text-[12px] font-bold uppercase tracking-[0.14em] text-on-surface transition-colors"
              aria-haspopup="true"
              aria-current={group.isActive ? 'page' : undefined}
            >
              {group.label}
            </button>

            <div class:list={['am-nav__dropdown', group.items.some((item) => item.description) && 'am-nav__dropdown--detailed']}>
              <div class:list={['am-nav__dropdown-panel', group.items.some((item) => item.description) && 'am-nav__dropdown-panel--detailed']}>
                {group.items.map((item) => (
                  <>
                    {item.sectionLabel && (
                      <span
                        class:list={[
                          'am-nav__dropdown-section',
                          item.separatedSection && 'am-nav__dropdown-section--separated'
                        ]}
                      >
                        {item.sectionLabel}
                      </span>
                    )}
                    {item.href ? (
                      <a
                        href={item.href}
                        class:list={[
                          'am-nav__dropdown-link font-label text-[12px] font-bold uppercase tracking-[0.12em]',
                          item.description && 'am-nav__dropdown-link--detailed',
                          item.overview && 'am-nav__dropdown-link--overview'
                        ]}
                        aria-current={item.isActive ? 'page' : undefined}
                      >
                        <span class="am-nav__dropdown-item-title">{item.label}</span>
                        {item.description && (
                          <span class="am-nav__dropdown-item-meta">{item.description}</span>
                        )}
                      </a>
                    ) : (
                      <span
                        class:list={[
                          'am-nav__dropdown-link am-is-disabled font-label text-[12px] font-bold uppercase tracking-[0.12em]',
                          item.description && 'am-nav__dropdown-link--detailed',
                          item.overview && 'am-nav__dropdown-link--overview'
                        ]}
                        aria-disabled="true"
                      >
                        <span class="am-nav__dropdown-item-title">{item.label}</span>
                        {item.description && (
                          <span class="am-nav__dropdown-item-meta">{item.description}</span>
                        )}
                      </span>
                    )}
                  </>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="am-nav__rail">
      <div class="am-nav__slot am-nav__slot--language">
        <div class="am-nav__language" data-am-language>
          <button
            type="button"
            class="am-nav__icon-button"
            aria-label={utilityLabels.selectLanguage}
            aria-haspopup="true"
            aria-expanded="false"
            data-am-language-trigger
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </button>

          <div class="am-nav__language-popover" data-am-language-panel>
            <div class="min-w-[144px] bg-surface/95 backdrop-blur-md border border-outline-variant/15 rounded-overlay shadow-lg shadow-black/5 py-3 px-3">
              <div class="flex flex-col gap-1">
                {languageOptions.map((lang) => (
                  <a
                    href={lang.href}
                    class={`font-label text-[13px] transition-colors px-2 py-1.5 rounded-md ${
                      currentLang === lang.code
                        ? 'font-bold text-primary bg-primary/5'
                        : 'text-on-surface/70 hover:text-on-surface hover:bg-surface-container-low'
                    }`}
                  >
                    {lang.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      {showBookingCta && (
        <div class="am-nav__slot am-nav__slot--cta">
          {ctaLink && (
            !isPublicLinkEnabled(ctaLink.token) ? (
              <span class="am-btn am-btn--primary am-is-disabled" aria-disabled="true">
                <span class="am-nav__cta-label-full">{ctaLink.label}</span>
                <span class="am-nav__cta-label-short">{ctaLink.shortLabel}</span>
              </span>
            ) : (
              <a
                href={resolveLink(ctaLink.token, currentLang)}
                class="am-btn am-btn--primary"
              >
                <span class="am-nav__cta-label-full">{ctaLink.label}</span>
                <span class="am-nav__cta-label-short">{ctaLink.shortLabel}</span>
              </a>
            )
          )}
        </div>
      )}

      <div class="am-nav__slot am-nav__slot--menu">
        <button
          type="button"
          class="am-nav__icon-button am-nav__menu-trigger"
          aria-label={utilityLabels.menu}
          aria-expanded="false"
          aria-controls="amara-mobile-menu"
          data-label-open={utilityLabels.menu}
          data-label-close={utilityLabels.closeMenu}
          data-am-menu-trigger
        >
          <span class="am-nav__menu-lines" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <div id="amara-mobile-menu" class="am-nav-mobile" data-am-mobile-menu hidden>
    <nav class="am-nav-mobile__inner" aria-label={utilityLabels.mobileNavigation}>
      <div class="am-nav-mobile__groups">
        {resolvedGlobalNavGroups.map((group) => (
          <details class="am-nav-mobile__group" open={group.isActive}>
            <summary class="am-nav-mobile__summary">
              <span>{group.label}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </summary>
            <div class="am-nav-mobile__links">
              {group.items.map((item) => (
                <>
                  {item.sectionLabel && (
                    <span
                      class:list={[
                        'am-nav-mobile__section',
                        item.separatedSection && 'am-nav-mobile__section--separated'
                      ]}
                    >
                      {item.sectionLabel}
                    </span>
                  )}
                  {item.href ? (
                    <a
                      href={item.href}
                      class:list={[
                        item.description && 'am-nav-mobile__detailed-link',
                        item.overview && 'am-nav-mobile__overview-link'
                      ]}
                      aria-current={item.isActive ? 'page' : undefined}
                    >
                      <span class="am-nav-mobile__item-title">{item.label}</span>
                      {item.description && (
                        <span class="am-nav-mobile__item-meta">{item.description}</span>
                      )}
                    </a>
                  ) : (
                    <span
                      class:list={[
                        'am-is-disabled',
                        item.description && 'am-nav-mobile__detailed-link',
                        item.overview && 'am-nav-mobile__overview-link'
                      ]}
                      aria-disabled="true"
                    >
                      <span class="am-nav-mobile__item-title">{item.label}</span>
                      {item.description && (
                        <span class="am-nav-mobile__item-meta">{item.description}</span>
                      )}
                    </span>
                  )}
                </>
              ))}
            </div>
          </details>
        ))}
      </div>

      {showBookingCta && ctaLink && (
        !isPublicLinkEnabled(ctaLink.token) ? (
          <span class="am-btn am-btn--primary am-nav-mobile__cta am-is-disabled" aria-disabled="true">
            {ctaLink.label}
          </span>
        ) : (
          <a href={resolveLink(ctaLink.token, currentLang)} class="am-btn am-btn--primary am-nav-mobile__cta">
            {ctaLink.label}
          </a>
        )
      )}
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-am-navigation]');
    if (!header) return;

    var menuTrigger = header.querySelector('[data-am-menu-trigger]');
    var mobileMenu = header.querySelector('[data-am-mobile-menu]');
    var language = header.querySelector('[data-am-language]');
    var languageTrigger = header.querySelector('[data-am-language-trigger]');

    var setLanguageOpen = function (open) {
      if (!language || !languageTrigger) return;
      language.setAttribute('data-open', open ? 'true' : 'false');
      languageTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    var setMenuOpen = function (open) {
      if (!menuTrigger || !mobileMenu) return;
      mobileMenu.hidden = !open;
      menuTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      menuTrigger.setAttribute(
        'aria-label',
        open ? menuTrigger.getAttribute('data-label-close') : menuTrigger.getAttribute('data-label-open')
      );
      document.documentElement.classList.toggle('am-nav-lock', open);
      setLanguageOpen(false);

      if (open) {
        var firstControl = mobileMenu.querySelector('summary, a');
        if (firstControl) firstControl.focus();
      }
    };

    if (menuTrigger && mobileMenu) {
      menuTrigger.addEventListener('click', function () {
        setMenuOpen(menuTrigger.getAttribute('aria-expanded') !== 'true');
      });

      mobileMenu.addEventListener('click', function (event) {
        var target = event.target;
        if (target && target.closest && target.closest('a')) setMenuOpen(false);
      });
    }

    if (language && languageTrigger) {
      languageTrigger.addEventListener('click', function (event) {
        event.stopPropagation();
        setLanguageOpen(languageTrigger.getAttribute('aria-expanded') !== 'true');
      });
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      if (language && target && language.contains(target)) return;
      setLanguageOpen(false);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      if (menuTrigger && menuTrigger.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        menuTrigger.focus();
        return;
      }
      setLanguageOpen(false);
      if (languageTrigger) languageTrigger.focus();
    });

    var desktopQuery = window.matchMedia('(min-width: 1024px)');
    var handleDesktopChange = function (event) {
      if (event.matches) setMenuOpen(false);
    };
    if (desktopQuery.addEventListener) desktopQuery.addEventListener('change', handleDesktopChange);
  })();
</script>

<style>
