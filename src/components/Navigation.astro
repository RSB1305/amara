---
// src/components/Navigation.astro
/**
 * AMARA canonical shared navigation
 *
 * Architectural intent:
 * All page types render the same header geometry. The center navigation and
 * CTA are global so guests see one stable route structure across the site.
 *
 * This file is the coordinator only: it accepts the public props, builds the
 * resolved navigation model once and composes the three presentation parts.
 * Authored menu content lives in `navigation/globalNavigationContent.ts`, link
 * resolution and active state in `navigation/globalNavigationModel.ts`,
 * interaction in `navigation/globalNavigation.client.ts` and presentation rules
 * in `navigation/global-navigation.css`.
 */
import type { LinkToken } from '../lib/linkResolver';
import type { AmaraLanguage } from '../types/seo';
import GlobalNavigationDesktop from './navigation/GlobalNavigationDesktop.astro';
import GlobalNavigationMobile from './navigation/GlobalNavigationMobile.astro';
import GlobalNavigationUtilities from './navigation/GlobalNavigationUtilities.astro';
import { createGlobalNavigationModel } from './navigation/globalNavigationModel';
import './navigation/global-navigation.css';

interface Props {
  currentLang: AmaraLanguage;
  currentToken?: LinkToken;
  languageToken?: LinkToken;
  showBookingCta?: boolean;
}

const { currentLang, currentToken, languageToken, showBookingCta = true } = Astro.props;

const { brandHref, utilityLabels, groups, languageOptions, cta } = createGlobalNavigationModel({
  currentLang,
  currentPath: Astro.url.pathname,
  currentToken,
  languageToken
});
---

<header
  class="fixed top-0 left-0 w-full z-[100] border-b border-outline-variant/5 bg-surface px-6 py-5 lg:px-12 lg:py-6"
  data-am-navigation
>
  <div class="am-nav max-w-screen-2xl mx-auto">
    <div class="am-nav__brand">
      <a href={brandHref} class="group inline-flex flex-col items-center text-center">
        <span class="font-headline italic text-xl text-on-surface tracking-tighter">
          AMARA
        </span>
        <span class="-mt-1 block text-center font-label text-[8px] uppercase tracking-[0.5em] text-on-surface/40">
          Lodging
        </span>
      </a>
    </div>

    <GlobalNavigationDesktop groups={groups} navigationLabel={utilityLabels.mobileNavigation} />

    <GlobalNavigationUtilities
      currentLang={currentLang}
      languageOptions={languageOptions}
      cta={cta}
      showBookingCta={showBookingCta}
      utilityLabels={utilityLabels}
    />
  </div>

  <GlobalNavigationMobile
    groups={groups}
    cta={cta}
    showBookingCta={showBookingCta}
    navigationLabel={utilityLabels.mobileNavigation}
  />
</header>

<script>
  import './navigation/globalNavigation.client';
</script>
