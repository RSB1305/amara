---
import FooterMinimal from './FooterMinimal.astro';
import FooterCore from './FooterCore.astro';
import type { AmaraLanguage } from '../types/seo';

interface Props {
  currentLang: AmaraLanguage;
  highlights?: { token: string; label: string }[];
  variant?: 'default' | 'trust';
}

const { currentLang, highlights, variant = 'default' } = Astro.props;
---

<div class="footer">
  <FooterMinimal currentLang={currentLang} links={highlights} />
  {variant !== 'trust' && <FooterCore currentLang={currentLang} />}
</div>
