---
import type { LinkToken } from '../lib/linkResolver';
import FooterMinimal from './FooterMinimal.astro';
import FooterCore from './FooterCore.astro';
import type { AmaraLanguage } from '../types/seo';

interface Props {
  currentLang: AmaraLanguage;
  highlights?: { token: LinkToken; label: string }[];
}

const { currentLang, highlights } = Astro.props;
const shouldRenderFooterMinimal = highlights === undefined || highlights.length > 0;
---

<div class="footer">
  {shouldRenderFooterMinimal && <FooterMinimal currentLang={currentLang} links={highlights} />}
  <FooterCore currentLang={currentLang} />
</div>
