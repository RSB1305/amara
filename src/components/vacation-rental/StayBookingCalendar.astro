---
import type { AmaraLanguage } from '../../types/seo';
import type { VacationRentalBookingKey } from '../../content/vacationRentalEntities';
import BookingDateRangeCalendar from '../booking/BookingDateRangeCalendar.astro';
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import AmaraSection from '../layout/AmaraSection.astro';
import AmaraFormControl from '../forms/AmaraFormControl.astro';

interface Props {
  id?: string;
  lang: AmaraLanguage;
  bookingKey: VacationRentalBookingKey;
  stayName: string;
  occupancy: number;
  /**
   * Resilience fallback only. When the gateway cannot answer, a guest must still
   * reach a booking surface; this link is never the equal of the live module.
   */
  fallbackHref?: string;
  fallbackLabel?: string;
}

type LocalizedText = Record<AmaraLanguage, string>;

const {
  id,
  lang,
  bookingKey,
  stayName,
  occupancy,
  fallbackHref,
  fallbackLabel
} = Astro.props;

const copy = {
  kicker: {
    en: 'Live availability',
    de: 'Live-Verfügbarkeit',
    es: 'Disponibilidad en directo',
    nl: 'Live beschikbaarheid',
    sv: 'Live-tillgänglighet'
  },
  // A statement, not a second instruction: the button already asks for dates,
  // and repeating the verb here made the page read as three nested commands.
  title: {
    en: 'Availability and price for {stay}',
    de: 'Verfügbarkeit und Preis für {stay}',
    es: 'Disponibilidad y precio de {stay}',
    nl: 'Beschikbaarheid en prijs voor {stay}',
    sv: 'Tillgänglighet och pris för {stay}'
  },
  // Replaces the former explanatory paragraph: the guest needs the promise, not
  // a description of the mechanism they are about to use.
  assurance: {
    en: 'Live availability · exact total price · no reservation yet',
    de: 'Live-Verfügbarkeit · exakter Gesamtpreis · noch keine Reservierung',
    es: 'Disponibilidad en directo · precio total exacto · sin reserva todavía',
    nl: 'Live beschikbaarheid · exacte totaalprijs · nog geen reservering',
    sv: 'Live-tillgänglighet · exakt totalpris · ingen bokning ännu'
  },
  arrival: {
    en: 'Arrival',
    de: 'Anreise',
    es: 'Llegada',
    nl: 'Aankomst',
    sv: 'Ankomst'
  },
  departure: {
    en: 'Departure',
    de: 'Abreise',
    es: 'Salida',
    nl: 'Vertrek',
    sv: 'Avresa'
  },
  guests: {
    en: 'Guests',
    de: 'Gäste',
    es: 'Huéspedes',
    nl: 'Gasten',
    sv: 'Gäster'
  },
  guestOption: {
    en: '{count} guest',
    de: '{count} Gast',
    es: '{count} huésped',
    nl: '{count} gast',
    sv: '{count} gäst'
  },
  guestOptionPlural: {
    en: '{count} guests',
    de: '{count} Gäste',
    es: '{count} huéspedes',
    nl: '{count} gasten',
    sv: '{count} gäster'
  },
  loading: {
    en: 'Checking the current total price…',
    de: 'Aktueller Gesamtpreis wird geprüft…',
    es: 'Consultando el precio total actual…',
    nl: 'Actuele totaalprijs wordt gecontroleerd…',
    sv: 'Kontrollerar aktuellt totalpris…'
  },
  available: {
    en: 'Available',
    de: 'Verfügbar',
    es: 'Disponible',
    nl: 'Beschikbaar',
    sv: 'Tillgängligt'
  },
  unavailable: {
    en: 'Not available',
    de: 'Nicht verfügbar',
    es: 'No disponible',
    nl: 'Niet beschikbaar',
    sv: 'Inte tillgängligt'
  },
  unavailableBody: {
    en: '{stay} is not available for this stay. Please choose different dates.',
    de: '{stay} ist für diesen Aufenthalt nicht verfügbar. Bitte wählt andere Reisedaten.',
    es: '{stay} no está disponible para esta estancia. Elegid otras fechas.',
    nl: '{stay} is niet beschikbaar voor dit verblijf. Kies andere data.',
    sv: '{stay} är inte tillgängligt för denna vistelse. Välj andra datum.'
  },
  totalPrice: {
    en: 'Total price',
    de: 'Gesamtpreis',
    es: 'Precio total',
    nl: 'Totaalprijs',
    sv: 'Totalpris'
  },
  night: {
    en: '{count} night',
    de: '{count} Nacht',
    es: '{count} noche',
    nl: '{count} nacht',
    sv: '{count} natt'
  },
  nights: {
    en: '{count} nights',
    de: '{count} Nächte',
    es: '{count} noches',
    nl: '{count} nachten',
    sv: '{count} nätter'
  },
  quoteNote: {
    en: 'Current total price for these dates. This check does not create or hold a reservation.',
    de: 'Aktueller Gesamtpreis für diese Reisedaten. Die Prüfung erstellt oder blockiert keine Reservierung.',
    es: 'Precio total actual para estas fechas. La consulta no crea ni bloquea una reserva.',
    nl: 'Actuele totaalprijs voor deze data. Deze controle maakt of blokkeert geen reservering.',
    sv: 'Aktuellt totalpris för dessa datum. Kontrollen skapar eller blockerar ingen bokning.'
  },
  invalidDates: {
    en: 'Choose a valid stay of no more than 45 nights.',
    de: 'Wählt einen gültigen Aufenthalt von höchstens 45 Nächten.',
    es: 'Elegid una estancia válida de un máximo de 45 noches.',
    nl: 'Kies een geldig verblijf van maximaal 45 nachten.',
    sv: 'Välj en giltig vistelse på högst 45 nätter.'
  },
  error: {
    en: 'Live booking data is currently unavailable. Please try again shortly.',
    de: 'Die Live-Buchungsdaten sind derzeit nicht verfügbar. Bitte versucht es in Kürze erneut.',
    es: 'Los datos de reserva en directo no están disponibles ahora. Volved a intentarlo en breve.',
    nl: 'De live boekingsgegevens zijn nu niet beschikbaar. Probeer het zo opnieuw.',
    sv: 'Livebokningsdata är inte tillgängliga just nu. Försök igen om en liten stund.'
  },
  chooseArrival: {
    en: 'Choose arrival', de: 'Anreise wählen', es: 'Elegir llegada', nl: 'Aankomst kiezen', sv: 'Välj ankomst'
  },
  chooseDeparture: {
    en: 'Choose departure', de: 'Abreise wählen', es: 'Elegir salida', nl: 'Vertrek kiezen', sv: 'Välj avresa'
  },
  calendarTitle: {
    en: 'Choose your stay', de: 'Aufenthalt wählen', es: 'Elegid vuestra estancia', nl: 'Kies jullie verblijf', sv: 'Välj er vistelse'
  },
  calendarHelp: {
    en: 'Choose an available arrival date. Nightly prices are indicative; the total price is checked after your departure is selected.',
    de: 'Wählt ein verfügbares Anreisedatum. Übernachtungspreise dienen zur Orientierung; den Gesamtpreis prüfen wir nach Auswahl der Abreise.',
    es: 'Elegid una fecha de llegada disponible. Los precios por noche son orientativos; consultamos el total al elegir la salida.',
    nl: 'Kies een beschikbare aankomstdatum. Nachtprijzen zijn indicatief; na de vertrekkeuze controleren we de totaalprijs.',
    sv: 'Välj ett tillgängligt ankomstdatum. Nattpriserna är vägledande; totalpriset kontrolleras när avresan är vald.'
  },
  departureHelp: {
    en: 'Now choose a departure. Only dates that keep every night available and match the stay rules can be selected.',
    de: 'Wählt jetzt die Abreise. Nur Daten, bei denen jede Nacht verfügbar ist und die Aufenthaltsregeln passen, sind auswählbar.',
    es: 'Elegid ahora la salida. Solo se pueden seleccionar fechas con todas las noches disponibles y que cumplan las reglas de estancia.',
    nl: 'Kies nu het vertrek. Alleen data waarbij elke nacht beschikbaar is en de verblijfsregels passen, zijn selecteerbaar.',
    sv: 'Välj nu avresa. Endast datum där varje natt är tillgänglig och vistelsereglerna uppfylls kan väljas.'
  },
  bookNow: {
    en: 'Book now',
    de: 'Jetzt buchen',
    es: 'Reservar ahora',
    nl: 'Nu boeken',
    sv: 'Boka nu'
  },
  minimumStayHelp: {
    en: 'Minimum stay from this arrival: {count} nights. Available dates remain visible; choose a valid departure.',
    de: 'Mindestaufenthalt ab dieser Anreise: {count} Nächte. Verfügbare Tage bleiben sichtbar; wählt eine mögliche Abreise.',
    es: 'Estancia mínima desde esta llegada: {count} noches. Las fechas disponibles siguen visibles; elegid una salida válida.',
    nl: 'Minimumverblijf vanaf deze aankomst: {count} nachten. Beschikbare data blijven zichtbaar; kies een geldig vertrek.',
    sv: 'Minsta vistelse från denna ankomst: {count} nätter. Tillgängliga datum förblir synliga; välj en giltig avresa.'
  },
  minimumStayViolation: {
    en: 'A minimum stay of {count} nights applies for arrival on {arrival}. Please choose a departure on or after {departure}.',
    de: 'Bei einer Anreise am {arrival} beträgt der Mindestaufenthalt {count} Nächte. Bitte wählt eine Abreise ab dem {departure}.',
    es: 'Para una llegada el {arrival}, la estancia mínima es de {count} noches. Elegid una salida a partir del {departure}.',
    nl: 'Bij aankomst op {arrival} geldt een minimumverblijf van {count} nachten. Kies een vertrek vanaf {departure}.',
    sv: 'Vid ankomst den {arrival} gäller minst {count} nätter. Välj avresa tidigast den {departure}.'
  },
  loadingCalendar: {
    en: 'Loading live availability and nightly prices…',
    de: 'Live-Verfügbarkeit und Übernachtungspreise werden geladen…',
    es: 'Cargando disponibilidad y precios por noche…',
    nl: 'Live beschikbaarheid en nachtprijzen worden geladen…',
    sv: 'Läser in live-tillgänglighet och nattpriser…'
  },
  calendarError: {
    en: 'The live calendar is currently unavailable. No reservation has been created or held.',
    de: 'Der Live-Kalender ist derzeit nicht verfügbar. Es wurde keine Reservierung erstellt oder blockiert.',
    es: 'El calendario en directo no está disponible ahora. No se ha creado ni bloqueado ninguna reserva.',
    nl: 'De live kalender is nu niet beschikbaar. Er is geen reservering gemaakt of geblokkeerd.',
    sv: 'Livekalendern är inte tillgänglig just nu. Ingen bokning har skapats eller blockerats.'
  },
  previousMonth: {
    en: 'Previous month', de: 'Vorheriger Monat', es: 'Mes anterior', nl: 'Vorige maand', sv: 'Föregående månad'
  },
  nextMonth: {
    en: 'Next month', de: 'Nächster Monat', es: 'Mes siguiente', nl: 'Volgende maand', sv: 'Nästa månad'
  },
  closeCalendar: {
    en: 'Close calendar', de: 'Kalender schließen', es: 'Cerrar calendario', nl: 'Kalender sluiten', sv: 'Stäng kalendern'
  },
  clearDates: {
    en: 'Clear dates', de: 'Daten löschen', es: 'Borrar fechas', nl: 'Data wissen', sv: 'Rensa datum'
  },
  availableDay: {
    en: 'available', de: 'verfügbar', es: 'disponible', nl: 'beschikbaar', sv: 'tillgängligt'
  },
  unavailableDay: {
    en: 'not available', de: 'nicht verfügbar', es: 'no disponible', nl: 'niet beschikbaar', sv: 'inte tillgängligt'
  },
  invalidDeparture: {
    en: 'not selectable as departure',
    de: 'nicht als Abreise auswählbar',
    es: 'no seleccionable como salida',
    nl: 'niet selecteerbaar als vertrek',
    sv: 'kan inte väljas som avresa'
  },
  minimumStayDeparture: {
    en: 'minimum stay not reached; select for details',
    de: 'Mindestaufenthalt noch nicht erreicht; für Details auswählen',
    es: 'no se alcanza la estancia mínima; seleccionad para ver los detalles',
    nl: 'minimumverblijf nog niet bereikt; selecteer voor uitleg',
    sv: 'minsta vistelse har inte uppnåtts; välj för mer information'
  },
  selectedArrival: {
    en: 'selected arrival',
    de: 'gewählte Anreise',
    es: 'llegada seleccionada',
    nl: 'gekozen aankomst',
    sv: 'vald ankomst'
  },
  fromPrice: {
    en: 'from {price}', de: 'ab {price}', es: 'desde {price}', nl: 'vanaf {price}', sv: 'från {price}'
  }
} satisfies Record<string, LocalizedText>;

const t = (value: LocalizedText) => value[lang] ?? value.en;
const clientCopy = Object.fromEntries(
  Object.entries(copy).map(([key, value]) => [key, t(value).replace('{stay}', stayName)])
);
const guestOptions = Array.from({ length: occupancy }, (_, index) => index + 1);
const titleId = `${bookingKey}-booking-calendar-title`;
---

<AmaraSection id={id} labelledby={titleId} dataComponent="stay-booking-calendar">
  <div
    data-am-stay-booking-calendar
    data-am-booking-stay={bookingKey}
    data-am-booking-language={lang}
    data-am-booking-copy={JSON.stringify(clientCopy)}
  >
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-14">
    <div class="max-w-xl">
      <p class="am-text-label text-on-surface-variant">
        {t(copy.kicker)}
      </p>
      <h2 id={titleId} class="am-text-subtitle mt-3 text-balance text-on-surface">
        {t(copy.title).replace('{stay}', stayName)}
      </h2>
    </div>

    <div class="am-stay-booking-calendar__panel self-start bg-surface-container-low p-5 sm:p-7">
      <form method="get" data-am-booking-form>
        <div class="grid gap-5 sm:grid-cols-3">
          <label class="block am-stay-booking-calendar__native-date">
            <span class="am-text-label text-on-surface-variant">
              {t(copy.arrival)}
            </span>
            <AmaraFormControl
              as="input"
              name="arrival"
              required
              data={{ 'data-am-booking-arrival': '' }}
            />
          </label>
          <div class="am-stay-booking-calendar__date-trigger" hidden data-am-booking-arrival-trigger-wrap>
            <span class="am-text-label text-on-surface-variant">{t(copy.arrival)}</span>
            <AmaraFormControl
              as="button"
              trigger
              ariaExpanded={false}
              data={{ 'data-am-booking-arrival-trigger': '' }}
            >
              <span data-am-booking-arrival-value>{t(copy.chooseArrival)}</span>
            </AmaraFormControl>
          </div>

          <label class="block am-stay-booking-calendar__native-date">
            <span class="am-text-label text-on-surface-variant">
              {t(copy.departure)}
            </span>
            <AmaraFormControl
              as="input"
              name="departure"
              required
              data={{ 'data-am-booking-departure': '' }}
            />
          </label>
          <div class="am-stay-booking-calendar__date-trigger" hidden data-am-booking-departure-trigger-wrap>
            <span class="am-text-label text-on-surface-variant">{t(copy.departure)}</span>
            <AmaraFormControl
              as="button"
              trigger
              ariaExpanded={false}
              data={{ 'data-am-booking-departure-trigger': '' }}
            >
              <span data-am-booking-departure-value>{t(copy.chooseDeparture)}</span>
            </AmaraFormControl>
          </div>

          <label class="block">
            <span class="am-text-label text-on-surface-variant">
              {t(copy.guests)}
            </span>
            <AmaraFormControl
              as="select"
              name="guests"
              data={{ 'data-am-booking-guests': '' }}
            >
              {guestOptions.map((count) => (
                <option value={count} selected={count === Math.min(2, occupancy)}>
                  {t(count === 1 ? copy.guestOption : copy.guestOptionPlural).replace('{count}', String(count))}
                </option>
              ))}
            </AmaraFormControl>
          </label>
        </div>

        <BookingDateRangeCalendar
          title={t(copy.calendarTitle)}
          help={t(copy.calendarHelp)}
          closeLabel={t(copy.closeCalendar)}
          previousMonthLabel={t(copy.previousMonth)}
          nextMonthLabel={t(copy.nextMonth)}
          clearLabel={t(copy.clearDates)}
        />

      </form>

      <p class="am-text-caption mt-5 font-normal leading-relaxed text-on-surface-variant">
        {t(copy.assurance)}
      </p>

      <div
        class="am-stay-booking-calendar__result mt-6 border border-border-subtle bg-surface p-5"
        role="status"
        aria-live="polite"
        hidden
        data-am-booking-result
      >
        <p class="am-text-label text-on-surface-variant" data-am-booking-status></p>
        <p class="am-text-body mt-3 text-on-surface" data-am-booking-summary></p>
        <div class="mt-5 border-t border-border-subtle pt-4" hidden data-am-booking-price-wrap>
          <p class="am-text-label text-on-surface-variant">
            {t(copy.totalPrice)}
          </p>
          <p class="am-text-title mt-2 text-on-surface" data-am-booking-price></p>
        </div>
        <p class="am-text-caption mt-4 font-normal leading-relaxed text-on-surface-variant" data-am-booking-note></p>
        <a
          class="am-btn am-btn--primary mt-5 w-full justify-center sm:w-auto"
          hidden
          data-am-booking-checkout
        >
          {t(copy.bookNow)}
        </a>
      </div>

      {fallbackHref && fallbackLabel && (
        <p class="am-text-caption mt-5 font-normal text-on-surface-variant" data-am-booking-fallback>
          <AmaraActionLink variant="inline" href={fallbackHref}>{fallbackLabel}</AmaraActionLink>
        </p>
      )}
    </div>
  </div>
  </div>
</AmaraSection>

<style is:global>
  /* Page-level calls to action scroll here, so the fixed header must not cover
     the heading the guest was sent to. */
  [data-am-component='stay-booking-calendar'],
  [data-am-stay-booking-calendar] {
    scroll-margin-top: 7rem;
  }

  .am-stay-booking-calendar__panel,
  .am-stay-booking-calendar__result {
    border-radius: var(--radius-editorial);
  }

  .am-stay-booking-calendar__panel {
    box-shadow: var(--shadow-editorial-card);
  }

  [data-am-booking-enhanced='true'] .am-stay-booking-calendar__native-date {
    display: none;
  }

</style>

<script>
  import { enhanceStayBookingCalendars } from '../../scripts/stayBookingCalendar';

  enhanceStayBookingCalendars();
</script>
