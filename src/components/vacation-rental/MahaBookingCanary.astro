---
import type { AmaraLanguage } from '../../types/seo';
import AmaraSection from '../layout/AmaraSection.astro';

interface Props {
  lang: AmaraLanguage;
  occupancy: number;
}

type LocalizedText = Record<AmaraLanguage, string>;

const { lang, occupancy } = Astro.props;

const copy = {
  kicker: {
    en: 'Live availability',
    de: 'Live-Verfügbarkeit',
    es: 'Disponibilidad en directo',
    nl: 'Live beschikbaarheid',
    sv: 'Live-tillgänglighet'
  },
  title: {
    en: 'Check current availability and price for Maha',
    de: 'Aktuelle Verfügbarkeit und Preis für Maha prüfen',
    es: 'Consulta la disponibilidad y el precio actual de Maha',
    nl: 'Controleer de actuele beschikbaarheid en prijs voor Maha',
    sv: 'Kontrollera aktuell tillgänglighet och pris för Maha'
  },
  intro: {
    en: 'Open the calendar to see live availability and indicative nightly prices. We request booking data only when you start choosing dates.',
    de: 'Öffnet den Kalender, um Live-Verfügbarkeit und orientierende Übernachtungspreise zu sehen. Buchungsdaten fragen wir erst ab, wenn ihr Reisedaten auswählt.',
    es: 'Abrid el calendario para ver la disponibilidad en directo y precios orientativos por noche. Solo consultamos datos de reserva cuando empezáis a elegir fechas.',
    nl: 'Open de kalender voor live beschikbaarheid en indicatieve nachtprijzen. We vragen boekingsgegevens pas op wanneer jullie data gaan kiezen.',
    sv: 'Öppna kalendern för att se live-tillgänglighet och vägledande nattpriser. Vi hämtar bokningsdata först när ni börjar välja datum.'
  },
  arrival: {
    en: 'Arrival',
    de: 'Anreise',
    es: 'Llegada',
    nl: 'Aankomst',
    sv: 'Ankomst'
  },
  departure: {
    en: 'Departure',
    de: 'Abreise',
    es: 'Salida',
    nl: 'Vertrek',
    sv: 'Avresa'
  },
  guests: {
    en: 'Guests',
    de: 'Gäste',
    es: 'Huéspedes',
    nl: 'Gasten',
    sv: 'Gäster'
  },
  guestOption: {
    en: '{count} guest',
    de: '{count} Gast',
    es: '{count} huésped',
    nl: '{count} gast',
    sv: '{count} gäst'
  },
  guestOptionPlural: {
    en: '{count} guests',
    de: '{count} Gäste',
    es: '{count} huéspedes',
    nl: '{count} gasten',
    sv: '{count} gäster'
  },
  submit: {
    en: 'Check current total price',
    de: 'Aktuellen Gesamtpreis prüfen',
    es: 'Consultar el precio total actual',
    nl: 'Actuele totaalprijs controleren',
    sv: 'Kontrollera aktuellt totalpris'
  },
  loading: {
    en: 'Checking the current total price…',
    de: 'Aktueller Gesamtpreis wird geprüft…',
    es: 'Consultando el precio total actual…',
    nl: 'Actuele totaalprijs wordt gecontroleerd…',
    sv: 'Kontrollerar aktuellt totalpris…'
  },
  available: {
    en: 'Available',
    de: 'Verfügbar',
    es: 'Disponible',
    nl: 'Beschikbaar',
    sv: 'Tillgängligt'
  },
  unavailable: {
    en: 'Not available',
    de: 'Nicht verfügbar',
    es: 'No disponible',
    nl: 'Niet beschikbaar',
    sv: 'Inte tillgängligt'
  },
  unavailableBody: {
    en: 'Maha is not available for this stay. Please choose different dates.',
    de: 'Maha ist für diesen Aufenthalt nicht verfügbar. Bitte wählt andere Reisedaten.',
    es: 'Maha no está disponible para esta estancia. Elegid otras fechas.',
    nl: 'Maha is niet beschikbaar voor dit verblijf. Kies andere data.',
    sv: 'Maha är inte tillgängligt för denna vistelse. Välj andra datum.'
  },
  totalPrice: {
    en: 'Total price',
    de: 'Gesamtpreis',
    es: 'Precio total',
    nl: 'Totaalprijs',
    sv: 'Totalpris'
  },
  night: {
    en: '{count} night',
    de: '{count} Nacht',
    es: '{count} noche',
    nl: '{count} nacht',
    sv: '{count} natt'
  },
  nights: {
    en: '{count} nights',
    de: '{count} Nächte',
    es: '{count} noches',
    nl: '{count} nachten',
    sv: '{count} nätter'
  },
  quoteNote: {
    en: 'Current total price for these dates. This check does not create or hold a reservation.',
    de: 'Aktueller Gesamtpreis für diese Reisedaten. Die Prüfung erstellt oder blockiert keine Reservierung.',
    es: 'Precio total actual para estas fechas. La consulta no crea ni bloquea una reserva.',
    nl: 'Actuele totaalprijs voor deze data. Deze controle maakt of blokkeert geen reservering.',
    sv: 'Aktuellt totalpris för dessa datum. Kontrollen skapar eller blockerar ingen bokning.'
  },
  invalidDates: {
    en: 'Choose a valid stay of no more than 45 nights.',
    de: 'Wählt einen gültigen Aufenthalt von höchstens 45 Nächten.',
    es: 'Elegid una estancia válida de un máximo de 45 noches.',
    nl: 'Kies een geldig verblijf van maximaal 45 nachten.',
    sv: 'Välj en giltig vistelse på högst 45 nätter.'
  },
  error: {
    en: 'Live booking data is currently unavailable. Please try again shortly.',
    de: 'Die Live-Buchungsdaten sind derzeit nicht verfügbar. Bitte versucht es in Kürze erneut.',
    es: 'Los datos de reserva en directo no están disponibles ahora. Volved a intentarlo en breve.',
    nl: 'De live boekingsgegevens zijn nu niet beschikbaar. Probeer het zo opnieuw.',
    sv: 'Livebokningsdata är inte tillgängliga just nu. Försök igen om en liten stund.'
  },
  chooseArrival: {
    en: 'Choose arrival', de: 'Anreise wählen', es: 'Elegir llegada', nl: 'Aankomst kiezen', sv: 'Välj ankomst'
  },
  chooseDeparture: {
    en: 'Choose departure', de: 'Abreise wählen', es: 'Elegir salida', nl: 'Vertrek kiezen', sv: 'Välj avresa'
  },
  calendarTitle: {
    en: 'Choose your stay', de: 'Aufenthalt wählen', es: 'Elegid vuestra estancia', nl: 'Kies jullie verblijf', sv: 'Välj er vistelse'
  },
  calendarHelp: {
    en: 'Choose an available arrival date. Nightly prices are indicative; the total price is checked after your departure is selected.',
    de: 'Wählt ein verfügbares Anreisedatum. Übernachtungspreise dienen zur Orientierung; den Gesamtpreis prüfen wir nach Auswahl der Abreise.',
    es: 'Elegid una fecha de llegada disponible. Los precios por noche son orientativos; consultamos el total al elegir la salida.',
    nl: 'Kies een beschikbare aankomstdatum. Nachtprijzen zijn indicatief; na de vertrekkeuze controleren we de totaalprijs.',
    sv: 'Välj ett tillgängligt ankomstdatum. Nattpriserna är vägledande; totalpriset kontrolleras när avresan är vald.'
  },
  departureHelp: {
    en: 'Now choose a departure. Only dates that keep every night available and match the stay rules can be selected.',
    de: 'Wählt jetzt die Abreise. Nur Daten, bei denen jede Nacht verfügbar ist und die Aufenthaltsregeln passen, sind auswählbar.',
    es: 'Elegid ahora la salida. Solo se pueden seleccionar fechas con todas las noches disponibles y que cumplan las reglas de estancia.',
    nl: 'Kies nu het vertrek. Alleen data waarbij elke nacht beschikbaar is en de verblijfsregels passen, zijn selecteerbaar.',
    sv: 'Välj nu avresa. Endast datum där varje natt är tillgänglig och vistelsereglerna uppfylls kan väljas.'
  },
  loadingCalendar: {
    en: 'Loading live availability and nightly prices…',
    de: 'Live-Verfügbarkeit und Übernachtungspreise werden geladen…',
    es: 'Cargando disponibilidad y precios por noche…',
    nl: 'Live beschikbaarheid en nachtprijzen worden geladen…',
    sv: 'Läser in live-tillgänglighet och nattpriser…'
  },
  calendarError: {
    en: 'The live calendar is currently unavailable. No reservation has been created or held.',
    de: 'Der Live-Kalender ist derzeit nicht verfügbar. Es wurde keine Reservierung erstellt oder blockiert.',
    es: 'El calendario en directo no está disponible ahora. No se ha creado ni bloqueado ninguna reserva.',
    nl: 'De live kalender is nu niet beschikbaar. Er is geen reservering gemaakt of geblokkeerd.',
    sv: 'Livekalendern är inte tillgänglig just nu. Ingen bokning har skapats eller blockerats.'
  },
  previousMonth: {
    en: 'Previous month', de: 'Vorheriger Monat', es: 'Mes anterior', nl: 'Vorige maand', sv: 'Föregående månad'
  },
  nextMonth: {
    en: 'Next month', de: 'Nächster Monat', es: 'Mes siguiente', nl: 'Volgende maand', sv: 'Nästa månad'
  },
  closeCalendar: {
    en: 'Close calendar', de: 'Kalender schließen', es: 'Cerrar calendario', nl: 'Kalender sluiten', sv: 'Stäng kalendern'
  },
  clearDates: {
    en: 'Clear dates', de: 'Daten löschen', es: 'Borrar fechas', nl: 'Data wissen', sv: 'Rensa datum'
  },
  availableDay: {
    en: 'available', de: 'verfügbar', es: 'disponible', nl: 'beschikbaar', sv: 'tillgängligt'
  },
  unavailableDay: {
    en: 'not available', de: 'nicht verfügbar', es: 'no disponible', nl: 'niet beschikbaar', sv: 'inte tillgängligt'
  },
  invalidDeparture: {
    en: 'not selectable as departure',
    de: 'nicht als Abreise auswählbar',
    es: 'no seleccionable como salida',
    nl: 'niet selecteerbaar als vertrek',
    sv: 'kan inte väljas som avresa'
  },
  fromPrice: {
    en: 'from {price}', de: 'ab {price}', es: 'desde {price}', nl: 'vanaf {price}', sv: 'från {price}'
  }
} satisfies Record<string, LocalizedText>;

const t = (value: LocalizedText) => value[lang] ?? value.en;
const clientCopy = Object.fromEntries(
  Object.entries(copy).map(([key, value]) => [key, t(value)])
);
const guestOptions = Array.from({ length: occupancy }, (_, index) => index + 1);
---

<AmaraSection labelledby="maha-booking-canary-title" dataComponent="maha-booking-canary">
  <div
    data-am-booking-canary
    data-am-booking-language={lang}
    data-am-booking-copy={JSON.stringify(clientCopy)}
  >
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-14">
    <div class="max-w-xl">
      <p class="am-text-label text-on-surface-variant">
        {t(copy.kicker)}
      </p>
      <h2 id="maha-booking-canary-title" class="am-text-title mt-4 text-balance text-on-surface">
        {t(copy.title)}
      </h2>
      <p class="am-text-body mt-5 leading-relaxed text-on-surface-variant">
        {t(copy.intro)}
      </p>
    </div>

    <div class="am-booking-canary__panel self-start bg-surface-container-low p-5 sm:p-7">
      <form method="get" data-am-booking-form>
        <div class="grid gap-5 sm:grid-cols-3">
          <label class="block am-booking-canary__native-date">
            <span class="am-text-label text-on-surface-variant">
              {t(copy.arrival)}
            </span>
            <input
              class="am-booking-canary__control am-text-body mt-2"
              type="date"
              name="arrival"
              required
              data-am-booking-arrival
            />
          </label>
          <div class="am-booking-canary__date-trigger" hidden data-am-booking-arrival-trigger-wrap>
            <span class="am-text-label text-on-surface-variant">{t(copy.arrival)}</span>
            <button
              class="am-booking-canary__control am-booking-canary__trigger am-text-body mt-2"
              type="button"
              aria-expanded="false"
              data-am-booking-arrival-trigger
            >
              <span data-am-booking-arrival-value>{t(copy.chooseArrival)}</span>
            </button>
          </div>

          <label class="block am-booking-canary__native-date">
            <span class="am-text-label text-on-surface-variant">
              {t(copy.departure)}
            </span>
            <input
              class="am-booking-canary__control am-text-body mt-2"
              type="date"
              name="departure"
              required
              data-am-booking-departure
            />
          </label>
          <div class="am-booking-canary__date-trigger" hidden data-am-booking-departure-trigger-wrap>
            <span class="am-text-label text-on-surface-variant">{t(copy.departure)}</span>
            <button
              class="am-booking-canary__control am-booking-canary__trigger am-text-body mt-2"
              type="button"
              aria-expanded="false"
              data-am-booking-departure-trigger
            >
              <span data-am-booking-departure-value>{t(copy.chooseDeparture)}</span>
            </button>
          </div>

          <label class="block">
            <span class="am-text-label text-on-surface-variant">
              {t(copy.guests)}
            </span>
            <select
              class="am-booking-canary__control am-text-body mt-2"
              name="guests"
              data-am-booking-guests
            >
              {guestOptions.map((count) => (
                <option value={count} selected={count === Math.min(2, occupancy)}>
                  {t(count === 1 ? copy.guestOption : copy.guestOptionPlural).replace('{count}', String(count))}
                </option>
              ))}
            </select>
          </label>
        </div>

        <div
          class="am-booking-calendar mt-6 border-y border-border-subtle bg-surface"
          hidden
          data-am-booking-calendar
        >
          <div class="am-booking-calendar__header">
            <div>
              <p class="am-text-label text-on-surface-variant">{t(copy.calendarTitle)}</p>
              <p
                class="am-text-caption mt-2 font-normal leading-relaxed text-on-surface-variant"
                role="status"
                aria-live="polite"
                data-am-booking-calendar-status
              >
                {t(copy.calendarHelp)}
              </p>
            </div>
            <button
              class="am-booking-calendar__text-action am-text-label"
              type="button"
              data-am-booking-calendar-close
            >
              {t(copy.closeCalendar)}
            </button>
          </div>

          <div class="am-booking-calendar__navigation">
            <button
              class="am-booking-calendar__nav-button"
              type="button"
              aria-label={t(copy.previousMonth)}
              data-am-booking-calendar-prev
            >←</button>
            <button
              class="am-booking-calendar__nav-button"
              type="button"
              aria-label={t(copy.nextMonth)}
              data-am-booking-calendar-next
            >→</button>
          </div>

          <div class="am-booking-calendar__months" data-am-booking-calendar-months></div>

          <div class="am-booking-calendar__footer">
            <button
              class="am-booking-calendar__text-action am-text-label"
              type="button"
              data-am-booking-calendar-clear
            >
              {t(copy.clearDates)}
            </button>
          </div>
        </div>

        <button
          class="am-btn am-btn--primary mt-6 w-full justify-center sm:w-auto"
          type="submit"
          data-am-booking-submit
        >
          {t(copy.submit)}
        </button>
      </form>

      <div
        class="am-booking-canary__result mt-6 border border-border-subtle bg-surface p-5"
        role="status"
        aria-live="polite"
        hidden
        data-am-booking-result
      >
        <p class="am-text-label text-on-surface-variant" data-am-booking-status></p>
        <p class="am-text-body mt-3 text-on-surface" data-am-booking-summary></p>
        <div class="mt-5 border-t border-border-subtle pt-4" hidden data-am-booking-price-wrap>
          <p class="am-text-label text-on-surface-variant">
            {t(copy.totalPrice)}
          </p>
          <p class="am-text-title mt-2 text-on-surface" data-am-booking-price></p>
        </div>
        <p class="am-text-caption mt-4 font-normal leading-relaxed text-on-surface-variant" data-am-booking-note></p>
      </div>
    </div>
  </div>
  </div>
</AmaraSection>

<style is:global>
  .am-booking-canary__panel,
  .am-booking-canary__result {
    border-radius: var(--radius-editorial);
  }

  .am-booking-canary__panel {
    box-shadow: var(--shadow-editorial-card);
  }

  .am-booking-canary__control {
    min-height: 3rem;
    width: 100%;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    padding: 0.5rem 0.75rem;
    color: var(--color-on-surface);
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .am-booking-canary__control:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-am-booking-enhanced='true'] .am-booking-canary__native-date {
    display: none;
  }

  .am-booking-canary__trigger {
    display: flex;
    align-items: center;
    text-align: left;
  }

  .am-booking-canary__trigger[aria-expanded='true'] {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }

  .am-booking-calendar {
    padding: 1.25rem 0;
  }

  .am-booking-calendar__header,
  .am-booking-calendar__footer,
  .am-booking-calendar__navigation {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .am-booking-calendar__header {
    padding: 0 0.25rem 1rem;
  }

  .am-booking-calendar__navigation {
    justify-content: flex-end;
    border-top: 1px solid var(--color-outline-variant);
    padding: 0.75rem 0.25rem;
  }

  .am-booking-calendar__footer {
    justify-content: flex-end;
    border-top: 1px solid var(--color-outline-variant);
    margin-top: 1rem;
    padding: 1rem 0.25rem 0;
  }

  .am-booking-calendar__text-action {
    flex: 0 0 auto;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-on-surface);
  }

  .am-booking-calendar__nav-button {
    display: inline-flex;
    min-height: 2.75rem;
    min-width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-control);
    color: var(--color-on-surface);
    font-size: 1.25rem;
  }

  .am-booking-calendar button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .am-booking-calendar__nav-button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .am-booking-calendar__months {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .am-booking-calendar__month {
    min-width: 0;
  }

  .am-booking-calendar__month-title {
    min-height: 2.25rem;
    padding: 0 0.25rem 0.75rem;
    color: var(--color-on-surface);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 400;
    text-transform: capitalize;
  }

  .am-booking-calendar__weekdays,
  .am-booking-calendar__days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .am-booking-calendar__weekdays {
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .am-booking-calendar__weekday {
    padding: 0.45rem 0.1rem;
    text-align: center;
  }

  .am-booking-calendar__days {
    row-gap: 0.25rem;
    padding-top: 0.35rem;
  }

  .am-booking-calendar__day,
  .am-booking-calendar__blank {
    min-width: 0;
    min-height: 4.25rem;
  }

  .am-booking-calendar__day {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border: 1px solid transparent;
    color: var(--color-on-surface);
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .am-booking-calendar__day:not(:disabled):hover {
    border-color: var(--color-primary);
  }

  .am-booking-calendar__day:disabled {
    cursor: not-allowed;
    color: color-mix(in srgb, var(--color-on-surface-variant) 42%, transparent);
  }

  .am-booking-calendar__day:disabled .am-booking-calendar__day-number {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .am-booking-calendar__day[data-range='middle'] {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-surface));
  }

  .am-booking-calendar__day[data-range='start'],
  .am-booking-calendar__day[data-range='end'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .am-booking-calendar__day-number {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1;
  }

  .am-booking-calendar__day-price {
    max-width: 100%;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    white-space: normal;
  }

  .am-booking-calendar__day[data-range='start'] .am-booking-calendar__day-price,
  .am-booking-calendar__day[data-range='end'] .am-booking-calendar__day-price {
    color: var(--color-on-primary);
  }

  @media (min-width: 64rem) {
    .am-booking-calendar__months {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .am-booking-calendar__day,
    .am-booking-calendar__blank {
      min-height: 4.5rem;
    }
  }
</style>

<script>
  import { enhanceMahaBookingCalendars } from '../../scripts/mahaBookingCalendar';

  enhanceMahaBookingCalendars();
</script>
