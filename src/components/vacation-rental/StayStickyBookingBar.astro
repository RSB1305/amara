---
interface Props {
  /** Indicative from-price. The live module owns the exact total. */
  price: string;
  href: string;
  label: string;
}

const { price, href, label } = Astro.props;
---

{/*
  A compact companion to the live booking module, not a second booking surface:
  it appears once the hero decision block has scrolled away and steps aside
  while the module itself is on screen, so the guest never sees two competing
  calls to action at the same time.
*/}
<div class="am-stay-sticky-cta" data-am-stay-sticky-cta hidden>
  <div class="am-stay-sticky-cta__inner">
    <p class="am-text-label am-stay-sticky-cta__price">{price}</p>
    <a
      class="am-btn am-btn--primary am-stay-sticky-cta__action"
      href={href}
      data-am-booking-open
    >
      {label}
    </a>
  </div>
</div>

<style>
  .am-stay-sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    border-top: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    backdrop-filter: blur(8px);
    padding: 0.625rem 1.5rem calc(0.625rem + env(safe-area-inset-bottom));
  }

  .am-stay-sticky-cta[hidden] {
    display: none;
  }

  .am-stay-sticky-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 96rem;
    margin-inline: auto;
  }

  .am-stay-sticky-cta__price {
    color: var(--color-on-surface);
    white-space: nowrap;
  }

  .am-stay-sticky-cta__action {
    flex: 0 1 auto;
  }

  @media (min-width: 48rem) {
    .am-stay-sticky-cta {
      padding-inline: 3rem;
    }
  }
</style>

<script>
  import { enhanceStayStickyBookingBar } from '../../scripts/stayStickyBookingBar';

  enhanceStayStickyBookingBar();
</script>
