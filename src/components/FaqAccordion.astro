---
// src/components/FaqAccordion.astro
import AmaraActionLink from './actions/AmaraActionLink.astro';
import { getPageEndAttributes, type AmaraPageEndFamily } from './page-end/pageEndContract';

interface Props {
  arrivalTitle?: string;
  steps?: Array<{ num: string; headline: string; text: string }>;
  faqTitle?: string;
  items?: Array<{ question: string; answer: string }>;
  /** Optional in-page anchor id for the arrival column (e.g. Frigiliana section nav). */
  anchorArrivalId?: string;
  /** Optional in-page anchor id for the FAQ column. */
  anchorFaqId?: string;
  /** Optional onward link below arrival steps (resolved href + label from parent). */
  arrivalDetailCta?: { href: string; label: string };
  /** Optional onward link below the FAQ accordion list. */
  allFaqsCta?: { href: string; label: string };
  pageEndFamily?: AmaraPageEndFamily;
  layout?: 'split' | 'single';
  dataComponent?: string;
  [attribute: `data-am-${string}`]: string | undefined;
}

const {
  arrivalTitle = "The Arrival",
  steps = [],
  faqTitle = "Dispatches & FAQ",
  items = [],
  anchorArrivalId,
  anchorFaqId,
  arrivalDetailCta,
  allFaqsCta,
  pageEndFamily,
  layout = 'split',
  dataComponent,
  ...sectionAttributes
} = Astro.props;
---

<section class="bg-surface px-6 py-20 md:px-12 md:py-32" data-am-component={dataComponent} {...(pageEndFamily ? getPageEndAttributes('faq', pageEndFamily) : {})} {...sectionAttributes}>
  <div class:list={['mx-auto grid grid-cols-1 gap-y-16', layout === 'split' ? 'max-w-screen-2xl gap-x-32 md:grid-cols-2 md:items-stretch md:gap-y-20' : 'max-w-5xl']}>
    {layout === 'split' && <div class="flex flex-col md:h-full min-h-0" {...(anchorArrivalId ? { id: anchorArrivalId } : {})}>
      <h2 class="am-text-title italic text-on-surface mb-10 tracking-tight leading-tight shrink-0 md:mb-20">
        {arrivalTitle}
      </h2>
      <div class="flex flex-col gap-10 md:flex-1 md:min-h-0 md:justify-between">
        <div class="space-y-12 md:space-y-20">
          {steps && steps.length > 0 ? steps.map((step) => (
            <div class="flex gap-12 items-start group">
              <span class="am-text-display italic leading-none text-outline select-none">
                {step.num}
              </span>
              <div class="pt-3">
                <h3 class="am-text-caption am-text-caption--upper am-text-caption--wide text-on-surface mb-3">
                  {step.headline}
                </h3>
                <p class="am-text-body text-on-surface-variant leading-relaxed max-w-sm">
                  {step.text}
                </p>
              </div>
            </div>
          )) : <p class="italic text-outline">Informationen zur Anreise folgen.</p>}
        </div>
        {arrivalDetailCta && (
          <AmaraActionLink href={arrivalDetailCta.href} variant="editorial" class="inline-block w-fit self-start shrink-0 md:pt-4">
            {arrivalDetailCta.label}
          </AmaraActionLink>
        )}
      </div>
    </div>}

    <div class="flex flex-col md:h-full min-h-0" {...(anchorFaqId ? { id: anchorFaqId } : {})}>
      <h2 class:list={['am-text-title text-on-surface mb-10 leading-tight shrink-0', layout === 'split' ? 'italic tracking-tight md:mb-20' : 'max-w-3xl md:mb-12']}>
        {faqTitle}
      </h2>
      <div class="flex flex-col gap-10 md:flex-1 md:min-h-0 md:justify-between">
        <div class="divide-y divide-outline-variant/10 border-t border-outline-variant/10">
          {items && items.length > 0 ? items.map((item) => (
            <details class:list={['group outline-none', layout === 'split' ? 'py-6 md:py-10' : 'py-7 md:py-9']}>
              <summary class="am-accordion__trigger items-center">
                <span class:list={[layout === 'split' ? 'am-text-caption am-text-caption--upper am-text-caption--wide' : 'am-text-subtitle pr-6', 'text-on-surface group-hover:text-primary transition-colors']}>
                  {item.question}
                </span>
                <span class="am-accordion__indicator" aria-hidden="true">
                  <span class="group-open:hidden">+</span>
                  <span class="hidden group-open:inline">−</span>
                </span>
              </summary>
              <div class="overflow-hidden transition-all duration-500">
                <p class:list={['pt-5 am-text-body text-on-surface-variant leading-relaxed', layout === 'split' ? 'max-w-md italic md:pt-8' : 'max-w-3xl md:pt-7']}>
                  {item.answer}
                </p>
              </div>
            </details>
          )) : <p class="py-10 italic text-outline">Häufig gestellte Fragen werden bald ergänzt.</p>}
          <div class="border-b border-outline-variant/10"></div>
        </div>
        {allFaqsCta && (
          <AmaraActionLink href={allFaqsCta.href} variant="editorial" class="inline-block w-fit self-start shrink-0 md:pt-4">
            {allFaqsCta.label}
          </AmaraActionLink>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  summary {
    list-style: none;
  }

  details[open] div {
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] div {
      animation: none;
    }
  }
</style>
