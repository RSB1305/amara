---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import {
  getAmaraImageProfile,
  type AmaraImageProfile
} from '../lib/images/amaraImageProfiles';
import { resolveAmaraImageSource } from '../lib/images/amaraImageRegistry';
import type { AmaraMediaRole } from './media/mediaContract';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  profile?: AmaraImageProfile;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  widths?: number[];
  sizes?: string;
  quality?: number;
  avifQuality?: number;
  preferAvif?: boolean;
  mediaRole?: AmaraMediaRole;
  focalPoint?: string;
}

const {
  src,
  alt,
  profile = 'card',
  class: className,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  width,
  widths,
  sizes,
  quality,
  avifQuality,
  preferAvif = false,
  mediaRole,
  focalPoint
} = Astro.props;

const image = resolveAmaraImageSource(src);
const preset = getAmaraImageProfile(profile);
const outputWidth = width ?? preset.width;
const outputWidths = widths ?? preset.widths;
const outputSizes = sizes ?? preset.sizes;
const avif = preferAvif
  ? await getImage({
      src: image,
      width: outputWidth,
      widths: outputWidths,
      sizes: outputSizes,
      quality: avifQuality ?? preset.avifQuality,
      format: 'avif'
    })
  : null;
---

{avif ? (
  <picture class="contents">
    <source srcset={avif.srcSet.attribute} sizes={outputSizes} type="image/avif" />
    <Image
      src={image}
      alt={alt}
      width={outputWidth}
      widths={outputWidths}
      sizes={outputSizes}
      quality={quality ?? preset.quality}
      format="webp"
      class={className}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      data-am-media-image={mediaRole}
      style={focalPoint ? `object-position: ${focalPoint}` : undefined}
    />
  </picture>
) : (
  <Image
    src={image}
    alt={alt}
    width={outputWidth}
    widths={outputWidths}
    sizes={outputSizes}
    quality={quality ?? preset.quality}
    format="webp"
    class={className}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    data-am-media-image={mediaRole}
    style={focalPoint ? `object-position: ${focalPoint}` : undefined}
  />
)}
