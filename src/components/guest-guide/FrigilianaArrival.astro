---
import { Footprints } from '@lucide/astro';
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import GuestGuideAccordionItem from './GuestGuideAccordionItem.astro';
import GuestGuideIcon from './GuestGuideIcon.astro';
import { frigilianaCenterArrivalContent as content, sharedFrigilianaCenterArrivalItem as item } from '../../content/guestGuideFrigiliana';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
}

const { lang } = Astro.props;
const { copy } = content;
---

<GuestGuideAccordionItem icon={item.icon} title={item.title[lang]} body={[]}>
  <div slot="content" class="am-frigiliana-arrival">
    <p class="am-ios-title">{copy.intro[lang]}</p>

    <div class="am-frigiliana-arrival__step">
      <h3 class="am-ios-title">{copy.driveTitle[lang]}</h3>
      <p><strong>{content.arrivalAddress}</strong><br />{copy.driveNote[lang]}</p>
      <AmaraActionLink variant="primary" href={content.drivingHref} external class="am-frigiliana-arrival__action">
        <GuestGuideIcon name="car" />
        <span>{copy.driveAction[lang]}</span>
      </AmaraActionLink>
    </div>

    <div class="am-frigiliana-arrival__step">
      <h3 class="am-ios-title">{copy.walkTitle[lang]}</h3>
      <p>{copy.walkNote[lang]}</p>
      <AmaraActionLink variant="secondary" href={content.walkingHref} external class="am-frigiliana-arrival__action">
        <Footprints size={24} stroke-width={1.75} aria-hidden="true" focusable="false" />
        <span>{copy.walkAction[lang]}</span>
      </AmaraActionLink>
    </div>

    <details class="am-ios-details">
      <summary class="am-ios-item">
        <span class="am-ios-title">{copy.fallbackTitle[lang]}</span>
        <span class="am-ios-chevron" aria-hidden="true">&rsaquo;</span>
      </summary>
      <div class="am-ios-panel">
        <ol>
          {content.directions.map((direction) => <li id={`arrival-${direction.id}`}>{direction.text[lang]}</li>)}
        </ol>
        <p>
          <strong>{copy.addressLabel[lang]}</strong><br />
          <AmaraActionLink variant="inline" href={content.houseHref} external>{content.houseAddress}</AmaraActionLink>
        </p>
      </div>
    </details>

    <p class="am-frigiliana-arrival__note">{copy.accessNote[lang]}</p>

    <details class="am-ios-details">
      <summary class="am-ios-item">
        <span class="am-ios-title">{copy.busTitle[lang]}</span>
        <span class="am-ios-chevron" aria-hidden="true">&rsaquo;</span>
      </summary>
      <div class="am-ios-panel">
        <p>
          <strong>{copy.busStopLabel[lang]}</strong><br />
          <AmaraActionLink variant="inline" href={content.busStopHref} external>{content.busStop}</AmaraActionLink>
        </p>
        <ul class="am-frigiliana-arrival__routes" role="list">
          {content.busRoutes.map((route) => (
            <li id={`arrival-bus-${route.id}`}>
              <h4 class="am-ios-title">{route.title[lang]}</h4>
              <p><strong>{route.distance[lang]}</strong><br />{route.terrain[lang]}</p>
              <AmaraActionLink variant="inline" href={route.href} external aria-label={`${copy.busRouteAction[lang]}: ${route.title[lang]}`}>
                {copy.busRouteAction[lang]}
              </AmaraActionLink>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <details class="am-ios-details">
      <summary class="am-ios-item">
        <span class="am-ios-title">{copy.parkingTitle[lang]}</span>
        <span class="am-ios-chevron" aria-hidden="true">&rsaquo;</span>
      </summary>
      <div class="am-ios-panel">
        <p>{copy.freeParking[lang]}</p>
        <p>{copy.planB[lang]}</p>
        <p><AmaraActionLink variant="inline" href={content.carParkHref} external>{copy.planBAction[lang]}</AmaraActionLink></p>
        <p>{copy.tariff[lang]}</p>
      </div>
    </details>
  </div>
</GuestGuideAccordionItem>

<style>
  .am-frigiliana-arrival__step {
    margin-bottom: 1.5rem;
  }

  .am-frigiliana-arrival h3,
  .am-frigiliana-arrival h4 {
    margin: 0 0 0.5rem;
  }

  .am-frigiliana-arrival :global(.am-frigiliana-arrival__action) {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    gap: 0.75rem;
    white-space: normal;
    line-height: 1.5;
    text-align: center;
  }

  .am-frigiliana-arrival :global(.am-frigiliana-arrival__action svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .am-frigiliana-arrival__note {
    margin-top: 1rem;
  }

  .am-frigiliana-arrival .am-frigiliana-arrival__routes {
    padding-left: 0;
    list-style: none;
  }

  .am-frigiliana-arrival__routes li + li {
    margin-top: 1.25rem;
  }
</style>
