---
// Native <details>/<summary> dropdown — same no-JS technique as the accordion items.
import { SUPPORTED_LANGUAGES } from '../../lib/routeOwnership';
import { guideHref } from '../../lib/guestGuideHref';
import { AMARA_LANGUAGE_LABELS } from '../../lib/languageLabels';
import type { AmaraLanguage } from '../../types/seo';
import { experienceAccessHref } from '../../../guest-experience/guide-routes.mjs';
import '../../styles/guest-guide-language-switcher.css';

interface Props {
  slug?: string;
  currentLang: AmaraLanguage;
  variant?: 'overlay' | 'inline';
  target?: 'guide' | 'access';
}

const { slug, currentLang, variant = 'inline', target = 'guide' } = Astro.props;
if (target === 'guide' && !slug) throw new Error('Guest Guide language switching requires a guide slug.');
const hrefForLanguage = (lang: AmaraLanguage) => (
  target === 'access' ? experienceAccessHref(lang) : guideHref(slug!, lang)
);
---

<details class={`am-lang-menu ${variant === 'overlay' ? 'am-lang-menu--overlay' : ''}`}>
  <summary class="am-lang-menu__trigger" aria-label="Change language">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
  </summary>
  <nav class="am-lang-menu__panel" aria-label="Language">
    {SUPPORTED_LANGUAGES.map((lang) => (
      <a
        class="am-lang-menu__option"
        href={hrefForLanguage(lang)}
        aria-current={lang === currentLang ? 'true' : undefined}
      >
        {AMARA_LANGUAGE_LABELS[lang]}
      </a>
    ))}
  </nav>
</details>
