---
/**
 * The structured "Anreise & Parken" card for any stay: a short numbered path to
 * the door with navigate/walk buttons, and the longer detail (fallback
 * directions, bus routes, parking, plan B) folded into collapsibles. One shared
 * treatment for Frigiliana, Nerja and Tarifa, so a guest sees at a glance how
 * simple the arrival is — the number of steps flexes per stay. The quoted values
 * live in the content module; this component only lays them out.
 */
import { Footprints } from '@lucide/astro';
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import GuestGuideAccordionItem from './GuestGuideAccordionItem.astro';
import GuestGuideIcon from './GuestGuideIcon.astro';
import type { GuestGuideArrivalItem } from '../../types/guestGuide';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  item: GuestGuideArrivalItem;
  lang: AmaraLanguage;
}

const { item, lang } = Astro.props;
const { arrival } = item;
---

<GuestGuideAccordionItem icon={item.icon} title={item.title[lang]} body={[]}>
  <div slot="content" class="am-guest-arrival">
    <p class="am-ios-title am-guest-arrival__intro">{arrival.intro[lang]}</p>

    {arrival.steps.map((step, index) => (
      <div class="am-guest-arrival__step">
        <div class="am-guest-arrival__step-head">
          <span class="am-guest-arrival__num" aria-hidden="true">{index + 1}</span>
          <h3 class="am-ios-title am-guest-arrival__step-title">{step.title[lang]}</h3>
        </div>
        <p class="am-guest-arrival__note" set:html={step.note[lang]} />
        {step.action && (
          <AmaraActionLink variant={step.action.variant ?? 'primary'} href={step.action.href} external class="am-guest-arrival__action">
            {step.action.icon === 'walk'
              ? <Footprints size={24} stroke-width={1.75} aria-hidden="true" focusable="false" />
              : <GuestGuideIcon name={step.action.icon === 'map' ? 'location-pin' : 'car'} />}
            <span>{step.action.label[lang]}</span>
          </AmaraActionLink>
        )}
      </div>
    ))}

    {arrival.note && <p class="am-guest-arrival__aside" set:html={arrival.note[lang]} />}

    {arrival.details?.map((detail) => (
      <details class="am-ios-details">
        <summary class="am-ios-item">
          <span class="am-ios-title">{detail.title[lang]}</span>
          <span class="am-ios-chevron" aria-hidden="true">&rsaquo;</span>
        </summary>
        <div class="am-ios-panel">
          {detail.directions && (
            <ol>
              {detail.directions.map((direction, index) => <li id={`${detail.id}-step-${index + 1}`} set:html={direction[lang]} />)}
            </ol>
          )}
          {detail.paragraphs?.map((paragraph) => <p set:html={paragraph[lang]} />)}
          {detail.routes && (
            <ul class="am-guest-arrival__routes" role="list">
              {detail.routes.map((route) => (
                <li id={`${detail.id}-${route.id}`}>
                  <h4 class="am-ios-title">{route.title[lang]}</h4>
                  <p><strong>{route.distance[lang]}</strong><br />{route.terrain[lang]}</p>
                  {route.href && route.actionLabel && (
                    <AmaraActionLink variant="inline" href={route.href} external aria-label={`${route.actionLabel[lang]}: ${route.title[lang]}`}>
                      {route.actionLabel[lang]}
                    </AmaraActionLink>
                  )}
                </li>
              ))}
            </ul>
          )}
          {detail.action && (
            <p><AmaraActionLink variant="inline" href={detail.action.href} external>{detail.action.label[lang]}</AmaraActionLink></p>
          )}
        </div>
      </details>
    ))}
  </div>
</GuestGuideAccordionItem>

<style>
  .am-guest-arrival__intro {
    margin-bottom: 1.25rem;
  }

  .am-guest-arrival__step {
    margin-bottom: 1.5rem;
  }

  .am-guest-arrival__step-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .am-guest-arrival__num {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-surface);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
  }

  .am-guest-arrival__step-title {
    margin: 0;
  }

  .am-guest-arrival__note {
    margin: 0;
  }

  .am-guest-arrival :global(.am-guest-arrival__action) {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    margin-top: 0.75rem;
    gap: 0.75rem;
    white-space: normal;
    line-height: 1.5;
    text-align: center;
  }

  .am-guest-arrival :global(.am-guest-arrival__action svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .am-guest-arrival__aside {
    margin-top: 1rem;
  }

  .am-guest-arrival h4 {
    margin: 0 0 0.5rem;
  }

  .am-guest-arrival .am-guest-arrival__routes {
    padding-left: 0;
    list-style: none;
  }

  .am-guest-arrival__routes li + li {
    margin-top: 1.25rem;
  }
</style>
