const translations = weatherTranslations[lang];
---

<details class="am-ios-details" id={widgetId}>
  <summary class="am-ios-item">
    <span class="am-ios-item__left">
      <span class="am-ios-icon" aria-hidden="true">
        <GuestGuideIcon name={icon} />
      </span>
      <span class="am-ios-item__text">
        <span class="am-ios-title">{title}</span>
        <span class="am-ios-subtitle min-h-[1.95rem]" data-weather-subtitle>{loadingLabel}</span>
      </span>
    </span>
    <span class="am-ios-chevron" aria-hidden="true">&rsaquo;</span>
  </summary>

  <div class="am-ios-panel">
    <div class="am-weather-live-note">
      <strong>{todayLabel}</strong>
      <div data-weather-summary>{loadingLabel}</div>
    </div>

    <div class="am-prose">
      {introBody.map((paragraph) => <p set:html={paragraph} />)}
    </div>

    <div class="am-weather-app">
      <div class="am-weather-head">
        <div class="am-weather-location">{locationName}</div>
        <div class="am-weather-current-temp" data-weather-temp>--°</div>
        <div class="am-weather-current-desc" data-weather-desc>{loadingLabel}</div>
        <div class="am-weather-current-range" data-weather-range>-- / --</div>
        {windMode ? (
          <div class="am-weather-badges">
            <div class="am-weather-uv" data-weather-uv>UV --</div>
            <div class="am-weather-wind-badge" data-weather-wind>Wind --</div>
          </div>
        ) : (
          <div class="am-weather-uv" data-weather-uv>UV --</div>
        )}
      </div>

      <div class="am-weather-section">
        <div class="am-weather-section-title" data-weather-hourly-label></div>
        <div class="am-weather-hourly" data-weather-hourly></div>
      </div>

      <div class="am-weather-section">
        <div class="am-weather-section-title" data-weather-days-label></div>
        <div class="am-weather-days" data-weather-days></div>
      </div>
    </div>
  </div>
</details>

<script define:vars={{ lat, lon, translations, windMode, widgetId }}>
  (function () {
    const root = document.getElementById(widgetId);
    if (!root) return;

    const icons = { 0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️', 45: '🌫️', 48: '🌫️', 51: '🌦️', 53: '🌦️', 55: '🌦️', 61: '🌧️', 63: '🌧️', 65: '🌧️', 71: '❄️', 80: '🌦️', 81: '🌦️', 82: '🌧️', 95: '⛈️' };
    const t = translations;
    const showWind = Boolean(windMode);

    const hourlyLabelEl = root.querySelector('[data-weather-hourly-label]');
    const daysLabelEl = root.querySelector('[data-weather-days-label]');
    if (hourlyLabelEl) hourlyLabelEl.textContent = t.hourly;
    if (daysLabelEl) daysLabelEl.textContent = t.days;

    function kmhToKnots(kmh) {
      return Math.round(kmh * 0.539957);
    }

    function getWindHint(windKmh) {
      if (windKmh >= 55) return t.windVeryStrong;
      if (windKmh >= 35) return t.windStrong;
      if (windKmh >= 18) return t.windModerate;
      return t.windLight;
    }

    function buildSummary(code, temp, uv, windKmh) {
      if (code === 95) return t.storm;
      if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return t.rain;
      if (showWind && windKmh >= 45) return t.windyStrong;
      if (showWind && windKmh >= 25) return t.windyModerate;
      if (code === 2) return t.partlyCloudy;
      if ([3, 45, 48].includes(code)) return t.cloudy;
      if ([0, 1].includes(code) && uv >= 6) return t.sunnyHighUv;
      if ([0, 1].includes(code) && temp >= 24) return t.sunnyWarm;
      return t.fallback;
    }

    (async function () {
      try {
        const currentFields = showWind
          ? 'temperature_2m,weather_code,uv_index,wind_speed_10m'
          : 'temperature_2m,weather_code,uv_index';
        const hourlyFields = showWind
          ? 'temperature_2m,weather_code,wind_speed_10m'
          : 'temperature_2m,weather_code';
        const dailyFields = showWind
          ? 'weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max'
          : 'weather_code,temperature_2m_max,temperature_2m_min';
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=${currentFields}&hourly=${hourlyFields}&daily=${dailyFields}&timezone=auto&forecast_days=5`;
        const res = await fetch(url);
        const data = await res.json();
        if (!data || !data.current || !data.hourly || !data.daily) return;

        const currentCode = data.current.weather_code;
        const currentTemp = Math.round(data.current.temperature_2m);
        const currentWindKmh = Math.round(data.current.wind_speed_10m || 0);
        const currentWindKnots = kmhToKnots(currentWindKmh);
        const todayMax = Math.round(data.daily.temperature_2m_max[0]);
        const todayMin = Math.round(data.daily.temperature_2m_min[0]);
        const uv = Math.round(data.current.uv_index || 0);

        let uvHint = t.uvLow;
        if (uv >= 3) uvHint = t.uvMid;
        if (uv >= 6) uvHint = t.uvHigh;

        const summary = buildSummary(currentCode, currentTemp, uv, currentWindKmh);
        const subtitle = showWind
          ? `${summary} · ${t.wind} ${currentWindKmh} ${t.windUnit} / ${currentWindKnots} ${t.knotsShort}`
          : summary + ' · ' + t.uv + ' ' + uv;

        const tempEl = root.querySelector('[data-weather-temp]');
        const descEl = root.querySelector('[data-weather-desc]');
        const rangeEl = root.querySelector('[data-weather-range]');
        const uvEl = root.querySelector('[data-weather-uv]');
        const windEl = root.querySelector('[data-weather-wind]');
        const summaryEl = root.querySelector('[data-weather-summary]');
        const subtitleEl = root.querySelector('[data-weather-subtitle]');
        const hourlyEl = root.querySelector('[data-weather-hourly]');
        const daysEl = root.querySelector('[data-weather-days]');

        if (tempEl) tempEl.textContent = currentTemp + '°';
        if (descEl) descEl.textContent = (icons[currentCode] || '☀️') + ' ' + (t.weather[currentCode] || t.now);
        if (rangeEl) rangeEl.textContent = 'H ' + todayMax + '° · L ' + todayMin + '°';
        if (uvEl) uvEl.textContent = t.uv + ' ' + uv + ' · ' + uvHint;
        if (windEl) {
          windEl.textContent = `${t.wind} ${currentWindKmh} ${t.windUnit} / ${currentWindKnots} ${t.knotsShort} · ${getWindHint(currentWindKmh)}`;
        }
        if (summaryEl) summaryEl.textContent = summary;
        if (subtitleEl) subtitleEl.textContent = subtitle;

        if (hourlyEl) {
          hourlyEl.innerHTML = '';
          const hourlyTimes = data.hourly.time || [];
          const currentTimeRaw = data.current.time || '';
          let startIndex = hourlyTimes.indexOf(currentTimeRaw);
          if (startIndex === -1) {
            const nowTs = new Date(currentTimeRaw).getTime();
            startIndex = hourlyTimes.findIndex((timeStr) => new Date(timeStr).getTime() >= nowTs);
          }
          if (startIndex === -1) startIndex = 0;

          for (let i = startIndex; i < startIndex + 8 && i < hourlyTimes.length; i++) {
            const timeRaw = hourlyTimes[i] || '';
            const time = timeRaw.split('T')[1] ? timeRaw.split('T')[1].slice(0, 5) : '--:--';
            const temp = Math.round(data.hourly.temperature_2m[i]);
            const code = data.hourly.weather_code[i];
            const windKmh = Math.round(data.hourly.wind_speed_10m?.[i] || 0);
            const windKnots = kmhToKnots(windKmh);
            const hourEl = document.createElement('div');
            hourEl.className = 'am-weather-hour';
            hourEl.innerHTML = `<div class="am-weather-hour-time">${time}</div><div class="am-weather-hour-icon">${icons[code] || '☀️'}</div><div class="am-weather-hour-temp">${temp}°</div>${showWind ? `<div class="am-weather-hour-wind">${windKmh} km/h<br>${windKnots} kn</div>` : ''}`;
            hourlyEl.appendChild(hourEl);
          }
        }

        if (daysEl) {
          daysEl.innerHTML = '';
          for (let i = 0; i < 5; i++) {
            const date = new Date(data.daily.time[i]);
            const dayName = t.dayNames[date.getDay()];
            const code = data.daily.weather_code[i];
            const min = Math.round(data.daily.temperature_2m_min[i]);
            const max = Math.round(data.daily.temperature_2m_max[i]);
            const windKmh = Math.round(data.daily.wind_speed_10m_max?.[i] || 0);
            const windKnots = kmhToKnots(windKmh);
            const dayEl = document.createElement('div');
            dayEl.className = 'am-weather-day';
            dayEl.innerHTML = showWind
              ? `<div class="am-weather-day-name">${dayName}</div><div class="am-weather-day-icon">${icons[code] || '☀️'}</div><div class="am-weather-day-meta"><div class="am-weather-day-temp">${min}° / ${max}°</div><div class="am-weather-day-wind">${windKmh} km/h · ${windKnots} kn</div></div>`
              : `<div class="am-weather-day-name">${dayName}</div><div class="am-weather-day-icon">${icons[code] || '☀️'}</div><div class="am-weather-day-temp">${min}° / ${max}°</div>`;
            daysEl.appendChild(dayEl);
          }
        }
      } catch (err) {
        console.log('Weather widget error:', err);
      }
    })();
  })();
</script>
