    weather: { 0: 'Soligt', 1: 'Mestadels soligt', 2: 'Delvis molnigt', 3: 'Molnigt', 45: 'Dimma', 48: 'Dimma', 51: 'Lätt duggregn', 53: 'Duggregn', 55: 'Kraftigare duggregn', 61: 'Lätt regn', 63: 'Regn', 65: 'Kraftigt regn', 71: 'Snö', 80: 'Skurar', 81: 'Skurar', 82: 'Kraftiga skurar', 95: 'Åska' }
