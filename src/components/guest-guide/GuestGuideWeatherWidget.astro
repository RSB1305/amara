---
// Live forecast card (Open-Meteo, no API key) — client-fetched because the guest
// guide is a static page and this needs to feel current when a guest opens it,
// unlike the marketing site's build-time-cached <amara-weather/> current-conditions card.
import GuestGuideIcon from './GuestGuideIcon.astro';
import type { AmaraLanguage } from '../../types/seo';
import type { GuestGuideIconName } from '../../types/guestGuide';

interface Props {
  icon: GuestGuideIconName;
  title: string;
  loadingLabel: string;
  todayLabel: string;
  lat: number;
  lon: number;
  locationName: string;
  lang: AmaraLanguage;
  /** Tarifa-specific mode with live wind data in km/h and knots. */
  windMode?: boolean;
  /** Trusted paragraph HTML, one entry per paragraph. */
  introBody: string[];
}

const {
  icon,
  title,
  loadingLabel,
  todayLabel,
  lat,
  lon,
  locationName,
  lang,
  windMode = false,
  introBody
} = Astro.props;
const widgetId = 'am-weather-widget';
const weatherTranslations = {
