---
// Native <details>/<summary> + Tailwind `group-open:` — same no-JS technique as FaqAccordion.astro.
import GuestGuideIcon from './GuestGuideIcon.astro';
import AmaraImage from '../AmaraImage.astro';
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import type { GuestGuideIconName } from '../../types/guestGuide';

interface Props {
  icon: GuestGuideIconName;
  title: string;
  subtitle?: string;
  /** Trusted paragraph HTML (may contain <strong>/<a>), one entry per paragraph. */
  body: string[];
  image?: { src: string; alt: string; caption?: string };
  images?: { src: string; alt: string; caption?: string }[];
  /** Shown under the title when the place exists only in the Guest Guide (DR-GUEST-006). */
  exclusiveLabel?: string;
  video?: { src?: string; embedUrl?: string; title: string };
  audio?: { src: string; title: string };
  actions?: { label: string; href: string; variant?: 'primary' | 'secondary' }[];
  /** Map link owned by the recommendation record; wins over a link lifted from the copy. */
  mapsUrl?: string;
  /** Language-neutral fact strip from the recommendation record (address, distance, check date). */
  facts?: { label: string; value: string; href?: string }[];
  /** Place list from several recommendation records (name, map link, address, actions). */
  places?: { name: string; mapsUrl?: string; address?: string; actions: { label: string; href: string }[] }[];
}

const { icon, title, subtitle, body, image, images, video, audio, actions, facts, places, exclusiveLabel } = Astro.props;

/**
 * Entries used to end with a "Open in Google Maps" link on its own line, repeated
 * roughly sixty times per language. The label is lifted out of the copy here and
 * shown as a pin in the row instead, so the map stays one tap away without the
 * same sentence appearing on every entry.
 *
 * Only this exact trailing pattern is matched. Map links written into the middle
 * of a sentence — of which the guides have many — are left alone.
 */
const TRAILING_MAP_LINK =
  /<br><br><a class="am-link" href="([^"]+)" target="_blank" rel="noopener">(?:Open in Google Maps|In Google Maps öffnen|Abrir en Google Maps|Openen in Google Maps|Öppna i Google Maps)<\/a>\s*$/;

let mapsUrl: string | undefined = Astro.props.mapsUrl;
const cleanedBody = body.map((paragraph) => {
  const match = paragraph.match(TRAILING_MAP_LINK);
  if (!match) return paragraph;
  mapsUrl ??= match[1];
  return paragraph.replace(TRAILING_MAP_LINK, '');
});

const mapLabel = `${title} — Google Maps`;
---

<details class="am-ios-details">
  <summary class="am-ios-item">
    <span class="am-ios-item__left">
      <span class="am-ios-icon" aria-hidden="true">
        <GuestGuideIcon name={icon} />
      </span>
      {subtitle || exclusiveLabel ? (
        <span class="am-ios-item__text">
          <span class="am-ios-title">{title}</span>
          {subtitle && <span class="am-ios-subtitle">{subtitle}</span>}
          {exclusiveLabel && <span class="am-ios-tag">{exclusiveLabel}</span>}
        </span>
      ) : (
        <span class="am-ios-title">{title}</span>
      )}
    </span>
    <span class="am-ios-item__end">
      {mapsUrl && (
        <a
          class="am-ios-map"
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          aria-label={mapLabel}
          title={mapLabel}
          data-am-map-link
        >
          <GuestGuideIcon name="location-pin" />
        </a>
      )}
      <span class="am-ios-chevron" aria-hidden="true">&rsaquo;</span>
    </span>
  </summary>
  <div class="am-ios-panel">
    {audio && (
      <audio class="am-ios-audio" controls preload="none" src={audio.src} aria-label={audio.title}></audio>
    )}
    {cleanedBody.map((paragraph) => <p set:html={paragraph} />)}
    {image && (
      <figure class="am-ios-figure">
        <AmaraImage src={image.src} alt={image.alt} profile="gallery" mediaRole="utility" />
        {image.caption && <figcaption class="am-muted">{image.caption}</figcaption>}
      </figure>
    )}
    {images && images.map((img) => (
      <figure class="am-ios-figure">
        <AmaraImage src={img.src} alt={img.alt} profile="gallery" mediaRole="utility" />
        {img.caption && <figcaption class="am-muted">{img.caption}</figcaption>}
      </figure>
    ))}
    {video && video.src && (
      <video
        class="am-ios-video-native"
        controls
        playsinline
        preload="none"
        width="1280"
        height="720"
        aria-label={video.title}
      >
        <source src={video.src} type="video/mp4" />
      </video>
    )}
    {video && !video.src && video.embedUrl && (
      <div class="am-ios-video">
        <iframe
          src={video.embedUrl}
          title={video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        />
      </div>
    )}
    {places && places.length > 0 && (
      <ul class="am-ios-places">
        {places.map((place) => (
          <li>
            {place.mapsUrl ? (
              <a class="am-link" href={place.mapsUrl} target="_blank" rel="noopener"><strong>{place.name}</strong></a>
            ) : (
              <strong>{place.name}</strong>
            )}
            {place.address && <span class="am-muted"> · {place.address}</span>}
            {place.actions.map((action) => (
              <Fragment> · <a class="am-link" href={action.href} target={action.href.startsWith('tel:') ? undefined : '_blank'} rel="noopener">{action.label}</a></Fragment>
            ))}
          </li>
        ))}
      </ul>
    )}
    {facts && facts.length > 0 && (
      <dl class="am-ios-facts">
        {facts.map((fact) => (
          <Fragment>
            <dt>{fact.label}</dt>
            <dd>{fact.href ? <a class="am-link" href={fact.href} target="_blank" rel="noopener">{fact.value}</a> : fact.value}</dd>
          </Fragment>
        ))}
      </dl>
    )}
    {actions && actions.length > 0 && (
      <div class="am-actions">
        {actions.map((action) => (
          <AmaraActionLink
            variant={action.variant === 'secondary' ? 'secondary' : 'primary'}
            href={action.href}
            external
          >
            {action.label}
          </AmaraActionLink>
        ))}
      </div>
    )}
  </div>
</details>

<style>
  .am-ios-audio {
    display: block;
    width: 100%;
    margin: 0 0 1rem;
  }
</style>
