---
/**
 * AMARA global navigation — desktop center row
 *
 * Architectural intent:
 * Renders the hover/click group navigation shown from the large breakpoint up.
 * Desktop and mobile deliberately keep separate markup because their semantics
 * differ: this view is a button-driven dropdown, the mobile view is a details
 * disclosure list. Both consume the same resolved model.
 */
import type { ResolvedGlobalNavGroup, ResolvedGlobalNavItem } from './globalNavigationModel';

interface Props {
  groups: ResolvedGlobalNavGroup[];
  experienceLink: ResolvedGlobalNavItem;
  navigationLabel: string;
}

const { groups, experienceLink, navigationLabel } = Astro.props;
---

<nav class="am-nav__center" aria-label={navigationLabel}>
  <ul class="hidden lg:flex items-center gap-10">
    {groups.map((group) => (
      <>
      <li class="am-nav__group">
        <button
          type="button"
          class="am-nav__link am-nav__group-trigger am-text-nav-primary text-on-surface transition-colors"
          aria-controls={group.dropdownId}
          aria-expanded="false"
          aria-current={group.isActive ? 'page' : undefined}
        >
          {group.label}
        </button>

        <div
          id={group.dropdownId}
          class:list={['am-nav__dropdown', group.hasDescriptions && 'am-nav__dropdown--detailed']}
        >
          <div class:list={['am-nav__dropdown-panel', group.hasDescriptions && 'am-nav__dropdown-panel--detailed']}>
            {group.items.map((item) => (
              <>
                {item.sectionLabel && (
                  <span
                    class:list={[
                      'am-nav__dropdown-section',
                      item.separatedSection && 'am-nav__dropdown-section--separated'
                    ]}
                  >
                    {item.sectionLabel}
                  </span>
                )}
                {item.href ? (
                  <a
                    href={item.href}
                    class:list={[
                      'am-nav__dropdown-link am-text-nav-primary',
                      item.description && 'am-nav__dropdown-link--detailed',
                      group.id === 'stays' && !item.overview && 'am-nav__dropdown-link--nested',
                      item.overview && 'am-nav__dropdown-link--overview'
                    ]}
                    aria-current={item.isActive ? 'page' : undefined}
                  >
                    <span class="am-nav__dropdown-item-title">{item.label}</span>
                    {item.description && (
                      <span class="am-nav__dropdown-item-meta">{item.description}</span>
                    )}
                  </a>
                ) : (
                  <span
                    class:list={[
                      'am-nav__dropdown-link am-is-disabled am-text-nav-primary',
                      item.description && 'am-nav__dropdown-link--detailed',
                      group.id === 'stays' && !item.overview && 'am-nav__dropdown-link--nested',
                      item.overview && 'am-nav__dropdown-link--overview'
                    ]}
                    aria-disabled="true"
                  >
                    <span class="am-nav__dropdown-item-title">{item.label}</span>
                    {item.description && (
                      <span class="am-nav__dropdown-item-meta">{item.description}</span>
                    )}
                  </span>
                )}
              </>
            ))}
          </div>
        </div>
      </li>
      {group.id === 'stays' && (
        <li>
          {experienceLink.href ? (
            <a
              href={experienceLink.href}
              class="am-nav__link am-text-nav-primary text-on-surface transition-colors"
              aria-current={experienceLink.isActive ? 'page' : undefined}
            >
              {experienceLink.label}
            </a>
          ) : (
            <span class="am-nav__link am-is-disabled am-text-nav-primary" aria-disabled="true">
              {experienceLink.label}
            </span>
          )}
        </li>
      )}
      </>
    ))}
  </ul>
</nav>
