---
/**
 * Sitewide orientation rail for public AMARA pages outside the destination
 * guides, which keep their own location-specific context navigation.
 */
import ContextNavigation, {
  type ContextNavigationItem
} from './ContextNavigation.astro';
import { resolveLink } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
  pageTitle: string;
  breadcrumbTitle?: string;
  pathname: string;
  isStay?: boolean;
}

const {
  lang,
  pageTitle,
  breadcrumbTitle: breadcrumbTitleOverride,
  pathname,
  isStay = false
} = Astro.props;

const labels: Record<
  AmaraLanguage,
  {
    breadcrumb: string;
    discover: string;
    aboutUs: string;
    stays: string;
    switcher: string;
    destinations: string;
    allStays: string;
    amenities: string;
    reviews: string;
    checkAvailability: string;
    directBookingBenefits: string;
    faq: string;
    arrival: string;
  }
> = {
  en: {
    breadcrumb: 'Breadcrumb',
    discover: 'Discover AMARA',
    aboutUs: 'About Us',
    stays: 'Stays',
    switcher: 'Explore AMARA',
    destinations: 'Destinations',
    allStays: 'All stays',
    amenities: 'Comfort & Amenities',
    reviews: 'Guest Reviews',
    checkAvailability: 'Check Availability',
    directBookingBenefits: 'Direct Booking Benefits',
    faq: 'Stay FAQ',
    arrival: 'Arrival Guide'
  },
  de: {
    breadcrumb: 'Brotkrümelnavigation',
    discover: 'AMARA entdecken',
    aboutUs: 'Über uns',
    stays: 'Unterkünfte',
    switcher: 'AMARA entdecken',
    destinations: 'Reiseziele',
    allStays: 'Alle Unterkünfte',
    amenities: 'Komfort & Ausstattung',
    reviews: 'Gästebewertungen',
    checkAvailability: 'Verfügbarkeit prüfen',
    directBookingBenefits: 'Vorteile der Direktbuchung',
    faq: 'Aufenthalts-FAQ',
    arrival: 'Anreise-Guide'
  },
  es: {
    breadcrumb: 'Migas de pan',
    discover: 'Descubrir AMARA',
    aboutUs: 'Sobre nosotros',
    stays: 'Alojamientos',
    switcher: 'Descubrir AMARA',
    destinations: 'Destinos',
    allStays: 'Todos los alojamientos',
    amenities: 'Confort y servicios',
    reviews: 'Opiniones de huéspedes',
    checkAvailability: 'Ver disponibilidad',
    directBookingBenefits: 'Ventajas de reserva directa',
    faq: 'FAQ de la estancia',
    arrival: 'Guía de llegada'
  },
  nl: {
    breadcrumb: 'Broodkruimelnavigatie',
    discover: 'AMARA ontdekken',
    aboutUs: 'Over ons',
    stays: 'Verblijven',
    switcher: 'AMARA ontdekken',
    destinations: 'Bestemmingen',
    allStays: 'Alle verblijven',
    amenities: 'Comfort en voorzieningen',
    reviews: 'Gastbeoordelingen',
    checkAvailability: 'Beschikbaarheid bekijken',
    directBookingBenefits: 'Voordelen van direct boeken',
    faq: 'Verblijfs-FAQ',
    arrival: 'Aankomstgids'
  },
  sv: {
    breadcrumb: 'Brödsmulenavigering',
    discover: 'Upptäck AMARA',
    aboutUs: 'Om oss',
    stays: 'Boenden',
    switcher: 'Upptäck AMARA',
    destinations: 'Resmål',
    allStays: 'Alla boenden',
    amenities: 'Komfort och bekvämligheter',
    reviews: 'Gästrecensioner',
    checkAvailability: 'Se tillgänglighet',
    directBookingBenefits: 'Fördelar med direktbokning',
    faq: 'FAQ för vistelsen',
    arrival: 'Ankomstguide'
  }
};

const copy = labels[lang];
const normalizePath = (value: string) =>
  (value.replace(/\/index\.html$/i, '/').replace(/\.html$/i, '').replace(/\/$/, '') || '/');
const currentPath = normalizePath(pathname);
const homeHref = resolveLink('home', lang);
const isHome = currentPath === normalizePath(homeHref);
const cleanPageTitle = pageTitle.replace(/\s*[|–—-]\s*AMARA(?:\s+Lodging)?\s*$/i, '').trim();
const isDirectBookingBenefits =
  currentPath === normalizePath(resolveLink('direct_booking_benefits', lang));
const breadcrumbSection = isDirectBookingBenefits
  ? copy.aboutUs
  : isStay
    ? copy.stays
    : copy.discover;
const resolvedBreadcrumbTitle = isDirectBookingBenefits
  ? copy.directBookingBenefits
  : breadcrumbTitleOverride?.trim() || cleanPageTitle || breadcrumbSection;
const breadcrumbSectionHref = isStay && breadcrumbTitleOverride
  ? resolveLink('romantic_hideaways', lang)
  : undefined;

const genericItems: ContextNavigationItem[] = [
  { id: 'destinations', href: resolveLink('explore_hub', lang), label: copy.destinations },
  { id: 'stays', href: resolveLink('romantic_hideaways', lang), label: copy.allStays },
  { id: 'amenities', href: resolveLink('amenities', lang), label: copy.amenities },
  { id: 'reviews', href: resolveLink('reviews_hub', lang), label: copy.reviews },
  { id: 'availability', href: resolveLink('book', lang), label: copy.checkAvailability },
  { id: 'faq', href: resolveLink('faq_general', lang), label: copy.faq }
];

/**
 * Stay pages carry no context navigation. The row competed with the booking CTA
 * directly beneath it and repeated links the footer already offers; the arrival
 * guide now sits in the page's own "Plan your stay" section, where a guest looks
 * for it. Breadcrumbs are unaffected — they render from `breadcrumbs`, not here.
 */
const stayItems: ContextNavigationItem[] = [];

/**
 * The reviews hub drops the link row for the same reason stay pages do: it sat
 * above a page whose job is to build confidence and offered five ways to leave.
 * Its breadcrumb stays, so the trail back is intact.
 */
const isReviewsHub = currentPath === normalizePath(resolveLink('reviews_hub', lang));

const items = isStay || isReviewsHub ? stayItems : genericItems;
const activeId = items.find((item) => normalizePath(item.href) === currentPath)?.id;
---

<ContextNavigation
  activeId={activeId}
  breadcrumbAriaLabel={copy.breadcrumb}
  breadcrumbs={isHome ? [] : [
    { label: 'AMARA', href: homeHref },
    { label: breadcrumbSection, href: breadcrumbSectionHref },
    { label: resolvedBreadcrumbTitle }
  ]}
  context="experience"
  items={items}
  switcherAriaLabel={copy.switcher}
/>
