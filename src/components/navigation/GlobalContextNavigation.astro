---
/**
 * Sitewide orientation rail for public AMARA pages outside the destination
 * guides, which keep their own location-specific context navigation.
 */
import ContextNavigation, {
  type ContextNavigationItem
} from './ContextNavigation.astro';
import { trustLabels, trustSectionLabels } from '../../content/trustLabels';
import { resolveLink } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
  pageTitle: string;
  breadcrumbTitle?: string;
  pathname: string;
  isStay?: boolean;
}

const {
  lang,
  pageTitle,
  breadcrumbTitle: breadcrumbTitleOverride,
  pathname,
  isStay = false
} = Astro.props;

const labels: Record<
  AmaraLanguage,
  {
    breadcrumb: string;
    discover: string;
    stays: string;
    switcher: string;
    destinations: string;
    allStays: string;
    amenities: string;
    reviews: string;
    checkAvailability: string;
    directBookingBenefits: string;
    faq: string;
    arrival: string;
  }
> = {
  en: {
    breadcrumb: 'Breadcrumb',
    discover: 'Discover AMARA',
    stays: 'Stays',
    switcher: 'Explore AMARA',
    destinations: 'Destinations',
    allStays: 'All stays',
    amenities: trustLabels.amenities.en,
    reviews: trustLabels.reviews_hub.en,
    checkAvailability: trustLabels.book.en,
    directBookingBenefits: trustLabels.direct_booking_benefits.en,
    faq: trustLabels.faq_general.en,
    arrival: 'Arrival Guide'
  },
  de: {
    breadcrumb: 'Brotkrümelnavigation',
    discover: 'AMARA entdecken',
    stays: 'Unterkünfte',
    switcher: 'AMARA entdecken',
    destinations: 'Reiseziele',
    allStays: 'Alle Unterkünfte',
    amenities: trustLabels.amenities.de,
    reviews: trustLabels.reviews_hub.de,
    checkAvailability: trustLabels.book.de,
    directBookingBenefits: trustLabels.direct_booking_benefits.de,
    faq: trustLabels.faq_general.de,
    arrival: 'Anreise-Guide'
  },
  es: {
    breadcrumb: 'Migas de pan',
    discover: 'Descubrir AMARA',
    stays: 'Alojamientos',
    switcher: 'Descubrir AMARA',
    destinations: 'Destinos',
    allStays: 'Todos los alojamientos',
    amenities: trustLabels.amenities.es,
    reviews: trustLabels.reviews_hub.es,
    checkAvailability: trustLabels.book.es,
    directBookingBenefits: trustLabels.direct_booking_benefits.es,
    faq: trustLabels.faq_general.es,
    arrival: 'Guía de llegada'
  },
  nl: {
    breadcrumb: 'Broodkruimelnavigatie',
    discover: 'AMARA ontdekken',
    stays: 'Verblijven',
    switcher: 'AMARA ontdekken',
    destinations: 'Bestemmingen',
    allStays: 'Alle verblijven',
    amenities: trustLabels.amenities.nl,
    reviews: trustLabels.reviews_hub.nl,
    checkAvailability: trustLabels.book.nl,
    directBookingBenefits: trustLabels.direct_booking_benefits.nl,
    faq: trustLabels.faq_general.nl,
    arrival: 'Aankomstgids'
  },
  sv: {
    breadcrumb: 'Brödsmulenavigering',
    discover: 'Upptäck AMARA',
    stays: 'Boenden',
    switcher: 'Upptäck AMARA',
    destinations: 'Resmål',
    allStays: 'Alla boenden',
    amenities: trustLabels.amenities.sv,
    reviews: trustLabels.reviews_hub.sv,
    checkAvailability: trustLabels.book.sv,
    directBookingBenefits: trustLabels.direct_booking_benefits.sv,
    faq: trustLabels.faq_general.sv,
    arrival: 'Ankomstguide'
  }
};

const copy = labels[lang];
const normalizePath = (value: string) =>
  (value.replace(/\/index\.html$/i, '/').replace(/\.html$/i, '').replace(/\/$/, '') || '/');
const currentPath = normalizePath(pathname);
const homeHref = resolveLink('home', lang);
const isHome = currentPath === normalizePath(homeHref);
const cleanPageTitle = pageTitle.replace(/\s*[|–—-]\s*AMARA(?:\s+Lodging)?\s*$/i, '').trim();
const isDirectBookingBenefits =
  currentPath === normalizePath(resolveLink('direct_booking_benefits', lang));
const isReviewsHub = currentPath === normalizePath(resolveLink('reviews_hub', lang));
const isCollection = currentPath === normalizePath(resolveLink('romantic_hideaways', lang));
const isAmenities = currentPath === normalizePath(resolveLink('amenities', lang));
const isAbout = currentPath === normalizePath(resolveLink('about', lang));
const isFaq = currentPath === normalizePath(resolveLink('faq_general', lang));
const isLegalNotice = currentPath === normalizePath(resolveLink('legal_notice', lang));
const isBookingStayTerms = currentPath === normalizePath(resolveLink('booking_stay_terms', lang));
const isLegalDocument = isLegalNotice || isBookingStayTerms;
const isPrimaryTrustPage =
  isAbout ||
  isReviewsHub ||
  isDirectBookingBenefits ||
  isAmenities ||
  isFaq;
const isTrustFamilyPage = isPrimaryTrustPage || isLegalDocument;

/**
 * A breadcrumb should read like the navigation, not like the SEO title. Titles
 * are written for search results — "Komfort & Ausstattung: Lizenzen und Details"
 * — and make a poor trail. Pages that have a label in the nav use that label;
 * the rest still fall back to the page title.
 */
const navLabelForPage =
  isDirectBookingBenefits ? trustLabels.direct_booking_benefits[lang]
  : isReviewsHub ? trustLabels.reviews_hub[lang]
  : isCollection ? copy.allStays
  : isAmenities ? trustLabels.amenities[lang]
  : isFaq ? trustLabels.faq_general[lang]
  : isAbout ? trustLabels.about[lang]
  : isLegalNotice ? trustLabels.legal_notice[lang]
  : isBookingStayTerms ? trustLabels.booking_stay_terms[lang]
  : undefined;

const breadcrumbSection = isTrustFamilyPage
  ? trustSectionLabels[lang]
  : isStay && !isCollection
    ? copy.stays
    : copy.discover;

const resolvedBreadcrumbTitle =
  navLabelForPage || breadcrumbTitleOverride?.trim() || cleanPageTitle || breadcrumbSection;
const breadcrumbSectionHref = isStay && breadcrumbTitleOverride
  ? resolveLink('romantic_hideaways', lang)
  : undefined;

const genericItems: ContextNavigationItem[] = [
  { id: 'stays', href: resolveLink('romantic_hideaways', lang), label: copy.allStays },
  { id: 'amenities', href: resolveLink('amenities', lang), label: copy.amenities },
  { id: 'reviews', href: resolveLink('reviews_hub', lang), label: copy.reviews },
  { id: 'availability', href: resolveLink('book', lang), label: copy.checkAvailability },
  { id: 'faq', href: resolveLink('faq_general', lang), label: copy.faq }
];

const trustItems: ContextNavigationItem[] = [
  { id: 'about', href: resolveLink('about', lang), label: trustLabels.about[lang] },
  { id: 'reviews', href: resolveLink('reviews_hub', lang), label: trustLabels.reviews_hub[lang] },
  {
    id: 'direct-booking',
    href: resolveLink('direct_booking_benefits', lang),
    label: trustLabels.direct_booking_benefits[lang]
  },
  { id: 'amenities', href: resolveLink('amenities', lang), label: trustLabels.amenities[lang] },
  { id: 'faq', href: resolveLink('faq_general', lang), label: trustLabels.faq_general[lang] }
];

/**
 * Stay pages carry no context navigation. The row competed with the booking CTA
 * directly beneath it and repeated links the footer already offers; the arrival
 * guide now sits in the page's own "Plan your stay" section, where a guest looks
 * for it. Breadcrumbs are unaffected — they render from `breadcrumbs`, not here.
 */
const stayItems: ContextNavigationItem[] = [];

const items = isStay || isLegalDocument
  ? stayItems
  : isTrustFamilyPage
    ? trustItems
    : genericItems;
const activeId = items.find(
  (item) => item.href !== undefined && normalizePath(item.href) === currentPath
)?.id;
const breadcrumbs = isHome ? [] : [
  { label: 'AMARA', href: homeHref },
  ...(!isLegalDocument
    ? [{ label: breadcrumbSection, href: breadcrumbSectionHref }]
    : []),
  { label: resolvedBreadcrumbTitle }
];
---

<ContextNavigation
  activeId={activeId}
  breadcrumbAriaLabel={copy.breadcrumb}
  breadcrumbs={breadcrumbs}
  context="experience"
  items={items}
  switcherAriaLabel={copy.switcher}
/>
