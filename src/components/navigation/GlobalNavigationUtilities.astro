---
/**
 * AMARA global navigation — right utility rail
 *
 * Architectural intent:
 * The rail is the utility and conversion cluster: language choice, the booking
 * CTA and the mobile menu trigger. It stays visually detached from the editorial
 * navigation so the CTA reads as an action anchor rather than a menu item.
 */
import type {
  ResolvedLanguageOption,
  ResolvedNavigationCta
} from './globalNavigationModel';
import type { NavigationUtilityLabels } from './globalNavigationContent';
import type { AmaraLanguage } from '../../types/seo';
import AmaraActionLink from '../actions/AmaraActionLink.astro';

interface Props {
  currentLang: AmaraLanguage;
  languageOptions: ResolvedLanguageOption[];
  cta: ResolvedNavigationCta;
  showBookingCta: boolean;
  utilityLabels: NavigationUtilityLabels;
}

const { currentLang, languageOptions, cta, showBookingCta, utilityLabels } = Astro.props;
---

<div class="am-nav__rail">
  <div class="am-nav__slot am-nav__slot--language">
    <div class="am-nav__language" data-am-language>
      <button
        type="button"
        class="am-nav__icon-button"
        aria-label={utilityLabels.selectLanguage}
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="am-nav-language-menu"
        data-am-language-trigger
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </button>

      <div id="am-nav-language-menu" class="am-nav__language-popover" data-am-language-panel>
        <div class="min-w-[144px] bg-surface/95 backdrop-blur-md border border-outline-variant/15 rounded-overlay shadow-lg shadow-black/5 py-3 px-3">
          <div class="flex flex-col gap-1">
            {languageOptions.map((lang) => (
              <a
                href={lang.href}
                class={`font-label text-[13px] transition-colors px-2 py-1.5 rounded-md ${
                  currentLang === lang.code
                    ? 'font-bold text-primary bg-primary/5'
                    : 'text-on-surface/70 hover:text-on-surface hover:bg-surface-container-low'
                }`}
              >
                {lang.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  {showBookingCta && !cta.hidden && (
    <div class="am-nav__slot am-nav__slot--cta">
      <AmaraActionLink
        href={cta.href ?? undefined}
        variant="secondary"
        disabled={cta.href === null}
      >
        <span class="am-nav__cta-label-full">{cta.label}</span>
        <span class="am-nav__cta-label-short">{cta.shortLabel}</span>
      </AmaraActionLink>
    </div>
  )}

  <div class="am-nav__slot am-nav__slot--menu">
    <button
      type="button"
      class="am-nav__icon-button am-nav__menu-trigger"
      aria-label={utilityLabels.menu}
      aria-expanded="false"
      aria-controls="amara-mobile-menu"
      data-label-open={utilityLabels.menu}
      data-label-close={utilityLabels.closeMenu}
      data-am-menu-trigger
    >
      <span class="am-nav__menu-lines" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</div>
