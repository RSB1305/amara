---
/**
 * Shared two-sided context navigation for AMARA page families.
 *
 * The component owns the approved Explore composition so family wrappers only
 * provide localized breadcrumbs, links and active-state data.
 */
export interface ContextNavigationBreadcrumb {
  label: string;
  href?: string;
}

export interface ContextNavigationItem {
  id: string;
  href: string;
  label: string;
}

interface Props {
  activeId?: string;
  backLink?: {
    href: string;
    label: string;
  };
  breadcrumbAriaLabel: string;
  breadcrumbs: ContextNavigationBreadcrumb[];
  context: 'experience' | 'location';
  items: ContextNavigationItem[];
  switcherAriaLabel: string;
}

const {
  activeId,
  backLink,
  breadcrumbAriaLabel,
  breadcrumbs,
  context,
  items,
  switcherAriaLabel
} = Astro.props;

// The breadcrumb already identifies the current page. Removing it from the
// sibling switcher keeps the navigation focused on the available next steps.
const visibleItems = activeId
  ? items.filter((item) => item.id !== activeId)
  : items;
---

<div
  class="border-b border-outline-variant/10 bg-surface"
  data-am-context-navigation
  data-am-experience-context={context === 'experience' ? '' : undefined}
  data-am-location-context={context === 'location' ? '' : undefined}
>
  <div class="mx-auto max-w-screen-2xl px-6 py-5 md:px-12">
    <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
      {
        breadcrumbs.length > 0 && (
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
        <nav aria-label={breadcrumbAriaLabel}>
          <ol class="flex flex-wrap items-center gap-2 font-label text-[10px] font-semibold uppercase tracking-[0.14em] text-on-surface/55">
            {
              breadcrumbs.map((breadcrumb, index) => {
                const isCurrent = index === breadcrumbs.length - 1;

                return (
                  <>
                    {index > 0 && (
                      <li aria-hidden="true" class="text-outline-variant/60">
                        /
                      </li>
                    )}
                    <li
                      aria-current={isCurrent ? 'page' : undefined}
                      class:list={[isCurrent && 'text-on-surface']}
                    >
                      {breadcrumb.href && !isCurrent ? (
                        <a
                          href={breadcrumb.href}
                          class="transition-colors hover:text-primary"
                        >
                          {breadcrumb.label}
                        </a>
                      ) : (
                        breadcrumb.label
                      )}
                    </li>
                  </>
                );
              })
            }
          </ol>
        </nav>

        {
          backLink && (
            <a
              href={backLink.href}
              aria-label={backLink.label}
              class="inline-flex h-9 w-9 items-center justify-center text-primary transition-colors hover:text-on-surface"
            >
              <span aria-hidden="true">&larr;</span>
            </a>
          )
        }
      </div>
        )
      }

      <nav aria-label={switcherAriaLabel} class="min-w-0">
        <ul class="-mx-1 flex flex-nowrap items-center gap-0.5 overflow-x-auto overscroll-x-contain pb-1 xl:justify-end xl:overflow-visible xl:pb-0">
          {
            visibleItems.map((item) => (
              <li
                class="shrink-0"
                data-am-context-sibling
                data-am-experience-sibling={context === 'experience' ? '' : undefined}
                data-am-location-sibling={context === 'location' ? '' : undefined}
              >
                <a
                  href={item.href}
                  class="inline-flex min-h-8 items-center border-b border-transparent px-2 font-label text-[10px] font-medium uppercase tracking-[0.06em] text-on-surface-variant transition-colors hover:border-primary/45 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</div>
