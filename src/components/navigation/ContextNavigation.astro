---
/**
 * Shared two-sided context navigation for AMARA page families.
 *
 * The component owns the approved Explore composition so family wrappers only
 * provide localized breadcrumbs, links and active-state data.
 */
export interface ContextNavigationBreadcrumb {
  label: string;
  href?: string;
}

export interface ContextNavigationItem {
  id: string;
  href?: string;
  label: string;
  status?: 'live' | 'future';
}

export interface ContextNavigationGroup {
  id: string;
  items: ContextNavigationItem[];
  label: string;
}

import DestinationBranchSwitcher from './DestinationBranchSwitcher.astro';
import GroupedContextNavigation from './GroupedContextNavigation.astro';
import DestinationContextDisclosures from './DestinationContextDisclosures.astro';

interface Props {
  activeId?: string;
  activeBranchId?: string;
  branches?: { id: string; href: string; label: string }[];
  branchSwitcherAriaLabel?: string;
  branchGroups?: Record<string, ContextNavigationGroup[]>;
  breadcrumbAriaLabel: string;
  breadcrumbs: ContextNavigationBreadcrumb[];
  context: 'experience' | 'location';
  groups?: ContextNavigationGroup[];
  items?: ContextNavigationItem[];
  retainActiveItem?: boolean;
  switcherAriaLabel: string;
  wrapItems?: boolean;
}

const {
  activeId,
  activeBranchId,
  branches = [],
  branchSwitcherAriaLabel,
  branchGroups,
  breadcrumbAriaLabel,
  breadcrumbs,
  context,
  groups = [],
  items = [],
  retainActiveItem = false,
  switcherAriaLabel,
  wrapItems = false
} = Astro.props;

// The breadcrumb already identifies the current page. Removing it from the
// sibling switcher keeps the navigation focused on the available next steps.
const visibleItems = activeId && !retainActiveItem
  ? items.filter((item) => item.id !== activeId)
  : items;
---

<div data-am-context-navigation-shell={groups.length > 0 || branchGroups ? '' : undefined}>
  <div
    class="border-b border-outline-variant/10 bg-surface"
    data-am-context-navigation
    data-am-context-navigation-grouped={groups.length > 0 || branchGroups ? '' : undefined}
    data-am-experience-context={context === 'experience' ? '' : undefined}
    data-am-location-context={context === 'location' ? '' : undefined}
  >
  <div
    class:list={[
      'mx-auto max-w-screen-2xl px-6 md:px-12',
      'py-1.5 xl:py-1'
    ]}
    data-am-context-inner
  >
    <div
      class:list={[
        'grid min-h-10 grid-cols-[max-content_minmax(0,1fr)] items-center gap-x-3'
      ]}
      data-am-context-layout={groups.length > 0 || branchGroups ? '' : undefined}
    >
      {
        breadcrumbs.length > 0 && (
      <div
        class:list={[
          'min-w-0',
          'overflow-hidden'
        ]}
        data-am-context-breadcrumb-row
      >
        <nav class="min-w-0 max-w-full" aria-label={breadcrumbAriaLabel}>
          <ol
            class:list={[
              'flex w-full max-w-full items-center am-text-nav-breadcrumb text-on-surface/70',
              'am-text-nav-breadcrumb--responsive min-w-0 flex-nowrap gap-1 overflow-hidden md:gap-2'
            ]}
          >
            {
              breadcrumbs.map((breadcrumb, index) => {
                const isCurrent = index === breadcrumbs.length - 1;
                const isAmaraHome = index === 0 && breadcrumb.label.trim().toUpperCase() === 'AMARA';
                const breadcrumbLabel = isAmaraHome ? (
                  <>
                    <span aria-hidden="true">&hearts;</span>
                    <span class="sr-only">AMARA</span>
                  </>
                ) : breadcrumb.label;

                return (
                  <>
                    {index > 0 && (
                      <li
                        aria-hidden="true"
                        class="text-outline-variant/60"
                        data-am-context-mobile-hidden={index > 1 ? '' : undefined}
                      >
                        /
                      </li>
                    )}
                    <li
                      aria-current={isCurrent ? 'page' : undefined}
                      class:list={[
                        'truncate',
                        (index === 0 || (index === 1 && !isCurrent)) && 'shrink-0',
                        isCurrent && 'min-w-0',
                        isCurrent && 'text-on-surface'
                      ]}
                      data-am-context-breadcrumb-current={isCurrent ? '' : undefined}
                      data-am-context-mobile-hidden={index > 1 ? '' : undefined}
                    >
                      {breadcrumb.href && !isCurrent ? (
                        <a
                          href={breadcrumb.href}
                          class="transition-colors hover:text-primary"
                        >
                          {breadcrumbLabel}
                        </a>
                      ) : (
                        breadcrumbLabel
                      )}
                    </li>
                  </>
                );
              })
            }
          </ol>
        </nav>

      </div>
        )
      }

      {(branches.length > 0 || groups.length > 0 || visibleItems.length > 0) && (
      <div
        class:list={[
          'ml-auto flex min-w-0 max-w-full gap-3 overflow-hidden'
        ]}
        data-am-context-toolbar={groups.length > 0 || branchGroups ? '' : undefined}
      >
        {branches.length > 0 && branchSwitcherAriaLabel && !branchGroups && (
          <DestinationBranchSwitcher
            activeId={activeBranchId}
            ariaLabel={branchSwitcherAriaLabel}
            items={branches}
          />
        )}
        {branchGroups && branches.length > 0 && branchSwitcherAriaLabel ? (
          <DestinationContextDisclosures
            activeBranchId={activeBranchId}
            activeId={activeId}
            ariaLabel={branchSwitcherAriaLabel}
            branches={branches}
            groups={branchGroups}
          />
        ) : groups.length > 0 ? (
          <GroupedContextNavigation
            activeId={activeId}
            context={context}
            groups={groups}
            navigationAriaLabel={switcherAriaLabel}
          />
        ) : visibleItems.length > 0 && (
      <nav aria-label={switcherAriaLabel} class="min-w-0 max-w-full">
        <ul
          data-am-context-scroll-rail
          class:list={[
            'flex items-center gap-x-0.5 gap-y-1',
            wrapItems
              ? 'flex-wrap xl:flex-nowrap xl:justify-end'
              : '-mx-1 flex-nowrap overflow-x-auto overscroll-x-contain pb-1 xl:justify-end xl:overflow-visible xl:pb-0'
          ]}
        >
          {
            visibleItems.map((item) => {
              const isActiveItem = item.id === activeId;
              const isLiveItem = item.status !== 'future' && Boolean(item.href);

              return (
                <li
                  class:list={[!wrapItems && 'shrink-0']}
                  data-am-context-sibling
                  data-am-context-sibling-status={isLiveItem ? 'live' : 'future'}
                  data-am-experience-sibling={context === 'experience' ? '' : undefined}
                  data-am-location-sibling={context === 'location' ? '' : undefined}
                >
                  {isLiveItem ? (
                    <a
                      href={item.href}
                      aria-current={isActiveItem ? 'page' : undefined}
                      class:list={[
                        'inline-flex min-h-8 items-center border-b px-2 am-text-nav-context transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25',
                        isActiveItem
                          ? 'border-primary font-bold text-on-surface'
                          : 'border-transparent text-on-surface hover:border-primary/45'
                      ]}
                    >
                      {item.label}
                    </a>
                  ) : (
                    <span
                      aria-disabled="true"
                      class="inline-flex min-h-8 items-center px-2 am-text-nav-context text-muted"
                    >
                      {item.label}
                    </span>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>
        )}
      </div>
      )}
    </div>
  </div>
  </div>
</div>

<style>
  @media (max-width: 1279px) {
    [data-am-context-navigation-shell] {
      min-height: 53px;
    }

    [data-am-context-navigation] [data-am-context-mobile-hidden] {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    [data-am-context-layout] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 52rem);
      align-items: center;
      column-gap: 2rem;
    }

    [data-am-context-breadcrumb-row] {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }

    [data-am-context-toolbar] {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.25rem 0.75rem;
    }

    [data-am-context-toolbar] [data-am-grouped-context-navigation] {
      flex-basis: 100%;
      width: 100%;
    }
  }

</style>
