---
/** Crawlable destination-level switch between location and experience hubs. */
interface BranchItem {
  id: string;
  href: string;
  label: string;
}

interface Props {
  activeId: string;
  ariaLabel: string;
  items: BranchItem[];
}

const { activeId, ariaLabel, items } = Astro.props;
---

<nav aria-label={ariaLabel} data-am-destination-branch-switcher>
  <ul class="inline-flex items-center whitespace-nowrap">
    {items.map((item) => {
      const isActive = item.id === activeId;

      return (
        <li>
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-8 items-center border-b-2 px-3 font-label text-[10px] font-semibold uppercase tracking-[0.08em] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25',
              isActive
                ? 'border-primary text-on-surface'
                : 'border-transparent text-on-surface-variant hover:border-outline hover:text-on-surface'
            ]}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
