---
import { ChevronDown } from '@lucide/astro';
import type {
  ContextNavigationGroup,
  ContextNavigationItem
} from './ContextNavigation.astro';

interface Props {
  activeId?: string;
  context: 'experience' | 'location';
  groups: ContextNavigationGroup[];
  navigationAriaLabel: string;
}

const {
  activeId,
  context,
  groups,
  navigationAriaLabel
} = Astro.props;

const isLiveItem = (item: ContextNavigationItem) =>
  item.status !== 'future' && Boolean(item.href);

const groupContainsActiveItem = (group: ContextNavigationGroup) =>
  group.items.some((item) => item.id === activeId);

const itemClasses = (item: ContextNavigationItem) => [
  'am-context-grouped__item flex min-h-10 w-full items-center border-l-2 px-4 py-2 font-label text-[10px] font-medium uppercase tracking-[0.06em] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/25',
  item.id === activeId
    ? 'border-primary bg-primary/[0.05] font-semibold text-on-surface'
    : 'border-transparent text-on-surface-variant hover:border-primary/45 hover:bg-primary/[0.03] hover:text-on-surface'
];
---

<div class="w-full shrink-0" data-am-grouped-context-navigation>
  <nav class="w-full" aria-label={navigationAriaLabel}>
    <div class="w-full" data-am-context-panel>
      <div
        class="am-context-grouped__groups grid gap-2"
        data-am-context-groups
        style={`--am-context-group-count: ${groups.length};`}
      >
        {groups.map((group) => (
          <details
            class="am-context-grouped__group border-b border-outline-variant/15 xl:border-b-0"
            data-am-context-group
            data-am-context-group-active={groupContainsActiveItem(group) ? '' : undefined}
          >
            <summary
              class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-2 font-label text-[10px] font-normal uppercase tracking-[0.08em] text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/25 [&::-webkit-details-marker]:hidden xl:min-h-9 xl:justify-center xl:px-3 xl:text-[9px] xl:tracking-[0.06em] xl:text-center"
            >
              <span>{group.label}</span>
              <ChevronDown
                aria-hidden="true"
                class="am-context-grouped__chevron size-3.5 shrink-0 transition-transform duration-200"
                stroke-width={1.5}
              />
            </summary>

            <ul class="am-context-grouped__items pb-2 xl:pb-0">
              {group.items.map((item) => (
                <li
                  data-am-context-sibling
                  data-am-context-sibling-status={isLiveItem(item) ? 'live' : 'future'}
                  data-am-experience-sibling={context === 'experience' ? '' : undefined}
                  data-am-location-sibling={context === 'location' ? '' : undefined}
                >
                  {isLiveItem(item) ? (
                    <a
                      href={item.href}
                      aria-current={item.id === activeId ? 'page' : undefined}
                      class:list={itemClasses(item)}
                    >
                      {item.label}
                    </a>
                  ) : (
                    <span
                      aria-disabled="true"
                      class="am-context-grouped__item flex min-h-10 w-full items-center px-4 py-2 font-label text-[10px] font-medium uppercase tracking-[0.06em] text-muted"
                    >
                      {item.label}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </nav>
</div>

<style>
  [data-am-context-group][open] .am-context-grouped__chevron {
    transform: rotate(180deg);
  }

  @media (min-width: 1280px) {
    .am-context-grouped__groups {
      position: relative;
      grid-template-columns: repeat(var(--am-context-group-count), max-content);
      justify-content: end;
      column-gap: 1.75rem;
      row-gap: 0;
      min-height: 2.25rem;
    }

    .am-context-grouped__group {
      position: relative;
    }

    .am-context-grouped__group[open] > summary,
    .am-context-grouped__group[data-am-context-group-active] > summary {
      color: var(--color-primary);
    }

    .am-context-grouped__items {
      position: absolute;
      z-index: 10;
      top: calc(100% + 0.25rem);
      right: auto;
      left: 0;
      display: block;
      width: max-content;
      max-width: calc(100vw - 6rem);
      min-height: 0;
      border: 1px solid color-mix(in srgb, var(--color-outline-variant) 14%, transparent);
      background: var(--color-surface-white);
      padding: 0.75rem 0.5rem;
      box-shadow: 0 14px 32px rgba(45, 39, 31, 0.08);
    }

    .am-context-grouped__items > li {
      width: auto;
    }

    .am-context-grouped__item {
      width: auto;
      padding-inline: 0.75rem;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-context-grouped__chevron {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-am-grouped-context-navigation]').forEach((root) => {
    const groupDisclosures = Array.from(
      root.querySelectorAll<HTMLDetailsElement>('[data-am-context-group]')
    );
    const desktopViewport = window.matchMedia('(min-width: 1280px)');

    groupDisclosures.forEach((groupDisclosure) => {
      groupDisclosure.addEventListener('toggle', () => {
        if (!groupDisclosure.open) return;

        groupDisclosures.forEach((candidate) => {
          if (candidate !== groupDisclosure) candidate.open = false;
        });
      });
    });

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('a')) return;

      groupDisclosures.forEach((groupDisclosure) => {
        groupDisclosure.open = false;
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !desktopViewport.matches) return;
      groupDisclosures.forEach((groupDisclosure) => {
        groupDisclosure.open = false;
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (!desktopViewport.matches) return;
      if (event.target instanceof Node && root.contains(event.target)) return;

      groupDisclosures.forEach((groupDisclosure) => {
        groupDisclosure.open = false;
      });
    });
  });
</script>
