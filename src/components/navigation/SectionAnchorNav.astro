---
/**
 * On-page section anchor navigation (Type A and similar long pages).
 * Local content nav only — not a substitute for the global main navigation.
 */
export interface SectionAnchorNavItem {
  label: string;
  href: string;
  id?: string;
}

interface Props {
  items: SectionAnchorNavItem[];
  activeId?: string;
}

const { items, activeId } = Astro.props;
---

<nav
  class="border-b border-outline-variant/5 bg-transparent"
  aria-label="On this page"
>
  <div class="max-w-screen-2xl mx-auto px-6 py-2 md:px-12">
    <ul
      class="-mx-1 flex flex-nowrap items-center gap-4 overflow-x-auto overscroll-x-contain md:flex-wrap md:justify-center md:gap-6 md:overflow-visible"
    >
      {
        items.map((item) => (
          <li class="shrink-0">
            <a
              href={item.href}
              aria-current={item.id && activeId && item.id === activeId ? 'location' : undefined}
              class:list={[
                'relative inline-flex min-h-11 items-center whitespace-nowrap px-1 font-label text-[13px] font-medium tracking-[0.035em] transition-colors after:absolute after:bottom-0 after:left-1/2 after:h-px after:w-7 after:-translate-x-1/2 after:origin-center after:scale-x-0 after:bg-primary after:transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25 focus-visible:ring-offset-2',
                item.id && activeId && item.id === activeId
                  ? 'text-on-surface after:scale-x-100'
                  : 'text-on-surface-variant hover:text-on-surface hover:after:scale-x-100'
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
