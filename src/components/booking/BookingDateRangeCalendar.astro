---
import AmaraActionButton from '../actions/AmaraActionButton.astro';

interface Props {
  title: string;
  help: string;
  closeLabel: string;
  previousMonthLabel: string;
  nextMonthLabel: string;
  clearLabel?: string;
  submitLabel?: string;
}

const {
  title,
  help,
  closeLabel,
  previousMonthLabel,
  nextMonthLabel,
  clearLabel,
  submitLabel
} = Astro.props;
---

<div
  class="am-booking-calendar mt-6 border-y border-border-subtle bg-surface"
  hidden
  data-am-booking-calendar
>
  <div class="am-booking-calendar__header">
    <div>
      <p class="am-text-label text-on-surface-variant">{title}</p>
      <p
        class="am-text-caption mt-2 font-normal leading-relaxed text-on-surface-variant"
        role="status"
        aria-live="polite"
        data-am-booking-calendar-status
      >
        {help}
      </p>
    </div>
    <button
      class="am-booking-calendar__text-action am-text-label"
      type="button"
      data-am-booking-calendar-close
    >
      {closeLabel}
    </button>
  </div>

  <div class="am-booking-calendar__navigation">
    <button
      class="am-booking-calendar__nav-button"
      type="button"
      aria-label={previousMonthLabel}
      data-am-booking-calendar-prev
    >←</button>
    <button
      class="am-booking-calendar__nav-button"
      type="button"
      aria-label={nextMonthLabel}
      data-am-booking-calendar-next
    >→</button>
  </div>

  <div class="am-booking-calendar__months" data-am-booking-calendar-months></div>

  {(clearLabel || submitLabel) && (
    <div class="am-booking-calendar__footer">
      {clearLabel && (
        <button
          class="am-booking-calendar__text-action am-text-label"
          type="button"
          data-am-booking-calendar-clear
        >
          {clearLabel}
        </button>
      )}
      {submitLabel && (
        <AmaraActionButton
          variant="primary"
          class="min-h-12 w-full justify-center sm:w-auto"
          type="submit"
          disabled
          data-am-booking-calendar-submit
        >
          {submitLabel}
        </AmaraActionButton>
      )}
    </div>
  )}
</div>

<style is:global>
  .am-booking-calendar {
    width: min(100%, 60rem);
    margin-inline: auto;
    padding: 1.25rem 0;
  }

  .am-booking-calendar__header,
  .am-booking-calendar__footer,
  .am-booking-calendar__navigation {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .am-booking-calendar__header {
    padding: 0 0.25rem 1rem;
  }

  .am-booking-calendar__header > div {
    min-width: 0;
    flex: 1 1 auto;
  }

  .am-booking-calendar [data-am-booking-calendar-status-state='minimum-stay'] {
    max-width: 48rem;
    border-left: 0.25rem solid var(--color-on-surface);
    background: color-mix(in srgb, var(--color-on-surface) 5%, var(--color-surface));
    padding: 0.75rem 1rem;
    color: var(--color-on-surface);
    font-weight: 700;
  }

  .am-booking-calendar__navigation {
    justify-content: flex-end;
    border-top: 1px solid var(--color-outline-variant);
    padding: 0.75rem 0.25rem;
  }

  .am-booking-calendar__footer {
    justify-content: flex-end;
    align-items: center;
    border-top: 1px solid var(--color-outline-variant);
    margin-top: 1rem;
    padding: 1rem 0.25rem 0;
  }

  .am-booking-calendar__text-action {
    flex: 0 0 auto;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-on-surface);
  }

  .am-booking-calendar__nav-button {
    display: inline-flex;
    min-height: 2.75rem;
    min-width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-control);
    color: var(--color-on-surface);
    font-size: 1.25rem;
  }

  .am-booking-calendar button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .am-booking-calendar__nav-button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .am-booking-calendar__months {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .am-booking-calendar__month {
    min-width: 0;
  }

  .am-booking-calendar__month-title {
    min-height: 2.25rem;
    padding: 0 0.25rem 0.75rem;
    color: var(--color-on-surface);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 400;
    text-transform: capitalize;
  }

  .am-booking-calendar__weekdays,
  .am-booking-calendar__days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .am-booking-calendar__weekdays {
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .am-booking-calendar__weekday {
    padding: 0.45rem 0.1rem;
    text-align: center;
  }

  .am-booking-calendar__days {
    row-gap: 0.25rem;
    padding-top: 0.35rem;
  }

  .am-booking-calendar__day,
  .am-booking-calendar__blank {
    min-width: 0;
    min-height: 4.25rem;
  }

  .am-booking-calendar__day {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border: 1px solid transparent;
    color: var(--color-on-surface);
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .am-booking-calendar__day:not(:disabled):hover {
    border-color: var(--color-primary);
  }

  .am-booking-calendar__day:disabled {
    cursor: not-allowed;
    color: color-mix(in srgb, var(--color-on-surface-variant) 42%, transparent);
  }

  .am-booking-calendar__day:disabled .am-booking-calendar__day-number {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .am-booking-calendar__day[data-am-booking-day-state] {
    cursor: default;
    color: color-mix(in srgb, var(--color-on-surface-variant) 68%, transparent);
  }

  .am-booking-calendar__day[data-am-booking-day-state] .am-booking-calendar__day-number {
    text-decoration: none;
  }

  .am-booking-calendar__day[data-am-booking-day-state='loading'] {
    cursor: wait;
  }

  .am-booking-calendar__day[data-am-booking-day-state='restricted'] {
    cursor: not-allowed;
    color: var(--color-on-surface-variant);
  }

  .am-booking-calendar__day[data-am-booking-restriction='minimum-stay'] {
    cursor: pointer;
  }

  .am-booking-calendar__day-loading {
    display: block;
    width: 1.8rem;
    height: 0.3rem;
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-on-surface-variant) 24%, transparent);
  }

  .am-booking-calendar__day[data-am-booking-day-state='loading']
    .am-booking-calendar__day-loading {
    animation: am-booking-calendar-loading 1.2s ease-in-out infinite alternate;
  }

  @keyframes am-booking-calendar-loading {
    to {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-booking-calendar__day[data-am-booking-day-state='loading']
      .am-booking-calendar__day-loading {
      animation: none;
    }
  }

  .am-booking-calendar__day[data-range='middle'] {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-surface));
  }

  .am-booking-calendar__day[data-range='start'],
  .am-booking-calendar__day[data-range='end'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .am-booking-calendar__day-number {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1;
  }

  .am-booking-calendar__day-price {
    display: flex;
    max-width: 100%;
    flex-direction: column;
    align-items: center;
    color: var(--color-on-surface-variant);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
  }

  .am-booking-calendar__day-price-prefix,
  .am-booking-calendar__day-price-amount {
    display: block;
  }

  .am-booking-calendar__day[data-range='start'] .am-booking-calendar__day-price,
  .am-booking-calendar__day[data-range='end'] .am-booking-calendar__day-price {
    color: var(--color-on-primary);
  }

  /**
   * Date selection uses the same calm bottom sheet in every booking context.
   * Keeping it out of document flow prevents either the home finder or a stay
   * panel from jumping by more than a viewport while guests choose dates.
   */
  @media (max-width: 639px) {
    .am-booking-calendar {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 120;
      width: 100%;
      max-height: 85dvh;
      margin: 0;
      overflow-y: auto;
      border-top: 1px solid var(--color-outline-variant);
      box-shadow: 0 -12px 32px rgb(0 0 0 / 18%);
    }
  }

  @media (min-width: 64rem) {
    .am-booking-calendar__months {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .am-booking-calendar__day,
    .am-booking-calendar__blank {
      min-height: 4.5rem;
    }
  }
</style>
