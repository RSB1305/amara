---
import { staySearchCopy, staySearchDestinations } from '../../content/staySearchContent';
import type { AmaraLanguage } from '../../types/seo';
import { ChevronDown } from '@lucide/astro';
import AmaraActionButton from '../actions/AmaraActionButton.astro';
import AmaraFormControl from '../forms/AmaraFormControl.astro';
import BookingDateRangeCalendar from './BookingDateRangeCalendar.astro';

interface Props {
  lang: AmaraLanguage;
  action: string;
  variant?: 'home' | 'results';
}

const { lang, action, variant = 'home' } = Astro.props;
const t = (value: Record<AmaraLanguage, string>) => value[lang] ?? value.en;
const copy = Object.fromEntries(
  Object.entries(staySearchCopy).map(([key, value]) => [key, t(value)])
);
const guestOptions = [1, 2, 3, 4];
const destinationControlId = `am-stay-search-destination-${variant}`;
const destinationLabelId = `${destinationControlId}-label`;
const destinationListboxId = `${destinationControlId}-listbox`;
const destinationValueId = `${destinationControlId}-value`;
const guestsControlId = `am-stay-search-guests-${variant}`;
const guestsLabelId = `${guestsControlId}-label`;
const guestsListboxId = `${guestsControlId}-listbox`;
const guestsValueId = `${guestsControlId}-value`;
const initialGuestLabel = t(staySearchCopy.guestsPlural).replace('{count}', '2');
const controlLabelClasses = [
  'am-text-label text-on-surface-variant',
  variant === 'home' && 'font-semibold normal-case tracking-normal'
];
---

<section
  id={variant === 'home' ? 'stay-search' : undefined}
  class:list={[
    'am-stay-search relative z-[3]',
    variant === 'home'
      ? 'mx-auto w-[min(100%-3rem,70rem)] -mt-8 bg-surface p-4 md:-mt-8 md:p-5'
      : 'bg-surface-container-low p-5 md:p-7'
  ]}
  aria-label={t(staySearchCopy.eyebrow)}
  data-am-stay-search-finder
  data-am-stay-search-language={lang}
  data-am-stay-search-variant={variant}
  data-am-stay-search-copy={JSON.stringify(copy)}
>
  {/* The section already carries this as its accessible name, so on a phone the
      eyebrow is redundant chrome: it wrapped to two lines and was the loudest
      element in a widget that should read as a quiet utility. */}
  {variant === 'home' && (
    <p class="am-text-eyebrow mb-4 hidden text-primary sm:block">{t(staySearchCopy.eyebrow)}</p>
  )}

  <form action={action} method="get" data-am-stay-search-form>
    {/* Arrival and departure share a row below sm; the form was five stacked
        controls tall, which filled most of a phone viewport directly under the
        hero. */}
    <div
      class:list={[
        'grid grid-cols-4 sm:grid-cols-2 lg:grid-cols-[1.1fr_1fr_1fr_0.75fr] lg:items-end',
        variant === 'home' ? 'gap-3' : 'gap-4'
      ]}
    >
      <div class="am-select-menu order-1 col-span-3 block min-w-0 sm:col-span-2 lg:col-span-1" data-am-select-menu="destination">
        <label id={destinationLabelId} for={destinationControlId} class:list={controlLabelClasses}>
          {t(staySearchCopy.destination)}
        </label>
        <AmaraFormControl
          as="select"
          id={destinationControlId}
          name="destination"
          class="am-select-menu__native"
          data={{ 'data-am-stay-search-destination': '', 'data-am-select-menu-native': '' }}
        >
          {staySearchDestinations.map((destination) => (
            <option value={destination.value}>{t(destination.label)}</option>
          ))}
        </AmaraFormControl>
        <button
          class="am-form-control am-form-control--trigger am-text-form-value am-select-menu__trigger mt-2"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls={destinationListboxId}
          aria-labelledby={`${destinationLabelId} ${destinationValueId}`}
          hidden
          data-am-select-menu-trigger
        >
          <span class="min-w-0 flex-1 truncate" id={destinationValueId} data-am-select-menu-value>
            {t(staySearchDestinations[0].label)}
          </span>
          <ChevronDown class="am-select-menu__chevron h-4 w-4 shrink-0" stroke-width={1.6} aria-hidden="true" />
        </button>
        <div class="am-select-menu__popover" hidden data-am-select-menu-popover>
          <div id={destinationListboxId} role="listbox" aria-labelledby={destinationLabelId} data-am-select-menu-listbox></div>
        </div>
      </div>

      <label class="order-3 col-span-2 block am-stay-search__native-date sm:order-2 sm:col-span-1">
        <span class:list={controlLabelClasses}>{t(staySearchCopy.arrival)}</span>
        <AmaraFormControl
          as="input"
          name="arrival"
          required
          data={{ 'data-am-stay-search-arrival': '' }}
        />
      </label>
      <div class="order-3 col-span-2 am-stay-search__date-trigger sm:order-2 sm:col-span-1" hidden data-am-stay-search-arrival-trigger-wrap>
        <span class:list={controlLabelClasses}>{t(staySearchCopy.arrival)}</span>
        <AmaraFormControl
          as="button"
          trigger
          ariaExpanded={false}
          data={{ 'data-am-stay-search-arrival-trigger': '' }}
        >
          <span data-am-stay-search-arrival-value>{t(staySearchCopy.chooseArrival)}</span>
        </AmaraFormControl>
      </div>

      <label class="order-4 col-span-2 block am-stay-search__native-date sm:order-3 sm:col-span-1">
        <span class:list={controlLabelClasses}>{t(staySearchCopy.departure)}</span>
        <AmaraFormControl
          as="input"
          name="departure"
          required
          data={{ 'data-am-stay-search-departure': '' }}
        />
      </label>
      <div class="order-4 col-span-2 am-stay-search__date-trigger sm:order-3 sm:col-span-1" hidden data-am-stay-search-departure-trigger-wrap>
        <span class:list={controlLabelClasses}>{t(staySearchCopy.departure)}</span>
        <AmaraFormControl
          as="button"
          trigger
          ariaExpanded={false}
          data={{ 'data-am-stay-search-departure-trigger': '' }}
        >
          <span data-am-stay-search-departure-value>{t(staySearchCopy.chooseDeparture)}</span>
        </AmaraFormControl>
      </div>

      <div class="am-select-menu order-2 col-span-1 block min-w-0 sm:order-4 sm:col-span-2 lg:col-span-1" data-am-select-menu="guests">
        <label id={guestsLabelId} for={guestsControlId} class:list={controlLabelClasses}>
          {t(staySearchCopy.guests)}
        </label>
        <AmaraFormControl
          as="select"
          id={guestsControlId}
          name="guests"
          class="am-select-menu__native"
          data={{ 'data-am-stay-search-guests': '', 'data-am-select-menu-native': '' }}
        >
          {guestOptions.map((count) => (
            <option
              value={count}
              selected={count === 2}
              data-am-guest-label={t(count === 1 ? staySearchCopy.guest : staySearchCopy.guestsPlural).replace('{count}', String(count))}
              data-am-guest-label-compact={t(staySearchCopy.guestsCompact).replace('{count}', String(count))}
            >
              {t(count === 1 ? staySearchCopy.guest : staySearchCopy.guestsPlural).replace('{count}', String(count))}
            </option>
          ))}
        </AmaraFormControl>
        <button
          class="am-form-control am-form-control--trigger am-text-form-value am-select-menu__trigger mt-2"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls={guestsListboxId}
          aria-labelledby={`${guestsLabelId} ${guestsValueId}`}
          hidden
          data-am-select-menu-trigger
        >
          <span class="min-w-0 flex-1 truncate" id={guestsValueId} data-am-select-menu-value>{initialGuestLabel}</span>
          <ChevronDown class="am-select-menu__chevron h-4 w-4 shrink-0" stroke-width={1.6} aria-hidden="true" />
        </button>
        <div class="am-select-menu__popover" hidden data-am-select-menu-popover>
          <div id={guestsListboxId} role="listbox" aria-labelledby={guestsLabelId} data-am-select-menu-listbox></div>
        </div>
      </div>
    </div>

    <BookingDateRangeCalendar
      title={t(staySearchCopy.calendarTitle)}
      help={t(staySearchCopy.calendarHelp)}
      previousMonthLabel={t(staySearchCopy.previousMonth)}
      nextMonthLabel={t(staySearchCopy.nextMonth)}
      submitLabel={t(staySearchCopy.submit)}
    />

    <noscript>
      <AmaraActionButton variant="primary" class="mt-4 min-h-12 w-full justify-center sm:w-auto" type="submit">
        {t(staySearchCopy.submit)}
      </AmaraActionButton>
    </noscript>

    <p
      class="am-text-caption mt-4 font-normal text-error"
      role="alert"
      hidden
      data-am-stay-search-error
    >
      {t(staySearchCopy.invalidSearch)}
    </p>
  </form>
</section>

<style is:global>
  .am-stay-search {
    border-radius: var(--radius-editorial);
  }

  /* A drop shadow made the finder read as a card pasted onto the hero. A
     hairline keeps it part of the page while the negative margin still ties it
     to the image above. */
  .am-stay-search[data-am-stay-search-variant='home'] {
    border-radius: var(--radius-overlay);
    border: 1px solid var(--color-outline-variant);
  }

  .am-select-menu {
    position: relative;
  }

  [data-am-stay-search-enhanced='true'] .am-select-menu__native {
    display: none;
  }

  .am-select-menu__trigger {
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--color-surface-white);
  }

  .am-select-menu__chevron {
    transition: transform 180ms ease;
  }

  .am-select-menu__trigger[aria-expanded='true'] .am-select-menu__chevron {
    transform: rotate(180deg);
  }

  .am-select-menu__popover {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 80;
    min-width: 100%;
    padding: 0.375rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-overlay);
    background: var(--color-surface-white);
    box-shadow: 0 1rem 2.5rem rgb(31 28 23 / 14%);
  }

  [data-am-select-menu='guests'] .am-select-menu__popover {
    right: 0;
    left: auto;
    min-width: min(12rem, calc(100vw - 3rem));
  }

  .am-select-menu__option {
    display: flex;
    min-height: 2.75rem;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: calc(var(--radius-overlay) - 0.25rem);
    padding: 0.625rem 0.75rem;
    color: var(--color-on-surface);
    text-align: left;
  }

  .am-select-menu__option:hover,
  .am-select-menu__option:focus-visible {
    background: var(--color-surface-container-low);
    outline: none;
  }

  .am-select-menu__option[aria-selected='true'] {
    background: color-mix(in srgb, var(--color-primary) 9%, var(--color-surface-white));
    color: var(--color-primary);
  }

  .am-select-menu__option[aria-selected='true']::after {
    content: '✓';
    color: var(--color-primary);
    font-size: 0.875rem;
  }

  [data-am-stay-search-enhanced='true'] .am-stay-search__native-date {
    display: none;
  }

</style>

<script>
  import { enhanceStaySearchFinders } from '../../scripts/staySearchFinder';

  enhanceStaySearchFinders();
</script>
