---
import type { WhereToStayOrientationGraphicData } from '../../content/whereToStayOrientationGraphicContent';

interface Props {
  data: WhereToStayOrientationGraphicData;
}

const { data } = Astro.props;
const l = data.labels;
---

<aside
  class="area-graphic flex min-h-full flex-col overflow-hidden bg-inverse-surface text-inverted-on-surface"
  data-am-area-graphic={data.place}
  aria-label={data.ariaLabel}
>
  <div class="flex items-start justify-between gap-6 px-7 pb-2 pt-8 sm:px-9 sm:pt-10 lg:px-10">
    <div>
      <p class="am-text-graphic-eyebrow text-primary-fixed-dim">{data.eyebrow}</p>
      <p class="mt-3 font-headline text-3xl italic text-inverted-on-surface">{data.title}</p>
    </div>
    <p class="max-w-32 pt-1 text-right am-text-graphic-label leading-relaxed text-inverted-on-surface/45">{data.region}</p>
  </div>

  <div class="flex flex-1 items-center px-3 pb-2 sm:px-5 lg:px-6">
    {data.place === 'frigiliana' && (
      <svg viewBox="0 0 560 430" class="block h-auto w-full" role="img" aria-hidden="true">
        <g class="contours">
          <path d="M32 382 C128 362 225 391 318 350 C402 313 462 316 548 276" />
          <path d="M27 331 C124 310 217 338 312 296 C402 256 472 260 548 219" />
          <path d="M24 278 C128 256 215 282 306 240 C399 197 474 202 543 161" />
          <path d="M42 222 C142 199 222 222 311 179 C394 139 466 140 526 103" />
          <path d="M75 163 C159 141 229 158 316 119 C385 88 444 83 495 57" />
        </g>

        <path class="later-village-shape" d="M190 328 C278 318 363 333 443 302 C489 284 525 280 558 287 L558 430 L204 430 C211 389 208 358 190 328 Z" />
        <path class="old-town-shape" d="M145 94 C232 67 345 60 438 87 C480 130 500 193 501 252 C458 295 391 326 306 330 C240 315 188 285 154 238 C139 192 137 139 145 94 Z" />
        <path class="barribarto-shape" d="M252 98 C320 72 392 71 438 91 C472 125 486 168 480 211 C427 228 372 230 319 213 C291 177 270 139 252 98 Z" />
        <path class="barribajo-shape" d="M202 184 C268 196 333 212 393 239 C411 270 394 297 357 316 C294 317 241 295 203 260 C191 231 191 207 202 184 Z" />

        <g class="village-labels">
          <text class="map-label map-label--muted" x="207" y="113">{l.oldTown}</text>
          <text class="map-label" x="332" y="136">{l.barribarto}</text>
          <text class="map-label" x="274" y="276">{l.barribajo}</text>
          <text class="map-label map-label--muted" x="360" y="396">{l.laterVillage}</text>
        </g>

        <path class="main-road-casing" d="M126 12 C116 72 139 119 128 174 C116 233 131 285 194 319 C259 354 344 355 434 326 C482 310 522 304 558 309" />
        <path class="main-road" d="M126 12 C116 72 139 119 128 174 C116 233 131 285 194 319 C259 354 344 355 434 326 C482 310 522 304 558 309" />
        <text class="road-label road-label--main" x="112" y="247" transform="rotate(77 112 247)">{l.ma5105}</text>
        <text class="road-note" x="63" y="250" transform="rotate(77 63 250)">{l.mainRoad}</text>

        <path class="historic-route" d="M433 301 C407 280 397 255 365 241 C322 222 280 211 245 190 C226 178 209 169 197 164" />
        <path class="historic-route historic-route--restricted" d="M197 164 C180 137 174 106 170 70" />
        <text class="route-label" x="310" y="214" transform="rotate(23 310 214)">{l.calleReal}</text>
        <text class="route-label" x="159" y="140" transform="rotate(-79 159 140)">{l.calleChorruelo}</text>
        <text class="road-note road-note--historic" x="318" y="327" text-anchor="middle">{l.historicAccess}</text>

        <g class="castle" transform="translate(426 97)">
          <path d="M-10 8 V-7 H-5 V-12 H0 V-7 H5 V-12 H10 V8 Z" />
          <text x="0" y="-20" text-anchor="middle">{l.castle}</text>
        </g>

        <g class="steps" transform="translate(394 168)" aria-hidden="true">
          <path d="M-21 18 H-11 V8 H-1 V-2 H9 V-12 H19" />
        </g>

        <g class="landmark" transform="translate(181 181)">
          <rect x="-5" y="-15" width="10" height="13" rx="1" />
          <path d="M-8 -15 L0 -23 L8 -15 M0 -23 V-31 M-4 -27 H4" />
          <text x="-14" y="11" text-anchor="end">{l.church}</text>
        </g>

        <g class="landmark landmark--amara" transform="translate(205 164)">
          <circle r="7" />
          <circle class="halo" r="18" />
          <text class="amara-name" x="17" y="-3">{l.amara}</text>
          <text class="amara-position" x="17" y="12">{l.amaraPosition}</text>
        </g>
        <path class="relationship" d="M189 172 L198 167" />

        <g class="location-anchor" transform="translate(257 341)">
          <circle r="3" />
          <text x="9" y="4">{l.ingenio}</text>
        </g>
        <text class="height-label" x="367" y="288">{l.villageHeight}</text>
      </svg>
    )}

    {data.place === 'nerja' && (
      <svg viewBox="0 0 560 430" class="block h-auto w-full" role="img" aria-hidden="true">
        <g class="contours">
          <path d="M46 119 C168 83 314 95 516 42" />
          <path d="M56 156 C189 121 332 132 531 78" />
          <path d="M72 194 C211 160 361 174 542 120" />
        </g>
        <path class="coast" d="M18 310 C86 283 137 300 196 273 C244 250 285 270 333 242 C382 214 424 234 473 262 C508 282 529 276 548 266" />
        <path class="sea-fill" d="M18 310 C86 283 137 300 196 273 C244 250 285 270 333 242 C382 214 424 234 473 262 C508 282 529 276 548 266 L548 430 L18 430 Z" />
        <text class="sea-label" x="331" y="380">{l.sea}</text>
        <g class="district district--soft"><path d="M35 244 L115 224 L138 280 L57 298 Z" /><text x="69" y="258">{l.puntaLara}</text></g>
        <g class="district district--amara"><path d="M130 218 L220 206 L233 267 L145 279 Z" /><text x="151" y="232">{l.torrecilla}</text></g>
        <g class="district"><path d="M222 178 L319 174 L333 239 L238 255 Z" /><text x="237" y="201">{l.oldTown}</text></g>
        <g class="district district--soft"><path d="M319 166 L391 170 L406 231 L337 239 Z" /><text x="337" y="193">{l.carabeo}</text></g>
        <g class="district"><path d="M406 192 L512 222 L493 279 L411 242 Z" /><text x="428" y="226">{l.burriana}</text></g>
        <g class="district district--upper"><path d="M315 84 L473 59 L493 139 L337 158 Z" /><text x="343" y="111">{l.hills}</text></g>
        <g class="landmark landmark--amara" transform="translate(181 246)">
          <circle r="6" /><circle class="halo" r="14" /><text x="13" y="4">{l.amara}</text>
        </g>
      </svg>
    )}

    {data.place === 'tarifa' && (
      <svg viewBox="0 0 560 430" class="block h-auto w-full" role="img" aria-hidden="true">
        <g class="contours">
          <path d="M112 102 C211 72 326 82 510 48" />
          <path d="M99 143 C214 108 343 121 530 84" />
          <path d="M91 185 C224 147 367 162 544 122" />
        </g>
        <path class="coast" d="M18 321 C118 285 205 293 286 273 C362 255 431 275 548 242" />
        <path class="sea-fill" d="M18 321 C118 285 205 293 286 273 C362 255 431 275 548 242 L548 430 L18 430 Z" />
        <text class="sea-label" x="331" y="380">{l.sea}</text>
        <g class="district district--soft"><path d="M34 238 L180 207 L203 281 L62 311 Z" /><text x="77" y="255">{l.losLances}</text></g>
        <g class="district district--amara"><path d="M199 191 L324 178 L340 262 L218 278 Z" /><text x="227" y="215">{l.laMarina}</text></g>
        <g class="district"><path d="M341 165 L453 164 L479 240 L354 257 Z" /><text x="372" y="195">{l.oldTown}</text></g>
        <g class="district district--upper"><path d="M276 72 L489 49 L518 130 L310 155 Z" /><text x="341" y="102">{l.campo}</text></g>
        <g class="landmark landmark--amara" transform="translate(271 242)">
          <circle r="6" /><circle class="halo" r="14" /><text x="13" y="4">{l.amara}</text>
        </g>
      </svg>
    )}
  </div>

  <p class="px-7 pb-7 text-right am-text-graphic-label am-text-graphic-label--sm text-inverted-on-surface/40 sm:px-9 lg:px-10">{data.note}</p>
</aside>

<style>
  .area-graphic { container-type: inline-size; }
  .contours path { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 13%, transparent); stroke-width: 1; }
  .zones path, .district path { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 9%, transparent); stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 34%, transparent); stroke-width: 1; }
  .old-town-shape { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 7%, transparent); stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 42%, transparent); stroke-width: 1; }
  .later-village-shape { fill: color-mix(in srgb, var(--color-inverted-on-surface) 3%, transparent); stroke: color-mix(in srgb, var(--color-inverted-on-surface) 12%, transparent); stroke-width: 1; stroke-dasharray: 4 5; }
  .barribarto-shape { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 8%, transparent); stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 24%, transparent); stroke-width: 1; }
  .barribajo-shape { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 4%, transparent); stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 18%, transparent); stroke-width: 1; }
  .district--soft path { fill: color-mix(in srgb, var(--color-inverted-on-surface) 4%, transparent); }
  .district--upper path { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 5%, transparent); stroke-dasharray: 4 4; }
  .district--amara path { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 15%, transparent); }
  .route { fill: none; stroke-linecap: round; }
  .route--primary { stroke: var(--color-primary-fixed-dim); stroke-width: 3; }
  .route--secondary { stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 72%, transparent); stroke-width: 2; stroke-dasharray: 5 4; }
  .main-road-casing { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 18%, transparent); stroke-width: 12; stroke-linecap: round; }
  .main-road { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 48%, transparent); stroke-width: 4; stroke-linecap: round; }
  .historic-route { fill: none; stroke: var(--color-primary-fixed-dim); stroke-width: 3; stroke-linecap: round; }
  .historic-route--restricted { stroke-width: 2.5; stroke-dasharray: 5 4; }
  .route-label, .road-label, .road-note, .map-label, .zone-label, .district text, .sea-label, .height-label, .location-anchor text { font-family: var(--font-label); text-transform: uppercase; }
  .route-label { fill: var(--color-primary-fixed-dim); font-size: 8px; font-weight: 700; letter-spacing: 0.12em; }
  .road-label--main { fill: color-mix(in srgb, var(--color-inverted-on-surface) 78%, transparent); font-size: 8.5px; font-weight: 750; letter-spacing: 0.1em; }
  .road-note { fill: color-mix(in srgb, var(--color-inverted-on-surface) 38%, transparent); font-size: 6.5px; font-weight: 650; letter-spacing: 0.08em; }
  .road-note--historic { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 62%, transparent); }
  .map-label { fill: color-mix(in srgb, var(--color-inverted-on-surface) 72%, transparent); font-size: 7.5px; font-weight: 700; letter-spacing: 0.07em; }
  .map-label--muted { fill: color-mix(in srgb, var(--color-inverted-on-surface) 34%, transparent); letter-spacing: 0.13em; }
  .zone-label, .district text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 75%, transparent); font-size: 8.5px; font-weight: 650; letter-spacing: 0.08em; }
  .coast { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 70%, transparent); stroke-width: 2; }
  .sea-fill { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 6%, transparent); }
  .sea-label { fill: color-mix(in srgb, var(--color-inverted-on-surface) 24%, transparent); font-size: 10px; font-weight: 700; letter-spacing: 0.25em; }
  .landmark { color: var(--color-primary-fixed-dim); fill: none; stroke: currentColor; stroke-width: 1.5; }
  .landmark text { fill: var(--color-inverted-on-surface); stroke: none; font-family: var(--font-label); font-size: 8.5px; font-weight: 700; letter-spacing: 0.08em; }
  .landmark--amara > circle:first-child { fill: var(--color-primary-fixed-dim); stroke: none; }
  .landmark--amara .halo { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 34%, transparent); }
  .landmark--amara .amara-name { fill: var(--color-primary-fixed-dim); font-size: 11px; font-weight: 800; letter-spacing: 0.13em; }
  .landmark--amara .amara-position { fill: color-mix(in srgb, var(--color-inverted-on-surface) 82%, transparent); font-size: 7.5px; font-weight: 650; letter-spacing: 0.04em; }
  .relationship { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 60%, transparent); stroke-width: 1; stroke-dasharray: 2 2; }
  .castle, .steps { color: color-mix(in srgb, var(--color-inverted-on-surface) 48%, transparent); fill: none; stroke: currentColor; stroke-width: 1.2; }
  .castle text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 58%, transparent); stroke: none; font-family: var(--font-label); font-size: 7px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .location-anchor circle { fill: var(--color-primary-fixed-dim); }
  .location-anchor text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 62%, transparent); font-size: 7px; font-weight: 700; letter-spacing: 0.06em; }
  .height-label { fill: color-mix(in srgb, var(--color-inverted-on-surface) 30%, transparent); font-size: 6.5px; font-weight: 650; letter-spacing: 0.08em; }
</style>
