---
// Average daily hours of sunshine across the year, with the winter months
// highlighted — the argument for a low-season stay, shown rather than claimed.
// Data comes from the same climate profile as the weather page.
import { formatDecimal } from '../../lib/formatNumber';
import type { AmaraLanguage } from '../../types/seo';

interface SunMonth {
  month: string;
  sunHours: number;
}

interface Props {
  lang: AmaraLanguage;
  eyebrow: string;
  title: string;
  intro: string;
  unitLabel: string;
  months: SunMonth[];
  /** Indices (0 = Jan) drawn in the emphasis colour. Defaults to Dec/Jan/Feb. */
  winterIndices?: number[];
  /** A one-line winter contrast against the reader's home city. */
  comparisonNote?: string;
}

const { lang, eyebrow, title, intro, unitLabel, months, winterIndices = [11, 0, 1], comparisonNote } = Astro.props;
const maxSun = Math.max(...months.map((month) => month.sunHours));
---

<section class="bg-surface-container-low" data-am-sun-hours>
  <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
    <header class="grid gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{eyebrow}</p>
        <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{title}</h2>
      </div>
      <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant lg:col-span-7 lg:col-start-6">
        {intro}
      </p>
    </header>

    <div class="mt-12 overflow-x-auto pb-2">
      <div class="grid min-w-[720px] grid-cols-12 gap-1.5" aria-hidden="true">
        {months.map((month, index) => (
          <div class="flex flex-col items-center">
            <div class="flex h-40 w-full items-end justify-center">
              <div
                class:list={[
                  'w-full max-w-[1.4rem] rounded-t-sm',
                  winterIndices.includes(index) ? 'bg-primary' : 'bg-primary/30'
                ]}
                style={`height: ${Math.max(3, (month.sunHours / maxSun) * 100)}%`}
              ></div>
            </div>
            <p class="mt-3 tabular-nums am-text-subtitle leading-none text-on-surface">{formatDecimal(month.sunHours, lang)}</p>
            <p class="mt-2 text-muted am-text-label am-text-label--sm am-text-label--wide">{month.month}</p>
          </div>
        ))}
      </div>
    </div>

    {comparisonNote && (
      <p class="mt-10 max-w-2xl border-l-2 border-primary pl-5 am-text-subtitle leading-snug text-balance text-on-surface">
        {comparisonNote}
      </p>
    )}

    <p class="mt-6 am-text-label am-text-label--sm text-muted">{unitLabel}</p>
  </div>
</section>
