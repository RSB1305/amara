---
interface Props {
  eyebrow: string;
  mark: string;
  note?: string;
}

const { eyebrow, mark, note } = Astro.props;
---

<aside
  class="flex aspect-[3/4] min-h-full flex-col justify-between overflow-hidden bg-inverse-surface px-8 py-9 text-inverted-on-surface md:px-10 md:py-12"
  data-am-guide-evidence
>
  <div>
    <p class="am-text-caption font-bold uppercase tracking-[0.2em] text-primary-fixed-dim">
      {eyebrow}
    </p>
    <p class="am-text-display mt-8 text-balance italic text-inverted-on-surface" aria-hidden="true">
      {mark}
    </p>
  </div>

  <div class="border-t border-inverted-on-surface/20 pt-7">
    <div class="mb-6 h-px w-12 bg-primary-fixed-dim"></div>
    {
      note && (
        <p class="am-text-body max-w-sm leading-relaxed text-inverted-on-surface/75">
          {note}
        </p>
      )
    }
  </div>
</aside>
