---
import type { ImageMetadata } from 'astro';
import EditorialByline from '../editorial/EditorialByline.astro';
import LocationGuideHero from './LocationGuideHero.astro';
import type { AmaraHeroByline } from '../hero/heroContract';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  paragraphs: string[];
  accent?: string;
  imageSrc: ImageMetadata | string;
  imageAlt: string;
  imageWidth?: number;
  imageSizes?: string;
  byline?: AmaraHeroByline;
}

const {
  eyebrow,
  title,
  subtitle,
  paragraphs,
  accent,
  imageSrc,
  imageAlt,
  imageWidth,
  imageSizes,
  byline
} = Astro.props;
---

<LocationGuideHero
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  paragraphs={paragraphs}
  accent={accent}
  imageSrc={imageSrc}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageSizes={imageSizes}
  role="hub"
  topic="overview"
>
  {byline && <EditorialByline slot="meta" {...byline} />}
</LocationGuideHero>
