---
interface ClimateMonth {
  month: string;
  high: number;
  low: number;
  rain: number;
  sunHours: number;
}

interface SourceLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  months: ClimateMonth[];
  labels: {
    month: string;
    high: string;
    low: string;
    rain: string;
    sunHours: string;
    details: string;
  };
  chartLabels: {
    temperature: string;
    rainfall: string;
  };
  sourceTitle: string;
  sourceText: string;
  sources: SourceLink[];
}

const {
  eyebrow,
  title,
  intro,
  months,
  labels,
  chartLabels,
  sourceTitle,
  sourceText,
  sources
} = Astro.props;

const maxRain = Math.max(...months.map((month) => month.rain));
const displayTemperature = (value: number) => Math.round(value);
---

<section class="bg-surface-container-low" data-am-climate-table>
  <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
    <header class="grid gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{eyebrow}</p>
        <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{title}</h2>
      </div>
      <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant lg:col-span-7 lg:col-start-6">
        {intro}
      </p>
    </header>

    <div class="mt-14 overflow-x-auto pb-3">
      <div class="min-w-[900px] border-y border-outline-variant/20" aria-hidden="true">
        <div class="grid grid-cols-12">
          {months.map((month) => (
            <div class="border-r border-outline-variant/15 px-3 py-5 last:border-r-0">
              <p class="text-muted am-text-label am-text-label--sm am-text-label--wide">
                {month.month}
              </p>
              <p class="mt-4 am-text-subtitle leading-none text-on-surface">
                {displayTemperature(month.high)}°
              </p>
              <p class="am-text-data-note mt-2 tabular-nums text-muted">
                {displayTemperature(month.low)}°
              </p>
              <div class="mt-5 flex h-20 items-end border-b border-outline-variant/20">
                <div
                  class="w-full bg-primary/55"
                  style={`height: ${Math.max(3, (month.rain / maxRain) * 100)}%`}
                ></div>
              </div>
              <p class="am-text-data-note am-text-data-note--sm mt-2 tabular-nums text-muted">
                {month.rain} mm
              </p>
            </div>
          ))}
        </div>
        <div class="flex items-center gap-8 border-t border-outline-variant/15 px-3 py-3 am-text-label am-text-label--sm text-muted">
          <span>{chartLabels.temperature}</span>
          <span class="flex items-center gap-2"><span class="h-2 w-2 bg-primary/55"></span>{chartLabels.rainfall}</span>
        </div>
      </div>
    </div>

    <details class="group mt-10 border-y border-outline-variant/20">
      <summary class="am-accordion__trigger min-h-14 items-center py-5">
        <span class="am-text-subtitle text-on-surface transition-colors group-hover:text-primary">
          {labels.details}
        </span>
        <span class="am-accordion__indicator" aria-hidden="true">
          <span class="group-open:hidden">+</span>
          <span class="hidden group-open:inline">−</span>
        </span>
      </summary>
      <div class="overflow-x-auto border-t border-outline-variant/20">
        <table class="w-full min-w-[760px] border-collapse text-left">
          <thead>
            <tr class="border-b border-outline-variant/25 text-muted am-text-label am-text-label--sm">
              <th scope="col" class="py-4 pr-5">{labels.month}</th>
              <th scope="col" class="px-5 py-4 text-right">{labels.high}</th>
              <th scope="col" class="px-5 py-4 text-right">{labels.low}</th>
              <th scope="col" class="px-5 py-4 text-right">{labels.rain}</th>
              <th scope="col" class="py-4 pl-5 text-right">{labels.sunHours}</th>
            </tr>
          </thead>
          <tbody>
            {months.map((month) => (
              <tr class="border-b border-outline-variant/15 am-text-body text-on-surface-variant">
                <th scope="row" class="py-4 pr-5 font-normal text-on-surface">{month.month}</th>
                <td class="px-5 py-4 text-right tabular-nums">{displayTemperature(month.high)} °C</td>
                <td class="px-5 py-4 text-right tabular-nums">{displayTemperature(month.low)} °C</td>
                <td class="px-5 py-4 text-right tabular-nums">{month.rain} mm</td>
                <td class="py-4 pl-5 text-right tabular-nums">{month.sunHours} h</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <footer class="mt-10 grid gap-4 border-l border-primary/35 pl-6 lg:grid-cols-[auto_1fr] lg:gap-8">
      <p class="text-primary am-text-label am-text-label--sm am-text-label--wide">{sourceTitle}</p>
      <div>
        <p class="am-text-body max-w-4xl leading-relaxed text-on-surface-variant">{sourceText}</p>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {sources.map((source) => (
            <a class="am-text-caption text-on-surface underline decoration-primary/40 underline-offset-4 hover:decoration-primary" href={source.href} rel="noreferrer" target="_blank">
              {source.label}
            </a>
          ))}
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
