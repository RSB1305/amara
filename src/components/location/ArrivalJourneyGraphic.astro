---
export interface ArrivalJourneyGraphicData {
  place: 'frigiliana' | 'nerja' | 'tarifa';
  eyebrow: string;
  destination: string;
  region: string;
  airportLabel: string;
  distanceLabel: string;
  timeLabel: string;
  primaryAirport: {
    code: string;
    name: string;
    distance: string;
    time: string;
  };
  otherAirports?: Array<{
    code: string;
    distance: string;
    time: string;
  }>;
  context: Array<{
    label: string;
    value: string;
  }>;
  mapLabels?: {
    morocco: string;
    tangier: string;
    strait: string;
    ferry: string;
  };
  ariaLabel: string;
}

interface Props {
  data: ArrivalJourneyGraphicData;
}

const { data } = Astro.props;

const diagrams = {
  frigiliana: {
    coast: 'M18 283 C90 270 142 286 205 264 C266 244 318 257 376 229 C424 206 463 209 502 194',
    terrain: [
      'M260 120 C310 88 373 92 424 60 C458 39 486 41 516 27',
      'M278 151 C333 121 386 127 439 94 C469 75 493 77 520 61',
      'M302 184 C350 160 406 163 458 132 C482 118 501 119 520 108'
    ],
    routes: [
      'M82 256 C155 242 219 247 286 210 C329 186 351 160 402 125'
    ],
    nodes: [
      { x: 82, y: 256, code: 'AGP', kind: 'airport' },
      { x: 326, y: 205, code: 'NERJA', kind: 'context' },
      { x: 402, y: 125, code: 'AMARA', kind: 'destination' }
    ],
    sea: 'MEDITERRÁNEO'
  },
  nerja: {
    coast: 'M18 283 C90 270 142 286 205 264 C266 244 318 257 376 229 C424 206 463 209 502 194',
    terrain: [
      'M260 120 C310 88 373 92 424 60 C458 39 486 41 516 27',
      'M278 151 C333 121 386 127 439 94 C469 75 493 77 520 61',
      'M302 184 C350 160 406 163 458 132 C482 118 501 119 520 108'
    ],
    routes: [
      'M82 256 C157 242 228 251 296 224 C334 209 367 205 405 207'
    ],
    nodes: [
      { x: 82, y: 256, code: 'AGP', kind: 'airport' },
      { x: 376, y: 139, code: 'FRIGILIANA', kind: 'context' },
      { x: 405, y: 207, code: 'AMARA', kind: 'destination' }
    ],
    sea: 'MEDITERRÁNEO'
  },
  tarifa: {
    coast: 'M287 20 C303 69 329 104 355 137 C382 172 389 207 374 239 C354 277 313 300 273 324 C240 344 209 365 192 402',
    terrain: [
      'M329 40 C368 62 407 68 441 93 C472 116 491 146 514 165',
      'M306 77 C345 98 380 106 414 130 C449 155 469 183 496 205',
      'M281 111 C320 132 352 143 384 165 C420 190 440 216 469 242'
    ],
    routes: [
      'M426 74 C406 137 383 198 352 242 C328 276 307 297 278 316',
      'M382 216 C348 247 321 280 278 316',
      'M119 86 C146 151 176 211 211 263 C235 290 252 304 278 316'
    ],
    oppositeCoast: 'M34 400 C118 373 190 386 257 369 C331 349 417 366 506 337',
    ferryRoute: 'M257 369 C260 352 267 334 278 316',
    nodes: [
      { x: 426, y: 74, code: 'AGP', kind: 'airport' },
      { x: 119, y: 86, code: 'XRY', kind: 'airport-secondary' },
      { x: 382, y: 216, code: 'GIB', kind: 'airport-secondary' },
      { x: 278, y: 316, code: 'AMARA', kind: 'destination' }
    ],
    sea: 'ATLÁNTICO · MEDITERRÁNEO'
  }
} as const;

const diagram = diagrams[data.place];
---

<aside
  class="arrival-graphic flex min-h-full flex-col overflow-hidden bg-inverse-surface text-inverted-on-surface"
  data-am-arrival-graphic={data.place}
  aria-label={data.ariaLabel}
>
  <div class="flex items-start justify-between gap-6 px-7 pb-1 pt-8 sm:px-9 sm:pt-10 md:px-8 lg:px-10">
    <div>
      <p class="am-text-graphic-eyebrow text-primary-fixed-dim">
        {data.eyebrow}
      </p>
      <p class="arrival-graphic__destination mt-3 italic text-inverted-on-surface">{data.destination}</p>
    </div>
    <p class="max-w-32 pt-1 text-right am-text-graphic-label leading-relaxed text-inverted-on-surface/45">
      {data.region}
    </p>
  </div>

  <div class="px-3 sm:px-5 md:px-3 lg:px-5">
    <svg
      viewBox="0 0 520 420"
      class:list={[
        'block h-auto w-full',
        data.place === 'tarifa'
          ? 'md:h-[320px] lg:h-auto xl:h-[320px]'
          : 'md:h-[336px] lg:h-auto xl:h-[336px]'
      ]}
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <filter id={`route-glow-${data.place}`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <g class="terrain-lines">
        {diagram.terrain.map((path) => <path d={path} />)}
      </g>
      <path class="coast-line" d={diagram.coast} />

      {data.place === 'tarifa' && data.mapLabels && (
        <>
          <path class="opposite-coast-line" d={diagrams.tarifa.oppositeCoast} />
          <path class="route-ferry" d={diagrams.tarifa.ferryRoute} />
          <g class="ferry-symbol" transform="translate(264 343)">
            <path d="M-12 3 L-8 10 C-3 13 3 13 8 10 L12 3 Z" />
            <path d="M-7 3 V-4 H7 V3 M-3 -4 V-9 H3 V-4" />
          </g>
          <g class="map-node map-node--context" transform="translate(257 369)">
            <circle class="node-halo" r="11" />
            <circle class="node-dot" r="3.5" />
            <text class="node-label" x="-13" y="-9" text-anchor="end">{data.mapLabels.tangier}</text>
          </g>
          <text class="ferry-label" x="230" y="344" text-anchor="end">{data.mapLabels.ferry}</text>
          <text class="strait-label" x="303" y="348">{data.mapLabels.strait}</text>
          <text class="map-region-label" x="340" y="392">{data.mapLabels.morocco}</text>
        </>
      )}

      <g class="route-lines">
        {diagram.routes.map((path, index) => (
          <path
            d={path}
            class:list={[index === 0 ? 'route-primary' : 'route-secondary']}
            filter={index === 0 ? `url(#route-glow-${data.place})` : undefined}
          />
        ))}
      </g>

      <text class="sea-label" x={data.place === 'tarifa' ? 32 : 320} y={data.place === 'tarifa' ? 368 : 306}>
        {diagram.sea}
      </text>

      {diagram.nodes.map((node) => (
        <g class:list={['map-node', `map-node--${node.kind}`]} transform={`translate(${node.x} ${node.y})`}>
          <circle
            class="node-halo"
            r={node.kind === 'destination' ? 16 : node.kind === 'context' ? 11 : 19}
          />
          {(node.kind === 'airport' || node.kind === 'airport-secondary') ? (
            <path
              class="airport-symbol"
              transform="translate(-12 -12)"
              d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 20 3s-3-1-4.5.5L12 7 3.8 5.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L8 12l-2 3H3l-1 1 4 2 2 4 1-1v-3l3-2 4.5 5.3c.4.4.9.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2Z"
            />
          ) : (
            <circle class="node-dot" r={node.kind === 'destination' ? 5 : 3.5} />
          )}
          <text
            class="node-label"
            x={node.kind === 'airport' || node.kind === 'airport-secondary'
              ? node.x > 370 ? -28 : 28
              : node.x > 370 ? -13 : 13}
            y={node.kind === 'context' ? -12 : 4}
            text-anchor={node.x > 370 ? 'end' : 'start'}
          >
            {node.kind === 'airport' ? (
              <>
                <tspan class="airport-code">{data.primaryAirport.code}</tspan>
                <tspan class="airport-city"> · {data.primaryAirport.name}</tspan>
              </>
            ) : node.code}
          </text>
        </g>
      ))}

      <g class="compass" transform="translate(47 53)">
        <path d="M0 14 L6 0 L12 14" />
        <line x1="6" y1="1" x2="6" y2="25" />
        <text x="6" y="-8" text-anchor="middle">N</text>
      </g>
    </svg>
  </div>

  <div class="mt-auto px-7 pb-8 sm:px-9 sm:pb-9 md:px-8 lg:px-10">
    <div class="grid grid-cols-3 border-y border-inverted-on-surface/15 py-5">
      <div class="pr-3">
        <p class="graphic-label">{data.airportLabel}</p>
        <p class="graphic-value">
          {data.primaryAirport.code}<span class="airport-name"> · {data.primaryAirport.name}</span>
        </p>
      </div>
      <div class="border-l border-inverted-on-surface/15 px-3">
        <p class="graphic-label">{data.distanceLabel}</p>
        <p class="graphic-value">{data.primaryAirport.distance}</p>
      </div>
      <div class="border-l border-inverted-on-surface/15 pl-3">
        <p class="graphic-label">{data.timeLabel}</p>
        <p class="graphic-value">{data.primaryAirport.time}</p>
      </div>
    </div>

    {data.otherAirports && data.otherAirports.length > 0 && (
      <div class="flex flex-wrap gap-x-5 gap-y-2 border-b border-inverted-on-surface/15 py-3">
        {data.otherAirports.map((airport) => (
          <p class="am-text-graphic-label text-inverted-on-surface/55">
            <span class="text-primary-fixed-dim">{airport.code}</span>
            {' · '}{airport.distance}{' · '}{airport.time}
          </p>
        ))}
      </div>
    )}

    <div class="grid grid-cols-2 gap-x-5 pt-5">
      {data.context.slice(0, 2).map((item) => (
        <div>
          <p class="graphic-label">{item.label}</p>
          <p class="mt-2 text-[13px] leading-snug text-inverted-on-surface/78">{item.value}</p>
        </div>
      ))}
    </div>
  </div>
</aside>

<style>
  .arrival-graphic {
    aspect-ratio: 3 / 5;
    background-image:
      radial-gradient(circle at 78% 26%, color-mix(in srgb, var(--color-primary-fixed-dim) 8%, transparent), transparent 31%),
      linear-gradient(145deg, color-mix(in srgb, var(--color-inverse-surface) 93%, black), var(--color-inverse-surface));
  }

  .arrival-graphic__destination {
    font-family: var(--font-headline);
    font-size: clamp(1.75rem, 4vw, 2.65rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .terrain-lines path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.09;
  }

  .coast-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.32;
  }

  .opposite-coast-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    opacity: 0.28;
  }

  .route-lines path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route-primary {
    stroke: var(--color-primary-fixed-dim);
    stroke-width: 2.1;
    stroke-dasharray: 3 7;
  }

  .route-secondary {
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 2 8;
    opacity: 0.27;
  }

  .route-ferry {
    fill: none;
    stroke: var(--color-primary-fixed-dim);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 4 5;
  }

  .ferry-symbol path {
    fill: none;
    stroke: var(--color-inverse-on-surface);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.88;
  }

  .node-halo {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.26;
  }

  .node-dot {
    fill: currentColor;
    opacity: 0.7;
  }

  .map-node--destination .node-halo {
    stroke: var(--color-primary-fixed-dim);
    opacity: 0.72;
  }

  .map-node--destination .node-dot,
  .map-node--airport .airport-symbol {
    fill: var(--color-inverse-on-surface);
    opacity: 1;
  }

  .map-node--airport .node-halo {
    stroke: var(--color-inverse-on-surface);
    opacity: 0.82;
  }

  .map-node--airport-secondary .node-halo {
    opacity: 0.58;
  }

  .airport-symbol {
    fill: var(--color-inverse-on-surface);
    opacity: 0.82;
  }

  .node-label,
  .sea-label,
  .compass text {
    fill: currentColor;
    font-family: var(--font-label);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .node-label {
    opacity: 0.72;
  }

  .map-node--destination .node-label {
    fill: var(--color-primary-fixed-dim);
    opacity: 1;
  }

  .map-node--context .node-label,
  .map-node--airport-secondary .node-label {
    opacity: 0.72;
  }

  .map-node--context .node-label {
    font-size: 7px;
    opacity: 0.38;
  }

  .map-node--airport .node-label {
    fill: var(--color-inverse-on-surface);
    font-size: 16px;
  }

  .airport-city {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .map-node--airport-secondary .node-label {
    fill: var(--color-inverse-on-surface);
    font-size: 14px;
  }

  .sea-label {
    font-size: 7px;
    font-weight: 600;
    opacity: 0.2;
  }

  .ferry-label,
  .strait-label,
  .map-region-label {
    fill: currentColor;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
  }

  .ferry-label {
    font-size: 7px;
    letter-spacing: 0.12em;
    opacity: 0.64;
  }

  .strait-label {
    font-size: 6.5px;
    letter-spacing: 0.1em;
    opacity: 0.44;
  }

  .map-region-label {
    font-size: 9px;
    letter-spacing: 0.16em;
    opacity: 0.72;
  }

  .compass path,
  .compass line {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.32;
  }

  .compass text {
    font-size: 7px;
    opacity: 0.42;
  }

  .graphic-label {
    font-family: var(--font-label);
    font-size: 8px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 44%, transparent);
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .graphic-value {
    margin-top: 0.45rem;
    font-family: var(--font-label);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--color-inverted-on-surface);
  }

  .airport-name {
    font-size: 0.68rem;
    font-weight: 550;
    color: color-mix(in srgb, currentColor 62%, transparent);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .arrival-graphic {
      margin-inline: auto;
      width: min(100%, 540px);
      min-height: 0;
      aspect-ratio: 3 / 4;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .arrival-graphic {
      aspect-ratio: 3 / 5;
      min-height: 0;
    }
  }

  @media (min-width: 1280px) {
    .arrival-graphic {
      aspect-ratio: 3 / 4;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .route-primary {
      animation: route-drift 16s linear infinite;
    }
  }

  @keyframes route-drift {
    to { stroke-dashoffset: -40; }
  }
</style>
