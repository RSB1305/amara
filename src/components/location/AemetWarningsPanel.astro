---
/**
 * AemetWarningsPanel
 *
 * The official warning block: AEMET Meteoalerta warnings for one configured
 * zone, fetched from the server-side gateway and shown in AEMET's own wording.
 * The panel frames each warning with level, phenomenon, zone, validity and
 * source; it never summarises, softens or weighs a warning against a model.
 * Empty and error states are stated as such.
 *
 * The block is a disclosure, folded by default (operator decision of
 * 11 September 2026): the status line stays visible — count, highest level,
 * first headline — and carries AEMET's own level colour (yellow, orange, red)
 * on the chip and the left rule, so the official status reads at a glance
 * without the full wording taking the top of the page. The colours are the
 * semantic warning palette of this block only, not the brand accent.
 *
 * AEMET issues a warning per day and cuts at midnight, so the same wording
 * arrives several times with different validity windows. Warnings with the
 * same level, phenomenon, parameter and wording are shown as one card with
 * one validity line per window (operator decision of 11 September 2026);
 * the wording itself is never merged or shortened.
 */
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import LocationGuideIcon from './LocationGuideIcon.astro';
import type { Resolved } from '../../types/content';
import type { TarifaWeatherWarningsCopy } from '../../content/tarifaWeatherWarningsContent';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  endpoint: string;
  lang: AmaraLanguage;
  timezone: string;
  copy: Resolved<TarifaWeatherWarningsCopy>;
  officialHref: string;
}

const { endpoint, lang, timezone, copy, officialHref } = Astro.props;
const widgetId = 'am-aemet-warnings';
---

<details id={widgetId} class="group bg-surface" aria-busy="true" data-am-official-warnings data-warnings-level="loading">
  <summary class="am-accordion__trigger items-center gap-4 px-6 py-5 md:px-8">
    <span class="flex min-w-0 flex-1 flex-wrap items-center gap-x-4 gap-y-2">
      <span class="am-text-label am-text-label--sm inline-flex shrink-0 items-center gap-2 px-2.5 py-1" data-warnings-chip>
        <span class="h-2 w-2 rounded-full bg-current" aria-hidden="true"></span>
        <span data-warnings-chip-text>{copy.summary.chipUnknown}</span>
      </span>
      <span class="min-w-64 flex-1">
        <span class="am-text-body block text-on-surface" data-warnings-summary>{copy.summary.loading}</span>
        <span class="am-text-caption mt-1 hidden normal-case tracking-normal text-muted" data-warnings-summary-detail></span>
      </span>
    </span>
    <span class="am-accordion__indicator" aria-hidden="true">
      <span class="group-open:hidden">+</span>
      <span class="hidden group-open:inline">−</span>
    </span>
  </summary>

  <div class="px-6 pb-7 md:px-8" aria-labelledby={`${widgetId}-title`} aria-live="polite">
    <h3 id={`${widgetId}-title`} class="sr-only">{copy.title}</h3>

    <div data-warnings-loading class="flex items-center gap-3">
      <LocationGuideIcon name="temperature" class="h-5 w-5" />
      <p class="am-text-body text-on-surface-variant">{copy.loading}</p>
    </div>

    <div data-warnings-list class="hidden space-y-5"></div>

    <div data-warnings-empty class="hidden">
      <p class="am-text-body text-on-surface" data-warnings-empty-title></p>
      <p class="am-text-body mt-2 max-w-2xl leading-relaxed text-on-surface-variant" data-warnings-empty-text></p>
    </div>

    <div data-warnings-fallback class="hidden">
      <p class="am-text-body text-on-surface">{copy.unavailableTitle}</p>
      <p class="am-text-body mt-2 max-w-2xl leading-relaxed text-on-surface-variant">{copy.unavailableText}</p>
    </div>

    <p class="am-text-caption mt-5 hidden normal-case tracking-normal text-muted" data-warnings-meta></p>
    <AmaraActionLink href={officialHref} variant="editorial" external class="mt-5 inline-flex">{copy.linkLabel}</AmaraActionLink>

    <template data-warning-template>
      <article class="border-l-4 bg-surface-container-low px-5 py-5" data-warning-level="">
        <p class="am-text-label am-text-label--sm text-on-surface"><span data-field="levelLabel"></span>: <span data-field="level"></span></p>
        <p class="am-text-subtitle mt-2 text-on-surface" data-field="headline"></p>
        <p class="am-text-caption mt-2 normal-case tracking-normal text-muted" data-field="meta"></p>
        <ul class="am-text-caption mt-1 list-none space-y-0.5 p-0 normal-case tracking-normal text-muted" data-field="validity"></ul>
        <p class="am-text-body mt-3 max-w-3xl leading-relaxed text-on-surface" data-field="description"></p>
        <p class="am-text-body mt-2 max-w-3xl leading-relaxed text-on-surface-variant" data-field="instruction"></p>
        <div class="mt-3 hidden" data-field="englishBlock">
          <p class="am-text-label am-text-label--sm text-muted" data-field="englishLabel"></p>
          <p class="am-text-body mt-1 max-w-3xl leading-relaxed text-on-surface-variant" data-field="english"></p>
        </div>
        <p class="am-text-caption mt-3 normal-case tracking-normal text-muted" data-field="verbatim"></p>
      </article>
    </template>

    <noscript>
      <p class="am-text-body mt-5 text-on-surface-variant">{copy.unavailableText}</p>
    </noscript>
  </div>
</details>

<style>
  /*
   * Semantic warning colours of the official block, keyed on the highest
   * active level. They follow AEMET's yellow / orange / red and stay inside
   * this component; the brand accent is deliberately not used for a warning.
   */
  [data-am-official-warnings] {
    --am-warn-accent: var(--color-outline-variant);
    --am-warn-ink: var(--color-on-surface-variant);
    --am-warn-tint: var(--color-surface-container-low);
    border-left: 4px solid var(--am-warn-accent);
  }
  [data-am-official-warnings][data-warnings-level='none'] {
    --am-warn-accent: #4d7a5a;
    --am-warn-ink: #2f5a3c;
    --am-warn-tint: #e4efe6;
  }
  [data-am-official-warnings][data-warnings-level='amarillo'] {
    --am-warn-accent: #e6b800;
    --am-warn-ink: #5f4a00;
    --am-warn-tint: #fff6c7;
  }
  [data-am-official-warnings][data-warnings-level='naranja'] {
    --am-warn-accent: #e8781a;
    --am-warn-ink: #6b3300;
    --am-warn-tint: #ffe6cf;
  }
  [data-am-official-warnings][data-warnings-level='rojo'] {
    --am-warn-accent: #c8281e;
    --am-warn-ink: #6e0f0a;
    --am-warn-tint: #fbdad6;
  }
  [data-warnings-chip] {
    background: var(--am-warn-tint);
    color: var(--am-warn-ink);
  }
  [data-warning-level='amarillo'] { border-color: #e6b800; }
  [data-warning-level='naranja'] { border-color: #e8781a; }
  [data-warning-level='rojo'] { border-color: #c8281e; }
</style>

<script is:inline define:vars={{ endpoint, lang, timezone, copy, widgetId }}>
  (function () {
    const root = document.getElementById(widgetId);
    if (!root) return;
    const query = (selector) => root.querySelector(selector);
    const loading = query('[data-warnings-loading]');
    const list = query('[data-warnings-list]');
    const empty = query('[data-warnings-empty]');
    const fallback = query('[data-warnings-fallback]');
    const meta = query('[data-warnings-meta]');
    const template = query('[data-warning-template]');
    const chipText = query('[data-warnings-chip-text]');
    const summary = query('[data-warnings-summary]');
    const summaryDetail = query('[data-warnings-summary-detail]');

    const LEVEL_RANK = { amarillo: 1, naranja: 2, rojo: 3 };
    const stamp = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: timezone });
    const format = (value) => {
      const parsed = value ? Date.parse(value) : Number.NaN;
      return Number.isFinite(parsed) ? stamp.format(new Date(parsed)) : '—';
    };

    function setStatus(level, chip, text, detail) {
      root.dataset.warningsLevel = level;
      chipText.textContent = chip;
      summary.textContent = text;
      if (detail) {
        summaryDetail.textContent = detail;
        summaryDetail.classList.remove('hidden');
      }
    }

    function finish() {
      root.setAttribute('aria-busy', 'false');
      if (loading) loading.classList.add('hidden');
    }

    function showFallback() {
      finish();
      if (fallback) fallback.classList.remove('hidden');
      setStatus('unknown', copy.summary.chipUnknown, copy.summary.unavailable, '');
    }

    function groupWarnings(warnings) {
      const groups = new Map();
      warnings.forEach((warning) => {
        const primary = warning.spanish || warning.english || {};
        const key = [
          warning.level,
          warning.phenomenon && warning.phenomenon.code,
          warning.parameter && warning.parameter.value,
          primary.headline,
          primary.description,
          primary.instruction
        ].join('|');
        if (!groups.has(key)) groups.set(key, { warning, periods: [] });
        groups.get(key).periods.push({ onset: warning.onset, expires: warning.expires });
      });
      return Array.from(groups.values()).map((group) => {
        group.periods.sort((a, b) => (Date.parse(a.onset || '') || 0) - (Date.parse(b.onset || '') || 0));
        return group;
      });
    }

    function renderGroup(group, zoneName) {
      const warning = group.warning;
      const node = template.content.firstElementChild.cloneNode(true);
      const field = (name) => node.querySelector('[data-field="' + name + '"]');
      const level = warning.level || '';
      node.dataset.warningLevel = level;
      field('levelLabel').textContent = copy.levelLabel;
      field('level').textContent = copy.levels[level] || level || '—';
      const primary = warning.spanish || warning.english;
      field('headline').textContent = primary.headline || primary.event || '';
      const phenomenon = warning.phenomenon
        ? (copy.phenomena[warning.phenomenon.code] || warning.phenomenon.name || warning.phenomenon.code) +
          (warning.phenomenon.name && copy.phenomena[warning.phenomenon.code] ? ' (' + warning.phenomenon.name + ')' : '')
        : '—';
      const parameter = warning.parameter && (warning.parameter.name || warning.parameter.value)
        ? ' · ' + [warning.parameter.name, warning.parameter.value].filter(Boolean).join(': ')
        : '';
      field('meta').textContent =
        copy.phenomenonLabel + ': ' + phenomenon + parameter +
        ' · ' + copy.zoneLabel + ': ' + (warning.areaDesc || zoneName);
      const validity = field('validity');
      group.periods.forEach((period) => {
        const item = document.createElement('li');
        item.textContent = copy.validLabel + ': ' + format(period.onset) + ' ' + copy.until + ' ' + format(period.expires);
        validity.appendChild(item);
      });
      field('description').textContent = primary.description || '';
      const instruction = field('instruction');
      if (primary.instruction) instruction.textContent = primary.instruction;
      else instruction.remove();
      if (warning.spanish && warning.english) {
        field('englishLabel').textContent = copy.englishLabel;
        field('english').textContent = [warning.english.headline, warning.english.description].filter(Boolean).join(' — ');
        field('englishBlock').classList.remove('hidden');
      }
      field('verbatim').textContent = copy.verbatimNote;
      return node;
    }

    function summarize(groups) {
      let highest = '';
      groups.forEach((group) => {
        if ((LEVEL_RANK[group.warning.level] || 0) > (LEVEL_RANK[highest] || 0)) highest = group.warning.level;
      });
      const levelText = copy.summary.levelsShort[highest] || highest || '—';
      const text = (groups.length === 1 ? copy.summary.one : copy.summary.many)
        .replace('{count}', String(groups.length))
        .replace('{level}', levelText);
      const first = groups[0];
      const primary = first.warning.spanish || first.warning.english;
      const firstPeriod = first.periods[0];
      const lastPeriod = first.periods[first.periods.length - 1];
      const detail = (primary.description || primary.headline || '') +
        ' · ' + copy.validLabel + ': ' + format(firstPeriod.onset) + ' ' + copy.until + ' ' + format(lastPeriod.expires);
      setStatus(highest || 'unknown', levelText, text, detail);
    }

    (async function () {
      try {
        const response = await fetch(endpoint, { method: 'GET', headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('warnings unavailable');
        const payload = await response.json();
        if (!payload || !Array.isArray(payload.warnings) || !payload.zone || !payload.source) throw new Error('warnings malformed');

        finish();
        if (payload.warnings.length > 0) {
          const groups = groupWarnings(payload.warnings);
          groups.forEach((group) => list.appendChild(renderGroup(group, payload.zone.name)));
          list.classList.remove('hidden');
          summarize(groups);
        } else {
          const listed = payload.coverage === 'zone-listed';
          query('[data-warnings-empty-title]').textContent = listed ? copy.noneTitle : copy.notListedTitle;
          query('[data-warnings-empty-text]').textContent = listed ? copy.noneText : copy.notListedText;
          empty.classList.remove('hidden');
          if (listed) setStatus('none', copy.summary.chipNone, copy.summary.none, '');
          else setStatus('unknown', copy.summary.chipUnknown, copy.notListedTitle, '');
        }
        meta.textContent = copy.sourceLabel + ' · ' + copy.zoneLabel + ': ' + payload.zone.name + ' (' + payload.zone.id + ') · ' + copy.fetchedLabel + ': ' + format(payload.source.fetchedAt);
        meta.classList.remove('hidden');
      } catch {
        showFallback();
      }
    })();
  })();
</script>
