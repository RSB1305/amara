---
/**
 * Property listing card: image, meta, title, description, CTA.
 * Styling uses design tokens only (no raw hex).
 */
import type { ImageMetadata } from 'astro';
import AmaraImage from '../AmaraImage.astro';
import InlineEmphasis from '../text/InlineEmphasis.astro';

interface Props {
  href: string;
  imageSrc: ImageMetadata | string;
  imageAlt: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  meta: string;
  title: string;
  description: string;
  ctaLabel: string;
  linkAriaLabel?: string;
  dataStay?: string;
  dataDestination?: string;
  dataOccupancy?: number;
  totalPriceLabel?: string;
  hidden?: boolean;
}

const {
  href,
  imageSrc,
  imageAlt,
  loading = 'lazy',
  fetchpriority,
  meta,
  title,
  description,
  ctaLabel,
  linkAriaLabel = `View ${title}`,
  dataStay,
  dataDestination,
  dataOccupancy,
  totalPriceLabel,
  hidden = false
} = Astro.props;
---

<div
  class="am-apartment-card am-apartment-card--hover"
  hidden={hidden}
  data-am-stay-result={dataStay}
  data-am-stay-destination={dataDestination}
  data-am-stay-occupancy={dataOccupancy}
>
  <figure class="am-apartment-card__figure">
    <a
      href={href}
      aria-label={linkAriaLabel}
      class="am-card-link am-apartment-card__image-link"
      data-am-stay-result-link={dataStay}
      data-am-stay-result-base-href={dataStay ? href : undefined}
    >
      <AmaraImage
        src={imageSrc}
        alt={imageAlt}
        profile="card"
        class="am-apartment-card__image"
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    </a>
  </figure>
  <div class="am-apartment-card__body">
    <small class="am-apartment-card__meta am-text-caption text-on-surface-variant">{meta}</small>
    <h3 class="am-apartment-card__title am-text-subtitle text-on-surface">{title}</h3>
    <p class="am-apartment-card__description am-text-body text-on-surface-variant"><InlineEmphasis text={description} /></p>
    {dataStay && (
      <>
        <p class="am-apartment-card__stay-summary am-text-caption text-on-surface-variant" hidden data-am-stay-result-summary></p>
        <div class="am-apartment-card__price" hidden data-am-stay-result-price-wrap>
          <span class="am-text-label text-on-surface-variant">{totalPriceLabel}</span>
          {/* The price used to share `am-text-subtitle` with the stay's own
              title above it, so the two read at the same size and the figure
              won the card. `am-text-price` is the step below. */}
          <strong class="am-text-price text-primary" data-am-stay-result-price></strong>
        </div>
      </>
    )}
    <div class="am-apartment-card__cta-wrap">
      <a
        class:list={['am-btn', dataStay ? 'am-btn--primary' : 'am-btn--secondary']}
        href={href}
        data-am-stay-booking-link={dataStay}
        data-am-stay-result-base-href={dataStay ? href : undefined}
      >{ctaLabel}</a>
    </div>
  </div>
</div>

<style>
  @reference "../../styles/global.css";

  .am-apartment-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .am-apartment-card__figure {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: var(--color-surface-container-low);
  }

  .am-apartment-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .am-apartment-card__image-link :global(.am-apartment-card__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .am-apartment-card--hover:hover .am-apartment-card__image-link :global(.am-apartment-card__image) {
    transform: scale(1.05);
  }

  .am-apartment-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .am-apartment-card__meta {
    letter-spacing: 0.05em;
  }

  .am-apartment-card__title {
    margin: 0;
  }

  .am-apartment-card__description {
    margin: 0;
  }

  .am-apartment-card__cta-wrap {
    margin-top: 0.75rem;
  }

  .am-apartment-card__stay-summary {
    margin-top: 0.5rem;
  }

  .am-apartment-card__price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 0.75rem;
  }

</style>
