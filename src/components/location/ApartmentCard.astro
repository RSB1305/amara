---
/**
 * Property listing card: image, meta, title, description, CTA.
 * Styling uses design tokens only (no raw hex).
 */
interface Props {
  href: string;
  imageSrc: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  loading?: 'eager' | 'lazy';
  meta: string;
  title: string;
  description: string;
  ctaLabel: string;
}

const {
  href,
  imageSrc,
  imageAlt,
  imageWidth = 800,
  imageHeight = 600,
  loading = 'lazy',
  meta,
  title,
  description,
  ctaLabel
} = Astro.props;
---

<div class="am-apartment-card am-apartment-card--hover">
  <figure class="am-apartment-card__figure">
    <a href={href} aria-label={`View ${title}`} class="am-card-link am-apartment-card__image-link">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="am-apartment-card__image"
        loading={loading}
        width={imageWidth}
        height={imageHeight}
      />
    </a>
  </figure>
  <div class="am-apartment-card__body">
    <small class="am-apartment-card__meta am-text-caption text-on-surface-variant">{meta}</small>
    <h3 class="am-apartment-card__title am-text-subtitle text-on-surface">{title}</h3>
    <p class="am-apartment-card__description am-text-body text-on-surface-variant">{description}</p>
    <div class="am-apartment-card__cta-wrap">
      <a class="am-btn am-btn--secondary" href={href}>{ctaLabel}</a>
    </div>
  </div>
</div>

<style>
  @reference "../../styles/global.css";

  .am-apartment-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .am-apartment-card__figure {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: var(--color-surface-container-low);
  }

  .am-apartment-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .am-apartment-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .am-apartment-card--hover:hover .am-apartment-card__image {
    transform: scale(1.05);
  }

  .am-apartment-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .am-apartment-card__meta {
    letter-spacing: 0.05em;
  }

  .am-apartment-card__title {
    margin: 0;
  }

  .am-apartment-card__description {
    margin: 0;
  }

  .am-apartment-card__cta-wrap {
    margin-top: 0.75rem;
  }

</style>
