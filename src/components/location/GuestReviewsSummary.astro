---
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import { BedDouble, MessageCircle, Moon, Sparkles } from '@lucide/astro';

/**
 * Guest-review summary content rendered inside the shared AMARA section system.
 */
interface Feature {
  label: string;
  note?: string;
  icon?: 'cleanliness' | 'quiet-nights' | 'good-sleep' | 'quick-replies';
}

interface Props {
  eyebrow: string;
  headline: string;
  body: string;
  reviewsHref: string;
  reviewsCtaLabel: string;
  features: Feature[];
}

const { eyebrow, headline, body, reviewsHref, reviewsCtaLabel, features } = Astro.props;
const featureIcons = {
  cleanliness: Sparkles,
  'quiet-nights': Moon,
  'good-sleep': BedDouble,
  'quick-replies': MessageCircle
};
---

<div id="am-trust-badge" class="am-guest-reviews-summary">
  <div class="am-guest-reviews-summary__inner">
    <div class="am-guest-reviews-summary__copy">
      <p class="am-guest-reviews-summary__eyebrow am-text-eyebrow text-primary">{eyebrow}</p>
      <h2 id="guest-reviews-title" class="am-guest-reviews-summary__headline am-text-title text-on-surface">
        <span class="am-guest-reviews-summary__star am-gold" aria-hidden="true">★</span>
        {headline}
      </h2>
      <p class="am-guest-reviews-summary__body am-text-body text-on-surface-variant">{body}</p>
      <div class="am-guest-reviews-summary__cta-wrap">
        <AmaraActionLink variant="secondary" href={reviewsHref}>{reviewsCtaLabel}</AmaraActionLink>
      </div>
    </div>

    <ul class="am-guest-reviews-summary__features" aria-label="Highlighted guest features">
      {
        features.map((feature) => {
          const Icon = feature.icon ? featureIcons[feature.icon] : undefined;

          return (
            <li class="am-guest-reviews-summary__feature am-text-body">
              {Icon && <Icon class="am-guest-reviews-summary__feature-icon" stroke-width={1.5} aria-hidden="true" />}
              <span>
                {feature.label}
                {feature.note && <span class="am-guest-reviews-summary__feature-note am-text-caption text-muted">{feature.note}</span>}
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<style>
  @reference "../../styles/global.css";

  .am-guest-reviews-summary {
    width: 100%;
  }

  .am-guest-reviews-summary__inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
  }

  @media (min-width: 1024px) {
    .am-guest-reviews-summary__inner {
      flex-direction: row;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .am-guest-reviews-summary__copy {
    flex: 1 1 0%;
    max-width: 42rem;
  }

  .am-guest-reviews-summary__eyebrow {
    margin: 0 0 1.5rem 0;
  }

  .am-guest-reviews-summary__headline {
    margin: 0 0 1.5rem 0;
  }

  .am-guest-reviews-summary__star {
    margin-right: 0.75rem;
  }

  .am-guest-reviews-summary__body {
    line-height: 1.625;
    margin: 0 0 0.5rem 0;
  }

  .am-guest-reviews-summary__cta-wrap {
    margin-top: 0.5rem;
  }

  .am-guest-reviews-summary__features {
    flex: 1 1 0%;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 1024px) {
    .am-guest-reviews-summary__features {
      padding-top: 3rem;
      border-top: 0;
    }
  }

  .am-guest-reviews-summary__feature {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 3.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    line-height: 1.4;
    color: var(--color-on-surface-variant);
  }

  .am-guest-reviews-summary__feature-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    color: var(--color-primary);
  }

  .am-guest-reviews-summary__feature:nth-child(even) {
    padding-left: 1rem;
  }

  .am-guest-reviews-summary__feature-note {
    margin-left: 0.25rem;
  }
</style>
