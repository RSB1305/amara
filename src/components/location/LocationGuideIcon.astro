---
import {
  ArrowLeftRight,
  BusFront,
  CalendarDays,
  CarFront,
  CarTaxiFront,
  Castle,
  Clock3,
  CloudRain,
  Croissant,
  Flower2,
  Footprints,
  Handshake,
  House,
  Landmark,
  Map,
  MapPin,
  Mountain,
  Pill,
  PlaneLanding,
  Repeat2,
  Route,
  Sailboat,
  ShoppingBasket,
  Store,
  Sun,
  Sunset,
  ThermometerSun,
  Trees,
  Users,
  UtensilsCrossed,
  WavesHorizontal,
  Wind
} from '@lucide/astro';

import type { LocationGuideIconName } from './locationGuideIconContract';
export type { LocationGuideIconName };

interface Props {
  name: LocationGuideIconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

/**
 * One semantic icon vocabulary keeps practical Location guides aligned with
 * the accommodation fact language while allowing the underlying glyphs to
 * change centrally in a later AMARA design refresh.
 */
const icons = {
  airport: PlaneLanding,
  'rental-car': CarFront,
  'private-transfer': Handshake,
  taxi: CarTaxiFront,
  bus: BusFront,
  'journey-time': Clock3,
  distance: Route,
  elevation: Mountain,
  'walking-surface': Footprints,
  frequency: Repeat2,
  municipality: Map,
  'village-square': MapPin,
  'protected-landscape': Trees,
  'local-shops': ShoppingBasket,
  bakery: Croissant,
  supermarket: Store,
  walkable: Footprints,
  pharmacy: Pill,
  'opening-hours': Clock3,
  'longer-stay': CalendarDays,
  comparison: ArrowLeftRight,
  temperature: ThermometerSun,
  evening: Sunset,
  rainfall: CloudRain,
  sunshine: Sun,
  coast: WavesHorizontal,
  village: House,
  wind: Wind,
  boat: Sailboat,
  landmark: Landmark,
  castle: Castle,
  dining: UtensilsCrossed,
  wellness: Flower2,
  family: Users
} satisfies Record<LocationGuideIconName, typeof BusFront>;

const Icon = icons[name];
---

<Icon
  class:list={['shrink-0 text-primary', className]}
  stroke-width={1.5}
  aria-hidden="true"
  data-am-location-icon={name}
/>
