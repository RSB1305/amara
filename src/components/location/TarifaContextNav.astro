---
/**
 * Tarifa local context navigation with explicit parent and child levels.
 */
import ContextNavigation, {
  type ContextNavigationBreadcrumb,
  type ContextNavigationGroup
} from '../navigation/ContextNavigation.astro';
import {
  getTarifaAuthoritySubnav,
  type TarifaAuthorityBranchId,
  type TarifaAuthorityChild,
  type TarifaAuthorityChildId,
  type TarifaAuthoritySubnavId
} from '../../lib/tarifa/tarifaAuthoritySubnav';
import { resolveOptionalLink } from '../../lib/linkResolver';
import { getDestinationBranchNavigation } from '../../lib/location/destinationBranchNavigation';
import {
  getLocationGuideClusterLabels,
  LOCATION_GUIDE_CLUSTER_IDS,
  LOCATION_GUIDE_CLUSTER_TOPICS,
  type LocationGuideClusterId
} from '../../lib/location/locationGuideTopics';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  activeId: TarifaAuthoritySubnavId;
  activeChildId?: TarifaAuthorityChildId;
  currentLabel: string;
  childLabel?: string;
  lang: AmaraLanguage;
}

const {
  activeId,
  activeChildId,
  currentLabel,
  childLabel,
  lang
} = Astro.props;

const navigationItems = getTarifaAuthoritySubnav(lang);
const locationBranch = navigationItems.find((branch) => branch.id === 'location');
const experienceBranch = navigationItems.find((branch) => branch.id === 'experience');

const labels: Record<
  AmaraLanguage,
  {
    breadcrumb: string;
    switcher: string;
    experience: string;
    experienceDining: string;
    experienceNature: string;
    experienceCulture: string;
  }
> = {
  en: {
    breadcrumb: 'Breadcrumb',
    switcher: 'Tarifa guide navigation',
    experience: 'Experience',
    experienceDining: 'Dining & Taste',
    experienceNature: 'Nature & Outdoors',
    experienceCulture: 'Culture & Day Trips'
  },
  de: {
    breadcrumb: 'Brotkrümelnavigation',
    switcher: 'Navigation im Tarifa-Guide',
    experience: 'Erlebnisse',
    experienceDining: 'Kulinarik & Genuss',
    experienceNature: 'Natur & Outdoor',
    experienceCulture: 'Kultur & Ausflüge'
  },
  es: {
    breadcrumb: 'Migas de pan',
    switcher: 'Navegación de la guía de Tarifa',
    experience: 'Experiencias',
    experienceDining: 'Gastronomía & Sabor',
    experienceNature: 'Naturaleza & Aire Libre',
    experienceCulture: 'Cultura & Excursiones'
  },
  nl: {
    breadcrumb: 'Broodkruimelnavigatie',
    switcher: 'Navigatie van de Tarifa-gids',
    experience: 'Ervaringen',
    experienceDining: 'Culinair & Genieten',
    experienceNature: 'Natuur & Buitenleven',
    experienceCulture: 'Cultuur & Dagtrips'
  },
  sv: {
    breadcrumb: 'Brödsmulenavigering',
    switcher: 'Navigering i Tarifa-guiden',
    experience: 'Upplevelser',
    experienceDining: 'Mat & Smaker',
    experienceNature: 'Natur & Friluftsliv',
    experienceCulture: 'Kultur & Dagsutflykter'
  }
};

const copy = labels[lang];
const locationClusterLabels = getLocationGuideClusterLabels(lang);

const locationTopicsById = new Map(
  (locationBranch?.children ?? []).map((child) => [child.id, child] as const)
);

const pickLocationTopics = (ids: readonly TarifaAuthorityChildId[]) =>
  ids
    .map((id) => locationTopicsById.get(id))
    .filter((topic): topic is TarifaAuthorityChild => topic !== undefined);
const experienceTopicsById = new Map(
  (experienceBranch?.children ?? []).map((child) => [child.id, child] as const)
);

const pickExperienceTopics = (ids: readonly TarifaAuthorityChildId[]) =>
  ids
    .map((id) => experienceTopicsById.get(id))
    .filter((topic): topic is TarifaAuthorityChild => topic !== undefined);

const locationGroups: ContextNavigationGroup[] = [
  ...LOCATION_GUIDE_CLUSTER_IDS.map((clusterId: LocationGuideClusterId) => ({
    id: `tarifa-${clusterId}`,
    label: locationClusterLabels[clusterId],
    items: pickLocationTopics(LOCATION_GUIDE_CLUSTER_TOPICS[clusterId])
  }))
].filter((group) => group.items.length > 0);

const experienceGroups: ContextNavigationGroup[] = [
  {
    id: 'tarifa-experience-dining',
    label: copy.experienceDining,
    items: pickExperienceTopics(['food-evening-life'])
  },
  {
    id: 'tarifa-experience-nature',
    label: copy.experienceNature,
    items: pickExperienceTopics(['beaches', 'wind'])
  },
  {
    id: 'tarifa-experience-culture',
    label: copy.experienceCulture,
    items: pickExperienceTopics(['nature-wildlife', 'old-town-history', 'bolonia-baelo-claudia'])
  }
].filter((group) => group.items.length > 0);

const locationTopicIds = new Set((locationBranch?.children ?? []).map((topic) => topic.id));
const experienceTopicIds = new Set((experienceBranch?.children ?? []).map((topic) => topic.id));

const inferredChildId: TarifaAuthorityChildId | undefined =
  activeChildId ??
  (activeId !== 'overview' && activeId !== 'experience' ? activeId : undefined);

const activeBranchId: TarifaAuthorityBranchId =
  activeId === 'overview'
    ? 'location'
    : activeId === 'experience'
      ? 'experience'
      : inferredChildId
        ? locationTopicIds.has(inferredChildId)
          ? 'location'
          : experienceTopicIds.has(inferredChildId)
            ? 'experience'
            : 'location'
        : 'location';

const navigationGroups: ContextNavigationGroup[] =
  activeBranchId === 'experience' ? experienceGroups : locationGroups;

const allChildren = navigationGroups.flatMap((group) => group.items);
const activeTopicId = inferredChildId
  ? allChildren.find((item) => item.id === inferredChildId)?.id
  : undefined;
const branchNavigation = getDestinationBranchNavigation('tarifa', lang);
const homeHref = resolveOptionalLink('home', lang, {
  suppressMissing: true
});
const tarifaHref = resolveOptionalLink('location_tarifa', lang, {
  suppressMissing: true
});
const experienceHref = resolveOptionalLink('tarifa_experience_hub', lang, {
  suppressMissing: true
});

const breadcrumbs: ContextNavigationBreadcrumb[] = [
  {
    label: 'AMARA',
    href: homeHref ?? undefined
  },
  {
    label: 'Tarifa',
    href:
      activeBranchId === 'location' && !inferredChildId
        ? undefined
        : tarifaHref ?? undefined
  }
];

if (activeBranchId === 'experience' && activeId !== 'experience') {
  breadcrumbs.push({
    label:
      navigationItems.find((item) => item.id === 'experience')?.label ??
      copy.experience,
    href: experienceHref ?? undefined
  });
}

if (activeId !== 'overview') {
  breadcrumbs.push({ label: currentLabel });
}

if (childLabel) {
  breadcrumbs.push({ label: childLabel });
}
---

<ContextNavigation
  activeBranchId={activeBranchId}
  activeId={activeTopicId}
  branches={branchNavigation.items}
  branchSwitcherAriaLabel={branchNavigation.ariaLabel}
  breadcrumbAriaLabel={copy.breadcrumb}
  breadcrumbs={breadcrumbs}
  context="location"
  groups={navigationGroups}
  retainActiveItem={true}
  switcherAriaLabel={copy.switcher}
  items={[]}
/>
