---
import EditorialByline from '../editorial/EditorialByline.astro';
import LocationGuideEvidence from './LocationGuideEvidence.astro';
import LocationGuideHero from './LocationGuideHero.astro';
import type { AmaraHeroByline } from '../hero/heroContract';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  paragraphs: string[];
  evidenceEyebrow: string;
  evidenceMark?: string;
  evidenceNote?: string;
  evidenceSummary?: string;
  evidenceItems?: Array<{ label: string; value: string }>;
  byline?: AmaraHeroByline;
}

const {
  eyebrow,
  title,
  subtitle,
  paragraphs,
  evidenceEyebrow,
  evidenceMark,
  evidenceNote,
  evidenceSummary,
  evidenceItems = [],
  byline
} = Astro.props;
---

<LocationGuideHero
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  paragraphs={paragraphs}
  role="spoke"
  topic="weather"
  variant="authority-evidence"
  visualBeforeParagraphsOnMobile
>
  {byline && <EditorialByline slot="meta" {...byline} />}
  <LocationGuideEvidence
    slot="visual"
    eyebrow={evidenceEyebrow}
    mark={evidenceMark}
    note={evidenceNote}
    summary={evidenceSummary}
    items={evidenceItems}
  />
</LocationGuideHero>
