---
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  label: string;
  note: string;
  lang: AmaraLanguage;
}

const { label, note, lang } = Astro.props;

/**
 * Regional orientation map (not an arrival route — that lives on the arrival page).
 * It places Frigiliana in Andalusia: right beside Nerja on the Mediterranean coast,
 * with the classic round-trip cities (Sevilla, Córdoba, Granada, Ronda, Málaga) ringed
 * around it, so guests can situate the village and see the great highlights within reach.
 * City names stay in their Spanish spelling across all locales; only the sea, the base
 * note and the legend caption localize.
 */
const mapCopy: Record<AmaraLanguage, { sea: string; base: string; ring: string }> = {
  en: { sea: 'MEDITERRANEAN', base: 'Your AMARA base', ring: "Andalusia's classic round-trip stops" },
  de: { sea: 'MITTELMEER', base: 'Euer AMARA-Standort', ring: 'Andalusiens klassische Rundreise-Ziele' },
  es: { sea: 'MEDITERRÁNEO', base: 'Vuestra base AMARA', ring: 'Los clásicos de Andalucía para una ruta' },
  nl: { sea: 'MIDDELLANDSE ZEE', base: 'Jullie AMARA-basis', ring: "Andalusiës klassieke rondreissteden" },
  sv: { sea: 'MEDELHAVET', base: 'Er AMARA-bas', ring: 'Andalusiens klassiska rundresemål' }
};
const copy = mapCopy[lang];
---

<figure class="m-0">
  <div class="overflow-hidden border border-outline-variant/20 bg-surface-container-lowest">
    <svg
      class="block h-auto w-full"
      viewBox="0 0 920 620"
      role="img"
      aria-labelledby="frigiliana-orientation-map-title frigiliana-orientation-map-description"
    >
      <title id="frigiliana-orientation-map-title">{label}</title>
      <desc id="frigiliana-orientation-map-description">{note}</desc>

      <rect width="920" height="620" class="map-land" />

      <!-- Mediterranean along the south coast -->
      <path
        d="M0 470 C150 478 300 470 430 430 C500 410 560 405 640 398 C740 390 840 388 920 384 V620 H0 Z"
        class="map-sea"
      />
      <path
        d="M0 470 C150 478 300 470 430 430 C500 410 560 405 640 398 C740 390 840 388 920 384"
        class="map-coastline"
      />

      <!-- region wordmark -->
      <text x="58" y="118" class="map-wordmark" aria-hidden="true">ANDALUCÍA</text>

      <!-- classic round-trip ring through the great cities -->
      <path
        d="M166 258 C240 200 320 170 390 161 C480 175 560 250 609 299 C540 360 430 390 320 385 C250 360 180 310 166 258 Z"
        class="map-loop"
        aria-hidden="true"
      />

      <!-- round-trip hotspots -->
      <g class="map-hotspots">
        <circle cx="166" cy="258" r="7" class="map-point-muted" />
        <circle cx="390" cy="161" r="7" class="map-point-muted" />
        <circle cx="609" cy="299" r="7" class="map-point-muted" />
        <circle cx="320" cy="385" r="7" class="map-point-muted" />
        <circle cx="457" cy="388" r="7" class="map-point-muted" />
        <circle cx="575" cy="392" r="6" class="map-point-muted" />
      </g>

      <g class="map-labels">
        <text x="166" y="242" class="map-label map-label--mid">SEVILLA</text>
        <text x="390" y="145" class="map-label map-label--mid">CÓRDOBA</text>
        <text x="624" y="303" class="map-label">GRANADA</text>
        <text x="320" y="407" class="map-label map-label--mid">RONDA</text>
        <text x="446" y="409" class="map-label map-label--end">MÁLAGA</text>
        <text x="588" y="397" class="map-label map-label-small">NERJA</text>
        <text x="335" y="548" class="map-water-label">{copy.sea}</text>
      </g>

      <!-- Frigiliana: the emphasized base, right by Nerja on the coast -->
      <circle cx="554" cy="375" r="19" class="map-focus-ring" aria-hidden="true" />
      <circle cx="554" cy="375" r="11" class="map-point" />

      <path d="M560 378 L604 448" class="map-callout-line" />
      <g transform="translate(604 432)">
        <rect width="184" height="58" rx="1" class="map-callout" />
        <circle cx="18" cy="20" r="5" class="map-callout-point" />
        <text x="32" y="25" class="map-callout-title">FRIGILIANA</text>
        <text x="18" y="44" class="map-callout-copy">{copy.base}</text>
      </g>

      <!-- legend -->
      <g transform="translate(54 585)" aria-hidden="true">
        <path d="M0 0 H68" class="map-legend-line" />
        <text x="82" y="5" class="map-legend-label">{copy.ring}</text>
      </g>
    </svg>
  </div>
  <figcaption class="mt-3 am-text-label am-text-label--sm text-muted">
    {note}
  </figcaption>
</figure>

<style>
  .map-land {
    fill: var(--color-surface-container-lowest);
  }

  .map-sea {
    fill: #dbe7e7;
  }

  .map-coastline {
    fill: none;
    stroke: color-mix(in srgb, var(--color-on-surface) 42%, transparent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .map-wordmark {
    font-family: var(--font-label);
    fill: color-mix(in srgb, var(--color-on-surface-variant) 30%, transparent);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.42em;
  }

  .map-loop {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 55%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
    vector-effect: non-scaling-stroke;
  }

  .map-point,
  .map-callout-point {
    fill: var(--color-primary);
    stroke: var(--color-surface-white);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .map-focus-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 40%, transparent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .map-point-muted {
    fill: var(--color-on-surface-variant);
    stroke: var(--color-surface-white);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .map-label,
  .map-water-label,
  .map-callout-title,
  .map-callout-copy,
  .map-legend-label,
  .map-wordmark {
    font-family: var(--font-label);
  }

  .map-label {
    fill: var(--color-on-surface);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .map-label--mid {
    text-anchor: middle;
  }

  .map-label--end {
    text-anchor: end;
  }

  .map-label-small {
    font-size: 12px;
    letter-spacing: 0.12em;
    fill: color-mix(in srgb, var(--color-on-surface) 82%, transparent);
  }

  .map-water-label {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 62%, transparent);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-anchor: middle;
  }

  .map-callout-line {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .map-callout {
    fill: var(--color-surface-white);
    stroke: color-mix(in srgb, var(--color-primary) 42%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .map-callout-title {
    fill: var(--color-on-surface);
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.09em;
  }

  .map-callout-copy {
    fill: var(--color-on-surface-variant);
    font-size: 11px;
    font-weight: 550;
  }

  .map-legend-line {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 55%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
    vector-effect: non-scaling-stroke;
  }

  .map-legend-label {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 76%, transparent);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  @media (max-width: 520px) {
    .map-label {
      font-size: 22px;
    }

    .map-label-small {
      font-size: 18px;
    }

    .map-water-label {
      font-size: 20px;
    }

    .map-wordmark {
      font-size: 40px;
    }

    .map-callout-title {
      font-size: 18px;
    }

    .map-callout-copy {
      font-size: 14px;
    }

    .map-legend-label {
      font-size: 16px;
    }
  }
</style>
