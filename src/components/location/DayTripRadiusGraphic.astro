---
/**
 * Dark hero-tile graphic that summarizes a day-trips guide: the coastal base
 * with dashed routes radiating out to the four Andalusian day-trip
 * destinations, each with a neutral drive time. Same visual language as
 * ArrivalJourneyGraphic and BeachesCoastGraphic (dark inverse-surface tile,
 * faint terrain contours, primary-fixed-dim routes, font-label typography).
 */
export interface DayTripRadiusGraphicData {
  place: 'frigiliana' | 'nerja';
  eyebrow: string;
  destination: string;
  region: string;
  /** Coastal base node label (the home the trips start from). */
  baseLabel: string;
  seaLabel: string;
  context: Array<{ label: string; value: string }>;
  ariaLabel: string;
}

interface Props {
  data: DayTripRadiusGraphicData;
}

const { data } = Astro.props;

const coast =
  'M18 344 C110 332 190 348 288 326 C368 308 432 315 502 300';
const terrain = [
  'M150 150 C205 120 268 126 322 96 C356 77 384 79 414 65',
  'M96 190 C158 160 226 166 286 134 C320 116 348 118 380 104'
];

const base = { x: 414, y: 306 };

// Four day-trip destinations, placed by real direction from the coast, with
// language-neutral drive times. Routes are drawn base → destination.
const destinations = [
  { label: 'MÁLAGA', time: '~50 min', x: 118, y: 322, route: 'M414 306 C320 320 210 324 130 322', labelDy: 18, anchor: 'start' as const },
  { label: 'RONDA', time: '~2 h', x: 60, y: 206, route: 'M414 306 C300 300 158 252 76 214', labelDy: 18, anchor: 'start' as const },
  { label: 'CAMINITO DEL REY', time: '~1 h 30', x: 178, y: 156, route: 'M414 306 C342 270 252 205 190 166', labelDy: -12, anchor: 'middle' as const },
  { label: 'GRANADA', time: '~1 h 10', x: 306, y: 74, route: 'M414 306 C388 224 348 132 314 88', labelDy: -12, anchor: 'middle' as const }
];
---

<aside
  class="daytrip-graphic flex min-h-full flex-col overflow-hidden bg-inverse-surface text-inverted-on-surface"
  data-am-daytrip-graphic={data.place}
  aria-label={data.ariaLabel}
>
  <div class="flex items-start justify-between gap-6 px-7 pb-1 pt-8 sm:px-9 sm:pt-10 md:px-8 lg:px-10">
    <div>
      <p class="am-text-graphic-eyebrow text-primary-fixed-dim">{data.eyebrow}</p>
      <p class="daytrip-graphic__destination mt-3 italic text-inverted-on-surface">{data.destination}</p>
    </div>
    <p class="max-w-32 pt-1 text-right am-text-graphic-label leading-relaxed text-inverted-on-surface/45">
      {data.region}
    </p>
  </div>

  <div class="px-3 sm:px-5 md:px-3 lg:px-5">
    <svg
      viewBox="0 0 520 420"
      class="block h-auto w-full md:h-[336px] lg:h-auto xl:h-[336px]"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <filter id={`daytrip-glow-${data.place}`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <g class="terrain-lines">
        {terrain.map((path) => <path d={path} />)}
      </g>
      <path class="coast-line" d={coast} />

      <g class="route-lines">
        {destinations.map((dest) => (
          <path d={dest.route} class="route-primary" filter={`url(#daytrip-glow-${data.place})`} />
        ))}
      </g>

      {destinations.map((dest) => (
        <g class="map-node map-node--destination" transform={`translate(${dest.x} ${dest.y})`}>
          <circle class="node-halo" r="9" />
          <circle class="node-dot" r="3" />
          <text class="node-label node-label--dest" x="0" y={dest.labelDy} text-anchor={dest.anchor}>
            {dest.label}<tspan class="node-time"> · {dest.time}</tspan>
          </text>
        </g>
      ))}

      <g class="map-node map-node--base" transform={`translate(${base.x} ${base.y})`}>
        <circle class="node-halo" r="13" />
        <circle class="node-dot" r="4" />
        <text class="node-label node-label--base" x="-13" y="4" text-anchor="end">{data.baseLabel}</text>
      </g>

      <text class="sea-label" x="300" y="374">{data.seaLabel}</text>

      <g class="compass" transform="translate(47 53)">
        <path d="M0 14 L6 0 L12 14" />
        <line x1="6" y1="1" x2="6" y2="25" />
        <text x="6" y="-8" text-anchor="middle">N</text>
      </g>
    </svg>
  </div>

  <div class="mt-auto px-7 pb-8 sm:px-9 sm:pb-9 md:px-8 lg:px-10">
    <div class="grid grid-cols-3 border-y border-inverted-on-surface/15 py-5">
      {data.context.slice(0, 3).map((item, index) => (
        <div class:list={[index === 0 ? 'pr-3' : 'border-l border-inverted-on-surface/15 px-3', index === 2 && 'pl-3 pr-0']}>
          <p class="graphic-label">{item.label}</p>
          <p class="graphic-value">{item.value}</p>
        </div>
      ))}
    </div>
  </div>
</aside>

<style>
  .daytrip-graphic {
    aspect-ratio: 3 / 5;
    background-image:
      radial-gradient(circle at 78% 26%, color-mix(in srgb, var(--color-primary-fixed-dim) 8%, transparent), transparent 31%),
      linear-gradient(145deg, color-mix(in srgb, var(--color-inverse-surface) 93%, black), var(--color-inverse-surface));
  }

  .daytrip-graphic__destination {
    font-family: var(--font-headline);
    font-size: clamp(1.75rem, 4vw, 2.65rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .terrain-lines path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.09;
  }

  .coast-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.32;
  }

  .route-lines path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route-primary {
    stroke: var(--color-primary-fixed-dim);
    stroke-width: 2;
    stroke-dasharray: 3 7;
    opacity: 0.85;
  }

  .node-halo {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.26;
  }

  .node-dot {
    fill: currentColor;
    opacity: 0.7;
  }

  .map-node--base .node-halo {
    stroke: var(--color-inverse-on-surface);
    opacity: 0.82;
  }

  .map-node--base .node-dot {
    fill: var(--color-inverse-on-surface);
    opacity: 1;
  }

  .map-node--destination .node-halo {
    stroke: var(--color-primary-fixed-dim);
    opacity: 0.62;
  }

  .map-node--destination .node-dot {
    fill: var(--color-primary-fixed-dim);
    opacity: 0.95;
  }

  .node-label {
    fill: currentColor;
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .node-label--dest {
    font-size: 8px;
    fill: var(--color-primary-fixed-dim);
    opacity: 0.92;
    text-transform: uppercase;
  }

  .node-time {
    fill: var(--color-inverse-on-surface);
    font-weight: 600;
    letter-spacing: 0.06em;
    opacity: 0.62;
  }

  .node-label--base {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    fill: var(--color-inverse-on-surface);
    opacity: 0.85;
  }

  .sea-label {
    fill: currentColor;
    font-family: var(--font-label);
    font-size: 7px;
    font-weight: 600;
    letter-spacing: 0.16em;
    opacity: 0.2;
  }

  .compass path,
  .compass line {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.32;
  }

  .compass text {
    fill: currentColor;
    font-family: var(--font-label);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.42;
  }

  .graphic-label {
    font-family: var(--font-label);
    font-size: 8px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 44%, transparent);
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .graphic-value {
    margin-top: 0.45rem;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--color-inverted-on-surface);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .daytrip-graphic {
      margin-inline: auto;
      width: min(100%, 540px);
      min-height: 0;
      aspect-ratio: 3 / 4;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .daytrip-graphic {
      aspect-ratio: 3 / 5;
      min-height: 0;
    }
  }

  @media (min-width: 1280px) {
    .daytrip-graphic {
      aspect-ratio: 3 / 4;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .route-primary {
      animation: route-drift 16s linear infinite;
    }
  }

  @keyframes route-drift {
    to { stroke-dashoffset: -40; }
  }
</style>
