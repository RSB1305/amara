---
import type { ImageMetadata } from 'astro';
import AmaraImage from '../AmaraImage.astro';
import InlineEmphasis from '../text/InlineEmphasis.astro';

interface Props {
  eyebrow: string;
  title: string;
  paragraphs?: string[];
  accent?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
  imageWidth?: number;
  imageSizes?: string;
  family?: 'location' | 'experience';
  role?: 'hub' | 'spoke';
  topic?: string;
  visualBeforeMetaOnMobile?: boolean;
  visualBreakpoint?: 'md' | 'lg';
}

const {
  eyebrow,
  title,
  paragraphs = [],
  accent,
  imageSrc,
  imageAlt,
  imageWidth = 1080,
  imageSizes = '(max-width: 767px) 100vw, (max-width: 1023px) 44vw, 36vw',
  family = 'location',
  role = 'spoke',
  topic,
  visualBeforeMetaOnMobile = false,
  visualBreakpoint = 'md'
} = Astro.props;

const hasVisualSlot = Astro.slots.has('visual');
const hasMetaSlot = Astro.slots.has('meta');
const hasActionsSlot = Astro.slots.has('actions');

if (!hasVisualSlot && (!imageSrc || !imageAlt)) {
  throw new Error('[AMARA] LocationGuideHero requires either an image or a visual slot.');
}
---

<header
  class:list={[
    'border-b border-border-subtle bg-surface px-6 md:px-12 md:py-24 lg:py-28',
    role === 'hub' ? 'pb-16 pt-10' : 'py-16'
  ]}
  data-am-family={family}
  data-am-guide-hero
  data-am-role={role}
  data-am-topic={topic}
>
  <div
    class:list={[
      'mx-auto grid max-w-screen-2xl items-start gap-14 lg:gap-20',
      visualBreakpoint === 'lg' ? 'lg:grid-cols-12' : 'md:grid-cols-12'
    ]}
  >
    <div
      class:list={[
        visualBreakpoint === 'lg' ? 'lg:col-span-7' : 'md:col-span-7',
        visualBeforeMetaOnMobile && 'contents md:block'
      ]}
    >
      <div class="order-1">
        <p class="am-text-caption font-bold uppercase tracking-[0.2em] text-primary">
          {eyebrow}
        </p>
        <h1 class:list={[visualBeforeMetaOnMobile ? 'am-text-title' : 'am-text-display', 'mt-7 max-w-5xl text-balance italic text-on-surface']}>
          {title}
        </h1>

        {
          paragraphs.length > 0 && (
            <div class="mt-10 max-w-2xl space-y-5 border-l border-primary/25 pl-7 md:pl-9">
              {paragraphs.map((paragraph) => (
                <p class="am-text-body leading-relaxed text-on-surface-variant">
                  <InlineEmphasis text={paragraph} />
                </p>
              ))}
              {accent && (
                <p class="am-text-subtitle pt-2 italic text-on-surface">
                  <InlineEmphasis text={accent} />
                </p>
              )}
            </div>
          )
        }
      </div>

      {hasMetaSlot && (
        <div class:list={visualBeforeMetaOnMobile ? 'order-3 mt-0 md:order-none md:mt-9' : 'mt-9'}>
          <slot name="meta" />
        </div>
      )}
      {hasActionsSlot && <div class="mt-10"><slot name="actions" /></div>}
    </div>

    <div
      class:list={[
        'am-mobile-full-bleed',
        visualBreakpoint === 'lg' ? 'lg:col-span-5' : 'md:col-span-5',
        visualBeforeMetaOnMobile && 'order-2 md:order-none'
      ]}
    >
      {
        hasVisualSlot ? (
          <slot name="visual" />
        ) : (
          <AmaraImage
            src={imageSrc!}
            alt={imageAlt!}
            profile="hero"
            width={imageWidth}
            widths={[480, 640, 800, imageWidth]}
            sizes={imageSizes}
            class="aspect-[3/4] h-full w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )
      }
    </div>
  </div>
</header>
