---
import type { ImageMetadata } from 'astro';
import AmaraImage from '../AmaraImage.astro';
import InlineEmphasis from '../text/InlineEmphasis.astro';

interface Props {
  eyebrow: string;
  title: string;
  paragraphs?: string[];
  accent?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageSizes?: string;
}

const {
  eyebrow,
  title,
  paragraphs = [],
  accent,
  imageSrc,
  imageAlt,
  imageWidth = 1080,
  imageSizes = '(max-width: 767px) 100vw, (max-width: 1023px) 44vw, 36vw'
} = Astro.props;

const hasVisualSlot = Astro.slots.has('visual');
const hasMetaSlot = Astro.slots.has('meta');
const hasActionsSlot = Astro.slots.has('actions');

if (!hasVisualSlot && (!imageSrc || !imageAlt)) {
  throw new Error('[AMARA] LocationGuideHero requires either an image or a visual slot.');
}
---

<header
  class="border-b border-border-subtle bg-surface px-6 py-16 md:px-12 md:py-24 lg:py-28"
  data-am-guide-hero
>
  <div class="mx-auto grid max-w-screen-2xl items-center gap-14 md:grid-cols-12 lg:gap-20">
    <div class="md:col-span-7">
      <p class="am-text-caption font-bold uppercase tracking-[0.2em] text-primary">
        {eyebrow}
      </p>
      <h1 class="am-text-display mt-7 max-w-5xl text-balance italic text-on-surface">
        {title}
      </h1>

      {
        paragraphs.length > 0 && (
          <div class="mt-10 max-w-2xl space-y-5 border-l border-primary/25 pl-7 md:pl-9">
            {paragraphs.map((paragraph) => (
              <p class="am-text-body leading-relaxed text-on-surface-variant">
                <InlineEmphasis text={paragraph} />
              </p>
            ))}
            {accent && (
              <p class="am-text-subtitle pt-2 italic text-on-surface">
                <InlineEmphasis text={accent} />
              </p>
            )}
          </div>
        )
      }

      {hasMetaSlot && <div class="mt-9"><slot name="meta" /></div>}
      {hasActionsSlot && <div class="mt-10"><slot name="actions" /></div>}
    </div>

    <div class="am-mobile-full-bleed md:col-span-5">
      {
        hasVisualSlot ? (
          <slot name="visual" />
        ) : (
          <AmaraImage
            src={imageSrc!}
            alt={imageAlt!}
            profile="hero"
            width={imageWidth}
            widths={[480, 640, 800, imageWidth]}
            sizes={imageSizes}
            class="aspect-[3/4] h-full w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )
      }
    </div>
  </div>
</header>
