---
/**
 * Dark hero-tile graphic that summarizes a beaches guide: the coastline with
 * the guide's beaches placed west→east and grouped by character, plus a
 * stat strip. Same visual language as ArrivalJourneyGraphic (dark
 * inverse-surface tile, faint terrain contours, primary-fixed-dim accents,
 * font-label typography) so the two graphics read as one family.
 */
export interface BeachesCoastGraphicData {
  place: 'frigiliana' | 'nerja';
  eyebrow: string;
  destination: string;
  region: string;
  /** Inland base node label (the village the guests drive down from). */
  baseLabel: string;
  seaLabel: string;
  context: Array<{ label: string; value: string }>;
  ariaLabel: string;
}

interface Props {
  data: BeachesCoastGraphicData;
}

const { data } = Astro.props;

// Shared coast and terrain geometry (matches ArrivalJourneyGraphic's frigiliana map).
const coast =
  'M18 283 C90 270 142 286 205 264 C266 244 318 257 376 229 C424 206 463 209 502 194';
const terrain = [
  'M260 120 C310 88 373 92 424 60 C458 39 486 41 516 27',
  'M278 151 C333 121 386 127 439 94 C469 75 493 77 520 61',
  'M302 184 C350 160 406 163 458 132 C482 118 501 119 520 108'
];

// Beaches placed along the shore, west→east, grouped by character.
const beaches = [
  { x: 72, y: 278, label: 'El Playazo', kind: 'quiet', labelDy: 15, anchor: 'start' },
  { x: 120, y: 282, label: 'Carabeíllo', kind: 'quiet', labelDy: 28, anchor: 'start' },
  { x: 238, y: 258, label: 'Calahonda', kind: 'town', labelDy: 16, anchor: 'middle' },
  { x: 300, y: 248, label: 'Burriana', kind: 'town', labelDy: 28, anchor: 'middle' },
  { x: 382, y: 230, label: 'Maro', kind: 'nature', labelDy: -12, anchor: 'middle' },
  { x: 452, y: 212, label: 'Cantarriján', kind: 'nature', labelDy: 16, anchor: 'end' }
] as const;

// Base node per place. Frigiliana sits inland above the coast, with a descent
// route down to the central shore that fills the map vertically; Nerja is a
// town on this same coast, marked among the beaches without a descent.
const baseByPlace = {
  frigiliana: { x: 316, y: 96, descent: 'M316 96 C306 140 300 186 300 242', labelX: 13, labelY: 4, anchor: 'start' as const },
  nerja: { x: 198, y: 246, descent: undefined, labelX: 0, labelY: -14, anchor: 'middle' as const }
};
const base = baseByPlace[data.place];
---

<aside
  class="beaches-graphic flex min-h-full flex-col overflow-hidden bg-inverse-surface text-inverted-on-surface"
  data-am-beaches-graphic={data.place}
  aria-label={data.ariaLabel}
>
  <div class="flex items-start justify-between gap-6 px-7 pb-1 pt-8 sm:px-9 sm:pt-10 md:px-8 lg:px-10">
    <div>
      <p class="am-text-graphic-eyebrow text-primary-fixed-dim">{data.eyebrow}</p>
      <p class="beaches-graphic__destination mt-3 italic text-inverted-on-surface">{data.destination}</p>
    </div>
    <p class="max-w-32 pt-1 text-right am-text-graphic-label leading-relaxed text-inverted-on-surface/45">
      {data.region}
    </p>
  </div>

  <div class="px-3 sm:px-5 md:px-3 lg:px-5">
    <svg
      viewBox="0 0 520 420"
      class="block h-auto w-full md:h-[336px] lg:h-auto xl:h-[336px]"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <g class="terrain-lines">
        {terrain.map((path) => <path d={path} />)}
      </g>
      <path class="coast-line" d={coast} />

      {base.descent && <path class="descent-route" d={base.descent} />}

      <g class="map-node map-node--base" transform={`translate(${base.x} ${base.y})`}>
        <circle class="node-halo" r="12" />
        <circle class="node-dot" r="3.5" />
        <text class="node-label node-label--base" x={base.labelX} y={base.labelY} text-anchor={base.anchor}>{data.baseLabel}</text>
      </g>

      {beaches.map((beach) => (
        <g class:list={['map-node', 'map-node--beach', `map-node--${beach.kind}`]} transform={`translate(${beach.x} ${beach.y})`}>
          <circle class="node-halo" r="8" />
          <circle class="node-dot" r="3" />
          <text class="node-label node-label--beach" x="0" y={beach.labelDy} text-anchor={beach.anchor}>
            {beach.label}
          </text>
        </g>
      ))}

      <text class="sea-label" x="320" y="306">{data.seaLabel}</text>

      <g class="compass" transform="translate(47 53)">
        <path d="M0 14 L6 0 L12 14" />
        <line x1="6" y1="1" x2="6" y2="25" />
        <text x="6" y="-8" text-anchor="middle">N</text>
      </g>
    </svg>
  </div>

  <div class="mt-auto px-7 pb-8 sm:px-9 sm:pb-9 md:px-8 lg:px-10">
    <div class="grid grid-cols-3 border-y border-inverted-on-surface/15 py-5">
      {data.context.slice(0, 3).map((item, index) => (
        <div class:list={[index === 0 ? 'pr-3' : 'border-l border-inverted-on-surface/15 px-3', index === 2 && 'pl-3 pr-0']}>
          <p class="graphic-label">{item.label}</p>
          <p class="graphic-value">{item.value}</p>
        </div>
      ))}
    </div>
  </div>
</aside>

<style>
  .beaches-graphic {
    aspect-ratio: 3 / 5;
    background-image:
      radial-gradient(circle at 78% 26%, color-mix(in srgb, var(--color-primary-fixed-dim) 8%, transparent), transparent 31%),
      linear-gradient(145deg, color-mix(in srgb, var(--color-inverse-surface) 93%, black), var(--color-inverse-surface));
  }

  .beaches-graphic__destination {
    font-family: var(--font-headline);
    font-size: clamp(1.75rem, 4vw, 2.65rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .terrain-lines path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.09;
  }

  .coast-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.32;
  }

  .descent-route {
    fill: none;
    stroke: var(--color-primary-fixed-dim);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 3 7;
    opacity: 0.85;
  }

  .node-halo {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.26;
  }

  .node-dot {
    fill: currentColor;
    opacity: 0.7;
  }

  .map-node--base .node-halo {
    stroke: var(--color-primary-fixed-dim);
    opacity: 0.72;
  }

  .map-node--base .node-dot {
    fill: var(--color-inverse-on-surface);
    opacity: 1;
  }

  .map-node--town .node-halo {
    stroke: var(--color-primary-fixed-dim);
    opacity: 0.6;
  }

  .map-node--town .node-dot {
    fill: var(--color-primary-fixed-dim);
    opacity: 0.95;
  }

  .node-label {
    fill: currentColor;
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .node-label--beach {
    font-size: 8.5px;
    opacity: 0.7;
    text-transform: uppercase;
  }

  .map-node--town .node-label--beach {
    fill: var(--color-primary-fixed-dim);
    opacity: 0.92;
  }

  .node-label--base {
    font-size: 9px;
    letter-spacing: 0.16em;
    opacity: 0.78;
  }

  .sea-label {
    fill: currentColor;
    font-family: var(--font-label);
    font-size: 7px;
    font-weight: 600;
    letter-spacing: 0.16em;
    opacity: 0.2;
  }

  .compass path,
  .compass line {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.32;
  }

  .compass text {
    fill: currentColor;
    font-family: var(--font-label);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.42;
  }

  .graphic-label {
    font-family: var(--font-label);
    font-size: 8px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 44%, transparent);
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .graphic-value {
    margin-top: 0.45rem;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--color-inverted-on-surface);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .beaches-graphic {
      margin-inline: auto;
      width: min(100%, 540px);
      min-height: 0;
      aspect-ratio: 3 / 4;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .beaches-graphic {
      aspect-ratio: 3 / 5;
      min-height: 0;
    }
  }

  @media (min-width: 1280px) {
    .beaches-graphic {
      aspect-ratio: 3 / 4;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .descent-route {
      animation: descent-drift 16s linear infinite;
    }
  }

  @keyframes descent-drift {
    to { stroke-dashoffset: -40; }
  }
</style>
