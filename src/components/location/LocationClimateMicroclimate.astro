---
// The mountain-vs-coast microclimate read, in the host's first-hand voice. It
// stands next to the measured climate table above but is deliberately framed as
// lived experience, not a station measurement — the intro says so — because the
// village-vs-coast contrast is not resolvable from the gridded climate data.
import InlineEmphasis from '../text/InlineEmphasis.astro';

interface Season {
  label: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  summer: Season;
  winter: Season;
  links: Array<{ label: string; href: string }>;
}

const { eyebrow, title, intro, summer, winter, links } = Astro.props;
---

<section class="bg-surface-container-low" data-am-climate-microclimate>
  <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
    <header class="max-w-3xl">
      <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{eyebrow}</p>
      <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{title}</h2>
      <p class="am-text-body mt-6 leading-relaxed text-on-surface-variant">{intro}</p>
    </header>

    <div class="mt-12 grid gap-x-16 gap-y-10 md:grid-cols-2">
      {[summer, winter].map((season) => (
        <div class="border-t border-outline-variant/25 pt-6">
          <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{season.label}</p>
          <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant"><InlineEmphasis text={season.body} /></p>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4">
      {links.map((link) => (
        <a href={link.href} class="am-cta-link">{link.label}</a>
      ))}
    </div>
  </div>
</section>
