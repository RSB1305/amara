---
// Two seasonal reads that turn the climate table into a decision: the real
// summer heat (with the step-guide link) and the unusually mild winter (with
// the winter-stay link). No chart of its own — the month-by-month comparison
// lives inside the climate table above.
import InlineEmphasis from '../text/InlineEmphasis.astro';

interface Callout {
  eyebrow: string;
  title: string;
  body: string;
  linkLabel: string;
  linkHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  summer: Callout;
  winter: Callout;
}

const { eyebrow, title, summer, winter } = Astro.props;
---

<section class="bg-surface" data-am-climate-context>
  <div class="mx-auto max-w-screen-2xl px-6 py-20 md:px-12 md:py-28">
    <header class="max-w-3xl">
      <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{eyebrow}</p>
      <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{title}</h2>
    </header>

    <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-8">
      {[summer, winter].map((callout) => (
        <div class="flex flex-col border-t-2 border-primary/70 bg-surface-container-low p-8 md:p-10">
          <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{callout.eyebrow}</p>
          <h3 class="am-text-subtitle mt-4 text-balance text-on-surface">{callout.title}</h3>
          <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant"><InlineEmphasis text={callout.body} /></p>
          <a href={callout.linkHref} class="am-cta-link mt-6 self-start">{callout.linkLabel}</a>
        </div>
      ))}
    </div>
  </div>
</section>
