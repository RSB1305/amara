---
import type { ImageMetadata } from 'astro';
import EditorialByline from '../editorial/EditorialByline.astro';
import type { AmaraLanguage } from '../../types/seo';
import LocationGuideHero from './LocationGuideHero.astro';

interface HeroAction {
  href: string;
  label: string;
  style: 'primary' | 'secondary';
}

interface HeroByline {
  lang: AmaraLanguage;
  authorName: string;
  authorHref: string;
  updated: string;
  note: string;
}

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  imageSrc: ImageMetadata | string;
  imageAlt: string;
  imageWidth?: number;
  imageSizes?: string;
  accent?: string;
  actions?: HeroAction[];
  byline?: HeroByline;
  role?: 'hub' | 'spoke';
  topic?: string;
}

const {
  eyebrow,
  title,
  paragraphs,
  imageSrc,
  imageAlt,
  imageWidth,
  imageSizes,
  accent,
  actions = [],
  byline,
  role = 'spoke',
  topic
} = Astro.props;
---

<LocationGuideHero
  eyebrow={eyebrow}
  title={title}
  paragraphs={paragraphs}
  accent={accent}
  imageSrc={imageSrc}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageSizes={imageSizes}
  family="experience"
  role={role}
  topic={topic}
>
  {byline && <EditorialByline slot="meta" {...byline} />}
  {actions.length > 0 && (
    <div slot="actions" class="flex flex-wrap gap-4">
      {actions.map((action) => (
        <a href={action.href} class={`am-btn am-btn--${action.style}`}>
          {action.label}
        </a>
      ))}
    </div>
  )}
</LocationGuideHero>
