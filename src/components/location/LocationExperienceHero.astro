---
import type { ImageMetadata } from 'astro';
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import EditorialByline from '../editorial/EditorialByline.astro';
import type { AmaraHeroByline, AmaraHeroStyledAction } from '../hero/heroContract';
import LocationGuideHero from './LocationGuideHero.astro';
import PhotoBrief from '../media/PhotoBrief.astro';
import type { PhotoBriefProps } from '../../lib/images/routeImages';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  paragraphs: string[];
  /** Either an image or a `visual` slot (e.g. a photo brief while the photograph is missing). */
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
  imageWidth?: number;
  imageSizes?: string;
  /** Holds the hero slot while the photograph is missing (`routeHero` supplies it from the image source). */
  brief?: PhotoBriefProps;
  accent?: string;
  actions?: AmaraHeroStyledAction[];
  byline?: AmaraHeroByline;
  role?: 'hub' | 'spoke';
  topic?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  paragraphs,
  imageSrc,
  imageAlt,
  imageWidth,
  imageSizes,
  brief,
  accent,
  actions = [],
  byline,
  role = 'spoke',
  topic
} = Astro.props;
const visualHtml = Astro.slots.has('visual') ? ((await Astro.slots.render('visual')) ?? '') : '';
const hasVisualSlot = visualHtml.trim().length > 0;
---

<LocationGuideHero
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  paragraphs={paragraphs}
  accent={accent}
  imageSrc={imageSrc}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageSizes={imageSizes}
  family="experience"
  role={role}
  topic={topic}
>
  {(hasVisualSlot || (!imageSrc && brief)) && (
    <div slot="visual" class="h-full">
      {hasVisualSlot ? (
        <Fragment set:html={visualHtml} />
      ) : (
        brief && <PhotoBrief class="aspect-[3/4] h-full w-full" motif={brief.motif} format={brief.format} light={brief.light} />
      )}
    </div>
  )}
  {byline && <EditorialByline slot="meta" {...byline} />}
  {actions.length > 0 && (
    <div slot="actions" class="flex flex-wrap gap-4">
      {actions.map((action) => (
        <AmaraActionLink href={action.href} variant={action.style}>
          {action.label}
        </AmaraActionLink>
      ))}
    </div>
  )}
</LocationGuideHero>
