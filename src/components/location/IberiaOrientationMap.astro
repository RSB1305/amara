---
import { iberiaOrientationMapGeometry as geo } from '../../content/iberiaOrientationMapGeometry';
import type { AmaraLanguage } from '../../types/seo';

type MapPlace = 'frigiliana' | 'nerja' | 'tarifa';
type PlaceKey = keyof typeof geo.places;

interface Props {
  place: MapPlace;
  label: string;
  note: string;
  lang: AmaraLanguage;
}

const { place, label, note, lang } = Astro.props;

/**
 * Orientation map shared by the three location hubs: the whole Iberian Peninsula (real
 * coastlines and borders, Lambert conic), Andalusia tinted, a road-shaped round trip through
 * the great cities from the AMARA base, and the base itself as the emphasised marker. Because
 * the base and its neighbour (Nerja/Frigiliana) or the base and its coast (Tarifa on the Strait)
 * collapse at peninsula scale, a magnifier lens enlarges the immediate surroundings. City names
 * keep their Spanish spelling in every locale; seas, neighbouring countries, the base note and
 * the legend localise. Geometry is generated by scripts/build-iberia-orientation-map.mjs.
 */
const mapCopy: Record<
  AmaraLanguage,
  { sea: string; atlantic: string; biscay: string; strait: string; france: string; morocco: string; algeria: string; base: string; legend: string }
> = {
  en: { sea: 'MEDITERRANEAN', atlantic: 'ATLANTIC', biscay: 'BAY OF BISCAY', strait: 'STRAIT OF GIBRALTAR', france: 'FRANCE', morocco: 'MOROCCO', algeria: 'ALGERIA', base: 'Your AMARA base', legend: 'A possible round trip' },
  de: { sea: 'MITTELMEER', atlantic: 'ATLANTIK', biscay: 'GOLF VON BISKAYA', strait: 'STRASSE VON GIBRALTAR', france: 'FRANKREICH', morocco: 'MAROKKO', algeria: 'ALGERIEN', base: 'Euer AMARA-Standort', legend: 'Mögliche Rundreise' },
  es: { sea: 'MEDITERRÁNEO', atlantic: 'ATLÁNTICO', biscay: 'GOLFO DE VIZCAYA', strait: 'ESTRECHO DE GIBRALTAR', france: 'FRANCIA', morocco: 'MARRUECOS', algeria: 'ARGELIA', base: 'Vuestra base AMARA', legend: 'Una posible ruta' },
  nl: { sea: 'MIDDELLANDSE ZEE', atlantic: 'ATLANTISCHE OCEAAN', biscay: 'GOLF VAN BISKAJE', strait: 'STRAAT VAN GIBRALTAR', france: 'FRANKRIJK', morocco: 'MAROKKO', algeria: 'ALGERIJE', base: 'Jullie AMARA-basis', legend: 'Een mogelijke rondreis' },
  sv: { sea: 'MEDELHAVET', atlantic: 'ATLANTEN', biscay: 'BISCAYABUKTEN', strait: 'GIBRALTAR SUND', france: 'FRANKRIKE', morocco: 'MAROCKO', algeria: 'ALGERIET', base: 'Er AMARA-bas', legend: 'En möjlig rundresa' }
};
const copy = mapCopy[lang];

const { width: W, height: H, places: p } = geo;

type Anchor = 'start' | 'middle' | 'end';
interface CityLabel {
  key: PlaceKey;
  name: string;
  dx: number;
  dy: number;
  anchor: Anchor;
}

const CITY_NAMES: Partial<Record<PlaceKey, string>> = {
  malaga: 'MÁLAGA',
  ronda: 'RONDA',
  sevilla: 'SEVILLA',
  cordoba: 'CÓRDOBA',
  granada: 'GRANADA',
  cadiz: 'CÁDIZ',
  madrid: 'MADRID',
  lisboa: 'LISBOA',
  porto: 'PORTO',
  barcelona: 'BARCELONA',
  valencia: 'VALENCIA',
  bilbao: 'BILBAO'
};
const cityLabel = (key: PlaceKey, dx: number, dy: number, anchor: Anchor): CityLabel => ({ key, name: CITY_NAMES[key] ?? key, dx, dy, anchor });

const inlandReferences: CityLabel[] = ['madrid', 'lisboa', 'porto', 'barcelona', 'valencia', 'bilbao'].map((key) => cityLabel(key as PlaceKey, 10, 4, 'start'));
const axarquiaStops: CityLabel[] = [
  cityLabel('sevilla', -10, 4, 'end'),
  cityLabel('cordoba', 0, -11, 'middle'),
  cityLabel('granada', 11, 4, 'start'),
  cityLabel('ronda', -9, 7, 'end'),
  cityLabel('malaga', 0, 16, 'middle')
];

const placeConfig: Record<MapPlace, { base: PlaceKey; route: keyof typeof geo.routes; stops: CityLabel[]; references: CityLabel[]; lens: 'axarquia-hill' | 'axarquia-coast' | 'strait' }> = {
  frigiliana: { base: 'frigiliana', route: 'frigiliana', stops: axarquiaStops, references: [...inlandReferences, cityLabel('cadiz', -10, 4, 'end')], lens: 'axarquia-hill' },
  nerja: { base: 'nerja', route: 'nerja', stops: axarquiaStops, references: [...inlandReferences, cityLabel('cadiz', -10, 4, 'end')], lens: 'axarquia-coast' },
  tarifa: {
    base: 'tarifa',
    route: 'tarifa',
    stops: [
      cityLabel('cadiz', -10, 4, 'end'),
      cityLabel('sevilla', -10, 4, 'end'),
      cityLabel('cordoba', 0, -11, 'middle'),
      cityLabel('granada', 11, 4, 'start'),
      cityLabel('malaga', 0, 16, 'middle'),
      cityLabel('ronda', -6, -7, 'end')
    ],
    references: inlandReferences,
    lens: 'strait'
  }
};
const cfg = placeConfig[place];
const base = p[cfg.base];
const route = geo.routes[cfg.route];

// magnifier lens over the Alborán Sea, tied to the base marker by one quiet leader line
const FOCUS_R = 9;
const LENS = { cx: 628, cy: 666, r: 82 };
const f1 = (v: number) => v.toFixed(1);
const leader = (() => {
  const [x1, y1] = base;
  const dx = LENS.cx - x1;
  const dy = LENS.cy - y1;
  const d = Math.hypot(dx, dy);
  const u = [dx / d, dy / d];
  return `M${f1(x1 + FOCUS_R * u[0])} ${f1(y1 + FOCUS_R * u[1])} L${f1(LENS.cx - LENS.r * u[0])} ${f1(LENS.cy - LENS.r * u[1])}`;
})();

const ids = {
  title: `iberia-orientation-map-title-${place}`,
  desc: `iberia-orientation-map-description-${place}`,
  clip: `iberia-orientation-lens-${place}`
};
const anchorClass = (anchor: Anchor) => (anchor === 'end' ? 'map-label--end' : anchor === 'middle' ? 'map-label--mid' : '');
---

<figure class="m-0">
  <div class="overflow-hidden border border-outline-variant/20 bg-surface-container-lowest">
    <svg class="block h-auto w-full" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${ids.title} ${ids.desc}`}>
      <title id={ids.title}>{label}</title>
      <desc id={ids.desc}>{note}</desc>
      <defs>
        <clipPath id={ids.clip}><circle r={LENS.r} /></clipPath>
      </defs>

      <rect width={W} height={H} class="map-sea" />

      <!-- neighbouring land as quiet context -->
      <path d={geo.countries.france} class="map-land map-land--neighbour" />
      <path d={geo.countries.morocco} class="map-land map-land--neighbour" />
      <path d={geo.countries.algeria} class="map-land map-land--neighbour" />
      <path d={geo.countries.andorra} class="map-land map-land--neighbour" />
      <!-- the peninsula -->
      <path d={geo.countries.portugal} class="map-land map-land--portugal" />
      <path d={geo.countries.spain} class="map-land" />
      <path d={geo.countries.gibraltar} class="map-land map-land--neighbour" />
      <path d={geo.andalucia} class="map-region" />
      <path d={geo.borders} class="map-border" />

      <!-- wordmarks and waters -->
      <g aria-hidden="true">
        <text x="470" y="252" class="map-wordmark map-wordmark--country">ESPAÑA</text>
        <text transform="translate(203 362) rotate(-72)" class="map-wordmark map-wordmark--portugal">PORTUGAL</text>
        <text x="418" y="474" class="map-wordmark map-wordmark--region">ANDALUCÍA</text>
        <text transform="translate(56 300) rotate(-90)" class="map-water-label">{copy.atlantic}</text>
        <text x="440" y="40" class="map-water-label map-water-label--small">{copy.biscay}</text>
        <text x="792" y="456" class="map-water-label">{copy.sea}</text>
        <text x="880" y="70" class="map-context-label">{copy.france}</text>
        <text x="440" y={H - 22} class="map-context-label">{copy.morocco}</text>
        <text x={W - 30} y={H - 28} class="map-context-label map-context-label--end">{copy.algeria}</text>
      </g>

      <!-- reference cities -->
      <g class="map-reference">
        {cfg.references.map(({ key, name, dx, dy, anchor }) => (
          <>
            <circle cx={p[key][0]} cy={p[key][1]} r="3.2" class="map-point-ref" />
            <text x={p[key][0] + dx} y={p[key][1] + dy} class:list={['map-label map-label--ref', anchorClass(anchor)]}>
              {name}
            </text>
          </>
        ))}
      </g>

      <!-- a possible round trip, drawn along the road corridors -->
      <path d={route} class="map-route-casing" />
      <path d={route} class="map-route" />
      <g class="map-stops">
        {cfg.stops.map(({ key }) => <circle cx={p[key][0]} cy={p[key][1]} r="4.6" class="map-point-stop" />)}
      </g>
      <g class="map-stop-labels">
        {cfg.stops.map(({ key, name, dx, dy, anchor }) => (
          <text x={p[key][0] + dx} y={p[key][1] + dy} class:list={['map-label map-label--stop', anchorClass(anchor)]}>
            {name}
          </text>
        ))}
      </g>

      <!-- the base, tied to the lens -->
      <path d={leader} class="map-leader" aria-hidden="true" />
      <circle cx={base[0]} cy={base[1]} r={FOCUS_R} class="map-focus-ring" />
      <circle cx={base[0]} cy={base[1]} r="4.6" class="map-point-base" />

      <!-- lens -->
      <g class="map-lens" transform={`translate(${LENS.cx} ${LENS.cy})`}>
        <circle r={LENS.r + 3} class="map-lens-rim" />
        <g clip-path={`url(#${ids.clip})`}>
          <rect x="-92" y="-92" width="184" height="184" class="map-lens-land" />

          {cfg.lens !== 'strait' && (
            <>
              <!-- Axarquía: the coast at Nerja, Frigiliana up the slope, the Sierra behind -->
              <g class="map-lens-contours">
                <path d="M-92 -70 C-56 -86 -14 -84 26 -72 C56 -63 78 -70 92 -82" />
                <path d="M-92 -50 C-60 -66 -22 -64 14 -52 C44 -42 70 -48 92 -62" />
                <path d="M-92 -30 C-64 -44 -30 -42 2 -32 C32 -22 64 -26 92 -40" />
              </g>
              <path
                d="M-92 34 C-64 30 -40 32 -18 28 C-4 25 2 20 10 20 C18 20 22 26 34 26 C58 26 76 20 92 16 L92 92 L-92 92 Z"
                class="map-lens-sea"
              />
              <path
                d="M-92 34 C-64 30 -40 32 -18 28 C-4 25 2 20 10 20 C18 20 22 26 34 26 C58 26 76 20 92 16"
                class="map-lens-coast"
              />
              <path d="M-92 28 C-60 24 -30 26 -8 22 C4 19 20 18 36 20 C60 22 78 16 92 10" class="map-lens-route" />
              <path
                d="M10 20 C8 10 2 4 0 -4 C-2 -12 -4 -16 0 -22"
                class:list={[cfg.lens === 'axarquia-hill' ? 'map-lens-route' : 'map-lens-road']}
              />
              <text x="0" y="62" class="map-water-label map-water-label--lens map-label--mid" aria-hidden="true">{copy.sea}</text>
              {cfg.lens === 'axarquia-hill' ? (
                <>
                  <circle cx="10" cy="20" r="3.4" class="map-point-stop" />
                  <text x="18" y="24" class="map-label map-lens-label">NERJA</text>
                  <circle cx="0" cy="-22" r="8" class="map-focus-ring" />
                  <circle cx="0" cy="-22" r="4.2" class="map-point-base" />
                  <text x="0" y="-37" class="map-label map-lens-title map-label--mid">FRIGILIANA</text>
                  <text x="0" y="-50" class="map-lens-copy map-label--mid">{copy.base}</text>
                </>
              ) : (
                <>
                  <circle cx="0" cy="-22" r="3.4" class="map-point-stop" />
                  <text x="0" y="-33" class="map-label map-lens-label map-label--mid">FRIGILIANA</text>
                  <circle cx="10" cy="20" r="8" class="map-focus-ring" />
                  <circle cx="10" cy="20" r="4.2" class="map-point-base" />
                  <text x="24" y="14" class="map-label map-lens-title">NERJA</text>
                  <text x="10" y="42" class="map-lens-copy map-lens-copy--sea map-label--mid">{copy.base}</text>
                </>
              )}
            </>
          )}

          {cfg.lens === 'strait' && (
            <>
              <!-- Tarifa: Los Lances running in from the north-west, the town on the point, the Strait below -->
              <g class="map-lens-contours">
                <path d="M-40 -92 C-30 -70 -10 -58 20 -56 C50 -54 72 -60 92 -70" />
                <path d="M-10 -92 C-2 -78 14 -70 34 -70 C56 -70 76 -76 92 -84" />
              </g>
              <path
                d="M-92 -58 C-70 -46 -50 -36 -30 -22 C-12 -10 2 2 12 14 C16 20 18 24 18 28 C22 24 30 12 44 0 C58 -12 76 -22 92 -30 L92 92 L-92 92 Z"
                class="map-lens-sea"
              />
              <path
                d="M-92 -58 C-70 -46 -50 -36 -30 -22 C-12 -10 2 2 12 14 C16 20 18 24 18 28 C22 24 30 12 44 0 C58 -12 76 -22 92 -30"
                class="map-lens-coast"
              />
              <path d="M16 27 L20 27 L22 36 C22 40 16 40 16 36 Z" class="map-lens-islet" />
              <path d="M-92 -88 C-60 -70 -36 -50 -22 -34 C-14 -24 -2 -8 14 12" class="map-lens-route" />
              <path d="M14 12 C24 4 34 -6 46 -18 C60 -32 76 -42 92 -50" class="map-lens-route" />
              <text transform="translate(-46 -8) rotate(34)" class="map-lens-label map-lens-label--muted map-lens-label--sea map-label--mid" aria-hidden="true">LOS LANCES</text>
              <text x="0" y="64" class="map-water-label map-water-label--lens map-water-label--strait map-label--mid" aria-hidden="true">{copy.strait}</text>
              <circle cx="14" cy="12" r="8" class="map-focus-ring" />
              <circle cx="14" cy="12" r="4.2" class="map-point-base" />
              <text x="2" y="17" class="map-label map-lens-title map-lens-title--sea map-label--end">TARIFA</text>
              <text x="0" y="50" class="map-lens-copy map-lens-copy--sea map-label--mid">{copy.base}</text>
            </>
          )}
        </g>
        <circle r={LENS.r} class="map-lens-ring" />
      </g>

      <!-- legend -->
      <g transform={`translate(28 ${H - 30})`} aria-hidden="true">
        <path d="M0 0 H56" class="map-legend-line" />
        <text x="68" y="4" class="map-legend-label">{copy.legend}</text>
      </g>
    </svg>
  </div>
  <figcaption class="am-text-caption mt-3 normal-case tracking-normal text-on-surface-variant">
    {note}
  </figcaption>
</figure>

<style>
  .map-sea,
  .map-lens-sea {
    fill: #dbe7e7;
  }

  .map-land {
    fill: var(--color-surface-container-lowest);
    stroke: color-mix(in srgb, var(--color-on-surface) 34%, transparent);
    stroke-width: 0.9;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .map-land--portugal {
    fill: color-mix(in srgb, var(--color-surface-container-lowest) 88%, var(--color-outline-variant));
  }

  .map-land--neighbour {
    fill: color-mix(in srgb, var(--color-surface-container-lowest) 80%, #dbe7e7);
    stroke: color-mix(in srgb, var(--color-on-surface) 18%, transparent);
  }

  .map-region {
    fill: color-mix(in srgb, var(--color-primary) 9%, transparent);
    stroke: color-mix(in srgb, var(--color-primary) 40%, transparent);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .map-border {
    fill: none;
    stroke: color-mix(in srgb, var(--color-on-surface) 34%, transparent);
    stroke-width: 0.9;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }

  text {
    font-family: var(--font-label);
    paint-order: stroke;
    stroke: var(--color-surface-container-lowest);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .map-wordmark {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 34%, transparent);
    font-weight: 700;
    text-anchor: middle;
  }

  .map-wordmark--country {
    font-size: 34px;
    letter-spacing: 0.42em;
  }

  .map-wordmark--portugal {
    font-size: 15px;
    letter-spacing: 0.36em;
  }

  .map-wordmark--region {
    fill: color-mix(in srgb, var(--color-primary) 62%, transparent);
    font-size: 17px;
    letter-spacing: 0.32em;
  }

  .map-water-label {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 58%, transparent);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-anchor: middle;
    stroke: #dbe7e7;
  }

  .map-water-label--small {
    font-size: 10px;
    letter-spacing: 0.2em;
  }

  .map-water-label--lens {
    font-size: 7px;
    letter-spacing: 0.18em;
  }

  .map-water-label--strait {
    font-size: 6.5px;
    letter-spacing: 0.14em;
  }

  .map-context-label {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 42%, transparent);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-anchor: middle;
    stroke: none;
  }

  .map-context-label--end {
    text-anchor: end;
  }

  .map-label {
    fill: var(--color-on-surface);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .map-label--ref {
    fill: color-mix(in srgb, var(--color-on-surface) 62%, transparent);
    font-size: 10.5px;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .map-label--stop {
    font-size: 11.5px;
  }

  .map-label--mid {
    text-anchor: middle;
  }

  .map-label--end {
    text-anchor: end;
  }

  .map-point-ref {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 62%, transparent);
    stroke: var(--color-surface-container-lowest);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .map-point-stop {
    fill: var(--color-on-surface-variant);
    stroke: var(--color-surface-white);
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
  }

  .map-point-base {
    fill: var(--color-primary);
    stroke: var(--color-surface-white);
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
  }

  .map-focus-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 55%, transparent);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  .map-route-casing {
    fill: none;
    stroke: var(--color-surface-container-lowest);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .map-route,
  .map-legend-line {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 5 3.5;
  }

  .map-leader {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 45%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
  }

  .map-lens-rim {
    fill: var(--color-surface-white);
  }

  .map-lens-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 60%, transparent);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .map-lens-land,
  .map-lens-islet {
    fill: var(--color-surface-container-lowest);
  }

  .map-lens-islet,
  .map-lens-coast {
    stroke: color-mix(in srgb, var(--color-on-surface) 40%, transparent);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .map-lens-coast {
    fill: none;
  }

  .map-lens-contours path {
    fill: none;
    stroke: color-mix(in srgb, var(--color-on-surface) 12%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .map-lens-route {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 4 3;
  }

  .map-lens-road {
    fill: none;
    stroke: color-mix(in srgb, var(--color-on-surface) 28%, transparent);
    stroke-width: 1.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .map-lens-label {
    font-size: 10px;
  }

  .map-lens-label--muted {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 70%, transparent);
    font-size: 7px;
    font-weight: 650;
    letter-spacing: 0.16em;
  }

  .map-lens-title {
    fill: var(--color-primary);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .map-lens-copy {
    fill: var(--color-on-surface-variant);
    font-size: 7.5px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-lens-title--sea,
  .map-lens-copy--sea,
  .map-lens-label--sea {
    stroke: #dbe7e7;
  }

  .map-legend-label {
    fill: color-mix(in srgb, var(--color-on-surface-variant) 80%, transparent);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.1em;
    stroke: #dbe7e7;
  }

  /* narrow screens: the viewBox shrinks to ~360px, so type steps up in map units */
  @media (max-width: 520px) {
    .map-wordmark--country {
      font-size: 44px;
    }

    .map-wordmark--portugal {
      font-size: 20px;
    }

    .map-wordmark--region {
      font-size: 20px;
    }

    .map-water-label {
      font-size: 17px;
    }

    .map-water-label--small {
      font-size: 14px;
    }

    .map-water-label--lens {
      font-size: 9px;
    }

    .map-water-label--strait {
      font-size: 7px;
    }

    .map-context-label {
      font-size: 13px;
    }

    .map-label--ref {
      font-size: 14px;
    }

    .map-label--stop {
      font-size: 16px;
    }

    .map-lens-label {
      font-size: 14px;
    }

    .map-lens-label--muted {
      font-size: 8px;
    }

    .map-lens-title {
      font-size: 16px;
    }

    .map-legend-label {
      font-size: 15px;
    }
  }
