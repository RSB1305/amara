---
import LocationGuideIcon, {
  type LocationGuideIconName
} from './LocationGuideIcon.astro';

interface Props {
  label: string;
  value: string;
  /** Short explanatory line below the value. */
  description?: string;
  /** Alignment hint for stats rows/grids. */
  align?: 'left' | 'center';
  /** Slightly stronger emphasis for key facts. */
  emphasize?: boolean;
  /** Optional semantic symbol from the shared Location guide vocabulary. */
  icon?: LocationGuideIconName;

  /** Back-compat: older prop name used in early drafts. */
  note?: string;
}

const {
  label,
  value,
  description,
  note,
  align = 'left',
  emphasize = false,
  icon
} = Astro.props;
const resolvedDescription = description ?? note;
const isCenter = align === 'center';
---

<article class="min-w-0 px-0 py-0">
  <div class:list={['flex min-w-0 flex-col', isCenter ? 'items-center text-center' : 'items-start text-left']}>
    <div class:list={['flex items-center gap-3 text-primary', isCenter && 'justify-center']}>
      {icon && <LocationGuideIcon name={icon} />}
      <div class:list={['h-px bg-outline-variant/25', icon ? 'w-8' : 'w-10']}></div>
    </div>
    <div class="mt-4 min-w-0 am-text-caption uppercase tracking-[0.18em] text-on-surface-variant/70 [overflow-wrap:anywhere]">
      {label}
    </div>
    <div class:list={['mt-2 min-w-0 hyphens-auto am-text-subtitle tracking-tight text-on-surface [overflow-wrap:anywhere]', emphasize ? 'font-normal' : '']}>
      {value}
    </div>
    {resolvedDescription && (
      <p class="mt-3 min-w-0 max-w-[44ch] hyphens-auto am-text-body leading-relaxed text-on-surface-variant/80 [overflow-wrap:anywhere]">
        {resolvedDescription}
      </p>
    )}
  </div>
</article>
