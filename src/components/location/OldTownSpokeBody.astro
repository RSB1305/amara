---
/**
 * Shared body for the small old-town spokes (Fuente Vieja, Castillo de Lizar, Reales
 * Pósitos, Ermita de Ecce Homo, Callejón del Peñón). Each spoke passes its own copy and
 * SEO; the design vocabulary is identical to the larger spokes (LocationPanoramaHero or a
 * typographic cover when no photograph exists yet, AmaraKeyFigures, three editorial
 * two-column sections, a pull-quote, the sightseeing guest-guide bridge and the editorial
 * close). Keeping it in one component means every small spoke stays visually in step.
 */
import type { ImageMetadata } from 'astro';
import Navigation from '../Navigation.astro';
import AmaraKeyFigures from '../content/AmaraKeyFigures.astro';
import LocationPanoramaHero from './LocationPanoramaHero.astro';
import EditorialClosingCta from '../editorial/EditorialClosingCta.astro';
import ExperienceContextNav from '../experience/ExperienceContextNav.astro';
import GuestGuideBridge from '../experience/GuestGuideBridge.astro';
import LocationAuthorityLayout from '../../layouts/LocationAuthorityLayout.astro';
import type { LabeledLink } from '../../lib/linkResolver';
import { normalizeLanguage } from '../../lib/seo/resolve-seo-head';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../../types/seo';
import type { AmaraPageFamilyId } from '../page-type/pageTypeContract';

type LocalizedRow = { readonly [K in AmaraLanguage]: string };

interface SpokeCopy {
  hero: {
    kicker: LocalizedRow;
    title: LocalizedRow;
    subtitle: LocalizedRow;
    paragraphs: readonly LocalizedRow[];
  };
  keyFigures: {
    figures: readonly { value: string; label: LocalizedRow }[];
    note: LocalizedRow;
  };
  sections: readonly { eyebrow: LocalizedRow; title: LocalizedRow; text: LocalizedRow }[];
  pullQuote: LocalizedRow;
  closing: {
    title: LocalizedRow;
    lead: LocalizedRow;
    oldTownCta: LocalizedRow;
    availabilityCta: LocalizedRow;
  };
}

interface Props {
  lang?: string;
  pageFamily: AmaraPageFamilyId;
  dataPage: string;
  copy: SpokeCopy;
  seo: AmaraAuthoringSeo;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  heroFocalPoint?: string;
}

const {
  lang = 'es',
  pageFamily,
  dataPage,
  copy,
  seo,
  heroImage,
  heroAlt = '',
  heroFocalPoint = '50% 50%'
} = Astro.props;

const currentLang = normalizeLanguage(lang as AmaraLanguage);

function t(row: LocalizedRow): string {
  return row[currentLang] ?? row.en;
}

const footerHighlights: LabeledLink[] = [
  {
    token: 'frigiliana_old_town',
    label: t({ en: 'Old town & history', de: 'Altstadt & Geschichte', es: 'Casco antiguo e historia', nl: 'Oude kern & geschiedenis', sv: 'Gamla stan & historia' })
  }
];

const keyFigures = copy.keyFigures.figures.map((figure) => ({ value: figure.value, label: t(figure.label) }));
const keyFiguresNote = t(copy.keyFigures.note);
const sections = copy.sections.map((section) => ({
  eyebrow: t(section.eyebrow),
  title: t(section.title),
  text: t(section.text)
}));
const sectionBg = ['bg-surface-white', 'bg-surface', 'bg-surface-white'];
---

<LocationAuthorityLayout
  pageFamily={pageFamily}
  seo={seo}
  pageLang={currentLang}
  showContextNavigation={false}
  footerHighlights={footerHighlights}
>
  <Navigation
    slot="navigation"
    contextDestination="frigiliana"
    currentLang={currentLang}
    languageToken="frigiliana_old_town"
  >
    <ExperienceContextNav slot="context-navigation" currentId="oldTown" destination="frigiliana" lang={currentLang} currentSpokeLabel={t(copy.hero.title)} />
  </Navigation>

  <article class="overflow-x-clip bg-surface" data-am-page={dataPage} data-am-family="location" data-am-role="spoke">
    {heroImage ? (
      <LocationPanoramaHero
        eyebrow={t(copy.hero.kicker)}
        title={t(copy.hero.title)}
        subtitle={t(copy.hero.subtitle)}
        paragraphs={[t(copy.hero.paragraphs[0])]}
        imageSrc={heroImage}
        imageAlt={heroAlt}
        focalPoint={heroFocalPoint}
        role="spoke"
        topic="old-town"
      />
    ) : (
      <header class="am-spoke-cover">
        <div class="am-spoke-cover__inner mx-auto max-w-screen-2xl px-6 md:px-12">
          <p class="am-spoke-cover__kicker">{t(copy.hero.kicker)}</p>
          <h1 class="am-spoke-cover__title">{t(copy.hero.title)}</h1>
          <p class="am-spoke-cover__sub">{t(copy.hero.subtitle)}</p>
          <p class="am-spoke-cover__lead">{t(copy.hero.paragraphs[0])}</p>
        </div>
      </header>
    )}

    <section class="bg-surface px-6 pb-16 pt-12 md:px-12 md:pb-20" aria-label={keyFigures.map((figure) => figure.label).join(' · ')}>
      <div class="mx-auto max-w-screen-2xl">
        <AmaraKeyFigures figures={keyFigures} note={keyFiguresNote} />
      </div>
    </section>

    {sections.map((section, index) => (
      <section class={`scroll-mt-28 ${sectionBg[index % sectionBg.length]} px-6 py-20 md:px-12 md:py-28`}>
        <div class="mx-auto max-w-screen-2xl">
          <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-4">
              <p class="am-text-eyebrow text-primary">{section.eyebrow}</p>
              <h2 class="am-text-title mt-5 text-balance text-on-surface">{section.title}</h2>
            </div>
            <div class="lg:col-span-7 lg:col-start-6">
              <p class="am-text-body leading-relaxed text-on-surface-variant">{section.text}</p>
            </div>
          </div>
        </div>
        {index === 0 && (
          <div class="mx-auto mt-20 max-w-4xl text-center md:mt-28">
            <blockquote class="am-text-display italic text-balance text-on-surface">{t(copy.pullQuote)}</blockquote>
          </div>
        )}
      </section>
    ))}

    <GuestGuideBridge lang={currentLang} destination="frigiliana" guideSlugs={['frigiliana-guest-sightseeing']} />

    <section class="max-w-screen-2xl mx-auto px-6 pt-20 pb-24 md:px-12">
      <EditorialClosingCta
        title={t(copy.closing.title)}
        lead={t(copy.closing.lead)}
        lang={currentLang}
        links={[
          { token: 'frigiliana_old_town', label: t(copy.closing.oldTownCta), style: 'primary' },
          { token: 'book', label: t(copy.closing.availabilityCta), style: 'secondary' }
        ]}
      />
    </section>
  </article>
</LocationAuthorityLayout>

<style>
  /* Typographic cover for spokes without a photograph yet (brand-colour band instead of a
     panorama hero). When a photo arrives, the page passes heroImage and this is unused. */
  .am-spoke-cover {
    background: var(--color-primary);
    color: var(--color-surface-white);
  }

  .am-spoke-cover__inner {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
  }

  .am-spoke-cover__kicker {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-surface-white) 82%, transparent);
    margin: 0 0 1.4rem;
  }

  .am-spoke-cover__title {
    font-family: var(--font-headline);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .am-spoke-cover__sub {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: clamp(1.15rem, 2.4vw, 1.75rem);
    margin: 1.25rem 0 0;
    max-width: 40ch;
    color: color-mix(in srgb, var(--color-surface-white) 92%, transparent);
  }

  .am-spoke-cover__lead {
    font-family: var(--font-body, inherit);
    font-size: 1.02rem;
    line-height: 1.7;
    margin: 2rem 0 0;
    max-width: 60ch;
    color: color-mix(in srgb, var(--color-surface-white) 88%, transparent);
  }

  @media (min-width: 768px) {
    .am-spoke-cover__inner {
      padding-top: 7.5rem;
      padding-bottom: 7.5rem;
    }
  }
</style>
