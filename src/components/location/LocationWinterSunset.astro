---
// A small comparison graphic for the winter pages: how much later the sun sets
// on the Costa del Sol than in the reader's home city on the shortest day of the
// year (21 December). Spain keeps Central European Time despite sitting far west,
// so the afternoon stays light much longer. Times are exact for that one date.
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
  placeName: string;
  placeSunset: string; // "HH:MM"
  cityName: string;
  citySunset: string; // "HH:MM"
}

const { lang, placeName, placeSunset, cityName, citySunset } = Astro.props;

const toMin = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
};
const placeMin = toMin(placeSunset);
const cityMin = toMin(citySunset);
const lo = Math.min(placeMin, cityMin) - 45;
const hi = Math.max(placeMin, cityMin) + 45;
const pos = (value: number) => ((value - lo) / (hi - lo)) * 100;
const deltaMin = Math.round((placeMin - cityMin) / 5) * 5;
const dh = Math.floor(deltaMin / 60);
const dm = deltaMin % 60;

type Copy = {
  eyebrow: string;
  title: string;
  intro: string;
  more: string;
  duration: (h: number, m: number) => string;
  takeaway: (place: string, ps: string, city: string, cs: string, dur: string) => string;
};

const copyByLang: Record<AmaraLanguage, Copy> = {
  de: {
    eyebrow: 'Längere Nachmittage',
    title: 'Die Sonne geht hier später unter',
    intro:
      'Am kürzesten Tag des Jahres, dem 21. Dezember, bleibt es an der Costa del Sol deutlich länger hell als im Norden — Spanien liegt weit westlich, hält aber mitteleuropäische Zeit.',
    more: 'mehr Tageslicht',
    duration: (h, m) => (h > 0 ? (m > 0 ? `${h} Std ${m} Min` : `${h} Stunden`) : `${m} Minuten`),
    takeaway: (place, ps, city, cs, dur) =>
      `Am 21. Dezember geht die Sonne in ${place} erst um ${ps} Uhr unter — in ${city} schon um ${cs} Uhr. Das sind rund ${dur} mehr Nachmittag.`
  },
  en: {
    eyebrow: 'Longer afternoons',
    title: 'The sun sets later here',
    intro:
      'On the shortest day of the year, 21 December, the Costa del Sol stays light far longer than the north — Spain lies far west but keeps Central European Time.',
    more: 'more daylight',
    duration: (h, m) => (h > 0 ? (m > 0 ? `${h} h ${m} min` : `${h} h`) : `${m} min`),
    takeaway: (place, ps, city, cs, dur) =>
      `On 21 December the sun sets in ${place} only at ${ps} — in ${city} already at ${cs}. That is about ${dur} more afternoon.`
  },
  es: {
    eyebrow: 'Tardes más largas',
    title: 'Aquí el sol se pone más tarde',
    intro:
      'En el día más corto del año, el 21 de diciembre, en la Costa del Sol hay luz mucho más tiempo que en el norte: España está muy al oeste pero mantiene el horario de Europa Central.',
    more: 'más luz',
    duration: (h, m) => (h > 0 ? (m > 0 ? `${h} h ${m} min` : `${h} h`) : `${m} min`),
    takeaway: (place, ps, city, cs, dur) =>
      `El 21 de diciembre el sol se pone en ${place} a las ${ps} — en ${city} ya a las ${cs}. Son unas ${dur} más de tarde.`
  },
  nl: {
    eyebrow: 'Langere middagen',
    title: 'Hier gaat de zon later onder',
    intro:
      'Op de kortste dag van het jaar, 21 december, blijft het aan de Costa del Sol veel langer licht dan in het noorden — Spanje ligt ver westelijk maar houdt Midden-Europese tijd aan.',
    more: 'meer daglicht',
    duration: (h, m) => (h > 0 ? (m > 0 ? `${h} u ${m} min` : `${h} u`) : `${m} min`),
    takeaway: (place, ps, city, cs, dur) =>
      `Op 21 december gaat de zon in ${place} pas om ${ps} onder — in ${city} al om ${cs}. Dat is ongeveer ${dur} meer middag.`
  },
  sv: {
    eyebrow: 'Längre eftermiddagar',
    title: 'Solen går ner senare här',
    intro:
      'På årets kortaste dag, den 21 december, är det ljust mycket längre på Costa del Sol än i norr — Spanien ligger långt västerut men håller centraleuropeisk tid.',
    more: 'mer dagsljus',
    duration: (h, m) => (h > 0 ? (m > 0 ? `${h} tim ${m} min` : `${h} tim`) : `${m} min`),
    takeaway: (place, ps, city, cs, dur) =>
      `Den 21 december går solen ner i ${place} först ${ps} — i ${city} redan ${cs}. Det är ungefär ${dur} mer eftermiddag.`
  }
};

const copy = copyByLang[lang];
const durationLabel = copy.duration(dh, dm);
const takeaway = copy.takeaway(placeName, placeSunset, cityName, citySunset, durationLabel);
---

<section class="bg-surface" data-am-winter-sunset>
  <div class="mx-auto max-w-screen-2xl px-6 py-16 md:px-12 md:py-20">
    <header class="grid gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="am-text-caption am-text-caption--upper am-text-caption--wide text-primary">{copy.eyebrow}</p>
        <h2 class="am-text-title mt-5 text-balance italic text-on-surface">{copy.title}</h2>
      </div>
      <p class="am-text-body max-w-3xl leading-relaxed text-on-surface-variant lg:col-span-7 lg:col-start-6">{copy.intro}</p>
    </header>

    <div class="mt-14 max-w-3xl">
      <div class="relative h-3 overflow-hidden rounded-full bg-outline-variant/20">
        <div class="absolute inset-y-0 bg-primary/25" style={`left:${pos(cityMin)}%; right:${100 - pos(placeMin)}%;`}></div>
        <div class="absolute inset-y-0 w-0.5 bg-on-surface/50" style={`left:calc(${pos(cityMin)}% - 1px);`}></div>
        <div class="absolute inset-y-0 w-0.5 bg-primary" style={`left:calc(${pos(placeMin)}% - 1px);`}></div>
      </div>
      <div class="mt-4 flex items-start justify-between gap-4">
        <div>
          <p class="tabular-nums am-text-subtitle leading-none text-on-surface-variant">{citySunset}</p>
          <p class="mt-1 am-text-label am-text-label--sm text-muted">{cityName}</p>
        </div>
        <p class="mt-1 text-center am-text-label am-text-label--sm text-primary">{copy.more}</p>
        <div class="text-right">
          <p class="tabular-nums am-text-subtitle leading-none text-on-surface">{placeSunset}</p>
          <p class="mt-1 am-text-label am-text-label--sm text-primary">{placeName}</p>
        </div>
      </div>
      <p class="mt-10 am-text-subtitle leading-snug text-balance text-on-surface">{takeaway}</p>
    </div>
  </div>
</section>
