---
/**
 * AMARA homepage composition.
 *
 * Architectural intent:
 * The home is the brand's front door and must do four things in order: say what
 * AMARA is, prove it, weight the three locations honestly, and hand off. Four of
 * the six stays are in Frigiliana while most arriving interest names Nerja, so
 * the places band and the bridge band carry that asymmetry explicitly rather
 * than leaving the two locations as parallel silos.
 *
 * The collection is deliberately a comparable grid, not a stack of full-width
 * blocks: choosing between six stays needs them side by side, and the full
 * storytelling belongs on each rental page.
 */
import InlineEmphasis from '../text/InlineEmphasis.astro';

export interface CinematicApartment {
  id: string;
  name: string;
  subtitle: string;
  city: string;
  interiorFact: string | null;
  terraceFact: string | null;
  viewNote: string;
  price: string;
  desc: string;
  imgAlt: string;
  img: string;
  imgWidth: number;
  imgHeight: number;
  imgSrcSet?: string;
  imgSizes?: string;
  exploreHref: string;
  exploreLabel: string;
}

export interface CinematicPlace {
  id: string;
  city: string;
  countLabel: string;
  character: string;
  travel: string;
  href: string;
  ctaLabel: string;
}

interface Props {
  heroImageSrc: string;
  heroImageSrcSet?: string;
  heroImageSizes?: string;
  heroImageWidth: number;
  heroImageHeight: number;
  heroImageAlt: string;
  heroKicker: string;
  heroLead: string;
  heroProof: string[];
  scrollHint: string;
  welcomeMessage: string;
  hostAvatarSrc: string;
  hostAvatarSrcSet?: string;
  hostAvatarSizes?: string;
  hostAvatarAlt: string;
  hostAboutHref: string | null;
  hostAboutLabel: string;
  philosophyHeadlinePart1: string;
  philosophyHeadlineAccent: string;
  philosophyLabel: string;
  philosophyP1: string;
  philosophyP2: string;
  statReviewsValue: string;
  statRatingValue: string;
  statReviewsLabel: string;
  statRatingLabel: string;
  placesEyebrow: string;
  placesTitle: string;
  places: CinematicPlace[];
  bridgeEyebrow: string;
  bridgeTitle: string;
  bridgeBody: string;
  bridgeQuote: string;
  bridgeQuoteAttribution: string;
  bridgeHref: string | null;
  bridgeCtaLabel: string;
  collectionEyebrow: string;
  collectionTitle: string;
  apartments: CinematicApartment[];
  collectionCtaHref: string | null;
  collectionCtaLabel: string;
  trustBgSrc: string;
  trustBgSrcSet?: string;
  trustBgSizes?: string;
  trustImageWidth: number;
  trustImageHeight: number;
  trustQuote: string;
  trustQuoteAttribution: string;
  trustChips: string[];
  trustCta: string;
  trustReviewsHref: string | null;
  trustCtaPrimary: string;
  trustBookingHref: string | null;
  /** Present only where the shown citation is a translation of its original. */
  quoteTranslationNote: string | null;
  directEyebrow: string;
  directTitle: string;
  directBenefits: string[];
  cancellationBadge: string;
  cancellationDetail: string;
  directHref: string | null;
  directCtaLabel: string;
  honeymoonEyebrow: string;
  honeymoonTitle: string;
  honeymoonHref: string | null;
  honeymoonCtaLabel: string;
}

const {
  heroImageSrc,
  heroImageSrcSet,
  heroImageSizes,
  heroImageWidth,
  heroImageHeight,
  heroImageAlt,
  heroKicker,
  heroLead,
  heroProof,
  scrollHint,
  welcomeMessage,
  hostAvatarSrc,
  hostAvatarSrcSet,
  hostAvatarSizes,
  hostAvatarAlt,
  hostAboutHref,
  hostAboutLabel,
  philosophyHeadlinePart1,
  philosophyHeadlineAccent,
  philosophyLabel,
  philosophyP1,
  philosophyP2,
  statReviewsValue,
  statRatingValue,
  statReviewsLabel,
  statRatingLabel,
  placesEyebrow,
  placesTitle,
  places,
  bridgeEyebrow,
  bridgeTitle,
  bridgeBody,
  bridgeQuote,
  bridgeQuoteAttribution,
  bridgeHref,
  bridgeCtaLabel,
  collectionEyebrow,
  collectionTitle,
  apartments,
  collectionCtaHref,
  collectionCtaLabel,
  trustBgSrc,
  trustBgSrcSet,
  trustBgSizes,
  trustImageWidth,
  trustImageHeight,
  trustQuote,
  trustQuoteAttribution,
  trustChips,
  trustCta,
  trustReviewsHref,
  trustCtaPrimary,
  trustBookingHref,
  quoteTranslationNote,
  directEyebrow,
  directTitle,
  directBenefits,
  cancellationBadge,
  cancellationDetail,
  directHref,
  directCtaLabel,
  honeymoonEyebrow,
  honeymoonTitle,
  honeymoonHref,
  honeymoonCtaLabel,
} = Astro.props;

/** Frigiliana holds four of the six stays and leads the places band. */
const [leadPlace, ...otherPlaces] = places;
---

<div class="bg-surface relative min-h-screen selection:bg-primary-fixed-dim selection:text-on-primary-fixed">
  <section
    class="relative z-[2] h-screen min-h-[28rem] w-full overflow-hidden bg-inverse-surface supports-[height:100svh]:h-[100svh]"
  >
    <div class="absolute inset-0 h-full w-full">
      <img
        src={heroImageSrc}
        srcset={heroImageSrcSet}
        sizes={heroImageSizes}
        alt={heroImageAlt}
        class="h-full w-full object-cover"
        width={heroImageWidth}
        height={heroImageHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-inverse-surface/25 via-transparent to-inverse-surface/80"></div>
      <div class="absolute left-1/2 top-1/2 h-[58%] w-[min(92%,52rem)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-inverse-surface/45 blur-3xl"></div>
    </div>

    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center px-6 pb-12 pt-28 text-center text-inverted-on-surface md:pb-16 md:pt-32">
      <span class="mb-6 am-text-section-caption text-inverted-on-surface/90">
        {heroKicker}
      </span>
      <h1 class="mb-8 am-text-display">
        AMARA<span class="sr-only"> — {heroKicker}</span>
      </h1>
      <p class="max-w-xl am-text-body italic text-inverted-on-surface/90"><InlineEmphasis text={heroLead} /></p>

      {trustBookingHref && (
        <a href={trustBookingHref} class="am-btn am-btn--primary am-btn--inverse mt-8">
          {trustCtaPrimary}
        </a>
      )}

      {
        heroProof.length > 0 && (
          <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 am-text-caption text-inverted-on-surface/80">
            {heroProof.map((proof) => (
              <li>{proof}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="absolute bottom-12 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-inverted-on-surface/80 sm:flex">
      <span class="am-text-caption uppercase tracking-widest">{scrollHint}</span>
      <div class="h-12 w-px bg-gradient-to-b from-inverted-on-surface-muted to-transparent"></div>
    </div>
  </section>

  <div
    class="relative z-[2] flex flex-col items-center gap-5 bg-surface-white px-6 py-16 text-center md:px-12 md:py-24"
    data-am-home-welcome
  >
    <p lang="es" class="am-text-title text-balance italic text-primary">
      {welcomeMessage}<span aria-hidden="true"> ❤︎</span>
    </p>
    {
      hostAboutHref && (
        <a href={hostAboutHref} class="group inline-flex items-center gap-3 text-on-surface-variant transition-colors hover:text-primary">
          <img
            src={hostAvatarSrc}
            srcset={hostAvatarSrcSet}
            sizes={hostAvatarSizes}
            alt={hostAvatarAlt}
            class="h-10 w-10 rounded-full object-cover"
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          />
          <span class="am-text-caption uppercase tracking-widest">{hostAboutLabel}</span>
        </a>
      )
    }
  </div>

  <section class="relative z-[2] mx-auto max-w-screen-xl px-6 py-24 md:px-12 md:py-32">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <div>
          <h2 class="mb-8 am-text-title text-on-surface">
            {philosophyHeadlinePart1}{' '}
            <span class="italic text-primary">{philosophyHeadlineAccent}</span>
          </h2>
        </div>
        <div>
          <div class="mb-8 flex items-center gap-4">
            <div class="h-px w-12 bg-outline-variant"></div>
            <span class="am-text-caption uppercase tracking-widest text-on-surface-variant">{philosophyLabel}</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-8 am-text-body text-on-surface-variant lg:col-span-6 lg:col-start-7">
        <div><p><InlineEmphasis text={philosophyP1} /></p></div>
        <div><p><InlineEmphasis text={philosophyP2} /></p></div>
        <div>
          <div class="flex gap-8 border-t border-outline-variant/30 pt-8">
            <div>
              <span class="mb-1 block am-text-subtitle text-on-surface">{statReviewsValue}</span>
              <span class="am-text-caption uppercase tracking-wider text-on-surface-variant">{statReviewsLabel}</span>
            </div>
            <div>
              <span class="mb-1 block am-text-subtitle text-on-surface">{statRatingValue}</span>
              <span class="am-text-caption uppercase tracking-wider text-on-surface-variant">{statRatingLabel}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    leadPlace && (
      <section
        id="places"
        class="relative z-[2] scroll-mt-[104px] border-y border-outline-variant/10 bg-surface-container-low py-20 md:py-28 lg:scroll-mt-[136px]"
      >
        <div class="mx-auto max-w-screen-xl px-6 md:px-12">
          <div class="mb-14 max-w-2xl">
            <span class="mb-4 block am-text-caption uppercase tracking-widest text-primary">{placesEyebrow}</span>
            <h2 class="am-text-title text-on-surface">{placesTitle}</h2>
          </div>

          <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
            <article class="flex flex-col justify-between gap-6 border-t-2 border-primary pt-6">
              <div>
                <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="am-text-subtitle text-on-surface">{leadPlace.city}</h3>
                  <span class="am-text-caption uppercase tracking-widest text-primary">{leadPlace.countLabel}</span>
                </div>
                <p class="mb-4 am-text-body text-on-surface-variant">{leadPlace.character}</p>
                <p class="am-text-caption text-on-surface-variant">{leadPlace.travel}</p>
              </div>
              <a href={leadPlace.href} class="am-cta-link am-cta-link--accent self-start">
                {leadPlace.ctaLabel}
              </a>
            </article>

            <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-1">
              {otherPlaces.map((place) => (
                <article class="flex flex-col justify-between gap-4 border-t border-outline-variant/40 pt-6">
                  <div>
                    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                      <h3 class="am-text-subtitle text-on-surface">{place.city}</h3>
                      <span class="am-text-caption uppercase tracking-widest text-on-surface-variant">{place.countLabel}</span>
                    </div>
                    <p class="mb-4 am-text-body text-on-surface-variant">{place.character}</p>
                    <p class="am-text-caption text-on-surface-variant">{place.travel}</p>
                  </div>
                  <a href={place.href} class="am-cta-link self-start">
                    {place.ctaLabel}
                  </a>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="relative z-[2] bg-surface py-20 md:py-28">
    <div class="mx-auto grid max-w-screen-xl gap-12 px-6 md:px-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start">
      <div>
        <span class="mb-4 block am-text-caption uppercase tracking-widest text-primary">{bridgeEyebrow}</span>
        <h2 class="mb-6 am-text-title text-on-surface">{bridgeTitle}</h2>
        <p class="am-text-body text-on-surface-variant">{bridgeBody}</p>
        {
          bridgeHref && (
            <a href={bridgeHref} class="am-cta-link am-cta-link--accent mt-8 inline-flex">
              {bridgeCtaLabel}
            </a>
          )
        }
      </div>

      <figure class="border-l-2 border-primary pl-6 md:pl-8">
        <blockquote class="am-text-body italic text-on-surface">
          <span aria-hidden="true">&ldquo;</span>{bridgeQuote}<span aria-hidden="true">&rdquo;</span>
        </blockquote>
        <figcaption class="mt-4 am-text-caption uppercase tracking-widest text-on-surface-variant">
          {bridgeQuoteAttribution}
        </figcaption>
        {
          quoteTranslationNote && (
            <p class="mt-2 am-text-caption text-on-surface-variant">{quoteTranslationNote}</p>
          )
        }
      </figure>
    </div>
  </section>

  <section class="relative z-[2] border-y border-outline-variant/10 bg-surface-container-low py-20 md:py-28">
    <div class="mx-auto max-w-screen-2xl px-6 md:px-12">
      <div class="mb-14 text-center">
        <span class="mb-4 block am-text-caption uppercase tracking-widest text-primary">{collectionEyebrow}</span>
        <h2 class="am-text-title text-on-surface">{collectionTitle}</h2>
      </div>

      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          apartments.map((apt) => (
            <article class="group flex flex-col">
              <div class="overflow-hidden">
                <img
                  src={apt.img}
                  srcset={apt.imgSrcSet}
                  sizes={apt.imgSizes}
                  alt={apt.imgAlt}
                  class="aspect-[3/2] w-full object-cover sm:aspect-[4/5] transition-transform duration-[1500ms] ease-out motion-safe:group-hover:scale-[1.03]"
                  width={apt.imgWidth}
                  height={apt.imgHeight}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="mt-6 flex flex-1 flex-col">
                <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="am-text-caption uppercase tracking-widest text-on-surface-variant">{apt.city}</span>
                  <span class="am-text-subtitle text-primary">{apt.price}</span>
                </div>

                <h3 class="mb-1 am-text-subtitle text-on-surface">{apt.name}</h3>
                <p class="mb-4 am-text-caption italic text-primary">{apt.subtitle}</p>

                <ul class="mb-3 flex flex-wrap gap-x-4 gap-y-1 am-text-caption text-on-surface-variant">
                  {apt.interiorFact && <li>{apt.interiorFact}</li>}
                  {apt.terraceFact && <li>{apt.terraceFact}</li>}
                </ul>
                <p class="mb-4 am-text-caption text-on-surface-variant">{apt.viewNote}</p>

                <p class="mb-6 am-text-body text-on-surface-variant"><InlineEmphasis text={apt.desc} /></p>

                <a href={apt.exploreHref} class="am-cta-link am-cta-link--accent mt-auto self-start">
                  {apt.exploreLabel}
                </a>
              </div>
            </article>
          ))
        }
      </div>

      {
        collectionCtaHref && (
          <div class="mt-16 text-center">
            <a href={collectionCtaHref} class="am-btn am-btn--secondary">
              {collectionCtaLabel}
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="relative z-[2] overflow-hidden bg-inverse-surface py-24 text-inverted-on-surface md:py-32">
    <div class="pointer-events-none absolute left-0 top-0 h-full w-full opacity-10">
      <img
        src={trustBgSrc}
        srcset={trustBgSrcSet}
        sizes={trustBgSizes}
        alt=""
        class="h-full w-full object-cover grayscale"
        width={trustImageWidth}
        height={trustImageHeight}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="relative z-10 mx-auto max-w-screen-xl px-6 text-center md:px-12">
      <span class="am-gold mb-8 block am-text-subtitle" aria-hidden="true">★★★★★</span>

      <figure>
        <blockquote class="mx-auto mb-6 max-w-4xl am-text-title text-inverted-on-surface">
          <span aria-hidden="true">&ldquo;</span>{trustQuote}<span aria-hidden="true">&rdquo;</span>
        </blockquote>
        <figcaption class="am-text-caption uppercase tracking-widest text-inverted-on-surface/80">
          {trustQuoteAttribution}
        </figcaption>
        {
          quoteTranslationNote && (
            <p class="mt-2 am-text-caption text-inverted-on-surface/70">{quoteTranslationNote}</p>
          )
        }
      </figure>

      <div class="mb-12 mt-12 flex flex-wrap justify-center gap-4 md:gap-6">
        {
          trustChips.map((feature) => (
            <span class="rounded-full border border-inverted-on-surface-muted px-6 py-2 am-text-caption normal-case tracking-normal text-inverted-on-surface">
              {feature}
            </span>
          ))
        }
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        {
          trustReviewsHref && (
            <a href={trustReviewsHref} class="am-btn am-btn--secondary am-btn--inverse">
              {trustCta}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="relative z-[2] bg-surface py-20 md:py-28">
    <div class="mx-auto grid max-w-screen-xl gap-12 px-6 md:px-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center">
      <div>
        <span class="mb-4 block am-text-caption uppercase tracking-widest text-primary">{directEyebrow}</span>
        <h2 class="mb-6 am-text-title text-on-surface">{directTitle}</h2>
        <ul class="flex flex-col gap-3 am-text-body text-on-surface-variant">
          {directBenefits.map((benefit) => (
            <li class="flex gap-3">
              <span class="mt-[0.6em] h-px w-4 shrink-0 bg-primary" aria-hidden="true"></span>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="border border-outline-variant/40 p-8 md:p-10">
        <p class="mb-3 am-text-subtitle text-on-surface">{cancellationBadge}</p>
        <p class="mb-8 am-text-body text-on-surface-variant">{cancellationDetail}</p>

        <div class="flex flex-wrap gap-4">
          {
            trustBookingHref && (
              <a href={trustBookingHref} class="am-btn am-btn--primary">
                {trustCtaPrimary}
              </a>
            )
          }
          {
            directHref && (
              <a href={directHref} class="am-cta-link self-center">
                {directCtaLabel}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    honeymoonHref && (
      <section class="relative z-[2] border-t border-outline-variant/10 bg-surface-container-low py-16 md:py-20">
        <div class="mx-auto flex max-w-screen-xl flex-col items-start gap-6 px-6 md:flex-row md:items-center md:justify-between md:px-12">
          <div>
            <span class="mb-3 block am-text-caption uppercase tracking-widest text-primary">{honeymoonEyebrow}</span>
            <h2 class="max-w-xl am-text-subtitle text-on-surface">{honeymoonTitle}</h2>
          </div>
          <a href={honeymoonHref} class="am-cta-link am-cta-link--accent shrink-0">
            {honeymoonCtaLabel}
          </a>
        </div>
      </section>
    )
  }
</div>
