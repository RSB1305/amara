---
import type { HTMLAttributes } from 'astro/types';

export type AmaraActionButtonVariant = 'primary' | 'secondary';

interface Props extends Omit<HTMLAttributes<'button'>, 'class' | 'class:list' | 'type'> {
  variant: AmaraActionButtonVariant;
  type?: 'button' | 'submit' | 'reset';
  inverse?: boolean;
  /** Disables the control and exposes its pending state to assistive technology. */
  loading?: boolean;
  class?: string;
}

const {
  variant,
  type = 'button',
  inverse = false,
  loading = false,
  disabled = false,
  'aria-busy': ariaBusy,
  class: className,
  ...attributes
} = Astro.props;
---

<button
  {...attributes}
  type={type}
  disabled={disabled || loading}
  aria-busy={loading ? 'true' : ariaBusy}
  class:list={[
    'am-btn',
    `am-btn--${variant}`,
    { 'am-btn--inverse': inverse, 'am-is-loading': loading },
    className
  ]}
>
  <slot />
</button>
