---
// src/components/Hero.astro
/**
 * AMARA v3 Hero Authority
 * Regel: Absolut rahmenlos. Kein bg-container, kein Shadow, keine Card-Optik.
 */
import type { ImageMetadata } from 'astro';
import AmaraImage from './AmaraImage.astro';

interface Props {
  imageSrc: ImageMetadata | string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  imageSizes?: string;
}

const {
  imageSrc,
  imageAlt,
  imageWidth = 1080,
  imageSizes = '(max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) 60vw, 40vw'
} = Astro.props;
---
<section class="max-w-screen-2xl mx-auto px-12 mb-32 pt-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-center">
    <div class="md:col-span-7">
      <slot />
    </div>

    <div class="md:col-span-5">
      <AmaraImage
        src={imageSrc}
        alt={imageAlt}
        profile="hero"
        width={imageWidth}
        widths={[480, 640, 800, imageWidth]}
        sizes={imageSizes}
        class="w-full h-auto aspect-[3/4] object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
