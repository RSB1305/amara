---
interface Props {
  family: string;
  dataLang?: string;
  documentVersion?: string;
  publishedAt?: string;
  flush?: boolean;
  whiteCanvas?: boolean;
  class?: string;
}

const {
  family,
  dataLang,
  documentVersion,
  publishedAt,
  flush = false,
  whiteCanvas = false,
  class: className
} = Astro.props;
---

<main
  id="am-main-content"
  tabindex="-1"
  class:list={[
    'am-page-shell',
    {
      'am-page-shell--flush': flush,
      'am-page-shell--white-canvas': whiteCanvas
    },
    className
  ]}
  data-am-page={family}
  data-lang={dataLang}
  data-document-version={documentVersion}
  data-published-at={publishedAt}
>
  <div class="am-page-shell__frame">
    <slot />
  </div>
</main>
