---
interface Props {
  family: string;
  dataLang?: string;
  class?: string;
}

const { family, dataLang, class: className } = Astro.props;
---

<main
  id="am-main-content"
  tabindex="-1"
  class:list={['am-page-shell', className]}
  data-am-page={family}
  data-lang={dataLang}
>
  <div class="am-page-shell__frame">
    <slot />
  </div>
</main>
