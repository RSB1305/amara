---
import {
  getAmaraSectionAttributes,
  type AmaraSectionFamily,
  type AmaraSectionStatus,
  type AmaraSectionSurface,
  type AmaraSectionVariant
} from './sectionContract';
import { getPageEndAttributes, type AmaraPageEndFamily, type AmaraPageEndRole } from '../page-end/pageEndContract';

interface Props {
  id?: string;
  labelledby?: string;
  variant?: AmaraSectionVariant;
  surface?: AmaraSectionSurface;
  family?: AmaraSectionFamily;
  status?: AmaraSectionStatus;
  divider?: boolean;
  dataComponent?: string;
  class?: string;
  pageEndRole?: AmaraPageEndRole;
  pageEndFamily?: AmaraPageEndFamily;
  [attribute: `data-am-${string}`]: string | undefined;
}

const {
  id,
  labelledby,
  variant = 'default',
  surface = 'plain',
  family = 'shared',
  status = 'canonical',
  divider = true,
  dataComponent,
  class: className,
  pageEndRole,
  pageEndFamily,
  ...consumerAttributes
} = Astro.props;
const sectionAttributes = getAmaraSectionAttributes({ variant, surface, family, status });
---

<section
  {...sectionAttributes}
  id={id}
  class:list={[
    'am-page-section',
    `am-page-section--${variant}`,
    `am-page-section--surface-${surface}`,
    { 'am-page-section--divided': divider },
    className
  ]}
  aria-labelledby={labelledby}
  data-am-component={dataComponent}
  {...(pageEndRole && pageEndFamily ? getPageEndAttributes(pageEndRole, pageEndFamily) : {})}
  {...consumerAttributes}
>
  <slot />
</section>
