  }
} as const;

const labels = copy[lang];
---

<section
  id={widgetId}
  class="bg-surface px-6 py-16 md:px-12 md:py-20"
  data-tarifa-wind-briefing
  data-state="loading"
  aria-live="polite"
  aria-busy="false"
>
  <div class="mx-auto max-w-screen-2xl">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="am-text-eyebrow text-primary">{labels.eyebrow}</p>
        <h2 class="am-text-title mt-5 max-w-xl text-balance text-on-surface">{labels.title}</h2>
        <p class="am-text-body mt-6 max-w-xl leading-relaxed text-on-surface-variant">{labels.intro}</p>
      </div>
      <div class="lg:col-span-7">
        <p data-wind-state class="am-text-label am-text-label--sm text-primary">{labels.loading}</p>
        <div data-wind-grid class="mt-6 grid gap-5 md:grid-cols-2">
          <article class="bg-surface-container-low p-6">
            <h3 class="am-text-subtitle text-on-surface">Los Lances</h3>
            <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{labels.fallbackLos}</p>
          </article>
          <article class="bg-surface-container-low p-6">
            <h3 class="am-text-subtitle text-on-surface">Valdevaqueros</h3>
            <p class="am-text-body mt-4 leading-relaxed text-on-surface-variant">{labels.fallbackValde}</p>
          </article>
        </div>
        <p data-wind-meta class="am-text-caption mt-5 hidden normal-case tracking-normal text-muted"></p>
      </div>
    </div>

    <div class="mt-12 bg-surface-container-low px-6 py-7 md:px-8">
      <h3 class="am-text-subtitle text-on-surface">{labels.safetyTitle}</h3>
      <ul class="mt-5 grid gap-4 md:grid-cols-2">
        {labels.safety.map((item) => <li class="am-text-body leading-relaxed text-on-surface-variant">{item}</li>)}
      </ul>
    </div>

    <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" class="am-inline-link mt-6 inline-flex">
      {labels.attribution} ↗
    </a>
  </div>
</section>

<script is:inline define:vars={{ endpoint, lang, labels, widgetId }}>
  (function () {
    const root = document.getElementById(widgetId);
    if (!root) return;
    const state = root.querySelector('[data-wind-state]');
    const grid = root.querySelector('[data-wind-grid]');
    const meta = root.querySelector('[data-wind-meta]');
    root.setAttribute('aria-busy', 'true');

    function textElement(tag, className, text) {
      const element = document.createElement(tag);
      element.className = className;
      element.textContent = text;
      return element;
    }

    function value(value, suffix) {
      return typeof value === 'number' && Number.isFinite(value) ? value + suffix : '—';
    }

    function dateLabel(date) {
      return new Intl.DateTimeFormat(lang, {
        weekday: 'long', day: 'numeric', month: 'short', timeZone: 'Europe/Madrid'
      }).format(new Date(date + 'T12:00:00+02:00'));
    }

    function metric(label, reading) {
      const row = document.createElement('p');
      row.className = 'am-text-caption normal-case tracking-normal text-on-surface-variant';
      row.append(textElement('span', 'text-muted', label + ': '), document.createTextNode(reading));
      return row;
    }

    function spotCard(spot) {
      const card = document.createElement('article');
      card.className = 'bg-surface-container-low p-6';
      card.append(textElement('h4', 'am-text-subtitle text-on-surface', spot.name));

      const status = labels.statuses[spot.status] || labels.statuses.unknown;
      card.append(textElement('p', 'am-text-label am-text-label--sm mt-3 text-primary', labels.status + ': ' + status));

      if (Array.isArray(spot.warnings)) {
        spot.warnings.forEach(function (warning) {
          if (!labels.warnings[warning]) return;
          card.append(textElement('p', 'am-text-body mt-3 leading-relaxed text-on-surface', labels.warnings[warning]));
        });
      }

      const measurements = document.createElement('div');
      measurements.className = 'mt-5 space-y-2 border-t border-border-subtle pt-4';
      const direction = spot.wind && spot.wind.direction ? spot.wind.direction + ' · ' : '';
      measurements.append(
        metric(labels.wind, direction + value(spot.wind && spot.wind.speedKnots, ' kn')),
        metric(labels.gusts, value(spot.wind && spot.wind.gustsKnots, ' kn')),
        metric(labels.gustOffset, value(spot.wind && spot.wind.gustOffset && spot.wind.gustOffset.knots, ' kn') + ' · ' + value(spot.wind && spot.wind.gustOffset && spot.wind.gustOffset.percent, '%')),
        metric(labels.waves, value(spot.marine && spot.marine.waveHeightMetres, ' m') + ' · ' + labels.period + ' ' + value(spot.marine && spot.marine.wavePeriodSeconds, ' s')),
        metric(labels.swell, value(spot.marine && spot.marine.swellHeightMetres, ' m') + ' · ' + labels.period + ' ' + value(spot.marine && spot.marine.swellPeriodSeconds, ' s'))
      );
      card.append(measurements);

      if (typeof spot.briefing === 'string') {
        card.append(textElement('p', 'am-text-body mt-5 leading-relaxed text-on-surface-variant', spot.briefing));
      }
      return card;
    }

    function renderForecast(forecast) {
      const fragment = document.createDocumentFragment();
      forecast.days.forEach(function (day) {
        const daySection = document.createElement('section');
        daySection.className = 'border-t border-border-subtle pt-6';
        daySection.append(textElement('h3', 'am-text-subtitle text-on-surface', dateLabel(day.date)));
        const spots = document.createElement('div');
        spots.className = 'mt-5 grid gap-5 md:grid-cols-2';
        day.spots.forEach(function (spot) { spots.append(spotCard(spot)); });
        daySection.append(spots);
        fragment.append(daySection);
      });
      grid.replaceChildren(fragment);

      const isStale = forecast.cache && forecast.cache.state === 'stale';
      state.textContent = isStale ? labels.stale : labels.fresh;
      root.dataset.state = isStale ? 'stale' : 'fresh';
      if (forecast.cache && forecast.cache.fetchedAt) {
        const updated = new Intl.DateTimeFormat(lang, {
          day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid'
        }).format(new Date(forecast.cache.fetchedAt));
        meta.textContent = labels.updated + ': ' + updated + ' · ' + labels.model + ': ' + (forecast.source && forecast.source.model ? forecast.source.model : 'best_match');
        meta.classList.remove('hidden');
      }
      root.setAttribute('aria-busy', 'false');
    }

    fetch(endpoint, { method: 'GET', headers: { Accept: 'application/json' } })
      .then(function (response) {
        if (!response.ok) throw new Error('forecast unavailable');
        return response.json();
      })
      .then(function (forecast) {
        if (!forecast || !Array.isArray(forecast.days) || forecast.days.length === 0 || forecast.days.some(function (day) { return !Array.isArray(day.spots) || day.spots.length !== 2; })) {
          throw new Error('forecast malformed');
        }
        renderForecast(forecast);
      })
      .catch(function () {
        state.textContent = labels.unavailable;
        root.dataset.state = 'unavailable';
        root.setAttribute('aria-busy', 'false');
      });
  })();
</script>
