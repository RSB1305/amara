---
interface HeroLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  subtitle?: string;
  lead: string;
  ctaLinks?: HeroLink[];
  ctaVariant?: 'editorial' | 'conversion';
  supportText?: string;
}

const {
  title,
  subtitle,
  lead,
  ctaLinks = [],
  ctaVariant = 'editorial',
  supportText
} = Astro.props;
---

<header class="am-exp-hero">
  {subtitle && (
    <div class="am-exp-hero__meta">
      <span class="am-kicker text-primary">{subtitle}</span>
    </div>
  )}
  <h1 class="am-text-display am-exp-hero__title" set:html={title} />
  <p class="am-text-body am-exp-hero__lead text-subtle">{lead}</p>
  {supportText && <p class="am-text-body am-hero-support italic text-muted">{supportText}</p>}
  {ctaLinks.length > 0 && ctaVariant === 'conversion' && (
    <div class="am-exp-hero__actions">
      {ctaLinks.map((link, index) => (
        <a
          href={link.href}
          class={`am-btn w-full justify-center sm:w-auto ${index === 0 ? 'am-btn--primary' : 'am-btn--secondary'}`}
        >
          {link.label}
        </a>
      ))}
    </div>
  )}
  {ctaLinks.length > 0 && ctaVariant === 'editorial' && (
    <div class="am-cta-group am-cta-group--left mt-8">
      {ctaLinks.map((link) => (
        <a href={link.href} class="am-cta-link">
          {link.label}
        </a>
      ))}
    </div>
  )}
</header>

<style>
  @reference "../../styles/global.css";

  .am-exp-hero {
    padding: clamp(2rem, 4vw, 2.5rem) 0 clamp(4rem, 8vw, 8rem);
  }

  .am-exp-hero__meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .am-exp-hero__title {
    max-width: 12ch;
    margin: 0 0 2.5rem 0;
    text-wrap: balance;
    @apply text-on-surface;
  }

  @media (min-width: 1024px) {
    .am-exp-hero__title {
      max-width: 18ch;
    }
  }

  .am-exp-hero__lead {
    max-width: 35ch;
  }

  .am-hero-support {
    margin-top: 1.5rem;
    max-width: 42ch;
  }

  .am-exp-hero__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .am-exp-hero__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
