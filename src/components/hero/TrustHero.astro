---
import InlineEmphasis from '../text/InlineEmphasis.astro';
import AmaraActionLink from '../actions/AmaraActionLink.astro';

interface HeroLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  titleWidth?: 'default' | 'wide';
  subtitle?: string;
  lead: string;
  ctaLinks?: HeroLink[];
  ctaVariant?: 'editorial' | 'conversion';
  supportText?: string;
  spacing?: 'standalone' | 'section';
}

const {
  title,
  titleWidth = 'default',
  subtitle,
  lead,
  ctaLinks = [],
  ctaVariant = 'editorial',
  supportText,
  spacing = 'standalone'
} = Astro.props;
---

<div class:list={['am-exp-hero', { 'am-exp-hero--section': spacing === 'section' }]}>
  {subtitle && (
    <div class="am-exp-hero__meta">
      <span class="am-text-eyebrow text-primary">{subtitle}</span>
    </div>
  )}
  <h1
    class:list={[
      'am-text-display am-exp-hero__title',
      { 'am-exp-hero__title--wide': titleWidth === 'wide' }
    ]}
    set:html={title}
  />
  <p class="am-text-body am-exp-hero__lead text-subtle"><InlineEmphasis text={lead} /></p>
  {supportText && <p class="am-text-body am-hero-support italic text-muted"><InlineEmphasis text={supportText} /></p>}
  {ctaLinks.length > 0 && ctaVariant === 'conversion' && (
    <div class="am-exp-hero__actions">
      {ctaLinks.map((link, index) => (
        <AmaraActionLink
          href={link.href}
          variant={index === 0 ? 'primary' : 'secondary'}
          class="w-full justify-center sm:w-auto"
        >
          {link.label}
        </AmaraActionLink>
      ))}
    </div>
  )}
  {ctaLinks.length > 0 && ctaVariant === 'editorial' && (
    <div class="am-cta-group am-cta-group--left mt-8">
      {ctaLinks.map((link) => (
        <AmaraActionLink href={link.href} variant="editorial">
          {link.label}
        </AmaraActionLink>
      ))}
    </div>
  )}
</div>

<style>
  @reference "../../styles/global.css";

  .am-exp-hero {
    padding: clamp(2rem, 4vw, 2.5rem) 0 clamp(4rem, 8vw, 8rem);
  }

  .am-exp-hero--section {
    padding: 0;
  }

  .am-exp-hero__meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .am-exp-hero__title {
    max-width: 12ch;
    margin: 0 0 2rem 0;
    text-wrap: balance;
    @apply text-on-surface;
  }

  .am-exp-hero__title.am-exp-hero__title--wide {
    max-width: none;
  }

  @media (min-width: 1024px) {
    .am-exp-hero__title {
      max-width: 18ch;
    }

    .am-exp-hero__title.am-exp-hero__title--wide {
      max-width: none;
    }
  }

  .am-exp-hero__lead {
    max-width: 42rem;
  }

  .am-hero-support {
    margin-top: 1.5rem;
    max-width: 42ch;
  }

  .am-exp-hero__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .am-exp-hero__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
