---
import { resolveLink } from '../lib/linkResolver';
import type { AmaraLanguage } from '../types/seo';

interface Props {
  currentLang: AmaraLanguage;
}

const { currentLang } = Astro.props;

const copy: Record<
  AmaraLanguage,
  { location: string; legal: string; bookingTerms: string }
> = {
  en: {
    location: 'Frigiliana, Malaga · Spain',
    legal: 'Legal Notice & Privacy',
    bookingTerms: 'Booking Terms'
  },
  de: {
    location: 'Frigiliana, Málaga · Spanien',
    legal: 'Impressum & Datenschutz',
    bookingTerms: 'Buchungsbedingungen'
  },
  es: {
    location: 'Frigiliana, Málaga · España',
    legal: 'Aviso legal y privacidad',
    bookingTerms: 'Condiciones de reserva'
  },
  nl: {
    location: 'Frigiliana, Málaga · Spanje',
    legal: 'Juridische kennisgeving & privacy',
    bookingTerms: 'Boekingsvoorwaarden'
  },
  sv: {
    location: 'Frigiliana, Málaga · Spanien',
    legal: 'Juridisk information & integritet',
    bookingTerms: 'Bokningsvillkor'
  }
};

const labels = copy[currentLang] ?? copy.en;
---

<footer class="footer-core border-t border-outline-variant/10 bg-surface-container-lowest px-6 md:px-12 py-12">
  <div class="max-w-screen-2xl mx-auto">
    <div class="footer-core__utility flex flex-wrap items-start justify-between gap-8 border-b border-outline-variant/10 pb-8">
      <div class="footer-core__social flex flex-wrap items-center gap-x-4 gap-y-2 text-on-surface-variant am-text-label">
        <span>&copy; 2026 AMARA</span>
        <span>{labels.location}</span>
      </div>

      <div class="footer-core__contact flex flex-wrap items-center gap-x-8 gap-y-3">
        <a href="mailto:hola@amara-lodging.es" class="text-on-surface-variant hover:text-primary am-text-label transition-colors">
          hola@amara-lodging.es
        </a>
      </div>

      <div class="footer-core__right flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href={resolveLink('booking_stay_terms', currentLang)} class="text-on-surface-variant hover:text-primary am-text-label transition-colors">
          {labels.bookingTerms}
        </a>
        <a href={resolveLink('legal_notice', currentLang)} class="text-on-surface-variant hover:text-primary am-text-label transition-colors">
          {labels.legal}
        </a>
      </div>
    </div>
  </div>
</footer>
