---
/**
 * AMARA canonical footer.
 *
 * Architectural intent:
 * The footer carries the identity and contact facts that must be reachable from
 * every page: postal address, the contact channels AMARA actually operates, the
 * public Instagram profile, the legal information and consent settings. AMARA
 * deliberately publishes no telephone number; WhatsApp and email are the
 * contact channels.
 */
import { MessageCircle } from '@lucide/astro';
import { resolveLink } from '../lib/linkResolver';
import type { AmaraLanguage } from '../types/seo';

interface Props {
  currentLang: AmaraLanguage;
}

const { currentLang } = Astro.props;

/** Casa AMARA is the registered address and the brand's postal identity. */
const postalAddress = 'Calle Chorruelo 5 · 29788 Frigiliana';
const whatsappNumber = '+34 604 440 964';
const whatsappHref = 'https://wa.me/34604440964';
const instagramHref = 'https://www.instagram.com/amaralodging/';

const copy: Record<
  AmaraLanguage,
  {
    region: string;
    legal: string;
    legalAriaLabel: string;
    cookies: string;
    cookiesAriaLabel: string;
    instagram: string;
  }
> = {
  en: {
    region: 'Málaga · Spain',
    legal: 'Legal',
    legalAriaLabel: 'Legal Notice & Privacy',
    cookies: 'Cookies',
    cookiesAriaLabel: 'Cookies — Cookie settings',
    instagram: 'AMARA on Instagram'
  },
  de: {
    region: 'Málaga · Spanien',
    legal: 'Rechtliches',
    legalAriaLabel: 'Rechtliches — Impressum & Datenschutz',
    cookies: 'Cookies',
    cookiesAriaLabel: 'Cookies — Cookie-Einstellungen',
    instagram: 'AMARA auf Instagram'
  },
  es: {
    region: 'Málaga · España',
    legal: 'Legal',
    legalAriaLabel: 'Aviso legal y privacidad',
    cookies: 'Cookies',
    cookiesAriaLabel: 'Cookies — configurar cookies',
    instagram: 'AMARA en Instagram'
  },
  nl: {
    region: 'Málaga · Spanje',
    legal: 'Juridisch',
    legalAriaLabel: 'Juridische kennisgeving & privacy',
    cookies: 'Cookies',
    cookiesAriaLabel: 'Cookies — cookie-instellingen',
    instagram: 'AMARA op Instagram'
  },
  sv: {
    region: 'Málaga · Spanien',
    legal: 'Juridiskt',
    legalAriaLabel: 'Juridisk information & integritet',
    cookies: 'Cookies',
    cookiesAriaLabel: 'Cookies — cookieinställningar',
    instagram: 'AMARA på Instagram'
  }
};

const labels = copy[currentLang] ?? copy.en;
---

<footer class="footer-core border-t border-outline-variant/10 bg-surface-container-lowest px-6 md:px-12 py-12">
  <div class="max-w-screen-2xl mx-auto">
    <div class="footer-core__utility flex flex-wrap items-start justify-between gap-8 border-b border-outline-variant/10 pb-8">
      <address class="footer-core__social flex flex-col gap-1 not-italic text-on-surface-variant am-text-label">
        <span>&copy; 2026 AMARA</span>
        <span>{postalAddress}</span>
        <span>{labels.region}</span>
      </address>

      <div class="footer-core__contact flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary am-text-label transition-colors"
        >
          <MessageCircle class="h-4 w-4" aria-hidden="true" />
          WhatsApp {whatsappNumber}
        </a>
        <a href="mailto:hola@amara-lodging.es" class="text-on-surface-variant hover:text-primary am-text-label transition-colors">
          hola@amara-lodging.es
        </a>
        <a
          href={instagramHref}
          target="_blank"
          rel="noopener"
          aria-label={labels.instagram}
          class="text-on-surface-variant hover:text-primary transition-colors"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
      </div>

      <div class="footer-core__right inline-flex items-center gap-2 whitespace-nowrap">
        <a
          href={resolveLink('legal_notice', currentLang)}
          aria-label={labels.legalAriaLabel}
          class="text-on-surface-variant hover:text-primary am-text-label transition-colors"
        >
          {labels.legal}
        </a>
        <span class="flex items-center justify-center leading-none text-outline-variant/60" aria-hidden="true">·</span>
        <a
          href={resolveLink('legal_notice', currentLang)}
          aria-label={labels.cookiesAriaLabel}
          class="text-on-surface-variant hover:text-primary am-text-label transition-colors"
          data-am-consent-settings
        >
          {labels.cookies}
        </a>
      </div>
    </div>
  </div>
</footer>
