---
/**
 * Wind window diagram for the Tarifa kitesurf beginner guide. A half-dome on
 * the lee side of the rider: little pull at the edges and at the zenith, an
 * illustrative kite in the 11 o'clock control zone (where early control and
 * body-drag happen), and the strongest pull as the kite crosses the central
 * power zone. Theme-aware via design tokens; the clock language mirrors how
 * instructors actually talk on the beach.
 */
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
}

const { lang } = Astro.props;
type L = Record<AmaraLanguage, string>;
const t = (v: L) => v[lang];

const copy = {
  eyebrow: { en: 'The wind window', de: 'Das Windfenster', es: 'La ventana de viento', nl: 'Het windvenster', sv: 'Vindfönstret' } satisfies L,
  title: {
    en: 'Where the kite makes power, and where it rests',
    de: 'Wo der Kite Leistung macht – und wo er ruht',
    es: 'Dónde genera potencia la cometa y dónde descansa',
    nl: 'Waar de kite kracht maakt en waar hij rust',
    sv: 'Var kiten skapar kraft och var den vilar'
  } satisfies L,
  zenith: { en: 'Zenith · 12', de: 'Zenit · 12 Uhr', es: 'Cenit · 12', nl: 'Zenit · 12 uur', sv: 'Zenit · 12' } satisfies L,
  edge: { en: 'Edge · little pull', de: 'Rand · wenig Zug', es: 'Borde · poca tracción', nl: 'Rand · weinig kracht', sv: 'Kant · lite drag' } satisfies L,
  control: { en: 'Control & body-drag · 11 and 1', de: 'Kontrolle & Bodydrag · 11 und 1 Uhr', es: 'Control y bodydrag · 11 y 1', nl: 'Controle & bodydrag · 11 en 1 uur', sv: 'Kontroll & bodydrag · 11 och 1' } satisfies L,
  kite: { en: 'Your kite', de: 'Dein Kite', es: 'Tu cometa', nl: 'Je kite', sv: 'Din kite' } satisfies L,
  power: { en: 'Power zone', de: 'Powerzone', es: 'Zona de potencia', nl: 'Powerzone', sv: 'Kraftzon' } satisfies L,
  wind: { en: 'Wind', de: 'Wind', es: 'Viento', nl: 'Wind', sv: 'Vind' } satisfies L,
  rider: { en: 'You', de: 'Du', es: 'Tú', nl: 'Jij', sv: 'Du' } satisfies L,
  caption: {
    en: 'Instructors talk in clock positions. The edges and the zenith stay calm; much of your early control and body-drag happens around 11 and 1; and the pull builds as the kite crosses the centre — the power zone.',
    de: 'Lehrer sprechen in Uhrzeigern. Ränder und Zenit bleiben ruhig; viel eurer frühen Kontrolle und der Bodydrag passiert um 11 und 1 Uhr; und der Zug baut sich auf, wenn der Kite durch die Mitte zieht – die Powerzone.',
    es: 'Los instructores hablan en horas de reloj. Los bordes y el cenit están tranquilos; buena parte del control inicial y del bodydrag ocurre hacia las 11 y la 1; y la tracción crece cuando la cometa cruza el centro: la zona de potencia.',
    nl: 'Instructeurs praten in kloktijden. De randen en het zenit blijven rustig; veel van je vroege controle en de bodydrag gebeurt rond 11 en 1 uur; en de kracht bouwt op als de kite door het midden gaat — de powerzone.',
    sv: 'Instruktörer pratar i klockslag. Kanterna och zenit är lugna; mycket av din tidiga kontroll och bodydrag sker kring 11 och 1; och draget byggs upp när kiten korsar mitten — kraftzonen.'
  } satisfies L
};
---

<section class="bg-inverse-surface px-6 py-16 text-inverted-on-surface md:px-12 md:py-24" data-am-topic="wind-window-diagram">
  <div class="mx-auto grid max-w-screen-2xl items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="am-text-eyebrow text-primary-fixed-dim">{t(copy.eyebrow)}</p>
      <h2 class="am-text-title mt-5 max-w-md text-balance text-inverted-on-surface">{t(copy.title)}</h2>
      <p class="am-text-body mt-6 max-w-md leading-relaxed text-inverted-on-surface/72">{t(copy.caption)}</p>
    </div>

    <div class="wind-window lg:col-span-8">
      <svg viewBox="0 0 640 400" class="block h-auto w-full" role="img" aria-label={t(copy.title)}>
        <defs>
          <radialGradient id="kw-power" cx="50%" cy="94%" r="80%">
            <stop offset="0%" stop-color="var(--color-primary-fixed-dim)" stop-opacity="0.52" />
            <stop offset="55%" stop-color="var(--color-primary-fixed-dim)" stop-opacity="0.2" />
            <stop offset="100%" stop-color="var(--color-primary-fixed-dim)" stop-opacity="0.02" />
          </radialGradient>
        </defs>

        <!-- faint body of the window -->
        <path class="window-fill" d="M30 340 A290 290 0 0 1 610 340 Z" />

        <!-- radial guide lines from the rider to the arc -->
        <g class="guides">
          <path d="M320 340 L30 340" />
          <path d="M320 340 L610 340" />
          <path d="M320 340 L320 50" />
          <path d="M320 340 L69 195" />
          <path d="M320 340 L571 195" />
        </g>
        <!-- the 11 and 1 o'clock control guides, brighter -->
        <g class="guides guides--control">
          <path d="M320 340 L175 89" />
          <path d="M320 340 L465 89" />
        </g>

        <!-- ground baseline -->
        <path class="ground" d="M24 340 H616" />

        <!-- outer window dome -->
        <path class="dome" d="M30 340 A290 290 0 0 1 610 340" />
        <path class="dome dome--inner" d="M118 340 A202 202 0 0 1 522 340" />

        <!-- power zone: low and central, pull building toward the centre -->
        <path class="power" fill="url(#kw-power)" d="M320 340 C238 322 196 262 200 196 C258 168 382 168 440 196 C444 262 402 322 320 340 Z" />
        <text class="power-label" x="320" y="250" text-anchor="middle">{t(copy.power)}</text>

        <!-- clock tick dots on the arc -->
        <g class="ticks">
          <circle cx="30" cy="340" r="2.5" /><circle cx="69" cy="195" r="2.5" /><circle cx="175" cy="89" r="2.5" />
          <circle cx="320" cy="50" r="2.5" /><circle cx="465" cy="89" r="2.5" /><circle cx="571" cy="195" r="2.5" /><circle cx="610" cy="340" r="2.5" />
        </g>

        <!-- clock numbers -->
        <g class="clock">
          <text x="320" y="36" text-anchor="middle">12</text>
          <text x="158" y="78">11</text>
          <text x="474" y="78">1</text>
          <text x="48" y="188" text-anchor="end">10</text>
          <text x="588" y="188">2</text>
          <text x="22" y="332" text-anchor="end">9</text>
          <text x="618" y="332">3</text>
        </g>

        <!-- illustrative kite in the 11 o'clock control zone, with its flying lines -->
        <g class="lines">
          <path d="M320 340 L176 118" />
          <path d="M320 340 L202 108" />
        </g>
        <g class="kite" transform="translate(188 106) rotate(-46)">
          <path class="kite-canopy" d="M-24 5 Q0 -17 24 5 Q0 -5 -24 5 Z" />
          <path class="kite-struts" d="M-12 2 V-5 M0 -7 V0 M12 2 V-5" />
        </g>
        <text class="control-label" x="150" y="150" text-anchor="end">{t(copy.control)}</text>
        <text class="kite-label" x="214" y="96">{t(copy.kite)}</text>

        <!-- zone labels -->
        <text class="zone" x="320" y="70" text-anchor="middle">{t(copy.zenith)}</text>
        <text class="zone" x="40" y="356">{t(copy.edge)}</text>
        <text class="zone zone--right" x="600" y="356" text-anchor="end">{t(copy.edge)}</text>

        <!-- rider -->
        <g class="rider" transform="translate(320 340)">
          <circle r="6" />
          <circle class="halo" r="15" />
          <text x="0" y="30" text-anchor="middle">{t(copy.rider)}</text>
        </g>

        <!-- wind from behind the rider -->
        <g class="wind">
          <path d="M320 392 L320 356" />
          <path d="M312 366 L320 356 L328 366" />
          <text x="336" y="384">{t(copy.wind)}</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .wind-window { container-type: inline-size; }
  .window-fill { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 4%, transparent); stroke: none; }
  .guides path { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 12%, transparent); stroke-width: 1; }
  .guides--control path { stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 38%, transparent); stroke-width: 1.25; stroke-dasharray: 2 4; }
  .ground { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 22%, transparent); stroke-width: 1; stroke-dasharray: 3 5; }
  .dome { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 55%, transparent); stroke-width: 2; }
  .dome--inner { stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 22%, transparent); stroke-width: 1; stroke-dasharray: 4 5; }
  .power { stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 44%, transparent); stroke-width: 1.25; }
  .power-label { fill: var(--color-primary-fixed-dim); font-family: var(--font-label); font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .ticks circle { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 60%, transparent); stroke: none; }
  .clock text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 66%, transparent); font-family: var(--font-label); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; }
  .lines path { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 40%, transparent); stroke-width: 1; }
  .kite .kite-canopy { fill: var(--color-primary-fixed-dim); stroke: none; }
  .kite .kite-struts { fill: none; stroke: color-mix(in srgb, var(--color-inverse-surface) 55%, transparent); stroke-width: 1; stroke-linecap: round; }
  .kite-label { fill: var(--color-primary-fixed-dim); font-family: var(--font-label); font-size: 8.5px; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .control-label { fill: color-mix(in srgb, var(--color-inverted-on-surface) 60%, transparent); font-family: var(--font-label); font-size: 8px; font-weight: 650; letter-spacing: 0.09em; text-transform: uppercase; }
  .zone { fill: color-mix(in srgb, var(--color-inverted-on-surface) 52%, transparent); font-family: var(--font-label); font-size: 8.5px; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  .rider circle { fill: var(--color-primary-fixed-dim); stroke: none; }
  .rider .halo { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 34%, transparent); stroke-width: 1; }
  .rider text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 78%, transparent); font-family: var(--font-label); font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .wind path { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 55%, transparent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .wind text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 62%, transparent); font-family: var(--font-label); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
</style>
