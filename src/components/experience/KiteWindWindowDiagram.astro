---
/**
 * Wind window diagram for the Tarifa kitesurf beginner guide. A half-dome on
 * the lee side of the rider: little pull at the edges and at the zenith, the
 * strongest pull in the central power zone. Theme-aware via design tokens; the
 * clock language mirrors how instructors actually talk on the beach.
 */
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  lang: AmaraLanguage;
}

const { lang } = Astro.props;
type L = Record<AmaraLanguage, string>;
const t = (v: L) => v[lang];

const copy = {
  eyebrow: { en: 'The wind window', de: 'Das Windfenster', es: 'La ventana de viento', nl: 'Het windvenster', sv: 'Vindfönstret' } satisfies L,
  title: {
    en: 'Where the kite makes power, and where it rests',
    de: 'Wo der Kite Leistung macht – und wo er ruht',
    es: 'Dónde genera potencia la cometa y dónde descansa',
    nl: 'Waar de kite kracht maakt en waar hij rust',
    sv: 'Var kiten skapar kraft och var den vilar'
  } satisfies L,
  zenith: { en: 'Zenith · 12', de: 'Zenit · 12 Uhr', es: 'Cenit · 12', nl: 'Zenit · 12 uur', sv: 'Zenit · 12' } satisfies L,
  edge: { en: 'Edge · little pull', de: 'Rand · wenig Zug', es: 'Borde · poca tracción', nl: 'Rand · weinig kracht', sv: 'Kant · lite drag' } satisfies L,
  power: { en: 'Power zone', de: 'Powerzone', es: 'Zona de potencia', nl: 'Powerzone', sv: 'Kraftzon' } satisfies L,
  wind: { en: 'Wind', de: 'Wind', es: 'Viento', nl: 'Wind', sv: 'Vind' } satisfies L,
  rider: { en: 'You', de: 'Du', es: 'Tú', nl: 'Jij', sv: 'Du' } satisfies L,
  caption: {
    en: 'Instructors talk in clock positions: “kite to 11”, “to 1”, “stop”. The edges and the zenith are calm; sending the kite through the centre is where the pull builds.',
    de: 'Lehrer sprechen in Uhrzeigern: „Kite auf 11“, „auf 1“, „stopp“. Ränder und Zenit sind ruhig; erst durch die Mitte baut sich der Zug auf.',
    es: 'Los instructores hablan en horas de reloj: “cometa a las 11”, “a la 1”, “stop”. Los bordes y el cenit son tranquilos; la tracción crece al pasar por el centro.',
    nl: 'Instructeurs praten in kloktijden: “kite naar 11”, “naar 1”, “stop”. De randen en het zenit zijn rustig; door het midden bouwt de kracht op.',
    sv: 'Instruktörer pratar i klockslag: ”kite till 11”, ”till 1”, ”stopp”. Kanterna och zenit är lugna; genom mitten byggs draget upp.'
  } satisfies L
};
---

<section class="bg-inverse-surface px-6 py-16 text-inverted-on-surface md:px-12 md:py-24" data-am-topic="wind-window-diagram">
  <div class="mx-auto grid max-w-screen-2xl items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="am-text-eyebrow text-primary-fixed-dim">{t(copy.eyebrow)}</p>
      <h2 class="am-text-title mt-5 max-w-md text-balance text-inverted-on-surface">{t(copy.title)}</h2>
      <p class="am-text-body mt-6 max-w-md leading-relaxed text-inverted-on-surface/72">{t(copy.caption)}</p>
    </div>

    <div class="wind-window lg:col-span-8">
      <svg viewBox="0 0 640 400" class="block h-auto w-full" role="img" aria-label={t(copy.title)}>
        <!-- radial guide lines from the rider to the arc -->
        <g class="guides">
          <path d="M320 340 L30 340" />
          <path d="M320 340 L610 340" />
          <path d="M320 340 L320 50" />
          <path d="M320 340 L115 135" />
          <path d="M320 340 L525 135" />
          <path d="M320 340 L188 92" />
          <path d="M320 340 L452 92" />
        </g>

        <!-- ground baseline -->
        <path class="ground" d="M24 340 H616" />

        <!-- outer window dome -->
        <path class="dome" d="M30 340 A290 290 0 0 1 610 340" />
        <path class="dome dome--inner" d="M118 340 A202 202 0 0 1 522 340" />

        <!-- power zone: low and central -->
        <path class="power" d="M320 340 C238 322 196 262 200 196 C258 168 382 168 440 196 C444 262 402 322 320 340 Z" />
        <text class="power-label" x="320" y="252" text-anchor="middle">{t(copy.power)}</text>

        <!-- clock numbers -->
        <g class="clock">
          <text x="320" y="38" text-anchor="middle">12</text>
          <text x="180" y="78">11</text>
          <text x="452" y="78">1</text>
          <text x="104" y="128">10</text>
          <text x="528" y="128">2</text>
          <text x="26" y="330" text-anchor="end">9</text>
          <text x="614" y="330">3</text>
        </g>

        <!-- zone labels -->
        <text class="zone" x="320" y="70" text-anchor="middle">{t(copy.zenith)}</text>
        <text class="zone" x="40" y="356">{t(copy.edge)}</text>
        <text class="zone zone--right" x="600" y="356" text-anchor="end">{t(copy.edge)}</text>

        <!-- rider -->
        <g class="rider" transform="translate(320 340)">
          <circle r="6" />
          <circle class="halo" r="15" />
          <text x="0" y="30" text-anchor="middle">{t(copy.rider)}</text>
        </g>

        <!-- wind from behind the rider -->
        <g class="wind">
          <path d="M320 392 L320 356" />
          <path d="M312 366 L320 356 L328 366" />
          <text x="336" y="384">{t(copy.wind)}</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .wind-window { container-type: inline-size; }
  .guides path { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 12%, transparent); stroke-width: 1; }
  .ground { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 22%, transparent); stroke-width: 1; stroke-dasharray: 3 5; }
  .dome { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 55%, transparent); stroke-width: 2; }
  .dome--inner { stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 24%, transparent); stroke-width: 1; stroke-dasharray: 4 5; }
  .power { fill: color-mix(in srgb, var(--color-primary-fixed-dim) 20%, transparent); stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 46%, transparent); stroke-width: 1.25; }
  .power-label { fill: var(--color-primary-fixed-dim); font-family: var(--font-label); font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .clock text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 64%, transparent); font-family: var(--font-label); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; }
  .zone { fill: color-mix(in srgb, var(--color-inverted-on-surface) 52%, transparent); font-family: var(--font-label); font-size: 8.5px; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  .rider circle { fill: var(--color-primary-fixed-dim); stroke: none; }
  .rider .halo { fill: none; stroke: color-mix(in srgb, var(--color-primary-fixed-dim) 34%, transparent); stroke-width: 1; }
  .rider text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 78%, transparent); font-family: var(--font-label); font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .wind path { fill: none; stroke: color-mix(in srgb, var(--color-inverted-on-surface) 55%, transparent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .wind text { fill: color-mix(in srgb, var(--color-inverted-on-surface) 62%, transparent); font-family: var(--font-label); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
</style>
