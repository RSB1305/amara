---
/**
 * Thermal-wind (land–sea breeze) diagram for the Tarifa kitesurf wind page,
 * told as one clear day in three panels: morning (land and sea equally cool,
 * nothing moves), afternoon (the sun heats the land, air rises, the sea
 * breeze is pulled in), evening and night (the land cools, the breeze dies,
 * a weak land breeze drifts out). The captions come from the page content;
 * this component owns only the drawings and their in-drawing labels.
 * Theme-aware via design tokens.
 */
interface Panel {
  id: 'morning' | 'afternoon' | 'evening';
  label: string;
  title: string;
  text: string;
  sea: string;
  land: string;
  note: string;
}

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-3" data-am-topic="thermal-wind-diagram">
  {panels.map((panel) => (
    <figure class="am-thermal m-0 bg-surface pb-7" data-am-thermal-panel={panel.id}>
      <svg viewBox="0 0 320 170" class="block h-auto w-full" role="img" aria-label={`${panel.label}: ${panel.title}`}>
        <rect class="sky" x="0" y="0" width="320" height="170" />
        {panel.id === 'morning' && <circle class="sun sun--low" cx="40" cy="36" r="12" />}
        {panel.id === 'afternoon' && <circle class="sun" cx="250" cy="30" r="16" />}
        {panel.id === 'evening' && <circle class="sun sun--low" cx="30" cy="96" r="12" />}
        <path class:list={['land', panel.id === 'afternoon' ? 'land--hot' : '']} d="M0 110 H150 Q170 105 200 112 H320 V170 H0 Z" />
        <path class:list={['sea', panel.id === 'evening' ? 'sea--night' : '']} d="M0 118 H150 V170 H0 Z" />

        {panel.id === 'afternoon' && (
          <g class="arrow arrow--strong">
            <path d="M240 100 V52" /><path d="M234 58 L240 52 L246 58" />
            <path d="M262 100 V52" /><path d="M256 58 L262 52 L268 58" />
            <path d="M40 104 H200" /><path d="M193 98 L200 104 L193 110" />
            <path d="M250 30 Q220 20 90 24" /><path d="M96 18 L90 24 L96 30" />
            <path d="M60 30 V90" /><path d="M54 84 L60 90 L66 84" />
          </g>
        )}
        {panel.id === 'evening' && (
          <g class="arrow arrow--weak">
            <path d="M200 100 H80" /><path d="M87 94 L80 100 L87 106" />
          </g>
        )}

        <text class="lbl" x="14" y="140">{panel.sea}</text>
        <text class="lbl" x="306" y="140" text-anchor="end">{panel.land}</text>
        {panel.id === 'morning' && <text class="note" x="110" y="70">{panel.note}</text>}
        {panel.id === 'afternoon' && <text class="note note--accent" x="96" y="94">{panel.note}</text>}
        {panel.id === 'evening' && <text class="note" x="96" y="90">{panel.note}</text>}
      </svg>
      <figcaption class="px-6 pt-5">
        <p class="am-text-eyebrow text-primary">{panel.label}</p>
        <h3 class="am-text-subtitle mt-2 text-balance text-on-surface">{panel.title}</h3>
        <p class="am-text-body mt-3 leading-relaxed text-on-surface-variant">{panel.text}</p>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .sky { fill: var(--color-surface-container-low); }
  .sun { fill: color-mix(in srgb, var(--color-primary) 60%, transparent); }
  .sun--low { fill: color-mix(in srgb, var(--color-primary) 30%, transparent); }
  .land { fill: color-mix(in srgb, var(--color-primary) 14%, var(--color-surface-container-high)); }
  .land--hot { fill: color-mix(in srgb, var(--color-primary) 46%, var(--color-surface-container-high)); }
  .sea { fill: color-mix(in srgb, var(--color-on-surface) 22%, var(--color-surface-container-low)); }
  .sea--night { fill: color-mix(in srgb, var(--color-on-surface) 38%, var(--color-surface-container-low)); }
  .arrow path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .arrow--strong path { stroke: var(--color-primary); stroke-width: 2; }
  .arrow--weak path { stroke: color-mix(in srgb, var(--color-on-surface) 45%, transparent); stroke-width: 2; stroke-dasharray: 4 5; }
  .lbl { fill: var(--color-on-surface-variant); font-family: var(--font-label); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .note { fill: var(--color-muted); font-family: var(--font-headline); font-style: italic; font-size: 13px; }
  .note--accent { fill: var(--color-primary); }
</style>
