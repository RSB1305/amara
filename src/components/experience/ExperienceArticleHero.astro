---
import EditorialByline from '../editorial/EditorialByline.astro';
import InlineEmphasis from '../text/InlineEmphasis.astro';
import {
  getAmaraHeroAttributes,
  type AmaraHeroByline
} from '../hero/heroContract';

interface Props extends AmaraHeroByline {
  eyebrow: string;
  title: string;
  standfirst: string;
  mark?: string;
  topic?: string;
}

const {
  eyebrow,
  title,
  standfirst,
  lang,
  authorName,
  authorHref,
  updated,
  note,
  mark,
  topic
} = Astro.props;

const heroAttributes = getAmaraHeroAttributes({
  family: 'experience',
  variant: 'authority-editorial',
  role: 'spoke',
  topic
});
---

<header
  {...heroAttributes}
  class="overflow-hidden border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28 lg:py-36"
>
  <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:col-span-8">
      <p class="am-text-eyebrow text-primary">
        {eyebrow}
      </p>
      <h1 class="am-text-display mt-7 max-w-6xl text-balance italic text-on-surface">
        {title}
      </h1>
    </div>
    <div class="border-l border-primary/30 pl-6 lg:col-span-4 lg:pl-9">
      <p class="am-text-subtitle text-balance leading-relaxed text-on-surface-variant">
        <InlineEmphasis text={standfirst} />
      </p>
    </div>
    <div class="lg:col-span-8">
      <EditorialByline
        lang={lang}
        authorName={authorName}
        authorHref={authorHref}
        updated={updated}
        note={note}
      />
    </div>
    {mark && (
      <div
        aria-hidden="true"
        class="am-text-hero-mark hidden text-right text-primary/10 lg:col-span-4 lg:block"
        data-am-hero-mark
      >
        {mark}
      </div>
    )}
  </div>
</header>
