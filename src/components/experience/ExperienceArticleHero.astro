---
import EditorialByline from '../editorial/EditorialByline.astro';
import InlineEmphasis from '../text/InlineEmphasis.astro';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  eyebrow: string;
  title: string;
  standfirst: string;
  lang: AmaraLanguage;
  authorName: string;
  authorHref: string;
  updated: string;
  note: string;
  mark?: string;
  topic?: string;
}

const {
  eyebrow,
  title,
  standfirst,
  lang,
  authorName,
  authorHref,
  updated,
  note,
  mark,
  topic
} = Astro.props;
---

<header
  class="overflow-hidden border-b border-border-subtle bg-surface px-6 py-20 md:px-12 md:py-28 lg:py-36"
  data-am-family="experience"
  data-am-role="spoke"
  data-am-topic={topic}
>
  <div class="mx-auto grid max-w-screen-2xl gap-14 lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:col-span-8">
      <p class="font-label text-[11px] font-bold uppercase tracking-[0.2em] text-primary">
        {eyebrow}
      </p>
      <h1 class="am-text-display mt-7 max-w-6xl text-balance italic text-on-surface">
        {title}
      </h1>
    </div>
    <div class="border-l border-primary/30 pl-6 lg:col-span-4 lg:pl-9">
      <p class="am-text-subtitle text-balance leading-relaxed text-on-surface-variant">
        <InlineEmphasis text={standfirst} />
      </p>
    </div>
    <div class="lg:col-span-8">
      <EditorialByline
        lang={lang}
        authorName={authorName}
        authorHref={authorHref}
        updated={updated}
        note={note}
      />
    </div>
    {mark && (
      <div
        aria-hidden="true"
        class="hidden text-right font-serif text-[clamp(3.5rem,8vw,8.5rem)] leading-[0.72] text-primary/10 lg:col-span-4 lg:block"
        data-am-hero-mark
      >
        {mark}
      </div>
    )}
  </div>
</header>
