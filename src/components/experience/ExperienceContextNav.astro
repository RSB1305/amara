---
/**
 * ExperienceContextNav
 *
 * Crawlable family navigation for the AMARA experience hub and every detail
 * page. The optional currentId creates the hub state; detail pages additionally
 * identify the current guide.
 */
import ContextNavigation, {
  type ContextNavigationBreadcrumb
} from '../navigation/ContextNavigation.astro';
import {
  experienceCatalog,
  experienceHubContent,
  experienceNavigationContent,
  type ExperienceId
} from '../../content/experienceHubContent';
import { resolveOptionalLink } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';

interface Props {
  currentId?: ExperienceId;
  lang: AmaraLanguage;
}

const { currentId, lang } = Astro.props;
const edition = experienceHubContent[lang];
const navigation = experienceNavigationContent[lang];
const currentLabel = currentId ? navigation.labels[currentId] : null;

const homeHref = resolveOptionalLink('home', lang, { suppressMissing: true });
const hubHref = resolveOptionalLink('explore_hub', lang, {
  suppressMissing: true
});

const siblingLinks = edition.catalog.order
  .map((id) => {
    const definition = experienceCatalog[id];
    const href = resolveOptionalLink(definition.token, lang, {
      suppressMissing: true
    });

    return href
      ? {
          id,
          href,
          label: navigation.labels[id]
        }
      : null;
  })
  .filter(
    (
      item
    ): item is {
      id: ExperienceId;
      href: string;
      label: string;
    } => Boolean(item)
  );

const breadcrumbs: ContextNavigationBreadcrumb[] = [
  {
    label: 'AMARA',
    href: homeHref ?? undefined
  },
  {
    label: navigation.breadcrumbLabel,
    href: currentId ? hubHref ?? undefined : undefined
  },
  ...(currentId && currentLabel ? [{ label: currentLabel }] : [])
];
---

<ContextNavigation
  activeId={currentId}
  breadcrumbAriaLabel={navigation.breadcrumbAriaLabel}
  breadcrumbs={breadcrumbs}
  context="experience"
  items={siblingLinks}
  switcherAriaLabel={navigation.switcherLabel}
/>
