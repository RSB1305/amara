---
/**
 * ExperiencePreFooter
 *
 * One locale-aware next step for each Frigiliana experience guide.
 *
 * The relationship is deliberately explicit: the closing link follows a
 * concrete planning question raised by the current guide instead of sending
 * guests into a generic recommendation carousel.
 */
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import {
  experienceCatalog,
  experienceHubContent,
  type ExperienceId
} from '../../content/experienceHubContent';
import { resolveOptionalLink } from '../../lib/linkResolver';
import type { AmaraLanguage } from '../../types/seo';
import { getPageEndAttributes } from '../page-end/pageEndContract';

interface Props {
  currentId: ExperienceId;
  lang: AmaraLanguage;
}

const { currentId, lang } = Astro.props;
const edition = experienceHubContent[lang];

const nextGuideByCurrentGuide: Record<ExperienceId, ExperienceId> = {
  restaurants: 'market',
  festivals: 'market',
  dayTrips: 'wellness',
  wellness: 'beaches',
  market: 'restaurants',
  hiking: 'wellness',
  beaches: 'dayTrips',
  nightlife: 'restaurants'
};

const nextId = nextGuideByCurrentGuide[currentId];
const definition = experienceCatalog[nextId];
const href = resolveOptionalLink(definition.token, lang, {
  suppressMissing: true
});
const recommendation = href
  ? {
      href,
      editorial: edition.stories[nextId]
    }
  : null;
---

{
  recommendation && (
    <section
      class="am-experience-prefooter am-section am-section--tint"
      data-am-experience-prefooter
      data-am-experience-recommendation
      {...getPageEndAttributes('related-content', 'experience')}
    >
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="am-text-caption mb-5 text-primary">
            {recommendation.editorial.kicker}
          </p>
          <h2 class="am-text-title italic tracking-tight text-on-surface">
            {recommendation.editorial.title}
          </h2>
        </div>
        <div class="lg:col-span-5">
          <p class="am-text-body leading-relaxed text-on-surface-variant">
            {recommendation.editorial.text}
          </p>
          <p class="mt-5">
            <AmaraActionLink href={recommendation.href} variant="inline">
              {recommendation.editorial.linkLabel}
              <span aria-hidden="true"> &rarr;</span>
            </AmaraActionLink>
          </p>
        </div>
      </div>
    </section>
  )
}
