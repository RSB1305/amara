---
import AmaraActionLink from '../actions/AmaraActionLink.astro';
import { getAmaraContentModuleAttributes } from '../content/moduleContract';

export interface ExperienceHubTopic {
  id?: string;
  eyebrow?: string;
  title: string;
  text: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  topics: ExperienceHubTopic[];
  columns?: 3 | 4;
  accent?: 'primary' | 'outline';
}

const { topics, columns = 3, accent = 'outline' } = Astro.props;
const moduleAttributes = getAmaraContentModuleAttributes({
  job: 'experience-hub-topic-grid',
  status: 'family',
  family: 'experience'
});
---

<div
  {...moduleAttributes}
  class:list={[
    'grid grid-cols-1 gap-x-12 gap-y-14 md:grid-cols-2',
    columns === 4 ? 'xl:grid-cols-4' : 'xl:grid-cols-3'
  ]}
>
  {topics.map((topic, index) => (
    <article
      id={topic.id}
      class:list={[
        'scroll-mt-36 border-t pt-6',
        accent === 'primary' ? 'border-primary/35' : 'border-outline-variant/30'
      ]}
    >
      <span class="am-text-label am-text-label--sm am-text-label--wide text-primary">
        {String(index + 1).padStart(2, '0')}
      </span>
      {topic.eyebrow && <p class="am-text-caption mt-5 text-primary">{topic.eyebrow}</p>}
      <h3 class:list={['am-text-subtitle text-on-surface', topic.eyebrow ? 'mt-3' : 'mt-5']}>
        {topic.href ? <a href={topic.href} class="experience-hub-title-link">{topic.title}</a> : topic.title}
      </h3>
      <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">{topic.text}</p>
      {topic.href && topic.linkLabel && (
        <p class="mt-6 text-sm">
          <AmaraActionLink href={topic.href} variant="inline">
            {topic.linkLabel}<span aria-hidden="true"> &rarr;</span>
          </AmaraActionLink>
        </p>
      )}
    </article>
  ))}
</div>

<style>
  .experience-hub-title-link {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 32%, transparent);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .experience-hub-title-link:hover,
  .experience-hub-title-link:focus-visible {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }

  .experience-hub-title-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-hub-title-link { transition: none; }
  }
</style>
