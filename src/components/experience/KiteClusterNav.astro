---
import AmaraSection from '../layout/AmaraSection.astro';
import { createRequiredLinkResolver, type LinkToken } from '../../lib/linkResolver';
import type { LocalizedText } from '../../types/content';
import type { AmaraLanguage } from '../../types/seo';

/**
 * Page-level band of the Tarifa kitesurf cluster, rendered above the hero of
 * every page in the cluster.
 *
 * It lives inside the page, not in the global context navigation: DR-IA-006
 * keeps the Tarifa context navigation at the hub level so mobile navigation
 * gains no third persistent tier. The band is a slim dark rail directly under
 * the context row, left-aligned, in the primary navigation role at regular
 * weight, on the inverse surface the site already uses for dark bands. The
 * current page is left out rather than marked (operator decision of
 * 4 September 2026): the band shows only where you can still go. Wind and
 * forecast are one page — the wind page carries both the live values and the
 * evergreen explanation, under the single "Wind & safety" entry. Educational
 * leave is a German concept and is shown in German only. No caption: the
 * breadcrumb above already names the topic.
 *
 * The beginner guide sits inside the cluster but is not itself a nav
 * destination, so it passes `currentId="guide"`: no item matches, and the band
 * shows every cluster page.
 */
export type KiteClusterPageId = 'hub' | 'spots' | 'wind' | 'school' | 'camp' | 'education' | 'equipment' | 'partner' | 'guide';

interface Props {
  lang: AmaraLanguage;
  currentId: KiteClusterPageId;
}

const { lang, currentId } = Astro.props;
const t = (value: LocalizedText) => value[lang];
const requiredLink = createRequiredLinkResolver(lang, 'Tarifa kite cluster nav');

const ariaLabel: LocalizedText = { en: 'More pages on kitesurfing in Tarifa', de: 'Weitere Seiten zum Kitesurfen in Tarifa', es: 'Más páginas sobre kitesurf en Tarifa', nl: 'Meer pagina’s over kitesurfen in Tarifa', sv: 'Fler sidor om kitesurfing i Tarifa' };

const items: Array<{ id: KiteClusterPageId; token: LinkToken; label: LocalizedText; languages?: AmaraLanguage[] }> = [
  { id: 'hub', token: 'tarifa_kitesurfing_hub', label: { en: 'Intro', de: 'Intro', es: 'Intro', nl: 'Intro', sv: 'Intro' } },
  { id: 'spots', token: 'tarifa_kitesurf_spots', label: { en: 'Kite spots', de: 'Kitespots', es: 'Spots de kite', nl: 'Kitespots', sv: 'Kitespots' } },
  { id: 'wind', token: 'tarifa_wind_kitesurfing_authority', label: { en: 'Wind & safety', de: 'Wind & Sicherheit', es: 'Viento y seguridad', nl: 'Wind & veiligheid', sv: 'Vind & säkerhet' } },
  { id: 'school', token: 'tarifa_kite_school', label: { en: 'Kite school', de: 'Kiteschule', es: 'Escuela de kite', nl: 'Kiteschool', sv: 'Kiteskola' } },
  { id: 'camp', token: 'tarifa_kitecamp', label: { en: 'Kitecamps', de: 'Kitecamps', es: 'Kitecamps', nl: 'Kitecamps', sv: 'Kitecamps' } },
  { id: 'education', token: 'tarifa_bildungsurlaub', label: { en: 'Educational leave', de: 'Bildungsurlaub', es: 'Bildungsurlaub', nl: 'Bildungsurlaub', sv: 'Bildungsurlaub' }, languages: ['de'] },
  { id: 'equipment', token: 'tarifa_kite_equipment', label: { en: 'Gear rental & shop', de: 'Materialverleih & Shop', es: 'Alquiler y tienda', nl: 'Materiaalverhuur & shop', sv: 'Uthyrning & butik' } },
  { id: 'partner', token: 'amara_tarifa_surf_club', label: { en: 'AMARA × Tarifa Surf Club', de: 'AMARA × Tarifa Surf Club', es: 'AMARA × Tarifa Surf Club', nl: 'AMARA × Tarifa Surf Club', sv: 'AMARA × Tarifa Surf Club' } }
];

const links = items.filter((item) => item.id !== currentId && (!item.languages || item.languages.includes(lang)));
---

<AmaraSection surface="inverse" family="location" class="mx-0 bg-inverse-surface px-6 py-0 text-inverted-on-surface md:px-12" data-am-topic="kite-cluster-nav" data-am-kite-cluster-nav data-am-kite-cluster-current={currentId}>
  <nav aria-label={t(ariaLabel)} class="mx-auto max-w-screen-2xl">
    <ul class="-mx-3 flex min-w-0 flex-nowrap items-center overflow-x-auto overscroll-x-contain md:flex-wrap md:overflow-visible" data-am-kite-scroller>
      {links.map((item) => (
        <li class="shrink-0">
          <a
            href={requiredLink(item.token)}
            class="group inline-flex min-h-9 items-center px-3 am-text-nav-context text-inverted-on-surface transition-colors hover:text-inverted-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inverted-on-surface/40"
          >
            <span class="border-b border-transparent pb-1 transition-colors group-hover:border-inverted-on-surface/50">{t(item.label)}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</AmaraSection>

<style>
  /*
   * On phones the band scrolls sideways. A soft edge fade signals that the row
   * continues, shown only on the side that can still scroll — the script below
   * sets the two widths from the scroll position (0 at each end). Above md the
   * list wraps and nothing scrolls, so the mask stays off.
   */
  @media (max-width: 767px) {
    [data-am-kite-cluster-nav] [data-am-kite-scroller] {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--am-kite-fade-left, 0px),
        #000 calc(100% - var(--am-kite-fade-right, 0px)),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--am-kite-fade-left, 0px),
        #000 calc(100% - var(--am-kite-fade-right, 0px)),
        transparent 100%
      );
    }
  }
</style>

<script>
  const FADE = '2rem';
  document.querySelectorAll<HTMLElement>('[data-am-kite-scroller]').forEach((scroller) => {
    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      if (max <= 1) {
        scroller.style.setProperty('--am-kite-fade-left', '0px');
        scroller.style.setProperty('--am-kite-fade-right', '0px');
        return;
      }
      scroller.style.setProperty('--am-kite-fade-left', scroller.scrollLeft > 1 ? FADE : '0px');
      scroller.style.setProperty('--am-kite-fade-right', scroller.scrollLeft < max - 1 ? FADE : '0px');
    };
    update();
    scroller.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  });
</script>
