---
/**
 * WindguruExampleRow
 *
 * An annotated, self-drawn forecast row in the spirit of a Windguru table: one
 * example hour, one model line, each field numbered and explained beneath.
 * It is an editorial teaching device, not a widget. The values are authored
 * examples and are labelled as such; nothing here is fetched or live.
 */
interface Column {
  id: string;
  value: string;
}

interface Term {
  id: string;
  title: string;
  text: string;
}

interface Props {
  title: string;
  note: string;
  hour: string;
  hourLabel: string;
  columns: Column[];
  terms: Term[];
  moreTitle: string;
}

const { title, note, hour, hourLabel, columns, terms, moreTitle } = Astro.props;

const numbered = columns.map((column, index) => ({
  ...column,
  index: index + 1,
  term: terms.find((term) => term.id === column.id)
}));
const remaining = terms.filter((term) => !columns.some((column) => column.id === term.id));
---

<figure data-am-windguru-example class="m-0">
  <figcaption>
    <h3 class="am-text-subtitle text-on-surface">{title}</h3>
    <p class="am-text-caption mt-2 normal-case tracking-normal text-muted">{note}</p>
  </figcaption>

  <div class="mt-6 overflow-x-auto bg-surface-container-lowest" role="region" aria-label={title} tabindex="0">
    <table class="w-full min-w-[52rem] border-collapse text-left">
      <caption class="sr-only">{title}</caption>
      <thead>
        <tr class="border-b border-border-subtle">
          <th scope="col" class="px-4 py-3 align-bottom am-text-label am-text-label--sm text-on-surface-variant">{hourLabel}</th>
          {numbered.map((column) => (
            <th scope="col" class="px-4 py-3 align-bottom">
              <span class="flex items-center gap-2">
                <span aria-hidden="true" class="am-text-data-note inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary">{column.index}</span>
                <span class="am-text-label am-text-label--sm text-on-surface-variant">{column.term?.title ?? column.id}</span>
              </span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" class="whitespace-nowrap px-4 py-5 am-text-subtitle tabular-nums text-on-surface">{hour}</th>
          {numbered.map((column) => (
            <td class="whitespace-nowrap px-4 py-5 am-text-subtitle tabular-nums text-on-surface" data-windguru-field={column.id}>{column.value}</td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>

  <ol class="mt-8 grid gap-x-10 gap-y-6 md:grid-cols-2" aria-label={title}>
    {numbered.map((column) => (
      <li class="flex gap-4" data-windguru-legend={column.id}>
        <span aria-hidden="true" class="am-text-data-note mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary">{column.index}</span>
        <div class="min-w-0">
          <p class="am-text-label am-text-label--sm text-on-surface">{column.term?.title ?? column.id}</p>
          <p class="am-text-body mt-2 leading-relaxed text-on-surface-variant">{column.term?.text}</p>
        </div>
      </li>
    ))}
  </ol>

  {remaining.length > 0 && (
    <div class="mt-10">
      <p class="am-text-label am-text-label--sm text-primary">{moreTitle}</p>
      <dl class="mt-4 grid gap-x-10 gap-y-6 md:grid-cols-3">
        {remaining.map((term) => (
          <div class="min-w-0 border-l border-primary/25 pl-4" data-windguru-term={term.id}>
            <dt class="am-text-label am-text-label--sm text-on-surface">{term.title}</dt>
            <dd class="am-text-body mt-2 leading-relaxed text-on-surface-variant">{term.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}
</figure>
