---
import type { ImageMetadata } from 'astro';
import AmaraImage from '../AmaraImage.astro';
import AmaraMediaFrame from '../media/AmaraMediaFrame.astro';

interface Props {
  title: string;
  paragraphs: string[];
  image: ImageMetadata | string;
  imageAlt: string;
  imageSide?: 'start' | 'end';
}

const { title, paragraphs, image, imageAlt, imageSide = 'end' } = Astro.props;
const mediaClass = imageSide === 'end' ? 'lg:col-span-6 lg:col-start-7' : 'lg:col-span-6 lg:col-start-1 lg:row-start-1';
---

<div class="mx-auto grid max-w-screen-2xl items-center gap-12 px-6 md:px-12 lg:grid-cols-12 lg:gap-16">
  <div class:list={['max-w-2xl lg:col-span-5', imageSide === 'start' && 'lg:col-start-8']}>
    <h2 class="am-text-title text-on-surface">{title}</h2>
    <div class="mt-8 space-y-5"><slot>{paragraphs.map((paragraph) => <p class="am-text-body leading-relaxed text-on-surface-variant">{paragraph}</p>)}</slot></div>
  </div>
  <AmaraMediaFrame role="gallery" class={mediaClass}>
    <AmaraImage src={image} alt={imageAlt} profile="gallery" loading="lazy" decoding="async" />
  </AmaraMediaFrame>
</div>
