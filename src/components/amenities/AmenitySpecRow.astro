---
import type { AmenitySpecIcon } from './amenityIcons';
export type { AmenitySpecIcon } from './amenityIcons';

interface Props {
  icon: AmenitySpecIcon;
  label: string;
  value?: string;
  category?: string;
  filterable?: boolean;
}

const { icon, label, value, category, filterable = false } = Astro.props;

const iconHref = `#am-amenity-icon-${icon}`;
---

<li
  class="grid min-h-[4.375rem] grid-cols-[1.75rem_minmax(0,1fr)] items-start gap-3 border-t border-outline-variant/20 py-3 md:min-h-[5.5rem] md:grid-cols-[2rem_minmax(0,1fr)] md:gap-4 md:py-5"
  data-amenity-row={filterable ? 'true' : undefined}
  data-amenity-category={category}
>
  <svg
    viewBox="0 0 24 24"
    class="mt-0.5 h-5 w-5 text-primary md:h-6 md:w-6"
    aria-hidden="true"
  >
    <use href={iconHref} />
  </svg>
  <div class="min-w-0">
    <strong class="am-text-body block font-normal text-on-surface md:font-bold">{label}</strong>
    {value && <span class="am-text-body mt-0.5 block leading-normal text-on-surface-variant md:mt-1 md:leading-relaxed">{value}</span>}
  </div>
</li>
