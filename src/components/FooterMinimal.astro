---
import { normalizeLanguage } from '../lib/seo/resolve-seo-head';
import { resolveOptionalLink } from '../lib/linkResolver';
import { isPublicLinkEnabled } from '../lib/routeOwnership';
import type { AmaraLanguage } from '../types/seo';

interface FooterLink {
  token: string;
  label: string;
}

interface Props {
  links?: FooterLink[];
}

const pathname = Astro.url.pathname;
const rawLang = pathname.split('/')[1] || 'es';
const currentLang: AmaraLanguage = normalizeLanguage(rawLang);

const defaultLinksByLang: Record<AmaraLanguage, FooterLink[]> = {
  en: [
    { token: 'romantic_hideaways', label: 'Apartments for couples' },
    { token: 'location_frigiliana', label: 'Frigiliana guide' },
    { token: 'reviews_hub', label: 'Guest Reviews' },
    { token: 'direct_booking_benefits', label: 'Direct Booking Benefits' }
  ],
  de: [
    { token: 'romantic_hideaways', label: 'Apartments für Paare' },
    { token: 'location_frigiliana', label: 'Frigiliana-Guide' },
    { token: 'reviews_hub', label: 'Gästebewertungen' },
    { token: 'direct_booking_benefits', label: 'Vorteile der Direktbuchung' }
  ],
  es: [
    { token: 'romantic_hideaways', label: 'Apartamentos para parejas' },
    { token: 'location_frigiliana', label: 'Guía de Frigiliana' },
    { token: 'reviews_hub', label: 'Reseñas de huéspedes' },
    { token: 'direct_booking_benefits', label: 'Ventajas de reserva directa' }
  ],
  nl: [
    { token: 'romantic_hideaways', label: 'Appartementen voor koppels' },
    { token: 'location_frigiliana', label: 'Frigiliana-gids' },
    { token: 'reviews_hub', label: 'Gastbeoordelingen' },
    { token: 'direct_booking_benefits', label: 'Voordelen van direct boeken' }
  ],
  sv: [
    { token: 'romantic_hideaways', label: 'Lägenheter för par' },
    { token: 'location_frigiliana', label: 'Frigiliana-guide' },
    { token: 'reviews_hub', label: 'Gästrecensioner' },
    { token: 'direct_booking_benefits', label: 'Fördelar med direktbokning' }
  ]
};
const defaultLinks = defaultLinksByLang[currentLang] ?? defaultLinksByLang.en;

const { links = defaultLinks } = Astro.props;
const resolvedLinks = links
  .map((link) => {
    if (!isPublicLinkEnabled(link.token)) {
      return { ...link, href: null };
    }
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { ...link, href } : null;
  })
  .filter((link): link is FooterLink & { href: string | null } => Boolean(link));
---

<section class="footer-minimal border-t border-outline-variant/10 bg-surface px-12 py-10">
  <nav class="footer-minimal__nav max-w-screen-2xl mx-auto" aria-label="Footer highlights">
    <ul class="footer-minimal__list flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {resolvedLinks.map((link) => (
        <li>
          {link.href ? (
            <a href={link.href} class="font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant hover:text-primary transition-colors">
              {link.label}
            </a>
          ) : (
            <span class="am-link-disabled font-label text-[11px] font-bold uppercase tracking-[0.14em] text-on-surface-variant transition-colors">
              {link.label}
            </span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .am-link-disabled {
    pointer-events: none;
    cursor: default;
    opacity: 0.6;
  }
</style>
