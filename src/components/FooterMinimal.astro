---
import { resolveOptionalLink, type LinkToken } from '../lib/linkResolver';
import { isPublicLinkEnabled } from '../lib/routeOwnership';
import { comfortAmenitiesLinkLabel } from '../content/comfortAmenitiesLinkLabel';
import { stayCollectionLabels } from '../content/stayCollectionLabels';
import type { AmaraLanguage } from '../types/seo';

interface FooterLink {
  token: LinkToken;
  label: string;
}

interface Props {
  currentLang: AmaraLanguage;
  links?: FooterLink[];
}

const defaultLinksByLang: Record<AmaraLanguage, FooterLink[]> = {
  en: [
    { token: 'romantic_hideaways', label: stayCollectionLabels.structuralName.en },
    { token: 'amenities', label: 'Comfort & Amenities' },
    { token: 'reviews_hub', label: 'Guest Reviews' },
    { token: 'direct_booking_benefits', label: 'Direct Booking Benefits' }
  ],
  de: [
    { token: 'romantic_hideaways', label: stayCollectionLabels.structuralName.de },
    { token: 'amenities', label: 'Komfort & Ausstattung' },
    { token: 'reviews_hub', label: 'Gästebewertungen' },
    { token: 'direct_booking_benefits', label: 'Vorteile der Direktbuchung' }
  ],
  es: [
    { token: 'romantic_hideaways', label: stayCollectionLabels.structuralName.es },
    { token: 'amenities', label: 'Confort y servicios' },
    { token: 'reviews_hub', label: 'Reseñas de huéspedes' },
    { token: 'direct_booking_benefits', label: 'Ventajas de reserva directa' }
  ],
  nl: [
    { token: 'romantic_hideaways', label: stayCollectionLabels.structuralName.nl },
    { token: 'amenities', label: 'Comfort en voorzieningen' },
    { token: 'reviews_hub', label: 'Gastbeoordelingen' },
    { token: 'direct_booking_benefits', label: 'Voordelen van direct boeken' }
  ],
  sv: [
    { token: 'romantic_hideaways', label: stayCollectionLabels.structuralName.sv },
    { token: 'amenities', label: 'Komfort och bekvämligheter' },
    { token: 'reviews_hub', label: 'Gästrecensioner' },
    { token: 'direct_booking_benefits', label: 'Fördelar med direktbokning' }
  ]
};
const { currentLang, links = defaultLinksByLang[currentLang] ?? defaultLinksByLang.en } = Astro.props;
const resolvedLinks = links
  .map((link) => {
    const label =
      link.token === 'amenities'
        ? comfortAmenitiesLinkLabel[currentLang]
        : link.label;

    if (!isPublicLinkEnabled(link.token)) {
      return { ...link, label, href: null };
    }
    const href = resolveOptionalLink(link.token, currentLang, { suppressMissing: true });
    return href ? { ...link, label, href } : null;
  })
  .filter((link): link is FooterLink & { href: string | null } => Boolean(link));
---

<section class="footer-minimal border-t border-outline-variant/10 bg-surface px-6 md:px-12 py-10">
  <nav class="footer-minimal__nav max-w-screen-2xl mx-auto" aria-label="Footer highlights">
    <ul class="footer-minimal__list flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {resolvedLinks.map((link) => (
        <li>
          {link.href ? (
            <a href={link.href} class="text-on-surface-variant hover:text-primary am-text-label transition-colors">
              {link.label}
            </a>
          ) : (
            <span class="am-is-disabled text-on-surface-variant transition-colors am-text-label" aria-disabled="true">
              {link.label}
            </span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</section>
