---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'class' | 'class:list' | 'type' | 'aria-pressed'> {
  /** The selected state is required because a filter chip is always a toggle control. */
  pressed: boolean;
  class?: string;
}

const {
  pressed,
  class: className,
  ...attributes
} = Astro.props;
---

<button
  {...attributes}
  type="button"
  aria-pressed={pressed ? 'true' : 'false'}
  class:list={['am-filter-chip', 'am-text-annotation', className]}
>
  <slot />
</button>
