---
import AmaraActionLink from '../actions/AmaraActionLink.astro';

interface ActionLink {
  href: string;
  label: string;
}

interface Props {
  priceLabel: string;
  price: string;
  primary: ActionLink;
  /**
   * Set when the primary action stays on the page and hands over to an in-page
   * booking module. The module resolves the exact total itself, so the link
   * must not behave like a departure to an external booking site.
   */
  primaryInPage?: boolean;
  secondary?: ActionLink;
  priceNote?: string;
  supportLinks?: ActionLink[];
}

const {
  priceLabel,
  price,
  primary,
  primaryInPage = false,
  secondary,
  priceNote,
  supportLinks = []
} = Astro.props;
---

<div class="am-booking-decision" data-am-component="booking-decision">
  <div class="am-booking-decision__price">
    <p class="am-text-label text-on-surface-variant">{priceLabel}</p>
    <p class="am-text-subtitle mt-1 text-on-surface">{price}</p>
  </div>

  <div class="am-booking-decision__actions">
    <AmaraActionLink
      variant="primary"
      class="w-full justify-center sm:w-auto"
      href={primary.href}
      data-am-booking-open={primaryInPage ? '' : undefined}
    >
      {primary.label}
    </AmaraActionLink>
    {secondary && (
      <AmaraActionLink
        variant="secondary"
        class="w-full justify-center sm:w-auto"
        href={secondary.href}
      >
        {secondary.label}
      </AmaraActionLink>
    )}
  </div>

  {priceNote && (
    <p class="am-booking-decision__note am-text-caption font-normal leading-relaxed">
      {priceNote}
    </p>
  )}

  {supportLinks.length > 0 && (
    <div class="am-booking-decision__support am-text-caption font-normal">
      {supportLinks.map((link) => (
        <AmaraActionLink variant="inline" href={link.href}>{link.label}</AmaraActionLink>
      ))}
    </div>
  )}
</div>

<style>
  .am-booking-decision {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-border-subtle);
  }

  .am-booking-decision__actions {
    display: grid;
    gap: 0.75rem;
  }

  .am-booking-decision__note,
  .am-booking-decision__support {
    color: var(--color-on-surface-variant);
  }

  .am-booking-decision__note {
    margin-top: -0.5rem;
  }

  .am-booking-decision__support {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .am-booking-decision {
      grid-template-columns: minmax(9rem, 1fr) auto;
      align-items: center;
      column-gap: 2rem;
    }

    .am-booking-decision__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .am-booking-decision__note,
    .am-booking-decision__support {
      grid-column: 1 / -1;
    }

    .am-booking-decision__note {
      margin-top: 0;
      max-width: 42rem;
    }
  }
</style>
