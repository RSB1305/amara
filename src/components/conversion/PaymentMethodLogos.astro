/**
 * Payment trust row for the governed external checkout.
 *
 * Architectural intent:
 * The row names only the payment methods a guest actually meets in the
 * Lodgify checkout, verified against the live payment step on 2026-09-04:
 * card payment processed by Stripe with Visa, Mastercard and American Express,
 * and Google Pay. The marks are monochrome inline SVG in the surrounding text
 * colour at reduced opacity, so the row reads as a quiet secondary signal
 * beneath price, primary action and legal links rather than as a design
 * element of its own. It carries no title or explanatory copy; the brand names
 * are language-neutral and serve as the accessible names. Marks are sized by
 * height so wordmarks, circles and the boxed Amex mark read as one calm row.
 * Vector data: Stripe wordmark (official brand asset) and Simple Icons (CC0).
 */
interface Props {
  class?: string;
}

