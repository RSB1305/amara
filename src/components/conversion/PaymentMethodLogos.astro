---

<ul
  class:list={['flex flex-wrap items-center gap-x-4 gap-y-2 text-on-surface-variant opacity-60', className]}
  data-am-component="payment-methods"
>
  {marks.map((mark) => (
    <li class="flex items-center">
      <svg
        class:list={[mark.heightClass, 'w-auto']}
        viewBox={mark.viewBox}
        fill="currentColor"
        fill-rule={mark.fillRule}
        role="img"
        aria-label={mark.name}
      >
        <path d={mark.path} />
      </svg>
    </li>
  ))}
</ul>
