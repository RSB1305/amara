---
import { guestGuideEntries } from '../content/guestGuideEntries';
import { experienceAccessHref } from '../../guest-experience/guide-routes.mjs';

export function getStaticPaths() {
  return guestGuideEntries.map((entry) => ({
    params: { guideSlug: entry.slug },
    props: { entry }
  }));
}

return Astro.redirect(experienceAccessHref('es'), 301);
---
