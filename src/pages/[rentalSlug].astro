---
import VacationRentalPage from '../page-families/vacation-rental/VacationRentalPage.astro';
import { vacationRentalEntities } from '../content/vacationRentalEntities';
import { DEFAULT_LANGUAGE } from '../lib/routeOwnership';

export function getStaticPaths() {
  return vacationRentalEntities.map((rental) => ({
    params: { rentalSlug: rental.slug },
    props: { rental }
  }));
}

const { rental } = Astro.props;
---

<VacationRentalPage rental={rental} lang={DEFAULT_LANGUAGE} />
