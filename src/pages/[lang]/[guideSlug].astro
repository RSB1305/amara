---
import GuestGuidePage from '../../page-families/guest-guide/GuestGuidePage.astro';
import { guestGuideEntries } from '../../content/guestGuideEntries';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '../../lib/routeOwnership';
import type { AmaraLanguage } from '../../types/seo';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES
    .filter((lang) => lang !== DEFAULT_LANGUAGE)
    .flatMap((lang) =>
      guestGuideEntries.map((entry) => ({
        params: { lang, guideSlug: entry.slug },
        props: { entry, lang }
      }))
    );
}

const { entry, lang } = Astro.props as {
  entry: (typeof guestGuideEntries)[number];
  lang: AmaraLanguage;
};
---

<GuestGuidePage entry={entry} lang={lang} />
