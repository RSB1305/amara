---
import VacationRentalPage from '../../page-families/vacation-rental/VacationRentalPage.astro';
import { vacationRentalEntities } from '../../content/vacationRentalEntities';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '../../lib/routeOwnership';
import type { AmaraLanguage } from '../../types/seo';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES
    .filter((lang) => lang !== DEFAULT_LANGUAGE)
    .flatMap((lang) =>
      vacationRentalEntities.map((rental) => ({
        params: { lang, rentalSlug: rental.slug },
        props: { rental, lang }
      }))
    );
}

const { rental, lang } = Astro.props as {
  rental: (typeof vacationRentalEntities)[number];
  lang: AmaraLanguage;
};
---

<VacationRentalPage rental={rental} lang={lang} />
