---
import HoneymoonPage from '../../page-families/honeymoon/HoneymoonPage.astro';
import {
  getOwnedPageStaticPaths,
  isSupportedLanguage
} from '../../lib/routeOwnership';

export const getStaticPaths = getOwnedPageStaticPaths;

const { lang } = Astro.params;
if (!lang || !isSupportedLanguage(lang)) {
  throw new Error(`Unsupported language route: ${lang ?? 'missing'}`);
}
---

<HoneymoonPage lang={lang} />
