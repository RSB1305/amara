                  <FaqAccordion
                    arrivalTitle="Direct answers"
                    steps={[{ num: '01', headline: 'Start with the question', text: 'Keep the answer complete, direct and easy to scan.' }]}
                    faqTitle="Related questions"
                    items={[{ question: 'What belongs here?', answer: 'Only follow-up information that helps readers understand or act on the answer.' }]}
                    pageEndFamily="trust"
                  />
                )}
                {group === 'documentary-authority' && (
                  <EditorialSplit title="Formal information remains documentary">
                    <p class="am-text-subtitle text-on-surface">Terms and legal notices keep stable document sections, identities and exceptions.</p>
                    <p class="am-text-body text-subtle">Functional media and a next action are not required merely to complete a page-type anatomy.</p>
                  </EditorialSplit>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="sg-subsection">
        <h3 class="am-text-title text-on-surface">Explore family compositions</h3>
        <p class="sg-inline-demo mt-3">Campaign, Hub and Spoke share the Explore intent, but each family owns a different composition. The specimens below render production owners rather than imitating their output.</p>

        <h4 class="am-text-subtitle mt-10 text-on-surface">Campaign</h4>
        <p class="sg-specimen-note"><strong>Owners:</strong> ExploreCampaignHero, ExploreCampaignMediaSplit, ExploreCampaignPlanningGrid, FaqAccordion and EditorialClosingCta. <strong>Allowed:</strong> emotional linear narrative and Stay-oriented onward actions. <strong>Boundary:</strong> not a Destination Hub or Spoke template.</p>
        <div class="sg-hero-preview">
          <ExploreCampaignHero
            imageSrc="/images/hero-frigiliana.jpg"
            imageAlt="Frigiliana village"
            kicker="Campaign Explore"
            title="Shared time shaped by place"
            lead="A campaign may tell one emotional, linear story while keeping the next action restrained."
            paragraphs={['The family owner controls the repeated hierarchy; the page supplies localized meaning and evidence.']}
            action={{ href: '#page-families', label: 'See campaign families' }}
          />
        </div>
        <div class="sg-component-frame">
          <ExploreCampaignMediaSplit
            title="A place within the story"
            paragraphs={['Campaign media supports one narrative phase without becoming a generic split system.']}
            image="/images/hero-frigiliana.jpg"
            imageAlt="White village buildings in Frigiliana"
          />
        </div>
        <div class="sg-component-frame">
          <ExploreCampaignPlanningGrid columns={3} items={[
            { title: 'Choose the setting', text: 'Connect the occasion to a truthful place consequence.' },
            { title: 'Plan the rhythm', text: 'Keep useful planning inside the emotional narrative.' },
            { title: 'Continue calmly', text: 'Offer one relevant Stay-oriented next step.', href: '#page-families', linkLabel: 'View ownership' }
          ]} />
        </div>

        <h4 class="am-text-subtitle mt-12 text-on-surface">Destination Experience Hub</h4>
        <p class="sg-specimen-note"><strong>Owner:</strong> ExperienceHubTopicGrid with LocationExperienceHero, AmaraSectionIntro and GuideClosingSection around it in production. <strong>Allowed:</strong> three or four columns, optional eyebrow and primary or outline accent. <strong>Boundary:</strong> lead stories remain dominant where the family requires them.</p>
        <div class="sg-component-frame">
          <AmaraSectionIntro title="Choose a way into the destination" eyebrow="Experience Hub" intro="A hub preserves a dominant entry and then exposes curated paths without flattening every topic into equal editorial weight." variant="editorial" />
          <ExperienceHubTopicGrid topics={[
            { eyebrow: 'Village', title: 'Move through the old town', text: 'A story-oriented path into place.', href: '#page-families', linkLabel: 'Open family registry' },
            { eyebrow: 'Coast', title: 'Find the right shoreline', text: 'A location-led route into the day.' },
            { eyebrow: 'Movement', title: 'Follow wind and landscape', text: 'A more active destination path.' }
          ]} />
        </div>

        <h4 class="am-text-subtitle mt-12 text-on-surface">Destination Experience Spoke</h4>
        <p class="sg-specimen-note"><strong>Cluster owners:</strong> BeachSectionList, DayTripDestinationList and RestaurantSectionList. <strong>Shared global owners:</strong> AmaraMetaChip, EditorialCallout, AmaraActionLink and GuideClosingSection. <strong>Boundary:</strong> Market and Tarifa retain their distinct practical or editorial family templates.</p>
        <div class="sg-component-frame">
          <BeachSectionList
            sections={[{ id: 'styleguide-beach', title: 'A place-oriented spoke', intro: 'Location, fit and one practical consequence stay together.', beaches: [{ title: 'Sheltered cove', bestFor: 'A slower morning', description: 'The place unit remains useful rather than becoming a generic card.', tip: 'Check access before setting out.', mapHref: '#page-families' }] }]}
            labels={{ bestFor: 'Best for', tip: 'Practical note', map: 'Open route' }}
          />
        </div>
        <div class="sg-component-frame">
          <DayTripDestinationList
            destinations={[{ id: 'styleguide-day-trip', kicker: 'Day trip', title: 'A practical Explore spoke', summary: 'Facts and planning retain more weight than decorative media.', facts: [{ label: 'Travel logic', value: 'Choose the route before the atmosphere.' }], planningTitle: 'Plan the return', callout: 'Keep the useful constraint visible.', details: 'The shared owner preserves a scannable facts-and-planning composition.', officialHref: '#page-families', officialLabel: 'Continue to registry' }]}
          />
        </div>
        <div class="sg-component-frame">
          <RestaurantSectionList
            sections={[{ id: 'styleguide-restaurant', title: 'A place and food cluster', intro: 'Selection guidance, practical notes and external actions have distinct owners.', restaurants: [{ title: 'Local table', bestFor: 'An unhurried evening', description: 'The card remains a place decision, not a Stay or Trust card.', tip: 'Reserve when timing matters.', goodToKnow: 'Opening patterns can change.', mapHref: '#page-families', websiteHref: '#page-families' }] }]}
            labels={{ bestFor: 'Best for', tip: 'Tip', goodToKnow: 'Good to know', map: 'Map', website: 'Website' }}
          />
        </div>
      </div>

      <div class="sg-subsection">
        <h3 class="am-text-title text-on-surface">Trust family compositions</h3>
        <p class="sg-inline-demo mt-3">All three families use TrustPageLayout, TrustHero, the executable Trust family contract and TrustFamilyClosing. Their evidence job stays deliberately different: philosophy and people, guest proof, or concrete comfort detail.</p>

        {trustFamilyIds.map((family) => {
          const profile = AMARA_TRUST_FAMILY_PROFILES[family];
          return (
            <article class="mt-10" {...getTrustFamilyAttributes(family)}>
              <p class="sg-specimen-note"><strong>Family:</strong> {family} · <strong>Job:</strong> {profile.job} · <strong>Intro:</strong> {profile.intro} · <strong>Evidence:</strong> {profile.evidence} · <strong>Phases:</strong> {profile.phases.join(' → ')}. <strong>Boundary:</strong> subtle onward action only; no second conversion funnel.</p>
              <div class="sg-component-frame">
                {family === 'trust-content' && (
                  <EditorialSplit title="Principles become credible through practice">
                    <p class="am-text-subtitle text-on-surface">The brand family gives philosophy, responsibility and personal host context a calm editorial sequence.</p>
                    <p class="am-text-body text-subtle">Owner chain: TrustPageLayout → EditorialSplit and EditorialFeatureGrid → TrustFamilyClosing.</p>
                  </EditorialSplit>
                )}
                {family === 'guest-reviews' && (
                  <>
                    <EditorialQuote quote="Guest evidence stays attributable, specific and visually quieter than a promotional claim." source="Trust evidence specimen" />
                    <div class="mt-10">
                      <AmaraSectionIntro title="Evidence with context" intro="Review excerpts, source context and awards remain separate proof roles inside one evidence-led family." variant="centered" />
                    </div>
                  </>
                )}
                {family === 'comfort-amenities' && (
                  <>
                    <AmaraSectionIntro title="Quality made concrete" intro="Comfort evidence remains functional and scannable rather than becoming a Stay decision card." variant="editorial" />
                    <EditorialFeatureGrid cards={[
                      { title: 'Inventory', copy: 'Concrete inclusions stay grouped by the existing amenities renderer.' },
                      { title: 'Detail', copy: 'Expandable property detail remains useful evidence rather than promotional copy.' }
                    ]} />
                  </>
                )}
              </div>
              <div class="sg-component-frame">
                <TrustFamilyClosing
                  family={family}
                  title="Continue with the next useful context"
                  lead="The shared Trust close keeps the family-owned action treatment and prevents a competing closing funnel."
                  links={[{ token: 'about', label: 'Read about AMARA', style: 'text' }]}
                  lang="en"
                />
              </div>
            </article>
          );
        })}
      </div>

    </section>

    <section class="sg-section" id="page-families">
      <h2 class="sg-section-title">Registered Page-Family Baukästen</h2>
      <p class="sg-inline-demo">This view is generated directly from <span class="sg-code">AMARA_PAGE_FAMILY_PROFILES</span>. Reference and approved tiers are presentation metadata here—not a second registry. Unregistered legacy and Guest Utility remain intentionally outside the public type matrix.</p>

      {(['reference', 'approved'] as const).map((tier) => (
        <div class="sg-subsection">
          <h3 class="am-text-title text-on-surface">{tier === 'reference' ? 'Reference families' : 'Additionally classified families'}</h3>
          <div class="mt-6 divide-y divide-border-subtle border-y border-border-subtle">
            {classifiedPageFamilies.filter(([, profile]) => profile.tier === tier).map(([family, profile]) => (
              <div class="am-text-body grid gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-6">
                <code>{family}</code>
                <span>{profile.type}</span>
                <span class="text-on-surface-variant">{'conversionOwnership' in profile ? profile.conversionOwnership : '—'}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="sg-section" id="cards">
      <h2 class="sg-section-title">Cards & Content Modules</h2>
      <p class="sg-inline-demo" style="margin-bottom:32px">
        AMARA besitzt keine Universal-Card. Der Produktionsowner folgt dem Informationsjob: Feature, praktische Hervorhebung, Guide-Navigation, Unterkunftsauswahl, Evidence, Vergleich oder Buchungsentscheidung.
      </p>

      <span class="sg-label">Canonical · editorial-feature-grid</span>
      <div class="sg-component-frame">
        <EditorialFeatureGrid cards={[
          { title: 'Arrival reality', copy: 'Understand access, gradients and the useful route before choosing a stay.' },
          { title: 'Daily rhythm', copy: 'Connect practical facts to the way a couple will actually move through the place.' },
          { title: 'Evidence', copy: 'Keep verified guidance distinct from decorative emphasis.' },
          { title: 'Next step', copy: 'Give the reader a relevant onward action without forcing conversion.' }
        ]} />
        <div class="sg-component-label">Owner: <span class="sg-code">EditorialFeatureGrid</span> · wiederverwendet in Trust, Property und Location · keine verlinkte Auswahlkarte</div>
      </div>

      <span class="sg-label">Canonical · practical-callout</span>
      <div class="sg-component-frame">
        <EditorialCallout>
          <strong class="text-primary">Good to know:</strong> This treatment is for a practical consequence, tip or access note—not for decorative emphasis.
        </EditorialCallout>
        <div class="sg-component-label">Owner: <span class="sg-code">EditorialCallout</span> · zentrale Fläche, Border, Innenabstand und Textrolle · optionale low/lowest surface</div>
      </div>

      <span class="sg-label">Family · location · guide-link-grid</span>
      <div class="sg-hero-preview">
        <GuideLinkCardSection
          title="Continue planning"
          intro="Related guidance stays a quiet editorial navigation job rather than becoming a promotional card wall."
          surface="surface"
          items={[
            { title: 'Arrival and parking', text: 'Know where the car stops and where walking begins.', href: '#structure', linkLabel: 'Open the guide' },
            { title: 'Where to stay', text: 'Match the daily route to the part of town that suits the stay.', href: '#heroes', linkLabel: 'Compare areas' }
          ]}
        />
        <div class="sg-hero-meta">Owner: <span class="sg-code">GuideLinkCardSection</span> · Location family · editorial navigation with optional links</div>
      </div>

      <span class="sg-label">Family · stay · stay-selection-card</span>
      <div class="sg-component-frame">
        <div style="max-width:30rem">
          <ApartmentCard
            href="#heroes"
            imageSrc="/images/hero-frigiliana.jpg"
            imageAlt="Frigiliana village on the hillside"
            meta="Frigiliana · 2 guests"
            title="Casa AMARA"
            description="A stay-selection card joins a real destination, image, fit and onward decision."
            ctaLabel="View the stay"
          />
        </div>
        <div class="sg-component-label">Owner: <span class="sg-code">ApartmentCard</span> · linked stay selection · image, metadata, description and conversion-aware states</div>
      </div>

      <span class="sg-label">Family · location · evidence-panel</span>
      <div class="sg-component-frame">
        <div style="max-width:34rem">
          <LocationGuideEvidence
            eyebrow="Planning evidence"
            summary="Evidence panels carry a concise authority statement and optional fact rows. They are not a generic inverted card."
            items={[
              { label: 'Owner', value: 'LocationGuideEvidence' },
              { label: 'Use', value: 'Verified orientation or planning evidence' }
            ]}
          />
        </div>
      </div>

      <span class="sg-label">Family · conversion · booking-decision</span>
      <div class="sg-component-frame">
        <BookingDecisionPanel
          priceLabel="From per night"
          price="€145"
          primary={{ href: '#buttons', label: 'Choose dates' }}
          primaryInPage
          priceNote="A booking decision is a conversion module, not a card treatment to reuse for editorial content."
        />
        <div class="sg-component-label">Owner: <span class="sg-code">BookingDecisionPanel</span> · conversion-only · price context and explicit next step</div>
      </div>
    </section>

    <!-- LINKS -->
    <section class="sg-section" id="links">
      <h2 class="sg-section-title">Links</h2>
      <div class="sg-component-frame">
        <span class="sg-label">Editorial onward action</span>
        <AmaraActionLink href="#cards" variant="editorial">Continue to related guidance</AmaraActionLink>

        <span class="sg-label" style="margin-top:28px">Inline editorial link</span>
        <p class="sg-inline-demo">
          Frigiliana is not a flat coastal resort. Read the
          <AmaraActionLink href="#structure" variant="inline">arrival guide</AmaraActionLink>
          before you book, or explore
          <AmaraActionLink href="#spacing" variant="inline">macro spacing</AmaraActionLink>
          for vertical rhythm.
        </p>

        <span class="sg-label" style="margin-top:28px">Related guide link</span>
        <div style="max-width:28rem">
          <AmaraActionLink href="#structure" variant="guide">Arrival and parking guide</AmaraActionLink>
        </div>

        <span class="sg-label" style="margin-top:28px">Text inside a linked card</span>
        <AmaraActionLink href="#cards" variant="card">Open the complete stay story</AmaraActionLink>

        <span class="sg-label" style="margin-top:28px">Deliberately external destination</span>
        <AmaraActionLink href="https://example.com" variant="editorial" external>Open external source</AmaraActionLink>

        <div class="sg-component-label" style="margin-top:16px">
          Produktionsowner: <span class="sg-code">AmaraActionLink</span> · Varianten: <span class="sg-code">editorial</span>, <span class="sg-code">inline</span>, <span class="sg-code">guide</span>, <span class="sg-code">card</span> · <span class="sg-code">external</span> erzwingt <span class="sg-code">target="_blank"</span> mit sicherem <span class="sg-code">rel</span>
        </div>
      </div>
    </section>

    <!-- BORDERS -->
    <section class="sg-section" id="borders">
      <h2 class="sg-section-title">Borders & Dividers</h2>
      <div class="sg-component-frame">
        <div style="border-bottom:1px solid var(--color-outline-variant);padding-bottom:12px;margin-bottom:12px;font-size:13px">border-outline-variant — Standard Divider</div>
        <div style="border-bottom:1px solid var(--color-outline);padding-bottom:12px;margin-bottom:12px;font-size:13px">border-outline — Stärker</div>
        <div style="border-bottom:2px solid var(--color-on-surface);padding-bottom:12px;margin-bottom:12px;font-size:13px">border-on-surface — Stark / Akzent</div>
        <div style="border-bottom:1px solid var(--color-border-subtle);padding-bottom:12px;font-size:13px;color:var(--color-muted)">border-subtle — Sehr fein</div>
      </div>
    </section>

    <!-- SHADOWS -->
    <section class="sg-section" id="shadows">
      <h2 class="sg-section-title">Shadows</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div style="background:var(--color-surface-white);border-radius:10px;padding:24px;box-shadow:var(--shadow-editorial-card)">
          <div style="font-size:12px;font-family:monospace;color:var(--color-primary)">--shadow-editorial-card</div>
          <div style="font-size:11px;color:var(--color-muted);margin-top:4px">@theme</div>
        </div>
        <div style="background:var(--color-surface-white);border-radius:10px;padding:24px;border:1px solid var(--color-outline-variant)">
          <div style="font-size:12px;font-family:monospace;color:var(--color-primary)">border-outline-variant</div>
          <div style="font-size:11px;color:var(--color-muted);margin-top:4px">Kein Shadow — nur Border</div>
        </div>
      </div>
    </section>

  </main>
</div>

</body>
</html>
