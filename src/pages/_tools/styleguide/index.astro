---
// src/pages/tools/styleguide/index.astro
// AMARA Living Styleguide — Internes Tool
// Nur lokal verfügbar · robots: noindex · niemals deployen
import '../../../styles/global.css';
import AmaraActionButton from '../../../components/actions/AmaraActionButton.astro';
import AmaraActionLink from '../../../components/actions/AmaraActionLink.astro';
import AmaraFilterChip from '../../../components/chips/AmaraFilterChip.astro';
import AmaraMetaChip from '../../../components/chips/AmaraMetaChip.astro';
import AmaraStatusBadge from '../../../components/chips/AmaraStatusBadge.astro';
import EditorialCallout from '../../../components/content/EditorialCallout.astro';
import BookingDecisionPanel from '../../../components/conversion/BookingDecisionPanel.astro';
import EditorialFeatureGrid from '../../../components/editorial/EditorialFeatureGrid.astro';
import ExperienceArticleHero from '../../../components/experience/ExperienceArticleHero.astro';
import ApartmentCard from '../../../components/location/ApartmentCard.astro';
import LocationGuideEvidence from '../../../components/location/LocationGuideEvidence.astro';
import LocationGuideHero from '../../../components/location/LocationGuideHero.astro';
import StayHero from '../../../components/hero/StayHero.astro';
import TrustHero from '../../../components/hero/TrustHero.astro';
import GuideLinkCardSection from '../../../page-families/location-authority/GuideLinkCardSection.astro';
import { BedDouble, UsersRound } from '@lucide/astro';

const styleguideStayFacts = [
  { label: '2 guests', Icon: UsersRound },
  { label: '1 bedroom', Icon: BedDouble }
];
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex, nofollow" />
  <title>AMARA Styleguide</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    /* Layout shell only — color/type tokens come from global.css @theme */
    .sg-shell { min-height: 100vh; }
    .sg-nav { background: var(--color-nav-panel); color: var(--color-inverse-on-surface); padding: 24px 20px; }
    .sg-nav-logo { font-family: var(--font-headline); font-size: 22px; font-weight: 300; letter-spacing: .08em; color: var(--color-gold); margin-bottom: 8px; }
    .sg-nav-sub { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-faint); margin-bottom: 32px; }
    .sg-nav-section { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-faint); margin: 20px 0 8px; }
    .sg-nav a { display: block; font-size: 13px; color: color-mix(in srgb, var(--color-inverse-on-surface) 70%, transparent); text-decoration: none; padding: 5px 0; transition: color .15s; }
    .sg-nav a:hover { color: var(--color-inverse-on-surface); }

    .sg-main { width: 100%; max-width: 1100px; padding: 32px 20px; overflow: hidden; }
    .sg-section { margin-bottom: 72px; }
    .sg-section-title { font-family: var(--font-headline); font-size: 32px; font-weight: 300; color: var(--color-on-surface); margin-bottom: 6px; padding-bottom: 16px; border-bottom: 1px solid var(--color-outline-variant); margin-bottom: 32px; }
    .sg-label { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 16px; display: block; }
    .sg-subsection { margin-bottom: 40px; }

    /* Color swatches */
    .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
    .sg-swatch { border-radius: 10px; overflow: hidden; border: 1px solid var(--color-outline-variant); }
    .sg-swatch-color { height: 72px; }
    .sg-swatch-info { padding: 10px 12px; background: var(--color-surface-white); }
    .sg-swatch-name { font-size: 11px; font-weight: 700; color: var(--color-on-surface); margin-bottom: 2px; }
    .sg-swatch-value { font-size: 10px; font-family: monospace; color: var(--color-muted); }
    .sg-swatch-class { font-size: 10px; font-family: monospace; color: var(--color-primary); margin-top: 2px; }

    /* Typography specimens */
    .sg-type-specimen { background: var(--color-surface-white); border: 1px solid var(--color-outline-variant); border-radius: 10px; padding: 24px 28px; margin-bottom: 12px; display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; }
    .sg-type-meta { text-align: right; }
    .sg-type-meta-name { font-size: 11px; font-weight: 700; color: var(--color-muted); }
    .sg-type-meta-detail { font-size: 10px; font-family: monospace; color: var(--color-hint); margin-top: 2px; }

    /* Spacing */
    .sg-spacing-row { display: flex; align-items: center; gap: 16px; margin-bottom: 10px; }
    .sg-spacing-bar { background: var(--color-primary-container); height: 20px; border-radius: 4px; max-width: 100%; }
    .sg-spacing-label { font-size: 11px; font-family: monospace; color: var(--color-muted); min-width: 120px; }

    /* Components */
    .sg-component-frame { background: var(--color-surface-white); border: 1px solid var(--color-outline-variant); border-radius: 12px; padding: 32px; margin-bottom: 12px; }
    .sg-component-label { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-hint); margin-top: 12px; }
    .sg-hero-preview { border: 1px solid var(--color-outline-variant); background: var(--color-surface); margin-bottom: 20px; overflow: hidden; }
    .sg-hero-meta { padding: 14px 16px; border-top: 1px solid var(--color-outline-variant); background: var(--color-surface-white); color: var(--color-muted); font-size: 11px; line-height: 1.6; }

    /* Structure demo */
    .sg-structure { background: var(--color-surface-container-low); border: 2px dashed var(--color-outline-variant); border-radius: 12px; padding: 20px; }
    .sg-structure-label { font-size: 10px; font-family: monospace; color: var(--color-primary); margin-bottom: 12px; display: block; font-weight: 700; }
    .sg-structure-inner { background: var(--color-surface-white); border: 2px dashed var(--color-outline-variant); border-radius: 8px; padding: 16px; margin-top: 8px; }

    /* Dividers */
    .sg-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .sg-code { font-family: monospace; font-size: 11px; background: var(--color-surface-container-high); padding: 2px 7px; border-radius: 4px; color: var(--color-primary); overflow-wrap: anywhere; }

    .sg-inline-demo { font-family: var(--font-body); font-size: 16px; line-height: 1.75; color: var(--color-on-surface-variant); max-width: 42rem; }

    @media (max-width: 899px) {
      .sg-nav { position: static; height: auto; }
      .sg-nav a { display: inline-block; margin-right: 16px; }
      .sg-nav-section { margin-top: 16px; }
      .sg-type-specimen { grid-template-columns: 1fr; }
      .sg-type-meta { text-align: left; }
    }

    @media (min-width: 900px) {
      .sg-shell { display: grid; grid-template-columns: 220px minmax(0, 1fr); }
      .sg-nav { position: sticky; top: 0; height: 100vh; padding: 32px 20px; overflow-y: auto; }
      .sg-main { padding: 48px 56px; }
    }
  </style>
</head>
<body>

<div class="sg-shell">

  <!-- Sidebar Nav -->
  <nav class="sg-nav">
    <div class="sg-nav-logo">AMARA</div>
    <div class="sg-nav-sub">Living Styleguide</div>
    <div class="sg-nav-section">Foundations</div>
    <a href="#colors">Colors & Tokens</a>
    <a href="#typography">Typography</a>
    <a href="#spacing">Spacing</a>
    <a href="#structure">Page Structure</a>
    <div class="sg-nav-section">Components</div>
    <a href="#heroes">Hero Families</a>
    <a href="#buttons">Buttons</a>
    <a href="#chips">Chips & Status</a>
    <a href="#cards">Cards & Modules</a>
    <a href="#links">Links</a>
    <div class="sg-nav-section">Utilities</div>
    <a href="#borders">Borders & Dividers</a>
    <a href="#shadows">Shadows</a>
  </nav>

  <!-- Main Content -->
  <main class="sg-main">

    <!-- COLORS -->
    <section class="sg-section" id="colors">
      <h2 class="sg-section-title">Colors & Tokens</h2>

      <div class="sg-subsection">
        <span class="sg-label">Surface — Hintergründe</span>
        <div class="sg-swatches">
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-surface)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">surface</div><div class="sg-swatch-value">@theme --color-surface</div><div class="sg-swatch-class">bg-surface</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-surface-white)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">surface-white</div><div class="sg-swatch-value">@theme --color-surface-white</div><div class="sg-swatch-class">bg-surface-white</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-surface-container-lowest)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">container-lowest</div><div class="sg-swatch-value">@theme --color-surface-container-lowest</div><div class="sg-swatch-class">bg-surface-container-lowest</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-surface-container-low)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">container-low</div><div class="sg-swatch-value">@theme --color-surface-container-low</div><div class="sg-swatch-class">bg-surface-container-low</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-surface-container)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">container</div><div class="sg-swatch-value">@theme --color-surface-container</div><div class="sg-swatch-class">bg-surface-container</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-surface-container-high)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">container-high</div><div class="sg-swatch-value">@theme --color-surface-container-high</div><div class="sg-swatch-class">bg-surface-container-high</div></div>
          </div>
        </div>
      </div>

      <div class="sg-subsection">
        <span class="sg-label">Inverted — editorial / dunkle Karten</span>
        <div class="sg-swatches">
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-inverted-surface)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">inverted-surface</div><div class="sg-swatch-value">@theme --color-inverted-surface</div><div class="sg-swatch-class">bg-inverted-surface</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-inverted-on-surface)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">inverted-on-surface</div><div class="sg-swatch-value">@theme --color-inverted-on-surface</div><div class="sg-swatch-class">text-inverted-on-surface</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-inverted-on-surface-muted)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">inverted-on-surface-muted</div><div class="sg-swatch-value">@theme --color-inverted-on-surface-muted</div><div class="sg-swatch-class">text-inverted-on-surface-muted</div></div>
          </div>
        </div>
      </div>

      <div class="sg-subsection">
        <span class="sg-label">Brand — Primärfarben</span>
        <div class="sg-swatches">
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-primary)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">primary</div><div class="sg-swatch-value">@theme --color-primary</div><div class="sg-swatch-class">text-primary / bg-primary</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-primary-container)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">primary-container</div><div class="sg-swatch-value">@theme --color-primary-container</div><div class="sg-swatch-class">bg-primary-container</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-gold)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">gold</div><div class="sg-swatch-value">@theme --color-gold</div><div class="sg-swatch-class">text-gold / bg-gold</div></div>
          </div>
        </div>
      </div>

      <div class="sg-subsection">
        <span class="sg-label">Text — Schriftfarben</span>
        <div class="sg-swatches">
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-on-surface)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">on-surface</div><div class="sg-swatch-value">@theme --color-on-surface</div><div class="sg-swatch-class">text-on-surface</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-on-surface-variant)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">on-surface-variant</div><div class="sg-swatch-value">@theme --color-on-surface-variant</div><div class="sg-swatch-class">text-on-surface-variant</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-muted)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">muted</div><div class="sg-swatch-value">@theme --color-muted</div><div class="sg-swatch-class">text-muted</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-hint)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">hint</div><div class="sg-swatch-value">@theme --color-hint</div><div class="sg-swatch-class">text-hint</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-faint)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">faint</div><div class="sg-swatch-value">@theme --color-faint</div><div class="sg-swatch-class">text-faint</div></div>
          </div>
        </div>
      </div>

      <div class="sg-subsection">
        <span class="sg-label">Outline — Borders & Divider</span>
        <div class="sg-swatches">
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-outline)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">outline</div><div class="sg-swatch-value">@theme --color-outline</div><div class="sg-swatch-class">border-outline</div></div>
          </div>
          <div class="sg-swatch">
            <div class="sg-swatch-color" style="background:var(--color-outline-variant)"></div>
            <div class="sg-swatch-info"><div class="sg-swatch-name">outline-variant</div><div class="sg-swatch-value">@theme --color-outline-variant</div><div class="sg-swatch-class">border-outline-variant</div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TYPOGRAPHY -->
    <section class="sg-section" id="typography">
      <h2 class="sg-section-title">Typography</h2>

      <div class="sg-type-specimen">
        <div class="am-text-display">AMARA</div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Display</div><div class="sg-type-meta-detail">.am-text-display</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="am-text-title italic">The Reality of Arrival</div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Title</div><div class="sg-type-meta-detail">.am-text-title · italic in markup</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="am-text-subtitle">Frigiliana Parking Guide</div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Subtitle</div><div class="sg-type-meta-detail">.am-text-subtitle</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="am-text-body text-on-surface-variant">Frigiliana is not a flat coastal resort. It is vertical, stepped, and historic.</div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Body</div><div class="sg-type-meta-detail">.am-text-body</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="am-text-eyebrow text-primary">Location Authority · Frigiliana</div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Eyebrow</div><div class="sg-type-meta-detail">.am-text-eyebrow</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="sg-row">
          <span class="am-text-caption">Caption</span>
          <span class="am-text-label am-text-label--sm">Small label</span>
          <span class="am-text-annotation">Annotation</span>
        </div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Compact editorial roles</div><div class="sg-type-meta-detail">caption · label · annotation</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="sg-row">
          <span class="am-text-nav-primary">Primary navigation</span>
          <span class="am-text-nav-context">Context navigation</span>
          <span class="am-text-nav-option">Language option</span>
        </div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Navigation roles</div><div class="sg-type-meta-detail">primary · context · option</div></div>
      </div>
      <div class="sg-type-specimen">
        <div class="sg-row">
          <span class="am-text-graphic-value">52 min by car</span>
          <span class="am-text-data-note tabular-nums">18 mm</span>
          <span class="am-text-brand-strapline">Lodging</span>
        </div>
        <div class="sg-type-meta"><div class="sg-type-meta-name">Special-purpose roles</div><div class="sg-type-meta-detail">graphic value · data note · brand lockup</div></div>
      </div>
    </section>

    <!-- SPACING -->
    <section class="sg-section" id="spacing">
      <h2 class="sg-section-title">Spacing</h2>
      <span class="sg-label">Macro — @theme (vertikale Editorial-Abstände)</span>
      <div class="sg-spacing-row"><div class="sg-spacing-label">--spacing-macro-120</div><div class="sg-spacing-bar" style="width:var(--spacing-macro-120)"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">--spacing-macro-160</div><div class="sg-spacing-bar" style="width:var(--spacing-macro-160)"></div></div>
      <span class="sg-label" style="margin-top:24px">Tailwind Scale — häufig genutzte Werte</span>
      <div class="sg-spacing-row"><div class="sg-spacing-label">4px · p-1 / m-1</div><div class="sg-spacing-bar" style="width:4px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">8px · p-2 / m-2</div><div class="sg-spacing-bar" style="width:8px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">16px · p-4 / m-4</div><div class="sg-spacing-bar" style="width:16px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">24px · p-6 / m-6</div><div class="sg-spacing-bar" style="width:24px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">32px · p-8 / m-8</div><div class="sg-spacing-bar" style="width:32px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">48px · p-12 / m-12</div><div class="sg-spacing-bar" style="width:48px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">64px · p-16 / m-16</div><div class="sg-spacing-bar" style="width:64px"></div></div>
      <div class="sg-spacing-row"><div class="sg-spacing-label">80px · pt-20 (section)</div><div class="sg-spacing-bar" style="width:80px"></div></div>
    </section>

    <!-- PAGE STRUCTURE -->
    <section class="sg-section" id="structure">
      <h2 class="sg-section-title">Page Structure</h2>
      <span class="sg-label">AMARA Pflicht-Struktur — jede Seite</span>
      <div class="sg-structure">
        <span class="sg-structure-label">Astro Layout (1× pro Seite)</span>
        <div class="sg-structure-inner">
          <span class="sg-structure-label">Page-Family-Inhalt</span>
          <div style="background:var(--color-primary-container);border-radius:6px;padding:12px 16px;margin-top:8px;">
            <span style="font-size:11px;font-family:monospace;color:var(--color-primary)">→ dein Seiteninhalt hier</span>
          </div>
        </div>
      </div>
      <div style="margin-top:16px;font-size:12px;color:var(--color-muted);line-height:1.7">
        Das Astro Layout komponiert die globale Seitenstruktur<br>
        Die Page Family besitzt den jeweiligen Seiteninhalt<br>
        Kein <span class="sg-code">style=""</span> inline · kein <span class="sg-code">!important</span> außer SSOT-dokumentiert
      </div>
    </section>

    <!-- HERO FAMILIES -->
    <section class="sg-section" id="heroes">
      <h2 class="sg-section-title">Hero Families</h2>
      <p class="sg-inline-demo" style="margin-bottom:28px">
        Ein gemeinsamer semantischer Vertrag macht alle Hero-Owner auffindbar und steuerbar. Die Geometrie bleibt eine benannte Familienentscheidung: Trust vermittelt Vertrauen, Stay führt zur Buchungsentscheidung, Location verbindet Orientierung mit Bildautorität und Experience darf editorial erzählen.
      </p>

      <span class="sg-label">Trust · family variant · trust-content</span>
      <div class="sg-hero-preview">
        <div style="padding:24px 28px">
          <TrustHero
            spacing="section"
            eyebrow="AMARA Trust"
            title="Confidence before you arrive"
            lead="Clear expectations, direct contact and evidence that supports the decision."
            ctaLinks={[{ href: '#links', label: 'Read the trust guide' }]}
          />
        </div>
        <div class="sg-hero-meta">Owner: <span class="sg-code">TrustHero</span> · text-led · optional editorial or conversion actions · no media requirement</div>
      </div>

      <span class="sg-label">Stay · family variant · stay-decision</span>
      <div class="sg-hero-preview">
        <StayHero
          imageSrc="/images/hero-frigiliana.jpg"
          imageAlt="Whitewashed houses in Frigiliana"
          imageCount={12}
          galleryLabel="Open the stay gallery"
          eyebrow="Romantic Hideaway · Frigiliana"
          title="Casa AMARA"
          headline="A calm village stay for shared time"
          keyFactsLabel="Key stay facts"
          keyFacts={styleguideStayFacts}
          booking={{
            priceLabel: 'From per night',
            price: '€145',
            primary: { href: '#buttons', label: 'Choose dates' },
            priceNote: 'Final price depends on dates and occupancy.'
          }}
          lead="The opening decision block keeps the stay, its practical fit and the next booking step in one mobile-first sequence."
          highlights={['Direct host contact', 'Live availability after interaction']}
          directTrust={{
            title: 'Book directly with AMARA',
            signals: ['Clear stay conditions', 'Secure provider-owned checkout']
          }}
        />
        <div class="sg-hero-meta">Owner: <span class="sg-code">StayHero</span> · image-led conversion sequence · gallery entry, key facts, booking decision and trust evidence</div>
      </div>

      <span class="sg-label">Location · family variant · authority-media</span>
      <div class="sg-hero-preview">
        <LocationGuideHero
          eyebrow="Location Authority · Frigiliana"
          title="Understand the village before you choose where to stay"
          paragraphs={['A location hero connects the place, the practical consequence and the visual evidence without turning the image into a card.']}
          imageSrc="/images/hero-frigiliana.jpg"
          imageAlt="Frigiliana village on the hillside"
          role="hub"
          topic="overview"
        />
        <div class="sg-hero-meta">Owner: <span class="sg-code">LocationGuideHero</span> · authority-media or authority-evidence · hub and spoke roles · optional meta and action slots</div>
      </div>

      <span class="sg-label">Experience · family variant · authority-editorial</span>
      <div class="sg-hero-preview">
        <ExperienceArticleHero
          eyebrow="AMARA Experience"
          title="A day shaped by place, pace and the way back home"
          standfirst="The editorial variant gives a narrative standfirst and provenance equal weight without inventing a separate typographic language."
          lang="en"
          authorName="AMARA"
          authorHref="#heroes"
          updated="25 August 2026"
          note="AMARA editorial guidance"
          mark="01"
          topic="styleguide"
        />
        <div class="sg-hero-meta">Owner: <span class="sg-code">ExperienceArticleHero</span> · editorial authority · standfirst, byline and optional graphic mark</div>
      </div>

      <div class="sg-component-label">
        Gemeinsamer Owner: <span class="sg-code">heroContract.ts</span> · alle Varianten tragen <span class="sg-code">data-am-hero-family</span>, <span class="sg-code">data-am-hero-variant</span>, Rolle und Status · neue lokale Hero-Rezepte sind neben diesen Familien nicht zulässig
      </div>
    </section>

    <!-- BUTTONS -->
    <section class="sg-section" id="buttons">
      <h2 class="sg-section-title">Buttons</h2>
      <div class="sg-component-frame">
        <span class="sg-label">Echte Buttons — lokale Aktion oder Formular</span>
        <div class="sg-row">
          <AmaraActionButton variant="primary">Confirm selection</AmaraActionButton>
          <AmaraActionButton variant="secondary">Cancel</AmaraActionButton>
        </div>
        <span class="sg-label" style="margin-top:28px">Nicht verfügbar und in Bearbeitung</span>
        <div class="sg-row">
          <AmaraActionButton variant="primary" disabled>Unavailable</AmaraActionButton>
          <AmaraActionButton variant="secondary" loading>Loading</AmaraActionButton>
          <AmaraActionLink variant="secondary" disabled>Route unavailable</AmaraActionLink>
        </div>
        <span class="sg-label" style="margin-top:28px">Button-Treatment auf Links — Navigation zu einem Ziel</span>
        <div class="sg-row">
          <AmaraActionLink href="#links" variant="primary">Explore AMARA stays</AmaraActionLink>
          <AmaraActionLink href="#links" variant="secondary">Learn more</AmaraActionLink>
        </div>
        <span class="sg-label" style="margin-top:28px">Inverse Anwendung auf dunkler Fläche</span>
        <div class="sg-row" style="padding:24px;background:var(--color-inverted-surface);border-radius:var(--radius-card)">
          <AmaraActionLink href="#links" variant="primary" inverse>Primary inverse</AmaraActionLink>
          <AmaraActionLink href="#links" variant="secondary" inverse>Secondary inverse</AmaraActionLink>
        </div>
        <div class="sg-component-label" style="margin-top:20px">
          Produktionsowner: <span class="sg-code">AmaraActionButton</span> für Aktionen und Formulare · <span class="sg-code">AmaraActionLink</span> für Navigation · <span class="sg-code">loading</span> gilt nur für echte Buttons · deaktivierte Links werden als nicht-interaktive Labels ausgegeben
        </div>
      </div>
    </section>

    <!-- CHIPS AND STATUS -->
    <section class="sg-section" id="chips">
      <h2 class="sg-section-title">Chips & Status</h2>
      <div class="sg-component-frame">
        <span class="sg-label">Interactive filter — toggle button with selected state</span>
        <div class="sg-row">
          <AmaraFilterChip pressed={false}>All stays</AmaraFilterChip>
          <AmaraFilterChip pressed={true}>Frigiliana</AmaraFilterChip>
          <AmaraFilterChip pressed={false} disabled>Unavailable filter</AmaraFilterChip>
        </div>

        <span class="sg-label" style="margin-top:28px">Passive concise information</span>
        <div class="sg-row">
          <AmaraMetaChip>Historic centre</AmaraMetaChip>
          <AmaraMetaChip tone="accent"><strong>Best for:</strong>&nbsp;quiet evenings</AmaraMetaChip>
        </div>

        <span class="sg-label" style="margin-top:28px">Real planning status</span>
        <div class="sg-row">
          <AmaraStatusBadge>Confirmed for 2026</AmaraStatusBadge>
        </div>

        <div class="sg-component-label" style="margin-top:20px">
          Produktionsowner: <span class="sg-code">AmaraFilterChip</span> für Filterzustände · <span class="sg-code">AmaraMetaChip</span> für passive Fakten · <span class="sg-code">AmaraStatusBadge</span> ausschließlich für echte Zustände · runde Icon-Flächen gehören nicht zu diesem Cluster
        </div>
      </div>
    </section>

    <!-- CARDS AND CONTENT MODULES -->
    <section class="sg-section" id="cards">
      <h2 class="sg-section-title">Cards & Content Modules</h2>
      <p class="sg-inline-demo" style="margin-bottom:32px">
        AMARA besitzt keine Universal-Card. Der Produktionsowner folgt dem Informationsjob: Feature, praktische Hervorhebung, Guide-Navigation, Unterkunftsauswahl, Evidence, Vergleich oder Buchungsentscheidung.
      </p>

      <span class="sg-label">Canonical · editorial-feature-grid</span>
      <div class="sg-component-frame">
        <EditorialFeatureGrid cards={[
          { title: 'Arrival reality', copy: 'Understand access, gradients and the useful route before choosing a stay.' },
          { title: 'Daily rhythm', copy: 'Connect practical facts to the way a couple will actually move through the place.' },
          { title: 'Evidence', copy: 'Keep verified guidance distinct from decorative emphasis.' },
          { title: 'Next step', copy: 'Give the reader a relevant onward action without forcing conversion.' }
        ]} />
        <div class="sg-component-label">Owner: <span class="sg-code">EditorialFeatureGrid</span> · wiederverwendet in Trust, Property und Location · keine verlinkte Auswahlkarte</div>
      </div>

      <span class="sg-label">Canonical · practical-callout</span>
      <div class="sg-component-frame">
        <EditorialCallout>
          <strong class="text-primary">Good to know:</strong> This treatment is for a practical consequence, tip or access note—not for decorative emphasis.
        </EditorialCallout>
        <div class="sg-component-label">Owner: <span class="sg-code">EditorialCallout</span> · zentrale Fläche, Border, Innenabstand und Textrolle · optionale low/lowest surface</div>
      </div>

      <span class="sg-label">Family · location · guide-link-grid</span>
      <div class="sg-hero-preview">
        <GuideLinkCardSection
          title="Continue planning"
          intro="Related guidance stays a quiet editorial navigation job rather than becoming a promotional card wall."
          surface="surface"
          items={[
            { title: 'Arrival and parking', text: 'Know where the car stops and where walking begins.', href: '#structure', linkLabel: 'Open the guide' },
            { title: 'Where to stay', text: 'Match the daily route to the part of town that suits the stay.', href: '#heroes', linkLabel: 'Compare areas' }
          ]}
        />
        <div class="sg-hero-meta">Owner: <span class="sg-code">GuideLinkCardSection</span> · Location family · editorial navigation with optional links</div>
      </div>

      <span class="sg-label">Family · stay · stay-selection-card</span>
      <div class="sg-component-frame">
        <div style="max-width:30rem">
          <ApartmentCard
            href="#heroes"
            imageSrc="/images/hero-frigiliana.jpg"
            imageAlt="Frigiliana village on the hillside"
            meta="Frigiliana · 2 guests"
            title="Casa AMARA"
            description="A stay-selection card joins a real destination, image, fit and onward decision."
            ctaLabel="View the stay"
          />
        </div>
        <div class="sg-component-label">Owner: <span class="sg-code">ApartmentCard</span> · linked stay selection · image, metadata, description and conversion-aware states</div>
      </div>

      <span class="sg-label">Family · location · evidence-panel</span>
      <div class="sg-component-frame">
        <div style="max-width:34rem">
          <LocationGuideEvidence
            eyebrow="Planning evidence"
            summary="Evidence panels carry a concise authority statement and optional fact rows. They are not a generic inverted card."
            items={[
              { label: 'Owner', value: 'LocationGuideEvidence' },
              { label: 'Use', value: 'Verified orientation or planning evidence' }
            ]}
          />
        </div>
      </div>

      <span class="sg-label">Family · conversion · booking-decision</span>
      <div class="sg-component-frame">
        <BookingDecisionPanel
          priceLabel="From per night"
          price="€145"
          primary={{ href: '#buttons', label: 'Choose dates' }}
          primaryInPage
          priceNote="A booking decision is a conversion module, not a card treatment to reuse for editorial content."
        />
        <div class="sg-component-label">Owner: <span class="sg-code">BookingDecisionPanel</span> · conversion-only · price context and explicit next step</div>
      </div>
    </section>

    <!-- LINKS -->
    <section class="sg-section" id="links">
      <h2 class="sg-section-title">Links</h2>
      <div class="sg-component-frame">
        <span class="sg-label">Editorial onward action</span>
        <AmaraActionLink href="#cards" variant="editorial">Continue to related guidance</AmaraActionLink>

        <span class="sg-label" style="margin-top:28px">Inline editorial link</span>
        <p class="sg-inline-demo">
          Frigiliana is not a flat coastal resort. Read the
          <AmaraActionLink href="#structure" variant="inline">arrival guide</AmaraActionLink>
          before you book, or explore
          <AmaraActionLink href="#spacing" variant="inline">macro spacing</AmaraActionLink>
          for vertical rhythm.
        </p>

        <span class="sg-label" style="margin-top:28px">Related guide link</span>
        <div style="max-width:28rem">
          <AmaraActionLink href="#structure" variant="guide">Arrival and parking guide</AmaraActionLink>
        </div>

        <span class="sg-label" style="margin-top:28px">Text inside a linked card</span>
        <AmaraActionLink href="#cards" variant="card">Open the complete stay story</AmaraActionLink>

        <span class="sg-label" style="margin-top:28px">Deliberately external destination</span>
        <AmaraActionLink href="https://example.com" variant="editorial" external>Open external source</AmaraActionLink>

        <div class="sg-component-label" style="margin-top:16px">
          Produktionsowner: <span class="sg-code">AmaraActionLink</span> · Varianten: <span class="sg-code">editorial</span>, <span class="sg-code">inline</span>, <span class="sg-code">guide</span>, <span class="sg-code">card</span> · <span class="sg-code">external</span> erzwingt <span class="sg-code">target="_blank"</span> mit sicherem <span class="sg-code">rel</span>
        </div>
      </div>
    </section>

    <!-- BORDERS -->
    <section class="sg-section" id="borders">
      <h2 class="sg-section-title">Borders & Dividers</h2>
      <div class="sg-component-frame">
        <div style="border-bottom:1px solid var(--color-outline-variant);padding-bottom:12px;margin-bottom:12px;font-size:13px">border-outline-variant — Standard Divider</div>
        <div style="border-bottom:1px solid var(--color-outline);padding-bottom:12px;margin-bottom:12px;font-size:13px">border-outline — Stärker</div>
        <div style="border-bottom:2px solid var(--color-on-surface);padding-bottom:12px;margin-bottom:12px;font-size:13px">border-on-surface — Stark / Akzent</div>
        <div style="border-bottom:1px solid var(--color-border-subtle);padding-bottom:12px;font-size:13px;color:var(--color-muted)">border-subtle — Sehr fein</div>
      </div>
    </section>

    <!-- SHADOWS -->
    <section class="sg-section" id="shadows">
      <h2 class="sg-section-title">Shadows</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div style="background:var(--color-surface-white);border-radius:10px;padding:24px;box-shadow:var(--shadow-editorial-card)">
          <div style="font-size:12px;font-family:monospace;color:var(--color-primary)">--shadow-editorial-card</div>
          <div style="font-size:11px;color:var(--color-muted);margin-top:4px">@theme</div>
        </div>
        <div style="background:var(--color-surface-white);border-radius:10px;padding:24px;border:1px solid var(--color-outline-variant)">
          <div style="font-size:12px;font-family:monospace;color:var(--color-primary)">border-outline-variant</div>
          <div style="font-size:11px;color:var(--color-muted);margin-top:4px">Kein Shadow — nur Border</div>
        </div>
      </div>
    </section>

  </main>
</div>

</body>
</html>
