      {(['authority', 'explore', 'trust', 'conversion'] as const).map((type) => {
        const profile = AMARA_PAGE_TYPE_PROFILES[type];
        return (
          <article class="sg-subsection" {...getPageTypeAttributes(type)}>
            <h3 class="am-text-title text-on-surface">{pageTypeLabels[type]}</h3>
            <p class="am-text-body mt-3 text-on-surface-variant">Purpose: {profile.purpose} · Layout: {profile.layout} · Density: {profile.density} · Media: {profile.media} · Whitespace: {profile.whitespace} · CTA: {profile.cta}</p>
            <p class="am-text-caption mt-3 text-primary">Reference: {profile.reference.family} · /{profile.reference.route}</p>
            <p class="am-text-caption mt-3 text-primary">Page ends: {profile.pageEndRoles.join(' → ')}</p>
            {'conversionOwnership' in profile && (
              <p class="am-text-caption mt-3 text-primary">Conversion ownership: {profile.conversionOwnership.join(' or ')}</p>
