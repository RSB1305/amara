        {conversionFamilyGroups.map((group) => {
          const profile = AMARA_CONVERSION_FAMILY_GROUPS[group];
          const families = Object.entries(AMARA_CONVERSION_FAMILY_ASSIGNMENTS)
            .filter(([, assignedGroup]) => assignedGroup === group)
            .map(([family]) => family);
          const specimenFamily = families[0] as keyof typeof AMARA_CONVERSION_FAMILY_ASSIGNMENTS;
          return (
            <article class="mt-10" {...getConversionFamilyAttributes(specimenFamily)}>
              <p class="sg-specimen-note"><strong>Group:</strong> {group} · <strong>Families:</strong> {families.join(', ')} · <strong>Ownership:</strong> {profile.ownership} · <strong>Phases:</strong> {profile.phases.join(' → ')} · <strong>Allowed close:</strong> {profile.allowedClose}. <strong>Protection:</strong> {profile.funnelProtection}.</p>
