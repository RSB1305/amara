---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmaraPageShell from '../components/layout/AmaraPageShell.astro';
import AmaraSection from '../components/layout/AmaraSection.astro';
import { resolveLink } from '../lib/linkResolver';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';

const currentLang: AmaraLanguage = 'es';

const seo: AmaraAuthoringSeo = {
  version: '2026-08-09-404-v1.0-utility',
  pageType: 'utility',
  languages: {
    en: {
      title: 'Page not found | AMARA',
      description: 'The requested page is not available. Return to the AMARA homepage.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    de: {
      title: 'Seite nicht gefunden | AMARA',
      description: 'Die angeforderte Seite ist nicht verfügbar. Kehren Sie zur AMARA-Startseite zurück.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    es: {
      title: 'Página no encontrada | AMARA',
      description: 'La página solicitada no está disponible. Volved a la página principal de AMARA.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    nl: {
      title: 'Pagina niet gevonden | AMARA',
      description: 'De opgevraagde pagina is niet beschikbaar. Ga terug naar de homepage van AMARA.',
      robots: 'noindex, follow',
      canonical: 'auto'
    },
    sv: {
      title: 'Sidan kunde inte hittas | AMARA',
      description: 'Sidan du söker är inte tillgänglig. Gå tillbaka till AMARAs startsida.',
      robots: 'noindex, follow',
      canonical: 'auto'
    }
  }
};

const homeHref = resolveLink('home', currentLang);
---

<BaseLayout seo={seo} pageLang={currentLang} showContextNavigation={false}>
  <AmaraPageShell family="not-found" dataLang={currentLang} whiteCanvas>
    <AmaraSection variant="hero" divider={false} dataComponent="not-found" class="flex min-h-[62vh] items-center">
      <div class="max-w-3xl border-t border-outline-variant/30 pt-10 md:pt-14">
        <p class="am-text-label text-primary">Error 404</p>
        <h1 class="am-text-display mt-5">Esta página ya no está aquí.</h1>
        <p class="am-text-body mt-7 max-w-2xl text-on-surface-variant">
          Puede que el enlace haya cambiado o que la dirección no sea correcta. Desde la
          página principal podéis volver a descubrir todos los alojamientos y destinos de AMARA.
        </p>
        <a class="am-btn am-btn--primary mt-9" href={homeHref}>Volver a AMARA</a>
      </div>
    </AmaraSection>
  </AmaraPageShell>
</BaseLayout>
