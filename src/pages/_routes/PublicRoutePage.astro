---
/**
 * Public route dispatcher.
 *
 * The two catch-all pages generate every public path from the route manifest
 * and hand this component a route key and a language. This is the only place
 * that maps a route's page family to its Astro component, so the manifest
 * stays pure data and a page family is imported exactly once.
 */
import type { AmaraLanguage } from '../../types/seo';
import { getOwnedPublicRoute } from '../../lib/routeOwnership';
import { getVacationRentalBySlug } from '../../content/vacationRentalEntities';

import AmaraExperienceLandingPage from '../../page-families/amara-experience/AmaraExperienceLandingPage.astro';
