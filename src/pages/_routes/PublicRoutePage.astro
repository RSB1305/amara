import FrigilianaHikingPage from '../../page-families/location-authority/FrigilianaHikingPage.astro';
import FrigilianaLocationPage from '../../page-families/location-authority/FrigilianaLocationPage.astro';
import FrigilianaMarketPage from '../../page-families/location-authority/FrigilianaMarketPage.astro';
import FrigilianaOldTownPage from '../../page-families/location-authority/FrigilianaOldTownPage.astro';
import FrigilianaOrNerjaPage from '../../page-families/location-authority/FrigilianaOrNerjaPage.astro';
import FrigilianaRestaurantsPage from '../../page-families/location-authority/FrigilianaRestaurantsPage.astro';
