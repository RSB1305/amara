---
import GuestGuidePage from '../../../page-families/guest-guide/GuestGuidePage.astro';
import { guestGuideEntries } from '../../../content/guestGuideEntries';
import { DEFAULT_LANGUAGE } from '../../../lib/routeOwnership';

export function getStaticPaths() {
  return guestGuideEntries.map((entry) => ({
    params: { guideSlug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<GuestGuidePage entry={entry} lang={DEFAULT_LANGUAGE} />
