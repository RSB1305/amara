---
// src/layouts/LocationAuthorityLayout.astro
import BaseLayout from './BaseLayout.astro';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';

interface Props {
  seo: AmaraAuthoringSeo;
  pageLang?: AmaraLanguage;
  footerHighlights?: { token: string; label: string }[];
  footerVariant?: 'default' | 'trust';
  bodyBackgroundClass?: string;
}

const { seo, pageLang, footerHighlights, footerVariant, bodyBackgroundClass } = Astro.props;
---

<BaseLayout
  seo={seo}
  pageLang={pageLang}
  footerHighlights={footerHighlights}
  footerVariant={footerVariant}
  bodyBackgroundClass={bodyBackgroundClass}
>
  <main>
    <slot />
  </main>
</BaseLayout>
