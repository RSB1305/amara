---
import type { LinkToken } from '../lib/linkResolver';
// src/layouts/LocationAuthorityLayout.astro
import AmaraPageShell from '../components/layout/AmaraPageShell.astro';
import BaseLayout from './BaseLayout.astro';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';
import type { AmaraPageFamilyId } from '../components/page-type/pageTypeContract';

interface Props {
  seo: AmaraAuthoringSeo;
  pageLang?: AmaraLanguage;
  footerHighlights?: { token: LinkToken; label: string }[];
  showContextNavigation?: boolean;
  bodyBackgroundClass?: string;
  pageFamily?: AmaraPageFamilyId;
}

const {
  seo,
  pageLang,
  footerHighlights,
  showContextNavigation = false,
  bodyBackgroundClass,
  pageFamily
} = Astro.props;
---

<BaseLayout
  seo={seo}
  pageLang={pageLang}
  footerHighlights={footerHighlights}
  showContextNavigation={showContextNavigation}
  bodyBackgroundClass={bodyBackgroundClass}
  pageFamily={pageFamily}
>
  <!-- Global navigation stays before the layout-owned page shell to preserve banner semantics across this page family. -->
  <slot name="navigation" />

  <AmaraPageShell family="location-authority" dataLang={pageLang} flush whiteCanvas>
    <slot />
  </AmaraPageShell>
</BaseLayout>
