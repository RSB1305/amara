---
// src/layouts/BaseLayout.astro
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';
import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
import GlobalContextNavigation from '../components/navigation/GlobalContextNavigation.astro';
import type { DestinationId } from '../lib/location/destinationBranchNavigation';
import { resolveLink, type LinkToken } from '../lib/linkResolver';
import {
  normalizeLanguage,
  OG_LOCALES,
  resolveSeoHead
} from '../lib/seo/resolve-seo-head';
import { resolveStructuredData } from '../lib/seo/resolve-structured-data';
import '../styles/global.css';
import headlineFontUrl from '@fontsource/newsreader/files/newsreader-latin-300-normal.woff2?url';
import bodyFontUrl from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import labelFontUrl from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url';

/**
 * Web fonts are declared inside the global stylesheet, so the browser can only
 * discover them after that stylesheet has been fetched and parsed — a third
 * serial round trip before any text reaches its final form. Preloading starts
 * the three faces that carry the visible page shell (headings, body copy and
 * navigation labels) in parallel with the stylesheet instead.
 *
 * The Newsreader italic wordmark is deliberately excluded: it is the largest
 * file of the set and covers the least text, so it stays a normal swap rather
 * than competing with the LCP image for early bandwidth.
 */
const preloadedFonts = [headlineFontUrl, bodyFontUrl, labelFontUrl];

interface Props {
  seo: AmaraAuthoringSeo;
  pageLang?: AmaraLanguage;
  footerHighlights?: { token: LinkToken; label: string }[];
  /** Optional compact label for the final item in the global breadcrumb. */
  contextBreadcrumbTitle?: string;
  /** Destination context for the reduced Location / Experiences links on stay pages. */
  contextDestination?: DestinationId;
  /** Disable only when a page family supplies its own location-specific context navigation. */
  showContextNavigation?: boolean;
  /** Page canvas behind content; default matches design token surface. */
  bodyBackgroundClass?: string;
}

const {
  seo,
  pageLang,
  footerHighlights,
  contextBreadcrumbTitle,
  contextDestination,
  showContextNavigation = true,
  bodyBackgroundClass = 'bg-surface'
} = Astro.props;

/**
 * Layout owns the document shell.
 * Runtime-derived metadata is resolved centrally here,
 * so pages do not emit parallel SEO logic.
 */
const pathname = Astro.url.pathname;
const rawLang = pathname.split('/')[1] || 'es';
const currentLang: AmaraLanguage = pageLang ?? normalizeLanguage(rawLang);
const skipLinkLabels: Record<AmaraLanguage, string> = {
  en: 'Skip to main content',
  de: 'Zum Hauptinhalt springen',
  es: 'Saltar al contenido principal',
  nl: 'Ga naar de hoofdinhoud',
  sv: 'Hoppa till huvudinnehållet'
};
const normalizePath = (value: string) =>
  value.replace(/\/index\.html$/i, '/').replace(/\.html$/i, '').replace(/\/$/, '') || '/';
const isHomePage =
  normalizePath(pathname) === normalizePath(resolveLink('home', currentLang));
const shouldShowContextNavigation =
  showContextNavigation && !isHomePage && !pathname.startsWith('/tools/');

const origin = Astro.url.origin;

const head = resolveSeoHead(seo, origin, pathname, currentLang);
const ldJson = resolveStructuredData(seo, head.canonicalUrl, currentLang, origin);
---

<!DOCTYPE html>
<html lang={currentLang} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {preloadedFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    {/* PNG first — browsers that support it prefer it; favicon.ico stays as the fallback. */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{head.current.title}</title>
    <meta name="description" content={head.current.description} />
    <meta name="robots" content={head.current.robots} />
    <link rel="canonical" href={head.canonicalUrl} />

    {head.hreflangs.map((item) => (
      <link rel="alternate" hreflang={item.hreflang} href={item.href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AMARA" />
    {head.ogImage && <meta property="og:image" content={head.ogImage} />}
    <meta property="og:title" content={head.current.title} />
    <meta property="og:description" content={head.current.description} />
    <meta property="og:url" content={head.canonicalUrl} />
    <meta property="og:locale" content={OG_LOCALES[currentLang]} />
    {head.hreflangs
      .filter((item) => item.hreflang !== 'x-default' && item.hreflang !== currentLang)
      .map((item) => (
        <meta
          property="og:locale:alternate"
          content={OG_LOCALES[item.hreflang as AmaraLanguage]}
        />
      ))}

    <meta
      name="twitter:card"
      content={head.ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={head.current.title} />
    <meta name="twitter:description" content={head.current.description} />
    {head.ogImage && <meta name="twitter:image" content={head.ogImage} />}

    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <script type="application/json" data-amara="seo" set:html={head.seoBlock} />

  </head>

  <body class:list={[bodyBackgroundClass, 'text-on-surface font-body selection:bg-primary/10 antialiased']}>
    <div class="relative z-[10] pt-[104px] lg:pt-[112px]" data-am-interaction-root>
      <a
        href="#am-main-content"
        class="am-btn am-btn--primary fixed left-4 top-0 z-[200] max-w-[calc(100vw-2rem)] -translate-y-full whitespace-normal text-center transition-none focus:translate-y-4"
        data-am-skip-link
      >
        {skipLinkLabels[currentLang]}
      </a>
      {shouldShowContextNavigation && (
        <GlobalContextNavigation
      lang={currentLang}
      pageTitle={seo.languages[currentLang].title}
      breadcrumbTitle={contextBreadcrumbTitle}
      destination={contextDestination}
      pathname={pathname}
      isStay={
        Boolean(seo.entityKey && seo.entityKey !== 'amara-brand') ||
        pathname.includes('romantic-hideaways')
      }
    />
      )}
      <slot />
      <BackToTop lang={currentLang} />
      <Footer currentLang={currentLang} highlights={footerHighlights} />
    </div>
  </body>
</html>
