---
import TrustHero from '../components/hero/TrustHero.astro';
import AmaraPageShell from '../components/layout/AmaraPageShell.astro';
import AmaraSection from '../components/layout/AmaraSection.astro';
import type { LinkToken } from '../lib/linkResolver';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';
import BaseLayout from './BaseLayout.astro';
import type { AmaraPageFamilyId } from '../components/page-type/pageTypeContract';
import { getTrustFamilyAttributes, isAmaraTrustFamilyId } from '../components/trust/trustFamilyContract';

interface HeroLink {
  href: string;
  label: string;
}

interface Props {
  seo: AmaraAuthoringSeo;
  currentLang: AmaraLanguage;
  pageId: string;
  currentToken?: LinkToken;
  languageToken?: LinkToken;
  footerHighlights?: { token: LinkToken; label: string }[];
  dataLang?: AmaraLanguage;
  mainClass?: string;
  pageFamily?: AmaraPageFamilyId;
  hero: {
    title: string;
    titleWidth?: 'default' | 'wide';
    lead: string;
    subtitle?: string;
    supportText?: string;
    ctaLinks?: HeroLink[];
    ctaVariant?: 'editorial' | 'conversion';
  };
}

const {
  seo,
  currentLang,
  pageId,
  currentToken,
  languageToken,
  footerHighlights,
  dataLang,
  mainClass,
  pageFamily,
  hero
} = Astro.props;
const trustFamilyAttributes = isAmaraTrustFamilyId(pageFamily) ? getTrustFamilyAttributes(pageFamily) : {};
---

<BaseLayout
  seo={seo}
  pageLang={currentLang}
  footerHighlights={footerHighlights}
  pageFamily={pageFamily}
  navigationCurrentToken={currentToken}
  navigationLanguageToken={languageToken}
>

  <AmaraPageShell family={pageId} dataLang={dataLang}>
    <AmaraSection variant="hero" dataComponent="trust-hero" class="am-trust-page__hero">
      <TrustHero
        eyebrow={hero.subtitle}
        title={hero.title}
        titleWidth={hero.titleWidth}
        lead={hero.lead}
        supportText={hero.supportText}
        ctaLinks={hero.ctaLinks}
        ctaVariant={hero.ctaVariant}
        spacing="section"
      />
    </AmaraSection>

    <div class:list={['am-trust-flow', mainClass]} {...trustFamilyAttributes}>
      <slot />
    </div>
  </AmaraPageShell>
</BaseLayout>
