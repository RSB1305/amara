---
import Navigation from '../components/Navigation.astro';
import TrustHero from '../components/hero/TrustHero.astro';
import AmaraPageShell from '../components/layout/AmaraPageShell.astro';
import AmaraSection from '../components/layout/AmaraSection.astro';
import type { LinkToken } from '../lib/linkResolver';
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';
import BaseLayout from './BaseLayout.astro';

interface HeroLink {
  href: string;
  label: string;
}

interface Props {
  seo: AmaraAuthoringSeo;
  currentLang: AmaraLanguage;
  pageId: string;
  currentToken?: LinkToken;
  languageToken?: LinkToken;
  footerHighlights?: { token: LinkToken; label: string }[];
  dataLang?: AmaraLanguage;
  mainClass?: string;
  hero: {
    title: string;
    titleWidth?: 'default' | 'wide';
    lead: string;
    subtitle?: string;
    supportText?: string;
    ctaLinks?: HeroLink[];
    ctaVariant?: 'editorial' | 'conversion';
  };
}

const {
  seo,
  currentLang,
  pageId,
  currentToken,
  languageToken,
  footerHighlights,
  dataLang,
  mainClass,
  hero
} = Astro.props;
---

<BaseLayout seo={seo} pageLang={currentLang} footerHighlights={footerHighlights}>
  <Navigation
    currentLang={currentLang}
    currentToken={currentToken}
    languageToken={languageToken}
  />

  <AmaraPageShell family={pageId} dataLang={dataLang}>
    <AmaraSection variant="hero" dataComponent="trust-hero" class="am-trust-page__hero">
      <TrustHero
        subtitle={hero.subtitle}
        title={hero.title}
        titleWidth={hero.titleWidth}
        lead={hero.lead}
        supportText={hero.supportText}
        ctaLinks={hero.ctaLinks}
        ctaVariant={hero.ctaVariant}
        spacing="section"
      />
    </AmaraSection>

    <div class:list={['am-trust-flow', mainClass]}>
      <slot />
    </div>
  </AmaraPageShell>
</BaseLayout>

<style>
  :global(.am-trust-page__hero.am-page-section--divided) {
    position: relative;
    border-bottom: 0;
  }

  :global(.am-trust-page__hero.am-page-section--divided)::after {
    position: absolute;
    right: var(--spacing-page-gutter);
    bottom: 0;
    left: var(--spacing-page-gutter);
    border-bottom: 1px solid var(--color-border-subtle);
    content: '';
  }
</style>
