---
// Minimal shell for internal, noindex Guest Guide pages.
// Deliberately does NOT use BaseLayout: no marketing Navigation/Footer/BackToTop,
// no reserved top padding for the fixed nav — this is meant to feel like a small
// native app, not a marketing page. Still reuses the shared SEO head resolver so
// noindex/title/description/canonical logic stays centralized with the rest of the site.
import type { AmaraAuthoringSeo, AmaraLanguage } from '../types/seo';
import { normalizeLanguage, resolveSeoHead } from '../lib/seo/resolve-seo-head';
import GuestGuideSupportFloat from '../components/guest-guide/GuestGuideSupportFloat.astro';
import '../styles/global.css';
import '../styles/guest-guide.css';

interface Props {
  seo: AmaraAuthoringSeo;
  pageLang: AmaraLanguage;
  supportHref: string;
  supportLabel: string;
  /** This page's own guide slug — recorded to the nav stack when the guest follows a link onward, so SmartBackButton can retrace it regardless of how many pages deep they went. */
  currentSlug: string;
}

const { seo, pageLang, supportHref, supportLabel, currentSlug } = Astro.props;

const pathname = Astro.url.pathname;
const currentLang = normalizeLanguage(pageLang);
const origin = Astro.url.origin;
const head = resolveSeoHead(seo, origin, pathname, currentLang);
const accessHref = currentLang === 'es' ? '/amara-experience/access' : `/${currentLang}/amara-experience/access`;
const logoutLabel: Record<AmaraLanguage, string> = {
  en: 'Log out',
  de: 'Abmelden',
  es: 'Cerrar sesión',
  nl: 'Uitloggen',
  sv: 'Logga ut'
};
---

<!DOCTYPE html>
<html lang={currentLang} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{head.current.title}</title>
    <meta name="description" content={head.current.description} />
    <meta name="robots" content={head.current.robots} />
    <link rel="canonical" href={head.canonicalUrl} />
  </head>

  <body class="am-guide-root bg-surface text-on-surface font-body antialiased" data-guide-slug={currentSlug}>
    <div class="am-guide-wrap">
      <header class="am-guide-session-bar">
        <span class="am-guide-session-brand">AMARA Experience</span>
        <button class="am-guide-session-logout" type="button" data-am-guide-logout>{logoutLabel[currentLang]}</button>
      </header>
      <slot />
    </div>
    <GuestGuideSupportFloat href={supportHref} label={supportLabel} />

    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;
        if (window.__amaraNavTrackBound) return;
        window.__amaraNavTrackBound = true;
        // Records the page the guest is leaving onto a sessionStorage stack whenever they
        // follow a real guide link (not an accordion toggle, which shares the same class
        // on its <summary>) — so SmartBackButton can retrace an arbitrarily deep path
        // (hub -> shared recommendations -> a specific recommendation page -> ...).
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('a.am-ios-item') : null;
          if (!el) return;
          var slug = document.body.getAttribute('data-guide-slug');
          if (!slug) return;
          try {
            var raw = sessionStorage.getItem('amGuideNavStack');
            var stack = raw ? JSON.parse(raw) : [];
            stack.push(slug);
            sessionStorage.setItem('amGuideNavStack', JSON.stringify(stack));
          } catch (err) {
            /* sessionStorage unavailable (private mode etc.) — SmartBackButton falls back to its default target */
          }
        });

        // The map pin sits inside <summary>, so a plain click would open Maps and expand
        // the entry at the same time. Open it here instead and let the toggle be.
        // Without JS the link still works; the entry just expands as well.
        document.addEventListener('click', function (e) {
          var link = e.target && e.target.closest ? e.target.closest('[data-am-map-link]') : null;
          if (!link) return;
          e.preventDefault();
          window.open(link.href, '_blank', 'noopener');
        });
      })();
    </script>
    <script is:inline define:vars={{ accessHref }}>
      (function () {
        var button = document.querySelector('[data-am-guide-logout]');
        if (!button) return;
        button.addEventListener('click', async function () {
          button.disabled = true;
          try {
            var response = await fetch('/api/guest/session', {
              method: 'DELETE',
              credentials: 'same-origin',
              headers: { Accept: 'application/json' }
            });
            if (!response.ok) throw new Error('logout_failed');
            window.location.replace(accessHref);
          } catch (error) {
            button.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
