---
import { CalendarCheck } from '@lucide/astro';
import type { AmaraLanguage } from '../types/seo';
import AmaraActionLink from '../components/actions/AmaraActionLink.astro';
import GuestGuideLanguageSwitcher from '../components/guest-guide/GuestGuideLanguageSwitcher.astro';
import { globalCtaLabels } from '../components/navigation/globalNavigationContent';
import { resolveLink } from '../lib/linkResolver';
import '../styles/global.css';
import '../styles/amara-experience.css';

interface Props {
  lang: AmaraLanguage;
  title: string;
}

const { lang, title } = Astro.props;
const homeHref = resolveLink('home', lang);
const availabilityHref = resolveLink('stay_search_results', lang);
---

<!doctype html>
<html lang={lang} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Cache-Control" content="no-store" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  </head>
  <body class="am-experience-app">
    <div class="am-experience-app__viewport">
      <header class="am-experience-app__header">
        <a href={homeHref} class="am-experience-app__brand" aria-label="AMARA Lodging">
          <span class="font-headline italic text-xl text-on-surface tracking-tighter">AMARA</span>
          <span class="am-text-brand-strapline -mt-1 block text-center text-muted">Lodging</span>
        </a>
        <div class="am-experience-app__utilities">
          <AmaraActionLink
            href={availabilityHref}
            variant="secondary"
            class="am-experience-app__availability"
            aria-label={globalCtaLabels[lang]}
            title={globalCtaLabels[lang]}
            data-am-availability-action
          >
            <CalendarCheck size={22} stroke-width={1.5} aria-hidden="true" />
          </AmaraActionLink>
          <GuestGuideLanguageSwitcher currentLang={lang} target="access" />
        </div>
      </header>
      <slot />
    </div>
  </body>
</html>
