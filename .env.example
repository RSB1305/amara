# Public site origin used during the static production build.
PUBLIC_SITE_URL=https://amara-lodging.es

# Server-only secret. Never rename this with a PUBLIC_ prefix and never commit a value.
LODGIFY_API_KEY=

# Server-only key for the official AEMET OpenData municipality forecast.
AEMET_API_KEY=

# Server-only Guest Guide Wi-Fi table (Cloudflare Pages secret, DR-GUEST-005). JSON keyed by
# stay id (zaid, lounis, maha, farah, playa, tarifa), each {"network": "...", "password": "..."}.
# Read only by /api/guest/profile for the booked stay of an open session; never committed.
AMARA_GUEST_WIFI=

