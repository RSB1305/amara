{
  "name": "frigiliana",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "typecheck:tools": "astro check --tsconfig tsconfig.tools.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "audit:dependencies": "npm audit --audit-level=high",
    "test": "npm run test:contracts && npm run test:browser",
    "test:contracts": "playwright test --config=playwright.contracts.config.ts",
    "test:browser": "playwright test --config=playwright.browser.config.ts",
    "prebuild": "npm run typecheck && npm run check:slug-policy && npm run check:fallback-policy && npm run check:image-policy",
    "check": "npm run typecheck && npm run check:slug-policy && npm run check:fallback-policy && npm run check:image-policy",
    "build": "astro build",
    "postbuild": "node scripts/postbuild.mjs && node scripts/check-image-policy.mjs --dist",
    "preview": "astro preview",
    "astro": "astro",
    "check:slug-policy": "node scripts/check-public-slug-policy.mjs",
    "check:fallback-policy": "node scripts/check-fallback-policy.mjs",
    "check:image-policy": "node scripts/check-image-policy.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "sandbox:lodgify": "node --env-file-if-exists=.env scripts/lodgify-sandbox.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@lucide/astro": "^1.31.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.1.6",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
